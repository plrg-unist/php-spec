    "text": "from pathlib import Path\nimport base64,hashlib,json,os,sys,tempfile\nR=Path.cwd();sys.path.insert(0,str(R/'tests/semantics'));import request_environment as q\nD=Path(tempfile.mkdtemp(prefix='review7-call-ownership-',dir=R/'.tools'))\nCASES={\n 'caller-held-array-across-call':b'<?php function f(){return [2];}$x=1;echo ([$x]+f())[0];',\n 'caller-foreach-reference-across-call':b'<?php $a=[1,2];function f(){global $a;$a[]=3;return 7;}foreach($a as &$v){echo $v;if($v===1)echo f();}echo $v;',\n 'callee-arg-survives-global-unset':b'<?php function f($x){unset($GLOBALS[\"a\"]);$x[0]=2;return $x;}$a=[1];$r=f($a);echo $r[0],isset($a);',\n 'returned-local-singleton-reference-cow':b'<?php function f(){$x=1;$a=[&$x];return $a;}$a=f();$b=$a;$b[0]=7;echo $a[0],$b[0];',\n 'returned-global-shared-reference-cow':b'<?php $g=1;function f(){global $g;return [&$g];}$a=f();$b=$a;$b[0]=7;echo $g,$a[0],$b[0];',\n 'callee-fatal-stack-and-output':b'<?php function f(){echo \"A\";return 1/0;}echo \"B\",f(),\"C\";',\n}\nrecords=[];before=q.t.syntax_validation.implementation_fingerprint()\nfor i,(name,source) in enumerate(CASES.items()):\n path=D/f'case{i}.php';path.write_bytes(source);entries=[b'LC_ALL=C',b'TZ=UTC',b'FIRST=one'];packet=q.packet(1700000000,125000,entries);payload=D/f'case{i}.input';payload.write_bytes(packet)\n request={'env':[[q.b64(k),q.b64(v)] for k,v in (entry.split(b'=',1) for entry in entries)],'argv':[q.b64(os.fsencode(path)),q.b64(b'alpha'),q.b64(b'beta')],'file':q.b64(os.fsencode(path)),'seconds':'1700000000','microseconds':125000,'variables':q.b64(b'EGPCS'),'jit':True,'cwd':q.b64(os.fsencode(D))}\n row={'id':name,'source_base64':q.b64(source),'source_sha256':hashlib.sha256(source).hexdigest(),'context':str(path),'request':request,'payload_base64':q.b64(packet),'payload_sha256':hashlib.sha256(packet).hexdigest()}\n (D/f'case{i}-input.json').write_text(json.dumps(row,indent=2)+'\\n')\n row['native']=q.invoke(path,payload,[],[b'alpha',b'beta'],D);records.append(row);(D/'originals.json').write_text(json.dumps({'scope':'Independent native-only originals before function/frame source activation. Explicit reviewed request primitives; no semantic pass claim.','fingerprint':before,'records':records},indent=2)+'\\n')\n assert row['native']['exit_status']==(255 if name=='callee-fatal-stack-and-output' else 0)\n print(name,base64.b64decode(row['native']['stdout']),row['native']['exit_status'])\nassert before==q.t.syntax_validation.implementation_fingerprint();(D/'capture.py').write_bytes(Path(__file__).read_bytes());print(D)\n"
