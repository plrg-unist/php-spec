#!/usr/bin/env python3
"""Execute checked PHP syntax through the pure SpecTec machine."""
import argparse
import base64
import json
import os
from pathlib import Path
import select
import math
import struct
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'frontend'))
import wire


def b64(data):
    return base64.b64encode(data).decode('ascii')


def request(command, value, timeout):
    environment = os.environ.copy()
    environment.pop('PHP_SPEC_SCRIPT_ENCODING', None)
    environment.update(LC_ALL='C', TZ='UTC')
    result = subprocess.run(command, input=wire.dumps(value) + '\n', text=True,
                            capture_output=True, timeout=timeout, env=environment)
    if result.returncode:
        raise RuntimeError(f'worker exit {result.returncode}: {result.stderr}')
    lines = result.stdout.splitlines()
    if len(lines) != 1:
        raise RuntimeError('worker did not return exactly one response: ' + result.stdout)
    return wire.loads(lines[0])


class AdapterSession:
    def __init__(self, command):
        environment = os.environ.copy()
        environment.pop('PHP_SPEC_SCRIPT_ENCODING', None)
        environment.update(LC_ALL='C', TZ='UTC')
        self.process = subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                        stderr=subprocess.PIPE, env=environment)
        self.buffer = bytearray()

    def request(self, value, timeout):
        self.process.stdin.write((wire.dumps(value) + '\n').encode())
        self.process.stdin.flush()
        deadline = time.monotonic() + timeout
        while b'\n' not in self.buffer:
            remaining = deadline - time.monotonic()
            if remaining <= 0 or not select.select([self.process.stdout], [], [], remaining)[0]:
                raise subprocess.TimeoutExpired(self.process.args, timeout)
            chunk = os.read(self.process.stdout.fileno(), 65536)
            if not chunk:
                raise RuntimeError('adapter closed before its response')
            self.buffer.extend(chunk)
        line, _, rest = self.buffer.partition(b'\n')
        self.buffer = bytearray(rest)
        return wire.loads(line.decode())

    def close(self):
        if self.process.poll() is None:
            self.process.stdin.close()
            try:
                self.process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                self.process.kill()
                self.process.wait()
        self.process.stdout.close()
        self.process.stderr.close()


def observe(state, filename, display_mode=2):
    def source_filename(unit):
        for sourcefile in state['FILES']:
            if int(sourcefile['args'][0]) == int(unit):
                return bytes(map(int, sourcefile['args'][1]))
        raise ValueError(f'unknown source unit {unit}')

    events = state['EVENTS']
    stdout = b''
    completion = state['COMPLETION']
    tag, fields = completion['tag'], completion['args']
    uncaught_chain = []
    uncaught_rendered = tag == 'UNCAUGHT_RENDERED'
    if tag in ('UNCAUGHT', 'UNCAUGHT_RENDERED'):
        def class_name(object_id):
            obj = state['OBJECTS'][object_id]
            if obj['tag'] == 'THROWABLE':
                return obj['args'][0]['KIND']
            origin = obj['args'][0]
            name = next(row['NAME'] for row in state['CLASSES'] if row['ORIGIN'] == origin)
            return bytes(map(int, name)).decode('utf-8', 'surrogateescape')

        def field(object_id, name):
            properties = next(row['SLOTS'] for row in state['OBJECTPROPS'] if int(row['OBJECT']) == object_id)
            if name in ('string', 'trace', 'previous'):
                keys = {b'\0Exception\0' + name.encode(), b'\0Error\0' + name.encode()}
            else:
                keys = {b'\0*\0' + name.encode()}
            slot = next(slot for slot in properties if bytes(map(int, slot['NAME'])) in keys)
            item = slot['STATE']['args'][0]
            return (item['args'][0] if item['tag'] == 'DIRECT'
                    else state['STORE'][int(item['args'][0])]['args'][0])

        def exception_message(value):
            kind = value['tag']
            if kind == 'PSTRING':
                return bytes(map(int, value['args'][0])), False
            if kind == 'PINT':
                return str(value['args'][0]).encode(), False
            if kind == 'PBOOL':
                return (b'1' if value['args'][0] else b''), False
            if kind == 'PNULL':
                return b'', False
            if kind == 'PARRAY':
                return b'Array', True
            if kind == 'PFLOAT':
                number = struct.unpack('>d', int(value['args'][0]).to_bytes(8, 'big'))[0]
                return format(number, '.14G').encode(), False
            raise ValueError(f'unsupported exception message kind {kind}')

        root_id = int(fields[0])
        object_id = root_id
        seen = set()
        while object_id is not None and object_id not in seen:
            seen.add(object_id)
            uncaught_chain.append(object_id)
            if uncaught_rendered:
                break
            previous = field(object_id, 'previous')
            object_id = int(previous['args'][0]) if previous['tag'] == 'POBJECT' else None
        message = (fields[1] if uncaught_rendered
                   else list(exception_message(field(root_id, 'message'))[0]))
        tag, fields = 'THROWN', [class_name(root_id), message, field(root_id, 'line')['args'][0]]
    def diagnostic_bytes(event):
        data = b''
        if event['tag'] == 'STDERR':
            data += bytes(map(int, event['args'][0]))
        elif event['tag'] == 'WARNING':
            name, line = bytes(map(int, event['args'][0])), int(event['args'][1])
            data += (b'Warning: Undefined variable $' + name + b' in ' + os.fsencode(filename)
                       + b' on line ' + str(line).encode() + b'\n')
        elif event['tag'] == 'WARNING_SOURCE':
            unit, name, line = event['args']
            data += (b'Warning: Undefined variable $' + bytes(map(int, name)) + b' in '
                       + source_filename(unit) + b' on line ' + str(line).encode() + b'\n')
        elif event['tag'] == 'DIAGNOSTIC':
            severity, message, line = event['args']
            data += (severity.encode() + b': ' + bytes(map(int, message)) + b' in ' + os.fsencode(filename)
                       + b' on line ' + str(line).encode() + b'\n')
        elif event['tag'] == 'DIAGNOSTIC_INTERNAL':
            severity, message, line = event['args']
            data += (severity.encode() + b': ' + bytes(map(int, message)) + b' in Unknown'
                       + b' on line ' + str(line).encode() + b'\n')
        elif event['tag'] == 'DIAGNOSTIC_SOURCE':
            unit, severity, message, line = event['args']
            data += (severity.encode() + b': ' + bytes(map(int, message)) + b' in '
                       + source_filename(unit) + b' on line ' + str(line).encode() + b'\n')
        elif event['tag'] in {'DIAGNOSTIC_STACK', 'DIAGNOSTIC_STACK_SOURCE'}:
            if event['tag'] == 'DIAGNOSTIC_STACK_SOURCE':
                unit, severity, message, line, trace = event['args']
                event_file = source_filename(unit)
            else:
                severity, message, line, trace = event['args']
                event_file = os.fsencode(filename)
            data += (severity.encode() + b': ' + bytes(map(int, message)) + b' in '
                       + event_file + b' on line ' + str(line).encode()
                       + b'\nStack trace:\n' + bytes(map(int, trace)) + b'\n')
        return data

    stderr = b''
    for event in events:
        if event['tag'] == 'OUTPUT':
            stdout += bytes(map(int, event['args'][0]))
        elif event['tag'] == 'DISPLAY_STDOUT':
            stdout += b'\n' + diagnostic_bytes(event['args'][0])
        else:
            stderr += diagnostic_bytes(event)
    def array_items(array_id):
        return state['ARRAYS'][array_id]['ITEMS']

    def item_value(item):
        return (item['args'][0] if item['tag'] == 'DIRECT'
                else state['STORE'][int(item['args'][0])]['args'][0])

    def array_field(array_id, name):
        for entry in array_items(array_id):
            key, item = entry['args']
            if key['tag'] == 'KSTRING' and bytes(map(int, key['args'][0])) == name:
                return item_value(item)
        return None

    def value_text(value):
        kind = value['tag']
        if kind == 'PNULL':
            return b'NULL'
        if kind == 'PBOOL':
            return b'true' if value['args'][0] else b'false'
        if kind == 'PINT':
            return str(value['args'][0]).encode()
        if kind == 'PFLOAT':
            number = struct.unpack('>d', int(value['args'][0]).to_bytes(8, 'big'))[0]
            if math.isnan(number):
                return b'NAN'
            if math.isinf(number):
                return b'-INF' if number < 0 else b'INF'
            rendered = format(number, '.14G').encode()
            return rendered + b'.0' if b'.' not in rendered and b'E' not in rendered else rendered
        if kind == 'PARRAY':
            return b'Array'
        if kind == 'POBJECT':
            obj = state['OBJECTS'][int(value['args'][0])]
            if obj['tag'] == 'THROWABLE':
                name = obj['args'][0]['KIND']
            elif obj['tag'] == 'STDINSTANCE':
                name = 'stdClass'
            elif obj['tag'] == 'INSTANCE':
                name = next(row['NAME'] for row in state['CLASSES'] if row['ORIGIN'] == obj['args'][0])
                return b'Object(' + bytes(map(int, name)) + b')'
            else:
                name = 'Closure'
            return b'Object(' + name.encode() + b')'
        if kind == 'PSTRING':
            data = bytes(map(int, value['args'][0]))
            escapes = {10: b'\\n', 13: b'\\r', 9: b'\\t', 12: b'\\f', 11: b'\\v', 27: b'\\e', 92: b'\\\\'}
            return b"'" + b''.join(escapes.get(ch, bytes([ch]) if 32 <= ch <= 126 else f'\\x{ch:02X}'.encode())
                                   for ch in data[:15]) + (b"...'" if len(data) > 15 else b"'")
        raise ValueError(f'unsupported trace argument kind {kind}')

    def trace_frame(index, file, line, function, classname, call_type, args):
        call = (classname + call_type if classname is not None else b'') + function
        rendered = []
        for key, value in args:
            prefix = bytes(map(int, key['args'][0])) + b': ' if key['tag'] == 'KSTRING' else b''
            rendered.append(prefix + value_text(value))
        location = (b'[internal function]' if file is None else file + b'(' + str(line).encode() + b')')
        return (b'#' + str(index).encode() + b' ' + location + b': '
                + call + b'(' + b', '.join(rendered) + b')\n')

    def slot_trace(array_id):
        frames = []
        for index, entry in enumerate(array_items(array_id)):
            frame_id = int(item_value(entry['args'][1])['args'][0])
            get = lambda name: array_field(frame_id, name)
            file_value = get(b'file')
            line_value = get(b'line')
            file = bytes(map(int, file_value['args'][0])) if file_value else None
            line = int(line_value['args'][0]) if line_value else None
            function = bytes(map(int, get(b'function')['args'][0]))
            classname = get(b'class')
            call_type = get(b'type')
            args_value = get(b'args')
            args = ([(entry['args'][0], item_value(entry['args'][1]))
                     for entry in array_items(int(args_value['args'][0]))] if args_value else [])
            frames.append(trace_frame(index, file, line, function,
                                      bytes(map(int, classname['args'][0])) if classname else None,
                                      bytes(map(int, call_type['args'][0])) if call_type else b'', args))
        return b''.join(frames) + b'#' + str(len(frames)).encode() + b' {main}\n'

    stack = b''
    for i, frame in enumerate(state.get('TRACE', [])):
        args = [(key, value) for key, value in frame['ARGS']]
        stack += trace_frame(i, None if not frame['FILE'] and int(frame['LINE']) == -1 else bytes(map(int, frame['FILE'])), int(frame['LINE']),
                             bytes(map(int, frame['FUNCTION'])),
                             bytes(map(int, frame['CLASS'])) if frame['CLASS'] is not None else None,
                             bytes(map(int, frame['TYPE'])) if frame['TYPE'] is not None else b'', args)
    stack += b'#' + str(len(state.get('TRACE', []))).encode() + b' {main}\n'
    location = os.fsencode(filename)
    origin = state.get('ERRORORIGIN')
    if origin is not None:
        location = source_filename(origin['args'][0])
    if uncaught_chain:
        location = bytes(map(int, field(uncaught_chain[0], 'file')['args'][0]))
    diagnostic = None
    status = {'NORMAL': 'normal', 'REQUESTFATAL': 'php_error', 'EXITED': 'explicit_exit', 'FATAL': 'php_error', 'USERFATAL': 'php_error', 'INTERNALFATAL': 'php_error', 'PHPERROR': 'php_error', 'THROWN': 'php_error', 'STATICERROR': 'static_rejection', 'STATICBYTES': 'static_rejection', 'COMPILETHROWN': 'static_rejection',
              'UNSUPPORTED': 'unsupported', 'BUDGET': 'budget_exhausted'}[tag]
    if tag == 'STATICBYTES':
        for declaration in reversed(state['DECLARATIONS']):
            if declaration['tag'] == 'PDEXIT':
                if declaration['args'][1]['tag'] == 'PCSCOMPLETE':
                    status = 'php_error'
                break
    exit_status = 0 if tag == 'NORMAL' else None
    event_stderr = stderr
    stderr = b''
    if tag == 'REQUESTFATAL':
        diagnostic = {'class': bytes(map(int, fields[0])).decode('utf-8', 'surrogateescape'),
                      'message': b64(bytes(map(int, fields[1]))), 'line': int(fields[2])}
        exit_status = 255
    elif tag == 'EXITED':
        exit_status = int(fields[0]) % 256
    elif tag == 'PHPERROR':
        name, line = bytes(map(int, fields[0])), int(fields[1])
        message = b'Undefined constant "' + name + b'"'
        diagnostic = {'class': 'Error', 'message': b64(message), 'line': line}
        stderr += (b'Fatal error: Uncaught Error: ' + message + b' in ' + location + b':' + str(line).encode()
                  + b'\nStack trace:\n' + stack + b'  thrown in ' + location + b' on line ' + str(line).encode() + b'\n')
        exit_status = 255
    elif tag == 'THROWN':
        classname, message, line = fields[0], bytes(map(int, fields[1])), int(fields[2])
        diagnostic = {'class': classname, 'message': b64(message), 'line': line}
        display_message = message
        if classname in ('TypeError', 'ArgumentCountError') and b', called in ' in message.split(b'\0', 1)[0]:
            display_message += b' and defined'
        messages = {}
        if uncaught_chain and not uncaught_rendered:
            for chain_id in uncaught_chain:
                messages[chain_id], array_warning = exception_message(field(chain_id, 'message'))
                if array_warning and int(state['REPORTING']) & 2:
                    warning = b'Warning: Array to string conversion in Unknown on line 0\n'
                    if int(display_mode) == 1:
                        stdout += b'\n' + warning
                    elif int(display_mode) == 2:
                        event_stderr += warning
        if int(state['REPORTING']) & (4 if classname == 'ParseError' else 64 if classname == 'CompileError' else 1):
            if classname in {'ParseError', 'CompileError'}:
                prefix = b'Parse error: ' if classname == 'ParseError' else b'Fatal error: '
                stderr += prefix + message + b' in ' + location + b' on line ' + str(line).encode() + b'\n'
            elif uncaught_rendered:
                stderr += (b'Fatal error: Uncaught ' + message + b'\n  thrown in ' + location
                           + b' on line ' + str(line).encode() + b'\n')
            elif uncaught_chain:
                for index, chain_id in enumerate(reversed(uncaught_chain)):
                    chain_name = class_name(chain_id)
                    message_bytes = messages[chain_id]
                    if chain_name in ('TypeError', 'ArgumentCountError') and b', called in ' in message_bytes.split(b'\0', 1)[0]:
                        message_bytes += b' and defined'
                    prefix = b'Fatal error: Uncaught ' if index == 0 else b'\nNext '
                    message_part = b': ' + message_bytes if message_bytes else b''
                    stderr += (prefix + chain_name.encode('utf-8', 'surrogateescape') + message_part + b' in '
                               + bytes(map(int, field(chain_id, 'file')['args'][0])) + b':' + str(field(chain_id, 'line')['args'][0]).encode()
                               + b'\nStack trace:\n')
                    stderr += slot_trace(int(field(chain_id, 'trace')['args'][0]))
                stderr += b'  thrown in ' + location + b' on line ' + str(line).encode() + b'\n'
            else:
                message_part = b': ' + display_message if display_message else b''
                stderr += (b'Fatal error: Uncaught ' + classname.encode() + message_part + b' in ' + location
                           + b':' + str(line).encode() + b'\nStack trace:\n' + stack + b'  thrown in ' + location
                           + b' on line ' + str(line).encode() + b'\n')
        exit_status = 255
    elif tag == 'USERFATAL':
        message, line, display = bytes(map(int, fields[0])), int(fields[1]), fields[2]
        diagnostic = {'class': 'Error', 'message': b64(message), 'line': line}
        if display:
            stderr += (b'Fatal error: ' + message + b' in ' + location
                       + b' on line ' + str(line).encode()
                       + (b'\nStack trace:\n' + stack if state.get('TRACE') else b'\n'))
        exit_status = 255
    elif tag == 'INTERNALFATAL':
        message, display = bytes(map(int, fields[0])), fields[1]
        diagnostic = {'class': 'Error', 'message': b64(message), 'line': 0}
        if display:
            stderr += (b'Fatal error: ' + message + b' in Unknown on line 0\nStack trace:\n' + stack)
        exit_status = 255
    elif tag == 'COMPILETHROWN':
        message, line = bytes(map(int, fields[0])), int(fields[1])
        diagnostic = {'class': 'CompileError', 'message': b64(message), 'line': line}
        stderr += (b'Fatal error: ' + message + b' in ' + location
                   + b' on line ' + str(line).encode() + b'\n')
        exit_status = 255
    elif tag in {'STATICERROR', 'STATICBYTES', 'FATAL'}:
        message = fields[0].encode() if tag == 'STATICERROR' else bytes(map(int, fields[0]))
        line = int(fields[1])
        diagnostic = {'class': 'Error' if tag == 'FATAL' else 'CompileError', 'message': b64(message), 'line': line}
        stderr += (b'Fatal error: ' + message + b' in ' + location
                  + b' on line ' + str(line).encode() + b'\nStack trace:\n' + stack)
        exit_status = 255
    if int(display_mode) == 1 and stderr:
        stdout += b'\n' + stderr
    elif int(display_mode) == 2:
        event_stderr += stderr
    return {'status': status, 'stdout': b64(stdout), 'stderr': b64(event_stderr),
            'exit_status': exit_status, 'diagnostic': diagnostic,
            'reason': fields[0] if tag == 'UNSUPPORTED' else None, 'events': events}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('file', type=Path)
    parser.add_argument('--steps', type=int, default=100000)
    parser.add_argument('--timeout', type=float, default=30)
    parser.add_argument('--request-context', type=Path, help='JSON file containing explicit primitive request facts')
    parser.add_argument('--file-snapshot', type=Path, help='finite include/require resolution and file-byte facts')
    parser.add_argument('--startup-ini', type=Path, help='JSON registered startup display_errors (base64 or null), or error_reporting/include_path with optional display_errors')
    args = parser.parse_args()
    if args.steps < 0 or args.timeout <= 0:
        parser.error('steps must be nonnegative and timeout positive')
    filename = args.file.resolve()
    source = filename.read_bytes()
    php = str(ROOT / '.tools/php/bin/php')
    profile = json.loads((ROOT / 'tests/semantics/profile.json').read_text())
    flags = [flag for key, value in profile.items() for flag in ('-d', key + '=' + value)]
    parsed = request([php, '-n', *flags, '-d', 'extension=' + str(ROOT / '.tools/php-file.so'),
                      str(ROOT / 'frontend/worker.php')], {'op': 'parse', 'source': b64(source)}, args.timeout)
    if not parsed.get('ok') or not parsed.get('accepted'):
        return {'status': 'frontend_failure', 'frontend': parsed}
    execution = {'op': 'execute', 'ast': parsed['ast'], 'steps': args.steps,
                 'filename': b64(os.fsencode(filename))}
    if args.startup_ini is not None:
        execution['startup_ini'] = json.loads(args.startup_ini.read_text())
    if args.request_context is not None:
        execution['request'] = json.loads(args.request_context.read_text())
    file_snapshot = None
    if args.file_snapshot is not None:
        file_snapshot = json.loads(args.file_snapshot.read_text())
        if file_snapshot.get('main') != execution['filename']:
            raise ValueError('file snapshot main path differs from executed source')
        if file_snapshot.get('cwd') != b64(os.fsencode(Path.cwd().resolve())):
            raise ValueError('file snapshot cwd differs from process cwd')
        execution['file_snapshot'] = file_snapshot
    adapter = AdapterSession([str(ROOT / '_build/default/adapter/main.exe'), str(ROOT)])
    try:
        result = adapter.request(execution, args.timeout)
        while result.get('ok') and 'pending' in result:
            pending = result['pending']
            mode = pending['mode']
            if mode == 'chdir':
                if file_snapshot is None or file_snapshot['version'] != 2:
                    return {'status': 'unsupported', 'reason': 'chdir requires a finite version 2 snapshot'}
                matches = [entry for entry in file_snapshot['chdir_entries']
                           if entry['cwd'] == pending['cwd']
                           and entry['requested'] == pending['requested']]
                if len(matches) != 1:
                    return {'status': 'unsupported', 'reason': 'chdir absent or ambiguous in finite snapshot'}
                result = adapter.request({'op': 'resume_chdir',
                                          'response': {'id': pending['id'], 'site': pending['site'],
                                                       **matches[0]}}, args.timeout)
                continue
            if mode == 'file-resolve':
                if file_snapshot is None:
                    return {'status': 'unsupported', 'reason': 'file resolution requires a finite snapshot'}
                matches = [entry for entry in file_snapshot['entries']
                           if entry['caller'] == pending['caller']
                           and entry['requested'] == pending['requested']
                           and (file_snapshot['version'] != 2 or
                                (entry['cwd'] == pending['cwd'] and
                                 entry['include_path'] == pending['include_path']))]
                if len(matches) != 1:
                    return {'status': 'unsupported', 'reason': 'file resolution absent or ambiguous in finite snapshot'}
                result = adapter.request({'op': 'resume_file_resolve',
                                          'response': {'id': pending['id'], **matches[0]}}, args.timeout)
                continue
            if mode not in {'eval', 'file'}:
                return {'status': 'runner_failure', 'reason': 'unknown source service mode'}
            operation = 'parse-eval' if mode == 'eval' else 'parse-file'
            parsed_dynamic = request([php, '-n', *flags, '-d', 'extension=' + str(ROOT / '.tools/php-file.so'),
                                      str(ROOT / 'frontend/worker.php')],
                                     {'op': operation, **pending}, args.timeout)
            if not parsed_dynamic.get('ok'):
                if parsed_dynamic.get('category') == 'helper_unsupported':
                    return {'status': 'unsupported', 'reason': mode + ' source service: ' + parsed_dynamic.get('message', '')}
                return {'status': 'frontend_failure', 'frontend': parsed_dynamic}
            if parsed_dynamic.get('diagnostics'):
                return {'status': 'unsupported', 'reason': mode + ' parser service diagnostics'}
            response = {key: value for key, value in parsed_dynamic.items() if key not in {'ok', 'diagnostics'}}
            result = adapter.request({'op': 'resume_eval' if mode == 'eval' else 'resume_file_parse',
                                      'response': response}, args.timeout)
    finally:
        adapter.close()
    if not result.get('ok'):
        return {'status': result.get('category', 'runner_failure'), 'detail': result}
    outcome = observe(result['state'], filename, result['display_mode'])
    outcome['frontend'] = 'accepted'
    outcome['checked'] = 'program'
    return outcome


if __name__ == '__main__':
    try:
        result = main()
    except subprocess.TimeoutExpired:
        result = {'status': 'timeout'}
    except (OSError, RuntimeError, ValueError, KeyError) as error:
        result = {'status': 'runner_failure', 'message': str(error)}
    print(json.dumps(result))
    sys.exit(0 if result['status'] in {'normal', 'explicit_exit', 'php_error', 'static_rejection'} else 1)
