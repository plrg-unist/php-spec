    },
    {
      "id": "protected-value-overridden-by-variable-return",
      "source": "<?php $x='old';function h($n,$m,$f,$l){echo 'H;';return true;}set_error_handler('h');function &f(){global $x;try{return 1;}finally{echo 'F;';return $x;}}$r=&f();echo 'R:',$r,';';$r='new';echo 'X:',$x,';';",
      "source_sha256": "d7036be2ea306221e08d510ba51cdd37451b0f750ad31eff24193297e8eb54d7",
      "stdout": "F;R:old;X:new;",
      "stderr": "",
      "exit": 0,
      "purpose": "An inner value-designated reference return is replaced inside finally by a variable reference return; its pending Notice must be cancelled, and the selected variable remains the caller's reference cell."
    }
  ]
