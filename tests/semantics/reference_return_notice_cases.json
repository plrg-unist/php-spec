    },
    {
      "id": "protected-null-literal-handler",
      "source": "<?php function notice20($n,$m,$f,$l){echo \"H;\";return true;}set_error_handler(\"notice20\");function &f(){try{return null;}finally{echo \"F;\";}}$r=&f();echo \"R:\",(int)($r===null),\";\";",
      "source_sha256": "c649b2f1867eef4dc616fc4dc5c7fedd168c77ee747cdf05543d1b31a0c49e09",
      "stdout": "F;H;R:1;",
      "stderr": "",
      "exit": 0,
