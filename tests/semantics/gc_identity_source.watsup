;; A nonowning left operand authorizes exactly one produced right temporary.
;; Keep the source predicate equivalent before and after SL structuring.
dec $identity_receipt(poperand, bool) : pgctemporary
def $identity_receipt(poperand, b) = {OPERAND poperand, PENDING b}
dec $main() : bool
def $main() = true
