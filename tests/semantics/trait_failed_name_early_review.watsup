;; Preserve genuine fatal/Throwable state while seeking the next file service.
dec $review_failed_name_file_wait(pstate, nat) : pstate
def $review_failed_name_file_wait(S, n) = S -- if S.COMPLETION = SOURCE_PENDING
def $review_failed_name_file_wait(S, n) = $review_failed_name_file_wait(S[.COMPLETION = NORMAL], n)
  -- if S.COMPLETION = BUDGET
def $review_failed_name_file_wait(S, n) = $review_failed_name_file_wait($drive_steps(S, 1), $nabs($(n - 1)))
  -- if S.COMPLETION =/= SOURCE_PENDING /\ S.COMPLETION =/= BUDGET /\ $(n > 0)
def $review_failed_name_file_wait(S, n) = S -- otherwise

