{
  "suppress-variable-used-and-restored": "<?php echo @$missing;echo $other,\"DONE\";",
  "suppress-computed-variable": "<?php $n=\"missing\";echo @$$n;echo \"DONE\";",
  "suppress-static-array-hole": "<?php @([,1]);",
  "suppress-static-write-priority": "<?php $x=@($GLOBALS=1);",
  "suppress-variable-reference-send": "<?php function f(&$x){$x=2;}$a=1;f(@$a);echo $a;",
  "suppress-call-reference-send": "<?php $a=1;function &g(){global $a;return $a;}function f(&$x){$x=2;}f(@g());echo $a;",
  "suppress-reference-return-variable": "<?php $a=1;function &f(){global $a;return @$a;}$r=&f();$r=2;echo $a,$r;",
  "suppress-reference-return-call": "<?php $a=1;function &g(){global $a;return $a;}function &f(){return @g();}$r=&f();$r=2;echo $a,$r;",
  "suppress-constant-default": "<?php function f($x=@1){}",
  "suppress-multiline-call-parent": "<?php\nfunction g($x){return [];}\nfunction f():int {\n return @g(\n 1\n );\n}\nf();",
  "suppression": "<?php $x=1;$c=1;function &f(){global $x;return $x;}function h($v){return $v;}\n@f();",
  "void-suppression": "<?php $x=1;$c=1;function &f(){global $x;return $x;}function h($v){return $v;}\n(void)@f();",
  "silence-nested-call-restoration": "<?php function g(){echo \"G\",$missing;return 1;}function f(){echo @g(),$inside;return 2;}echo @f(),$after,\"DONE\";",
  "silence-numeric-warning": "<?php function f(){return \"1x\"+2;}echo @f(),$after,\"DONE\";",
  "silence-key-deprecation": "<?php function f(){$a=[];$a[1.2]=3;return $a[1];}echo @f(),$after,\"DONE\";",
  "silence-nan-string-warning": "<?php function f(){return (string)NAN;}echo @f(),$after,\"DONE\";",
  "silence-top-error-cleared-tasks": "<?php echo \"BEFORE\";echo @((string)($x+[]));echo \"AFTER\";",
  "silence-nested-call-error": "<?php function g():int{return [];}function f(){return @g();}echo \"BEFORE\";echo @f();echo \"AFTER\";",
  "silence-reference-result-cow": "<?php $a=[1];$b=$a;function &g(){global $a;echo $missing;return $a;}function f(&$x){$x[0]=3;}f(@g());echo $a[0],$b[0],$after,\"DONE\";",
  "silence-constant-dead-write": "<?php @false && ($GLOBALS=1);echo \"DONE\";",
  "silence-constant-dead-hole": "<?php @true || [,1];echo \"DONE\";",
  "silence-constant-folded-list-effects": "<?php echo (@([$x]=[2]))[0]+3,$x,$after,\"DONE\";",
  "silence-nested-constant-effects": "<?php echo @(@([$x]=[2])),$x,$after,\"DONE\";",
  "silence-constant-parent-warning": "<?php echo (@NAN).\"x\";echo $after,\"DONE\";",
  "silence-folded-append-once": "<?php $a=[];echo (@([$a[]]=[2]))[0]+3,$a[0],$a[1]??\"N\",$after,\"DONE\";",
  "silence-nested-append-once": "<?php $a=[];echo (@(@([$a[]]=[2])))[0]+3,$a[0],$a[1]??\"N\",$after,\"DONE\";"
}
