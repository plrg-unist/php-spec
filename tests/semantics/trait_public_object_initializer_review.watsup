  -- if $trait_cache_object_scalar_error(S_next.COMPLETION)
def $review_trait_object_error(F, S, ptraitcachecause, n) = $review_trait_object_error(F[.RECORDED = F.RECORDED ++ pfdiagnostic*], S_next[.EVENTS = eps], ptraitcachecause, $nabs($(n - 1)))
  -- if $(n > 0)
  -- if S.COMPLETION = NORMAL /\ S.TODO =/= eps
  -- if S.CLASSCONSTANTINIT = pclassconstantcontext :: pclassconstantcontext_tail*
