;; Pause the genuine published dependency loop immediately before its first
;; failing step. The seed copies238's source-owned comparison context without
;; invoking the folder to completion, then266/184 perform every runtime step.
dec $review_trait_object_seed(pstate, pclassdesc, porigin) : pfstate?
def $review_trait_object_seed(S, pclassdesc, PORIGIN n pcpath) = (F_seed)
  -- if $source_unit(S.SOURCES, n) = (pcunit)
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (expression)
  -- if $($expression_line(expression) > 0)
  -- if F = $pfbegin(n, pcunit.AST)
  -- if porigin_member = PORIGIN n pcpath[0:$nabs($(|pcpath| - 1))]
  -- if S_memory = S[.CONSTCONTEXT = ({ORIGIN TRAIT_MEMBER_ORIGIN pclassdesc.ORIGIN porigin_member, LINE $expression_line(expression), FACTS eps})][.ORIGIN = eps][.ERRORHANDLER = {CALLBACK eps, LEVELS 0}][.ERRORFATALTRACE = eps][.DISPLAYINI = ($ptascii("stderr"))]
  -- if ptcontext = {NAMESPACE eps, IMPORTS eps, SCOPE PTKNOWN pclassdesc.NAME pclassdesc.PARENT, POSITION PTCONSTANT, OWNER pclassdesc.NAME, MEMBER eps, FILE $call_sourcefile(S.FILES, PORIGIN n pcpath), LINE $nabs($expression_line(expression))}
  -- if $pool_at(S.POOLS, n) = (ppool)
  -- if $trait_record_root(S, pclassdesc, PORIGIN n pcpath)
  -- if F_seed = $pfcontextualize(F[.RECORD = ({CLASS pclassdesc.ORIGIN, ROOT PORIGIN n pcpath, TABLE pclassdesc.CONSTANTS})][.FACTS = $trait_pool_facts(S, n, ppool.CONSTANTS)][.CLASSFACTS = $trait_pool_classes(ppool.CONSTANTS)][.CLASSES = S.CLASSES][.CLASSCONSTANTS = pclassdesc.CONSTANTS][.EXTERNAL = (S)][.DEFAULT = true][.CONSTANT = true][.CLASSCONTEXT = (ptcontext)][.FILE = ($call_sourcefile(S.FILES, PORIGIN n pcpath))][.CWD = ($call_request_cwd(S.REQUEST))][.MEMORY = S_memory[.REPORTING = 32767][.EVENTS = eps]][.ENV = $plempty(false)], pcpath)

