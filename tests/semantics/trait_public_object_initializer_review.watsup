  -- if S_next = $trait_cache_object_step(S, ptraitcachecause)
  -- if $trait_cache_object_events(pclassconstantdesc_active.OWNER, porigin_site, S_next.EVENTS) = (pfdiagnostic*)
  -- if S_next.COMPLETION = NORMAL

dec $review_trait_initializer_output(pevent*) : ptbytes
dec $review_trait_initializer_event(pevent) : ptbytes
def $review_trait_initializer_output(eps) = eps
def $review_trait_initializer_output(pevent :: pevent_tail*) = $review_trait_initializer_event(pevent) ++ $review_trait_initializer_output(pevent_tail*)
def $review_trait_initializer_event(OUTPUT ptbytes) = ptbytes
def $review_trait_initializer_event(pevent) = eps -- otherwise
