dec $review_trait_object_error(pfstate, pstate, ptraitcachecause, nat) : (pfstate, pstate, pstate)?
def $review_trait_object_error(F, S, ptraitcachecause, 0) = eps
def $review_trait_object_error(F, S, ptraitcachecause, n) = ((F[.RECORDED = F.RECORDED ++ pfdiagnostic*], S, S_next[.EVENTS = eps]))
  -- if $(n > 0)
  -- if S.COMPLETION = NORMAL /\ S.TODO =/= eps
  -- if S.CLASSCONSTANTINIT = pclassconstantcontext :: pclassconstantcontext_tail*
