CREATE TABLE phpnews_banned (   id int(4) unsigned NOT NULL auto_increment,   ip varchar(80) NOT NULL,   timesbanned tinyint(3) NOT NULL default '0',   isbanned tinyint(1) NOT NULL,   PRIMARY KEY  (id) ) TYPE=MyISAM;
CREATE TABLE phpnews_comments (   id int(11) unsigned auto_increment,   ip varchar(80) NOT NULL,   mid int(11) NOT NULL,   time bigint(20) NOT NULL,   name varchar(40) NOT NULL,   message text NOT NULL,   email varchar(50),   website tinytext,   PRIMARY KEY  (id) ) TYPE=MyISAM;
CREATE TABLE phpnews_news (   id int(11) unsigned NOT NULL auto_increment,   posterid int(5) NOT NULL default '0',   postername varchar(80) NOT NULL default '',   time bigint(20) NOT NULL default '0',   month int(2) NOT NULL default '0',   year int(4) NOT NULL default '0',   subject tinytext NOT NULL,   titletext text NOT NULL,   maintext text NOT NULL,   break tinytext NOT NULL,   catid int(11) NOT NULL default '0',   trusted tinyint(1) default '1',   views int(11) NOT NULL default '0',   PRIMARY KEY  (id),   KEY trusted (trusted),   KEY trusted_2 (trusted),   KEY catid (catid) ) TYPE=MyISAM;
CREATE TABLE phpnews_categories (   id int(3) unsigned NOT NULL auto_increment,   catname varchar(40) NOT NULL,   caticon tinytext NOT NULL,   PRIMARY KEY  (id) ) TYPE=MyISAM;
CREATE TABLE phpnews_posters (   id int(5) unsigned auto_increment,   username varchar(40) NOT NULL default '',   password varchar(50) NOT NULL,   email varchar(50),   avatar tinytext,   language varchar(10),   access varchar(20) NOT NULL,   PRIMARY KEY  (id) ) TYPE=MyISAM;
CREATE TABLE phpnews_settings (   variable char(20) NOT NULL,   value text NOT NULL ) TYPE=MyISAM;
