  -- if S.TODO = (EVAL (NExprBinaryOpGreater expression_1 expression_2 metadata)) :: ptask_tail*

rule PhpStep/comparison-greaterequal: S ~> S[.TODO = [$at_task($origin_child(S.ORIGIN, [PCFIELD 0]), EVAL expression_1), BINARY_LEFT GREATEREQUAL expression_2 $runtime_line(S, [PCFIELD 1], expression_2)] ++ ptask_tail*]
  -- if S.TODO = (EVAL (NExprBinaryOpGreaterOrEqual expression_1 expression_2 metadata)) :: ptask_tail*

rule PhpStep/comparison-spaceship: S ~> S[.TODO = [$at_task($origin_child(S.ORIGIN, [PCFIELD 0]), EVAL expression_1), BINARY_LEFT SPACESHIP expression_2 $runtime_line(S, [PCFIELD 1], expression_2)] ++ ptask_tail*]
  -- if S.TODO = (EVAL (NExprBinaryOpSpaceship expression_1 expression_2 metadata)) :: ptask_tail*
