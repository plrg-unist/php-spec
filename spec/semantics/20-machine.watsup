;; Request state and pending work are explicit; PHP effects never use host I/O.
syntax pvalue = PNULL | PBOOL bool | PINT int | PFLOAT nat | PSTRING nat* | PARRAY nat
syntax pkey = KINT int | KSTRING nat*
syntax pitem = DIRECT pvalue | UNINITIALIZED | ALIAS nat
syntax pentry = ENTRY pkey pitem
syntax parray = { ITEMS pentry*, NEXT int }
syntax pevent = OUTPUT nat* | WARNING nat* int | DIAGNOSTIC text nat* int
syntax pcompletion = NORMAL | PHPERROR nat* int | THROWN text nat* int | STATICERROR text int | UNSUPPORTED text | BUDGET
syntax pcheck = READY | REJECT pcompletion
syntax peval = VALUE pvalue | ABRUPT pcompletion
syntax pbin = ADD | SUBTRACT | MULTIPLY | DIVIDE | IDENTICAL | NOTIDENTICAL
syntax punary = POSITIVE | NEGATIVE
syntax pcomparison = COMPARED bool | RECURSIVE
var z : int

dec $metadata_line(metadataEntry) : int
def $metadata_line(MstartLine z) = z
def $metadata_line(metadataEntry) = 0
  -- otherwise

dec $source_line(metadata) : int
def $source_line(eps) = 0
def $source_line(metadataEntry :: metadataEntry_tail*) = z
  -- if z = $metadata_line(metadataEntry)
  -- if $(z > 0)
def $source_line(metadataEntry :: metadataEntry_tail*) = $source_line(metadataEntry_tail*)
  -- if $($metadata_line(metadataEntry) <= 0)

dec $metadata_end_line(metadataEntry) : int
def $metadata_end_line(MendLine z) = z
def $metadata_end_line(metadataEntry) = 0
  -- otherwise
dec $source_end_line(metadata) : int
def $source_end_line(eps) = 0
def $source_end_line(metadataEntry :: metadataEntry_tail*) = z
  -- if z = $metadata_end_line(metadataEntry)
  -- if $(z > 0)
def $source_end_line(metadataEntry :: metadataEntry_tail*) = $source_end_line(metadataEntry_tail*)
  -- if $($metadata_end_line(metadataEntry) <= 0)

dec $expression_line(expression) : int
dec $variable_line(phpType34, metadata) : int
def $variable_line(BYTES text, metadata) = $source_line(metadata)
def $variable_line(phpType34, metadata) = $expression_line(expression)
  -- if phpType34 = expression
def $expression_line(NScalarString phpType35 metadata) = $source_line(metadata)
def $expression_line(NScalarInt phpType24 metadata) = $source_line(metadata)
def $expression_line(NScalarFloat phpType43 metadata) = $source_line(metadata)
def $expression_line(NExprConstFetch name metadata) = $source_line(metadata)
def $expression_line(NExprVariable phpType34 metadata) = $variable_line(phpType34, metadata)
def $expression_line(NExprAssign expression_1 expression_2 metadata) = $expression_line(expression_1)
def $expression_line(NExprAssignRef expression_1 expression_2 metadata) = $expression_line(expression_1)
def $expression_line(NExprBinaryOpPlus expression_1 expression_2 metadata) = $expression_line(expression_1)
def $expression_line(NExprBinaryOpMinus expression_1 expression_2 metadata) = $expression_line(expression_1)
def $expression_line(NExprBinaryOpMul expression_1 expression_2 metadata) = $expression_line(expression_1)
def $expression_line(NExprBinaryOpDiv expression_1 expression_2 metadata) = $expression_line(expression_1)
def $expression_line(NExprUnaryPlus expression metadata) = $expression_line(expression)
def $expression_line(NExprUnaryMinus expression metadata) = $expression_line(expression)
def $expression_line(NExprBinaryOpIdentical expression_1 expression_2 metadata) = $expression_line(expression_1)
def $expression_line(NExprBinaryOpNotIdentical expression_1 expression_2 metadata) = $expression_line(expression_1)
def $expression_line(NExprArray (SEQUENCE eps) metadata) = $source_end_line(metadata)
def $expression_line(NExprArray (SEQUENCE ((NArrayItem phpType5 expression phpType4_1 phpType4_2 metadata_item) :: phpType13_tail*)) metadata) = $expression_line(expression)
def $expression_line(NExprArrayDimFetch expression phpType5 metadata) = $expression_line(expression)
def $expression_line(expression) = 0
  -- otherwise

;; Zend emits consumers with the current compiler line after child compilation.
;; This differs from the AST start line and assignment's explicit LHS reset.
dec $assignment_self(expression, expression) : bool
dec $compiled_line(expression) : int
dec $array_is_constant(expression) : bool
dec $array_last_line(phpType13*) : int
def $array_last_line([NArrayItem phpType5 expression phpType4_1 phpType4_2 metadata]) = $compiled_line(expression)
def $array_last_line(phpType13 :: phpType13_tail*) = $array_last_line(phpType13_tail*)
  -- if phpType13_tail* =/= eps
def $compiled_line(NExprVariable (BYTES text) metadata) = $source_line(metadata)
def $compiled_line(NExprVariable phpType34 metadata) = $compiled_line(expression)
  -- if phpType34 = expression
def $compiled_line(NExprAssign (NExprVariable phpType34 metadata_var) expression metadata) = $variable_line(phpType34, metadata_var)
def $compiled_line(NExprAssign (NExprArrayDimFetch expression_base phpType5 metadata_dim) expression metadata) = $compiled_line(expression)
  -- if ~$assignment_self(NExprArrayDimFetch expression_base phpType5 metadata_dim, expression)
def $compiled_line(NExprAssign (NExprArrayDimFetch expression_base phpType5 metadata_dim) expression metadata) = $compiled_line(NExprArrayDimFetch expression_base phpType5 metadata_dim)
  -- if $assignment_self(NExprArrayDimFetch expression_base phpType5 metadata_dim, expression)
def $compiled_line(NExprAssignRef expression_1 expression_2 metadata) = $compiled_line(expression_2)
def $compiled_line(NExprBinaryOpPlus expression_1 expression_2 metadata) = $compiled_line(expression_2)
def $compiled_line(NExprBinaryOpMinus expression_1 expression_2 metadata) = $compiled_line(expression_2)
def $compiled_line(NExprBinaryOpMul expression_1 expression_2 metadata) = $compiled_line(expression_2)
def $compiled_line(NExprBinaryOpDiv expression_1 expression_2 metadata) = $compiled_line(expression_2)
def $compiled_line(NExprBinaryOpIdentical expression_1 expression_2 metadata) = $compiled_line(expression_2)
def $compiled_line(NExprBinaryOpNotIdentical expression_1 expression_2 metadata) = $compiled_line(expression_2)
def $compiled_line(NExprUnaryPlus expression metadata) = $compiled_line(expression)
def $compiled_line(NExprUnaryMinus expression metadata) = $compiled_line(expression)
def $compiled_line(NExprArray (SEQUENCE phpType13*) metadata) = $expression_line(NExprArray (SEQUENCE phpType13*) metadata)
  -- if $array_is_constant(NExprArray (SEQUENCE phpType13*) metadata)
def $compiled_line(NExprArray (SEQUENCE phpType13*) metadata) = $array_last_line(phpType13*)
  -- if ~$array_is_constant(NExprArray (SEQUENCE phpType13*) metadata)
def $compiled_line(NExprArrayDimFetch expression ABSENT metadata) = $compiled_line(expression)
def $compiled_line(NExprArrayDimFetch expression phpType5 metadata) = $compiled_line(expression_key)
  -- if phpType5 = expression_key
def $compiled_line(expression) = $expression_line(expression)
  -- otherwise

dec $header_literal(phpType34) : bool
def $header_literal(BYTES text) = ($base64(text) = [104,116,116,112,95,114,101,115,112,111,110,115,101,95,104,101,97,100,101,114])
def $header_literal(NScalarString (BYTES text) metadata) = $header_literal(BYTES text)
def $header_literal(phpType34) = false
  -- otherwise

dec $check_assignment_target(expression) : pcheck
dec $check_unset_target(expression) : pcheck
dec $check_lvalue(expression) : pcheck
dec $check_variable(phpType34) : pcheck
dec $array_name_fold_warning(phpType34) : bool
dec $name_fold_warning(phpType34) : bool
dec $check_array_items(phpType13*) : pcheck
dec $context_error(text, int) : pcheck
def $context_error(text, z) = REJECT (STATICERROR text z)
  -- if $(z > 0)
def $context_error(text, z) = REJECT (UNSUPPORTED "missing source line")
  -- if $(z <= 0)

dec $check_expression(expression) : pcheck
def $check_expression(NScalarString (BYTES text) metadata) = READY
def $check_expression(NScalarInt (INTEGER z) metadata) = READY
def $check_expression(NScalarFloat (FLOAT text) metadata) = READY
def $check_expression(NExprConstFetch (NName (BYTES text) metadata_1) metadata_2) = READY
def $check_expression(NExprVariable phpType34 metadata) = $check_variable(phpType34)
def $check_expression(NExprAssign expression_1 expression_2 metadata) = $check_expression(expression_2)
  -- if $check_assignment_target(expression_1) = READY
def $check_expression(NExprAssign expression_1 expression_2 metadata) = REJECT pcompletion
  -- if $check_assignment_target(expression_1) = REJECT pcompletion
def $check_expression(NExprAssignRef expression_1 expression_2 metadata) = $check_lvalue(expression_2)
  -- if $check_lvalue(expression_1) = READY
def $check_expression(NExprAssignRef expression_1 expression_2 metadata) = REJECT pcompletion
  -- if $check_lvalue(expression_1) = REJECT pcompletion
def $check_expression(NExprBinaryOpPlus expression_1 expression_2 metadata) = $check_expression(expression_2)
  -- if $check_expression(expression_1) = READY
def $check_expression(NExprBinaryOpPlus expression_1 expression_2 metadata) = REJECT pcompletion
  -- if $check_expression(expression_1) = REJECT pcompletion
def $check_expression(NExprBinaryOpMinus expression_1 expression_2 metadata) = $check_expression(expression_2)
  -- if $check_expression(expression_1) = READY
def $check_expression(NExprBinaryOpMinus expression_1 expression_2 metadata) = REJECT pcompletion
  -- if $check_expression(expression_1) = REJECT pcompletion
def $check_expression(NExprBinaryOpMul expression_1 expression_2 metadata) = $check_expression(expression_2)
  -- if $check_expression(expression_1) = READY
def $check_expression(NExprBinaryOpMul expression_1 expression_2 metadata) = REJECT pcompletion
  -- if $check_expression(expression_1) = REJECT pcompletion
def $check_expression(NExprBinaryOpDiv expression_1 expression_2 metadata) = $check_expression(expression_2)
  -- if $check_expression(expression_1) = READY
def $check_expression(NExprBinaryOpDiv expression_1 expression_2 metadata) = REJECT pcompletion
  -- if $check_expression(expression_1) = REJECT pcompletion
def $check_expression(NExprUnaryPlus expression metadata) = $check_expression(expression)
def $check_expression(NExprUnaryMinus expression metadata) = $check_expression(expression)
def $check_expression(NExprBinaryOpIdentical expression_1 expression_2 metadata) = $check_expression(expression_2)
  -- if $check_expression(expression_1) = READY
def $check_expression(NExprBinaryOpIdentical expression_1 expression_2 metadata) = REJECT pcompletion
  -- if $check_expression(expression_1) = REJECT pcompletion
def $check_expression(NExprBinaryOpNotIdentical expression_1 expression_2 metadata) = $check_expression(expression_2)
  -- if $check_expression(expression_1) = READY
def $check_expression(NExprBinaryOpNotIdentical expression_1 expression_2 metadata) = REJECT pcompletion
  -- if $check_expression(expression_1) = REJECT pcompletion
def $check_expression(NExprArray (SEQUENCE phpType13*) metadata) = $check_array_items(phpType13*)
def $check_expression(NExprArrayDimFetch expression ABSENT metadata) = $context_error("Cannot use [] for reading", $compiled_line(expression))
  -- if $check_expression(expression) = READY
def $check_expression(NExprArrayDimFetch expression ABSENT metadata) = REJECT pcompletion
  -- if $check_expression(expression) = REJECT pcompletion
def $check_expression(NExprArrayDimFetch expression_1 phpType5 metadata) = $check_expression(expression_2)
  -- if phpType5 = expression_2
  -- if $check_expression(expression_1) = READY
def $check_expression(NExprArrayDimFetch expression_1 phpType5 metadata) = REJECT pcompletion
  -- if phpType5 = expression_2
  -- if $check_expression(expression_1) = REJECT pcompletion
def $check_expression(expression) = REJECT (UNSUPPORTED "expression")
  -- otherwise

def $check_array_items(eps) = READY
def $check_array_items((NArrayItem ABSENT expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType13_tail*) = $check_array_items(phpType13_tail*)
  -- if $check_expression(expression) = READY
def $check_array_items((NArrayItem ABSENT expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType13_tail*) = REJECT pcompletion
  -- if $check_expression(expression) = REJECT pcompletion
def $check_array_items((NArrayItem phpType5 expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType13_tail*) = $check_array_items(phpType13_tail*)
  -- if phpType5 = expression_key
  -- if $check_expression(expression_key) = READY
  -- if $check_expression(expression) = READY
def $check_array_items((NArrayItem phpType5 expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType13_tail*) = REJECT pcompletion
  -- if phpType5 = expression_key
  -- if $check_expression(expression_key) = REJECT pcompletion
def $check_array_items((NArrayItem phpType5 expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType13_tail*) = REJECT pcompletion
  -- if phpType5 = expression_key
  -- if $check_expression(expression_key) = READY
  -- if $check_expression(expression) = REJECT pcompletion
def $check_array_items(phpType13*) = REJECT (UNSUPPORTED "array references or unpacking")
  -- otherwise

def $check_assignment_target(NExprVariable phpType34 metadata) = $check_variable(phpType34)
  -- if ~$header_literal(phpType34)
def $check_assignment_target(NExprVariable phpType34 metadata) = READY
  -- if $header_literal(phpType34)
def $check_assignment_target(NExprArrayDimFetch expression ABSENT metadata) = $check_assignment_target(expression)
def $check_assignment_target(NExprArrayDimFetch expression phpType5 metadata) = $check_expression(expression_key)
  -- if phpType5 = expression_key
  -- if $check_assignment_target(expression) = READY
def $check_assignment_target(NExprArrayDimFetch expression phpType5 metadata) = REJECT pcompletion
  -- if phpType5 = expression_key
  -- if $check_assignment_target(expression) = REJECT pcompletion
def $check_assignment_target(expression) = REJECT (UNSUPPORTED "lvalue")
  -- otherwise


def $check_lvalue(NExprVariable phpType34 metadata) = $check_variable(phpType34)
  -- if ~$header_literal(phpType34)
def $check_lvalue(NExprVariable phpType34 metadata) = READY
  -- if $header_literal(phpType34)
def $check_lvalue(expression) = REJECT (UNSUPPORTED "lvalue")
  -- otherwise

def $check_variable(BYTES text) = READY
  -- if ~$header_literal(BYTES text)
def $check_variable(phpType34) = REJECT (UNSUPPORTED "compile-time http_response_header context")
  -- if $header_literal(phpType34)
def $check_variable(phpType34) = REJECT (UNSUPPORTED "compile-time NaN name diagnostic")
  -- if $name_fold_warning(phpType34)
def $check_variable(phpType34) = REJECT (UNSUPPORTED "compile-time array name diagnostic")
  -- if $array_name_fold_warning(phpType34)
def $check_variable(phpType34) = $check_expression(expression)
  -- if phpType34 = expression
  -- if ~$name_fold_warning(phpType34)
  -- if ~$array_name_fold_warning(phpType34)
  -- if ~$header_literal(phpType34)

def $check_unset_target(NExprVariable phpType34 metadata) = $check_variable(phpType34)
  -- if ~$header_literal(phpType34)
def $check_unset_target(NExprVariable phpType34 metadata) = READY
  -- if $header_literal(phpType34)
def $check_unset_target(NExprArrayDimFetch expression ABSENT metadata) = $context_error("Cannot use [] for unsetting", $compiled_line(expression))
  -- if $check_unset_target(expression) = READY
def $check_unset_target(NExprArrayDimFetch expression phpType5 metadata) = REJECT pcompletion
  -- if $check_unset_target(expression) = REJECT pcompletion
def $check_unset_target(NExprArrayDimFetch expression phpType5 metadata) = $check_expression(expression_key)
  -- if phpType5 = expression_key
  -- if $check_unset_target(expression) = READY
def $check_unset_target(expression) = REJECT (UNSUPPORTED "unset target")
  -- otherwise

dec $check_unsets(expression*) : pcheck
def $check_unsets(eps) = READY
def $check_unsets(expression :: expression_tail*) = $check_unsets(expression_tail*)
  -- if $check_unset_target(expression) = READY
def $check_unsets(expression :: expression_tail*) = REJECT pcompletion
  -- if $check_unset_target(expression) = REJECT pcompletion

dec $check_expressions(expression*) : pcheck
def $check_expressions(eps) = READY
def $check_expressions(expression :: expression_tail*) = $check_expressions(expression_tail*)
  -- if $check_expression(expression) = READY
def $check_expressions(expression :: expression_tail*) = REJECT pcompletion
  -- if $check_expression(expression) = REJECT pcompletion

dec $check_statements(statement*) : pcheck
dec $check_statement(statement) : pcheck
def $check_statement(NStmtNop metadata) = READY
def $check_statement(NStmtInlineHTML (BYTES text) metadata) = READY
def $check_statement(NStmtEcho (SEQUENCE expression_tail*) metadata) = $check_expressions(expression_tail*)
def $check_statement(NStmtExpression expression metadata) = $check_expression(expression)
def $check_statement(NStmtUnset (SEQUENCE expression_tail*) metadata) = $check_unsets(expression_tail*)
def $check_statement(NStmtBlock (SEQUENCE statement_tail*) metadata) = $check_statements(statement_tail*)
def $check_statement(NStmtBreak ABSENT metadata) = REJECT (STATICERROR "'break' not in the 'loop' or 'switch' context" z)
  -- if z = $source_line(metadata)
  -- if $(z > 0)
def $check_statement(NStmtBreak ABSENT metadata) = REJECT (UNSUPPORTED "missing source line")
  -- if $($source_line(metadata) <= 0)
def $check_statement(statement) = REJECT (UNSUPPORTED "statement")
  -- otherwise

def $check_statements(eps) = READY
def $check_statements(statement :: statement_tail*) = $check_statements(statement_tail*)
  -- if $check_statement(statement) = READY
def $check_statements(statement :: statement_tail*) = REJECT pcompletion
  -- if $check_statement(statement) = REJECT pcompletion

dec $lower_byte(nat) : nat
def $lower_byte(n) = $(n + 32)
  -- if $(n >= 65)
  -- if $(n <= 90)
def $lower_byte(n) = n
  -- otherwise

dec $builtin_value(text) : pvalue?
def $builtin_value("UEhQX0lOVF9NQVg=") = (PINT 9223372036854775807)
def $builtin_value("UEhQX0lOVF9NSU4=") = (PINT $(-9223372036854775808))
def $builtin_value("UEhQX0lOVF9TSVpF") = (PINT 8)
def $builtin_value("RV9BTEw=") = (PINT 30719)
def $builtin_value("SU5G") = (PFLOAT 9218868437227405312)
def $builtin_value("TkFO") = (PFLOAT 9221120237041090560)
def $builtin_value(text) = eps
  -- otherwise

dec $constant(text, nat*, int) : peval
def $constant(text, n*, z) = VALUE pvalue
  -- if $builtin_value(text) = (pvalue)
def $constant(text, n*, z) = VALUE PNULL
  -- if ($lower_byte(n))* = [110, 117, 108, 108]
def $constant(text, n*, z) = VALUE (PBOOL true)
  -- if ($lower_byte(n))* = [116, 114, 117, 101]
def $constant(text, n*, z) = VALUE (PBOOL false)
  -- if ($lower_byte(n))* = [102, 97, 108, 115, 101]
def $constant(text, n*, z) = ABRUPT (UNSUPPORTED "initial constant")
  -- if $initial_constant(text)
  -- if $builtin_value(text) = eps
  -- if ($lower_byte(n))* =/= [110, 117, 108, 108]
  -- if ($lower_byte(n))* =/= [116, 114, 117, 101]
  -- if ($lower_byte(n))* =/= [102, 97, 108, 115, 101]
def $constant(text, n*, z) = ABRUPT (UNSUPPORTED "missing source line")
  -- if $(z <= 0)
  -- if ($lower_byte(n))* =/= [110, 117, 108, 108]
  -- if ($lower_byte(n))* =/= [116, 114, 117, 101]
  -- if ($lower_byte(n))* =/= [102, 97, 108, 115, 101]
  -- if ~$initial_constant(text)
def $constant(text, n*, z) = ABRUPT (PHPERROR n* z)
  -- otherwise

dec $evaluate(expression) : peval
def $evaluate(NScalarString (BYTES text) metadata) = VALUE (PSTRING $base64(text))
def $evaluate(NScalarInt (INTEGER z) metadata) = VALUE (PINT z)
def $evaluate(NScalarFloat (FLOAT text) metadata) = VALUE (PFLOAT $hex_bits(text, 0))
def $evaluate(NExprConstFetch (NName (BYTES text) metadata_1) metadata_2) = $constant(text, $base64(text), $source_line(metadata_2))
def $evaluate(expression) = ABRUPT (UNSUPPORTED "expression")
  -- otherwise

dec $echo_value(pvalue) : nat*
def $echo_value(PNULL) = eps
def $echo_value(PBOOL false) = eps
def $echo_value(PBOOL true) = [49]
def $echo_value(PINT z) = $decimal_integer(z)
def $echo_value(PSTRING n*) = n*
def $echo_value(PFLOAT n) = n_out*
  -- if (n_out*, b_warning) = $number_text(NFLOAT n, 14)

