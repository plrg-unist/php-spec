;; Request state and pending work are explicit; PHP effects never use host I/O.
syntax pvalue = PNULL | PBOOL bool | PINT int | PFLOAT nat | PSTRING nat*
syntax pevent = OUTPUT nat* | WARNING nat* int
syntax pcompletion = NORMAL | PHPERROR nat* int | STATICERROR text int | UNSUPPORTED text | BUDGET
syntax pcheck = READY | REJECT pcompletion
syntax peval = VALUE pvalue | ABRUPT pcompletion
var n : nat
var z : int

dec $metadata_line(metadataEntry) : int
def $metadata_line(MstartLine z) = z
def $metadata_line(metadataEntry) = 0
  -- otherwise

dec $source_line(metadata) : int
def $source_line(eps) = 0
def $source_line(metadataEntry :: metadataEntry_tail*) = z
  -- if z = $metadata_line(metadataEntry)
  -- if $(z > 0)
def $source_line(metadataEntry :: metadataEntry_tail*) = $source_line(metadataEntry_tail*)
  -- if $($metadata_line(metadataEntry) <= 0)

dec $expression_line(expression) : int
dec $variable_line(phpType34, metadata) : int
def $variable_line(BYTES text, metadata) = $source_line(metadata)
def $variable_line(phpType34, metadata) = $expression_line(expression)
  -- if phpType34 = expression
def $expression_line(NScalarString phpType35 metadata) = $source_line(metadata)
def $expression_line(NScalarInt phpType24 metadata) = $source_line(metadata)
def $expression_line(NExprConstFetch name metadata) = $source_line(metadata)
def $expression_line(NExprVariable phpType34 metadata) = $variable_line(phpType34, metadata)
def $expression_line(NExprAssign expression_1 expression_2 metadata) = $expression_line(expression_1)
def $expression_line(NExprAssignRef expression_1 expression_2 metadata) = $expression_line(expression_1)
def $expression_line(expression) = 0
  -- otherwise

;; This initial static pass checks supported statement forms before any effects.
dec $check_lvalue(expression) : pcheck
dec $check_variable(phpType34) : pcheck
dec $check_expression(expression) : pcheck
def $check_expression(NScalarString (BYTES text) metadata) = READY
def $check_expression(NScalarInt (INTEGER z) metadata) = READY
def $check_expression(NExprConstFetch (NName (BYTES text) metadata_1) metadata_2) = READY
def $check_expression(NExprVariable phpType34 metadata) = $check_variable(phpType34)
def $check_expression(NExprAssign expression_1 expression_2 metadata) = $check_expression(expression_2)
  -- if $check_lvalue(expression_1) = READY
def $check_expression(NExprAssign expression_1 expression_2 metadata) = REJECT pcompletion
  -- if $check_lvalue(expression_1) = REJECT pcompletion
def $check_expression(NExprAssignRef expression_1 expression_2 metadata) = $check_lvalue(expression_2)
  -- if $check_lvalue(expression_1) = READY
def $check_expression(NExprAssignRef expression_1 expression_2 metadata) = REJECT pcompletion
  -- if $check_lvalue(expression_1) = REJECT pcompletion
def $check_expression(expression) = REJECT (UNSUPPORTED "expression")
  -- otherwise

def $check_lvalue(NExprVariable phpType34 metadata) = $check_variable(phpType34)
def $check_lvalue(expression) = REJECT (UNSUPPORTED "lvalue")
  -- otherwise

def $check_variable(BYTES text) = READY
def $check_variable(phpType34) = $check_expression(expression)
  -- if phpType34 = expression

dec $check_unsets(expression*) : pcheck
def $check_unsets(eps) = READY
def $check_unsets(expression :: expression_tail*) = $check_unsets(expression_tail*)
  -- if $check_lvalue(expression) = READY
def $check_unsets(expression :: expression_tail*) = REJECT pcompletion
  -- if $check_lvalue(expression) = REJECT pcompletion

dec $check_expressions(expression*) : pcheck
def $check_expressions(eps) = READY
def $check_expressions(expression :: expression_tail*) = $check_expressions(expression_tail*)
  -- if $check_expression(expression) = READY
def $check_expressions(expression :: expression_tail*) = REJECT pcompletion
  -- if $check_expression(expression) = REJECT pcompletion

dec $check_statements(statement*) : pcheck
dec $check_statement(statement) : pcheck
def $check_statement(NStmtNop metadata) = READY
def $check_statement(NStmtInlineHTML (BYTES text) metadata) = READY
def $check_statement(NStmtEcho (SEQUENCE expression_tail*) metadata) = $check_expressions(expression_tail*)
def $check_statement(NStmtExpression expression metadata) = $check_expression(expression)
def $check_statement(NStmtUnset (SEQUENCE expression_tail*) metadata) = $check_unsets(expression_tail*)
def $check_statement(NStmtBlock (SEQUENCE statement_tail*) metadata) = $check_statements(statement_tail*)
def $check_statement(NStmtBreak ABSENT metadata) = REJECT (STATICERROR "'break' not in the 'loop' or 'switch' context" z)
  -- if z = $source_line(metadata)
  -- if $(z > 0)
def $check_statement(NStmtBreak ABSENT metadata) = REJECT (UNSUPPORTED "missing source line")
  -- if $($source_line(metadata) <= 0)
def $check_statement(statement) = REJECT (UNSUPPORTED "statement")
  -- otherwise

def $check_statements(eps) = READY
def $check_statements(statement :: statement_tail*) = $check_statements(statement_tail*)
  -- if $check_statement(statement) = READY
def $check_statements(statement :: statement_tail*) = REJECT pcompletion
  -- if $check_statement(statement) = REJECT pcompletion

dec $lower_byte(nat) : nat
def $lower_byte(n) = $(n + 32)
  -- if $(n >= 65)
  -- if $(n <= 90)
def $lower_byte(n) = n
  -- otherwise

dec $constant(text, nat*, int) : peval
def $constant(text, n*, z) = VALUE PNULL
  -- if ($lower_byte(n))* = [110, 117, 108, 108]
def $constant(text, n*, z) = VALUE (PBOOL true)
  -- if ($lower_byte(n))* = [116, 114, 117, 101]
def $constant(text, n*, z) = VALUE (PBOOL false)
  -- if ($lower_byte(n))* = [102, 97, 108, 115, 101]
def $constant(text, n*, z) = ABRUPT (UNSUPPORTED "initial constant")
  -- if $initial_constant(text)
  -- if ($lower_byte(n))* =/= [110, 117, 108, 108]
  -- if ($lower_byte(n))* =/= [116, 114, 117, 101]
  -- if ($lower_byte(n))* =/= [102, 97, 108, 115, 101]
def $constant(text, n*, z) = ABRUPT (UNSUPPORTED "missing source line")
  -- if $(z <= 0)
  -- if ($lower_byte(n))* =/= [110, 117, 108, 108]
  -- if ($lower_byte(n))* =/= [116, 114, 117, 101]
  -- if ($lower_byte(n))* =/= [102, 97, 108, 115, 101]
  -- if ~$initial_constant(text)
def $constant(text, n*, z) = ABRUPT (PHPERROR n* z)
  -- otherwise

dec $evaluate(expression) : peval
def $evaluate(NScalarString (BYTES text) metadata) = VALUE (PSTRING $base64(text))
def $evaluate(NScalarInt (INTEGER z) metadata) = VALUE (PINT z)
def $evaluate(NExprConstFetch (NName (BYTES text) metadata_1) metadata_2) = $constant(text, $base64(text), $source_line(metadata_2))
def $evaluate(expression) = ABRUPT (UNSUPPORTED "expression")
  -- otherwise

dec $echo_value(pvalue) : nat*
def $echo_value(PNULL) = eps
def $echo_value(PBOOL false) = eps
def $echo_value(PBOOL true) = [49]
def $echo_value(PINT z) = $decimal_integer(z)
def $echo_value(PSTRING n*) = n*

