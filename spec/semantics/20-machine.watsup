def $string_line(metadata) = $source_line(metadata)
  -- if $string_kind(metadata) = (z)
  -- if (z = 1 \/ z = 2)
def $string_line(metadata) = $($source_line(metadata) + 1)
  -- if $string_kind(metadata) = (z)
  -- if (z = 3 \/ z = 4)
  -- if $($source_line(metadata) > 0)
def $string_line(metadata) = $source_line(metadata)
