;; Ordinary construction has already initialized templates and allocated This.
;; Its parameter cache is the selected method's existing request-shared cache.
dec $parameter_constructor_site(pstate, porigin) : bool
def $parameter_constructor_site(S, porigin) = true
  -- if $origin_node(S.SOURCES, porigin) = (NExprNew phpType28 (SEQUENCE phpType7*) metadata)
def $parameter_constructor_site(S, porigin) = false -- otherwise
dec $parameter_constructor_selection(pstate, porigin, porigin) : bool
def $parameter_constructor_selection(S, PORIGIN n_unit pcpath, porigin_called) = true
  -- if $origin_node(S.SOURCES, PORIGIN n_unit pcpath) = (NExprNew name (SEQUENCE phpType7*) metadata)
  -- if ~$ordinary_keyword_new_site(S, PORIGIN n_unit pcpath)
  -- if $code_at(S.CODE, n_unit) = (pcode)
  -- if $code_name(pcode.NAMES, pcpath) = ((preqbytes, eps))
  -- if $class_named(S.CLASSNAMES, $ptlc(preqbytes)) = (porigin_called)
def $parameter_constructor_selection(S, porigin, porigin_called) = false -- otherwise
dec $parameter_constructor_invocation(pstate, pfunction, pdeclcalls, nat) : bool
def $parameter_constructor_invocation(S, pfunction, (porigin_function, porigin_site_option?, porigin_owner_option?, porigin_called_option?) :: pdeclcalls, n_prefix) = true
  -- if porigin_function = pfunction.ORIGIN
  -- if porigin_site_option? = (porigin_site)
  -- if porigin_owner_option? = (porigin_owner)
  -- if porigin_called_option? = (porigin_called)
  -- if $parameter_method_source(S, pfunction) = (pmethoddesc)
  -- if pmethoddesc.OWNER = porigin_owner
  -- if $ptlc(pmethoddesc.NAME) = $ptascii("__construct")
  -- if pmethoddesc.VISIBILITY = PROPERTY_PUBLIC /\ ~pmethoddesc.STATIC
  -- if $parameter_constructor_selection(S, porigin_site, porigin_called)
  -- if $effective_method(S, porigin_called, $ptascii("__construct"), |S.CLASSES|) = (pmethoddesc)
  -- if $parameter_callable_function_published(S, pfunction, n_prefix)
  -- if $(n_prefix <= |S.DECLARATIONS|)
  -- if $constant_callable_published(S.DECLARATIONS[0:n_prefix], porigin_called)
  -- if $declaration_invocation(S, pfunction, porigin_site, (porigin_owner), (porigin_called), pdeclcalls)
def $parameter_constructor_invocation(S, pfunction, pdeclcalls, n_prefix) = false -- otherwise
def $parameter_method_invocation(S, pfunction, pdeclcalls, n_prefix) = true
  -- if $parameter_constructor_invocation(S, pfunction, pdeclcalls, n_prefix)

;; The real caller continuation owns the allocated result, independently of the
;; active method's receiver. Historical calls retain neither of those roots.
dec $parameter_constructor_current(pstate, pfunction) : bool
def $parameter_constructor_current(S, pfunction) = true
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.TARGET = METHOD_TARGET n pfunction.ORIGIN
  -- if pcallcontext.FUNCTION = pfunction.ORIGIN
  -- if pcallcontext.CALLSITE = (porigin_site)
  -- if pcallcontext.INSTANCE = eps /\ pcallcontext.WRAPPER = eps /\ pcallcontext.CACHE = eps
  -- if pcallcontext.RECEIVER = (n)
  -- if $(n < |S.OBJECTS|) /\ (HOBJECT n) <- S.ALLOCATIONS
  -- if $object_class_origin(S, n) = (porigin_called)
  -- if $parameter_method_source(S, pfunction) = (pmethoddesc)
  -- if pcallcontext.LEXICAL_CLASS = (pmethoddesc.OWNER) /\ pcallcontext.CALLED_CLASS = (porigin_called)
  -- if $target_function(S, METHOD_TARGET n pfunction.ORIGIN) = (pfunction)
  -- if $method_call_selected(S, METHOD_TARGET n pfunction.ORIGIN, (porigin_site))
  -- if pdeclcause = $declaration_cause(S)
  -- if $parameter_constructor_invocation(S, pfunction, pdeclcause.CALLS, |S.DECLARATIONS|)
  -- if S.FRAMES = pframe :: pframe_tail*
  -- if pframe.TODO = (CTOR_RESULT n) :: ptask_tail*
  -- if pframe.ORIGIN = (porigin_site)
  -- if $ctor_result_valid($constant_frame_scope(S, pframe, pframe_tail*), n)
def $parameter_constructor_current(S, pfunction) = false -- otherwise
def $parameter_method_current_valid(S, pfunction) = $parameter_constructor_current(S, pfunction)
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.CALLSITE = (porigin_site)
  -- if $parameter_constructor_site(S, porigin_site)

;; The selected source donor also gates hits containing an earlier scalar.
;; Existing non-Deprecated/scalar entry and explicit method calls keep their route.
def $default_nonclosure_recipient(S, pfunction, pdefault) = $parameter_constructor_current(S, pfunction)
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.CALLSITE = (porigin_site)
  -- if $parameter_constructor_site(S, porigin_site)
  -- if $parameter_default_owned_source(S, pdefault.ORIGIN)

;; The C warning-exit reconstruction must preserve the automatic constructor's
;; failed flag before its receiver can lose the final owner during unwinding.
def $deprecated_handler_exit_scope(S, S_scoped) = $constructor_failed(S_scoped)
  -- if S.CURRENT = (pcallcontext)
  -- if $receiving_function(S, pcallcontext.FUNCTION) = (pfunction)
  -- if $parameter_constructor_current(S, pfunction)

;; Ordinary body exit otherwise discards the saved CTOR_RESULT when replacing
;; its continuation. Mark the real automatic constructor before that happens.
def $closure_call_copy_exit_scope(S, S_exit) = $constructor_failed(S_exit)
  -- if S.CURRENT = (pcallcontext)
  -- if $receiving_function(S, pcallcontext.FUNCTION) = (pfunction)
  -- if $parameter_constructor_current(S, pfunction)
  -- if ~$closure_call_copy_exit_pending(S)
  -- if $closure_call_copy_cleanup_exit(S) = eps
  -- if ~$deprecated_handler_exit_ready(S)
