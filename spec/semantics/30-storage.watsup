;; Names designate cells. Rebinding a name changes its cell, not the old cell's value.
syntax pslot = UNDEFINED | DEFINED pvalue
syntax pbinding = BIND nat* nat
syntax porigin = PORIGIN nat pcpath | TRAIT_ORIGIN porigin porigin ptbytes | TRAIT_MEMBER_ORIGIN porigin porigin
;; Retired array identity is non-owning, local to one active or saved call.
syntax pretiredkind = RET_SWITCH_VAR_ARRAY | RET_FOREACH_VALUE_ARRAY
syntax pretiredowner = { OWNER porigin, FIRSTRETURN porigin, FIRSTLINE int, LASTRETURN porigin, LASTLINE int, KIND pretiredkind, ARRAY nat, POSITION nat? }
syntax ppropertyid = porigin | INTERNAL_PROPERTY text ptbytes
syntax pstaticcompound = { CLASS porigin, DECL ppropertyid, CELL nat?, VERIFY bool, ENTRY nat }
syntax plocation = ROOT nat | ELEMENT nat pkey | PROPERTY nat ptbytes | CLASS_STATIC ppropertyid | STATIC_COMPOUND pstaticcompound | NOWHERE
syntax poperand = KNOWN pvalue | VARIABLE nat* int | REFERENCE nat | BORROWED plocation
syntax pbase = BASE_VALUE poperand | BASE_GLOBAL poperand int | BASE_NAME poperand int | BASE_DIM pbase poperand int | BASE_APPEND pbase int | BASE_PLACE porigin plocation | BASE_RETURNED porigin nat | BASE_PROPERTY pvalue ptbytes | BASE_PROPERTY_PENDING pbase poperand int | BASE_CHAIN_PROPERTY pvalue ptbytes int | BASE_CLASS_STATIC porigin ptbytes | BASE_CLASS_STATIC_PENDING poperand poperand | BASE_SHORT
syntax pnode = HCELL nat | HARRAY nat | HOBJECT nat
syntax pvstage = PVFOLD | PVEXEC
syntax pvalueclass = PVSCALAR | PVSTRING bool | PVARRAY bool (pkey, pvalueclass)* | PVCLOSURE nat porigin | PVOBJECT | PVINSTANCE nat porigin
syntax parrayselection = { SITE porigin, INIT int, LINE int, REQUESTED porigin, NAME ptbytes }
syntax pstringselection = { SITE porigin, INIT int, LINE int, REQUESTED porigin, ORIGINAL ptbytes }
syntax pmethodcapture = { FUNCTION porigin, CALLSITE porigin?, LEXICAL_CLASS porigin?, CALLED_CLASS porigin? }
syntax pcallableaccess = { SITE porigin?, SCOPE porigin?, OBJECT bool, CREATION pmethodcapture? }
syntax papiquery
syntax pfibercallable
syntax pfiberrawapi
syntax pcalltarget = porigin | FIBER_REPORTING_TARGET | FIBER_API_TARGET nat | FIBER_ARRAY_TARGET pfiberrawapi | CLOSURE_TARGET nat | CLOSURE_CALL_TARGET nat nat | METHOD_TARGET nat porigin | PROPERTY_GET_TARGET nat porigin | AGGREGATE_METHOD_TARGET nat porigin | AGGREGATE_GENERATOR_TARGET nat porigin nat porigin int | FOREACH_AGGREGATE_GENERATOR_TARGET nat porigin porigin int | YIELD_FROM_AGGREGATE_GENERATOR_TARGET nat porigin nat porigin int | STATIC_METHOD_TARGET porigin porigin | SCOPED_TARGET porigin porigin porigin nat? poperand | ARRAY_METHOD_TARGET pcalltarget parrayselection | STRING_METHOD_TARGET pcalltarget pstringselection | HANDLER_METHOD_TARGET bool porigin ptbytes pcalltarget | SCOPE_METHOD_TARGET pcalltarget pcallableaccess | API_METHOD_TARGET papiquery porigin ptbytes bool | FIBER_METHOD_TARGET pfibercallable
syntax parraymode = ARRAY_ADMISSION | ARRAY_DISPATCH
syntax parrayresolution = ARRAYRESOLVED pcalltarget porigin ptbytes | ARRAYADMITTED | ARRAYINVALID ptbytes | ARRAYUNKNOWN text
syntax pconstant = PCONSTANT pcpath pvalue | PCCLASS pcpath pvalueclass | PCCPRECISION pcpath int | PCCASSERTION pcpath nat*
syntax ppool = { UNIT nat, CONSTANTS pconstant* }
syntax pcodeexpr = CODEMATCH_LINE pcpath int | CODEMATCH_TABLE pcpath bool | CODEIMPLICIT pcpath ptbytes int | CODEARROW pcpath int | CODELEXICAL pcpath ptbytes bool int | CODESTATIC pcpath ptbytes int int bool | CODECALL_INIT pcpath int | CODEPIPE_SEND pcpath int | CODESWITCH_COMPARE pcpath int | CODESWITCH_BOOL pcpath bool | CODEGOTO pcpath pcpath | CODEARG pcpath | CODEWRITE pcpath int | CODEEXPR pcpath int bool | CODEEFFECT pcpath
syntax pcodename = CODENAME pcpath nat* (nat*)?
syntax pcoderedirect = CODEREDIRECT pcpath pcpath bool
syntax pcode = { STRICT bool, GLOBALS pcpath*, UNIT nat, EXPRESSIONS pcodeexpr*, NAMES pcodename*, REDIRECTS pcoderedirect* }
syntax pdefaultkind = PDSTORED | PDDEFERRED
syntax pdefault = { INDEX nat, ORIGIN porigin, KIND pdefaultkind }
syntax pfunction = { DEFAULTS pdefault*, ORIGIN porigin, NAME ptbytes, SIGNATURE pssignature, CVS ptbytes*, ENV plenv, CODE pcode, BODY pcpath, EARLY bool, LINE nat, ENDLINE nat }
syntax ppropertyvisibility = PROPERTY_PUBLIC | PROPERTY_PROTECTED | PROPERTY_PRIVATE
syntax pmethoddesc = { NAME ptbytes, FUNCTION pfunction, OWNER porigin, VISIBILITY ppropertyvisibility, STATIC bool, FINAL bool, ABSTRACT bool }
syntax ppropdefault = PROP_UNINITIALIZED | PROP_NULL | PROP_STORED porigin | PROP_LITERAL pvalue | PROP_DEFERRED porigin
syntax ppropertydesc = { ORIGIN ppropertyid, NAME ptbytes, KEY ptbytes, VISIBILITY ppropertyvisibility, SETVISIBILITY ppropertyvisibility?, FINAL bool, STATIC bool, READONLY bool, TYPE ptbranch*, DEFAULT ppropdefault, LINE nat }
syntax ppropstate = PROP_INITIAL | PROP_UNSET | PROP_VALUE pitem | PROP_DEFERRED porigin
syntax ppropertyslot = { DECL ppropertyid?, NAME ptbytes, STATE ppropstate }
syntax pobjectprops = { OBJECT nat, SLOTS ppropertyslot*, MATERIALIZED bool }
syntax pobjecttable = { OBJECT nat, TABLE nat }
syntax pobjectcast = { SITE porigin, LINE int, OBJECT nat, INPUT poperand, CELL nat?, REFERENCED bool }
syntax pobjectforeach = { SITE porigin, LINE int, OBJECT nat, OWNER pnode, ITERATOR nat, POSITION nat, TABLE nat, SERIAL nat, KEY ptbytes, REF bool }
syntax pproptypesource = OBJECT_PROP_SOURCE nat ptbytes ppropertyid | CLASS_PROP_SOURCE ppropertyid | RETIRED_CLASS_PROP_SOURCE porigin nat | COMPOUND_CLASS_PROP_SOURCE ppropertyid nat
syntax ppropref = { CELL nat, SOURCES pproptypesource* }
syntax prefcoercion = { CELL nat, SITE porigin, LINE int, VALUE ptbytes }
syntax ppropertystring = { SITE porigin, BASE pbase, TARGET nat, KEY ptbytes, DECL ppropertyid, RHS poperand, OBJECT nat, LINE int }
syntax pdynamicproperty = { SITE porigin, BASE pbase, TARGET nat, KEY ptbytes, RHS poperand, SELECTED poperand, LINE int, SELF bool, RETIRED bool, PENDING nat? }
syntax pstaticstring = { SITE porigin, CLASS porigin, DECL ppropertyid, NAME ptbytes, OBJECT nat, RHS poperand, LINE int }
syntax pparameterstring = { FUNCTION porigin, INDEX nat, CELL nat, OBJECT nat, LINE int }
syntax pvariadicstring = { FUNCTION porigin, INDEX nat, ELEMENT nat, NAMED bool, OPERAND poperand, OBJECT nat, LINE int }
syntax pparameterbacking = { FUNCTION porigin, INDEX nat, CELL nat, LINE int, VALUE ptbytes }
dec $propref_at(ppropref*, nat) : ppropref?
syntax pclosureevidence
syntax pdynamicnew
syntax ptraitcachecause
syntax pstaticselection = { SITE porigin, ROOT porigin, SCOPE porigin?, CALLED porigin?, CLOSURE pclosureevidence? }
syntax pclassconstantevent = CCLINK porigin nat | CCCACHE porigin porigin nat | CCUPDATE porigin porigin porigin nat | CCSTATIC porigin porigin nat | CCSTATICRETIRE porigin porigin nat nat | CCCOMPOUNDENTER pstaticcompound porigin int nat | CCCOMPOUNDRETIRE pstaticcompound nat porigin int nat | CCCOMPOUNDWRITE pstaticcompound porigin int ptbytes nat
  | CCCOMPOUNDSELECT pstaticcompound pstaticselection porigin int nat
  | CCSTATICSELECT porigin pstaticselection nat | CCSTATICRETIRESELECT porigin pstaticselection nat nat | CCUPDATESELECT porigin pstaticselection nat
  | CCINSTANCE porigin porigin porigin porigin pstaticselection? nat
  | CCUPDATENEW porigin pdynamicnew nat
  | CCSTATICNEW porigin pdynamicnew nat | CCSTATICRETIRENEW porigin pdynamicnew nat nat
  | CCTRAITCACHE porigin ptraitcachecause
  | CCTRAITBIRTH nat porigin ptraitcachecause
syntax pclassconstantflags = CCFLAGS (porigin, bool)* porigin* | CCBAD
syntax pclassconstantdesc = { ORIGIN porigin, OWNER porigin, OWNERNAME ptbytes, NAME ptbytes, VISIBILITY ppropertyvisibility, FINAL bool, TYPE ptbranch*, INITIALIZER porigin, FOLDED bool, LINE nat }
syntax ptraitcachecause = { CLASS porigin, ROOT porigin, TABLE pclassconstantdesc*, LOOKUPS porigin*, PREFIX nat, USERPREFIX nat }
dec $trait_cache_event_at(pclassconstantevent*, porigin) : ptraitcachecause?
dec $ppclass_constants(pclassconstantdesc*, porigin) : pclassconstantdesc*
syntax pclassdesc = { ORIGIN porigin, KIND text, NAME ptbytes, PARENT ptbytes?, INTERFACES ptbytes*, PROPERTIES ppropertydesc*, METHODS pmethoddesc*, CONSTANTS pclassconstantdesc*, ABSTRACT bool, FINAL bool, READONLY bool, EARLY bool, LINE nat }
syntax pclassparent = SOURCE_PARENT porigin | STDCLASS_PARENT | INTERNAL_THROWABLE_PARENT text
syntax pclasslink = CLASSLINK porigin pclassparent
syntax pilref = PILSOURCE ptbytes porigin | PILBUILTIN ptbytes
syntax pinterfacelink = { OWNER porigin, TARGETS pilref* }
syntax pmethodissue = METHOD_OK | METHOD_COMPILEISSUE ptbytes int | METHOD_ISSUE ptbytes int | METHOD_RUNTIMEISSUE ptbytes int | METHOD_FILEISSUE ptbytes int porigin | METHOD_UNSUPPORTED text
syntax pdynamicnew = { SITE porigin, SOURCE pvalue, CLASS ptbytes, LINE int, FETCHLINE int, SCOPE porigin?, CALLED porigin?, CLOSURE pclosureevidence? }
syntax pnoctorcall = { SITE porigin, CLASS ptbytes, OBJECT nat, ARGUMENTS phpType7*, INDEX nat, SENT poperand*, LINE int }
syntax pdefaultnew = { SITE porigin, CLASS ptbytes, OBJECT nat, ARGUMENTS phpType7*, INDEX nat, VALUES pvalue*, LINE int }
syntax psourcefile = SOURCEFILE nat nat*
syntax pevalphase = PARSER_WAIT | EVAL_COMPILE | UNIT_RUN
syntax pfailedkind = FAILED_PARSE | FAILED_COMPILE
syntax pconstantlocation = { CLASS porigin, ROOT porigin, CHILD porigin }
syntax pfailedsource = { UNIT nat, SITE porigin, BYTES nat*, FILE nat*, ISFILE bool, KIND pfailedkind, MESSAGE nat*, LINE int, LOCATION pconstantlocation? }
syntax pfilephase = FILE_RESOLVE_WAIT | FILE_PARSE_WAIT | FILE_UNIT_RUN | FILE_WARNING_STREAM nat* nat* | FILE_WARNING_OPEN nat*
syntax pfilebinding = { UNIT nat, SITE porigin, KIND int, REQUESTED nat*, RESOLVED nat*, OPENED nat*, BYTES nat*, CLASS porigin? }
syntax pfileopenresponse = FILE_MISSING nat nat* nat* nat* | FILE_OPEN_FAILURE nat nat* nat* nat* nat* nat* | FILE_OPENED nat nat* nat* nat* nat* nat*
syntax pdirresponse = DIR_CHANGED nat nat* nat* nat* | DIR_FAILED nat nat* nat* nat* nat
syntax psourceresponse = SOURCE_ACCEPT nat nat* program | SOURCE_PARSE_REJECT nat nat* nat* int | SOURCE_COMPILE_REJECT nat nat* nat* int
syntax pupdate = INCREMENT | DECREMENT
syntax psilence = SILENCE porigin int
syntax pnamedslot = NAMED_HOLE | NAMED_SENT poperand
syntax pnamedargs = { SLOTS pnamedslot*, NAMED (nat*, poperand)* }
syntax pdefaultctor = { NEW pdefaultnew, FUNCTION porigin, INDEX nat, PREPARED pnamedargs }
syntax punpackcall = { FUNCTION pcalltarget, ARGUMENTS phpType7*, INDEX nat, SENT pnamedargs, CALLSITE porigin?, LINE int }
syntax pintrinsic = INTRINSIC_ASSERT | INTRINSIC_ASSERT_OPTIONS | INTRINSIC_GC_COLLECT | INTRINSIC_GC_ENABLE | INTRINSIC_GC_DISABLE | INTRINSIC_GC_ENABLED | INTRINSIC_WEAKREF_CREATE | INTRINSIC_WEAKREF_GET | INTRINSIC_WEAKREF_CONSTRUCT | INTRINSIC_FIBER_CONSTRUCT | INTRINSIC_FIBER_START | INTRINSIC_FIBER_RESUME | INTRINSIC_FIBER_THROW | INTRINSIC_FIBER_SUSPEND | INTRINSIC_FIBER_CURRENT | INTRINSIC_FIBER_STARTED | INTRINSIC_FIBER_SUSPENDED | INTRINSIC_FIBER_RUNNING | INTRINSIC_FIBER_TERMINATED | INTRINSIC_FIBER_RETURN | INTRINSIC_REGISTER_SHUTDOWN_FUNCTION | INTRINSIC_AUTO_REGISTER | INTRINSIC_AUTO_UNREGISTER | INTRINSIC_AUTO_FUNCTIONS | INTRINSIC_AUTO_CALL | INTRINSIC_EXIT | INTRINSIC_DIE | INTRINSIC_CLONE | INTRINSIC_GET_CLASS | INTRINSIC_GET_CALLED_CLASS | INTRINSIC_FROM_CALLABLE | INTRINSIC_FROM_CALLABLE_FACTORY | INTRINSIC_CLOSURE_CURRENT | INTRINSIC_CLOSURE_BIND | INTRINSIC_CLOSURE_BINDTO | INTRINSIC_FUNC_NUM_ARGS | INTRINSIC_FUNC_GET_ARG | INTRINSIC_FUNC_GET_ARGS | INTRINSIC_GET_INCLUDE_PATH | INTRINSIC_SET_INCLUDE_PATH | INTRINSIC_INI_GET | INTRINSIC_INI_SET | INTRINSIC_INI_RESTORE | INTRINSIC_CHDIR
  | INTRINSIC_ERROR_REPORTING | INTRINSIC_SET_ERROR_HANDLER | INTRINSIC_RESTORE_ERROR_HANDLER | INTRINSIC_GET_ERROR_HANDLER | INTRINSIC_TRIGGER_ERROR | INTRINSIC_USER_ERROR
  | INTRINSIC_SET_EXCEPTION_HANDLER | INTRINSIC_RESTORE_EXCEPTION_HANDLER | INTRINSIC_GET_EXCEPTION_HANDLER
syntax pexitcall = { SITE porigin, KIND pintrinsic, INDEX nat, SENT poperand*, NAMED bool, OWNER nat?, LINE int }
syntax pclonecall = { SITE porigin, INDEX nat, SENT pnamedslot*, NAMED bool, OWNER nat?, NAME ptbytes?, LINE int }
syntax pcloneoperation = { SITE porigin, LINE int, SOURCE nat, TARGET nat, INPUT poperand?, CALL pclonecall?, SCOPE porigin? }
syntax pclonephase = CLONE_CALLBACK | CLONE_UPDATES
syntax pclonerevision = { KEY ptbytes, COUNT nat }
syntax pclonewindow = { OPERATION pcloneoperation, PHASE pclonephase, AVAILABLE ptbytes*, REVISIONS pclonerevision* }
syntax pclonevisit = { KEY pkey, TARGET ptbytes, DECL ppropertyid?, VALUE pvalue?, PRECISION int, REVISION nat? }
syntax pcloneupdate = { OPERATION pcloneoperation, ARRAY nat, CURSOR nat, VISITED pclonevisit* }
syntax pcloneupdatestring = { UPDATE pcloneupdate, KEY ptbytes, DECL ppropertyid, OBJECT nat, PRECISION int }
syntax pgetclasscall = { SITE porigin, INDEX nat, SENT pnamedslot*, NAMED bool, OWNER nat?, LINE int }
syntax pargref = { TARGET pcalltarget, CALLSITE porigin, ARGUMENT porigin, POSITION nat, DIMENSION porigin, LINE int }
syntax pargcall = { SITE porigin, KIND pintrinsic, INDEX nat, SENT pnamedslot*, NAMED bool, OWNER nat?, SELECTION nat?, LINE int }
;; Completed unpack certificates borrow values from SENT, never heap owners.
syntax pconfigpack = { INDEX nat, SITE porigin, LINE int, ARRAY nat, ITEMS pentry* }
syntax ptraversablepack = { INDEX nat, SITE porigin, LINE int, OBJECT nat, ITEMS pentry* }
syntax pfiberpack = FIBER_ARRAY_PACK pconfigpack | FIBER_TRAVERSABLE_PACK ptraversablepack
syntax pconfigcall = { SITE porigin, KIND pintrinsic, INDEX nat, SENT pnamedslot*, NAMED bool, OWNER nat?, SELECTION nat?, LINE int, PACKS pconfigpack* }
syntax pfiberfactory = { CALL pconfigcall, ITEMS pentry* }
syntax pfiberarray = { SITE porigin, INIT int, LINE int, ARRAY nat, ITEMS pentry*, KIND pintrinsic, NAME ptbytes, INPUT nat? }
syntax pfiberrawapi = { ITEMS pentry*, KIND pintrinsic, NAME ptbytes, INPUT nat? }
syntax pfibercapture = { SITE porigin, KIND pintrinsic, NAME ptbytes, INPUT nat?, FACTORY pfiberfactory?, ARRAY pfiberarray? }
;; Zend retains the raw callable, not the registration-time function cache.
syntax perrorhandler = { CALLBACK pvalue?, LEVELS int }
syntax passertflag = { VALUE bool, INITIAL nat*, RAW nat*, MODIFIED bool }
syntax passertmode = { INPUT pvalue, VALUE int }
syntax passertiniphase = ASSERTION_CONVERT | ASSERTION_PARSE | ASSERTION_REFUSE int
syntax ptask
syntax passertiniconversion = { SOURCE ptask, VALUE pvalue }
syntax passertini = { ID nat, CALL pconfigcall, CONVERSION passertiniconversion?, INPUT pvalue, OLDRAW pvalue, RETURNRAW pvalue, OLDRETURN pvalue, ORIGINAL pvalue, ENTRYMODIFIED bool, VALUE int, WARNING (nat*)?, PRECISION int, PHASE passertiniphase }
syntax passertoption = { ID nat, CALL pconfigcall, OPTION int, OLD bool }
syntax passertfailure = { CALL pconfigcall, DESCRIPTION pvalue, PRECISION int, PENDING nat? }
syntax passertcall = { FAILURE passertfailure, CALLBACK pvalue, RAW parray?, TARGET pcalltarget? }
syntax phandlerresolution = HANDLERRESOLVED pcalltarget | HANDLERINVALID ptbytes | HANDLERUNKNOWN text
syntax pgeneratorop, pgeneratorloop, pgenerator, pgeneratorphase, pgeneratorfrom, pgeneratoraccess
syntax pgenclosestage, pgenclose, pgenrelease, pgenstorage
syntax prefowner = REPLAY_TRY porigin | REPLAY_CATCH porigin
syntax prefreturncursor = { OWNER porigin, SOURCE porigin, LINE int, OUTER porigin? }
syntax prefstringcv = { SOURCE porigin, LINE int, CELL nat, OBJECT nat }
syntax prefreturnnotice = REF_NOTICE_VALUE | REF_NOTICE_NULL
syntax pdircontext, perrorread, perrorcall, pdeclnoticebatch, pevalcompile, pevalcompileplan, pevalcompilefatal, pbindwarning
syntax pgenfatal
syntax papiclass = { REQUESTED porigin, CALLED porigin, RECEIVER nat?, STRICT bool }
syntax papiclassresult = API_CLASS papiclass | API_CLASS_INVALID ptbytes | API_CLASS_UNKNOWN text
;; SOURCE owns its existing operands; the selecting-frame snapshot and live
;; member pointer are borrowed metadata, not extra reference-cell owners.
syntax papiquery = { SOURCE ptask, VALUE pvalue, INPUT pvalue, METHOD pitem, SCOPE porigin?, CALLED porigin?, THIS nat?, CLASS papiclass, OUTER papiclass?, ORIGINAL ptbytes, PREFIX nat, WIDTH nat, LINE int }
syntax perrorread = { ORIGINAL ptask, INPUT poperand, BASE pbase, NAME nat*, LINE int, TASK ptask, RESULT poperand }
;; A dereferenced CV pointer is borrowed across an error callback, not a zval owner.
syntax pidentityread = { SITE porigin, OP pbin, LEFT nat*, LEFTLINE int, RIGHT nat*, LINE int, CELL nat, BASE pbase }
syntax pexceptioncall = { OBJECT nat, CALLBACK pvalue, TARGET pcalltarget?, ORIGIN porigin?, RAW parray?, SENT poperand?, RECEIVED poperand? }
syntax pglobalread = { SITE porigin, NAME nat*, LINE int }
syntax pnameread = { SITE porigin, NAME nat*, LINE int }
syntax ppropertyget = { SITE porigin, NAME ptbytes, LINE int, OBJECT nat, CLASS porigin, METHOD porigin, DECL ppropertyid? }
syntax ppropertywarning = { READ pnameread, OBJECT nat, KEY ptbytes, FREEING bool, BORROWED bool, CELL nat? }
syntax pnamestring = { READ pnameread, OBJECT nat, TAIL ptask* }
syntax pechoresult = { TEMP poperand, OBJECT nat, SITE porigin, LINE int, TAIL ptask* }
syntax pcompoundstring = { PLACE plocation, RIGHT poperand, SITE porigin, LINE int, CV bool, SELF bool, SELECTED nat? }
syntax pcomputedcompound = { CLASS poperand, NAME poperand, RIGHT poperand, SITE porigin, LINE int }
syntax pcomputedaddress = { CLASS poperand, RIGHT poperand, SITE porigin, LINE int, ROOT porigin, NAME ptbytes, PENDING nat? }
syntax pclosurescope, pclosurebinding
;; The selecting callback is borrowed history, not a retained queue owner.
syntax pcloneproducer = { SITE porigin, NAME ptbytes?, CLOSURE nat? }
syntax pcloneconsumer = { KIND pintrinsic, ID nat, SITE porigin }
syntax pclonemaker = { OBJECT nat, SELECTION pcloneproducer, CONSUMERS pcloneconsumer* }
syntax pshutdownproducer = { TARGET pcalltarget, SITE porigin?, SCOPE pclosurescope?, BINDING pclosurebinding?, INTERNAL bool, CLONE pcloneproducer? }
syntax pshutdownentry = { CALL pconfigcall, BIRTH nat?, CAPTURE pmethodcapture?, PRODUCER pshutdownproducer?, RAW parray?, TARGET pcalltarget, ARGS pvalue* }
;; Autoload registry buckets retain only the selected callable cache.
syntax preqbytes
syntax pautoloadtarget = AUTO_DEFAULT | AUTO_ALL | AUTO_TARGET pcalltarget
syntax pautoloadentry = { CALL pconfigcall, BIRTH nat?, CAPTURE pmethodcapture?, PRODUCER pshutdownproducer?, RAW parray?, TARGET pautoloadtarget, SCOPE pclosurescope?, BINDING pclosurebinding? }
syntax pautoloadregistry = { ENTRIES pautoloadentry?*, BIRTHS nat?*, CAPACITY nat }
syntax pautoloadmode = AUTO_LOOKUP | AUTO_EXPLICIT pconfigcall
