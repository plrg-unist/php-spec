;; Names designate cells. Rebinding a name changes its cell, not the old cell's value.
syntax pslot = UNDEFINED | DEFINED pvalue
syntax pbinding = BIND nat* nat
syntax poperand = KNOWN pvalue | VARIABLE nat* int | REFERENCE nat
syntax pbase = BASE_VALUE poperand | BASE_GLOBAL poperand int | BASE_NAME poperand int | BASE_DIM pbase poperand int | BASE_APPEND pbase int | BASE_PROPERTY pvalue ptbytes | BASE_CHAIN_PROPERTY pvalue ptbytes int | BASE_SHORT
syntax pnode = HCELL nat | HARRAY nat | HOBJECT nat
syntax plocation = ROOT nat | ELEMENT nat pkey | PROPERTY nat ptbytes | NOWHERE
syntax pvstage = PVFOLD | PVEXEC
syntax pvalueclass = PVSCALAR | PVSTRING bool | PVARRAY bool (pkey, pvalueclass)*
syntax porigin = PORIGIN nat pcpath
syntax pcalltarget = porigin | CLOSURE_TARGET nat | METHOD_TARGET nat porigin
syntax pconstant = PCONSTANT pcpath pvalue | PCCLASS pcpath pvalueclass
syntax ppool = { UNIT nat, CONSTANTS pconstant* }
syntax pcodeexpr = CODEMATCH_LINE pcpath int | CODEMATCH_TABLE pcpath bool | CODEIMPLICIT pcpath ptbytes int | CODEARROW pcpath int | CODELEXICAL pcpath ptbytes bool int | CODESTATIC pcpath ptbytes int int bool | CODECALL_INIT pcpath int | CODEPIPE_SEND pcpath int | CODESWITCH_COMPARE pcpath int | CODESWITCH_BOOL pcpath bool | CODEGOTO pcpath pcpath | CODEARG pcpath | CODEWRITE pcpath int | CODEEXPR pcpath int bool | CODEEFFECT pcpath
syntax pcodename = CODENAME pcpath nat* (nat*)?
syntax pcoderedirect = CODEREDIRECT pcpath pcpath bool
syntax pcode = { STRICT bool, GLOBALS pcpath*, UNIT nat, EXPRESSIONS pcodeexpr*, NAMES pcodename*, REDIRECTS pcoderedirect* }
syntax pdefaultkind = PDSTORED | PDDEFERRED
syntax pdefault = { INDEX nat, ORIGIN porigin, KIND pdefaultkind }
syntax pfunction = { DEFAULTS pdefault*, ORIGIN porigin, NAME ptbytes, SIGNATURE pssignature, CVS ptbytes*, ENV plenv, CODE pcode, BODY pcpath, EARLY bool, LINE nat, ENDLINE nat }
syntax pmethoddesc = { NAME ptbytes, FUNCTION pfunction, OWNER porigin, FINAL bool, ABSTRACT bool }
syntax ppropdefault = PROP_UNINITIALIZED | PROP_NULL | PROP_STORED porigin
syntax ppropertydesc = { ORIGIN porigin, NAME ptbytes, TYPE ptbranch*, DEFAULT ppropdefault, LINE nat }
syntax ppropstate = PROP_INITIAL | PROP_UNSET | PROP_VALUE pitem
syntax ppropertyslot = { DECL porigin?, NAME ptbytes, STATE ppropstate }
syntax pobjectprops = { OBJECT nat, SLOTS ppropertyslot*, MATERIALIZED bool }
syntax pproptypesource = { OBJECT nat, NAME ptbytes, DECL porigin }
syntax ppropref = { CELL nat, SOURCES pproptypesource* }
dec $propref_at(ppropref*, nat) : ppropref?
syntax pclassdesc = { ORIGIN porigin, NAME ptbytes, PARENT ptbytes?, PROPERTIES ppropertydesc*, METHODS pmethoddesc*, ABSTRACT bool, FINAL bool, READONLY bool, EARLY bool, LINE nat }
syntax pclassparent = SOURCE_PARENT porigin | STDCLASS_PARENT
syntax pclasslink = CLASSLINK porigin pclassparent
syntax pmethodissue = METHOD_OK | METHOD_ISSUE ptbytes int | METHOD_UNSUPPORTED text
syntax pnoctorcall = { SITE porigin, CLASS ptbytes, OBJECT nat, ARGUMENTS phpType7*, INDEX nat, SENT poperand*, LINE int }
syntax psourcefile = SOURCEFILE nat nat*
syntax pupdate = INCREMENT | DECREMENT
syntax psilence = SILENCE porigin int
syntax pnamedslot = NAMED_HOLE | NAMED_SENT poperand
syntax pnamedargs = { SLOTS pnamedslot*, NAMED (nat*, poperand)* }
syntax punpackcall = { FUNCTION pcalltarget, ARGUMENTS phpType7*, INDEX nat, SENT pnamedargs, CALLSITE porigin?, LINE int }
syntax pintrinsic = INTRINSIC_EXIT | INTRINSIC_DIE
syntax pexitcall = { SITE porigin, KIND pintrinsic, INDEX nat, SENT poperand*, NAMED bool, OWNER nat?, LINE int }
syntax ptask = EXIT_ARGS pexitcall | EXIT_SEND pexitcall | EXIT_UNPACK_PREP pexitcall | EXIT_UNPACK_NEXT pexitcall poperand nat | EXIT_INVOKE pexitcall | EXIT_UNWIND int | MATCH_START porigin | MATCH_SCAN porigin poperand nat nat | MATCH_COMPARE porigin poperand nat nat | MATCH_RESULT porigin poperand nat | CLOSURE_CAPTURE nat nat | CLOSURE_RECEIVE porigin nat | STATIC_INIT porigin | STATIC_BIND porigin | UNPACK_ARGS punpackcall | UNPACK_SEND punpackcall | UNPACK_PREP punpackcall | UNPACK_NEXT punpackcall poperand nat bool | NAMED_ARGS pcalltarget phpType7* nat pnamedargs porigin? int | NAMED_SEND pcalltarget phpType7* nat pnamedargs porigin? int | NAMED_PREFLIGHT porigin nat | NAMED_DEFAULT_BIND porigin nat | NAMED_VARIADIC_RECEIVE porigin nat | VARIADIC_BEGIN porigin | VARIADIC_RECEIVE porigin nat | SILENCE_END porigin | TYPE_RECEIVE porigin nat | TYPE_FALLTHROUGH porigin | DEFAULT_RECEIVE porigin nat | DEFAULT_BIND porigin nat | CONSTANT_OBSERVE porigin | CONSTANT_INIT expression | CONSTANT_BIND porigin
  | NOCTOR_ARGS pnoctorcall | NOCTOR_SEND pnoctorcall | NOCTOR_UNPACK_PREP pnoctorcall | NOCTOR_UNPACK_NEXT pnoctorcall poperand nat
  | PIPE_FORCE porigin int int int | PIPE_APPLY porigin poperand int int
  | SWITCH_START statement porigin | SWITCH_SCAN statement porigin poperand nat | SWITCH_COMPARE statement porigin poperand nat int | SWITCH_NEXT statement porigin poperand
  | INSTANCEOF_RESULT int
  | PROPERTY_PREP phpType20 int | PROPERTY_NAME pvalue int
  | PROPERTY_REF_PREP expression int | PROPERTY_REF_CAPTURE pbase int | PROPERTY_REF_BIND pbase nat int | PROPERTY_REF_BIND_CV pbase nat* int | PROPERTY_REF_FETCH int
  | LIST_TEMP_CAPTURE expression int | CALL_REF_PREP pcalltarget nat porigin? | CALL_REF_FETCH pcalltarget nat porigin? | ERROR_UNWIND pcompletion | GLOBAL_BIND expression int | GLOBAL_BIND_NAME int | CALL_DYNAMIC porigin int int | FIRSTCLASS_CONVERT porigin int int | CALL_ARGS pcalltarget phpType7* nat poperand* porigin? int | CALL_SEND pcalltarget phpType7* nat poperand* porigin? int | RETURN_REF_FETCH int | RETURN_REF_VALUE int | RETURN_REF_NULL int | RETURN_VALUE int | RETURN_NULL | RETURN_UNWIND poperand | GLOBAL_NAME int | ISSET_PREP expression bool | ISSET_RESULT bool int | ISSET_NEXT expression* nat | COALESCE_ASSIGN_PREP expression expression int | COALESCE_ASSIGN_WRITE pbase bool int | COALESCE_QUIET expression int int | FOREACH_PREP statement int | FOREACH_CV statement nat* int | FOREACH_NAME statement int | FOREACH_DIM statement int | FOREACH_RESET statement plocation bool int | FOREACH_NEXT nat pnode statement porigin? int | COALESCE_RESULT expression int int | EVAL_EFFECT | COMPILED_RESULT bool | LIST_CAPTURE expression bool int | LIST_PATTERN expression poperand int | LIST_NEXT poperand nat phpType13* int | LIST_FETCH poperand nat expression bool phpType13* int | LIST_STORE expression poperand bool int | LIST_STORE_NAME poperand bool int | LIST_STORE_DIM poperand bool int | ARRAY_UNPACK nat phpType13* int | CONCAT_LEFT expression bool bool int | CONCAT_RIGHT poperand bool bool int | CAST_RESULT pcast int | BITNOT_RESULT int | COMPOUND_PREP pbin expression expression int | COMPOUND_APPLY pbin pbase bool int | UPDATE_PREP pupdate bool int | TRUTH_RESULT bool int | SHORT_RESULT bool expression int int | VALUE_COPY int | SELECT_VALUE phpType5 expression int int int
  | CHOOSE ptask* ptask* int | LOOP_TEST statement porigin? | LOOP_NEXT statement porigin?
  | AT porigin ptask | ORIGIN_RETURN porigin? | DISCARD | UNSET_ARRAY | ASSIGN_PREP expression expression | ASSIGN_ARRAY pbase int bool | DIM_APPEND int
  | REF_ARRAY_PREP expression int | REF_ARRAY_CAPTURE pbase int | REF_ARRAY pbase nat int | REF_ARRAY_CV pbase nat* int
  | ARRAY_NEXT nat phpType13* | ARRAY_KEY nat expression phpType13* | ARRAY_VALUE nat poperand? phpType13* int
  | ARRAY_REF_KEY nat expression phpType13* | ARRAY_REF_VALUE nat poperand? phpType13* int
  | DIM_PREP expression | DIM_NAME int | DIM_CAPTURE | DIM_INDEX expression int | DIM_PATH pbase int | DIM_FETCH int
  | NULLSAFE_DIM_PREP expression bool | NULLSAFE_DIM_INDEX expression int bool | NULLSAFE_PROP_PREP phpType20 int bool | NULLSAFE_CHECK phpType20 int bool | NULLSAFE_PROPERTY_NAME pvalue int
  | METHOD_PREP phpType20 phpType7* bool bool int | METHOD_NAME poperand phpType7* int | METHOD_RESULT | CTOR_RESULT nat
  | BINARY_LEFT pbin expression int | BINARY_RIGHT pbin poperand int | UNARY punary int | STMT statement | EVAL expression | EMIT int | PRINT_EMIT porigin int | NAME_READ int
  | WRITE_NAME nat* int | PREP_ASSIGN expression int | WRITE_DYNAMIC poperand int
  | REF_NAME nat* | REF_CAPTURE poperand int | REF_DYNAMIC poperand nat int | REF_DYNAMIC_CV poperand nat* int | PREP_REF expression int
  | ACQUIRE_CALL | ACQUIRE expression | ACQUIRE_DYNAMIC int | ACQUIRE_ARRAY int | UNSET expression | UNSET_DYNAMIC int
syntax pcursor = CURSOR nat nat
syntax piterator = ITERATOR nat nat bool pcursor* | OBJECTITER nat nat nat bool
syntax preqbytes = nat*
syntax prequest = { ENV (preqbytes, preqbytes)*, ARGV preqbytes*, FILE preqbytes, SECONDS int, MICROSECONDS nat, VARIABLES preqbytes, JIT bool, CWD preqbytes? }
var Q : prequest
syntax psymboltable = { ENV pbinding*, CVS preqbytes*, SYMBOLS preqbytes* }
syntax pconstantfact = { ORIGIN porigin, VALUE pvalue?, CLASS pvalueclass }
syntax pconstantcontext = { ORIGIN porigin, LINE int, FACTS pconstantfact* }
syntax pdefaultcache = { ORIGIN porigin, VALUE pvalue, CLASS pvalueclass }
syntax puserconstant = { NAME preqbytes, ORIGIN porigin, VALUE pvalue, CLASS pvalueclass }
syntax pcallcontext = { WRAPPER pnamedargs?, INSTANCE nat?, RECEIVER nat?, LEXICAL_CLASS porigin?, CALLED_CLASS porigin?, FUNCTION porigin, NAME preqbytes, CALLSITE porigin?, LINE int, PARAMS preqbytes*, ARGC nat, EXTRA poperand*, NAMED (preqbytes, poperand)* }
syntax pframe = { SILENCES psilence*, LOCALS psymboltable?, TODO ptask*, ORIGIN porigin?, HELD pnode*, CONTEXT pcallcontext? }
syntax ptraceframe = { FILE preqbytes, LINE int, NAME preqbytes, VALUES pvalue*, ARGTEXT preqbytes }
syntax pstaticcell = { ORIGIN porigin, CELL nat }
syntax pclosurescope = { OBJECT nat, LEXICAL porigin, CALLED porigin, RECEIVER nat? }
syntax pobject = INTRINSICCLOSURE pintrinsic | REALCLOSURE porigin pitem* pstaticcell* | NAMEDCLOSURE porigin | INSTANCE porigin | STDINSTANCE
syntax pstate = { OBJECTS pobject*, CLOSURESCOPES pclosurescope*, OBJECTPROPS pobjectprops*, PROPREFS ppropref*, CLASSES pclassdesc*, CLASSNAMES (preqbytes, porigin)*, LINKEDPARENTS pclasslink*, CLOSURETEMPLATES pfunction*, STATICS pstaticcell*, REPORTING int, SILENCES psilence*, DEFAULTCACHE pdefaultcache*, CONSTCONTEXT pconstantcontext?, USERCONSTANTS puserconstant*, TRACE ptraceframe*, ERRORORIGIN porigin?, FUNCTIONS pfunction*, CALLABLES (preqbytes, porigin)*, GLOBALTABLE psymboltable?, FRAMES pframe*, CURRENT pcallcontext?, REQUEST prequest?, SYMBOLS preqbytes*, CVS preqbytes*, HTTPROOTS (preqbytes, pvalue)*, ACTIVATED preqbytes*, TODO ptask*, EVENTS pevent*, COMPLETION pcompletion,
  ENV pbinding*, STORE pslot*, REFCELLS nat*, RESULT poperand, CELL nat, ARRAYS parray*, KEY pkey, BASE pbase, LOCATION plocation, ALLOCATIONS pnode*, HELD pnode*, SOURCES pcunit*, ORIGIN porigin?, POOLS ppool*, FILES psourcefile*, CODE pcode*, ITERATORS piterator*, NEXTITER nat }
dec $install_classes(pstate, pclassdesc*) : pstate
dec $method_link_issue(pstate, pclassdesc, porigin) : pmethodissue
dec $ctor_pairs_valid(pstate, ptask*) : bool
dec $ctor_frames_pairs_valid(pstate, pframe*) : bool
dec $class_at(pclassdesc*, porigin) : pclassdesc?
dec $class_named((preqbytes, porigin)*, preqbytes) : porigin?
dec $class_method_functions(pclassdesc*) : pfunction*
dec $class_method_origin(pclassdesc*, porigin) : pmethoddesc?
dec $closure_scope_at(pclosurescope*, nat) : pclosurescope?
dec $method_prep_task(pstate, phpType20, phpType7*, bool, bool, int) : bool
dec $method_call_selected(pstate, pcalltarget, porigin?) : bool
dec $new_has_ctor(pstate, preqbytes) : bool
dec $target_receiver(pstate, pcalltarget) : nat?
dec $target_lexical_class(pstate, pcalltarget) : porigin?
dec $target_called_class(pstate, pcalltarget) : porigin?
dec $call_argument_origin(pstate, porigin?, nat) : porigin?
dec $ppnullsafe(expression) : bool
dec $object_name(pstate, nat) : preqbytes
dec $class_plain_instance(pstate, nat) : bool
dec $activate_parented_class(pstate, pclassdesc, ptbytes) : pstate
dec $class_origin_matches(pstate, porigin, ptbytes, nat) : bool
dec $typed_class_chain(pstate, ptbranch*, porigin, nat) : bool
dec $class_links_valid(pstate) : bool
dec $property_layout(pstate, porigin, nat) : ppropertydesc*
dec $property_declaring_name(pclassdesc*, porigin) : ptbytes
dec $property_desc_at(ppropertydesc*, ptbytes) : ppropertydesc?
dec $ppproperty_override_message(ptbytes, ptbytes, ptbytes, ptbranch*, ptbranch*) : ptbytes?
dec $property_initial_slots(pstate, ppropertydesc*) : ppropertyslot*?
dec $objectprops_at(pobjectprops*, nat) : ppropertyslot*?
dec $objectprops_record_at(pobjectprops*, nat) : pobjectprops?
dec $property_slot_at(ppropertyslot*, ptbytes) : ppropertyslot?
dec $property_hash_count(ppropertyslot*) : nat
dec $objectprops_mark(pstate, nat) : pstate
dec $objectprops_materialized(pobjectprops*, nat) : bool
dec $property_slot_nodes(ppropertyslot*) : pnode*
dec $property_cast_array(ppropertyslot*) : parray
dec $property_entries(ppropertyslot*) : pentry*
dec $property_next(ppropertyslot*, nat, nat) : (ptbytes, pitem, nat)?
dec $property_slots_valid(pstate, ppropertydesc*, ppropertyslot*) : bool
dec $property_state_valid(pstate) : bool
dec $proprefs_valid(pstate) : bool
dec $nullsafe_base_phase_valid(pstate) : bool
dec $propref_slots_covered(pstate, pobjectprops*) : bool
dec $write_cell_checked(pstate, nat, pvalue, int) : pstate
dec $propref_detach_slot(pstate, nat, ppropertyslot) : pstate
dec $property_reference_fetch(pstate, nat, ptbytes, int) : pstate
dec $property_current_line(pstate) : int
dec $objectprops_prune(pobjectprops*, pnode*) : pobjectprops*
dec $proprefs_prune(ppropref*, pobjectprops*, pnode*) : ppropref*
dec $cv_name(phpType32) : (nat*)?
dec $direct_this(phpType32) : bool
dec $global_this_error(pstate, int) : pstate
dec $fetch_write_name_at(pstate, nat*, int) : pstate
dec $acquire_name_at(pstate, nat*, int) : pstate
dec $bind_reference_at(pstate, nat*, int) : pstate
dec $location_name_at(pstate, nat*, int) : pstate
dec $this_name(nat*) : bool
def $this_name(n*) = (n* = [116,104,105,115])
dec $initial_state(pcompletion) : pstate
dec $separate_location_array(pstate, nat) : pstate
var S : pstate
var namebytes : nat*

;; Only main-registered globals and language-special/request CLI names are guarded.
;; Session is absent from the pinned profile; HTTP wrappers create local names.
;; The initial environment for these language-owned names is a separate pending
;; obligation. Access cannot masquerade as an ordinary absent local variable.
dec $environment_name(nat*) : bool
def $environment_name(n*) = true
  -- if n* <- [[71,76,79,66,65,76,83], [116,104,105,115], [97,114,103,99], [97,114,103,118], [95,71,69,84], [95,80,79,83,84], [95,67,79,79,75,73,69], [95,83,69,82,86,69,82], [95,69,78,86], [95,82,69,81,85,69,83,84], [95,70,73,76,69,83]]
def $environment_name(n*) = false
  -- otherwise

dec $request_roots_nodes((preqbytes, pvalue)*) : pnode*
dec $symbol_add(preqbytes*, nat*) : preqbytes*
def $symbol_add(preqbytes*, n*) = preqbytes* -- if n* <- preqbytes*
def $symbol_add(preqbytes*, n*) = preqbytes* ++ [n*] -- if ~(n* <- preqbytes*)
dec $symbols_add(preqbytes*, preqbytes*) : preqbytes*
def $symbols_add(preqbytes*, eps) = preqbytes*
def $symbols_add(preqbytes_known*, preqbytes :: preqbytes_tail*) = $symbols_add($symbol_add(preqbytes_known*, preqbytes), preqbytes_tail*)

dec $symbol_delete(preqbytes*, nat*) : preqbytes*
def $symbol_delete(eps, n*) = eps
def $symbol_delete(preqbytes :: preqbytes_tail*, n*) = preqbytes_tail* -- if preqbytes = n*
def $symbol_delete(preqbytes :: preqbytes_tail*, n*) = preqbytes :: $symbol_delete(preqbytes_tail*, n*) -- if preqbytes =/= n*
dec $symbol_unset(pstate, nat*) : preqbytes*
def $symbol_unset(S, n*) = S.SYMBOLS -- if n* <- S.CVS
def $symbol_unset(S, n*) = $symbol_delete(S.SYMBOLS, n*) -- if ~(n* <- S.CVS)

dec $environment_blocked(pstate, nat*) : bool
def $environment_blocked(S, n*) = ($this_name(n*) \/ (S.REQUEST = eps /\ $environment_name(n*)))

dec $lookup(pbinding*, nat*) : nat?
def $lookup(eps, n_name*) = eps
def $lookup((BIND n_name* n_cell) :: pbinding_tail*, n_name*) = n_cell
def $lookup((BIND n_other* n_cell) :: pbinding_tail*, n_name*) = $lookup(pbinding_tail*, n_name*)
  -- if n_other* =/= n_name*

dec $unbind(pbinding*, nat*) : pbinding*
def $unbind(eps, n_name*) = eps
def $unbind((BIND n_name* n_cell) :: pbinding_tail*, n_name*) = pbinding_tail*
def $unbind((BIND n_other* n_cell) :: pbinding_tail*, n_name*) = (BIND n_other* n_cell) :: $unbind(pbinding_tail*, n_name*)
  -- if n_other* =/= n_name*

dec $set_cell(pslot*, nat, pslot) : pslot*
def $set_cell(pslot_old :: pslot_tail*, 0, pslot) = pslot :: pslot_tail*
def $set_cell(pslot_old :: pslot_tail*, n, pslot) = pslot_old :: $set_cell(pslot_tail*, n_next, pslot)
  -- if $(n > 0)
  -- if $(n - 1) = n_next

dec $ensure(pstate, nat*) : pstate
def $ensure(S, n_name*) = S[.CELL = n_cell]
  -- if $lookup(S.ENV, n_name*) = (n_cell)
def $ensure(S, n_name*) = S[.CELL = n_cell][.STORE = S.STORE ++ [UNDEFINED]][.ENV = (BIND n_name* n_cell) :: S.ENV][.SYMBOLS = $symbol_add(S.SYMBOLS, n_name*)][.ALLOCATIONS = S.ALLOCATIONS ++ [HCELL n_cell]]
  -- if $lookup(S.ENV, n_name*) = eps
  -- if n_cell = |S.STORE|

;; Explicit reference wrappers survive becoming singleton owners. This marker
;; carries no heap edge and stable cell IDs are never recycled. Array copies may
;; unwrap an ALIAS into DIRECT while the original cell's wrapper remains intact.
dec $reference_cell(pstate, nat) : pstate
def $reference_cell(S, n) = S -- if n <- S.REFCELLS
def $reference_cell(S, n) = S[.REFCELLS = n :: S.REFCELLS] -- if ~(n <- S.REFCELLS)

;; Ordinary writable-name fetching initializes the slot without creating a
;; reference wrapper. Reference-source acquisition adds the marker afterward.
dec $fetch_write_name(pstate, nat*) : pstate
def $fetch_write_name(S, n_name*) = S[.COMPLETION = UNSUPPORTED "request environment variable"]
  -- if $environment_blocked(S, n_name*)
def $fetch_write_name(S, n_name*) = S_found
  -- if ~$environment_blocked(S, n_name*)
  -- if S_found = $ensure(S, n_name*)
  -- if S_found.STORE[S_found.CELL] = DEFINED pvalue
def $fetch_write_name(S, n_name*) = S_found[.STORE = $set_cell(S_found.STORE, S_found.CELL, DEFINED PNULL)]
  -- if ~$environment_blocked(S, n_name*)
  -- if S_found = $ensure(S, n_name*)
  -- if S_found.STORE[S_found.CELL] = UNDEFINED

dec $acquire_name(pstate, nat*) : pstate
def $acquire_name(S, n_name*) = S_found
  -- if S_found = $fetch_write_name(S, n_name*)
  -- if S_found.COMPLETION =/= NORMAL
def $acquire_name(S, n_name*) = $reference_cell(S_found, S_found.CELL)
  -- if S_found = $fetch_write_name(S, n_name*)
  -- if S_found.COMPLETION = NORMAL

dec $report_event(pstate, pevent, int) : pstate
dec $missing(pstate, nat*, int) : pstate
def $missing(S, n_name*, z) = $report_event(S[.RESULT = KNOWN PNULL], WARNING n_name* z, 2)
  -- if $(z > 0)
def $missing(S, n_name*, z) = S[.COMPLETION = UNSUPPORTED "missing source line"]
  -- if $(z <= 0)

dec $read_name(pstate, nat*, int) : pstate
def $read_name(S, n_name*, z) = S[.COMPLETION = UNSUPPORTED "request environment variable"]
  -- if $environment_blocked(S, n_name*) /\ ~$this_name(n_name*)
def $read_name(S, n_name*, z) = $missing(S, n_name*, z)
  -- if (~$environment_blocked(S, n_name*) \/ $this_name(n_name*))
  -- if $lookup(S.ENV, n_name*) = eps
def $read_name(S, n_name*, z) = $missing(S, n_name*, z)
  -- if (~$environment_blocked(S, n_name*) \/ $this_name(n_name*))
  -- if $lookup(S.ENV, n_name*) = (n_cell)
  -- if S.STORE[n_cell] = UNDEFINED
def $read_name(S, n_name*, z) = S[.RESULT = KNOWN pvalue]
  -- if (~$environment_blocked(S, n_name*) \/ $this_name(n_name*))
  -- if $lookup(S.ENV, n_name*) = (n_cell)
  -- if S.STORE[n_cell] = DEFINED pvalue

dec $resolve(pstate, poperand) : pstate
def $resolve(S, KNOWN pvalue) = S[.RESULT = KNOWN pvalue]
def $resolve(S, VARIABLE n_name* z) = $read_name(S, n_name*, z)
def $resolve(S, REFERENCE n) = S[.RESULT = KNOWN pvalue]
  -- if S.STORE[n] = DEFINED pvalue

dec $resolve_at(pstate, poperand, int) : pstate
def $resolve_at(S, KNOWN pvalue, z) = S[.RESULT = KNOWN pvalue]
def $resolve_at(S, VARIABLE n_name* z_origin, z) = $read_name(S, n_name*, z)
def $resolve_at(S, REFERENCE n, z) = $resolve(S, REFERENCE n)

dec $write_name(pstate, nat*, pvalue) : pstate
def $write_name(S, n_name*, pvalue) = S[.COMPLETION = UNSUPPORTED "request environment variable"]
  -- if $environment_blocked(S, n_name*)
def $write_name(S, n_name*, pvalue) = $write_cell_checked(S_found, S_found.CELL, pvalue, $property_current_line(S))
  -- if ~$environment_blocked(S, n_name*)
  -- if S_found = $ensure(S, n_name*)

dec $bind_reference(pstate, nat*) : pstate
def $bind_reference(S, n_name*) = S[.COMPLETION = UNSUPPORTED "request environment variable"]
  -- if $environment_blocked(S, n_name*)
;; ZEND_ASSIGN_REF returns an owning reference wrapper when its value is used.
;; Consumers dereference this captured cell, even if a name is later rebound.
def $bind_reference(S, n_name*) = $reference_cell(S, S.CELL)[.ENV = (BIND n_name* S.CELL) :: $unbind(S.ENV, n_name*)][.SYMBOLS = $symbol_add(S.SYMBOLS, n_name*)][.RESULT = REFERENCE S.CELL]
  -- if ~$environment_blocked(S, n_name*)
  -- if S.STORE[S.CELL] = DEFINED pvalue

dec $unset_name(pstate, nat*) : pstate
def $unset_name(S, n_name*) = S[.COMPLETION = UNSUPPORTED "request environment variable"]
  -- if $environment_blocked(S, n_name*) /\ ~$this_name(n_name*)
def $unset_name(S, n_name*) = S[.ENV = $unbind(S.ENV, n_name*)][.SYMBOLS = $symbol_unset(S, n_name*)]
  -- if (~$environment_blocked(S, n_name*) \/ $this_name(n_name*))

dec $runtime_line(pstate, pcpath, expression) : int
dec $enter_compiled_task(pstate, porigin, ptask, ptask*) : pstate
dec $dimension_read(pstate, pvalue, poperand, int) : pstate

syntax pstringfetch = STRINGREFERENCE | STRINGNESTED | STRINGINCDEC | STRINGCOMPOUND
dec $string_dimension_write(pstate, nat*, poperand?, poperand, int) : (pstate, nat*)
dec $string_dimension_fetch(pstate, poperand?, pstringfetch, int) : pstate

;; Shared source/constant truth consumers; definitions follow in module50.
