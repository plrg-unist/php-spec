syntax pshutdown = { ENTRIES pshutdownentry*, INDEX nat, PHASE pshutdownphase, SENT poperand*, RECEIVED poperand*, RENDER pshutdownrender?, COMPLETION pcompletion }
syntax pkeymode = KEY_R | KEY_IS | KEY_TEST bool
syntax pkeyphase = KEY_CV | KEY_NULL | KEY_FLOAT castnotice castnotice* | KEY_ARRAY_NAME | KEY_MISSING
