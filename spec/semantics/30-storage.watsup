syntax pdestructionrelease = {JOBS pdestructionjob*, CALLER pcallcontext?, ORIGIN porigin?, CONSTCONTEXT pconstantcontext?, USER bool}
syntax pdestructionframe = {PENDING nat?, VALUE poperand, CALLER pcallcontext?, FUNCTION porigin, ORIGIN porigin?, CONSTCONTEXT pconstantcontext?}
syntax pdestructioncleanup = {SOURCE ptask, TARGET pshutdownproducer, CALLER pcallcontext?, ORIGIN porigin?, CONSTCONTEXT pconstantcontext?, RELEASED bool}
syntax pdestructionhandler = {VALUE pvalue, ARRAY parray?, CELLS (nat, pslot)*}
syntax pdestructionfatal = {FRAME pframe, FRAMES pframe*, GLOBAL psymboltable, VALUE poperand, BASE pbase, DESTRUCTION pdestruction, SHUTDOWN pshutdown, ERRORHANDLER perrorhandler, ERRORHANDLERS perrorhandler*, EXCEPTIONHANDLER pvalue?, EXCEPTIONHANDLERS pvalue?*, HANDLERS pdestructionhandler*, EVALCONTEXTS pevalcontext*, FILECONTEXTS pfilecontext*, DECLARATIONS pdeclaration*, COMPLETION pcompletion, FROZEN pcompletion, ERRORORIGIN porigin?, TRACE ptraceframe*, ERRORTRACE ptraceframe*, COMPILESTOP bool, REPORTING int}
syntax pgctemporary = {OPERAND poperand, PENDING bool}
syntax pdestructionoperation = {VALUE poperand, BASE pbase, CELL nat, KEY pkey, LOCATION plocation, COMPLETION pcompletion, PENDING nat?, CALLER pcallcontext?, ORIGIN porigin?, CONSTCONTEXT pconstantcontext?, SOURCE ptask, CLEANUP pdestructioncleanup?, NOGC pgctemporary?}
syntax pdestructorcall = {OBJECT nat, TARGET pcalltarget, STORE bool, CALLER pcallcontext?, ORIGIN porigin?, CONSTCONTEXT pconstantcontext?, USER bool, SITE porigin?, LINE int, RELEASE pdestructionrelease?, FRAME pdestructionframe?, OPERATION pdestructionoperation?, PENDING nat?}
