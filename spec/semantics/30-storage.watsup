syntax pautoloadregistration = { ENTRY pautoloadentry, INDEX nat, THROW bool, PREPEND bool }
syntax pshutdownphase = SHUTDOWN_PENDING | SHUTDOWN_RUNNING | SHUTDOWN_DONE
