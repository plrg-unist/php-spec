syntax pgcworker = {BIRTH pgccall, GUARD pgcguard?}
syntax pgc = {ENABLED bool, IMMUTABLE nat*, BUFFER pgcslot*, FREE nat*, NEXT nat, ACTIVE pgccall?, PLAN pgcplan?, WORKER nat?, SCAN pgcscan}
