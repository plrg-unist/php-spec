  | SOURCE_ARRAY_RESULT psourceoperand | SOURCE_READ_RESULT psourceoperand | SOURCE_NAME_RESULT psourceoperand int | SOURCE_STRING_RESULT psourceoperand nat | SOURCE_STRING_READY psourceoperand nat preqbytes | SOURCE_STRING_PENDING psourceoperand preqbytes nat | SOURCE_STRING_PROPAGATE psourceoperand preqbytes nat | SOURCE_OPERAND_FAST psourceoperand nat | SOURCE_FAST_FINISH psourceoperand nat | SOURCE_HELPER_RELEASE psourceoperand psourcehelper | SOURCE_HELPER_FINISH psourceoperand psourcehelper | SOURCE_OPERAND_RELEASE psourceoperand | SOURCE_OPERAND_ENTER psourceoperand nat | SOURCE_OPERAND_THROW psourceoperand nat
  | BINARY_LEFT pbin expression int | BINARY_RIGHT pbin poperand int | UNARY punary int | STMT statement | EVAL expression | EMIT int | ECHO_CALL_RESULT pechoresult | ECHO_CALL_PENDING pechoresult preqbytes nat | STRINGIFY_RESULT nat porigin int | TERMINAL_STRING nat | PRINT_EMIT porigin int | CLONE_RESULT porigin int | NAME_READ int
  | WRITE_NAME nat* int | PREP_ASSIGN expression int | WRITE_DYNAMIC poperand int
  | REF_NAME nat* | REF_CAPTURE poperand int | REF_DYNAMIC poperand nat int | REF_DYNAMIC_CV poperand nat* int | PREP_REF expression int
  | ACQUIRE_CALL | ACQUIRE expression | ACQUIRE_DYNAMIC int | ACQUIRE_ARRAY int | UNSET expression | UNSET_DYNAMIC int
syntax pdirconversion = { NONCE nat, CALLSITE porigin, CALLLINE int, OBJECT nat, RESULT nat*, SELECTION nat?, OWNERDEPTH nat }
syntax pdircontext = { NONCE nat, CALL pconfigcall, CWD nat*, REQUESTED nat*, CONVERSION nat?, FRAMEOWNER nat, TAIL ptask* }
syntax pfilecontext = { NONCE nat, SITE porigin, CALLER nat*, REQUESTED nat*, CWD nat*, INCLUDEPATH nat*, KIND int, LEXICAL_CLASS porigin?, OWNER nat, PHASE pfilephase, TAIL ptask*, UNIT nat?, RESOLVED nat*?, OPENED nat*?, BYTES nat*? }
syntax preceivecut, pdeclcause
syntax pevalcontext = { UNIT nat, RECEIVES preceivecut*, USERPREFIX nat, SITE porigin, BYTES nat*, FILE nat*, LEXICAL_CLASS porigin?, OWNER nat, PHASE pevalphase, TAIL ptask*, LOCATION pconstantlocation? }
syntax pevalbinding = { UNIT nat, RECEIVES preceivecut*, USERPREFIX nat, SITE porigin, CLASS porigin?, LOCATION pconstantlocation? }
syntax pcursor = CURSOR nat nat
syntax piterator = GENERATORITER nat nat | ITERATOR nat nat bool pcursor* | OBJECTITER nat nat nat bool | OBJECTKEYITER nat nat nat bool nat nat
syntax preqbytes = nat*
syntax prequest = { ENV (preqbytes, preqbytes)*, ARGV preqbytes*, FILE preqbytes, SECONDS int, MICROSECONDS nat, VARIABLES preqbytes, JIT bool, CWD preqbytes? }
syntax pstartup = { REPORTING preqbytes?, INCLUDEPATH preqbytes }
var Q : prequest
syntax psymboltable = { ENV pbinding*, CVS preqbytes*, SYMBOLS preqbytes* }
syntax pclassconstantselection = CLASS_CONST_FETCH poperand ptbytes | CLASS_CONST_UPDATE_SELECT porigin
syntax pclassconstantcontext = { DECL porigin, SELECTION pclassconstantselection, PREVIOUS pconstantcontext?, ORIGIN porigin?, LINE int }
syntax pconstantclosure = { OBJECT nat, SITE porigin, DECL porigin, PREFIX nat }
syntax pparameterreceive = PARAMETER_SCOPE pclosureevidence | PARAMETER_SOURCE nat
syntax pparameterclosure = { OBJECT nat, FUNCTION porigin, INDEX nat, SCOPE porigin?, EVIDENCE pparameterreceive? }
syntax pconstantobject = { OBJECT nat, SITE porigin, DECL porigin, CLASS porigin, PREFIX nat, COMPLETE bool }
syntax pdefaultcache = { ORIGIN porigin, VALUE pvalue, CLASS pvalueclass }
syntax preceivefrontier = RECEIVE_METHOD porigin porigin porigin nat | RECEIVE_DEPRECATED pdeprecatedconstant
syntax preceivecut = { OWNER nat, INDEX nat, FRONTIER preceivefrontier, CAUSE pdeclcause }
syntax puserconstant = { NAME preqbytes, ORIGIN porigin, VALUE pvalue, CLASS pvalueclass, READS pconstantfact*, RECEIVES preceivecut* }
syntax preceiveowner = { ID nat, PREFIX nat, PUBLICATION nat }
syntax pcallcontext = { TARGET pcalltarget, DEFAULTRECEIVE preceiveowner?, WRAPPER pnamedargs?, INSTANCE nat?, RECEIVER nat?, LEXICAL_CLASS porigin?, CALLED_CLASS porigin?, FUNCTION porigin, NAME preqbytes, CALLSITE porigin?, LINE int, PARAMS preqbytes*, ARGC nat, HOLES nat*, EXTRA poperand*, NAMED (preqbytes, poperand)* }
syntax pframe = { SILENCES psilence*, LOCALS psymboltable?, TODO ptask*, ORIGIN porigin?, HELD pnode*, CONTEXT pcallcontext?, RETIREDOWNERS pretiredowner*, BORROWEDREAD pidentityread?, OBJECTCAST pobjectcast?, CONSTCONTEXT pconstantcontext? }
;; The tag is confined to captured trace arguments, never a PHP value.
syntax ptracearg = pvalue | SENSITIVE_TRACE pvalue
syntax ptraceframe = { FILE preqbytes, LINE int, FUNCTION preqbytes, CLASS preqbytes?, TYPE preqbytes?, ARGS (pkey, ptracearg)*, HASARGS bool }
syntax pstaticcell = { ORIGIN porigin, CELL nat }
syntax pclassstatic = { DECL ppropertyid, STATE ppropstate }
syntax pinstanceobjectcertificate = INSTANCE_OBJECT_BIND porigin porigin porigin porigin pstaticselection? pvalueclass nat nat | INSTANCE_OBJECT_COPY porigin nat pinstanceobjectcertificate
syntax pinstancetemplatestate = INSTANCE_PENDING porigin | INSTANCE_VALUE pvalue pvalueclass | INSTANCE_OBJECT_VALUE pvalue pvalueclass pinstanceobjectcertificate
syntax pinstancetemplate = { CLASS porigin, DECL porigin, STATE pinstancetemplatestate }
syntax pthrowable = { KIND text, ORIGIN porigin?, FILEORIGIN porigin? }
syntax pclosurecreator = { SCOPE pclosureevidence, CALLSITE porigin? }
syntax pclosurecreation = { FUNCTION porigin, CALLSITE porigin?, RECEIVER bool, EVIDENCE pclosurecreator? }
syntax pclosurescope = { OBJECT nat, LEXICAL porigin, CALLED porigin, RECEIVER nat?, CREATION pclosurecreation? }
syntax pclosurebinding = { OBJECT nat, SITE porigin, SOURCE nat, LEXICAL porigin?, CALLED porigin?, RECEIVER nat? }
syntax pbindscope = BIND_UNSCOPED | BIND_CLASS porigin | BIND_INTERNAL ptbytes
;; The old source and scope row certify permission without retaining their heap owners.
syntax pboundfake = { SITE porigin, SOURCE nat, ORIGINAL pclosurescope?, SCOPE pbindscope, CALLED pbindscope, RECEIVER nat? }
syntax pinternalclosurescope = { SOURCE nat, FUNCTION porigin, CALLSITE porigin?, LEXICAL pbindscope, CALLED pbindscope, RECEIVER nat?, BOUND bool }
syntax pbindscoperesult = BIND_SCOPE pbindscope | BIND_SCOPE_MISSING ptbytes | BIND_SCOPE_UNKNOWN text
syntax pbindwarning = { CALL pconfigcall, SCOPE pbindscoperesult, MESSAGE ptbytes }
syntax pclosureevidence = CLOSURE_SCOPE pclosurescope | CLOSURE_BINDING pclosurebinding | CLOSURE_CALL porigin nat nat porigin
;; A durable fake closure keeps selection certificates, never the raw callback container.
syntax pfrommethod = { SITE porigin, FACTORY nat?, INPUT pvalue, METHOD ptbytes, SCOPE porigin?, CALLED porigin?, THIS nat?, CLASS papiclass, OUTER papiclass?, ORIGINAL ptbytes, PREFIX nat, WIDTH nat, FUNCTION porigin, NAME ptbytes, STATIC bool, CREATION pmethodcapture?, ARRAY bool, INVOKE bool }
;; Fibers move VM-local control; heap, class tables, INI and handlers stay shared.
syntax pfiberstatus = FIBER_INIT | FIBER_RUNNING | FIBER_SUSPENDED | FIBER_TERMINATED
syntax pfibervm = { GLOBAL bool, TABLE psymboltable, TODO ptask*, ORIGIN porigin?, CURRENT pcallcontext?, RETIREDOWNERS pretiredowner*, FRAMES pframe*, DESTRUCTORCALLS pdestructorcall*, DESTRUCTORRELEASES pdestructionrelease*, DESTRUCTORFRAMES pdestructionframe*, DESTRUCTOROPERATIONS pdestructionoperation*, DESTRUCTORCLEANUPS pdestructioncleanup*, HELD pnode*, RESULT poperand, BASE pbase, CELL nat, KEY pkey, LOCATION plocation, REPORTING int, SILENCES psilence*, BORROWEDREAD pidentityread?, OBJECTCAST pobjectcast?, CONSTCONTEXT pconstantcontext?, TRACE ptraceframe*, ERRORFATALTRACE ptraceframe*, ERRORORIGIN porigin? }
syntax pfibercaller = { OBJECT nat, PREVIOUS nat?, VM pfibervm, API pfiberapi }
;; Internal object destruction has a distinct waiting C frame, with no API row.
syntax pfiberclose = { OBJECT nat, PREVIOUS nat?, CALLERS nat, VM pfibervm, RELEASE pdestructionrelease, SUSPEND pfiberapi, EXIT nat, SEQUENCE nat }
syntax pfiber = { READY bool, CALL pconfigcall?, RAW pvalue, TARGET pcalltarget?, BIRTH pdynamicnew?, CAPTURE pmethodcapture?, PRODUCER pshutdownproducer?, ENTRY pnamedargs?, FINISH pfiberfinish?, GC pgcworker?, STATUS pfiberstatus, VM pfibervm?, VALUE pvalue, RETURNED bool, FAILED bool, GRACEFUL bool, SEQUENCE nat }
syntax pfibercallable = { QUERY papiquery, METHOD porigin, NAME ptbytes, STATIC bool, BIRTH pdynamicnew?, CAPTURE pmethodcapture?, PRODUCER pshutdownproducer? }
syntax pgeneratorphase = GENERATOR_FRESH | GENERATOR_PAUSED | GENERATOR_RUNNING | GENERATOR_CLOSED | GENERATOR_DELEGATING | GENERATOR_CLOSING
syntax pgenclosestage = CLOSE_QUEUED | CLOSE_BODY porigin | CLOSE_SCANNING | CLOSE_FLOW | CLOSE_FINISHED
syntax pgenclose = { OBJECT nat, SITE porigin, CONTEXT pcallcontext, CALLER pcallcontext?, CALLSITE porigin?, STAGE pgenclosestage, NEXT nat, FRAME pframe?, PENDING nat?, STORE nat? }
syntax pgenrelease = { JOBS pdestructionjob*, VALUE poperand, BASE pbase, PENDING nat?, COMPLETION pcompletion }
syntax pgenstorage = { OBJECT nat, HANDLE nat, NEXT nat, CALLER pcallcontext?, ORIGIN porigin?, CONSTCONTEXT pconstantcontext?, USER bool }
syntax pgeneratorborrowed = { VALUE poperand?, KEY pvalue? }
syntax pgeneratoraccess = { TARGET pcalltarget, SITE porigin, LINE int }
syntax pgenerator = { FUNCTION porigin, FRAME pframe?, PHASE pgeneratorphase, FIRST bool, INDEX int, VALUE pvalue?, REFCELL nat?, KEY pvalue?, BORROWED pgeneratorborrowed?, RETURN pvalue?, CLOSURE nat?, DELEGATE pgeneratorfrom?, ACCESS pgeneratoraccess? }
syntax pgeneratorfrom = { SITE porigin, INPUT pvalue?, POSITION nat, CURRENT poperand?, ACQUISITION pyieldfromreceipt? }
syntax pgeneratorloop = { ITERATOR nat, STATEMENT statement }
syntax pgeneratorop = { OBJECT nat, NAME text, SITE porigin, LINE int, LOOP pgeneratorloop?, ADVANCE bool, ARGUMENTS pvalue*, STARTPACK bool, BORROWED bool }
syntax pobject = SENSITIVEUNSET porigin | SENSITIVEVALUE pvalue | WEAKREFERENCE nat? | FIBERGRACEFUL nat nat | FIBER pfiber | FIBERAPICLOSURE pfibercapture | GENERATOR pgenerator | INTERNALCALLCLOSURE pinternalclosurescope pobject | CONSTANTCLOSURE porigin pobject | PARAMETERSOURCECLOSURE nat pobject | THROWABLE pthrowable | INTRINSICCLOSURE pintrinsic | FROMCALLABLEFACTORY porigin | REALCLOSURE porigin pitem* pstaticcell* | NAMEDCLOSURE porigin | METHODCLOSURE porigin porigin porigin pmethodcapture? | ARRAYMETHODCLOSURE pcalltarget parrayselection pmethodcapture? | STRINGMETHODCLOSURE pcalltarget pstringselection | INVOKECLOSURE nat porigin | GETTERCLOSURE nat pgettermethod text porigin | FROMCALLABLECLOSURE pfrommethod | BOUNDFAKECLOSURE pboundfake | INTERNALSCOPECLOSURE pinternalclosurescope pobject | INSTANCE porigin | STDINSTANCE
syntax pdeclautoload = (nat, pautoloadcall, pautoloadentry)
syntax pdeclcause = { UNIT nat, CALLS (porigin, porigin?, porigin?, porigin?)*, AUTOLOAD pdeclautoload* }
syntax pcompilestop = PCSREJECT | PCSMAINREJECT program | PCSCOMPLETE | PCSCOMPILER | PCSLINK nat | PCSUNSUPPORTED nat
syntax pdeclaration = PDENTER nat porigin? int | PDENTERPRECISION nat porigin? int int | PDECLASS nat porigin | PDEFUNCTION nat porigin | PDRCLASS porigin pdeclcause | PDRFUNCTION porigin pdeclcause | PDRCLASSFATAL porigin pdeclcause | PDRTRAITCACHEFAIL porigin pdeclcause | PDRTRAITFAIL porigin pdeclcause | PDCOMPILEWARNING pldiagnostic | PDEVALPAUSE nat nat nat pdeclnoticeitem* | PDEVALRESUME nat int | PDEVALRESUMEPRECISION nat int int | PDEVALFATALNOTICES nat pdeclnoticeitem* | PDEXIT nat pcompilestop
dec $object_body(pobject) : pobject

syntax preceiveedge = { FRONTIER preceivefrontier, HANDLER porigin }
syntax preceivebirth = { ORIGIN porigin, FUNCTION porigin, CALLSITE porigin?, PARENT nat?, PARENTINDEX nat?, PARENTEDGE preceiveedge?, CAUSE pdeclcause, PREFIX nat, PUBLICATION nat, ACTIVE bool }
syntax psourcepending = { OPERAND psourceoperand, UNIT nat, HELPER psourcehelper?, EXCEPTION nat, CALLER pcallcontext? }

syntax pstate = { OBJECTS pobject*, CLOSURESCOPES pclosurescope*, CLOSUREBINDINGS pclosurebinding*, OBJECTPROPS pobjectprops*, OBJECTTABLES pobjecttable*, PROPREFS ppropref*, REFCOERCIONS prefcoercion*, CONTAINERINITS pcontainerinit*, PARAMETERBACKINGS pparameterbacking*, CLONES pclonewindow*, CLONEMAKERS pclonemaker*, CLASSES pclassdesc*, CLASSNAMES (preqbytes, porigin)*, DECLARATIONS pdeclaration*, LINKEDPARENTS pclasslink*, LINKEDINTERFACES pinterfacelink*, CLOSURETEMPLATES pfunction*, STATICS pstaticcell*, CLASSSTATICS pclassstatic*, INSTANCEDEFAULTS pinstancetemplate*, CLASSCONSTANTCACHE pdefaultcache*, CLASSCONSTANTHISTORY pclassconstantevent*, CLASSCONSTANTINIT pclassconstantcontext*, CONSTANTCLOSURES pconstantclosure*, PARAMETERCLOSURES pparameterclosure*, CONSTANTOBJECTS pconstantobject*, STARTUP pstartup?, ASSERTIONS int, ASSERTIONSINIT preqbytes, ASSERTIONSINI preqbytes, ASSERTIONSMODIFIED bool, ASSERTIONSRAW pvalue, ASSERTIONSORIGINAL pvalue, ASSERTIONSMODE passertmode, ASSERTIONININEXT nat, ASSERTIONINI passertini*, STRINGDATA (nat*)*, ASSERTACTIVE passertflag, ASSERTBAIL passertflag, ASSERTWARNING passertflag, ASSERTEXCEPTION passertflag, ASSERTCALLBACK pvalue?, ASSERTOPTIONNEXT nat, ASSERTOPTIONS passertoption*, REPORTING int, REPORTINGINI preqbytes, REPORTINGMODIFIED bool, DISPLAYINIT preqbytes?, DISPLAYINI preqbytes?, DISPLAYMODIFIED bool, PRECISIONINIT preqbytes, PRECISIONINI preqbytes, PRECISIONMODIFIED bool, SILENCES psilence*, ERRORHANDLER perrorhandler, ERRORHANDLERS perrorhandler*, EXCEPTIONHANDLER pvalue?, EXCEPTIONHANDLERS pvalue?*, AUTOLOAD pautoloadregistry, AUTOSEQ nat, SHUTDOWN pshutdown, DESTRUCTION pdestruction, GC pgc, BORROWEDREAD pidentityread?, OBJECTCAST pobjectcast?, DEFAULTCACHE pdefaultcache*, PARAMETERSEQ nat, PARAMETERRECEIVES preceivebirth*, CONSTCONTEXT pconstantcontext?, USERCONSTANTS puserconstant*, TRACE ptraceframe*, ERRORFATALTRACE ptraceframe*, ERRORORIGIN porigin?, FUNCTIONS pfunction*, CALLABLES (preqbytes, porigin)*, GLOBALTABLE psymboltable?, ACTIVEFIBER nat?, FIBERCALLERS pfibercaller*, FIBERCLOSERS pfiberclose*, FIBERSEQ nat, FRAMES pframe*, CURRENT pcallcontext?, RETIREDOWNERS pretiredowner*, REQUEST prequest?, FILECWD preqbytes?, FILEINCLUDEPATH preqbytes?, FILESEQ nat, DIRSEQ nat, DIRCONVSEQ nat, DIRCONVERSIONS pdirconversion*, DIRCONTEXT pdircontext?, SELECTSEQ nat, SELECTEDCALLS pselectedcall*, FILECONTEXTS pfilecontext*, FILEBINDINGS pfilebinding*, INCLUDEDOPENED preqbytes*, EVALCONTEXTS pevalcontext*, EVALBINDINGS pevalbinding*, FAILEDSOURCES pfailedsource*, SOURCEPENDING psourcepending?, SERVICELEFT nat?, COMPILESTOP bool, SYMBOLS preqbytes*, CVS preqbytes*, HTTPROOTS (preqbytes, pvalue)*, ACTIVATED preqbytes*, TODO ptask*, EVENTS pevent*, COMPLETION pcompletion,
  ENV pbinding*, STORE pslot*, REFCELLS nat*, RESULT poperand, CELL nat, ARRAYS parray*, KEY pkey, BASE pbase, LOCATION plocation, ALLOCATIONS pnode*, HELD pnode*, SOURCES pcunit*, ORIGIN porigin?, POOLS ppool*, FILES psourcefile*, CODE pcode*, ITERATORS piterator*, NEXTITER nat, YIELDRETAINED pyieldfromretained* }

