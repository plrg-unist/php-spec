  -- if $weakmap_entries_child_pin(S, pweakmapentry*, n_freeing?)
  -- if $weakmap_entries_child_local(S, n_map, n_freeing?, pweakmapentry*)
  -- if $weakmap_entries_child_associations(S, n_freeing?, pweakmapentry*)
def $weakmap_entries_child_shared_storage(S, n_map, n_freeing?) = false -- otherwise
def $weakmap_shared_finite_registration(S, n_map, n_key, pweakmapvalue) = true
  -- if ~$weakmap_shared_leaf_registration(S, n_map, n_key, pweakmapvalue)
  -- if $weakmap_entries_child_key(S, n_key, eps)
  -- if nat_maps* = $weakmap_key_maps(S, S.ALLOCATIONS, n_key)
  -- if nat_maps* = n_first :: nat_tail*
