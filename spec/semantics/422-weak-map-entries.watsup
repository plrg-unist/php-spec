dec $weakmap_entries_cursor_next(pweakmapentry*, nat, nat*) : (pweakmapentry, nat)?
def $weakmap_entries_cursor_next(pweakmapentry_all*, n_position, n_keys*) = eps
  -- if $(n_position >= |n_keys*|)
def $weakmap_entries_cursor_next(pweakmapentry_all*, n_position, n_keys*) = (pweakmapentry_selected, $(n_position + 1))
  -- if $(n_position < |n_keys*|)
  -- if $weakmap_entries_find(pweakmapentry_all*, n_keys*[n_position]) = (pweakmapentry_selected)
def $weakmap_entries_cursor_next(pweakmapentry_all*, n_position, n_keys*) = $weakmap_entries_cursor_next(pweakmapentry_all*, $(n_position + 1), n_keys*)
  -- if $(n_position < |n_keys*|)
  -- if $weakmap_entries_find(pweakmapentry_all*, n_keys*[n_position]) = eps

def $weakmap_foreach_begin(S, n_map, statement, false, z) = S[.TODO = (FOREACH_NEXT n (HOBJECT n_map) statement (porigin) z) :: ptask_tail*][.ITERATORS = S.ITERATORS ++ [WEAKMAPITER n n_map 0 ($weakmap_entries_keys(pweakmapentry_all*))]][.NEXTITER = $(n + 1)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if $weakmap_entries_at(S, n_map)
  -- if S.TODO = ptask :: ptask_tail*
  -- if S.ORIGIN = (porigin)
  -- if $useriter_site(S, statement, porigin, z)
  -- if statement = NStmtForeach expression_iterable expression_key (BOOLEAN false) expression_value (SEQUENCE statement_body*) (BOOLEAN false) metadata
  -- if $weakmap_foreach_name(expression_key) = (n_key_name*)
  -- if $weakmap_foreach_name(expression_value) = (n_value_name*)
  -- if n_key_name* =/= n_value_name*
  -- if $weakmap_foreach_target(S, n_key_name*) /\ $weakmap_foreach_target(S, n_value_name*)
  -- if $weakmap_entries_table_valid(S, n_map, eps)
  -- if pweakmapentry_all* = $weakmap_entries_contents(S, n_map)
  -- if n = S.NEXTITER
rule PhpStep/weakmap-entries-foreach-fetch: S ~> $weakmap_foreach_body(S[.ORIGIN = (porigin)][.ITERATORS = $iterator_set(S.ITERATORS, WEAKMAPITER n n_map n_next n_keys*)], n, n_map, statement, porigin, z, pweakmapentry_selected)
  -- if S.TODO = (FOREACH_NEXT n (HOBJECT n_map) statement (porigin) z) :: ptask_tail*
  -- if $iterator_lookup(S.ITERATORS, n) = (WEAKMAPITER n n_map n_position n_keys*)
  -- if $call_task_valid(S, FOREACH_NEXT n (HOBJECT n_map) statement (porigin) z)
  -- if $weakmap_entries_foreach_storage(S, n_map)
  -- if $weakmap_entries_cursor_next($weakmap_entries_contents(S, n_map), n_position, n_keys*) = (pweakmapentry_selected, n_next)
rule PhpStep/weakmap-entries-foreach-end: S ~> $foreach_finish(S[.ORIGIN = (porigin)], n)
