def $iterator_set((OBJECTITER n_other n_object n_old b_ref) :: piterator_tail*, WEAKMAPREFITER n n_map n_position n_keys*) = (OBJECTITER n_other n_object n_old b_ref) :: $iterator_set(piterator_tail*, WEAKMAPREFITER n n_map n_position n_keys*)
