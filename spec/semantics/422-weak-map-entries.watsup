def $iterator_lookup((WEAKMAPREFITER n_other n_map n_position n_keys*) :: piterator_tail*, n) = $iterator_lookup(piterator_tail*, n)
  -- if n_other =/= n
def $iterator_remove((WEAKMAPREFITER n n_map n_position n_keys*) :: piterator_tail*, n) = piterator_tail*
def $iterator_remove((WEAKMAPREFITER n_other n_map n_position n_keys*) :: piterator_tail*, n) = (WEAKMAPREFITER n_other n_map n_position n_keys*) :: $iterator_remove(piterator_tail*, n)
