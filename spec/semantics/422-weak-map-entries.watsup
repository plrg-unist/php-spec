;; Keep callback-visible hash occupancy as borrowed history only. The
;; freeing marker detaches every registration/edge before the real slot jobs.
dec $weakmap_entries_retired_image(pstate, pweakmapentry*) : pobject
def $weakmap_entries_retired_image(S, pweakmapentry*) = WEAKMAPENTRIES pweakmapentry*
  -- if $weakmap_entries_callbacks(S, pweakmapentry*)
def $weakmap_entries_retired_image(S, pweakmapentry*) = WEAKMAP eps
  -- if ~$weakmap_entries_callbacks(S, pweakmapentry*)
;; Unregister every Key before the first value decrement. The pin retains
;; allocation/notification. Without callbacks the old empty image is exact.
def $destruction_storage_free(S, HOBJECT n_map, pdestructionrelease) = $destructor_release_begin($gc_store_retire($instance_storage_called(S[.OBJECTS[n_map] = $weakmap_entries_retired_image(S, pweakmapentry_all*)][.TODO = (INSTANCE_STORAGE_STEP {OBJECT n_map, HANDLE S.DESTRUCTION.HANDLES[n_map], SLOTS eps, NEXT 0, NOTIFY $weakref_find(S, S.ALLOCATIONS, n_map), CALLER S.CURRENT, ORIGIN S.ORIGIN, CONSTCONTEXT S.CONSTCONTEXT, USER $destructor_user_source(S)}) :: S.TODO], n_map), HOBJECT n_map), $destruction_values($weakmap_entries_nodes(pweakmapentry_all*)))
  -- if $weakmap_entries_free_allowed(S, n_map, pdestructionrelease)
  -- if pweakmapentry_all* = $weakmap_entries_contents(S, n_map)
def $destruction_storage_free(S, HOBJECT n, pdestructionrelease) = $destructor_release_replace(S, pdestructionrelease[.JOBS = (DESTRUCTION_VALUE (HOBJECT n)) :: pdestructionrelease.JOBS])[.COMPLETION = UNSUPPORTED "multiple-entry WeakMap storage destruction"]
  -- if $weakmap_entries_at(S, n)
  -- if ~$weakmap_entries_free_allowed(S, n, pdestructionrelease)

