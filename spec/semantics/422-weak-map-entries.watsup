  -- if $throwable_field(S, n_new_exception, "previous") = PNULL
  -- if $heap_owners($heap_graph(S), HOBJECT n_old_exception) = 1
  -- if $heap_owners($heap_graph(S), HOBJECT n_new_exception) = 1
  -- if $destructor_pending_parent_tasks(ptask_tail*, pdestructionoperation_inner, pdestructionoperation, pdestructionoperation[.PENDING = (n_new_exception)], false) = (ptask_new*)

;; A later selected Child hands off the same original parent's current head.
;; The path list is borrowed proof data; no task or intermediate heap root is added.
def $destructor_pending_parent(S, pdestructorcall) = (pdestructionoperation)
  -- if S.CURRENT = eps /\ S.FRAMES = eps /\ S.CONSTCONTEXT = eps
  -- if S.DESTRUCTION.CALLS = [pdestructorcall]
  -- if pdestructorcall.OPERATION = (pdestructionoperation_inner)
