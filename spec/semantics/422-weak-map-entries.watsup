  -- if $weakmap_entries_child_local(S, n_map, n_freeing?, pweakmapentry*)
  -- if $weakmap_entries_child_maps(S, n_freeing?, nat_tail*)
def $weakmap_entries_child_maps(S, n_freeing?, nat*) = false -- otherwise
dec $weakmap_entries_child_associations(pstate, nat?, pweakmapentry*) : bool
def $weakmap_entries_child_associations(S, n_freeing?, eps) = true
def $weakmap_entries_child_associations(S, n_freeing?, pweakmapentry :: pweakmapentry_tail*) = ($weakmap_entries_child_maps(S, n_freeing?, $weakmap_key_maps(S, S.ALLOCATIONS, pweakmapentry.KEY)) /\ $weakmap_entries_child_associations(S, n_freeing?, pweakmapentry_tail*))
dec $weakmap_entries_child_has_shared(pstate, pweakmapentry*) : bool
def $weakmap_entries_child_has_shared(S, eps) = false
def $weakmap_entries_child_has_shared(S, pweakmapentry :: pweakmapentry_tail*) = ($(|$weakmap_key_maps(S, S.ALLOCATIONS, pweakmapentry.KEY)| > 1) \/ $weakmap_entries_child_has_shared(S, pweakmapentry_tail*))
dec $weakmap_entries_child_pin(pstate, pweakmapentry*, nat?) : bool
