  -- if $(n_value < |S.OBJECTS|) /\ (HOBJECT n_value) <- S.ALLOCATIONS
  -- if S.OBJECTS[n_key] = STDINSTANCE
  -- if S.OBJECTS[n_value] = INSTANCE porigin_value
  -- if ~$instance_storage_freeing(S, n_key) /\ ~$instance_storage_freeing(S, n_value)
  -- if $objectprops_at(S.OBJECTPROPS, n_key) = (eps)
  -- if $object_table_at(S.OBJECTTABLES, n_key) = eps
  -- if $object_table_at(S.OBJECTTABLES, n_value) = eps
  -- if $node_children(S, HOBJECT n_key) = eps
  -- if $class_at(S.CLASSES, porigin_value) = (pclassdesc)
  -- if pclassdesc.KIND = "class" /\ pclassdesc.PARENT = eps /\ pclassdesc.METHODS = eps
  -- if $destructor_method(S, n_value) = eps
  -- if pclassdesc.PROPERTIES = [ppropertydesc]
  -- if ppropertydesc.VISIBILITY = PROPERTY_PUBLIC
  -- if ~ppropertydesc.STATIC /\ ~ppropertydesc.READONLY /\ ppropertydesc.TYPE = eps
  -- if $objectprops_at(S.OBJECTPROPS, n_value) = ([ppropertyslot])
  -- if ppropertyslot.DECL = (ppropertydesc.ORIGIN)
  -- if ppropertyslot.STATE = PROP_VALUE (DIRECT (POBJECT n_target))
  -- if $weakmap_entries_find($weakmap_entries_contents(S, n_map), n_target) =/= eps
  -- if $node_children(S, HOBJECT n_value) = [HOBJECT n_target]
  -- if $weakmap_before_valid(S, pweakmapentry)
  -- if $weakmap_key_maps(S, S.ALLOCATIONS, n_key) = [n_map]
  -- if $weakmap_entries_gc_entries(S, pweakmapentry_tail*, n_map)
def $weakmap_entries_gc_entries(S, pweakmapentry*, n_map) = false -- otherwise
;; One distinct member target per entry makes every component a Key cycle.
;; Conditional reachability therefore retains/frees complete entry pairs.
dec $weakmap_entries_gc_targets(pstate, pweakmapentry*) : nat*
def $weakmap_entries_gc_targets(S, eps) = eps
def $weakmap_entries_gc_targets(S, pweakmapentry :: pweakmapentry_tail*) = n_target :: $weakmap_entries_gc_targets(S, pweakmapentry_tail*)
  -- if pweakmapentry.VALUE = POBJECT n_value
  -- if $node_children(S, HOBJECT n_value) = [HOBJECT n_target]
dec $weakmap_entries_gc_objects(pstate, pnode*, nat, pnode*) : bool
def $weakmap_entries_gc_objects(S, eps, n_map, pnode_pairs*) = true
def $weakmap_entries_gc_objects(S, (HOBJECT n) :: pnode_tail*, n_map, pnode_pairs*) = $weakmap_entries_gc_objects(S, pnode_tail*, n_map, pnode_pairs*)
  -- if $(n < |S.OBJECTS|)
  -- if n = n_map \/ (HOBJECT n) <- pnode_pairs* \/ $weakref_object(S.OBJECTS[n])
def $weakmap_entries_gc_objects(S, (HCELL n) :: pnode_tail*, n_map, pnode_pairs*) = $weakmap_entries_gc_objects(S, pnode_tail*, n_map, pnode_pairs*)
  -- if $(n < |S.STORE|)
