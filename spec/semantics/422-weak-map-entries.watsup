dec $weakmap_entries_reference_acquire(pstate, nat, nat) : pstate
def $weakmap_entries_reference_acquire(S, n_map, n_key) = S[.STORE = S.STORE ++ [DEFINED (POBJECT n_value)]][.ALLOCATIONS = S.ALLOCATIONS ++ [HCELL n_cell]][.REFCELLS = n_cell :: S.REFCELLS][.OBJECTS[n_map] = $weakmap_entries_pack($weakmap_entries_reference_slot(pweakmapentry_all*, n_key, n_cell))][.CELL = n_cell]
  -- if $weakmap_entries_reference_storage(S, n_map)
  -- if pweakmapentry_all* = $weakmap_entries_contents(S, n_map)
  -- if $weakmap_entries_find(pweakmapentry_all*, n_key) = (pweakmapentry_selected)
  -- if pweakmapentry_selected.VALUE = POBJECT n_value
  -- if n_cell = |S.STORE|
def $weakmap_entries_reference_acquire(S, n_map, n_key) = S[.CELL = n_cell]
  -- if $weakmap_entries_reference_storage(S, n_map)
  -- if $weakmap_entries_find($weakmap_entries_contents(S, n_map), n_key) = (pweakmapentry_selected)
  -- if pweakmapentry_selected.VALUE = ALIAS n_cell
  -- if $weakmap_entries_cell_valid(S, n_cell)

def $weakmap_foreach_begin(S, n_map, statement, true, z) = S[.TODO = (FOREACH_NEXT n (HOBJECT n_map) statement (porigin) z) :: ptask_tail*][.ITERATORS = S.ITERATORS ++ [WEAKMAPREFITER n n_map 0 ($weakmap_entries_keys(pweakmapentry_all*))]][.NEXTITER = $(n + 1)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if $weakmap_entries_at(S, n_map)
  -- if S.TODO = ptask :: ptask_tail*
  -- if S.ORIGIN = (porigin)
  -- if $origin_node(S.SOURCES, porigin) = (statement)
  -- if statement = NStmtForeach expression_iterable expression_key (BOOLEAN true) expression_value (SEQUENCE statement_body*) (BOOLEAN false) metadata
  -- if z = $runtime_line(S[.ORIGIN = (porigin)], [PCFIELD 0], expression_iterable)
  -- if $weakmap_foreach_name(expression_key) = (n_key_name*)
  -- if $weakmap_foreach_name(expression_value) = (n_value_name*)
  -- if n_key_name* =/= n_value_name*
  -- if $weakmap_foreach_target(S, n_key_name*) /\ $weakmap_foreach_target(S, n_value_name*)
  -- if $weakmap_entries_table_valid(S, n_map, eps)
  -- if pweakmapentry_all* = $weakmap_entries_contents(S, n_map)
  -- if n = S.NEXTITER
rule PhpStep/weakmap-entries-reference-fetch: S ~> $weakmap_foreach_reference_body(S_ref[.ITERATORS = $iterator_set(S_ref.ITERATORS, WEAKMAPREFITER n n_map n_next n_keys*)], n, n_map, statement, porigin, z, pweakmapentry_selected)
  -- if S.TODO = (FOREACH_NEXT n (HOBJECT n_map) statement (porigin) z) :: ptask_tail*
  -- if $iterator_lookup(S.ITERATORS, n) = (WEAKMAPREFITER n n_map n_position n_keys*)
  -- if $call_task_valid(S, FOREACH_NEXT n (HOBJECT n_map) statement (porigin) z)
  -- if $weakmap_entries_reference_storage(S, n_map)
  -- if $weakmap_entries_cursor_next($weakmap_entries_contents(S, n_map), n_position, n_keys*) = (pweakmapentry_selected, n_next)
  -- if S_ref = $weakmap_entries_reference_acquire(S[.ORIGIN = (porigin)], n_map, pweakmapentry_selected.KEY)
rule PhpStep/weakmap-entries-reference-end: S ~> $foreach_finish(S[.ORIGIN = (porigin)], n)
  -- if S.TODO = (FOREACH_NEXT n (HOBJECT n_map) statement (porigin) z) :: ptask_tail*
  -- if $iterator_lookup(S.ITERATORS, n) = (WEAKMAPREFITER n n_map n_position n_keys*)
  -- if $call_task_valid(S, FOREACH_NEXT n (HOBJECT n_map) statement (porigin) z)
  -- if $weakmap_entries_reference_storage(S, n_map)
  -- if $weakmap_entries_cursor_next($weakmap_entries_contents(S, n_map), n_position, n_keys*) = eps
rule PhpStep/weakmap-entries-reference-storage-refusal: S ~> S[.COMPLETION = UNSUPPORTED "WeakMap reference foreach entry payload or storage"]
  -- if S.TODO = (FOREACH_NEXT n (HOBJECT n_map) statement (porigin) z) :: ptask_tail*
  -- if $iterator_lookup(S.ITERATORS, n) = (WEAKMAPREFITER n n_map n_position n_keys*)
  -- if $call_task_valid(S, FOREACH_NEXT n (HOBJECT n_map) statement (porigin) z)
  -- if ~$weakmap_entries_reference_storage(S, n_map)

;; Finite destructor-free Key permutations use the ordinary GC plan/count.
;; Their conditional edges never alter the physical ownership graph.
dec $weakmap_entries_gc_nodes(pweakmapentry*) : pnode*
def $weakmap_entries_gc_nodes(eps) = eps
def $weakmap_entries_gc_nodes(pweakmapentry :: pweakmapentry_tail*) = [HOBJECT pweakmapentry.KEY, HOBJECT n_value] ++ $weakmap_entries_gc_nodes(pweakmapentry_tail*)
  -- if pweakmapentry.VALUE = POBJECT n_value
dec $weakmap_entries_gc_entries(pstate, pweakmapentry*, nat) : bool
def $weakmap_entries_gc_entries(S, eps, n_map) = true
def $weakmap_entries_gc_entries(S, pweakmapentry :: pweakmapentry_tail*, n_map) = true
  -- if n_key = pweakmapentry.KEY
  -- if $weakmap_entries_find(pweakmapentry_tail*, n_key) = eps
