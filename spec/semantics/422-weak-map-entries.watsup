def $gc_ephemeron_key_order_safe(S, n_key) = false -- otherwise
def $gc_ephemeron_entries_valid(S, n_map, eps) = true
def $gc_ephemeron_entries_valid(S, n_map, pweakmapentry :: pweakmapentry_tail*) = true
