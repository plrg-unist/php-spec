def $weakmap_entries_gc_strip(hedge*, n_map, eps) = hedge*
def $weakmap_entries_gc_strip(hedge*, n_map, pweakmapentry :: pweakmapentry_tail*) = $weakmap_entries_gc_strip($weakmap_gc_strip(hedge*, n_map, n_value), n_map, pweakmapentry_tail*)
