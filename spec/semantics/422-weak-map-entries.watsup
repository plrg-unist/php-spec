def $gc_ephemeron_nodes_valid(S, eps) = true
def $gc_ephemeron_nodes_valid(S, pnode :: pnode_tail*) = ($gc_ephemeron_node_kind(S, pnode) /\ $gc_ephemeron_nodes_valid(S, pnode_tail*))
