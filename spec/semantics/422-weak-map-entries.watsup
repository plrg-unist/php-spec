def $weakmap_entries_keys_held(S, pweakmapentry :: pweakmapentry_tail*) = ($($heap_owners($heap_graph(S), HOBJECT pweakmapentry.KEY) > 0) /\ $weakmap_entries_keys_held(S, pweakmapentry_tail*))
dec $weakmap_entries_free_allowed(pstate, nat, pdestructionrelease) : bool
def $weakmap_entries_free_allowed(S, n_map, pdestructionrelease) = true
