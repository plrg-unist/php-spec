dec $weakmap_entries_child_maps(pstate, nat?, nat*) : bool
def $weakmap_entries_child_maps(S, n_freeing?, eps) = true
def $weakmap_entries_child_maps(S, n_freeing?, n_map :: nat_tail*) = true
