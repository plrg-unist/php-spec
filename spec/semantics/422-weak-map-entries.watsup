def $weakmap_entries_gc_shape(S, n_map) = false -- otherwise
def $weakmap_gc_shape(S, n_map) = true -- if $weakmap_entries_gc_shape(S, n_map)

dec $weakmap_entries_gc_edges(hedge*, nat, pweakmapentry*, pnode*) : hedge*
def $weakmap_entries_gc_edges(hedge*, n_map, eps, pnode_live*) = hedge*
def $weakmap_entries_gc_edges(hedge*, n_map, pweakmapentry :: pweakmapentry_tail*, pnode_live*) = (HEDGE (HOBJECT n_map) (HOBJECT n_value)) :: $weakmap_entries_gc_edges(hedge*, n_map, pweakmapentry_tail*, pnode_live*)
  -- if pweakmapentry.VALUE = POBJECT n_value
  -- if (HOBJECT pweakmapentry.KEY) <- pnode_live*
def $weakmap_entries_gc_edges(hedge*, n_map, pweakmapentry :: pweakmapentry_tail*, pnode_live*) = (HEDGE (HOBJECT pweakmapentry.KEY) (HOBJECT n_value)) :: $weakmap_entries_gc_edges(hedge*, n_map, pweakmapentry_tail*, pnode_live*)
  -- if pweakmapentry.VALUE = POBJECT n_value
  -- if ~((HOBJECT pweakmapentry.KEY) <- pnode_live*)
def $weakmap_gc_edges(S, hedge*, pnode_roots*) = $weakmap_entries_gc_edges(hedge_stripped*, n_map, pweakmapentry_all*, pnode_live*)
  -- if $weakmap_gc_map(S, S.ALLOCATIONS) = (n_map)
  -- if S.OBJECTS[n_map] = WEAKMAPENTRIES pweakmapentry_all*
  -- if hedge_stripped* = $weakmap_entries_gc_strip(hedge*, n_map, pweakmapentry_all*)
  -- if pnode_live* = $heap_reach(pnode_roots*, eps, hedge_stripped*)
  -- if (HOBJECT n_map) <- pnode_live*
def $weakmap_gc_edges(S, hedge*, pnode_roots*) = $weakmap_entries_gc_strip(hedge*, n_map, pweakmapentry_all*)
  -- if $weakmap_gc_map(S, S.ALLOCATIONS) = (n_map)
  -- if S.OBJECTS[n_map] = WEAKMAPENTRIES pweakmapentry_all*
  -- if hedge_stripped* = $weakmap_entries_gc_strip(hedge*, n_map, pweakmapentry_all*)
  -- if ~((HOBJECT n_map) <- $heap_reach(pnode_roots*, eps, hedge_stripped*))

dec $weakmap_entries_gc_free_valid(pweakmapentry*, pnode*, pnode*) : bool
def $weakmap_entries_gc_free_valid(eps, pnode_free*, pnode_live*) = true
def $weakmap_entries_gc_free_valid(pweakmapentry :: pweakmapentry_tail*, pnode_free*, pnode_live*) = true
  -- if pweakmapentry.VALUE = POBJECT n_value
  -- if ~((HOBJECT pweakmapentry.KEY) <- pnode_free*) /\ ~((HOBJECT n_value) <- pnode_free*)
  -- if $weakmap_entries_gc_free_valid(pweakmapentry_tail*, pnode_free*, pnode_live*)
def $weakmap_entries_gc_free_valid(pweakmapentry :: pweakmapentry_tail*, pnode_free*, pnode_live*) = true
  -- if pweakmapentry.VALUE = POBJECT n_value
  -- if (HOBJECT pweakmapentry.KEY) <- pnode_free* /\ (HOBJECT n_value) <- pnode_free*
  -- if ~((HOBJECT pweakmapentry.KEY) <- pnode_live*) /\ ~((HOBJECT n_value) <- pnode_live*)
  -- if $weakmap_entries_gc_free_valid(pweakmapentry_tail*, pnode_free*, pnode_live*)
def $weakmap_entries_gc_free_valid(pweakmapentry*, pnode_free*, pnode_live*) = false -- otherwise
dec $weakmap_entries_gc_retain(pweakmapentry*, pnode*) : pweakmapentry*
def $weakmap_entries_gc_retain(eps, pnode_free*) = eps
def $weakmap_entries_gc_retain(pweakmapentry :: pweakmapentry_tail*, pnode_free*) = $weakmap_entries_gc_retain(pweakmapentry_tail*, pnode_free*)
  -- if (HOBJECT pweakmapentry.KEY) <- pnode_free*
def $weakmap_entries_gc_retain(pweakmapentry :: pweakmapentry_tail*, pnode_free*) = pweakmapentry :: $weakmap_entries_gc_retain(pweakmapentry_tail*, pnode_free*)
  -- if ~((HOBJECT pweakmapentry.KEY) <- pnode_free*)
def $weakmap_gc_prepare(S, pgcplan) = S[.OBJECTS[n_map] = $weakmap_entries_pack($weakmap_entries_gc_retain(pweakmapentry_all*, pgcplan.FREESET))]
  -- if S.TODO = (GC_FREE pgcplan) :: ptask_tail*
