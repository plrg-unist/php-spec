dec $weakmap_entries_child_local(pstate, nat, nat?, pweakmapentry*) : bool
def $weakmap_entries_child_local(S, n_map, n_freeing?, eps) = true
def $weakmap_entries_child_local(S, n_map, n_freeing?, pweakmapentry :: pweakmapentry_tail*) = true
