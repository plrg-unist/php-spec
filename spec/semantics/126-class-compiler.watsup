  INTERNAL ($ptascii("uri") ++ [92] ++ $ptascii("whatwg") ++ [92] ++ $ptascii("urlvalidationerror")) ($ptascii("Uri") ++ [92] ++ $ptascii("WhatWg") ++ [92] ++ $ptascii("UrlValidationError")) "class",
