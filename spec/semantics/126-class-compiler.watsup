;; Named source classes retain compiler identity; publication is a runtime event.
;; Occupied internal class/interface/trait names in the pinned PHP -n profile.
syntax pinternal = INTERNAL ptbytes ptbytes text
dec $class_internal_catalogue() : pinternal*
def $class_internal_catalogue() = [
