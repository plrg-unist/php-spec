dec $class_internal_at(pinternal*, ptbytes) : pinternal?
def $class_internal_at(eps, ptbytes) = eps
def $class_internal_at((INTERNAL ptbytes ptbytes_display text_kind) :: pinternal_tail*, ptbytes) = (INTERNAL ptbytes ptbytes_display text_kind)
def $class_internal_at((INTERNAL ptbytes_other ptbytes_display text_kind) :: pinternal_tail*, ptbytes) = $class_internal_at(pinternal_tail*, ptbytes)
  -- if ptbytes_other =/= ptbytes
dec $class_internal(ptbytes) : bool
def $class_internal(ptbytes) = ($class_internal_at($class_internal_catalogue(), $ptlc(ptbytes)) =/= eps)

dec $ppclass_context(ppstate) : ptcontext
def $ppclass_context(P) = { NAMESPACE P.ENV.NAMESPACE, IMPORTS P.ENV.CLASSES, SCOPE PTGLOBAL, POSITION PTCONSTANT, OWNER eps, MEMBER eps, FILE P.LOCATION.FILE, LINE P.LOCATION.LINE }

dec $ppclass_diagnostics(ppstate, pchdiagnostic*) : ppstate
dec $ppclass_diagnostic(ppstate, pchdiagnostic) : ppstate
def $ppclass_diagnostics(P, eps) = P
def $ppclass_diagnostics(P, pchdiagnostic :: pchdiagnostic_tail*) = $ppclass_diagnostics($ppclass_diagnostic(P, pchdiagnostic), pchdiagnostic_tail*)
def $ppclass_diagnostic(P, PCHDIAGNOSTIC "fatal" text_code ptbytes* ptcontext) = P[.COMPLETION = PPCABRUPT (STATICBYTES $pchmessage(PCHDIAGNOSTIC "fatal" text_code ptbytes* ptcontext) ptcontext.LINE)]
def $ppclass_diagnostic(P, PCHDIAGNOSTIC text_level text_code ptbytes* ptcontext) = P[.DIAGNOSTICS = P.DIAGNOSTICS ++ [PLDIAGNOSTIC text_level "class-message" ([$pchmessage(PCHDIAGNOSTIC text_level text_code ptbytes* ptcontext)]) (P.LOCATION[.LINE = ptcontext.LINE])]]
  -- if text_level =/= "fatal"
def $plmessage(PLDIAGNOSTIC text "class-message" ([ptbytes]) pllocation) = ptbytes

dec $ppclass_early(pclassdesc*, ptbytes) : bool
def $ppclass_early(eps, ptbytes) = false
def $ppclass_early(pclassdesc :: pclassdesc_tail*, ptbytes) = true
  -- if pclassdesc.EARLY /\ $ptlc(pclassdesc.NAME) = $ptlc(ptbytes)
def $ppclass_early(pclassdesc :: pclassdesc_tail*, ptbytes) = $ppclass_early(pclassdesc_tail*, ptbytes)
  -- if ~(pclassdesc.EARLY /\ $ptlc(pclassdesc.NAME) = $ptlc(ptbytes))

dec $ppclass_result(ppstate, pcpath, pchresult) : ppstate
dec $ppclass_result_body(ppstate, pcpath, pchresult) : ppstate
def $ppclass_result(P, pcpath, pchresult) = $ppimage_publication($ppclass_result_body(P, pcpath, pchresult), PORIGIN P.FOLD.SOURCE.ID pcpath, PPCLASS, P.EARLY = (pcpath))
dec $ppproperty_body(phpType23) : bool
dec $ppmethod_body(phpType23) : bool
def $ppclass_result_body(P, pcpath, PCHUNSUPPORTED text) = $ppunsupported(P, text)
def $ppclass_result_body(P, pcpath, PCHERROR pchdiagnostic*) = $ppclass_diagnostics(P, pchdiagnostic*)
def $ppclass_result_body(P, pcpath, PCHOK pchheader pchdiagnostic*) = $ppunsupported($ppclass_diagnostics(P, pchdiagnostic*), "class inheritance, interfaces, attributes, or members")
  -- if pchheader.KIND = "class"
  -- if pchheader.BODY =/= SEQUENCE eps /\ ~$ppproperty_body(pchheader.BODY) /\ ~$ppmethod_body(pchheader.BODY)
def $ppclass_result_body(P, pcpath, PCHOK pchheader pchdiagnostic*) = $ppclass_diagnostics(P[.CLASSES = P.CLASSES ++ [{ ORIGIN PORIGIN P.FOLD.SOURCE.ID pcpath, KIND pchheader.KIND, NAME pchheader.NAME, PARENT eps, INTERFACES pchheader.INTERFACES, PROPERTIES eps, METHODS eps, CONSTANTS $ppclass_constants(P.CLASSCONSTANTS, PORIGIN P.FOLD.SOURCE.ID pcpath), ABSTRACT pchheader.ABSTRACT, FINAL pchheader.FINAL, READONLY pchheader.READONLY, EARLY (pchheader.INTERFACES = eps /\ P.EARLY = (pcpath) /\ ~$ppclass_early(P.CLASSES, pchheader.NAME) /\ ~$class_internal(pchheader.NAME)), LINE P.LOCATION.LINE }]], pchdiagnostic*)
  -- if pchheader.KIND = "class" /\ pchheader.PARENT = eps /\ pchheader.INTERFACES = eps /\ pchheader.BODY = SEQUENCE eps

dec $class_keyword_line(metadata, phpType3) : int
def $ppstatement(P, pcpath, NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata) = $ppunsupported(P, "missing ordinary compiler line")
  -- if P.COMPLETION = PPCNORMAL
  -- if $class_keyword_line(metadata, phpType3) = 0
def $ppstatement(P, pcpath, NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata) = $ppclass_result(P_line, pcpath, $pchcompile(NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata, false, $ppclass_context(P_line)))
  -- if P.CLASSCONTEXT = eps
  -- if P.COMPLETION = PPCNORMAL
  -- if $class_keyword_line(metadata, phpType3) = z
  -- if $(z > 0)
  -- if P_line = $pplocate(P, pcpath, z)
def $ppstatement(P, pcpath, NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata) = $ppclass_result(P_line, pcpath, $pchcompile(NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata, true, $ppclass_context(P_line)))
  -- if P.CLASSCONTEXT = (ptcontext)
  -- if P.COMPLETION = PPCNORMAL
  -- if $class_keyword_line(metadata, phpType3) = z
  -- if $(z > 0)
  -- if P_line = $pplocate(P, pcpath, z)

dec $ppclass_name(ppstate, pcpath, pnresult) : ppstate
dec $ppnew_class_name(ppstate, pcpath, name) : ppstate
dec $pptrait_new_deferred(ppstate, pcpath, name) : bool
dec $ppparameter_new_resolve(ppstate, pcpath, name) : ptbytes?
dec $pnclassresolve(plenv, name) : pnresult
dec $pnclassclear(pnresult) : pnresult
def $pnclassresolve(plenv, name) = $pnclassclear($pnqualify(plenv, PLCLASS, name, ptqual, ptbytes))
  -- if $ptast(name) = PTNAME ptqual ptbytes
  -- if $ptvalidname(ptbytes, true)
  -- if ~($ptlc(ptbytes) <- [$ptascii("self"), $ptascii("parent"), $ptascii("static")])
def $pnclassresolve(plenv, name) = PNUNSUPPORTED "self, parent, and static class binding"
  -- if $ptast(name) = PTNAME ptqual ptbytes
  -- if $ptlc(ptbytes) <- [$ptascii("self"), $ptascii("parent"), $ptascii("static")]
def $pnclassresolve(plenv, name) = PNUNSUPPORTED "invalid class name" -- otherwise
def $pnclassclear(PNRESOLVED pnreference) = PNRESOLVED pnreference[.FALLBACK = eps]
def $pnclassclear(PNUNSUPPORTED text) = PNUNSUPPORTED text
def $ppclass_name(P, pcpath, PNUNSUPPORTED text) = $ppunsupported(P, text)
def $ppclass_name(P, pcpath, PNRESOLVED pnreference) = P[.NAMES = P.NAMES ++ [(pcpath, pnreference)]][.FOLD = P.FOLD[.VALUE = eps]]

def $ppdispatch(P, pcpath, NExprNew name (SEQUENCE eps) metadata, PPR) = $ppnew_class_name(P, pcpath, name)
dec $ppnew_named(phpType28) : bool
def $ppnew_named(name) = true
def $ppnew_named(phpType28) = false -- otherwise
def $ppdispatch(P, pcpath, NExprNew phpType28 (SEQUENCE phpType7*) metadata, PPR) = $ppunsupported(P, "dynamic class target")
  -- if phpType7* =/= eps /\ ~$ppnew_named(phpType28)
def $ppdispatch(P, pcpath, NExprInstanceof expression name metadata, PPR) = $ppclass_name($ppexpr(P, pcpath ++ [PCFIELD 0], expression, PPR), pcpath, $pnclassresolve(P.ENV, name))
