;; ZEND_ASSIGN_DIM transfers the final writer into the implicit Set continuation.
;; The owned Get result and computed RHS survive while OP_DATA CV demand is late.
def $access_finish_task(KEY_WRITE_FINISH pkeywriter) = true
def $access_finish_task(ptask) = false -- otherwise
def $access_operand_roots(paccess) = $key_write_finish_roots(pkeywriter)
  -- if paccess.TASK = KEY_WRITE_FINISH pkeywriter

