;; Dynamic array INIT freezes dereferenced members before argument evaluation.
;; CONFIG and the waiting API own EX(This); these receipts own no heap values.
dec $fiber_array_new(pstate, nat, porigin, int, int) : pstate
dec $fiber_array_owner(pfiberarray) : nat?
dec $fiber_array_site_valid(pstate, pfiberarray) : bool
dec $fiber_array_receiver_live(pstate, pfiberarray) : bool
dec $fiber_array_source_valid(pstate, pfiberarray) : bool
dec $fiber_array_config_matches(pfiberarray, pconfigcall) : bool
dec $fiber_array_config_pair(ptask*, pconfigcall) : pfiberarray?
dec $fiber_array_at_site(ptask, porigin) : bool
dec $fiber_array_count(ptask*, porigin) : nat
dec $fiber_array_selected(pstate, pfiberarray, pconfigcall) : bool
dec $fiber_array_release_valid(pstate, pfiberarray) : bool
dec $fiber_array_result_valid(pstate, pfiberarray, pconfigcall) : bool

def $fiber_array_candidate(S, n) = $fiber_factory_candidate(S, PARRAY n)
def $array_dynamic(S, n, porigin, z_init, z_call) = $fiber_array_new(S, n, porigin, z_init, z_call)
  -- if $fiber_array_candidate(S, n)
def $fiber_array_new(S, n, porigin, z_init, z_call) = $throw_scalar(S, "Error", $ptascii("Call to undefined method Fiber::") ++ $c_string(ptbytes) ++ $ptascii("()"), z_init)
  -- if $fiber_factory_members(S, PARRAY n, $fiber_factory_items(S, PARRAY n)) = ((pvalue, ptbytes))
  -- if $fiber_factory_method(ptbytes) = eps
def $fiber_array_new(S, n, porigin, z_init, z_call) = $throw_scalar(S, "Error", $ptascii("Non-static method Fiber::") ++ $fiber_method_name(pintrinsic) ++ $ptascii("() cannot be called statically"), z_init)
  -- if $fiber_factory_members(S, PARRAY n, $fiber_factory_items(S, PARRAY n)) = ((PSTRING ptbytes_class, ptbytes))
  -- if $fiber_factory_method(ptbytes) = (pintrinsic)
  -- if ~$fiber_static(pintrinsic)
def $fiber_array_new(S, n, porigin, z_init, z_call) = S[.TODO = [CONFIG_ARGS pconfigcall, FIBER_ARRAY_RELEASE pfiberarray] ++ S.TODO][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if pentry* = $fiber_factory_items(S, PARRAY n)
  -- if $fiber_factory_selection(S, PARRAY n, pentry*) = ((pintrinsic, ptbytes, n_input?))
  -- if $fiber_kind(pintrinsic)
  -- if pfiberarray = {SITE porigin, INIT z_init, LINE z_call, ARRAY n, ITEMS pentry*, KIND pintrinsic, NAME ptbytes, INPUT n_input?}
  -- if pconfigcall = {SITE porigin, KIND pintrinsic, INDEX 0, SENT eps, NAMED false, OWNER $fiber_array_owner(pfiberarray), SELECTION eps, LINE z_call, PACKS eps}

def $fiber_array_owner(pfiberarray) = eps -- if $fiber_static(pfiberarray.KIND)
def $fiber_array_owner(pfiberarray) = pfiberarray.INPUT -- otherwise
def $fiber_array_site_valid(S, pfiberarray) = true
  -- if $origin_node(S.SOURCES, pfiberarray.SITE) = (NExprFuncCall expression (SEQUENCE phpType7*) metadata)
  -- if $ppcall_dynamic(expression) /\ ~$ppfirstclass(phpType7*)
  -- if $firstclass_evaluated(S, pfiberarray.SITE)
  -- if $dynamic_fixed_name(S, pfiberarray.SITE) = eps
  -- if pfiberarray.INIT = $dynamic_init_line(S, pfiberarray.SITE)
  -- if $call_line_valid(S, (pfiberarray.SITE), pfiberarray.LINE)
def $fiber_array_site_valid(S, pfiberarray) = false -- otherwise
def $fiber_array_receiver_live(S, pfiberarray) = true -- if $fiber_static(pfiberarray.KIND)
def $fiber_array_receiver_live(S, pfiberarray) = true
  -- if ~$fiber_static(pfiberarray.KIND)
  -- if pfiberarray.INPUT = (n_input)
  -- if $fiber_at(S, n_input) =/= eps
def $fiber_array_receiver_live(S, pfiberarray) = false -- otherwise
def $fiber_array_source_valid(S, pfiberarray) = true
  -- if $fiber_kind(pfiberarray.KIND)
  -- if $fiber_array_site_valid(S, pfiberarray)
  -- if $fiber_factory_members(S, PARRAY pfiberarray.ARRAY, pfiberarray.ITEMS) = ((PSTRING ptbytes_class, pfiberarray.NAME))
