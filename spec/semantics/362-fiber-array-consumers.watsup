  -- if ~$typed_callable_method(pfiberarray.NAME, false, false)
  -- if $fiber_method(pfiberarray.NAME) = (pfiberarray.KIND)
  -- if $fiber_static(pfiberarray.KIND) /\ pfiberarray.INPUT = eps
def $fiber_array_source_valid(S, pfiberarray) = true
  -- if $fiber_kind(pfiberarray.KIND)
  -- if $fiber_array_site_valid(S, pfiberarray)
  -- if pfiberarray.INPUT = (n_input)
  -- if $fiber_factory_members(S, PARRAY pfiberarray.ARRAY, pfiberarray.ITEMS) = ((POBJECT n_input, pfiberarray.NAME))
  -- if $fiber_factory_receiver(S, POBJECT n_input)
  -- if ~$typed_callable_method(pfiberarray.NAME, false, false)
  -- if $fiber_method(pfiberarray.NAME) = (pfiberarray.KIND)
def $fiber_array_source_valid(S, pfiberarray) = false -- otherwise
def $fiber_array_config_matches(pfiberarray, pconfigcall) = (pconfigcall.SITE = pfiberarray.SITE /\ pconfigcall.LINE = pfiberarray.LINE /\ pconfigcall.KIND = pfiberarray.KIND /\ pconfigcall.OWNER = $fiber_array_owner(pfiberarray) /\ pconfigcall.SELECTION = eps)
def $fiber_array_config_pair(ptask :: (FIBER_ARRAY_RELEASE pfiberarray) :: ptask_tail*, pconfigcall) = (pfiberarray)
  -- if $fiber_capture_config_task(ptask, pconfigcall)
def $fiber_array_config_pair(ptask :: (FIBER_ARRAY_RESULT pfiberarray pconfigcall) :: ptask_tail*, pconfigcall) = (pfiberarray)
  -- if $fiber_capture_config_task(ptask, pconfigcall)
def $fiber_array_config_pair(ptask :: ptask_tail*, pconfigcall) = $fiber_array_config_pair(ptask_tail*, pconfigcall)
  -- if ~$fiber_capture_config_task(ptask, pconfigcall)
def $fiber_array_config_pair(ptask*, pconfigcall) = eps -- otherwise
;; A user argument frame has its own TODO; recursive calls at the same site
;; therefore retain independent receipts instead of sharing a global count.
def $fiber_array_at_site(FIBER_ARRAY_RELEASE pfiberarray, porigin) = (pfiberarray.SITE = porigin)
def $fiber_array_at_site(FIBER_ARRAY_RESULT pfiberarray pconfigcall, porigin) = (pfiberarray.SITE = porigin)
def $fiber_array_at_site(ptask, porigin) = false -- otherwise
def $fiber_array_count(eps, porigin) = 0
def $fiber_array_count(ptask :: ptask_tail*, porigin) = $(1 + $fiber_array_count(ptask_tail*, porigin))
  -- if $fiber_array_at_site(ptask, porigin)
def $fiber_array_count(ptask :: ptask_tail*, porigin) = $fiber_array_count(ptask_tail*, porigin)
  -- if ~$fiber_array_at_site(ptask, porigin)
def $fiber_array_selected(S, pfiberarray, pconfigcall) = true
  -- if $fiber_array_source_valid(S, pfiberarray)
  -- if $fiber_array_config_matches(pfiberarray, pconfigcall)
  -- if $fiber_array_config_pair(S.TODO, pconfigcall) = (pfiberarray)
  -- if $fiber_array_count(S.TODO, pfiberarray.SITE) = 1
  -- if $generator_flat_tasks(S.TODO)
  -- if $fiber_array_receiver_live(S, pfiberarray)
def $fiber_array_selected(S, pfiberarray, pconfigcall) = false -- otherwise
def $config_selected_valid(S, pconfigcall) = true
  -- if $fiber_kind(pconfigcall.KIND) /\ pconfigcall.SELECTION = eps
  -- if $fiber_array_config_pair(S.TODO, pconfigcall) = (pfiberarray)
  -- if $fiber_array_selected(S, pfiberarray, pconfigcall)
def $fiber_array_config_pending(S, pconfigcall) = true
  -- if S.TODO = (CONFIG_INVOKE pconfigcall) :: (FIBER_ARRAY_RELEASE pfiberarray) :: ptask_tail*
  -- if $fiber_array_config_matches(pfiberarray, pconfigcall)
def $fiber_array_config_pending(S, pconfigcall) = false -- otherwise
rule PhpStep/fiber-array-invoke: S ~> $fiber_receive(S[.TODO = (CONFIG_INVOKE pconfigcall) :: (FIBER_ARRAY_RESULT pfiberarray pconfigcall) :: ptask_tail*], pconfigcall)
  -- if S.TODO = (CONFIG_INVOKE pconfigcall) :: (FIBER_ARRAY_RELEASE pfiberarray) :: ptask_tail*
  -- if $fiber_array_selected(S, pfiberarray, pconfigcall)
  -- if $config_invoke_valid(S, pconfigcall)

def $fiber_array_release_valid(S, pfiberarray) = ($fiber_array_source_valid(S, pfiberarray) /\ S.ORIGIN = (pfiberarray.SITE) /\ $fiber_array_count(S.TODO, pfiberarray.SITE) = 1 /\ $generator_flat_tasks(S.TODO))
def $fiber_array_result_valid(S, pfiberarray, pconfigcall) = true
  -- if $fiber_array_release_valid(S, pfiberarray)
  -- if $fiber_array_config_matches(pfiberarray, pconfigcall)
  -- if $intrinsic_count(S, pconfigcall.SITE) = (pconfigcall.INDEX)
  -- if $config_sent_shape(S, pconfigcall)
def $fiber_array_result_valid(S, pfiberarray, pconfigcall) = false -- otherwise
def $task_nodes(FIBER_ARRAY_RELEASE pfiberarray) = eps
def $task_nodes(FIBER_ARRAY_RESULT pfiberarray pconfigcall) = eps
def $call_task_valid(S, FIBER_ARRAY_RELEASE pfiberarray) = $fiber_array_release_valid(S, pfiberarray)
def $call_task_valid(S, FIBER_ARRAY_RESULT pfiberarray pconfigcall) = $fiber_array_result_valid(S, pfiberarray, pconfigcall)
def $fiber_marker(FIBER_ARRAY_RELEASE pfiberarray) = true
def $fiber_marker(FIBER_ARRAY_RESULT pfiberarray pconfigcall) = true
def $generator_internal_task(FIBER_ARRAY_RELEASE pfiberarray) = true
def $generator_internal_task(FIBER_ARRAY_RESULT pfiberarray pconfigcall) = true
rule PhpStep/fiber-array-release: S ~> S[.TODO = ptask_tail*]
  -- if S.TODO = (FIBER_ARRAY_RELEASE pfiberarray) :: ptask_tail*
  -- if $fiber_array_release_valid(S, pfiberarray)
rule PhpStep/fiber-array-result: S ~> S[.TODO = ptask_tail*]
  -- if S.TODO = (FIBER_ARRAY_RESULT pfiberarray pconfigcall) :: ptask_tail*
  -- if $fiber_array_result_valid(S, pfiberarray, pconfigcall)
rule PhpStep/fiber-array-throw-release: S ~> S[.TODO = (THROW_SEARCH n_throwable) :: ptask_tail*]
  -- if S.TODO = (THROW_SEARCH n_throwable) :: (FIBER_ARRAY_RELEASE pfiberarray) :: ptask_tail*
  -- if $fiber_array_release_valid(S, pfiberarray)
  -- if $throwable_live(S, n_throwable)
rule PhpStep/fiber-array-throw-result: S ~> S[.TODO = (THROW_SEARCH n_throwable) :: ptask_tail*]
  -- if S.TODO = (THROW_SEARCH n_throwable) :: (FIBER_ARRAY_RESULT pfiberarray pconfigcall) :: ptask_tail*
  -- if $fiber_array_result_valid(S, pfiberarray, pconfigcall)
  -- if $throwable_live(S, n_throwable)

;; The saved API owns its actual argument buffer and ordinary bound receiver.
;; Static suspend instead names the running Fiber, independent of input object.
