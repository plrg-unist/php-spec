  -- if $weakmap_iterator_outer_valid(S, n, n_object, statement, porigin_site, z)
  -- if $weakmap_iterator_cached(S, n_object, poperand)
  -- if S.OBJECTS[n_object] = WEAKMAPITERATOR n_map n_inner
  -- if $iterator_lookup(S.ITERATORS, n_inner) = (WEAKMAPOWNEDITER n_inner n_object n_map 0)
  -- if S.OBJECTS[n_map] = WEAKMAP (pweakmapentry)
def $useriter_call(S, n, n_object, statement, porigin_site, z, "next", KNOWN PNULL, ptask_tail*) = $weakmap_iterator_result(S[.ITERATORS = $iterator_set(S.ITERATORS, WEAKMAPOWNEDITER n_inner n_object n_map 1)], n, n_object, statement, porigin_site, z, "next", KNOWN PNULL, ptask_tail*, PNULL)
  -- if $weakmap_iterator_outer_valid(S, n, n_object, statement, porigin_site, z)
  -- if S.OBJECTS[n_object] = WEAKMAPITERATOR n_map n_inner

;; Manual methods own only their ordinary result. The factory's inner cursor
;; remains, but an active outer cache must not be retargeted through this API.
dec $weakmap_iterator_api_allowed(pstate, nat, ptbytes, phpType7*) : bool
def $weakmap_iterator_api_allowed(S, n_object, ptbytes, eps) = true
  -- if $ptlc(ptbytes) <- [$ptascii("rewind"), $ptascii("valid"), $ptascii("current"), $ptascii("key"), $ptascii("next")]
  -- if S.CURRENT = eps /\ S.FRAMES = eps /\ S.FIBERCALLERS = eps
  -- if S.DESTRUCTION.RELEASES = eps /\ S.DESTRUCTION.OPERATIONS = eps
  -- if $weakmap_iterator_valid(S, n_object)
  -- if S.OBJECTS[n_object] = WEAKMAPITERATOR n_map n_inner
  -- if |S.ITERATORS| = 1
  -- if S.ORIGIN = (porigin)
  -- if $origin_node(S.SOURCES, porigin) = (NExprMethodCall expression_receiver phpType20 (SEQUENCE eps) metadata)
  -- if $method_source_task(S, NExprMethodCall expression_receiver phpType20 (SEQUENCE eps) metadata)
  -- if $method_source_name(phpType20, ptbytes)
  -- if $weakmap_foreach_name(expression_receiver) = (n_name*)
  -- if S_receiver = $quiet_operand(S, VARIABLE n_name* 0)
  -- if S_receiver.COMPLETION = NORMAL /\ S_receiver.RESULT = KNOWN (POBJECT n_object)
def $weakmap_iterator_api_allowed(S, n_object, ptbytes, phpType7*) = false -- otherwise
dec $weakmap_iterator_api_done(pstate, pvalue) : pstate
def $weakmap_iterator_api_done(S, pvalue) = S[.TODO = METHOD_RESULT :: ptask_tail*][.RESULT = KNOWN pvalue][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = ptask :: ptask_tail*
dec $weakmap_iterator_many_current(pstate, nat) : (pweakmapentry, nat)?
def $weakmap_iterator_many_current(S, n_object) = $weakmap_entries_cursor_next($weakmap_entries_contents(S, n_map), n_position, n_keys*)
  -- if S.OBJECTS[n_object] = WEAKMAPITERATOR n_map n_inner
  -- if $iterator_lookup(S.ITERATORS, n_inner) = (WEAKMAPOWNEDKEYITER n_inner n_object n_map n_position n_keys*)
def $weakmap_iterator_many_current(S, n_object) = eps -- otherwise
dec $weakmap_iterator_api_value(pstate, nat, bool) : pvalue
def $weakmap_iterator_api_value(S, n_object, false) = pvalue
  -- if S.OBJECTS[n_object] = WEAKMAPITERATOR n_map n_inner
  -- if $iterator_lookup(S.ITERATORS, n_inner) = (WEAKMAPOWNEDITER n_inner n_object n_map 0)
  -- if S.OBJECTS[n_map] = WEAKMAP (pweakmapentry)
  -- if pvalue = pweakmapentry.VALUE
def $weakmap_iterator_api_value(S, n_object, true) = POBJECT pweakmapentry.KEY
  -- if S.OBJECTS[n_object] = WEAKMAPITERATOR n_map n_inner
  -- if $iterator_lookup(S.ITERATORS, n_inner) = (WEAKMAPOWNEDITER n_inner n_object n_map 0)
  -- if S.OBJECTS[n_map] = WEAKMAP (pweakmapentry)
def $weakmap_iterator_api_value(S, n_object, false) = pvalue
  -- if $weakmap_iterator_many_current(S, n_object) = (pweakmapentry_selected, n_next)
  -- if pvalue = pweakmapentry_selected.VALUE
def $weakmap_iterator_api_value(S, n_object, true) = POBJECT pweakmapentry_selected.KEY
  -- if $weakmap_iterator_many_current(S, n_object) = (pweakmapentry_selected, n_next)
def $weakmap_iterator_api_value(S, n_object, b_key) = PNULL -- otherwise
dec $weakmap_iterator_api(pstate, nat, ptbytes) : pstate
def $weakmap_iterator_api(S, n_object, ptbytes) = $weakmap_iterator_api_done(S, $weakmap_iterator_api_value(S, n_object, ptbytes = $ptascii("key")))
  -- if ptbytes <- [$ptascii("current"), $ptascii("key")]
def $weakmap_iterator_api(S, n_object, ptbytes) = $weakmap_iterator_api_done(S[.ITERATORS = [WEAKMAPOWNEDITER n_inner n_object n_map 0]], PNULL)
  -- if ptbytes = $ptascii("rewind")
  -- if S.OBJECTS[n_object] = WEAKMAPITERATOR n_map n_inner
  -- if $weakmap_iterator_single_cursor(S, n_object)
def $weakmap_iterator_api(S, n_object, ptbytes) = $weakmap_iterator_api_done(S[.ITERATORS = [WEAKMAPOWNEDITER n_inner n_object n_map 1]], PNULL)
  -- if ptbytes = $ptascii("next")
  -- if S.OBJECTS[n_object] = WEAKMAPITERATOR n_map n_inner
  -- if $weakmap_iterator_single_cursor(S, n_object)
def $weakmap_iterator_api(S, n_object, ptbytes) = $weakmap_iterator_api_done(S, PBOOL (n_position = 0 /\ S.OBJECTS[n_map] =/= WEAKMAP eps))
  -- if ptbytes = $ptascii("valid")
  -- if S.OBJECTS[n_object] = WEAKMAPITERATOR n_map n_inner
  -- if $iterator_lookup(S.ITERATORS, n_inner) = (WEAKMAPOWNEDITER n_inner n_object n_map n_position)
def $weakmap_iterator_api(S, n_object, ptbytes) = $weakmap_iterator_api_done(S[.ITERATORS = [WEAKMAPOWNEDKEYITER n_inner n_object n_map 0 n_keys*]], PNULL)
  -- if ptbytes = $ptascii("rewind")
  -- if S.OBJECTS[n_object] = WEAKMAPITERATOR n_map n_inner
  -- if $iterator_lookup(S.ITERATORS, n_inner) = (WEAKMAPOWNEDKEYITER n_inner n_object n_map n_position n_keys*)
def $weakmap_iterator_api(S, n_object, ptbytes) = $weakmap_iterator_api_done(S[.ITERATORS = [WEAKMAPOWNEDKEYITER n_inner n_object n_map n_next n_keys*]], PNULL)
  -- if ptbytes = $ptascii("next")
  -- if S.OBJECTS[n_object] = WEAKMAPITERATOR n_map n_inner
  -- if $iterator_lookup(S.ITERATORS, n_inner) = (WEAKMAPOWNEDKEYITER n_inner n_object n_map n_position n_keys*)
  -- if $weakmap_iterator_many_current(S, n_object) = (pweakmapentry_selected, n_next)
def $weakmap_iterator_api(S, n_object, ptbytes) = $weakmap_iterator_api_done(S[.ITERATORS = [WEAKMAPOWNEDKEYITER n_inner n_object n_map n_end n_keys*]], PNULL)
  -- if ptbytes = $ptascii("next")
  -- if S.OBJECTS[n_object] = WEAKMAPITERATOR n_map n_inner
  -- if $iterator_lookup(S.ITERATORS, n_inner) = (WEAKMAPOWNEDKEYITER n_inner n_object n_map n_position n_keys*)
  -- if $weakmap_iterator_many_current(S, n_object) = eps
  -- if n_end = |n_keys*|
def $weakmap_iterator_api(S, n_object, ptbytes) = $weakmap_iterator_api_done(S, PBOOL ($weakmap_iterator_many_current(S, n_object) =/= eps))
  -- if ptbytes = $ptascii("valid")
  -- if S.OBJECTS[n_object] = WEAKMAPITERATOR n_map n_inner
  -- if $iterator_lookup(S.ITERATORS, n_inner) = (WEAKMAPOWNEDKEYITER n_inner n_object n_map n_position n_keys*)
;; Compute the source/storage certificate once before the complementary result.
dec $weakmap_iterator_api_dispatch(pstate, nat, ptbytes, bool) : pstate
def $weakmap_iterator_api_dispatch(S, n_object, ptbytes, true) = $weakmap_iterator_api(S, n_object, $ptlc(ptbytes))
def $weakmap_iterator_api_dispatch(S, n_object, ptbytes, false) = S[.COMPLETION = UNSUPPORTED "WeakMap InternalIterator method source or storage"]
def $method_select(S, poperand, ptbytes, phpType7*, z) = $weakmap_iterator_api_dispatch(S_read, n_object, ptbytes, $weakmap_iterator_api_allowed(S_read, n_object, ptbytes, phpType7*))
  -- if S_read = $resolve_at(S, poperand, z)
  -- if S_read.COMPLETION = NORMAL
  -- if S_read.RESULT = KNOWN (POBJECT n_object)
  -- if $weakmap_iterator_at(S_read, n_object)
def $clone_value(S, POBJECT n_object, z) = S[.COMPLETION = UNSUPPORTED "WeakMap InternalIterator clone protocol"]
  -- if $weakmap_iterator_at(S, n_object)
