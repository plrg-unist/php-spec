def $weakmap_iterator_foreach(S, n_object, statement, false, z) = $useriter_call(S[.ITERATORS = S.ITERATORS ++ [OBJECTITER n n_object 0 false]][.NEXTITER = $(n + 1)], n, n_object, statement, porigin_site, z, "rewind", KNOWN PNULL, ptask_tail*)
