;; Nonpublic named-class groups keep the ordinary flags/type/item compiler.
def $ppmember_groups(P, pcpath, n, (NStmtClassConst (SEQUENCE phpType15*) (INTEGER flags) phpType18 (SEQUENCE phpType46*) metadata) :: statement_tail*, ppropertydesc*, pmethoddesc*, pchheader) = $ppmember_groups(P_next, pcpath, $(n + 1), statement_tail*, ppropertydesc*, pmethoddesc*, pchheader)
  -- if P.COMPLETION = PPCNORMAL
  -- if pchheader.KIND = "class"
  -- if $ppmethod_visibility(flags) <- [PROPERTY_PROTECTED, PROPERTY_PRIVATE]
  -- if $origin_node([P.FOLD.SOURCE], PORIGIN P.FOLD.SOURCE.ID pcpath) = (NStmtClass phpType14 (INTEGER flags_class) (NIdentifier phpType33 metadata_owner_name) phpType44 phpType42 phpType23 metadata_owner)
  -- if phpType46* = (NConst phpType11 expression metadata_constant) :: phpType46_tail*
  -- if phpType15* = [NAttributeGroup (SEQUENCE ([NAttribute name (SEQUENCE eps) metadata_attribute])) metadata_attributes]
  -- if $ppconstant_attribute_reference(P.ENV, name) = PNRESOLVED pnreference
  -- if $ptlc(pnreference.RESOLVED) = $ptascii("deprecated")
  -- if $ppproperty_group_line_valid(P, metadata)
  -- if pcpath_group = $ppmember_path(pcpath, pchheader, n)
  -- if z = $source_line(metadata_constant)
  -- if P_attributes = $ppconstant_attribute_groups($pplocate(P, pcpath_group, z), pcpath_group ++ [PCFIELD 0], 0, phpType15*)
  -- if P_next = $ppclass_constant_group(P_attributes, pcpath_group, PORIGIN P.FOLD.SOURCE.ID pcpath, flags, phpType18, phpType46*, pchheader, z)

;; Recognition is source metadata; access belongs to the current notice proof.
def $class_constant_deprecated(S, pclassconstantdesc) = true
  -- if pclassconstantdesc.VISIBILITY <- [PROPERTY_PROTECTED, PROPERTY_PRIVATE]
  -- if $class_at(S.CLASSES, pclassconstantdesc.OWNER) = (pclassdesc)
  -- if pclassdesc.KIND = "class"
  -- if $class_constant_attribute_group(S.SOURCES, pclassconstantdesc) = ((PORIGIN n_unit pcpath_group, phpType15*))
  -- if $origin_node(S.SOURCES, PORIGIN n_unit pcpath_group) = (NStmtClassConst (SEQUENCE phpType15*) (INTEGER flags) phpType18 phpType45 metadata_group)
  -- if $ppmethod_visibility(flags) = pclassconstantdesc.VISIBILITY
  -- if $source_unit(S.SOURCES, n_unit) = (pcunit)
  -- if $code_at(S.CODE, n_unit) = (pcode)
  -- if $constant_attribute_groups(pcunit, pcode, pcpath_group ++ [PCFIELD 0], 0, phpType15*) = BUILTIN_ATTRIBUTES ([pbuiltinattribute])
  -- if $ptlc(pbuiltinattribute.NAME) = $ptascii("deprecated")
  -- if pbuiltinattribute.ARGUMENTS = SEQUENCE eps
