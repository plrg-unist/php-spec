dec $property_isset_entered(pstate, pcallcontext?, pframe*, ppropertyisset) : bool
def $property_isset_entered(S, (pcallcontext), pframe :: pframe_tail*, ppropertyisset) = $property_isset_frame(S, pcallcontext, pframe, ppropertyisset)
  -- if pcallcontext.TARGET = PROPERTY_ISSET_TARGET ppropertyisset
