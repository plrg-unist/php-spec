  -- if S.ORIGIN = (ppropertyisset.SITE)
  -- if $property_isset_untyped(S, ppropertyisset) /\ $property_isset_valid(S, ppropertyisset)

;; RESULT owns the receiver; normal completion or abrupt discard drops it once.
def $task_nodes(PROPERTY_ISSET_RESULT ppropertyisset) = [HOBJECT ppropertyisset.OBJECT]
def $target_nodes(PROPERTY_ISSET_TARGET ppropertyisset) = eps
def $target_instance(PROPERTY_ISSET_TARGET ppropertyisset) = eps
def $target_receiver(S, PROPERTY_ISSET_TARGET ppropertyisset) = (ppropertyisset.OBJECT)
def $target_lexical_class(S, PROPERTY_ISSET_TARGET ppropertyisset) = $target_lexical_class(S, METHOD_TARGET ppropertyisset.OBJECT ppropertyisset.METHOD)
def $target_called_class(S, PROPERTY_ISSET_TARGET ppropertyisset) = (ppropertyisset.CLASS)
def $target_function(S, PROPERTY_ISSET_TARGET ppropertyisset) = $property_isset_function(S, ppropertyisset)
  -- if $property_isset_valid(S, ppropertyisset)
def $call_receiver_roots(pcallcontext) = eps
  -- if pcallcontext.TARGET = PROPERTY_ISSET_TARGET ppropertyisset

def $call_selected_valid(S, PROPERTY_ISSET_TARGET ppropertyisset, (porigin)) = (porigin = ppropertyisset.SITE /\ ($property_isset_pending_call(S, ppropertyisset) \/ $property_isset_entered(S, S.CURRENT, S.FRAMES, ppropertyisset)))
def $call_arguments_valid(S, (porigin), 1, eps, poperand :: eps, 0) = true
  -- if S.TODO = (CALL_ARGS (PROPERTY_ISSET_TARGET ppropertyisset) eps 1 (poperand :: eps) (porigin) z) :: ptask_tail*
