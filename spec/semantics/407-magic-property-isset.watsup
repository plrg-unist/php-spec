  -- if S.ORIGIN = (ppropertyisset.SITE) /\ S.BASE = BASE_VALUE (KNOWN PNULL)
  -- if $property_isset_untyped(S, ppropertyisset) /\ $property_isset_valid(S, ppropertyisset)
  -- if S.RESULT = KNOWN (POBJECT n_rv)
  -- if $(n_rv < |S.OBJECTS|) /\ (HOBJECT n_rv) <- S.ALLOCATIONS
  -- if S.OBJECTS[n_rv] = INSTANCE porigin_class
  -- if $class_at(S.CLASSES, porigin_class) = (pclassdesc)
  -- if pclassdesc.KIND = "class" /\ ~$instance_storage_freeing(S, n_rv)
def $property_isset_rv_ready(S, ppropertyisset) = true
  -- if S.COMPLETION = NORMAL /\ S.SOURCEPENDING = eps
  -- if $property_magic_cv_result_supported(S, ppropertyisset.SITE, ppropertyisset.LINE, false, S.RESULT)
  -- if S.TODO = (PROPERTY_ISSET_RESULT ppropertyisset) :: ptask_tail*
  -- if S.ORIGIN = (ppropertyisset.SITE) /\ S.BASE = BASE_VALUE (KNOWN PNULL)
  -- if $property_isset_untyped(S, ppropertyisset) /\ $property_isset_valid(S, ppropertyisset)
  -- if S.RESULT = KNOWN (PARRAY n_rv)
  -- if $(n_rv < |S.ARRAYS|) /\ (HARRAY n_rv) <- S.ALLOCATIONS
def $property_isset_rv_ready(S, ppropertyisset) = false -- otherwise
rule PhpStep/property-isset-rv-release: S ~> S[.RESULT = KNOWN (PBOOL $truth(S, pvalue))]
  -- if S.TODO = (PROPERTY_ISSET_RESULT ppropertyisset) :: ptask_tail*
  -- if $property_isset_rv_ready(S, ppropertyisset)
  -- if S.RESULT = KNOWN pvalue
rule PhpStep/property-isset-result-unsupported: S ~> S[.COMPLETION = UNSUPPORTED "magic isset result type"]
  -- if S.TODO = (PROPERTY_ISSET_RESULT ppropertyisset) :: ptask_tail*
