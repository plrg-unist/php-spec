def $property_isset_cleanup(S, ppropertyisset) = false -- otherwise
def $call_task_valid(S, PROPERTY_ISSET_RESULT ppropertyisset) = ($property_isset_pending_call(S, ppropertyisset) \/ $property_isset_tail(S, ppropertyisset, S.TODO) \/ $property_isset_throw_tail(S, ppropertyisset) \/ $property_isset_cleanup(S, ppropertyisset))
