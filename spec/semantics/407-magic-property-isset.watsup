;; NaN truth conversion keeps Empty's Isset guard while its handler runs.
rule PhpStep/property-isset-nan-guarded: S ~> S[.TODO = ptask_tail*][.RESULT = KNOWN (PBOOL false)][.BASE = BASE_VALUE (KNOWN PNULL)]
