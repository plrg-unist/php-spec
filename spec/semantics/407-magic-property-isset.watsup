dec $property_isset_guard(pstate, pcallcontext?, pframe*, nat, ptbytes) : bool
def $property_isset_guard(S, (pcallcontext), pframe :: pframe_tail*, n, ptbytes) = ($property_isset_guard_frame(S, pcallcontext, pframe, n, ptbytes) \/ $property_isset_guard(S, pframe.CONTEXT, pframe_tail*, n, ptbytes))
def $property_isset_guard(S, eps, pframe :: pframe_tail*, n, ptbytes) = $property_isset_guard(S, pframe.CONTEXT, pframe_tail*, n, ptbytes)
def $property_isset_guard(S, pcallcontext?, eps, n, ptbytes) = false

