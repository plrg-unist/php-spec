def $target_called_class(S, PROPERTY_ISSET_TARGET ppropertyisset) = (ppropertyisset.CLASS)
def $target_function(S, PROPERTY_ISSET_TARGET ppropertyisset) = $property_isset_function(S, ppropertyisset)
