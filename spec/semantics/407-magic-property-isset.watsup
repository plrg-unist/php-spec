  -- if pcallcontext.TARGET =/= PROPERTY_ISSET_TARGET ppropertyisset
def $property_isset_entered(S, eps, pframe :: pframe_tail*, ppropertyisset) = $property_isset_entered(S, pframe.CONTEXT, pframe_tail*, ppropertyisset)
def $property_isset_entered(S, pcallcontext?, eps, ppropertyisset) = false

dec $property_isset_guard_frame(pstate, pcallcontext, pframe, nat, ptbytes) : bool
