;; Keep the receiver marker while ordinary eager disposal releases the RV.
dec $property_isset_rv_ready(pstate, ppropertyisset) : bool
def $property_isset_rv_ready(S, ppropertyisset) = true
  -- if S.COMPLETION = NORMAL /\ S.SOURCEPENDING = eps
