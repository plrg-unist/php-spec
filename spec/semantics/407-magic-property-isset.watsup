  -- if pcallcontext.CALLSITE = (ppropertyisset.SITE) /\ pcallcontext.LINE = ppropertyisset.LINE
  -- if pcallcontext.ARGC = 1 /\ pcallcontext.EXTRA = eps /\ pcallcontext.NAMED = eps /\ pcallcontext.WRAPPER = eps /\ pcallcontext.HOLES = eps
  -- if $property_isset_entered(S, S.CURRENT, S.FRAMES, ppropertyisset)
def $property_isset_context(S, pcallcontext) = false -- otherwise
def $call_arity_valid(S, pcallcontext) = $property_isset_context(S, pcallcontext)
  -- if pcallcontext.TARGET = PROPERTY_ISSET_TARGET ppropertyisset
def $call_extent_valid(S, pcallcontext) = $property_isset_context(S, pcallcontext)
  -- if pcallcontext.TARGET = PROPERTY_ISSET_TARGET ppropertyisset
def $named_context_valid(S, pcallcontext) = $property_isset_context(S, pcallcontext)
  -- if pcallcontext.TARGET = PROPERTY_ISSET_TARGET ppropertyisset
def $named_receives_ready(S, pfunction) = true
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.FUNCTION = pfunction.ORIGIN
  -- if $property_isset_context(S, pcallcontext)
;; Existing eager records authenticate the still-queued marker in a saved RV D.
dec $property_isset_cleanup(pstate, ppropertyisset) : bool
def $property_isset_cleanup(S, ppropertyisset) = true
  -- if S.TODO = (DESTRUCTOR_RESULT pdestructorcall) :: (DESTRUCTOR_RELEASE pdestructionrelease) :: (DESTRUCTOR_OPERATION_EXIT pdestructionoperation) :: (PROPERTY_ISSET_RESULT ppropertyisset) :: ptask_tail*
