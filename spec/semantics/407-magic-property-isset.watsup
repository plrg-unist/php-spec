;; RESULT owns the receiver; normal completion or abrupt discard drops it once.
def $task_nodes(PROPERTY_ISSET_RESULT ppropertyisset) = [HOBJECT ppropertyisset.OBJECT]
def $target_nodes(PROPERTY_ISSET_TARGET ppropertyisset) = eps
def $target_instance(PROPERTY_ISSET_TARGET ppropertyisset) = eps
