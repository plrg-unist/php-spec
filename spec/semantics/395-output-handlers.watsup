def $ob_user_deprecation(pobinvoke) = $intrinsic_name(pobinvoke.CALL.KIND) ++ $ptascii("(): Producing output from user output handler ") ++ $ob_buffer_name(pobinvoke.BUFFER) ++ $ptascii(" is deprecated")
