def $ob_user_bytes(pvalue, z) = n* -- if $string_bytes(pvalue) = (n*)
def $ob_user_output(S, pvalue) = {VALUE pvalue, BYTES $ob_user_bytes(pvalue, $precision_value(S)), PRECISION $precision_value(S), FAILED (pvalue = PBOOL false)}
