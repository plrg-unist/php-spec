def $ob_user_scalar(pvalue) = (pvalue = PNULL \/ $typed_scalar(pvalue))
def $ob_user_bytes(PNULL, z) = eps
def $ob_user_bytes(PBOOL b, z) = eps
def $ob_user_bytes(PINT i, z) = $decimal_integer(i)
