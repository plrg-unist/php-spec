;; OnSetPrecision retains raw INI bytes and accepts only signed64 values >= -1.
;; zend_double_to_str narrows the live value to signed32 at each conversion.
dec $precision_ini_long(preqbytes) : int
def $precision_ini_long(preqbytes) = $reporting_ini_long(n_sign, n_digits)
  -- if (n_sign, n_value*) = $ntsign($nttrim($c_string(preqbytes)))
  -- if DIGITS n_digits n_count n_tail* = $ntdigits(n_value*, 0, 0)
dec $precision_ini_valid(preqbytes) : bool
def $precision_ini_valid(preqbytes) = ($startup_bytes(preqbytes) /\ $($precision_ini_long(preqbytes) >= -1))
def $precision_value(S) = $precision_ini_long(S.PRECISIONINI)
dec $precision_main_entry_valid(pstate) : bool
dec $precision_eval_waits_valid(pstate, pevalcontext*) : bool
dec $precision_file_waits_valid(pstate, pfilecontext*) : bool
def $precision_state_valid(S) = ($precision_ini_valid(S.PRECISIONINIT) /\ $precision_ini_valid(S.PRECISIONINI) /\ (S.PRECISIONMODIFIED \/ S.PRECISIONINI = S.PRECISIONINIT) /\ $precision_main_entry_valid(S) /\ $precision_eval_waits_valid(S, S.EVALCONTEXTS) /\ $precision_file_waits_valid(S, S.FILECONTEXTS))
def $precision_restore(S) = S[.PRECISIONINI = S.PRECISIONINIT][.PRECISIONMODIFIED = false]
  -- if S.PRECISIONMODIFIED
def $precision_restore(S) = S -- otherwise
;; zend_alter_ini_entry marks modification before invoking a rejecting modifier.
def $precision_set(S, preqbytes_new, preqbytes_old) = S[.PRECISIONINI = preqbytes_new][.PRECISIONMODIFIED = true][.RESULT = KNOWN (PSTRING preqbytes_old)]
  -- if $($precision_ini_long(preqbytes_new) >= -1)
def $precision_set(S, preqbytes_new, preqbytes_old) = S[.PRECISIONMODIFIED = true][.RESULT = KNOWN (PBOOL false)]
  -- if $($precision_ini_long(preqbytes_new) < -1)

;; Compiler memory uses a numeric input, distinct from live request INI bytes.
def $precision_memory(S, z_precision) = S[.PRECISIONINIT = preqbytes][.PRECISIONINI = preqbytes][.PRECISIONMODIFIED = false]
  -- if preqbytes = $decimal_integer(z_precision)
def $compile_source_precision(S, P) = P
  -- if $precision_value(P.FOLD.MEMORY) = $precision_value(S)
def $compile_source_precision(S, P) = $ppstart_precision_external(P.FOLD.SOURCE.ID, P.FOLD.SOURCE.AST, P.LOCATION.FILE, P.FOLD.CWD, P.EVALCLASS, P.FOLD.EXTERNAL, $precision_value(S))
  -- if $precision_value(P.FOLD.MEMORY) =/= $precision_value(S)

def $source_precision(S, (PORIGIN n pcpath)) = $declaration_precision(S.DECLARATIONS, n)
  -- if S.DECLARATIONS =/= eps
def $source_precision(S, porigin?) = (14)
  -- if S.SOURCES = eps /\ S.CODE = eps /\ S.DECLARATIONS = eps
def $source_precision(S, porigin?) = eps -- otherwise
;; Deferred AST operands convert when evaluated; ordinary compiled literals keep
;; their source precision, including ordinary code called by an initializer.
def $concat_runtime_constant(S, porigin) = $constant_expression_below(S, pconstantcontext.ORIGIN, porigin)
  -- if S.CONSTCONTEXT = (pconstantcontext)
def $concat_runtime_constant(S, porigin) = false -- otherwise
def $parser_literal_origin(S, porigin?, expression) = $parser_literal_at(expression, z_precision)
  -- if $source_precision(S, porigin?) = (z_precision)
def $parser_literal_origin(S, porigin?, expression) = eps -- otherwise
def $cv_source_name(S, phpType32) = $cv_name_at(phpType32, z_precision)
  -- if $source_precision(S, S.ORIGIN) = (z_precision)
def $cv_source_name(S, phpType32) = eps -- otherwise

;; Capture entry checks are independent of later callback writes to live INI.
def $precision_main_entry_valid(S) = (z_precision = $precision_ini_long(S.PRECISIONINIT))
  -- if $declaration_precision(S.DECLARATIONS, 0) = (z_precision)
def $precision_main_entry_valid(S) = true -- otherwise
def $precision_eval_waits_valid(S, eps) = true
def $precision_eval_waits_valid(S, pevalcontext :: pevalcontext_tail*) = ($declaration_precision(S.DECLARATIONS, pevalcontext.UNIT) = ($precision_value(S)) /\ $precision_eval_waits_valid(S, pevalcontext_tail*))
  -- if pevalcontext.PHASE = PARSER_WAIT
def $precision_eval_waits_valid(S, pevalcontext :: pevalcontext_tail*) = $precision_eval_waits_valid(S, pevalcontext_tail*)
  -- if pevalcontext.PHASE =/= PARSER_WAIT
def $precision_file_waits_valid(S, eps) = true
def $precision_file_waits_valid(S, pfilecontext :: pfilecontext_tail*) = ($declaration_precision(S.DECLARATIONS, n) = ($precision_value(S)) /\ $precision_file_waits_valid(S, pfilecontext_tail*))
  -- if pfilecontext.PHASE = FILE_PARSE_WAIT
  -- if pfilecontext.UNIT = (n)
def $precision_file_waits_valid(S, pfilecontext :: pfilecontext_tail*) = $precision_file_waits_valid(S, pfilecontext_tail*)
  -- if pfilecontext.PHASE =/= FILE_PARSE_WAIT

;; Startup precision is an independent registered fact; it invents no file CWD.
dec $precision_initial(pstartup?, bool, preqbytes?, preqbytes) : pstate
def $precision_initial(pstartup?, true, preqbytes_display?, preqbytes_precision) = $display_initial(pstartup?, preqbytes_display?)[.PRECISIONINIT = preqbytes_precision][.PRECISIONINI = preqbytes_precision]
def $precision_initial(pstartup?, false, preqbytes_display?, preqbytes_precision) = $display_initial(pstartup?, ($ptascii("stderr")))[.PRECISIONINIT = preqbytes_precision][.PRECISIONINI = preqbytes_precision]
dec $precision_startup_valid(pstartup?, bool, preqbytes?, preqbytes) : bool
def $precision_startup_valid(pstartup?, b_display, preqbytes_display?, preqbytes_precision) = ($display_startup_valid(pstartup?) /\ (~b_display \/ $startup_reporting_valid(preqbytes_display?)) /\ $precision_ini_valid(preqbytes_precision))
dec $php_precision_run(program, nat, text, pstartup?, bool, preqbytes?, preqbytes) : pstate
def $php_precision_run(program, n, text_file, pstartup?, b_display, preqbytes_display?, preqbytes_precision) = $drive($compile_source($precision_initial(pstartup?, b_display, preqbytes_display?, preqbytes_precision)[.FILES = [SOURCEFILE 0 n_file*]], $ppstart(0, program, n_file*)), n)
  -- if n_file* = $base64(text_file)
  -- if $source_filename(n_file*)
  -- if $precision_startup_valid(pstartup?, b_display, preqbytes_display?, preqbytes_precision)
def $php_precision_run(program, n, text_file, pstartup?, b_display, preqbytes_display?, preqbytes_precision) = $initial_state(UNSUPPORTED "invalid startup precision INI or source filename") -- otherwise
dec $php_request_precision_run(program, nat, text, prequest, pstartup?, bool, preqbytes?, preqbytes) : pstate
def $php_request_precision_run(program, n, text_file, Q, pstartup?, b_display, preqbytes_display?, preqbytes_precision) = $drive($compile_source($request_bootstrap($precision_initial(pstartup?, b_display, preqbytes_display?, preqbytes_precision)[.FILES = [SOURCEFILE 0 n_file*]], Q), $ppstart_cwd(0, program, n_file*, Q.CWD)), n)
  -- if n_file* = $base64(text_file)
  -- if $source_filename(n_file*)
  -- if $request_valid(Q)
  -- if $precision_startup_valid(pstartup?, b_display, preqbytes_display?, preqbytes_precision)
def $php_request_precision_run(program, n, text_file, Q, pstartup?, b_display, preqbytes_display?, preqbytes_precision) = $initial_state(UNSUPPORTED "invalid startup precision INI, request or source filename") -- otherwise
dec $php_file_precision_run(program, nat, preqbytes, preqbytes, pstartup?, bool, preqbytes?, preqbytes) : pstate
def $php_file_precision_run(program, n, n_file*, n_cwd*, pstartup?, b_display, preqbytes_display?, preqbytes_precision) = $drive($compile_source($precision_initial(pstartup?, b_display, preqbytes_display?, preqbytes_precision)[.FILES = [SOURCEFILE 0 n_file*]][.FILECWD = (n_cwd*)][.FILEINCLUDEPATH = ($startup_include_path(pstartup?))][.INCLUDEDOPENED = [n_file*]], $ppstart_cwd(0, program, n_file*, (n_cwd*))), n)
  -- if $source_filename(n_file*)
  -- if $source_filename(n_cwd*)
  -- if $precision_startup_valid(pstartup?, b_display, preqbytes_display?, preqbytes_precision)
def $php_file_precision_run(program, n, n_file*, n_cwd*, pstartup?, b_display, preqbytes_display?, preqbytes_precision) = $initial_state(UNSUPPORTED "invalid startup precision INI or file context") -- otherwise
dec $php_request_file_precision_run(program, nat, preqbytes, prequest, preqbytes, pstartup?, bool, preqbytes?, preqbytes) : pstate
def $php_request_file_precision_run(program, n, n_file*, Q, n_cwd*, pstartup?, b_display, preqbytes_display?, preqbytes_precision) = $drive($compile_source($request_bootstrap($precision_initial(pstartup?, b_display, preqbytes_display?, preqbytes_precision)[.FILES = [SOURCEFILE 0 n_file*]][.FILECWD = (n_cwd*)][.FILEINCLUDEPATH = ($startup_include_path(pstartup?))][.INCLUDEDOPENED = [n_file*]], Q), $ppstart_cwd(0, program, n_file*, (n_cwd*))), n)
  -- if Q.CWD = (n_cwd*)
  -- if $source_filename(n_file*)
  -- if $source_filename(n_cwd*)
  -- if $request_valid(Q)
  -- if $precision_startup_valid(pstartup?, b_display, preqbytes_display?, preqbytes_precision)
def $php_request_file_precision_run(program, n, n_file*, Q, n_cwd*, pstartup?, b_display, preqbytes_display?, preqbytes_precision) = $initial_state(UNSUPPORTED "invalid startup precision INI, request or file context") -- otherwise

;; Literal names retain their own source unit's parsing precision.
def $scoped_source_method_origin(S, porigin, phpType20, preqbytes) = $scoped_source_method_at(phpType20, preqbytes, z_precision)
  -- if $source_precision(S, (porigin)) = (z_precision)
def $scoped_source_method_origin(S, porigin, phpType20, preqbytes) = false -- otherwise
def $method_capture_source_name_origin(S, porigin, phpType20, preqbytes) = $method_capture_source_name_at(phpType20, preqbytes, z_precision)
  -- if $source_precision(S, (porigin)) = (z_precision)
def $method_capture_source_name_origin(S, porigin, phpType20, preqbytes) = false -- otherwise

;; Parser folding is fixed at source creation. Compiler folding follows only
;; the epochs recorded after real diagnostic/publication pauses.
dec $precision_resume_tag(pdeclaration) : bool
dec $precision_pause_tag(pdeclaration) : bool
dec $eval_precision_epochs_from(pdeclaration*, nat, int, (nat, nat, nat)*, (nat, nat, int)*) : (nat, nat, int)*?
dec $compiler_epoch_value((nat, nat, int)*, nat, nat, int) : int
dec $ppprecision_without(ppexprdone*, pcpath) : ppexprdone*
dec $ppprecision_tag(ppexprdone) : bool
dec $precision_compiler_current(pstate, nat, nat, nat) : int?
dec $eval_compile_precision_prefix(ppstate, ppstate, pevalcompile) : bool
dec $eval_compile_precision_publications(ppinstalled, ppinstalled, pppublication*) : bool

def $precision_resume_input(PDEVALRESUME n z) = ((n, z, eps))
def $precision_resume_input(PDEVALRESUMEPRECISION n z z_precision) = ((n, z, (z_precision)))
  -- if $(z_precision >= -1 /\ z_precision <= 9223372036854775807)
def $precision_resume_input(pdeclaration) = eps -- otherwise
def $precision_resume_tag(PDEVALRESUME n z) = true
def $precision_resume_tag(PDEVALRESUMEPRECISION n z z_precision) = true
def $precision_resume_tag(pdeclaration) = false -- otherwise
def $precision_pause_tag(PDEVALPAUSE n n_checkpoint n_diagnostic pdeclnoticeitem*) = true
def $precision_pause_tag(pdeclaration) = false -- otherwise

def $eval_precision_epochs(pdeclaration*, n) = $eval_precision_epochs_from(pdeclaration*, n, z_precision, eps, eps)
  -- if $declaration_precision(pdeclaration*, n) = (z_precision)
def $eval_precision_epochs(pdeclaration*, n) = eps -- otherwise
def $eval_precision_epochs_from(eps, n, z_current, (n_unit, n_checkpoint, n_diagnostic)*, (n_cp, n_diag, z_epoch)*) = ((n_cp, n_diag, z_epoch)*)
def $eval_precision_epochs_from((PDEVALPAUSE n_unit n_checkpoint n_diagnostic pdeclnoticeitem*) :: pdeclaration*, n, z_current, (n_wait, n_cp, n_diag)*, (n_epoch_cp, n_epoch_diag, z_epoch)*) = $eval_precision_epochs_from(pdeclaration*, n, z_current, (n_unit, n_checkpoint, n_diagnostic) :: (n_wait, n_cp, n_diag)*, (n_epoch_cp, n_epoch_diag, z_epoch)*)
def $eval_precision_epochs_from(pdeclaration_resume :: pdeclaration*, n, z_current, (n, n_checkpoint, n_diagnostic) :: (n_wait, n_cp, n_diag)*, (n_epoch_cp, n_epoch_diag, z_epoch)*) = $eval_precision_epochs_from(pdeclaration*, n, z_precision, (n_wait, n_cp, n_diag)*, (n_epoch_cp, n_epoch_diag, z_epoch)* ++ [(n_checkpoint, n_diagnostic, z_precision)])
  -- if $precision_resume_input(pdeclaration_resume) = ((n, z, (z_precision)))
  -- if z_precision =/= z_current
def $eval_precision_epochs_from(pdeclaration_resume :: pdeclaration*, n, z_current, (n, n_checkpoint, n_diagnostic) :: (n_wait, n_cp, n_diag)*, (n_epoch_cp, n_epoch_diag, z_epoch)*) = $eval_precision_epochs_from(pdeclaration*, n, z_current, (n_wait, n_cp, n_diag)*, (n_epoch_cp, n_epoch_diag, z_epoch)*)
  -- if $precision_resume_input(pdeclaration_resume) = ((n, z, eps))
def $eval_precision_epochs_from(pdeclaration_resume :: pdeclaration*, n, z_current, (n_other, n_checkpoint, n_diagnostic) :: (n_wait, n_cp, n_diag)*, (n_epoch_cp, n_epoch_diag, z_epoch)*) = $eval_precision_epochs_from(pdeclaration*, n, z_current, (n_wait, n_cp, n_diag)*, (n_epoch_cp, n_epoch_diag, z_epoch)*)
  -- if n_other =/= n
  -- if $precision_resume_input(pdeclaration_resume) = ((n_other, z, z_precision?))
def $eval_precision_epochs_from(pdeclaration :: pdeclaration_tail*, n, z_current, (n_wait, n_cp, n_diag)*, (n_epoch_cp, n_epoch_diag, z_epoch)*) = $eval_precision_epochs_from(pdeclaration_tail*, n, z_current, (n_wait, n_cp, n_diag)*, (n_epoch_cp, n_epoch_diag, z_epoch)*)
  -- if ~$precision_resume_tag(pdeclaration)
  -- if ~$precision_pause_tag(pdeclaration)
def $eval_precision_epochs_from(pdeclaration*, n, z_current, (n_wait, n_cp, n_diag)*, (n_epoch_cp, n_epoch_diag, z_epoch)*) = eps -- otherwise

def $compiler_epoch_value(eps, n_checkpoint, n_diagnostic, z) = z
def $compiler_epoch_value((n_cp, n_diag, z_epoch) :: (n_tail_cp, n_tail_diag, z_tail)*, n_checkpoint, n_diagnostic, z) = $compiler_epoch_value((n_tail_cp, n_tail_diag, z_tail)*, n_checkpoint, n_diagnostic, z_epoch)
  -- if $(n_cp <= n_checkpoint /\ n_diag <= n_diagnostic)
def $compiler_epoch_value((n_cp, n_diag, z_epoch) :: (n_tail_cp, n_tail_diag, z_tail)*, n_checkpoint, n_diagnostic, z) = $compiler_epoch_value((n_tail_cp, n_tail_diag, z_tail)*, n_checkpoint, n_diagnostic, z)
  -- if $(n_cp > n_checkpoint \/ n_diag > n_diagnostic)
def $pfcompiler_precision(F) = F[.MEMORY = $precision_memory(F.MEMORY, $compiler_epoch_value((n_cp, n_diag, z_epoch)*, F.CHECKPOINT, $(F.DIAGNOSTIC + |F.WARNINGS|), F.PARSEPRECISION))]
  -- if F.COMPILEPRECISIONS = ((n_cp, n_diag, z_epoch)*)
def $pfcompiler_precision(F) = F -- if F.COMPILEPRECISIONS = eps
def $ppcompiler_precision(P) = P[.FOLD = $pfcompiler_precision(P.FOLD[.CHECKPOINT = |P.PUBLICATIONS|][.DIAGNOSTIC = |P.DIAGNOSTICS|])]

;; These descriptors name compiler conversion points, not parser literal text.
def $ppprecision_tag(PPCPRECISION pcpath z) = true
def $ppprecision_tag(ppexprdone) = false -- otherwise
def $ppprecision_without(eps, pcpath) = eps
def $ppprecision_without((PPCPRECISION pcpath z) :: ppexprdone*, pcpath) = $ppprecision_without(ppexprdone*, pcpath)
def $ppprecision_without((PPCPRECISION pcpath_other z) :: ppexprdone*, pcpath) = (PPCPRECISION pcpath_other z) :: $ppprecision_without(ppexprdone*, pcpath)
  -- if pcpath_other =/= pcpath
def $ppprecision_without(ppexprdone :: ppexprdone_tail*, pcpath) = ppexprdone :: $ppprecision_without(ppexprdone_tail*, pcpath)
  -- if ~$ppprecision_tag(ppexprdone)
def $pprecord_precision(P, pcpath) = P[.EXPRESSIONS = $ppprecision_without(P.EXPRESSIONS, pcpath) ++ [PPCPRECISION pcpath z_precision]]
  -- if z_precision = $precision_value(P.FOLD.MEMORY)
  -- if z_precision =/= P.FOLD.PARSEPRECISION
def $pprecord_precision(P, pcpath) = P[.EXPRESSIONS = $ppprecision_without(P.EXPRESSIONS, pcpath)]
  -- if $precision_value(P.FOLD.MEMORY) = P.FOLD.PARSEPRECISION
def $export_precisions(eps) = eps
def $export_precisions((PPCPRECISION pcpath z) :: ppexprdone*) = (PCCPRECISION pcpath z) :: $export_precisions(ppexprdone*)
def $export_precisions(ppexprdone :: ppexprdone_tail*) = $export_precisions(ppexprdone_tail*)
  -- if ~$ppprecision_tag(ppexprdone)
def $compiled_precision(S, (PORIGIN n pcpath)) = (z)
  -- if $pool_at(S.POOLS, n) = (ppool)
  -- if $constant_precision_at(ppool.CONSTANTS, pcpath) = (z)
def $compiled_precision(S, porigin?) = $source_precision(S, porigin?) -- otherwise

def $precision_compiler_current(S, n, n_checkpoint, n_diagnostic) = ($compiler_epoch_value((n_cp, n_diag, z_epoch)*, n_checkpoint, n_diagnostic, z_parser))
  -- if $declaration_precision(S.DECLARATIONS, n) = (z_parser)
  -- if $eval_precision_epochs(S.DECLARATIONS, n) = ((n_cp, n_diag, z_epoch)*)
def $precision_compiler_current(S, n, n_checkpoint, n_diagnostic) = eps -- otherwise
def $precision_eval_resume_valid(S, pevalcompile) = ($precision_compiler_current(S, pevalcompile.PLAN.UNIT, pevalcompile.CHECKPOINT, pevalcompile.DIAGNOSTIC) = ($precision_value(S)))
def $precision_resume_value(S, n, n_checkpoint, n_diagnostic, eps) = $precision_compiler_current(S, n, n_checkpoint, n_diagnostic)
def $precision_resume_value(S, n, n_checkpoint, n_diagnostic, (z_precision)) = (z_precision)
  -- if $precision_compiler_current(S, n, n_checkpoint, n_diagnostic) = (z_current)
  -- if z_current =/= z_precision
  -- if $(z_precision >= -1 /\ z_precision <= 9223372036854775807)
def $precision_resume_value(S, n, n_checkpoint, n_diagnostic, z_precision?) = eps -- otherwise
def $eval_compile_precision_publications(ppinstalled_old, ppinstalled, eps) = true
def $eval_compile_precision_publications(ppinstalled_old, ppinstalled, (PPCP porigin n PPCLASS) :: pppublication*) = $eval_compile_precision_publications(ppinstalled_old, ppinstalled, pppublication*)
  -- if $class_at(ppinstalled_old.CLASSES, porigin) = (pclassdesc)
  -- if $class_at(ppinstalled.CLASSES, porigin) = (pclassdesc)
def $eval_compile_precision_publications(ppinstalled_old, ppinstalled, (PPCP porigin n PPFUNCTION) :: pppublication*) = $eval_compile_precision_publications(ppinstalled_old, ppinstalled, pppublication*)
  -- if $function_at(ppinstalled_old.FUNCTIONS, porigin) = (pfunction)
  -- if $function_at(ppinstalled.FUNCTIONS, porigin) = (pfunction)
def $eval_compile_precision_publications(ppinstalled_old, ppinstalled, pppublication*) = false -- otherwise
def $eval_compile_precision_prefix(P_old, P, pevalcompile) = true
  -- if $(pevalcompile.CHECKPOINT <= |P.PUBLICATIONS| /\ pevalcompile.DIAGNOSTIC <= |P.DIAGNOSTICS|)
  -- if P.PUBLICATIONS[0:pevalcompile.CHECKPOINT] = P_old.PUBLICATIONS[0:pevalcompile.CHECKPOINT]
  -- if P.DIAGNOSTICS[0:pevalcompile.DIAGNOSTIC] = P_old.DIAGNOSTICS[0:pevalcompile.DIAGNOSTIC]
  -- if $eval_compile_precision_publications(P_old.INSTALLED, P.INSTALLED, P_old.PUBLICATIONS[0:pevalcompile.CHECKPOINT])
def $eval_compile_precision_prefix(P_old, P, pevalcompile) = false -- otherwise
def $eval_compile_precision_resume(S, pevalcompile, ptask*) = $eval_compile_loop(S_refreshed[.TODO = ptask*], pevalcompile[.PLAN = $eval_compile_plan(P)])
  -- if $eval_compile_cursor_valid(S, pevalcompile)
  -- if $eval_compile_waiting(S.DECLARATIONS) = (pevalcompile.PLAN.UNIT, pevalcompile.CHECKPOINT, pevalcompile.DIAGNOSTIC, n_ordinal, pdeclnoticeitem*) :: pevalcompileclaim*
  -- if $source_unit(S.SOURCES, pevalcompile.PLAN.UNIT) = (pcunit)
  -- if P_old = $declaration_compiler_state($eval_source_ppstate(S, pcunit))
  -- if $compilation_image_valid(S, pcunit, P_old)
  -- if pevalcompile.PLAN = $eval_compile_plan(P_old)
  -- if S_epoch = S[.DECLARATIONS = S.DECLARATIONS ++ [PDEVALRESUMEPRECISION pevalcompile.PLAN.UNIT S.REPORTING $precision_value(S)]]
  -- if $eval_precision_epochs(S_epoch.DECLARATIONS, pcunit.ID) = ((n_cp, n_diag, z_epoch)*)
  -- if P = $declaration_compiler_state($eval_source_ppstate(S_epoch, pcunit))
  -- if $eval_compile_precision_prefix(P_old, P, pevalcompile)
  -- if S_refreshed = $compilation_refresh_image(S_epoch, pcunit.ID, P_old.INSTALLED, P.INSTALLED)
def $eval_compile_precision_resume(S, pevalcompile, ptask*) = S[.COMPLETION = UNSUPPORTED "invalid suspended precision continuation"] -- otherwise
