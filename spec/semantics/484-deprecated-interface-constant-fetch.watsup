;; Interface source paths are disjoint from the physical class arms.
def $ppmember_groups(P, pcpath, n, (NStmtClassConst (SEQUENCE phpType15*) (INTEGER flags) phpType18 (SEQUENCE ([NConst phpType11 expression metadata_constant])) metadata) :: statement_tail*, ppropertydesc*, pmethoddesc*, pchheader) = $ppmember_groups(P_next, pcpath, $(n + 1), statement_tail*, ppropertydesc*, pmethoddesc*, pchheader)
  -- if P.COMPLETION = PPCNORMAL
  -- if pchheader.KIND = "interface" /\ $ppmethod_visibility(flags) = PROPERTY_PUBLIC
  -- if $origin_node([P.FOLD.SOURCE], PORIGIN P.FOLD.SOURCE.ID pcpath) = (NStmtInterface phpType14 (NIdentifier phpType33 metadata_owner_name) phpType42 phpType23 metadata_owner)
  -- if phpType15* = [NAttributeGroup (SEQUENCE ([NAttribute name (SEQUENCE eps) metadata_attribute])) metadata_attributes]
  -- if $ppconstant_attribute_reference(P.ENV, name) = PNRESOLVED pnreference
  -- if $ptlc(pnreference.RESOLVED) = $ptascii("deprecated")
  -- if $ppproperty_group_line_valid(P, metadata)
  -- if pcpath_group = $ppmember_path(pcpath, pchheader, n)
  -- if z = $source_line(metadata_constant)
  -- if P_attributes = $ppconstant_attribute_groups($pplocate(P, pcpath_group, z), pcpath_group ++ [PCFIELD 0], 0, phpType15*)
  -- if P_next = $ppclass_constant_group(P_attributes, pcpath_group, PORIGIN P.FOLD.SOURCE.ID pcpath, flags, phpType18, [NConst phpType11 expression metadata_constant], pchheader, z)

def $class_constant_attribute_group(pcunit*, pclassconstantdesc) = ((PORIGIN n_unit (pcpath_owner ++ [PCFIELD 3, PCINDEX n_group]), phpType15*))
  -- if pclassconstantdesc.OWNER = PORIGIN n_unit pcpath_owner
  -- if pclassconstantdesc.ORIGIN = PORIGIN n_unit pcpath_decl
  -- if |pcpath_decl| = $(|pcpath_owner| + 4)
  -- if pcpath_decl[0:|pcpath_owner|] = pcpath_owner
  -- if pcpath_decl[|pcpath_owner|:4] = [PCFIELD 3, PCINDEX n_group, PCFIELD 3, PCINDEX n_constant]
  -- if $origin_node(pcunit*, pclassconstantdesc.OWNER) = (NStmtInterface phpType14 (NIdentifier phpType33 metadata_owner_name) phpType42 phpType23 metadata_owner)
  -- if $origin_node(pcunit*, PORIGIN n_unit (pcpath_owner ++ [PCFIELD 3, PCINDEX n_group])) = (NStmtClassConst (SEQUENCE phpType15*) phpType24 phpType18 phpType45 metadata_group)
  -- if phpType15* =/= eps
  -- if $origin_node(pcunit*, pclassconstantdesc.ORIGIN) = (NConst (NIdentifier (BYTES text_name) metadata_name) expression metadata_constant)
  -- if pclassconstantdesc.NAME = $base64(text_name)

def $class_constant_deprecated(S, pclassconstantdesc) = true
  -- if pclassconstantdesc.VISIBILITY = PROPERTY_PUBLIC
  -- if $class_at(S.CLASSES, pclassconstantdesc.OWNER) = (pclassdesc)
  -- if pclassdesc.KIND = "interface"
  -- if $class_constant_attribute_group(S.SOURCES, pclassconstantdesc) = ((PORIGIN n_unit pcpath_group, phpType15*))
  -- if $source_unit(S.SOURCES, n_unit) = (pcunit)
  -- if $code_at(S.CODE, n_unit) = (pcode)
  -- if $constant_attribute_groups(pcunit, pcode, pcpath_group ++ [PCFIELD 0], 0, phpType15*) = BUILTIN_ATTRIBUTES ([pbuiltinattribute])
  -- if $ptlc(pbuiltinattribute.NAME) = $ptascii("deprecated")
  -- if pbuiltinattribute.ARGUMENTS = SEQUENCE eps

