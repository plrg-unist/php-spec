;; Compiler line contexts already authenticated by the source/operand pipeline.
def $tick_begin_statement(T, NStmtNop metadata) = T
def $tick_begin_statement(T, statement) = T[.LINE = $source_line($pcmetadata(statement))] -- otherwise
def $tick_expression_line(T, pcodeexpr*, pcpath, expression) = T[.LINE = z]
  -- if $code_expression(pcodeexpr*, pcpath) = ((z, b))
def $tick_expression_line(T, pcodeexpr*, pcpath, expression) = T -- otherwise

def $tick_control_body(T, pcodeexpr*, pcpath, statement*, metadata) = $tick_statements(T[.LINE = z], pcodeexpr*, pcpath, 0, statement*, false)
  -- if $ppbodyline(metadata) = (z)
  -- if $(z > 0)
def $tick_control_body(T, pcodeexpr*, pcpath, statement*, metadata) = $tick_statements(T, pcodeexpr*, pcpath, 0, statement*, false)
  -- if $ppbodyline(metadata) = (0)
def $tick_control_body(T, pcodeexpr*, pcpath, statement*, metadata) = T[.DEPENDENCY = ("missing tick control body compiler line")] -- otherwise

def $tick_empty_multiline_declare(SEQUENCE statement*, metadata) = ($ppnullbody(statement*) /\ $source_line(metadata) =/= $source_end_line(metadata))
def $tick_empty_multiline_declare(phpType47, metadata) = false -- otherwise
