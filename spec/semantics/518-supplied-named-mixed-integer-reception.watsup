;; Named SEND order maps to fixed slots before formal-order RECVs.
;; The immutable formal mode selects the existing value/reference readiness.
dec $lossy_named_arguments(phpType7*) : bool
def $lossy_named_arguments(eps) = true
def $lossy_named_arguments((NArg (NIdentifier (BYTES text_name) metadata_name) (NExprVariable (BYTES text) metadata_variable) (BOOLEAN false) (BOOLEAN false) metadata_argument) :: phpType7*) = true
  -- if $cv_name(BYTES text) = (preqbytes)
  -- if preqbytes =/= $ptascii("this") /\ preqbytes =/= $ptascii("http_response_header")
  -- if ~$psautoglobal(preqbytes)
  -- if $lossy_named_arguments(phpType7*)
def $lossy_named_arguments(phpType7*) = false -- otherwise

dec $lossy_named_parameter_metadata(pstate, porigin, nat, int) : bool
def $lossy_named_parameter_metadata(S, porigin_function, n, z) = true
