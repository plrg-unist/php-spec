dec $lossy_named_parameter_source_valid(pstate, ptask) : bool
def $lossy_named_parameter_source_valid(S, LOSSY_NAMED_PARAMETER_RECEIVE porigin_function n n_cell n_bits i z) = true
  -- if $lossy_named_parameter_metadata(S, porigin_function, n, z)
  -- if S.ORIGIN = ($default_parameter_origin(S, porigin_function, n))
  -- if $function_at(S.FUNCTIONS, porigin_function) = (pfunction)
  -- if $lookup(S.ENV, pfunction.SIGNATURE.PARAMETERS[n].NAME) = (n_cell)
  -- if $(n_cell < |S.STORE|) /\ (HCELL n_cell) <- S.ALLOCATIONS
  -- if $lossy_parameter_snapshot(n_bits) = ((i, ptbytes))
def $lossy_named_parameter_source_valid(S, ptask) = false -- otherwise
def $call_task_valid(S, LOSSY_NAMED_PARAMETER_RECEIVE porigin_function n n_cell n_bits i z) = (S.TODO = [LOSSY_NAMED_PARAMETER_RECEIVE porigin_function n n_cell n_bits i z] /\ $lossy_named_parameter_source_valid(S, LOSSY_NAMED_PARAMETER_RECEIVE porigin_function n n_cell n_bits i z))
def $task_nodes(LOSSY_NAMED_PARAMETER_RECEIVE porigin_function n n_cell n_bits i z) = eps

dec $lossy_named_parameter_capture(pstate) : ptask?
def $lossy_named_parameter_capture(S) = (LOSSY_NAMED_PARAMETER_RECEIVE porigin_function n n_cell n_bits i z)
  -- if S.TODO = [TYPE_RECEIVE porigin_function n]
  -- if S.COMPLETION = NORMAL
  -- if $function_at(S.FUNCTIONS, porigin_function) = (pfunction)
  -- if z = $default_parameter_line(S, porigin_function, n)
  -- if $lossy_named_parameter_metadata(S, porigin_function, n, z)
  -- if $lookup(S.ENV, pfunction.SIGNATURE.PARAMETERS[n].NAME) = (n_cell)
  -- if $(n_cell < |S.STORE|) /\ (HCELL n_cell) <- S.ALLOCATIONS
  -- if S.STORE[n_cell] = DEFINED (PFLOAT n_bits)
  -- if $typed_parameter_conversion(S, pfunction.SIGNATURE.PARAMETERS[n], PFLOAT n_bits) = TYPEINTEGER (PFLOAT n_bits)
  -- if $lossy_parameter_snapshot(n_bits) = ((i, ptbytes))
def $lossy_named_parameter_capture(S) = eps -- otherwise
def $lossy_named_parameter_candidate(S) = ($lossy_named_parameter_capture(S) =/= eps)

rule PhpStep/lossy-named-parameter-begin: S ~> $error_dispatch(S[.TODO = [ptask_source]][.ORIGIN = (porigin_site)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], 8192, ptbytes, z, DIAGNOSTIC "Deprecated" ptbytes z, ptask_source)
  -- if $lossy_named_parameter_capture(S) = (ptask_source)
  -- if ptask_source = LOSSY_NAMED_PARAMETER_RECEIVE porigin_function n n_cell n_bits i z
  -- if $lossy_mixed_parameter_ready(S, n, n_cell, n_bits)
  -- if $lossy_parameter_snapshot(n_bits) = ((i, ptbytes))
  -- if porigin_site = $default_parameter_origin(S, porigin_function, n)
rule PhpStep/lossy-named-parameter-entry-refused: S ~> S[.COMPLETION = UNSUPPORTED "lossy named parameter receive context"]
  -- if $lossy_named_parameter_capture(S) = (LOSSY_NAMED_PARAMETER_RECEIVE porigin_function n n_cell n_bits i z)
  -- if ~$lossy_mixed_parameter_ready(S, n, n_cell, n_bits)

def $error_call_valid(S, perrorcall) = true
