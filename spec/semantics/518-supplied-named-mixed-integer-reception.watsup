  -- if $lossy_named_arguments(phpType7*)
  -- if $call_selected_valid(S, porigin_function, (porigin_call))
  -- if $function_at(S.FUNCTIONS, porigin_function) = (pfunction)
  -- if ~pfunction.SIGNATURE.BYREF /\ ~$function_generator(S, pfunction) /\ ~$generator_active(S)
  -- if S.ACTIVEFIBER = eps /\ S.CONSTCONTEXT = eps
  -- if $(2 <= |pfunction.SIGNATURE.PARAMETERS|) /\ $(pcallcontext.ARGC <= |pfunction.SIGNATURE.PARAMETERS|)
  -- if $lossy_required_integer_parameters(pfunction.SIGNATURE.PARAMETERS)
  -- if ~$lossy_positional_parameters(pfunction.SIGNATURE.PARAMETERS) /\ ~$lossy_positional_reference_parameters(pfunction.SIGNATURE.PARAMETERS)
  -- if $named_call_valid(S, porigin_function, (porigin_call))
  -- if pnamedargs = $named_call_shape(S, porigin_function, (porigin_call))
