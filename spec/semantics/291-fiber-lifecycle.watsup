def $destructor_private_error(S, pdestructorcall, ptbytes) = S_trace[.OBJECTS = S_trace.OBJECTS ++ [THROWABLE {KIND "Error", ORIGIN eps, FILEORIGIN eps}]][.OBJECTPROPS = S_trace.OBJECTPROPS ++ [{OBJECT n, SLOTS $throwable_slots("Error", ptbytes, $ptascii("[no active file]"), 0, n_trace, PNULL), MATERIALIZED false}]][.ALLOCATIONS = S_trace.ALLOCATIONS ++ [HOBJECT n]][.COMPLETION = THROWING n][.TRACE = eps][.ERRORORIGIN = eps]
