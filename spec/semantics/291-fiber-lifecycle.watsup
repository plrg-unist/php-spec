;; RELEASE stays at the caller's head until the internal dtor actually returns.
;; Generic ordered release then observes resurrection or frees its native slot.
def $fiber_back(S, pvalue, b) = $fiber_close_back(S, pvalue, b)
  -- if $fiber_close_boundary(S)
def $fiber_close_back(S, pvalue, false) = $fiber_vm_restore(S, pfiberclose.VM)[.ACTIVEFIBER = pfiberclose.PREVIOUS][.FIBERCLOSERS = pfiberclose_tail*][.COMPLETION = NORMAL]
  -- if S.FIBERCLOSERS = pfiberclose :: pfiberclose_tail*
  -- if $fiber_close_boundary(S)
def $fiber_close_back(S, POBJECT n, true) = $fiber_close_error_return(S_restored[.COMPLETION = NORMAL], n)
  -- if S.FIBERCLOSERS = pfiberclose :: pfiberclose_tail*
  -- if $fiber_close_boundary(S)
  -- if S_restored = $fiber_vm_restore(S, pfiberclose.VM)[.ACTIVEFIBER = pfiberclose.PREVIOUS][.FIBERCLOSERS = pfiberclose_tail*]
  -- if S_restored.TODO = (DESTRUCTOR_RELEASE pfiberclose.RELEASE) :: ptask_tail*

;; A throwing internal destructor transfers its exception into the genuine
;; existing pending slot. Remaining VALUE decrements retain their original order.
def $fiber_close_chain(S, n, eps) = S
def $fiber_close_chain(S, n, (n_old)) = $throwable_previous(S, n, n_old)
