def $fiber_callback_finish(S, pfiberfinish) = $fiber_close_back($fiber_put(S, pfiberfinish.OBJECT, $fiber_terminated(pfiber, pfiber.VALUE, false)), PNULL, false)
  -- if $fiber_at(S, pfiberfinish.OBJECT) = (pfiber)
