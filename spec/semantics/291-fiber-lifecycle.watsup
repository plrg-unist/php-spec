def $fiber_close_error_return(S, n) = $fiber_put(S_linked[.TODO = $fiber_finish_tasks(S_linked.TODO, pfiberfinish, pfiberfinish_new)], pfiberfinish.OBJECT, pfiber[.FINISH = (pfiberfinish_new)])
