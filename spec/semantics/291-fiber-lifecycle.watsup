  -- if $fiber_at(S, n_fiber) = (pfiber)
  -- if pfiber.STATUS = FIBER_TERMINATED /\ pfiber.SEQUENCE = n_sequence /\ pfiber.FINISH = eps
  -- if n_fiber <- S.DESTRUCTION.CALLED
