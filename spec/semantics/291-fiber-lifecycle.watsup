def $fiber_callback_finish(S, pfiberfinish) = $fiber_close_back($fiber_put(S, pfiberfinish.OBJECT, $fiber_terminated(pfiber, pfiber.VALUE, true)[.RETURNED = pfiber.RETURNED]), POBJECT n, true)
