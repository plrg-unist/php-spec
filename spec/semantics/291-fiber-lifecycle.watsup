def $fiber_close_error_return(S, n) = S[.COMPLETION = UNSUPPORTED "Fiber destruction with no supported pending exception consumer"] -- otherwise

;; The accepted ordinary exit protocol terminates a request. Suppression and
;; shared exit_status for DESTROYED Fiber contexts are a separate required lane.
def $exit_start_unwind(S, z) = S[.COMPLETION = UNSUPPORTED "exit inside a force-closing Fiber"]
