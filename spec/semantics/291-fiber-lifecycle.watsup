;; zend_fiber_object_destroy resumes a suspended stack with a private control
;; object. It is not registered in the class table and does not implement
;; Throwable. The waiting object-store frame retains its graceful zval and the
;; actual pending VALUE slot; neither its IDs nor source proof add owners.
dec $fiber_close_for(pfiberclose*, nat) : pfiberclose?
dec $fiber_close_exit(pfiberclose*, nat) : pfiberclose?
dec $fiber_close_valid(pstate, pfiberclose) : bool
dec $fiber_close_start(pstate, nat, pdestructionrelease) : pstate
dec $fiber_close_source(pstate, pfiberclose) : pstate
dec $fiber_close_selected(pstate, nat, pdestructionrelease) : bool
dec $fiber_graceful_retiring(pstate, nat) : bool
dec $fiber_retired_pending_valid(pstate, nat, pfiberfinish, pfiber) : bool
dec $fiber_callback_finish(pstate, pfiberfinish) : pstate
dec $fiber_callback_finish_live(pstate, pfiberfinish) : bool
dec $fiber_callback_finish_valid(pstate, pfiberfinish) : bool
dec $fiber_callback_base_frame(pstate, pframe) : bool
dec $fiber_callback_ready(pstate) : bool
dec $fiber_callback_step(pstate) : pstate
dec $fiber_finishing_tasks(ptask*, pfiberfinish) : bool
dec $fiber_finishing_frames(pframe*, pfiberfinish) : bool
dec $fiber_finishing_vm(pfibervm, pfiberfinish) : bool
dec $fiber_finish_task_count(ptask*, pfiberfinish) : nat
dec $fiber_finish_extra_count(ptask, pfiberfinish) : nat
dec $fiber_ordinary_finish_live(pstate, pfiberfinish) : bool
dec $fiber_close_blocked(pstate, nat) : bool
dec $fiber_retired_finish(ptask) : pfiberfinish?
dec $fiber_retired_source_valid(pstate, nat, ptask, pfiber) : bool
dec $fiber_finish_pending_graceful(pstate, pfiberfinish) : bool
dec $fiber_finish_frame_count(pframe*, pfiberfinish) : nat
dec $fiber_finishing_callers(pfibercaller*, pfiberfinish) : bool
dec $fiber_finishing_closers(pfiberclose*, pfiberfinish) : bool
dec $fiber_release_finish(ptask*) : pfiberfinish?
dec $fiber_finish_tasks(ptask*, pfiberfinish, pfiberfinish) : ptask*

dec $fiber_chain_close(nat, nat, pfiberclose*) : bool
dec $fiber_close_chain(pstate, nat, nat?) : pstate
dec $fiber_close_error_return(pstate, nat) : pstate
dec $fiber_release_operation(ptask*) : pdestructionoperation?
dec $fiber_request_store_ready(pstate) : bool

def $fiber_close_for(eps, n) = eps
def $fiber_close_for(pfiberclose :: pfiberclose_tail*, n) = (pfiberclose)
  -- if pfiberclose.OBJECT = n
def $fiber_close_for(pfiberclose :: pfiberclose_tail*, n) = $fiber_close_for(pfiberclose_tail*, n)
  -- if pfiberclose.OBJECT =/= n
def $fiber_closing(S, eps) = false
def $fiber_closing(S, (n)) = ($fiber_close_for(S.FIBERCLOSERS, n) =/= eps)
def $fiber_close_boundary(S) = true
  -- if S.FIBERCLOSERS = pfiberclose :: pfiberclose_tail*
  -- if S.ACTIVEFIBER = (pfiberclose.OBJECT)
  -- if |S.FIBERCALLERS| = pfiberclose.CALLERS
def $fiber_close_boundary(S) = false -- otherwise

def $fiber_close_nodes(eps) = eps
def $fiber_close_nodes(pfiberclose :: pfiberclose_tail*) = [HOBJECT pfiberclose.EXIT] ++ $fiber_vm_nodes(pfiberclose.VM) ++ $fiber_close_nodes(pfiberclose_tail*)
def $fiber_close_iterators(eps) = eps
def $fiber_close_iterators(pfiberclose :: pfiberclose_tail*) = $fiber_vm_iterators(pfiberclose.VM) ++ $fiber_close_iterators(pfiberclose_tail*)
def $fiber_close_waiting_ids(eps) = eps
def $fiber_close_waiting_ids(pfiberclose :: pfiberclose_tail*) = $fiber_previous_ids(pfiberclose.PREVIOUS) ++ $fiber_close_waiting_ids(pfiberclose_tail*)

def $fiber_close_exit(eps, n) = eps
def $fiber_close_exit(pfiberclose :: pfiberclose_tail*, n) = (pfiberclose)
  -- if pfiberclose.EXIT = n
def $fiber_close_exit(pfiberclose :: pfiberclose_tail*, n) = $fiber_close_exit(pfiberclose_tail*, n)
  -- if pfiberclose.EXIT =/= n
def $fiber_graceful_live(S, n) = true
  -- if $(n < |S.OBJECTS|)
