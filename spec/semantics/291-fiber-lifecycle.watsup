  -- if n_owners = $heap_count(HOBJECT n, $destruction_job_nodes(pdestructionrelease.JOBS))
  -- if $(n_owners > 0) /\ $heap_owners($heap_graph(S), HOBJECT n) = n_owners
def $fiber_graceful_retiring(S, n) = false -- otherwise
def $fiber_retired_pending_valid(S, n_exit, pfiberfinish, pfiber) = (~pfiber.FAILED /\ ~pfiber.GRACEFUL)
  -- if pfiberfinish.PENDING = eps
def $fiber_retired_pending_valid(S, n_exit, pfiberfinish, pfiber) = (~pfiber.FAILED /\ pfiber.GRACEFUL)
  -- if pfiberfinish.PENDING = (n_exit)
def $fiber_retired_pending_valid(S, n_exit, pfiberfinish, pfiber) = (pfiber.FAILED /\ ~pfiber.GRACEFUL /\ $throwable_member(S, n))
  -- if pfiberfinish.PENDING = (n)
  -- if n =/= n_exit
def $fiber_retired_finish(FIBER_CALLBACK_FINISH pfiberfinish) = (pfiberfinish)
def $fiber_retired_finish(ptask) = eps -- otherwise
def $fiber_retired_source_valid(S, n_exit, FIBER_CALLBACK_FINISH pfiberfinish, pfiber) = $fiber_retired_pending_valid(S, n_exit, pfiberfinish, pfiber)
def $fiber_retired_source_valid(S, n_exit, ptask, pfiber) = false -- otherwise
def $node_children(S, HOBJECT n) = eps
  -- if S.OBJECTS[n] = FIBERGRACEFUL n_fiber n_sequence
def $class_instanceof(S, POBJECT n, ptbytes) = false
  -- if S.OBJECTS[n] = FIBERGRACEFUL n_fiber n_sequence
def $throwable_live(S, n) = true
  -- if $fiber_graceful_live(S, n)
  -- if S.OBJECTS[n] = FIBERGRACEFUL n_fiber n_sequence
  -- if S.ACTIVEFIBER = (n_fiber)
def $closure_live_object_valid(S, n) = true -- if $fiber_graceful_live(S, n) \/ $fiber_graceful_retiring(S, n)
def $fiber_live_node_valid(S, HOBJECT n) = ($fiber_graceful_live(S, n) \/ $fiber_graceful_retiring(S, n))
  -- if S.OBJECTS[n] = FIBERGRACEFUL n_fiber n_sequence
def $closure_scope_complete(S, (HOBJECT n) :: pnode*) = $closure_scope_complete(S, pnode*)
  -- if S.OBJECTS[n] = FIBERGRACEFUL n_fiber n_sequence
def $property_live_complete(S, (HOBJECT n) :: pnode*) = $property_live_complete(S, pnode*)
  -- if S.OBJECTS[n] = FIBERGRACEFUL n_fiber n_sequence
  -- if $objectprops_at(S.OBJECTPROPS, n) = eps

;; zend_exception_set_previous drops an old internal exit. VM finalizer
;; replacement also discards the old exception when the new control is an exit.
def $throwable_previous(S, n_new, n_old) = S
  -- if $fiber_graceful_live(S, n_old)
def $finally_exception_previous(S, n_new, n_old) = S
  -- if $fiber_graceful_live(S, n_new)
def $finally_exception_previous(S, n_new, n_old) = $throwable_previous(S, n_new, n_old)
  -- if ~$fiber_graceful_live(S, n_new)

def $fiber_close_source(S, pfiberclose) = $fiber_vm_restore(S, pfiberclose.VM)[.ACTIVEFIBER = pfiberclose.PREVIOUS]
def $fiber_close_valid(S, pfiberclose) = true
  -- if $fiber_at(S, pfiberclose.OBJECT) = (pfiber)
  -- if pfiber.STATUS = FIBER_RUNNING /\ pfiber.SEQUENCE = pfiberclose.SEQUENCE
  -- if pfiberclose.OBJECT <- S.DESTRUCTION.CALLED
  -- if $(pfiberclose.CALLERS <= |S.FIBERCALLERS|)
  -- if pfiberclose.SUSPEND.OBJECT = pfiberclose.OBJECT
  -- if pfiberclose.SUSPEND.KIND = (INTRINSIC_FIBER_SUSPEND)
  -- if $(pfiberclose.SUSPEND.SEQUENCE < pfiberclose.SEQUENCE)
  -- if $fiber_api_valid(S, pfiberclose.SUSPEND)
  -- if $fiber_graceful_live(S, pfiberclose.EXIT)
  -- if pfiberclose.RELEASE.JOBS = (DESTRUCTION_VALUE (HOBJECT pfiberclose.OBJECT)) :: pdestructionjob*
  -- if pfiberclose.VM.TODO = (DESTRUCTOR_RELEASE pfiberclose.RELEASE) :: ptask*
  -- if pfiberclose.VM.DESTRUCTORRELEASES = pfiberclose.RELEASE :: pdestructionrelease*
  -- if $destructor_release_valid($fiber_close_source(S, pfiberclose), pfiberclose.RELEASE)
def $fiber_close_valid(S, pfiberclose) = false -- otherwise

;; The existing API caller chain is interrupted only at the authentic internal
;; destruction boundary. Nested public transfers retain their ordinary frames.
def $fiber_chain_valid(S, eps, eps, eps, n_seen*) = true
def $fiber_chain_valid(S, (n), pfibercaller*, pfiberclose :: pfiberclose_tail*, n_seen*) = true
  -- if ~(n <- n_seen*)
  -- if pfiberclose.OBJECT = n /\ pfiberclose.CALLERS = |pfibercaller*|
  -- if $fiber_close_valid(S, pfiberclose)
  -- if $fiber_vm_valid(S, pfiberclose.VM, pfiberclose.PREVIOUS, pfibercaller*)
  -- if $fiber_chain_valid(S, pfiberclose.PREVIOUS, pfibercaller*, pfiberclose_tail*, n :: n_seen*)
def $fiber_chain_valid(S, (n), pfibercaller :: pfibercaller_tail*, pfiberclose*, n_seen*) = true
  -- if ~(n <- n_seen*)
  -- if pfibercaller.OBJECT = n /\ pfibercaller.API.OBJECT = n
  -- if ~$fiber_chain_close(n, |pfibercaller_tail*|, pfiberclose*)
  -- if $fiber_at(S, n) = (pfiber)
  -- if pfiber.STATUS = FIBER_RUNNING
  -- if pfibercaller.API.SEQUENCE = pfiber.SEQUENCE
  -- if pfibercaller.VM.TODO = (FIBER_WAIT pfibercaller.API) :: ptask_tail*
  -- if $fiber_vm_valid(S, pfibercaller.VM, pfibercaller.PREVIOUS, pfibercaller_tail*)
  -- if $fiber_chain_valid(S, pfibercaller.PREVIOUS, pfibercaller_tail*, pfiberclose*, n :: n_seen*)
def $fiber_chain_valid(S, n?, pfibercaller*, pfiberclose*, n_seen*) = false -- otherwise
def $fiber_chain_close(n, n_tail, pfiberclose :: pfiberclose_tail*) = (pfiberclose.OBJECT = n /\ pfiberclose.CALLERS = $(n_tail + 1))
def $fiber_chain_close(n, n_tail, eps) = false

def $internal_destructor_pending(S, HOBJECT n) = true
  -- if $fiber_at(S, n) = (pfiber)
  -- if pfiber.STATUS = FIBER_SUSPENDED
  -- if ~(n <- S.DESTRUCTION.CALLED)
  -- if ~$fiber_closing(S, (n))
def $internal_destructor_pending(S, pnode) = false -- otherwise
def $fiber_request_store_ready(S) = true
  -- if S.TODO = [DESTRUCTOR_STORE]
  -- if $call_task_valid(S, DESTRUCTOR_STORE)
  -- if $(S.DESTRUCTION.INDEX < S.DESTRUCTION.NEXT)
  -- if $destructor_handle(S, S.DESTRUCTION.INDEX, 0) = (n)
  -- if $internal_destructor_pending(S, HOBJECT n)
def $fiber_request_store_ready(S) = false -- otherwise
rule PhpStep/fiber-request-store: S ~> S[.COMPLETION = UNSUPPORTED "Fiber destruction during request cleanup"]
  -- if $fiber_request_store_ready(S)

def $fiber_close_selected(S, n, pdestructionrelease) = true
  -- if $internal_destructor_pending(S, HOBJECT n)
  -- if $destructor_release_valid(S, pdestructionrelease)
  -- if pdestructionrelease.JOBS = (DESTRUCTION_VALUE (HOBJECT n)) :: pdestructionjob*
  -- if S_unheld = $destructor_release_replace(S, pdestructionrelease[.JOBS = pdestructionjob*])
  -- if $heap_owners($heap_graph(S_unheld), HOBJECT n) = 0
def $fiber_close_selected(S, n, pdestructionrelease) = false -- otherwise
def $fiber_close_blocked(S, n) = false -- otherwise

def $internal_destructor_enter(S, HOBJECT n, pdestructionrelease) = $fiber_close_start(S, n, pdestructionrelease)
  -- if $fiber_close_selected(S, n, pdestructionrelease)
  -- if pdestructionrelease.USER
  -- if $fiber_transfer_domain(S)
  -- if ~$fiber_close_blocked(S, n)
def $internal_destructor_enter(S, HOBJECT n, pdestructionrelease) = S[.COMPLETION = UNSUPPORTED "Fiber destruction during an initializer, source loader or Generator continuation"]
  -- if $fiber_close_selected(S, n, pdestructionrelease)
  -- if pdestructionrelease.USER
  -- if ~$fiber_transfer_domain(S)
def $internal_destructor_enter(S, HOBJECT n, pdestructionrelease) = S[.COMPLETION = UNSUPPORTED "Fiber destruction during request cleanup"]
  -- if $fiber_close_selected(S, n, pdestructionrelease)
  -- if ~pdestructionrelease.USER
def $fiber_close_start(S, n, pdestructionrelease) = $throwable_begin(S_next[.TODO = ptask_tail*][.COMPLETION = THROWING n_exit])
  -- if $fiber_at(S, n) = (pfiber)
  -- if pfiber.VM = (pfibervm)
  -- if pfibervm.TODO = (FIBER_CONTINUE pfiberapi) :: ptask_tail*
  -- if n_exit = |S.OBJECTS|
  -- if n_callers = |S.FIBERCALLERS|
  -- if pfiberclose = {OBJECT n, PREVIOUS S.ACTIVEFIBER, CALLERS n_callers, VM $fiber_vm(S), RELEASE pdestructionrelease, SUSPEND pfiberapi, EXIT n_exit, SEQUENCE S.FIBERSEQ}
  -- if S_control = $destruction_store_new(S[.OBJECTS = S.OBJECTS ++ [FIBERGRACEFUL n S.FIBERSEQ]][.ALLOCATIONS = S.ALLOCATIONS ++ [HOBJECT n_exit]][.DESTRUCTION.CALLED = S.DESTRUCTION.CALLED ++ [n]])
  -- if (pfiber_next, pfibervm_next) = $fiber_reactivate(pfiber, pfibervm, S.FIBERSEQ)
  -- if S_shared = $fiber_put(S_control[.GLOBALTABLE = ($fiber_globals(S))], n, pfiber_next)
  -- if S_next = $fiber_vm_restore(S_shared, pfibervm_next)[.ACTIVEFIBER = (n)][.FIBERCLOSERS = pfiberclose :: S.FIBERCLOSERS][.FIBERSEQ = $(S.FIBERSEQ + 1)]

def $fiber_receive_value(S, pconfigcall, pvalue) = $config_error(S, pconfigcall, "FiberError", $ptascii("Cannot suspend in a force-closed fiber"))
  -- if pconfigcall.KIND = INTRINSIC_FIBER_SUSPEND
  -- if $fiber_closing(S, S.ACTIVEFIBER)
def $fiber_receive_value(S, pconfigcall, pvalue) = S[.COMPLETION = UNSUPPORTED "getReturn after graceful Fiber destruction without an actual return"]
  -- if pconfigcall.KIND = INTRINSIC_FIBER_RETURN
  -- if pconfigcall.OWNER = (n)
  -- if $fiber_at(S, n) = (pfiber)
  -- if pfiber.STATUS = FIBER_TERMINATED /\ pfiber.GRACEFUL
def $fiber_graceful_for(S, n_fiber, n_sequence, n_exit) = true
  -- if $fiber_graceful_live(S, n_exit)
  -- if S.OBJECTS[n_exit] = FIBERGRACEFUL n_fiber n_sequence
def $fiber_graceful_for(S, n_fiber, n_sequence, n_exit) = false -- otherwise
def $fiber_finish_pending_valid(S, pfiberfinish) = true -- if pfiberfinish.PENDING = eps
def $fiber_finish_pending_valid(S, pfiberfinish) = ($throwable_member(S, n) \/ $fiber_graceful_for(S, pfiberfinish.OBJECT, pfiberfinish.SEQUENCE, n))
  -- if pfiberfinish.PENDING = (n)
def $fiber_finish_pending_graceful(S, pfiberfinish) = true
  -- if pfiberfinish.PENDING = (n)
  -- if $fiber_graceful_for(S, pfiberfinish.OBJECT, pfiberfinish.SEQUENCE, n)
def $fiber_finish_pending_graceful(S, pfiberfinish) = false -- otherwise
def $fiber_throw_pending_valid(S, n_fiber, n_throwable) = ($throwable_live(S, n_throwable) /\ ($throwable_member(S, n_throwable) \/ $fiber_graceful_for(S, n_fiber, pfiber.SEQUENCE, n_throwable)))
  -- if $fiber_close_boundary(S)
  -- if $fiber_at(S, n_fiber) = (pfiber)
def $fiber_throw_finish(S, n_fiber, n_exit) = $fiber_callback_retire(S, n_fiber, PNULL, (n_exit))
  -- if $fiber_close_boundary(S)
  -- if $fiber_at(S, n_fiber) = (pfiber)
  -- if $fiber_graceful_for(S, n_fiber, pfiber.SEQUENCE, n_exit)

;; zend_call_function writes the result before function_name is decremented.
;; Keep the Fiber RUNNING and DESTROYED while the ordered callback slots retire.
;; FINISH is borrowed; its task owns the genuine pending exception once.
def $fiber_finish(S, n) = $fiber_callback_retire(S_read, n, pvalue, eps)
  -- if S.ACTIVEFIBER = (n)
  -- if $fiber_close_boundary(S)
  -- if S.FRAMES = eps /\ S.CURRENT = eps
  -- if $fiber_finish_valid(S, n)
  -- if S_read = $resolve_at(S, S.RESULT, $(-1))
  -- if S_read.COMPLETION = NORMAL
  -- if S_read.RESULT = KNOWN pvalue
def $fiber_throw_finish(S, n_fiber, n_throwable) = $fiber_callback_retire(S, n_fiber, PNULL, (n_throwable))
  -- if $fiber_close_boundary(S)
  -- if $throwable_member(S, n_throwable)
def $fiber_callback_retire(S, n, pvalue, n_pending?) = $destructor_release_begin(S_ready, $destruction_values($fiber_callback_nodes(pfiber)))
  -- if $fiber_at(S, n) = (pfiber)
  -- if pfiberfinish = {OBJECT n, PENDING n_pending?, SEQUENCE pfiber.SEQUENCE}
  -- if pfiber_ready = $fiber_terminated(pfiber, pvalue, false)[.STATUS = FIBER_RUNNING][.FINISH = (pfiberfinish)][.RETURNED = (n_pending? = eps)]
  -- if S_ready = $fiber_put(S[.TODO = [FIBER_CALLBACK_FINISH pfiberfinish]][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], n, pfiber_ready)

def $fiber_finishing_tasks([FIBER_CALLBACK_FINISH pfiberfinish], pfiberfinish) = true
def $fiber_finishing_tasks(ptask :: ptask_tail*, pfiberfinish) = $fiber_finishing_tasks(ptask_tail*, pfiberfinish)
  -- if ptask =/= FIBER_CALLBACK_FINISH pfiberfinish
def $fiber_finishing_tasks(ptask*, pfiberfinish) = false -- otherwise
def $fiber_finishing_frames(eps, pfiberfinish) = false
def $fiber_finishing_frames(pframe :: pframe_tail*, pfiberfinish) = ($fiber_finishing_tasks(pframe.TODO, pfiberfinish) \/ $fiber_finishing_frames(pframe_tail*, pfiberfinish))
def $fiber_finish_task_count(eps, pfiberfinish) = 0
def $fiber_finish_extra_count(ptask, pfiberfinish) = 0 -- otherwise
def $fiber_finish_task_count((FIBER_CALLBACK_FINISH pfiberfinish) :: ptask*, pfiberfinish) = $(1 + $fiber_finish_task_count(ptask*, pfiberfinish))
def $fiber_finish_task_count(ptask :: ptask_tail*, pfiberfinish) = $($fiber_finish_extra_count(ptask, pfiberfinish) + $fiber_finish_task_count(ptask_tail*, pfiberfinish))
  -- if ptask =/= FIBER_CALLBACK_FINISH pfiberfinish
def $fiber_finish_frame_count(eps, pfiberfinish) = 0
def $fiber_finish_frame_count(pframe :: pframe_tail*, pfiberfinish) = $($fiber_finish_task_count(pframe.TODO, pfiberfinish) + $fiber_finish_frame_count(pframe_tail*, pfiberfinish))
def $fiber_finishing_vm(pfibervm, pfiberfinish) = ($( $fiber_finish_task_count(pfibervm.TODO, pfiberfinish) + $fiber_finish_frame_count(pfibervm.FRAMES, pfiberfinish) ) = 1 /\ ($fiber_finishing_tasks(pfibervm.TODO, pfiberfinish) \/ $fiber_finishing_frames(pfibervm.FRAMES, pfiberfinish)))
def $fiber_finishing_callers(eps, pfiberfinish) = false
def $fiber_finishing_callers(pfibercaller :: pfibercaller_tail*, pfiberfinish) = ((pfibercaller.PREVIOUS = (pfiberfinish.OBJECT) /\ $fiber_finishing_vm(pfibercaller.VM, pfiberfinish)) \/ $fiber_finishing_callers(pfibercaller_tail*, pfiberfinish))
def $fiber_finishing_closers(eps, pfiberfinish) = false
def $fiber_finishing_closers(pfiberclose :: pfiberclose_tail*, pfiberfinish) = ((pfiberclose.PREVIOUS = (pfiberfinish.OBJECT) /\ $fiber_finishing_vm(pfiberclose.VM, pfiberfinish)) \/ $fiber_finishing_closers(pfiberclose_tail*, pfiberfinish))
def $fiber_callback_finish_live(S, pfiberfinish) = true
  -- if $fiber_at(S, pfiberfinish.OBJECT) = (pfiber)
  -- if pfiber.READY /\ pfiber.STATUS = FIBER_RUNNING
  -- if pfiber.CALL = eps /\ pfiber.RAW = PNULL /\ pfiber.TARGET = eps
  -- if pfiber.BIRTH = eps /\ pfiber.CAPTURE = eps /\ pfiber.PRODUCER = eps
  -- if pfiber.ENTRY = eps /\ pfiber.VM = eps
  -- if ~pfiber.FAILED /\ ~pfiber.GRACEFUL
  -- if pfiber.FINISH = (pfiberfinish) /\ pfiber.SEQUENCE = pfiberfinish.SEQUENCE
  -- if $(pfiber.SEQUENCE > 0) /\ $(pfiber.SEQUENCE < S.FIBERSEQ)
  -- if $fiber_closing(S, (pfiberfinish.OBJECT))
