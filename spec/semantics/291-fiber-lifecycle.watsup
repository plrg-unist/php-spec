  -- if pfiberclose.SUSPEND.KIND = (INTRINSIC_FIBER_SUSPEND)
  -- if $(pfiberclose.SUSPEND.SEQUENCE < pfiberclose.SEQUENCE)
def $fiber_graceful_live(S, n) = false -- otherwise
;; After the close returns, its private zval is still an ordered release owner.
;; Admit only that storage lifetime; catch and pending authority remain live-only.
def $fiber_graceful_retiring(S, n) = true
