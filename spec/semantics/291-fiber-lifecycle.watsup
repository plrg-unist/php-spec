def $fiber_ordinary_finish_live(S, pfiberfinish) = false -- otherwise
def $fiber_callback_finish_valid(S, pfiberfinish) = (($fiber_callback_finish_live(S, pfiberfinish) \/ $fiber_ordinary_finish_live(S, pfiberfinish)) /\ S.ACTIVEFIBER = (pfiberfinish.OBJECT) /\ S.CURRENT = eps /\ S.FRAMES = eps)
