;; Edited internal code cannot substitute a missing/ambiguous write line.
dec $code_write_lines(pcodeexpr*, pcpath) : int*
def $code_write_lines(eps, pcpath) = eps
def $code_write_lines((CODEWRITE pcpath z) :: pcodeexpr*, pcpath) = z :: $code_write_lines(pcodeexpr*, pcpath)
def $code_write_lines((CODEWRITE pcpath_other z) :: pcodeexpr*, pcpath) = $code_write_lines(pcodeexpr*, pcpath)
  -- if pcpath_other =/= pcpath
def $code_write_lines((CODEEXPR pcpath_other z b) :: pcodeexpr*, pcpath) = $code_write_lines(pcodeexpr*, pcpath)
def $code_write_lines((CODEEFFECT pcpath_other) :: pcodeexpr*, pcpath) = $code_write_lines(pcodeexpr*, pcpath)
dec $write_descriptor_ready(pstate, pcpath) : bool
def $write_descriptor_ready(S, pcpath) = true
  -- if S.ORIGIN = (PORIGIN n pcpath_parent)
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_write_lines(pcode.EXPRESSIONS, pcpath_parent ++ pcpath) = [z]
  -- if $(z > 0)
def $write_descriptor_ready(S, pcpath) = false -- otherwise
dec $memoized_write_ready(pstate, pbase, pcpath) : bool
def $memoized_write_ready(S, BASE_DIM pbase poperand z, pcpath) = ($write_descriptor_ready(S, pcpath) /\ $memoized_write_ready(S, pbase, pcpath ++ [PCFIELD 0]))
def $memoized_write_ready(S, pbase, pcpath) = $write_descriptor_ready(S, pcpath) -- otherwise

;; Quiet and writable accesses share evaluated operands, but use separate
;; compiler occurrence lines. REFERENCE temporaries retain their acquired cell.
dec $memoized_write_base(pstate, pbase, pcpath) : pbase
def $memoized_write_base(S, BASE_VALUE poperand, pcpath) = BASE_VALUE poperand
def $memoized_write_base(S, BASE_NAME poperand z, pcpath) = BASE_NAME poperand $runtime_write_line(S, pcpath)
def $memoized_write_base(S, BASE_DIM pbase poperand z, pcpath) = BASE_DIM $memoized_write_base(S, pbase, pcpath ++ [PCFIELD 0]) poperand $runtime_write_line(S, pcpath)

dec $coalesce_assign_name(pstate, nat*, poperand, int) : pstate
def $coalesce_assign_name(S, n_name*, poperand, z) = $throw_scalar(S, "Error", [67,97,110,110,111,116,32,114,101,45,97,115,115,105,103,110,32,36,116,104,105,115], z)
  -- if $this_name(n_name*)
def $coalesce_assign_name(S, n_name*, poperand, z) = S_read
  -- if ~$this_name(n_name*)
  -- if S_read = $resolve_at(S, poperand, z)
  -- if S_read.COMPLETION =/= NORMAL
def $coalesce_assign_name(S, n_name*, poperand, z) = $write_name(S_read, n_name*, pvalue)
  -- if ~$this_name(n_name*)
  -- if S_read = $resolve_at(S, poperand, z)
  -- if S_read.COMPLETION = NORMAL
  -- if S_read.RESULT = KNOWN pvalue

dec $coalesce_assign(pstate, pbase, poperand, int) : pstate
def $coalesce_assign(S, BASE_VALUE (VARIABLE n_name* z_name), poperand, z) = $coalesce_assign_name(S, n_name*, poperand, z)
def $coalesce_assign(S, BASE_NAME poperand_name z_name, poperand, z) = S_name
  -- if S_name = $resolve_name(S, poperand_name, z_name)
  -- if S_name.COMPLETION =/= NORMAL
def $coalesce_assign(S, BASE_NAME poperand_name z_name, poperand, z) = $coalesce_assign_name(S_name, n_name*, poperand, z_name)
  -- if S_name = $resolve_name(S, poperand_name, z_name)
  -- if S_name.COMPLETION = NORMAL
  -- if S_name.RESULT = KNOWN (PSTRING n_name*)
def $coalesce_assign(S, BASE_DIM pbase poperand_key z_key, poperand, z) = $assign_array(S, BASE_DIM pbase poperand_key z_key, poperand, z)

