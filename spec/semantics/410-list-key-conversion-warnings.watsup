def $list_null_key_plan(S) = eps -- otherwise

def $list_null_key_pending(S) = true
  -- if $error_handler_eligible(S, 8192) \/ $error_handler_eligible(S, 2)
  -- if $list_null_key_plan(S) =/= eps
def $list_null_key_pending(S) = false -- otherwise

dec $list_null_key_message() : nat*
def $list_null_key_message() = $ptascii("Using null as an array offset is deprecated, use an empty string instead")

rule PhpStep/list-null-key-warning: S ~> $error_dispatch(S, 8192, $list_null_key_message(), z, DIAGNOSTIC "Deprecated" $list_null_key_message() z, LIST_KEY_NULL_RESULT poperand n_array n expression phpType13* z 0)
  -- if $list_null_key_pending(S)
  -- if $list_null_key_plan(S) = ((poperand, n_array, n, expression, phpType13*, z))
rule PhpStep/list-null-key-release: S ~> S[.TODO = (LIST_KEY_NULL_RESULT poperand n_array n expression phpType13* z 1) :: ptask_tail*][.RESULT = KNOWN PNULL]
  -- if S.TODO = (LIST_KEY_NULL_RESULT poperand n_array n expression phpType13* z 0) :: ptask_tail*
  -- if $list_null_key_source(S, poperand, n_array, n, expression, phpType13*, z, 0)
rule PhpStep/list-null-key-expired: S ~> S[.TODO = $list_fetched_tasks(S[.RESULT = KNOWN PNULL], poperand, n, expression, false, phpType13*, z) ++ ptask_tail*][.RESULT = KNOWN PNULL]
  -- if S.TODO = (LIST_KEY_NULL_RESULT poperand n_array n expression phpType13* z 1) :: ptask_tail*
