rule PhpStep/list-null-key-result: S ~> S[.TODO = $list_fetched_tasks(S[.RESULT = KNOWN pvalue], poperand, n, expression, false, phpType13*, z) ++ ptask_tail*][.RESULT = KNOWN PNULL]
  -- if S.TODO = (LIST_KEY_NULL_RESULT poperand n_array n expression phpType13* z 1) :: ptask_tail*
