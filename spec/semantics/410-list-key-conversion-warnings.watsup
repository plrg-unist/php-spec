rule PhpStep/list-null-key-missing: S ~> $error_dispatch(S, 2, $list_missing_message(KSTRING eps), z, DIAGNOSTIC "Warning" $list_missing_message(KSTRING eps) z, LIST_MISSING_RESULT poperand n expression phpType13* z (KSTRING eps))
  -- if S.TODO = (LIST_KEY_NULL_RESULT poperand n_array n expression phpType13* z 1) :: ptask_tail*
