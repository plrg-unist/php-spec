  -- if perrorcall.EVENT = DIAGNOSTIC "Deprecated" $list_null_key_message() z
def $task_nodes(LIST_KEY_NULL_RESULT (KNOWN (PARRAY n_array)) n_array n expression phpType13* z n_phase) = [HARRAY n_array]
def $task_nodes(LIST_KEY_NULL_RESULT (REFERENCE n_source) n_array n expression phpType13* z 0) = [HCELL n_source, HARRAY n_array]
def $task_nodes(LIST_KEY_NULL_RESULT (REFERENCE n_source) n_array n expression phpType13* z 1) = [HCELL n_source]
