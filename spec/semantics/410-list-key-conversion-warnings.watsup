def $call_task_valid(S, LIST_KEY_NULL_RESULT poperand n_array n expression phpType13* z n_phase) = $list_null_key_source(S, poperand, n_array, n, expression, phpType13*, z, n_phase)
def $error_call_valid(S, perrorcall) = true
  -- if perrorcall.RESUME = LIST_KEY_NULL_RESULT poperand n_array n expression phpType13* z 0
  -- if S.ORIGIN = (perrorcall.SITE)
