  -- if S.TODO = [DEFAULT_BIND pfunction.ORIGIN n]
  -- if $default_bind_task_valid(S, pfunction.ORIGIN, n)
def $default_string_producer(S, pfunction, n) = true
  -- if S.TODO = [DEFAULT_RECEIVE pfunction.ORIGIN n]
  -- if $default_task_valid(S, pfunction.ORIGIN, n)
def $default_string_producer(S, pfunction, n) = false -- otherwise
