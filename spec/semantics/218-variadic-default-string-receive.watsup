def $variadic_string_position_valid(S, pvariadicstring) = false -- otherwise

dec $receive_string_same_owner(ptask, ptask) : bool
def $receive_string_same_owner(VARIADIC_STRING_RESULT pvariadicstring, VARIADIC_STRING_RESULT pvariadicstring_other) = (pvariadicstring.FUNCTION = pvariadicstring_other.FUNCTION /\ pvariadicstring.INDEX = pvariadicstring_other.INDEX /\ pvariadicstring.ELEMENT = pvariadicstring_other.ELEMENT /\ pvariadicstring.NAMED = pvariadicstring_other.NAMED /\ pvariadicstring.OBJECT = pvariadicstring_other.OBJECT /\ pvariadicstring.LINE = pvariadicstring_other.LINE)
def $receive_string_same_owner(DEFAULT_STRING_RESULT pparameterstring, DEFAULT_STRING_RESULT pparameterstring_other) = (pparameterstring.FUNCTION = pparameterstring_other.FUNCTION /\ pparameterstring.INDEX = pparameterstring_other.INDEX /\ pparameterstring.OBJECT = pparameterstring_other.OBJECT /\ pparameterstring.LINE = pparameterstring_other.LINE)
def $receive_string_same_owner(DEFAULT_STRING_RESULT pparameterstring, PARAMETER_STRING_RESULT pparameterstring_other) = (pparameterstring.FUNCTION = pparameterstring_other.FUNCTION /\ pparameterstring.INDEX = pparameterstring_other.INDEX /\ pparameterstring.OBJECT = pparameterstring_other.OBJECT /\ pparameterstring.LINE = pparameterstring_other.LINE)
def $receive_string_same_owner(ptask, ptask_other) = false -- otherwise
dec $receive_string_saved(pstate, ptask, pframe*) : bool
dec $receive_string_saved_frame(pstate, ptask, pframe, pframe*) : bool
def $receive_string_saved_frame(S, ptask_consumer, pframe, pframe_tail*) = true
  -- if pframe.LOCALS = (psymboltable)
  -- if $receive_string_shape(pframe.TODO, ptask_consumer)
  -- if S_owner = S[.CURRENT = pframe.CONTEXT][.ENV = psymboltable.ENV][.ORIGIN = pframe.ORIGIN][.FRAMES = pframe_tail*]
  -- if $receive_string_record_valid(S_owner, ptask_consumer)
  -- if $receive_string_current(S_owner, ptask_consumer)
def $receive_string_saved_frame(S, ptask_consumer, pframe, pframe_tail*) = false -- otherwise
def $receive_string_saved(S, ptask_consumer, eps) = false
def $receive_string_saved(S, ptask_consumer, pframe :: pframe_tail*) = $receive_string_saved_frame(S, ptask_consumer, pframe, pframe_tail*)
  -- if $receive_string_frame_task(pframe.TODO) = (ptask_owner)
  -- if $receive_string_same_owner(ptask_consumer, ptask_owner)
def $receive_string_saved(S, ptask_consumer, pframe :: pframe_tail*) = $receive_string_saved(S, ptask_consumer, pframe_tail*)
  -- if $receive_string_frame_task(pframe.TODO) = eps
def $receive_string_saved(S, ptask_consumer, pframe :: pframe_tail*) = $receive_string_saved(S, ptask_consumer, pframe_tail*)
  -- if $receive_string_frame_task(pframe.TODO) = (ptask_owner)
  -- if ~$receive_string_same_owner(ptask_consumer, ptask_owner)
dec $receive_string_active_owner(pstate, ptask) : bool
def $receive_string_active_owner(S, ptask_consumer) = true
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.FUNCTION = $receive_string_function(ptask_consumer)
  -- if S.ORIGIN = ($default_parameter_origin(S, $receive_string_function(ptask_consumer), $receive_string_index(ptask_consumer)))
def $receive_string_active_owner(S, ptask_consumer) = false -- otherwise
dec $receive_string_scope_valid(pstate, ptask) : bool
def $receive_string_scope_valid(S, ptask_consumer) = ($receive_string_record_valid(S, ptask_consumer) /\ $receive_string_shape(S.TODO, ptask_consumer) /\ $receive_string_current(S, ptask_consumer))
  -- if $receive_string_active_owner(S, ptask_consumer)
def $receive_string_scope_valid(S, ptask_consumer) = $receive_string_saved(S, ptask_consumer, S.FRAMES)
  -- if ~$receive_string_active_owner(S, ptask_consumer)

def $stringify_source(S, porigin_site, z, DEFAULT_STRING_RESULT pparameterstring) = true
  -- if porigin_site = $default_parameter_origin(S, pparameterstring.FUNCTION, pparameterstring.INDEX)
  -- if z = pparameterstring.LINE
  -- if $receive_string_scope_valid(S, DEFAULT_STRING_RESULT pparameterstring)
def $stringify_source(S, porigin_site, z, VARIADIC_STRING_RESULT pvariadicstring) = true
  -- if porigin_site = $default_parameter_origin(S, pvariadicstring.FUNCTION, pvariadicstring.INDEX)
  -- if z = pvariadicstring.LINE
  -- if $receive_string_scope_valid(S, VARIADIC_STRING_RESULT pvariadicstring)
dec $receive_string_extended(ptask) : bool
def $receive_string_extended(DEFAULT_STRING_RESULT pparameterstring) = true
def $receive_string_extended(VARIADIC_STRING_RESULT pvariadicstring) = true
def $receive_string_extended(ptask) = false -- otherwise
dec $receive_string_result_marker(pstate, ptask*, nat, porigin, int) : bool
def $receive_string_result_marker(S, [STRINGIFY_RESULT n porigin_site z, ptask_consumer], n, porigin_site, z) = $stringify_source(S, porigin_site, z, ptask_consumer)
  -- if $receive_string_extended(ptask_consumer)
def $receive_string_result_marker(S, (CALL_ARGS (METHOD_TARGET n porigin_method) eps 0 eps (porigin_site) z) :: ptask*, n, porigin_site, z) = $receive_string_result_marker(S, ptask*, n, porigin_site, z)
def $receive_string_result_marker(S, (THROW_SEARCH n_throw) :: ptask*, n, porigin_site, z) = $receive_string_result_marker(S, ptask*, n, porigin_site, z)
def $receive_string_result_marker(S, ptask*, n, porigin_site, z) = false -- otherwise
def $stringify_result_valid(S, n, porigin_site, z) = true
  -- if S.ORIGIN = (porigin_site)
  -- if $receive_string_result_marker(S, S.TODO, n, porigin_site, z)
def $task_nodes(DEFAULT_STRING_RESULT pparameterstring) = [HCELL pparameterstring.CELL, HOBJECT pparameterstring.OBJECT]
def $task_nodes(VARIADIC_STRING_RESULT pvariadicstring) = $operand_nodes(pvariadicstring.OPERAND) ++ [HOBJECT pvariadicstring.OBJECT]
def $call_task_valid(S, DEFAULT_STRING_RESULT pparameterstring) = $receive_string_scope_valid(S, DEFAULT_STRING_RESULT pparameterstring)
def $call_task_valid(S, VARIADIC_STRING_RESULT pvariadicstring) = $receive_string_scope_valid(S, VARIADIC_STRING_RESULT pvariadicstring)

;; Mint only at the authenticated normal receive result. Persistent216 source
;; checks remain independent of whichever caller is active afterward.
dec $receive_string_cell(ptask) : nat?
def $receive_string_cell(DEFAULT_STRING_RESULT pparameterstring) = (pparameterstring.CELL)
def $receive_string_cell(VARIADIC_STRING_RESULT pvariadicstring) = (n_cell)
  -- if pvariadicstring.OPERAND = REFERENCE n_cell
def $receive_string_cell(VARIADIC_STRING_RESULT pvariadicstring) = eps
  -- if pvariadicstring.OPERAND = KNOWN pvalue
dec $receive_backing_admission(pstate, ptask, nat, ptbytes) : bool
def $receive_backing_admission(S, ptask_consumer, n_cell, ptbytes) = true
  -- if ptask_consumer = VARIADIC_STRING_RESULT pvariadicstring
  -- if S.COMPLETION = NORMAL
  -- if S.TODO = [ptask_consumer]
  -- if S.RESULT = KNOWN pvalue_string
  -- if $string_bytes(pvalue_string) = (ptbytes)
  -- if $receive_string_scope_valid(S, ptask_consumer)
  -- if $receive_string_cell(ptask_consumer) = (n_cell)
  -- if n_cell <- S.REFCELLS
  -- if $propref_at(S.PROPREFS, n_cell) = (ppropref)
  -- if $parameter_backing_source(S, {FUNCTION $receive_string_function(ptask_consumer), INDEX $receive_string_index(ptask_consumer), CELL n_cell, LINE $receive_string_line(ptask_consumer), VALUE ptbytes})
def $receive_backing_admission(S, ptask_consumer, n_cell, ptbytes) = false -- otherwise
dec $receive_string_store(pstate, ptask, nat, ptbytes) : pstate
def $receive_string_store(S, DEFAULT_STRING_RESULT pparameterstring, n_cell, ptbytes) = $write_cell_checked(S, n_cell, pvalue_string, pparameterstring.LINE)
  -- if S.RESULT = KNOWN pvalue_string
  -- if $string_bytes(pvalue_string) = (ptbytes)
def $receive_string_store(S, VARIADIC_STRING_RESULT pvariadicstring, n_cell, ptbytes) = $write_cell_checked(S, n_cell, pvalue_string, pvariadicstring.LINE)
  -- if S.RESULT = KNOWN pvalue_string
  -- if $string_bytes(pvalue_string) = (ptbytes)
  -- if $propref_at(S.PROPREFS, n_cell) = eps
def $receive_string_store(S, VARIADIC_STRING_RESULT pvariadicstring, n_cell, ptbytes) = S[.STORE = $set_cell(S.STORE, n_cell, DEFINED pvalue_string)][.PARAMETERBACKINGS = pparameterbacking :: $parameter_backing_remove(S.PARAMETERBACKINGS, n_cell)]
  -- if S.RESULT = KNOWN pvalue_string
  -- if $string_bytes(pvalue_string) = (ptbytes)
  -- if ptask_consumer = VARIADIC_STRING_RESULT pvariadicstring
  -- if $propref_at(S.PROPREFS, n_cell) = (ppropref)
  -- if $receive_backing_admission(S, ptask_consumer, n_cell, ptbytes)
  -- if pparameterbacking = {FUNCTION $receive_string_function(ptask_consumer), INDEX $receive_string_index(ptask_consumer), CELL n_cell, LINE $receive_string_line(ptask_consumer), VALUE ptbytes}
def $receive_string_store(S, VARIADIC_STRING_RESULT pvariadicstring, n_cell, ptbytes) = S[.COMPLETION = UNSUPPORTED "invalid parameter backing conversion"]
  -- if ptask_consumer = VARIADIC_STRING_RESULT pvariadicstring
  -- if $propref_at(S.PROPREFS, n_cell) = (ppropref)
  -- if ~$receive_backing_admission(S, ptask_consumer, n_cell, ptbytes)

rule PhpStep/variadic-string-begin: S ~> $user_string_begin(S[.ORIGIN = (porigin_site)], pvariadicstring.OBJECT, porigin_site, pvariadicstring.LINE, VARIADIC_STRING_RESULT pvariadicstring, eps)
  -- if $variadic_string_selected(S) = (pvariadicstring)
  -- if porigin_site = $default_parameter_origin(S, pvariadicstring.FUNCTION, pvariadicstring.INDEX)
dec $variadic_string_finish(pstate, pvariadicstring, pvalue) : pstate
def $variadic_string_finish(S, pvariadicstring, pvalue) = $variadic_insert(S, pfunction, $(pvariadicstring.INDEX + pvariadicstring.ELEMENT), pvariadicstring.OPERAND, pvalue)
  -- if ~pvariadicstring.NAMED
  -- if $receiving_function(S, pvariadicstring.FUNCTION) = (pfunction)
def $variadic_string_finish(S, pvariadicstring, pvalue) = $named_variadic_insert(S, pfunction, pvariadicstring.ELEMENT, pvariadicstring.OPERAND, pvalue)
  -- if pvariadicstring.NAMED
  -- if $receiving_function(S, pvariadicstring.FUNCTION) = (pfunction)
rule PhpStep/variadic-string-value: S ~> $variadic_string_finish(S, pvariadicstring, pvalue_string)
  -- if S.COMPLETION = NORMAL
  -- if S.TODO = [VARIADIC_STRING_RESULT pvariadicstring]
  -- if $receive_string_scope_valid(S, VARIADIC_STRING_RESULT pvariadicstring)
  -- if pvariadicstring.OPERAND = KNOWN pvalue
  -- if S.RESULT = KNOWN pvalue_string
  -- if $string_bytes(pvalue_string) = (ptbytes)
rule PhpStep/variadic-string-reference: S ~> $variadic_string_finish(S_store, pvariadicstring, pvalue_string)
  -- if S.COMPLETION = NORMAL
  -- if S.TODO = [VARIADIC_STRING_RESULT pvariadicstring]
  -- if $receive_string_scope_valid(S, VARIADIC_STRING_RESULT pvariadicstring)
  -- if pvariadicstring.OPERAND = REFERENCE n_cell
  -- if S.RESULT = KNOWN pvalue_string
  -- if $string_bytes(pvalue_string) = (ptbytes)
  -- if S_store = $receive_string_store(S, VARIADIC_STRING_RESULT pvariadicstring, n_cell, ptbytes)
  -- if S_store.COMPLETION = NORMAL
rule PhpStep/variadic-string-reference-abrupt: S ~> S_store
  -- if S.COMPLETION = NORMAL
  -- if S.TODO = [VARIADIC_STRING_RESULT pvariadicstring]
  -- if $receive_string_scope_valid(S, VARIADIC_STRING_RESULT pvariadicstring)
  -- if pvariadicstring.OPERAND = REFERENCE n_cell
  -- if S.RESULT = KNOWN pvalue_string
  -- if $string_bytes(pvalue_string) = (ptbytes)
  -- if S_store = $receive_string_store(S, VARIADIC_STRING_RESULT pvariadicstring, n_cell, ptbytes)
  -- if S_store.COMPLETION =/= NORMAL
rule PhpStep/default-string-store: S ~> S_store[.TODO = $default_next(S_store, pfunction, $(pparameterstring.INDEX + 1))][.ORIGIN = (pfunction.ORIGIN)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.COMPLETION = NORMAL
  -- if S.TODO = [DEFAULT_STRING_RESULT pparameterstring]
  -- if $receive_string_scope_valid(S, DEFAULT_STRING_RESULT pparameterstring)
  -- if S.RESULT = KNOWN pvalue_string
  -- if $string_bytes(pvalue_string) = (ptbytes)
  -- if $receiving_function(S, pparameterstring.FUNCTION) = (pfunction)
  -- if S_store = $receive_string_store(S, DEFAULT_STRING_RESULT pparameterstring, pparameterstring.CELL, ptbytes)
  -- if S_store.COMPLETION = NORMAL
rule PhpStep/default-string-store-abrupt: S ~> S_store
  -- if S.COMPLETION = NORMAL
  -- if S.TODO = [DEFAULT_STRING_RESULT pparameterstring]
  -- if $receive_string_scope_valid(S, DEFAULT_STRING_RESULT pparameterstring)
  -- if S.RESULT = KNOWN pvalue_string
  -- if $string_bytes(pvalue_string) = (ptbytes)
  -- if S_store = $receive_string_store(S, DEFAULT_STRING_RESULT pparameterstring, pparameterstring.CELL, ptbytes)
  -- if S_store.COMPLETION =/= NORMAL
