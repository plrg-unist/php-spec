def $receive_string_operand_valid(S, pvariadicstring) = false -- otherwise

dec $variadic_string_position_valid(pstate, pvariadicstring) : bool
dec $receive_string_current(pstate, ptask) : bool
def $receive_string_current(S, DEFAULT_STRING_RESULT pparameterstring) = true
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.FUNCTION = pparameterstring.FUNCTION
  -- if $fixed_parameter_defaulted(S, pparameterstring.INDEX)
