  -- if $typed_parameter_conversion_at(S, psparam.TYPE, POBJECT pvariadicstring.OBJECT, false) = TYPEDEPENDENT "user object string conversion"
  -- if pvariadicstring.LINE = $default_parameter_line(S, pvariadicstring.FUNCTION, pvariadicstring.INDEX)
  -- if $parameter_string_site_valid(S, $default_parameter_origin(S, pvariadicstring.FUNCTION, pvariadicstring.INDEX), pvariadicstring.LINE)
  -- if $receive_string_operand_valid(S, pvariadicstring)
def $receive_string_record_valid(S, ptask) = false -- otherwise
def $receive_string_operand_valid(S, pvariadicstring) = true
  -- if pvariadicstring.OPERAND = KNOWN (POBJECT pvariadicstring.OBJECT)
def $receive_string_operand_valid(S, pvariadicstring) = true
  -- if pvariadicstring.OPERAND = REFERENCE n_cell
  -- if n_cell <- S.REFCELLS
  -- if (HCELL n_cell) <- S.ALLOCATIONS
