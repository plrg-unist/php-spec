  -- if S.ORIGIN = ($default_parameter_origin(S, pparameterstring.FUNCTION, pparameterstring.INDEX))
  -- if ~$typed_caller_strict(S)
def $receive_string_current(S, VARIADIC_STRING_RESULT pvariadicstring) = true
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.FUNCTION = pvariadicstring.FUNCTION
  -- if S.ORIGIN = ($default_parameter_origin(S, pvariadicstring.FUNCTION, pvariadicstring.INDEX))
  -- if ~$typed_caller_strict(S)
  -- if $variadic_string_position_valid(S, pvariadicstring)
def $receive_string_current(S, ptask) = false -- otherwise
def $variadic_string_position_valid(S, pvariadicstring) = true
  -- if ~pvariadicstring.NAMED
  -- if S.CURRENT = (pcallcontext)
  -- if $(pvariadicstring.ELEMENT < |pcallcontext.EXTRA|)
  -- if pcallcontext.EXTRA[pvariadicstring.ELEMENT] = pvariadicstring.OPERAND
  -- if n_arg = $(pvariadicstring.INDEX + pvariadicstring.ELEMENT)
  -- if $variadic_receive_valid(S[.ORIGIN = (pvariadicstring.FUNCTION)][.TODO = [VARIADIC_RECEIVE pvariadicstring.FUNCTION n_arg]], pvariadicstring.FUNCTION, n_arg)
def $variadic_string_position_valid(S, pvariadicstring) = true
  -- if pvariadicstring.NAMED
  -- if S.CURRENT = (pcallcontext)
  -- if $(pvariadicstring.ELEMENT < |pcallcontext.NAMED|)
