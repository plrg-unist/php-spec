  -- if $parameter_string_site_valid(S, $default_parameter_origin(S, pfunction.ORIGIN, n), $default_parameter_line(S, pfunction.ORIGIN, n))
def $default_string_candidate(S, pfunction, n, pvalue) = false -- otherwise
def $default_string_begin(S, pfunction, n, n_object) = $user_string_begin(S_initial[.ORIGIN = (porigin_site)], n_object, porigin_site, z, DEFAULT_STRING_RESULT pparameterstring, eps)
  -- if S_initial = $write_name(S, pfunction.SIGNATURE.PARAMETERS[n].NAME, POBJECT n_object)
  -- if S_initial.COMPLETION = NORMAL
  -- if $lookup(S_initial.ENV, pfunction.SIGNATURE.PARAMETERS[n].NAME) = (n_cell)
  -- if porigin_site = $default_parameter_origin(S, pfunction.ORIGIN, n)
