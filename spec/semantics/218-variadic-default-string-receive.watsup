  -- if pparameterstring = {FUNCTION pfunction.ORIGIN, INDEX n, CELL n_cell, OBJECT n_object, LINE z}
def $default_string_begin(S, pfunction, n, n_object) = S_initial
  -- if S_initial = $write_name(S, pfunction.SIGNATURE.PARAMETERS[n].NAME, POBJECT n_object)
