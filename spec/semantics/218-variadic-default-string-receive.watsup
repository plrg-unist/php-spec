;; All captured values are owned by their consumer. Source/index/line and the
;; immediately owning receive frame authenticate the capture throughout reentry.
dec $receive_string_function(ptask) : porigin
def $receive_string_function(DEFAULT_STRING_RESULT pparameterstring) = pparameterstring.FUNCTION
def $receive_string_function(PARAMETER_STRING_RESULT pparameterstring) = pparameterstring.FUNCTION
def $receive_string_function(VARIADIC_STRING_RESULT pvariadicstring) = pvariadicstring.FUNCTION
dec $receive_string_index(ptask) : nat
def $receive_string_index(DEFAULT_STRING_RESULT pparameterstring) = pparameterstring.INDEX
def $receive_string_index(PARAMETER_STRING_RESULT pparameterstring) = pparameterstring.INDEX
def $receive_string_index(VARIADIC_STRING_RESULT pvariadicstring) = pvariadicstring.INDEX
dec $receive_string_object(ptask) : nat
def $receive_string_object(DEFAULT_STRING_RESULT pparameterstring) = pparameterstring.OBJECT
def $receive_string_object(PARAMETER_STRING_RESULT pparameterstring) = pparameterstring.OBJECT
def $receive_string_object(VARIADIC_STRING_RESULT pvariadicstring) = pvariadicstring.OBJECT
dec $receive_string_line(ptask) : int
def $receive_string_line(DEFAULT_STRING_RESULT pparameterstring) = pparameterstring.LINE
def $receive_string_line(PARAMETER_STRING_RESULT pparameterstring) = pparameterstring.LINE
def $receive_string_line(VARIADIC_STRING_RESULT pvariadicstring) = pvariadicstring.LINE
dec $receive_string_shape(ptask*, ptask) : bool
def $receive_string_shape([CALL_ARGS (METHOD_TARGET n porigin_method) eps 0 eps (porigin_site) z, STRINGIFY_RESULT n porigin_site z, ptask_consumer], ptask_consumer) = (n = $receive_string_object(ptask_consumer) /\ z = $receive_string_line(ptask_consumer))
def $receive_string_shape([STRINGIFY_RESULT n porigin_site z, ptask_consumer], ptask_consumer) = (n = $receive_string_object(ptask_consumer) /\ z = $receive_string_line(ptask_consumer))
def $receive_string_shape([ptask_consumer], ptask_consumer) = true
def $receive_string_shape((THROW_SEARCH n) :: ptask*, ptask_consumer) = $receive_string_shape(ptask*, ptask_consumer)
def $receive_string_shape(ptask*, ptask_consumer) = false -- otherwise
dec $receive_string_frame_task(ptask*) : ptask?
def $receive_string_frame_task([STRINGIFY_RESULT n porigin_site z, DEFAULT_STRING_RESULT pparameterstring]) = (DEFAULT_STRING_RESULT pparameterstring)
def $receive_string_frame_task([DEFAULT_STRING_RESULT pparameterstring]) = (DEFAULT_STRING_RESULT pparameterstring)
def $receive_string_frame_task([STRINGIFY_RESULT n porigin_site z, VARIADIC_STRING_RESULT pvariadicstring]) = (VARIADIC_STRING_RESULT pvariadicstring)
def $receive_string_frame_task([VARIADIC_STRING_RESULT pvariadicstring]) = (VARIADIC_STRING_RESULT pvariadicstring)
def $receive_string_frame_task([STRINGIFY_RESULT n porigin_site z, PARAMETER_STRING_RESULT pparameterstring]) = (PARAMETER_STRING_RESULT pparameterstring)
def $receive_string_frame_task([PARAMETER_STRING_RESULT pparameterstring]) = (PARAMETER_STRING_RESULT pparameterstring)
def $receive_string_frame_task((THROW_SEARCH n) :: ptask*) = $receive_string_frame_task(ptask*)
def $receive_string_frame_task(ptask*) = eps -- otherwise
def $parameter_string_frame_record([STRINGIFY_RESULT n porigin_site z, DEFAULT_STRING_RESULT pparameterstring]) = (pparameterstring)
def $parameter_string_frame_record([DEFAULT_STRING_RESULT pparameterstring]) = (pparameterstring)
def $parameter_string_frame_scope(S, pframe, pframe_tail*) = S[.CURRENT = pframe.CONTEXT][.ENV = psymboltable.ENV][.ORIGIN = pframe.ORIGIN][.TODO = pframe.TODO][.FRAMES = pframe_tail*]
  -- if $receive_string_frame_task(pframe.TODO) = (VARIADIC_STRING_RESULT pvariadicstring)
  -- if pframe.LOCALS = (psymboltable)

dec $receive_string_operand_mode(psparam, poperand) : bool
def $receive_string_operand_mode(psparam, REFERENCE n_cell) = psparam.BYREF
def $receive_string_operand_mode(psparam, KNOWN pvalue) = ~psparam.BYREF
dec $receive_string_operand_valid(pstate, pvariadicstring) : bool
dec $receive_string_record_valid(pstate, ptask) : bool
def $receive_string_record_valid(S, DEFAULT_STRING_RESULT pparameterstring) = true
  -- if $parameter_string_record_valid(S, pparameterstring)
