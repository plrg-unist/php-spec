  -- if $default_at(pfunction.DEFAULTS, pparameterstring.INDEX) = (pdefault)
  -- if pdefault.KIND = PDDEFERRED
  -- if pdefault.ORIGIN = $constant_child($default_parameter_origin(S, pfunction.ORIGIN, pparameterstring.INDEX), [PCFIELD 6])
def $receive_string_record_valid(S, VARIADIC_STRING_RESULT pvariadicstring) = true
  -- if $receiving_function(S, pvariadicstring.FUNCTION) = (pfunction)
  -- if pvariadicstring.INDEX = |$call_fixed_parameters(pfunction.SIGNATURE.PARAMETERS)|
  -- if $(pvariadicstring.INDEX < |pfunction.SIGNATURE.PARAMETERS|)
