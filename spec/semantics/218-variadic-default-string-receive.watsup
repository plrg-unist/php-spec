;; Named holes are receive metadata, not arguments. Capture their positions
;; before default evaluation can replace the missing slots.
def $named_holes(eps, n) = eps
def $named_holes(NAMED_HOLE :: pnamedslot*, n) = n :: $named_holes(pnamedslot*, $(n + 1))
def $named_holes((NAMED_SENT poperand) :: pnamedslot*, n) = $named_holes(pnamedslot*, $(n + 1))
dec $call_hole_rows_valid(pstate, pcallcontext, pfunction, nat*, nat) : bool
def $call_hole_rows_valid(S, pcallcontext, pfunction, eps, n_min) = true
def $call_hole_rows_valid(S, pcallcontext, pfunction, n :: n_tail*, n_min) = true
  -- if $(n >= n_min) /\ $(n < pcallcontext.ARGC)
  -- if $(n < |$call_fixed_parameters(pfunction.SIGNATURE.PARAMETERS)|)
  -- if porigin_site = $default_parameter_origin(S, pfunction.ORIGIN, n)
  -- if $parameter_string_site_valid(S, porigin_site, $default_parameter_line(S, pfunction.ORIGIN, n))
  -- if $call_hole_rows_valid(S, pcallcontext, pfunction, n_tail*, $(n + 1))
def $call_hole_rows_valid(S, pcallcontext, pfunction, n*, n_min) = false -- otherwise
dec $call_holes_source_valid(pstate, pcallcontext, pfunction) : bool
def $call_holes_source_valid(S, pcallcontext, pfunction) = true
  -- if $call_unpack_site(S, pcallcontext.CALLSITE) \/ pcallcontext.WRAPPER =/= eps
  -- if ~$stringify_context_kind(S, pcallcontext) /\ ~$error_context_kind(S, pcallcontext)
  -- if pcallcontext.HOLES = eps \/ ~$access_context_kind(S, pcallcontext)
def $call_holes_source_valid(S, pcallcontext, pfunction) = (pcallcontext.HOLES = eps)
  -- if $stringify_context_kind(S, pcallcontext) \/ $error_context_kind(S, pcallcontext)
def $call_holes_source_valid(S, pcallcontext, pfunction) = (pcallcontext.HOLES = $named_holes(pnamedargs.SLOTS[0:n_fixed], 0))
  -- if ~$call_unpack_site(S, pcallcontext.CALLSITE)
  -- if pcallcontext.WRAPPER = eps
  -- if ~$stringify_context_kind(S, pcallcontext) /\ ~$error_context_kind(S, pcallcontext)
  -- if pcallcontext.HOLES = eps \/ ~$access_context_kind(S, pcallcontext)
  -- if pcallcontext.CALLSITE = (porigin_site)
  -- if $call_argument_source(S, porigin_site) = PCALLARGUMENTS phpType7* n_field
  -- if pnamedargs = $named_call_shape(S, $context_target(pcallcontext), pcallcontext.CALLSITE)
  -- if n_fixed = $call_received(|pnamedargs.SLOTS|, |$call_fixed_parameters(pfunction.SIGNATURE.PARAMETERS)|)
def $call_holes_source_valid(S, pcallcontext, pfunction) = (pcallcontext.HOLES = eps)
  -- if ~$call_unpack_site(S, pcallcontext.CALLSITE)
  -- if pcallcontext.WRAPPER = eps
  -- if ~$stringify_context_kind(S, pcallcontext) /\ ~$error_context_kind(S, pcallcontext)
  -- if pcallcontext.HOLES = eps \/ ~$access_context_kind(S, pcallcontext)
  -- if pcallcontext.CALLSITE = (porigin_site)
  -- if $call_argument_source(S, porigin_site) = PCALLNOARGUMENTS
def $call_holes_source_valid(S, pcallcontext, pfunction) = false -- otherwise
def $call_holes_valid(S, pcallcontext) = true
  -- if $function_at($all_functions(S), pcallcontext.FUNCTION) = (pfunction)
  -- if $call_hole_rows_valid(S, pcallcontext, pfunction, pcallcontext.HOLES, 0)
  -- if $call_holes_source_valid(S, pcallcontext, pfunction)
def $call_holes_valid(S, pcallcontext) = false -- otherwise
def $fixed_parameter_supplied(S, n) = true
  -- if S.CURRENT = (pcallcontext)
  -- if $(n < pcallcontext.ARGC)
  -- if ~(n <- pcallcontext.HOLES)
  -- if $call_holes_valid(S, pcallcontext)
def $fixed_parameter_supplied(S, n) = false -- otherwise
dec $fixed_parameter_defaulted(pstate, nat) : bool
def $fixed_parameter_defaulted(S, n) = true
  -- if S.CURRENT = (pcallcontext)
  -- if $(n >= pcallcontext.ARGC) \/ n <- pcallcontext.HOLES
  -- if $call_holes_valid(S, pcallcontext)
def $fixed_parameter_defaulted(S, n) = false -- otherwise

;; DEFAULT also labels property initializers. Only a genuine NParam subtree
;; admits NEW here; class-constant and property NEW rules remain separate.
def $ppparameter_new_site(P, pcpath) = (P.FOLD.DEFAULT /\ $default_below(P.FOLD.SOURCE.OCCURRENCES, pcpath))
;; Method defaults use the declaring scope. Anonymous Closure keyword defaults
;; retain their selector for the authentic live receive; ordinary NEW is exact.
dec $ppparameter_new_selector(ptscope, name) : ptbytes?
def $ppparameter_new_selector(PTKNOWN ptbytes_owner ptbytes_parent?, NName (BYTES text) metadata) = (ptbytes_owner)
  -- if $ptlc($base64(text)) = $ptascii("self")
def $ppparameter_new_selector(PTKNOWN ptbytes_owner (ptbytes_parent), NName (BYTES text) metadata) = (ptbytes_parent)
  -- if $ptlc($base64(text)) = $ptascii("parent")
def $ppparameter_new_selector(ptscope, name) = eps -- otherwise
def $ppparameter_new_resolve(P, pcpath, name) = $ppparameter_new_selector(ptcontext.SCOPE, name)
  -- if P.CLASSCONTEXT = (ptcontext)
  -- if $ppparameter_new_site(P, pcpath) /\ ~P.CLOSURE
def $ppparameter_new_resolve(P, pcpath, name) = eps
  -- if P.CLASSCONTEXT = (ptcontext)
  -- if ~$ppparameter_new_site(P, pcpath) \/ P.CLOSURE
def $ppparameter_new_resolve(P, pcpath, name) = eps
  -- if P.CLASSCONTEXT = eps
dec $ppanonymous_new_deferred(ppstate, pcpath, name) : bool
def $ppanonymous_new_deferred(P, pcpath, name) = false -- otherwise
def $ppnew_class_name(P, pcpath, name) = $ppclass_name(P, pcpath, PNRESOLVED {ORIGINAL name, KIND PLCLASS, RESOLVED ptbytes, FULL true, FALLBACK eps})
  -- if $ppparameter_new_resolve(P, pcpath, name) = (ptbytes)
  -- if ~$pptrait_new_deferred(P, pcpath, name) /\ ~$ppanonymous_new_deferred(P, pcpath, name)
def $ppnew_class_name(P, pcpath, name) = $ppclass_name(P, pcpath, $pnclassresolve(P.ENV, name))
  -- if $ppparameter_new_resolve(P, pcpath, name) = eps
  -- if ~$pptrait_new_deferred(P, pcpath, name) /\ ~$ppanonymous_new_deferred(P, pcpath, name)
  -- if ~$ppordinary_new_keyword(P, pcpath, name) /\ ~$ppglobal_new_deferred(P, pcpath, name)
dec $ppparameter_new_class(ppstate, phpType28, metadata) : ppstate
def $ppparameter_new_class(P, phpType28, metadata) = $ppconstant_error(P, $ptascii("\"static\" is not allowed in compile-time constants"), $nabs($source_line(metadata)))
  -- if phpType28 = name
  -- if $ptast(name) = PTNAME PTPLAIN ptbytes
  -- if $ptlc(ptbytes) = $ptascii("static")
def $ppparameter_new_class(P, phpType28, metadata) = P
  -- if phpType28 = name
  -- if $ptast(name) = PTNAME ptqual ptbytes
  -- if ptqual =/= PTPLAIN \/ $ptlc(ptbytes) =/= $ptascii("static")
def $ppparameter_new_class(P, phpType28, metadata) = $ppunsupported(P, "parameter default class target")
  -- otherwise
dec $ppparameter_new_args(ppstate, pcpath, nat, phpType7*, bool) : ppstate
def $ppparameter_new_args(P, pcpath, n, phpType7*, b_named) = P -- if P.COMPLETION =/= PPCNORMAL
def $ppparameter_new_args(P, pcpath, n, eps, b_named) = P -- if P.COMPLETION = PPCNORMAL
def $ppparameter_new_args(P, pcpath, n, (NArg phpType3 expression phpType4_ref (BOOLEAN true) metadata) :: phpType7*, b_named) = $ppconstant_error(P, $ptascii("Argument unpacking in constant expressions is not supported"), $nabs($source_line(metadata)))
  -- if P.COMPLETION = PPCNORMAL
def $ppparameter_new_args(P, pcpath, n, (NArg ABSENT expression phpType4_ref (BOOLEAN false) metadata) :: phpType7*, true) = $ppconstant_error(P, $ptascii("Cannot use positional argument after named argument"), $nabs($source_line(metadata)))
  -- if P.COMPLETION = PPCNORMAL
def $ppparameter_new_args(P, pcpath, n, (NArg phpType3 expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType7*, b_named) = $ppparameter_new_args($ppconstant_validate(P, pcpath ++ [PCINDEX n, PCFIELD 1], expression), pcpath, $(n + 1), phpType7*, (b_named \/ phpType3 =/= ABSENT))
  -- if P.COMPLETION = PPCNORMAL
  -- if phpType3 =/= ABSENT \/ ~b_named
def $ppparameter_new_args(P, pcpath, n, phpType7*, b_named) = $ppunsupported(P, "edited parameter default new arguments") -- otherwise
dec $ppparameter_new_ready(ppstate, pcpath, phpType7*, metadata) : ppstate
def $ppparameter_new_ready(P, pcpath, phpType7*, metadata) = P -- if P.COMPLETION =/= PPCNORMAL
def $ppparameter_new_ready(P, pcpath, phpType7*, metadata) = $ppconstant_error(P, $ptascii("Cannot create Closure for new expression"), $nabs($source_line(metadata)))
  -- if P.COMPLETION = PPCNORMAL
  -- if $ppfirstclass(phpType7*)
def $ppparameter_new_ready(P, pcpath, phpType7*, metadata) = $ppparameter_new_args(P, pcpath ++ [PCFIELD 1], 0, phpType7*, false)
  -- if P.COMPLETION = PPCNORMAL
  -- if ~$ppfirstclass(phpType7*)
def $ppparameter_new(P, pcpath, phpType28, SEQUENCE phpType7*, metadata) = $ppparameter_new_ready($ppparameter_new_class(P, phpType28, metadata), pcpath, phpType7*, metadata)

;; Genuine parameter NEW has a separate suspended AST evaluation context.
;; Ordinary constructors retain their existing dispatch path.
def $parameter_default_constructor(S, name, phpType7*, metadata) = (S.COMPLETION = NORMAL /\ ~$ppfirstclass(phpType7*) /\ $constant_ast_constructor_context(S, pconstantcontext) /\ $origin_node(S.SOURCES, PORIGIN n_unit pcpath) = (NExprNew name (SEQUENCE phpType7*) metadata) /\ $constant_expression_below(S, pconstantcontext.ORIGIN, PORIGIN n_unit pcpath))
  -- if S.CONSTCONTEXT = (pconstantcontext)
  -- if S.ORIGIN = (PORIGIN n_unit pcpath)
def $parameter_default_constructor(S, name, phpType7*, metadata) = false
  -- if S.CONSTCONTEXT = eps
def $parameter_default_constructor(S, name, phpType7*, metadata) = false
  -- if S.CONSTCONTEXT = (pconstantcontext)
  -- if S.ORIGIN = eps

;; The AST default evaluator keeps a named argument table even without a
;; constructor. Its values run in source order and are discarded after NEW.
dec $parameter_default_noctor_at(pstate, pnoctorcall, pconstantcontext, pcnode?) : bool
def $parameter_default_noctor_at(S, pnoctorcall, pconstantcontext, (NExprNew name (SEQUENCE phpType7*) metadata)) = ($parameter_string_site_valid(S, pconstantcontext.ORIGIN, pconstantcontext.LINE) /\ $default_context_valid(S, pconstantcontext) /\ $constant_expression_below(S, pconstantcontext.ORIGIN, pnoctorcall.SITE))
def $parameter_default_noctor_at(S, pnoctorcall, pconstantcontext, pcnode?) = false -- otherwise
def $parameter_default_noctor(S, pnoctorcall) = $parameter_default_noctor_at(S, pnoctorcall, pconstantcontext, $origin_node(S.SOURCES, pnoctorcall.SITE))
  -- if S.CONSTCONTEXT = (pconstantcontext)
def $parameter_default_noctor(S, pnoctorcall) = false
  -- if S.CONSTCONTEXT = eps
def $parameter_new_prefix(eps) = true
def $parameter_new_prefix((NArg ABSENT expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType7*) = $parameter_new_prefix(phpType7*)
def $parameter_new_prefix((NArg (NIdentifier phpType33 metadata_name) expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType7*) = $parameter_new_prefix(phpType7*)
def $parameter_new_prefix(phpType7*) = false -- otherwise
def $noctor_direct_count_at(S, pnoctorcall, phpType7*) = |phpType7*|
  -- if $parameter_default_noctor(S, pnoctorcall)
def $noctor_direct_count_at(S, pnoctorcall, phpType7*) = $noctor_direct_count(phpType7*)
  -- if ~$parameter_default_noctor(S, pnoctorcall)
dec $parameter_new_name_present(phpType7*, ptbytes) : bool
def $parameter_new_name_present(eps, ptbytes) = false
def $parameter_new_name_present((NArg ABSENT expression phpType4_ref phpType4_unpack metadata) :: phpType7*, ptbytes) = $parameter_new_name_present(phpType7*, ptbytes)
def $parameter_new_name_present((NArg (NIdentifier (BYTES text) metadata_name) expression phpType4_ref phpType4_unpack metadata) :: phpType7*, ptbytes) = true
  -- if $base64(text) = ptbytes
def $parameter_new_name_present((NArg (NIdentifier (BYTES text) metadata_name) expression phpType4_ref phpType4_unpack metadata) :: phpType7*, ptbytes) = $parameter_new_name_present(phpType7*, ptbytes)
  -- if $base64(text) =/= ptbytes
def $parameter_new_name_present(phpType7*, ptbytes) = false -- otherwise
rule PhpStep/parameter-default-new-named: S ~> S_value[.TODO = (NOCTOR_ARGS $noctor_advance(pnoctorcall, pnoctorcall.SENT ++ [S_value.RESULT])) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.COMPLETION = NORMAL
  -- if S.TODO = (NOCTOR_SEND pnoctorcall) :: ptask_tail*
  -- if $parameter_default_noctor(S, pnoctorcall)
  -- if $origin_node(S.SOURCES, pnoctorcall.SITE) = (NExprNew name (SEQUENCE phpType7*) metadata)
  -- if phpType7*[pnoctorcall.INDEX] = NArg (NIdentifier (BYTES text) metadata_name) expression (BOOLEAN false) (BOOLEAN false) metadata_arg
  -- if S_value = $resolve_at(S, S.RESULT, $noctor_arg_line(S, pnoctorcall))
  -- if S_value.COMPLETION = NORMAL
  -- if ~$parameter_new_name_present(phpType7*[0:pnoctorcall.INDEX], $base64(text))
rule PhpStep/parameter-default-new-named-duplicate: S ~> $throw_scalar(S_value, "Error", $ptascii("Named parameter $") ++ $base64(text) ++ $ptascii(" overwrites previous argument"), $noctor_arg_line(S, pnoctorcall))
  -- if S.COMPLETION = NORMAL
  -- if S.TODO = (NOCTOR_SEND pnoctorcall) :: ptask_tail*
  -- if $parameter_default_noctor(S, pnoctorcall)
  -- if $origin_node(S.SOURCES, pnoctorcall.SITE) = (NExprNew name (SEQUENCE phpType7*) metadata)
  -- if phpType7*[pnoctorcall.INDEX] = NArg (NIdentifier (BYTES text) metadata_name) expression (BOOLEAN false) (BOOLEAN false) metadata_arg
  -- if S_value = $resolve_at(S, S.RESULT, $noctor_arg_line(S, pnoctorcall))
  -- if S_value.COMPLETION = NORMAL
  -- if $parameter_new_name_present(phpType7*[0:pnoctorcall.INDEX], $base64(text))
rule PhpStep/parameter-default-new-named-abrupt: S ~> S_value
  -- if S.COMPLETION = NORMAL
  -- if S.TODO = (NOCTOR_SEND pnoctorcall) :: ptask_tail*
  -- if $parameter_default_noctor(S, pnoctorcall)
  -- if $origin_node(S.SOURCES, pnoctorcall.SITE) = (NExprNew name (SEQUENCE phpType7*) metadata)
  -- if phpType7*[pnoctorcall.INDEX] = NArg (NIdentifier phpType33 metadata_name) expression (BOOLEAN false) (BOOLEAN false) metadata_arg
  -- if S_value = $resolve_at(S, S.RESULT, $noctor_arg_line(S, pnoctorcall))
  -- if S_value.COMPLETION =/= NORMAL

;; Default objects are never cached. This nonowning tag records allocation
;; class only; the ordinary NEW evaluator supplies the actual object and effects.
def $constant_shape_class(S, porigin, PFNEW phpType28 phpType6) = PVOBJECT
  -- if S.CONSTCONTEXT = (pconstantcontext)
  -- if $origin_node(S.SOURCES, pconstantcontext.ORIGIN) = (NParam phpType14 phpType24 phpType18 phpType4_ref phpType4_var phpType10 expression phpType37 metadata)
  -- if $constant_expression_below(S, pconstantcontext.ORIGIN, porigin)
def $constant_value_class_valid(S, POBJECT n, PVOBJECT) = ((HOBJECT n) <- S.ALLOCATIONS /\ $(n < |S.OBJECTS|))
def $constant_fact_value_valid(pconstantfact) = true
  -- if pconstantfact.VALUE = eps
  -- if pconstantfact.CLASS = PVOBJECT
def $constant_class_tree_valid(PVOBJECT) = true
def $constant_fact_truth(pconstantfact) = (true)
  -- if pconstantfact.VALUE = eps
  -- if pconstantfact.CLASS = PVOBJECT

;; Element verification has the same constrained-reference priority as a fixed
;; receive. Generic reference-return classification is unchanged.
def $variadic_conversion(S, psparam, poperand) = TYPEREJECT
  -- if psparam.BYREF
  -- if $typed_reference_operand_source(S, poperand)
  -- if $typed_parameter_conversion_at(S, psparam.TYPE, $variadic_operand_value(S, poperand), $typed_caller_strict(S)) = TYPEDEPENDENT "user object string conversion"
def $variadic_conversion(S, psparam, poperand) = $typed_parameter_reference_conversion(S, psparam.TYPE, $variadic_operand_value(S, poperand), $typed_caller_strict(S), (psparam.BYREF /\ $typed_reference_operand_source(S, poperand)))
  -- if ~psparam.BYREF \/ ~$typed_reference_operand_source(S, poperand) \/ $typed_parameter_conversion_at(S, psparam.TYPE, $variadic_operand_value(S, poperand), $typed_caller_strict(S)) =/= TYPEDEPENDENT "user object string conversion"

dec $variadic_string_from(pstate, pfunction, nat, bool, poperand) : pvariadicstring?
def $variadic_string_from(S, pfunction, n_element, b_named, poperand) = (pvariadicstring)
  -- if n_fixed = |$call_fixed_parameters(pfunction.SIGNATURE.PARAMETERS)|
  -- if $(n_fixed < |pfunction.SIGNATURE.PARAMETERS|)
  -- if $variadic_operand_value(S, poperand) = POBJECT n_object
  -- if $variadic_conversion(S, pfunction.SIGNATURE.PARAMETERS[n_fixed], poperand) = TYPEDEPENDENT "user object string conversion"
  -- if z = $default_parameter_line(S, pfunction.ORIGIN, n_fixed)
  -- if $parameter_string_site_valid(S, $default_parameter_origin(S, pfunction.ORIGIN, n_fixed), z)
  -- if pvariadicstring = {FUNCTION pfunction.ORIGIN, INDEX n_fixed, ELEMENT n_element, NAMED b_named, OPERAND poperand, OBJECT n_object, LINE z}
def $variadic_string_from(S, pfunction, n_element, b_named, poperand) = eps -- otherwise
dec $variadic_string_selected(pstate) : pvariadicstring?
def $variadic_string_selected(S) = $variadic_string_from(S, pfunction, n_element, false, pcallcontext.EXTRA[n_element])
  -- if S.COMPLETION = NORMAL
  -- if S.TODO = [VARIADIC_RECEIVE porigin n_arg]
  -- if $variadic_receive_valid(S, porigin, n_arg)
  -- if S.CURRENT = (pcallcontext)
  -- if $(n_arg < pcallcontext.ARGC)
  -- if $receiving_function(S, porigin) = (pfunction)
  -- if n_fixed = |$call_fixed_parameters(pfunction.SIGNATURE.PARAMETERS)|
  -- if n_element = $(n_arg - n_fixed)
def $variadic_string_selected(S) = $variadic_string_from(S, pfunction, n_element, true, poperand)
  -- if S.COMPLETION = NORMAL
  -- if S.TODO = [NAMED_VARIADIC_RECEIVE porigin n_element]
  -- if $named_tail_valid(S, porigin, n_element)
  -- if S.CURRENT = (pcallcontext)
  -- if $(n_element < |pcallcontext.NAMED|)
  -- if $receiving_function(S, porigin) = (pfunction)
  -- if (ptbytes, poperand) = pcallcontext.NAMED[n_element]
def $variadic_string_selected(S) = eps -- otherwise
def $variadic_string_candidate(S) = ($variadic_string_selected(S) =/= eps)

;; Named-hole defaults were evaluated by preflight, without conversion. Tail
;; defaults arrive here only after their own DEFAULT_BIND has completed.
dec $default_string_producer(pstate, pfunction, nat) : bool
def $default_string_producer(S, pfunction, n) = true
  -- if S.TODO = [TYPE_RECEIVE pfunction.ORIGIN n]
  -- if $typed_receive_valid(S, pfunction.ORIGIN, n)
