;; Sparse final flags from pinned PHP 8.5.10 -n ReflectionClass over the exact 166-name catalogue.
dec $class_internal_final(ptbytes) : bool
def $class_internal_final(ptbytes) = ($ptlc(ptbytes) <- [
  $ptascii("__php_incomplete_class"),
  $ptascii("allowdynamicproperties"),
  $ptascii("attribute"),
  $ptascii("closure"),
  $ptascii("delayedtargetvalidation"),
  $ptascii("deprecated"),
  $ptascii("directory"),
  $ptascii("fiber"),
  $ptascii("fibererror"),
  $ptascii("generator"),
  $ptascii("hashcontext"),
  $ptascii("internaliterator"),
  $ptascii("nodiscard"),
  $ptascii("override"),
  ($ptascii("random") ++ [92] ++ $ptascii("engine") ++ [92] ++ $ptascii("mt19937")),
  ($ptascii("random") ++ [92] ++ $ptascii("engine") ++ [92] ++ $ptascii("pcgoneseq128xslrr64")),
  ($ptascii("random") ++ [92] ++ $ptascii("engine") ++ [92] ++ $ptascii("secure")),
  ($ptascii("random") ++ [92] ++ $ptascii("engine") ++ [92] ++ $ptascii("xoshiro256starstar")),
  ($ptascii("random") ++ [92] ++ $ptascii("randomizer")),
  $ptascii("reflectionfiber"),
  $ptascii("reflectiongenerator"),
  $ptascii("reflectionreference"),
  $ptascii("returntypewillchange"),
  $ptascii("sensitiveparameter"),
  $ptascii("sensitiveparametervalue"),
  $ptascii("streambucket"),
  ($ptascii("uri") ++ [92] ++ $ptascii("rfc3986") ++ [92] ++ $ptascii("uri")),
  ($ptascii("uri") ++ [92] ++ $ptascii("whatwg") ++ [92] ++ $ptascii("url")),
  ($ptascii("uri") ++ [92] ++ $ptascii("whatwg") ++ [92] ++ $ptascii("urlvalidationerror")),
  $ptascii("weakmap"),
  $ptascii("weakreference")
])

;; The checked frontend records the class keyword separately from modifiers
;; and the class name. Missing, duplicate or out-of-range facts reject source.
dec $class_keyword_lines(metadata) : int*
dec $class_keyword_item(metadataEntry) : int*
def $class_keyword_item(MclassKeywordLine z) = [z]
def $class_keyword_item(metadataEntry) = eps -- otherwise
def $class_keyword_lines(eps) = eps
def $class_keyword_lines(metadataEntry :: metadataEntry_tail*) = $class_keyword_item(metadataEntry) ++ $class_keyword_lines(metadataEntry_tail*)

def $class_keyword_line(metadata, NIdentifier (BYTES text) metadata_name) = z
  -- if $class_keyword_lines(metadata) = [z]
  -- if $(z > 0)
  -- if $(z >= $source_line(metadata))
  -- if $(z <= $source_line(metadata_name))
  -- if $(z <= $source_end_line(metadata))
def $class_keyword_line(metadata, phpType3) = 0 -- otherwise

;; Zend links a top-level child during compilation only when its parent is
;; already in the compiler class table. Forward and conditional parents defer.
dec $ppclass_prior_early(pclassdesc*, ptbytes) : pclassdesc?
def $ppclass_prior_early(eps, ptbytes) = eps
def $ppclass_prior_early(pclassdesc :: pclassdesc_tail*, ptbytes) = (pclassdesc)
  -- if pclassdesc.EARLY /\ $ptlc(pclassdesc.NAME) = $ptlc(ptbytes)
def $ppclass_prior_early(pclassdesc :: pclassdesc_tail*, ptbytes) = $ppclass_prior_early(pclassdesc_tail*, ptbytes)
  -- if ~(pclassdesc.EARLY /\ $ptlc(pclassdesc.NAME) = $ptlc(ptbytes))

;; Interim bounds until compilation publishes each declaration before later
;; diagnostics. Notes remain compiler-only and recompile from source bytes.
dec $ppclass_prior_any(pclassdesc*, ptbytes) : pclassdesc?
dec $ppmethod_find(pmethoddesc*, ptbytes) : pmethoddesc?
dec $ppmethod_root_kind(pclassdesc*, pclassdesc, nat) : text?
def $ppclass_prior_any(eps, ptbytes) = eps
def $ppclass_prior_any(pclassdesc :: pclassdesc_tail*, ptbytes) = (pclassdesc)
  -- if $ptlc(pclassdesc.NAME) = $ptlc(ptbytes)
def $ppclass_prior_any(pclassdesc :: pclassdesc_tail*, ptbytes) = $ppclass_prior_any(pclassdesc_tail*, ptbytes)
  -- if $ptlc(pclassdesc.NAME) =/= $ptlc(ptbytes)
dec $ppclass_root_ancestry(pclassdesc*, ptbytes, nat) : bool
dec $ppclass_root_items(pclassdesc*, pclassdesc*, ptbytes, nat) : bool
def $ppclass_root_ancestry(pclassdesc_all*, ptbytes, n) = true
  -- if $(n > 0) /\ $throwable_link_kind(ptbytes) =/= eps
def $ppclass_root_ancestry(pclassdesc_all*, ptbytes, n) = $ppclass_root_items(pclassdesc_all*, pclassdesc_all*, ptbytes, n)
  -- if $(n > 0) /\ $throwable_link_kind(ptbytes) = eps
def $ppclass_root_ancestry(pclassdesc_all*, ptbytes, n) = false -- otherwise
def $ppclass_root_items(pclassdesc_all*, eps, ptbytes, n) = false
def $ppclass_root_items(pclassdesc_all*, pclassdesc :: pclassdesc_tail*, ptbytes, n) = true
  -- if $ptlc(pclassdesc.NAME) = $ptlc(ptbytes)
  -- if pclassdesc.KIND = "class"
  -- if pclassdesc.PARENT = (ptbytes_parent)
  -- if $ppclass_root_ancestry(pclassdesc_all*, ptbytes_parent, $nabs($(n - 1)))
def $ppclass_root_items(pclassdesc_all*, pclassdesc :: pclassdesc_tail*, ptbytes, n) = $ppclass_root_items(pclassdesc_all*, pclassdesc_tail*, ptbytes, n)
  -- if $ptlc(pclassdesc.NAME) =/= $ptlc(ptbytes) \/ pclassdesc.KIND =/= "class" \/ pclassdesc.PARENT = eps
def $ppclass_root_items(pclassdesc_all*, pclassdesc :: pclassdesc_tail*, ptbytes, n) = $ppclass_root_items(pclassdesc_all*, pclassdesc_tail*, ptbytes, n)
  -- if $ptlc(pclassdesc.NAME) = $ptlc(ptbytes) /\ pclassdesc.KIND = "class"
  -- if pclassdesc.PARENT = (ptbytes_parent)
  -- if ~$ppclass_root_ancestry(pclassdesc_all*, ptbytes_parent, $nabs($(n - 1)))
dec $ppclass_external_parent(pclassdesc*, ptbytes, nat) : ptbytes?
def $ppclass_external_parent(pclassdesc_all*, ptbytes, n) = (ptbytes)
  -- if $(n > 0) /\ ~$class_internal(ptbytes)
  -- if $ppclass_prior_any(pclassdesc_all*, ptbytes) = eps
def $ppclass_external_parent(pclassdesc_all*, ptbytes, n) = $ppclass_external_parent(pclassdesc_all*, ptbytes_parent, $nabs($(n - 1)))
  -- if $(n > 0) /\ ~$class_internal(ptbytes)
  -- if $ppclass_prior_any(pclassdesc_all*, ptbytes) = (pclassdesc)
  -- if pclassdesc.KIND = "class"
  -- if pclassdesc.PARENT = (ptbytes_parent)
def $ppclass_external_parent(pclassdesc_all*, ptbytes, n) = eps -- otherwise
dec $ppclass_early_root(pclassdesc*, ptbytes) : bool
def $ppclass_early_root(pclassdesc*, ptbytes) = true
  -- if $throwable_link_kind(ptbytes) =/= eps
def $ppclass_early_root(pclassdesc*, ptbytes) = true
  -- if $throwable_link_kind(ptbytes) = eps
  -- if $ppclass_prior_early(pclassdesc*, ptbytes) = (pclassdesc_parent)
  -- if $ppmethod_root_kind(pclassdesc*, pclassdesc_parent, $nabs($(|pclassdesc*| + 1))) =/= eps
def $ppclass_early_root(pclassdesc*, ptbytes) = false -- otherwise
dec $ppclass_wakeup_order(ppstate, pcpath, pchheader, bool, pmethoddesc*) : ppstate
def $ppclass_wakeup_order(P, pcpath, pchheader, true, pmethoddesc*) = P[.WAKEUPORDER = P.WAKEUPORDER ++ [PPWAKEKNOWN n_diagnostics]]
  -- if pchheader.PARENT = (ptbytes_parent)
  -- if $ppmethod_find(pmethoddesc*, $ptascii("__wakeup")) =/= eps
  -- if $ppclass_early_root(P.CLASSES, ptbytes_parent)
  -- if n_diagnostics = |P.DIAGNOSTICS|
def $ppclass_wakeup_order(P, pcpath, pchheader, false, pmethoddesc*) = P[.WAKEUPORDER = P.WAKEUPORDER ++ [PPWAKEEXTERNAL ptbytes_external]]
  -- if P.EARLY = (pcpath)
  -- if pchheader.PARENT = (ptbytes_parent)
  -- if $ppmethod_find(pmethoddesc*, $ptascii("__wakeup")) =/= eps
  -- if $ppclass_external_parent(P.CLASSES, ptbytes_parent, $nabs($(|P.CLASSES| + 1))) = (ptbytes_external)
def $ppclass_wakeup_order(P, pcpath, pchheader, b, pmethoddesc*) = P -- otherwise
dec $ppwakeup_later(ppwakeuporder*, nat, ppcompletion) : bool
def $ppwakeup_later(eps, n_diagnostics, ppcompletion) = false
def $ppwakeup_later((PPWAKEKNOWN n) :: ppwakeuporder_tail*, n_diagnostics, ppcompletion) = true
  -- if $(n_diagnostics > n) \/ ppcompletion =/= PPCNORMAL
def $ppwakeup_later((PPWAKEKNOWN n) :: ppwakeuporder_tail*, n_diagnostics, PPCNORMAL) = $ppwakeup_later(ppwakeuporder_tail*, n_diagnostics, PPCNORMAL)
  -- if $(n_diagnostics <= n)
def $ppwakeup_later((PPWAKEEXTERNAL ptbytes) :: ppwakeuporder_tail*, n_diagnostics, ppcompletion) = $ppwakeup_later(ppwakeuporder_tail*, n_diagnostics, ppcompletion)
def $ppwakeup_order_finish(P) = $ppunsupported(P[.DIAGNOSTICS = eps], "early rooted wakeup linking before later compilation diagnostics")
  -- if $ppwakeup_later(P.WAKEUPORDER, |P.DIAGNOSTICS|, P.COMPLETION)
def $ppwakeup_order_finish(P) = P -- otherwise
dec $ppclass_earlier_units(pclassdesc*, nat) : pclassdesc*
def $ppclass_earlier_units(eps, n_unit) = eps
def $ppclass_earlier_units(pclassdesc :: pclassdesc_tail*, n_unit) = pclassdesc :: $ppclass_earlier_units(pclassdesc_tail*, n_unit)
  -- if pclassdesc.ORIGIN = PORIGIN n pcpath
  -- if $(n < n_unit)
def $ppclass_earlier_units(pclassdesc :: pclassdesc_tail*, n_unit) = $ppclass_earlier_units(pclassdesc_tail*, n_unit)
  -- if pclassdesc.ORIGIN = PORIGIN n pcpath
  -- if $(n >= n_unit)
dec $ppwakeup_external_root(ppwakeuporder*, pclassdesc*) : bool
def $ppwakeup_external_root(eps, pclassdesc*) = false
def $ppwakeup_external_root((PPWAKEEXTERNAL ptbytes) :: ppwakeuporder_tail*, pclassdesc*) = true
  -- if $ppclass_root_ancestry(pclassdesc*, ptbytes, $nabs($(|pclassdesc*| + 1)))
def $ppwakeup_external_root((PPWAKEEXTERNAL ptbytes) :: ppwakeuporder_tail*, pclassdesc*) = $ppwakeup_external_root(ppwakeuporder_tail*, pclassdesc*)
  -- if ~$ppclass_root_ancestry(pclassdesc*, ptbytes, $nabs($(|pclassdesc*| + 1)))
def $ppwakeup_external_root((PPWAKEKNOWN n) :: ppwakeuporder_tail*, pclassdesc*) = $ppwakeup_external_root(ppwakeuporder_tail*, pclassdesc*)
def $ppwakeup_order_guard(S, P) = $ppunsupported(P[.DIAGNOSTICS = eps], "external potential-root wakeup early publication")
  -- if $ppwakeup_external_root(P.WAKEUPORDER, $ppclass_earlier_units(S.CLASSES, P.FOLD.SOURCE.ID))
def $ppwakeup_order_guard(S, P) = P -- otherwise

dec $ppclass_parent_known(pclassdesc*, ptbytes?) : bool
def $ppclass_parent_known(pclassdesc*, eps) = true
def $ppclass_parent_known(pclassdesc*, (ptbytes)) = ($class_internal(ptbytes) \/ $ppclass_prior_early(pclassdesc*, ptbytes) =/= eps)

dec $ppclass_inherited_early(ppstate, pcpath, pchheader, pmethoddesc*) : bool
def $ppclass_inherited_early(P, pcpath, pchheader, pmethoddesc*) = (P.EARLY = (pcpath) /\ ~$ppclass_early(P.CLASSES, pchheader.NAME) /\ ~$class_internal(pchheader.NAME) /\ $ppclass_parent_known(P.CLASSES, pchheader.PARENT) /\ $ppclass_interfaces(pchheader.INTERFACES, pmethoddesc*) = eps)

dec $ppclass_static_link_error(ppstate, ptbytes) : ppstate
def $ppclass_static_link_error(P, ptbytes) = P[.COMPLETION = PPCABRUPT (STATICBYTES ptbytes P.LOCATION.LINE)]

dec $ppclass_readonly_error(pchheader, ptbytes, bool) : ptbytes
def $ppclass_readonly_error(pchheader, ptbytes, false) = $ptascii("Readonly class ") ++ pchheader.NAME ++ $ptascii(" cannot extend non-readonly class ") ++ ptbytes
  -- if pchheader.READONLY
def $ppclass_readonly_error(pchheader, ptbytes, true) = $ptascii("Non-readonly class ") ++ pchheader.NAME ++ $ptascii(" cannot extend readonly class ") ++ ptbytes
  -- if ~pchheader.READONLY

dec $ppclass_early_link_check(ppstate, pchheader) : ppstate
def $ppclass_early_link_check(P, pchheader) = $ppclass_static_link_error(P, $ptascii("Class ") ++ pchheader.NAME ++ $ptascii(" cannot extend enum ") ++ ptbytes_display)
  -- if pchheader.PARENT = (ptbytes_parent)
  -- if $class_internal_at($class_internal_catalogue(), $ptlc(ptbytes_parent)) = (INTERNAL ptbytes_key ptbytes_display "enum")
def $ppclass_early_link_check(P, pchheader) = $ppclass_static_link_error(P, $ptascii("Class ") ++ pchheader.NAME ++ $ptascii(" cannot extend final class ") ++ ptbytes_display)
  -- if pchheader.PARENT = (ptbytes_parent)
  -- if $class_internal_at($class_internal_catalogue(), $ptlc(ptbytes_parent)) = (INTERNAL ptbytes_key ptbytes_display text_kind)
  -- if text_kind =/= "enum"
  -- if $class_internal_final(ptbytes_parent)
def $ppclass_early_link_check(P, pchheader) = $ppclass_static_link_error(P, $ptascii("Class ") ++ pchheader.NAME ++ $ptascii(" cannot extend ") ++ $ptascii(text_kind) ++ [32] ++ ptbytes_display)
  -- if pchheader.PARENT = (ptbytes_parent)
  -- if $class_internal_at($class_internal_catalogue(), $ptlc(ptbytes_parent)) = (INTERNAL ptbytes_key ptbytes_display text_kind)
  -- if text_kind <- ["interface", "trait"]
  -- if ~$class_internal_final(ptbytes_parent)
def $ppclass_early_link_check(P, pchheader) = $ppclass_static_link_error(P, $ppclass_readonly_error(pchheader, ptbytes_display, false))
  -- if pchheader.PARENT = (ptbytes_parent)
  -- if $class_internal_at($class_internal_catalogue(), $ptlc(ptbytes_parent)) = (INTERNAL ptbytes_key ptbytes_display "class")
  -- if $ptlc(ptbytes_parent) = $ptascii("stdclass")
  -- if pchheader.READONLY
def $ppclass_early_link_check(P, pchheader) = P
  -- if pchheader.PARENT = (ptbytes_parent)
  -- if $ptlc(ptbytes_parent) = $ptascii("stdclass")
  -- if ~pchheader.READONLY
def $ppclass_early_link_check(P, pchheader) = $ppclass_static_link_error(P, $ppclass_readonly_error(pchheader, $ptascii(text_kind), false))
  -- if pchheader.PARENT = (ptbytes_parent)
  -- if $throwable_link_kind(ptbytes_parent) = (text_kind)
  -- if pchheader.READONLY
def $ppclass_early_link_check(P, pchheader) = P
  -- if pchheader.PARENT = (ptbytes_parent)
  -- if $throwable_link_kind(ptbytes_parent) = (text_kind)
  -- if ~pchheader.READONLY
def $ppclass_early_link_check(P, pchheader) = $ppunsupported(P, "internal class inheritance")
  -- if pchheader.PARENT = (ptbytes_parent)
  -- if $class_internal_at($class_internal_catalogue(), $ptlc(ptbytes_parent)) = (INTERNAL ptbytes_key ptbytes_display "class")
  -- if ~$class_internal_final(ptbytes_parent)
  -- if $ptlc(ptbytes_parent) =/= $ptascii("stdclass")
  -- if $throwable_link_kind(ptbytes_parent) = eps
def $ppclass_early_link_check(P, pchheader) = $ppclass_static_link_error(P, $ptascii("Class ") ++ pchheader.NAME ++ $ptascii(" cannot extend interface ") ++ pclassdesc_parent.NAME)
  -- if pchheader.PARENT = (ptbytes_parent)
  -- if ~$class_internal(ptbytes_parent)
  -- if $ppclass_prior_early(P.CLASSES, ptbytes_parent) = (pclassdesc_parent)
  -- if pclassdesc_parent.KIND = "interface"
def $ppclass_early_link_check(P, pchheader) = $ppclass_static_link_error(P, $ptascii("Class ") ++ pchheader.NAME ++ $ptascii(" cannot extend final class ") ++ pclassdesc_parent.NAME)
  -- if pchheader.PARENT = (ptbytes_parent)
  -- if ~$class_internal(ptbytes_parent)
  -- if $ppclass_prior_early(P.CLASSES, ptbytes_parent) = (pclassdesc_parent)
  -- if pclassdesc_parent.KIND = "class"
  -- if pclassdesc_parent.FINAL
def $ppclass_early_link_check(P, pchheader) = $ppclass_static_link_error(P, $ppclass_readonly_error(pchheader, pclassdesc_parent.NAME, pclassdesc_parent.READONLY))
  -- if pchheader.PARENT = (ptbytes_parent)
  -- if ~$class_internal(ptbytes_parent)
  -- if $ppclass_prior_early(P.CLASSES, ptbytes_parent) = (pclassdesc_parent)
  -- if pclassdesc_parent.KIND = "class"
  -- if ~pclassdesc_parent.FINAL
  -- if pchheader.READONLY =/= pclassdesc_parent.READONLY
def $ppclass_early_link_check(P, pchheader) = P
  -- if pchheader.PARENT = (ptbytes_parent)
  -- if ~$class_internal(ptbytes_parent)
  -- if $ppclass_prior_early(P.CLASSES, ptbytes_parent) = (pclassdesc_parent)
  -- if pclassdesc_parent.KIND = "class"
  -- if ~pclassdesc_parent.FINAL
  -- if pchheader.READONLY = pclassdesc_parent.READONLY

dec $ppclass_inherited_add(ppstate, pcpath, pchheader, bool, ppropertydesc*, pmethoddesc*) : ppstate
def $ppclass_inherited_add(P, pcpath, pchheader, b, ppropertydesc*, pmethoddesc*) = P_order[.CLASSES = P.CLASSES ++ [{ ORIGIN PORIGIN P.FOLD.SOURCE.ID pcpath, KIND pchheader.KIND, NAME pchheader.NAME, PARENT pchheader.PARENT, INTERFACES $ppclass_interfaces(pchheader.INTERFACES, pmethoddesc*), PROPERTIES ppropertydesc*, METHODS pmethoddesc*, ABSTRACT pchheader.ABSTRACT, FINAL pchheader.FINAL, READONLY pchheader.READONLY, EARLY b, LINE P.LOCATION.LINE }]]
  -- if P.COMPLETION = PPCNORMAL
  -- if P_order = $ppclass_wakeup_order(P, pcpath, pchheader, b, pmethoddesc*)
def $ppclass_inherited_add(P, pcpath, pchheader, b, ppropertydesc*, pmethoddesc*) = P -- otherwise

dec $ppclass_inherited(ppstate, pcpath, pchheader, ppropertydesc*, pmethoddesc*) : ppstate
dec $ppmethod_early_check(ppstate, pchheader, pmethoddesc*) : ppstate
dec $ppproperty_early_check(ppstate, pchheader, ppropertydesc*) : ppstate
def $ppclass_inherited(P, pcpath, pchheader, ppropertydesc*, pmethoddesc*) = $ppclass_inherited_add($ppmethod_early_check($ppproperty_early_check($ppclass_early_link_check(P, pchheader), pchheader, ppropertydesc*), pchheader, pmethoddesc*), pcpath, pchheader, true, ppropertydesc*, pmethoddesc*)
  -- if $ppclass_inherited_early(P, pcpath, pchheader, pmethoddesc*)
def $ppclass_inherited(P, pcpath, pchheader, ppropertydesc*, pmethoddesc*) = $ppclass_inherited_add(P, pcpath, pchheader, false, ppropertydesc*, pmethoddesc*)
  -- if ~$ppclass_inherited_early(P, pcpath, pchheader, pmethoddesc*)

def $ppclass_result(P, pcpath, PCHOK pchheader pchdiagnostic*) = $ppclass_inherited($ppclass_diagnostics(P, pchdiagnostic*), pcpath, pchheader, eps, eps)
  -- if pchheader.PARENT =/= eps
  -- if pchheader.KIND = "class" /\ pchheader.BODY = SEQUENCE eps
