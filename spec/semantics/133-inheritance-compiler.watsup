;; Sparse final flags from pinned PHP 8.5.10 -n ReflectionClass over the exact 166-name catalogue.
dec $class_internal_final(ptbytes) : bool
def $class_internal_final(ptbytes) = ($ptlc(ptbytes) <- [
  $ptascii("__php_incomplete_class"),
  $ptascii("allowdynamicproperties"),
  $ptascii("attribute"),
  $ptascii("closure"),
  $ptascii("delayedtargetvalidation"),
  $ptascii("deprecated"),
  $ptascii("directory"),
  $ptascii("fiber"),
  $ptascii("fibererror"),
  $ptascii("generator"),
  $ptascii("hashcontext"),
  $ptascii("internaliterator"),
  $ptascii("nodiscard"),
  $ptascii("override"),
  ($ptascii("random") ++ [92] ++ $ptascii("engine") ++ [92] ++ $ptascii("mt19937")),
  ($ptascii("random") ++ [92] ++ $ptascii("engine") ++ [92] ++ $ptascii("pcgoneseq128xslrr64")),
  ($ptascii("random") ++ [92] ++ $ptascii("engine") ++ [92] ++ $ptascii("secure")),
  ($ptascii("random") ++ [92] ++ $ptascii("engine") ++ [92] ++ $ptascii("xoshiro256starstar")),
  ($ptascii("random") ++ [92] ++ $ptascii("randomizer")),
  $ptascii("reflectionfiber"),
  $ptascii("reflectiongenerator"),
  $ptascii("reflectionreference"),
  $ptascii("returntypewillchange"),
  $ptascii("sensitiveparameter"),
  $ptascii("sensitiveparametervalue"),
  $ptascii("streambucket"),
  ($ptascii("uri") ++ [92] ++ $ptascii("rfc3986") ++ [92] ++ $ptascii("uri")),
  ($ptascii("uri") ++ [92] ++ $ptascii("whatwg") ++ [92] ++ $ptascii("url")),
  ($ptascii("uri") ++ [92] ++ $ptascii("whatwg") ++ [92] ++ $ptascii("urlvalidationerror")),
  $ptascii("weakmap"),
  $ptascii("weakreference")
])

;; The checked frontend records the class keyword separately from modifiers
;; and the class name. Missing, duplicate or out-of-range facts reject source.
dec $class_keyword_lines(metadata) : int*
dec $class_keyword_item(metadataEntry) : int*
def $class_keyword_item(MclassKeywordLine z) = [z]
def $class_keyword_item(metadataEntry) = eps -- otherwise
def $class_keyword_lines(eps) = eps
def $class_keyword_lines(metadataEntry :: metadataEntry_tail*) = $class_keyword_item(metadataEntry) ++ $class_keyword_lines(metadataEntry_tail*)

def $class_keyword_line(metadata, NIdentifier (BYTES text) metadata_name) = z
  -- if $class_keyword_lines(metadata) = [z]
  -- if $(z > 0)
  -- if $(z >= $source_line(metadata))
  -- if $(z <= $source_line(metadata_name))
  -- if $(z <= $source_end_line(metadata))
def $class_keyword_line(metadata, phpType3) = 0 -- otherwise

;; Zend links a top-level child during compilation only when its parent is
;; already in the compiler class table. Forward and conditional parents defer.
dec $ppclass_prior_early(pclassdesc*, ptbytes) : pclassdesc?
def $ppclass_prior_early(eps, ptbytes) = eps
def $ppclass_prior_early(pclassdesc :: pclassdesc_tail*, ptbytes) = (pclassdesc)
  -- if pclassdesc.EARLY /\ $ptlc(pclassdesc.NAME) = $ptlc(ptbytes)
def $ppclass_prior_early(pclassdesc :: pclassdesc_tail*, ptbytes) = $ppclass_prior_early(pclassdesc_tail*, ptbytes)
  -- if ~(pclassdesc.EARLY /\ $ptlc(pclassdesc.NAME) = $ptlc(ptbytes))

dec $ppclass_parent_known(pclassdesc*, ptbytes?) : bool
def $ppclass_parent_known(pclassdesc*, eps) = true
def $ppclass_parent_known(pclassdesc*, (ptbytes)) = ($class_internal(ptbytes) \/ $ppclass_prior_early(pclassdesc*, ptbytes) =/= eps)

dec $ppclass_inherited_early(ppstate, pcpath, pchheader, pmethoddesc*) : bool
def $ppclass_inherited_early(P, pcpath, pchheader, pmethoddesc*) = (P.EARLY = (pcpath) /\ ~$pptrait_body_uses(pchheader.BODY) /\ ~$ppclass_early(P.CLASSES, pchheader.NAME) /\ ~$class_internal(pchheader.NAME) /\ $ppclass_parent_known(P.CLASSES, pchheader.PARENT) /\ $ppclass_interfaces(pchheader.INTERFACES, pmethoddesc*) = eps)

dec $ppclass_inherited_add(ppstate, pcpath, pchheader, bool, ppropertydesc*, pmethoddesc*) : ppstate
def $ppclass_inherited_add(P, pcpath, pchheader, b, ppropertydesc*, pmethoddesc*) = P[.CLASSES = P.CLASSES ++ [{ ORIGIN PORIGIN P.FOLD.SOURCE.ID pcpath, KIND pchheader.KIND, NAME pchheader.NAME, PARENT pchheader.PARENT, INTERFACES $ppclass_interfaces(pchheader.INTERFACES, pmethoddesc*), PROPERTIES ppropertydesc*, METHODS pmethoddesc*, CONSTANTS $ppclass_constants(P.CLASSCONSTANTS, PORIGIN P.FOLD.SOURCE.ID pcpath), ABSTRACT pchheader.ABSTRACT, FINAL pchheader.FINAL, READONLY pchheader.READONLY, EARLY b, LINE P.LOCATION.LINE }]]
  -- if P.COMPLETION = PPCNORMAL
def $ppclass_inherited_add(P, pcpath, pchheader, b, ppropertydesc*, pmethoddesc*) = P -- otherwise

dec $pppromotion_override_unbound(ppstate, pchheader, ppropertydesc*, pmethoddesc*) : ppstate
dec $pppromotion_override_unbound_properties(ppstate, pchheader, ppropertydesc*) : ppstate
dec $pppromotion_override_source(ppstate, pchheader, ppropertydesc) : bool
dec $ppclass_inherited(ppstate, pcpath, pchheader, ppropertydesc*, pmethoddesc*) : ppstate
def $ppclass_inherited(P, pcpath, pchheader, ppropertydesc*, pmethoddesc*) = $ppclass_inherited_add($pppromotion_override_unbound(P, pchheader, ppropertydesc*, pmethoddesc*), pcpath, pchheader, true, ppropertydesc*, pmethoddesc*)
  -- if $ppclass_inherited_early(P, pcpath, pchheader, pmethoddesc*)
def $ppclass_inherited(P, pcpath, pchheader, ppropertydesc*, pmethoddesc*) = $ppclass_inherited_add($pppromotion_override_unbound(P, pchheader, ppropertydesc*, pmethoddesc*), pcpath, pchheader, false, ppropertydesc*, pmethoddesc*)
  -- if ~$ppclass_inherited_early(P, pcpath, pchheader, pmethoddesc*)

;; Zend also links simple no-parent classes while compiling conditional and
;; function-local declarations. Their missing Override error precedes execution.
def $pppromotion_override_unbound(P, pchheader, ppropertydesc*, pmethoddesc*) = $pppromotion_override_unbound_properties(P, pchheader, ppropertydesc*)
  -- if P.COMPLETION = PPCNORMAL /\ pchheader.KIND = "class" /\ pchheader.PARENT = eps /\ $ppclass_interfaces(pchheader.INTERFACES, pmethoddesc*) = eps /\ ~$pptrait_body_uses(pchheader.BODY)
def $pppromotion_override_unbound(P, pchheader, ppropertydesc*, pmethoddesc*) = P -- otherwise
def $pppromotion_override_unbound_properties(P, pchheader, eps) = P
def $pppromotion_override_unbound_properties(P, pchheader, ppropertydesc :: ppropertydesc_tail*) = $ppconstant_error(P, pchheader.NAME ++ $ptascii("::$") ++ ppropertydesc.NAME ++ $ptascii(" has #[\\Override] attribute, but no matching parent property exists"), P.LOCATION.LINE)
  -- if $pppromotion_override_source(P, pchheader, ppropertydesc)
def $pppromotion_override_unbound_properties(P, pchheader, ppropertydesc :: ppropertydesc_tail*) = $pppromotion_override_unbound_properties(P, pchheader, ppropertydesc_tail*)
  -- if ~$pppromotion_override_source(P, pchheader, ppropertydesc)
def $pppromotion_override_source(P, pchheader, ppropertydesc) = true
  -- if $origin_node([P.FOLD.SOURCE], ppropertydesc.ORIGIN) = (NParam phpType14 phpType24 phpType18 phpType4_ref phpType4_var phpType10 phpType5 phpType37 metadata)
  -- if $pslower(NParam phpType14 phpType24 phpType18 phpType4_ref phpType4_var phpType10 phpType5 phpType37 metadata) = PSINPUT psraw
  -- if psraw.FLAGS =/= 0 /\ psraw.EXTRA = PSPARAMETERATTRIBUTES phpType14
  -- if psraw.NAME = ppropertydesc.NAME /\ psraw.LINE = ppropertydesc.LINE
  -- if $pspromotion_override_attribute($ppproperty_context(P, pchheader, psraw.NAME, psraw.LINE), phpType14)
def $pppromotion_override_source(P, pchheader, ppropertydesc) = false -- otherwise

def $ppclass_result_body(P, pcpath, PCHOK pchheader pchdiagnostic*) = $ppclass_inherited($ppclass_diagnostics(P, pchdiagnostic*), pcpath, pchheader, eps, eps)
  -- if pchheader.PARENT =/= eps
  -- if pchheader.KIND = "class" /\ pchheader.BODY = SEQUENCE eps
