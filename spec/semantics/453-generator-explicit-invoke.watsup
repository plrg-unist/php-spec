def $task_nodes(GENERATOR_INVOKE_RESULT pconfigcall true pvalue) = [HOBJECT n_capture] ++ $named_slots_roots(pconfigcall.SENT) ++ $value_nodes(pvalue)
  -- if pconfigcall.KIND = INTRINSIC_GENERATOR_METHOD text (pgeneratormethodselection)
  -- if pgeneratormethodselection.CAPTURE = (n_capture)
def $task_nodes(GENERATOR_INVOKE_RESULT pconfigcall false pvalue) = [HOBJECT n_capture] ++ $value_nodes(pvalue)
  -- if pconfigcall.KIND = INTRINSIC_GENERATOR_METHOD text (pgeneratormethodselection)
  -- if pgeneratormethodselection.CAPTURE = (n_capture)
def $task_nodes(GENERATOR_INVOKE_RETURN pconfigcall pvalue) = $value_nodes(pvalue)

