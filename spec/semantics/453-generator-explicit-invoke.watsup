def $generator_operation_trace(S, pgeneratorop) = [ptraceframe, ptraceframe_outer]
  -- if $generator_capture_wrapper_site(S, pgeneratorop.SITE)
  -- if pgeneratorop.SELECTION = (pgeneratormethodselection)
  -- if pgeneratormethodselection.CAPTURE = (n_capture)
