def $fiber_marker(GENERATOR_INVOKE_RESULT pconfigcall b) = true

;; The inner result is used by the wrapper. Its outer argv goes first, then
;; the unused/abrupt outer result, then the remaining Closure owner.
dec $generator_invoke_discard_result(pstate, pconfigcall) : bool
