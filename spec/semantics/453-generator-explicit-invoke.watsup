  -- if ~$ppfirstclass(phpType7*)
  -- if $method_source_name(phpType20, $ptascii("__invoke"))
def $generator_capture_wrapper_site(S, porigin) = true
  -- if $origin_node(S.SOURCES, porigin) = (NExprNullsafeMethodCall expression phpType20 (SEQUENCE phpType7*) metadata)
  -- if ~$ppfirstclass(phpType7*)
  -- if $method_source_name(phpType20, $ptascii("__invoke"))
def $generator_capture_wrapper_site(S, porigin) = false -- otherwise

