rule PhpStep/parameter-string-store: S ~> $write_cell_checked(S, pparameterstring.CELL, PSTRING n_text*, pparameterstring.LINE)[.TODO = $default_next(S, pfunction, $(pparameterstring.INDEX + 1))][.ORIGIN = (pfunction.ORIGIN)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
