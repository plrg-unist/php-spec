;; A weak by-value return may call a source __toString after its expression has
;; finished. Its saved return instruction owns the callback and the original
;; object until either the checked string or a chained TypeError is produced.
def $typed_return_source(S, PORIGIN n pcpath, z) = true
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (NStmtReturn expression metadata)
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_expression(pcode.EXPRESSIONS, pcpath) = ((z, false))
def $typed_return_source(S, porigin_site, z) = true
  -- if $origin_node(S.SOURCES, porigin_site) = (NExprArrowFunction phpType14 phpType4_static phpType4_ref phpType16 phpType18 expression metadata)
  -- if $function_at($all_functions(S), porigin_site) = (pfunction)
  -- if $arrow_line(pfunction.CODE.EXPRESSIONS, pfunction.BODY) = (z)
def $typed_return_source(S, porigin_site, z) = false -- otherwise

