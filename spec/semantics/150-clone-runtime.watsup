def $clone_sent_shape(S, pclonecall) = false -- otherwise
dec $clone_call_valid(pstate, pclonecall) : bool
def $clone_call_valid(S, pclonecall) = true
  -- if S.ORIGIN = (pclonecall.SITE)
  -- if $clone_selected_valid(S, pclonecall)
