def $clone_selected_valid(S, pclonecall) = false -- otherwise
dec $clone_slots_valid(pnamedslot*, nat, nat, bool) : bool
def $clone_slots_valid(eps, n, n_total, b) = true
def $clone_slots_valid((NAMED_SENT (KNOWN pvalue)) :: pnamedslot*, n, n_total, b) = $clone_slots_valid(pnamedslot*, $(n + 1), n_total, b)
def $clone_slots_valid(NAMED_HOLE :: pnamedslot*, 0, 2, true) = $clone_slots_valid(pnamedslot*, 1, 2, true)
def $clone_slots_valid(pnamedslot*, n, n_total, b) = false -- otherwise
dec $clone_slot_shape(pnamedslot*) : bool*
def $clone_slot_shape(eps) = eps
def $clone_slot_shape(NAMED_HOLE :: pnamedslot*) = false :: $clone_slot_shape(pnamedslot*)
def $clone_slot_shape((NAMED_SENT poperand) :: pnamedslot*) = true :: $clone_slot_shape(pnamedslot*)
dec $clone_source_prefix(phpType7*, pnamedslot*, bool) : (pnamedslot*, bool)?
def $clone_source_prefix(eps, pnamedslot*, b) = ((pnamedslot*, b))
def $clone_source_prefix((NArg phpType3 expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType7*, pnamedslot*, b) = $clone_source_prefix(phpType7*, $named_slot_set(pnamedslot*, n, KNOWN PNULL), (b \/ preqbytes? =/= eps))
