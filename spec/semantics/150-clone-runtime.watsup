def $clone_unpack_valid(S, pclonecall, poperand, n_cursor) = false -- otherwise
def $call_task_valid(S, CLONE_UNPACK_NEXT pclonecall poperand n_cursor) = $clone_unpack_valid(S, pclonecall, poperand, n_cursor)
def $clone_update_base_valid(S, pclonecall, n_object, n_array, n_cursor) = true
