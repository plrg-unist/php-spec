def $clone_invoke_valid(S, pclonecall) = false -- otherwise
def $call_task_valid(S, CLONE_INVOKE pclonecall) = $clone_invoke_valid(S, pclonecall)
dec $clone_unpack_valid(pstate, pclonecall, poperand, nat) : bool
