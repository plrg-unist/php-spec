def $clone_call_valid(S, pclonecall) = false -- otherwise
dec $clone_pending_valid(pstate, pclonecall, bool) : bool
def $clone_pending_valid(S, pclonecall, b) = true
  -- if $clone_call_valid(S, pclonecall)
  -- if $clone_sent_shape(S, pclonecall)
  -- if $intrinsic_argument(S, pclonecall.SITE, pclonecall.INDEX) = ((expression, b, preqbytes?, porigin, z))
def $clone_pending_valid(S, pclonecall, b) = false -- otherwise
def $call_task_valid(S, CLONE_ARGS pclonecall) = ($clone_call_valid(S, pclonecall) /\ $clone_sent_shape(S, pclonecall))
def $call_task_valid(S, CLONE_SEND pclonecall) = $clone_pending_valid(S, pclonecall, false)
def $call_task_valid(S, CLONE_UNPACK_PREP pclonecall) = $clone_pending_valid(S, pclonecall, true)
dec $clone_invoke_valid(pstate, pclonecall) : bool
def $clone_invoke_valid(S, pclonecall) = true
