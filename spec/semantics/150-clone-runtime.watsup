  -- if (HARRAY n_array) <- S.ALLOCATIONS
  -- if $(n_cursor <= |S.ARRAYS[n_array].ITEMS|)
def $clone_update_base_valid(S, pclonecall, n_object, n_array, n_cursor) = false -- otherwise
def $clone_update_valid(S, pclonecall, n_object, n_array, n_cursor) = true
  -- if $clone_update_base_valid(S, pclonecall, n_object, n_array, n_cursor)
  -- if $clone_update_prefix_valid(S, n_object, S.ARRAYS[n_array].ITEMS[0:n_cursor], pclonecall.LINE)
def $clone_update_valid(S, pclonecall, n_object, n_array, n_cursor) = false -- otherwise
def $call_task_valid(S, CLONE_UPDATE pclonecall n_object n_array n_cursor) = $clone_update_valid(S, pclonecall, n_object, n_array, n_cursor)

dec $clone_pending_result_valid(pstate, pclonecall, bool) : bool
def $clone_pending_result_valid(S, pclonecall, b_unpack) = true
  -- if $intrinsic_argument(S, pclonecall.SITE, pclonecall.INDEX) = ((expression, b_unpack, preqbytes?, PORIGIN n pcpath, z))
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $source_unit(S.SOURCES, n) = (pcunit)
  -- if $ppunpack_class(pcode, pcunit, pcpath) = (UNPACK_CV)
  -- if $exit_cv_operand(pcode, pcunit, pcpath) = (S.RESULT)
def $clone_pending_result_valid(S, pclonecall, b_unpack) = true
  -- if $intrinsic_argument(S, pclonecall.SITE, pclonecall.INDEX) = ((expression, b_unpack, preqbytes?, PORIGIN n pcpath, z))
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $source_unit(S.SOURCES, n) = (pcunit)
  -- if $ppunpack_class(pcode, pcunit, pcpath) = (punpackclass)
  -- if punpackclass =/= UNPACK_CV
  -- if $unpack_owned(S, S.RESULT)
def $clone_pending_result_valid(S, pclonecall, b_unpack) = false -- otherwise
def $clone_result_valid(S) = $clone_result_valid(S[.ORIGIN = (porigin)][.TODO = ptask :: ptask_tail*])
  -- if S.TODO = (AT porigin ptask) :: ptask_tail*
def $clone_result_valid(S) = $clone_result_valid(S[.ORIGIN = porigin?][.TODO = ptask_tail*])
  -- if S.TODO = (ORIGIN_RETURN porigin?) :: ptask_tail*
def $clone_result_valid(S) = $clone_pending_result_valid(S, pclonecall, false)
  -- if S.TODO = (CLONE_SEND pclonecall) :: ptask_tail*
def $clone_result_valid(S) = $clone_pending_result_valid(S, pclonecall, true)
  -- if S.TODO = (CLONE_UNPACK_PREP pclonecall) :: ptask_tail*
def $clone_result_valid(S) = true -- otherwise

def $clone_thrown(THROWN text preqbytes z) = true
def $clone_thrown(pcompletion) = false -- otherwise

;; Replaying the consumed prefix only validates that no mandatory failure was
;; skipped. Its state and diagnostics are discarded, never emitted a second time.
def $clone_update_prefix_valid(S, n, eps, z) = true
def $clone_update_prefix_valid(S, n, (ENTRY pkey pitem) :: pentry*, z) = $clone_update_prefix_valid(S_written, n, pentry*, z)
  -- if ~$clone_update_ref(S, pitem)
  -- if S_written = $clone_update_write(S, n, $clone_update_key(pkey), $entry_value(S, pitem), z)
  -- if S_written.COMPLETION = NORMAL
def $clone_update_prefix_valid(S, n, pentry*, z) = false -- otherwise
def $clone_same_kind(STDINSTANCE, STDINSTANCE) = true
def $clone_same_kind(INSTANCE porigin, INSTANCE porigin) = true
def $clone_same_kind(NAMEDCLOSURE porigin, NAMEDCLOSURE porigin) = true
def $clone_same_kind(REALCLOSURE porigin pitem_left* pstaticcell_left*, REALCLOSURE porigin pitem_right* pstaticcell_right*) = true
def $clone_same_kind(INTRINSICCLOSURE pintrinsic, INTRINSICCLOSURE pintrinsic) = true
def $clone_same_kind(pobject_left, pobject_right) = false -- otherwise

;; No callbacks or source evaluation occur between unpack steps. Retain the
;; array and initial receiver, and recompute the completed prefix without effects.
def $clone_unpack_prefix(S, pclonecall, eps) = (pclonecall)
def $clone_unpack_prefix(S, pclonecall, (ENTRY pkey pitem) :: pentry*) = $clone_unpack_prefix(S, $clone_sent(pclonecall, KNOWN $entry_value(S, pitem), preqbytes?), pentry*)
  -- if preqbytes? = $exit_key_name(pkey)
  -- if S_checked = $clone_send_check(S, pclonecall, preqbytes?, pclonecall.LINE)
  -- if S_checked.COMPLETION = NORMAL
def $clone_unpack_prefix(S, pclonecall, pentry*) = eps -- otherwise
