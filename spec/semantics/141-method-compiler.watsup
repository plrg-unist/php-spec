dec $ppmethod_scope_context(pchheader) : ptscope
dec $ppmethod_flags(int, text) : bool
dec $ppmethod_supported_signature(pssignature, text) : bool
;; Class-owned method descriptors never enter the global function registry.
syntax ppmembers = PPMEMBERS ppstate ppropertydesc* pmethoddesc*
dec $ppmethod_members(statement*, bool) : bool
dec $ppmember_groups(ppstate, pcpath, nat, statement*, ppropertydesc*, pmethoddesc*, pchheader) : ppmembers
def $ppmember_path(pcpath, pchheader, n) = pcpath ++ [PCFIELD 3, PCINDEX n]
  -- if pchheader.KIND = "interface"
def $ppmember_path(pcpath, pchheader, n) = pcpath ++ [PCFIELD 2, PCINDEX n]
  -- if pchheader.KIND = "trait"
def $ppmember_path(pcpath, pchheader, n) = pcpath ++ [PCFIELD 5, PCINDEX n]
  -- if pchheader.KIND = "class"
dec $ppmethod_at(pmethoddesc*, ptbytes) : bool
dec $ppmethod_magic(ptbytes) : bool
dec $ppmethod_tostring(ptbytes) : bool
dec $ppmethod_get(int, ptbytes) : bool
dec $ppmethod_get_signature(pssignature) : bool
dec $ppmethod_returns(ptbytes, pssignature) : pssignature
dec $ppmethod_visibility(int) : ppropertyvisibility
dec $ppmethod_warning(ppstate, int, ptbytes) : ppstate
dec $ppmethod_visibility_warning(ppstate, int, ptbytes, ptbytes, nat) : ppstate
dec $ppmethod_return_valid(ptbranch*) : bool
dec $ppmethod_wakeup_args_valid(psparam*) : bool
dec $ppmethod_wakeup_return_valid(ptbranch*) : bool
dec $declaration_method_source_line(metadata) : int
dec $declaration_method_keyword_line(metadata, metadata) : int
dec $ppmethod_line(metadata) : nat
def $ppmethod_line(metadata) = $nabs($declaration_method_source_line(metadata))
dec $ppmethod_context(ppstate, pchheader, ptbytes, int) : ptcontext
dec $ppmethod_prechecked(int, ptbytes, phpType47, pchheader) : bool
dec $ppmethod_header_ready(int, phpType47, pchheader) : bool
dec $iterator_notice_attributes(plenv, phpType14) : bool
dec $ppmethod_one(ppstate, pcpath, statement, ppropertydesc*, pmethoddesc*, pchheader) : ppmembers
dec $ppmethod_checked(ppstate, pcpath, int, bool, ptbytes, phpType16, phpType18, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader) : ppmembers
dec $ppmethod_begin(ppstate, pcpath, int, bool, ptbytes, phpType16, phpType18, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader) : ppmembers
dec $ppmethod_default_path(pcpath, nat) : pcpath
dec $ppmethod_default_parameter(ppstate, pcpath, nat) : ppstate
dec $ppmethod_defaults(ppstate, pcpath, psparam*, nat) : pdefault*
dec $ppmethod_step(ppstate, ppstate, pcpath, int, ptbytes, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader, psprogress) : ppmembers
dec $ppmethod_request(ppstate, ppstate, pcpath, int, ptbytes, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader, pscontinuation) : ppmembers
dec $ppmethod_ready(ppstate, ppstate, pcpath, int, ptbytes, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader, pscontinuation, expression) : ppmembers
dec $ppmethod_parameter(ppstate, ppstate, pcpath, int, ptbytes, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader, pscontinuation, psoneresult) : ppmembers
