dec $pmethod_user(pmethoddesc, pclassdesc, ptbytes) : pmmethod
dec $pmethod_independent_private(pmethoddesc) : bool
dec $pmethod_static_issue(pclassdesc, pmethoddesc, pclassdesc, pmethoddesc) : ptbytes?
dec $pmethod_visibility_issue(pclassdesc, pmethoddesc, pclassdesc, pmethoddesc) : ptbytes?
dec $pmethod_scope(pclassdesc, ptbytes*) : pvclass
dec $ppmethod_functions(pmethoddesc*) : pfunction*
def $ppmethod_functions(eps) = eps
def $ppmethod_functions(pmethoddesc :: pmethoddesc_tail*) = pmethoddesc.FUNCTION :: $ppmethod_functions(pmethoddesc_tail*)
def $ppclass_method_functions(eps) = eps
def $ppclass_method_functions(pclassdesc :: pclassdesc_tail*) = $ppmethod_functions(pclassdesc.METHODS) ++ $ppclass_method_functions(pclassdesc_tail*)
dec $pmethod_parent_name(ptbytes?) : ptbytes
def $pmethod_parent_name(eps) = eps
def $pmethod_parent_name((ptbytes)) = ptbytes
def $pmethod_user(pmethoddesc, pclassdesc, ptbytes_file) = { OWNER pclassdesc.NAME, NAME pmethoddesc.NAME, SIGNATURE pmethoddesc.FUNCTION.SIGNATURE, CONTEXT { NAMESPACE pmethoddesc.FUNCTION.ENV.NAMESPACE, IMPORTS pmethoddesc.FUNCTION.ENV.CLASSES, SCOPE PTKNOWN pclassdesc.NAME pclassdesc.PARENT, POSITION PTRETURN, OWNER pclassdesc.NAME, MEMBER pmethoddesc.NAME, FILE ptbytes_file, LINE pmethoddesc.FUNCTION.LINE } }
def $pmethod_scope(pclassdesc, ptbytes_ancestors*) = { NAME pclassdesc.NAME, PARENT $pmethod_parent_name(pclassdesc.PARENT), ANCESTORS ptbytes_ancestors*, FINAL pclassdesc.FINAL }
def $pmethod_independent_private(pmethoddesc) = (pmethoddesc.VISIBILITY = PROPERTY_PRIVATE /\ ~pmethoddesc.ABSTRACT /\ $ptlc(pmethoddesc.NAME) =/= $ptascii("__construct"))
def $pmethod_static_issue(pclassdesc_child, pmethoddesc_child, pclassdesc_parent, pmethoddesc_parent) = ($ptascii("Cannot make static method ") ++ pclassdesc_parent.NAME ++ $ptascii("::") ++ pmethoddesc_parent.NAME ++ $ptascii("() non static in class ") ++ pclassdesc_child.NAME)
  -- if pmethoddesc_parent.STATIC /\ ~pmethoddesc_child.STATIC
def $pmethod_static_issue(pclassdesc_child, pmethoddesc_child, pclassdesc_parent, pmethoddesc_parent) = ($ptascii("Cannot make non static method ") ++ pclassdesc_parent.NAME ++ $ptascii("::") ++ pmethoddesc_parent.NAME ++ $ptascii("() static in class ") ++ pclassdesc_child.NAME)
  -- if ~pmethoddesc_parent.STATIC /\ pmethoddesc_child.STATIC
def $pmethod_static_issue(pclassdesc_child, pmethoddesc_child, pclassdesc_parent, pmethoddesc_parent) = eps -- otherwise
def $pmethod_visibility_issue(pclassdesc_child, pmethoddesc_child, pclassdesc_parent, pmethoddesc_parent) = ($ptascii("Access level to ") ++ pclassdesc_child.NAME ++ $ptascii("::") ++ pmethoddesc_child.NAME ++ $ptascii("() must be public (as in class ") ++ pclassdesc_parent.NAME ++ [41])
  -- if pmethoddesc_parent.VISIBILITY = PROPERTY_PUBLIC /\ pmethoddesc_child.VISIBILITY =/= PROPERTY_PUBLIC
def $pmethod_visibility_issue(pclassdesc_child, pmethoddesc_child, pclassdesc_parent, pmethoddesc_parent) = ($ptascii("Access level to ") ++ pclassdesc_child.NAME ++ $ptascii("::") ++ pmethoddesc_child.NAME ++ $ptascii("() must be protected (as in class ") ++ pclassdesc_parent.NAME ++ $ptascii(") or weaker"))
  -- if pmethoddesc_parent.VISIBILITY = PROPERTY_PROTECTED /\ pmethoddesc_child.VISIBILITY = PROPERTY_PRIVATE
def $pmethod_visibility_issue(pclassdesc_child, pmethoddesc_child, pclassdesc_parent, pmethoddesc_parent) = eps -- otherwise

def $ppmethod_body(SEQUENCE statement*) = $ppmethod_members(statement*, false)
def $ppmethod_body(phpType23) = false -- otherwise
def $ppmethod_members(eps, b) = b
def $ppmethod_members((NStmtProperty phpType14 phpType24 phpType18 phpType56 phpType37 metadata) :: statement_tail*, b) = $ppmethod_members(statement_tail*, b)
def $ppmethod_members((NStmtClassMethod phpType14 phpType24 phpType4 phpType11 phpType16 phpType18 phpType47 metadata) :: statement_tail*, b) = $ppmethod_members(statement_tail*, true)
def $ppmethod_members((NStmtClassConst phpType14 phpType24 phpType18 phpType45 metadata) :: statement_tail*, b) = $ppmethod_members(statement_tail*, true)
def $ppmethod_members(statement*, b) = false -- otherwise

def $ppmember_groups(P, pcpath, n, statement*, ppropertydesc*, pmethoddesc*, pchheader) = PPMEMBERS P ppropertydesc* pmethoddesc*
  -- if P.COMPLETION =/= PPCNORMAL
def $ppmember_groups(P, pcpath, n, eps, ppropertydesc*, pmethoddesc*, pchheader) = PPMEMBERS P ppropertydesc* pmethoddesc*
  -- if P.COMPLETION = PPCNORMAL
def $ppmember_groups(P, pcpath, n, (NStmtProperty (SEQUENCE eps) (INTEGER flags) phpType18 (SEQUENCE phpType57*) (SEQUENCE eps) metadata) :: statement_tail*, ppropertydesc*, pmethoddesc*, pchheader) = $ppmember_groups(P_next, pcpath, $(n + 1), statement_tail*, ppropertydesc_next*, pmethoddesc*, pchheader)
  -- if P.COMPLETION = PPCNORMAL
  -- if pchheader.KIND = "class" \/ pchheader.KIND = "trait"
  -- if $ppproperty_group_line_valid(P, metadata)
  -- if PPROPERTIES P_next ppropertydesc_next* = $ppproperty_group($pplocate(P, $ppmember_path(pcpath, pchheader, n), $source_line(metadata)), $ppmember_path(pcpath, pchheader, n), flags, phpType18, phpType57*, ppropertydesc*, pchheader, $source_line(metadata))
def $ppmember_groups(P, pcpath, n, (NStmtClassMethod phpType14 phpType24 phpType4 phpType11 phpType16 phpType18 phpType47 metadata) :: statement_tail*, ppropertydesc*, pmethoddesc*, pchheader) = $ppmember_groups(P_next, pcpath, $(n + 1), statement_tail*, ppropertydesc_next*, pmethoddesc_next*, pchheader)
  -- if P.COMPLETION = PPCNORMAL
  -- if PPMEMBERS P_next ppropertydesc_next* pmethoddesc_next* = $ppmethod_one(P, $ppmember_path(pcpath, pchheader, n), NStmtClassMethod phpType14 phpType24 phpType4 phpType11 phpType16 phpType18 phpType47 metadata, ppropertydesc*, pmethoddesc*, pchheader)
def $ppmember_groups(P, pcpath, n, statement*, ppropertydesc*, pmethoddesc*, pchheader) = PPMEMBERS ($ppunsupported(P, "class members")) ppropertydesc* pmethoddesc* -- otherwise

def $ppmethod_at(eps, ptbytes) = false
def $ppmethod_at(pmethoddesc :: pmethoddesc_tail*, ptbytes) = true
  -- if $ptlc(pmethoddesc.NAME) = $ptlc(ptbytes)
def $ppmethod_at(pmethoddesc :: pmethoddesc_tail*, ptbytes) = $ppmethod_at(pmethoddesc_tail*, ptbytes)
  -- if $ptlc(pmethoddesc.NAME) =/= $ptlc(ptbytes)
def $ppmethod_magic(ptbytes) = ($ptlc(ptbytes) <- [$ptascii("__destruct"), $ptascii("__invoke"), $ptascii("__tostring"), $ptascii("__get"), $ptascii("__set"), $ptascii("__isset"), $ptascii("__unset"), $ptascii("__call"), $ptascii("__callstatic"), $ptascii("__sleep"), $ptascii("__wakeup"), $ptascii("__serialize"), $ptascii("__unserialize"), $ptascii("__clone"), $ptascii("__debuginfo"), $ptascii("__set_state")])
def $ppmethod_get(flags, ptbytes) = (flags <- [0, 1, 32, 33] /\ $ptlc(ptbytes) = $ptascii("__get"))
def $ppmethod_get_signature(pssignature) = true
  -- if pssignature.PARAMETERS = [psparam]
  -- if psparam.TYPE = eps /\ ~psparam.BYREF /\ ~psparam.VARIADIC /\ psparam.REQUIRED /\ psparam.DEFAULT = PSNONE
  -- if pssignature.RETURNS = eps
def $ppmethod_get_signature(pssignature) = false -- otherwise
def $ppmethod_tostring(ptbytes) = ($ptlc(ptbytes) = $ptascii("__tostring"))
def $ppmethod_returns(ptbytes, pssignature) = pssignature[.RETURNS = [(PTBRANCH ([PTBUILTIN "string"]))]]
  -- if $ppmethod_tostring(ptbytes) /\ pssignature.RETURNS = eps
def $ppmethod_returns(ptbytes, pssignature) = pssignature -- otherwise
def $ppmethod_visibility(flags) = PROPERTY_PRIVATE -- if $ppproperty_flag(flags, 4)
def $ppmethod_visibility(flags) = PROPERTY_PROTECTED -- if $ppproperty_flag(flags, 2)
def $ppmethod_visibility(flags) = PROPERTY_PUBLIC -- otherwise
def $ppmethod_warning(P, flags, ptbytes) = P[.DIAGNOSTICS = P.DIAGNOSTICS ++ [PLDIAGNOSTIC "warning" "private-final-method" eps P.LOCATION]]
  -- if $ppproperty_flag(flags, 4) /\ $ppproperty_flag(flags, 32) /\ $ptlc(ptbytes) =/= $ptascii("__construct")
def $ppmethod_warning(P, flags, ptbytes) = P -- otherwise
def $ppmethod_visibility_warning(P, flags, ptbytes, ptbytes_class, n_line) = P[.DIAGNOSTICS = P.DIAGNOSTICS ++ [PLDIAGNOSTIC "warning" "class-message" ([$ptascii("The magic method ") ++ ptbytes_class ++ $ptascii("::__toString() must have public visibility")]) (P.LOCATION[.LINE = n_line])]]
  -- if $ppmethod_tostring(ptbytes) /\ $ppmethod_visibility(flags) =/= PROPERTY_PUBLIC
def $ppmethod_visibility_warning(P, flags, ptbytes, ptbytes_class, n_line) = P[.DIAGNOSTICS = P.DIAGNOSTICS ++ [PLDIAGNOSTIC "warning" "class-message" ([$ptascii("The magic method ") ++ ptbytes_class ++ $ptascii("::") ++ ptbytes ++ $ptascii("() must have public visibility")]) (P.LOCATION[.LINE = n_line])]]
  -- if $ptlc(ptbytes) <- [$ptascii("__wakeup"), $ptascii("__invoke")] /\ $ppmethod_visibility(flags) =/= PROPERTY_PUBLIC
def $ppmethod_visibility_warning(P, flags, ptbytes, ptbytes_class, n_line) = P -- otherwise
def $ppmethod_return_valid(eps) = true
def $ppmethod_return_valid([(PTBRANCH ([PTBUILTIN "string"]))]) = true
def $ppmethod_return_valid([(PTBRANCH ([PTBUILTIN "never"]))]) = true
def $ppmethod_return_valid(ptbranch*) = false -- otherwise
def $ppmethod_wakeup_args_valid(eps) = true
def $ppmethod_wakeup_args_valid([psparam]) = psparam.VARIADIC
def $ppmethod_wakeup_args_valid(psparam*) = false -- otherwise
def $ppmethod_wakeup_return_valid(eps) = true
def $ppmethod_wakeup_return_valid([(PTBRANCH ([PTBUILTIN "void"]))]) = true
def $ppmethod_wakeup_return_valid([(PTBRANCH ([PTBUILTIN "never"]))]) = true
def $ppmethod_wakeup_return_valid(ptbranch*) = false -- otherwise
def $plmessage(PLDIAGNOSTIC "warning" "private-final-method" eps pllocation) = $ptascii("Private methods cannot be final as they are never overridden by other classes")

def $ppmethod_context(P, pchheader, ptbytes, z) = { NAMESPACE P.ENV.NAMESPACE, IMPORTS P.ENV.CLASSES, SCOPE $ppmethod_scope_context(pchheader), POSITION PTRETURN, OWNER pchheader.NAME, MEMBER ptbytes, FILE P.LOCATION.FILE, LINE $nabs(z) }
def $ppmethod_header_ready(flags, phpType47, pchheader) = (~$ppproperty_flag(flags, 64) /\ ~($ppproperty_flag(flags, 16) /\ $ppproperty_flag(flags, 32)) /\ (($ppproperty_flag(flags, 16) /\ (pchheader.ABSTRACT \/ pchheader.KIND = "trait") /\ (~$ppproperty_flag(flags, 4) \/ pchheader.KIND = "trait") /\ phpType47 = ABSENT) \/ (~$ppproperty_flag(flags, 16) /\ phpType47 =/= ABSENT)))
def $ppmethod_prechecked(flags, ptbytes, phpType47, pchheader) = ($ppmethod_header_ready(flags, phpType47, pchheader) /\ ~($ppproperty_flag(flags, 8) /\ $ptlc(ptbytes) = $ptascii("__construct")))
dec $ppmethod_public_invoke(int, ptbytes) : bool
def $ppmethod_public_invoke(flags, ptbytes) = ($ptlc(ptbytes) = $ptascii("__invoke") /\ flags <- [0,1,16,17,32,33])
dec $ppmethod_invoke(int, ptbytes) : bool
def $ppmethod_invoke(flags, ptbytes) = ($ptlc(ptbytes) = $ptascii("__invoke") /\ flags <- [0,1,2,4,8,9,10,12,16,17,18,24,25,26,32,33,34,36,40,41,42,44])

def $ppmethod_one(P, pcpath, NStmtClassMethod phpType14 (INTEGER flags) (BOOLEAN b) (NIdentifier (BYTES text) metadata_name) phpType16 phpType18 phpType47 metadata, ppropertydesc*, pmethoddesc*, pchheader) = $ppmethod_checked($pplocate(P, pcpath, z_line), pcpath, flags, b, $base64(text), phpType16, phpType18, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader)
  -- if z_line = $declaration_method_keyword_line(metadata, metadata_name)
  -- if $(z_line > 0)
  -- if $iterator_notice_attributes(P.ENV, phpType14)
  -- if pchheader.KIND = "class" \/ pchheader.KIND = "trait"
def $ppmethod_one(P, pcpath, statement, ppropertydesc*, pmethoddesc*, pchheader) = PPMEMBERS ($ppunsupported(P, "method attributes, name, or line")) ppropertydesc* pmethoddesc* -- otherwise

def $ppmethod_checked(P, pcpath, flags, b, ptbytes, phpType16, phpType18, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader) = PPMEMBERS P[.COMPLETION = PPCABRUPT (COMPILETHROWN $ptascii("Cannot use the readonly modifier on a method") P.LOCATION.LINE)] ppropertydesc* pmethoddesc*
  -- if $ppproperty_flag(flags, 64)
def $ppmethod_checked(P, pcpath, flags, b, ptbytes, phpType16, phpType18, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader) = PPMEMBERS P[.COMPLETION = PPCABRUPT (COMPILETHROWN $ptascii("Cannot use the final modifier on an abstract method") P.LOCATION.LINE)] ppropertydesc* pmethoddesc*
  -- if ~$ppproperty_flag(flags, 64) /\ $ppproperty_flag(flags, 16) /\ $ppproperty_flag(flags, 32)
def $ppmethod_checked(P, pcpath, flags, b, ptbytes, phpType16, phpType18, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader) = PPMEMBERS ($ppconstant_error(P, $ptascii("Method ") ++ pchheader.NAME ++ $ptascii("::__construct() cannot be static"), P.LOCATION.LINE)) ppropertydesc* pmethoddesc*
  -- if $ppmethod_header_ready(flags, phpType47, pchheader) /\ $ppproperty_flag(flags, 8) /\ $ptlc(ptbytes) = $ptascii("__construct")
def $ppmethod_checked(P, pcpath, flags, b, ptbytes, phpType16, phpType18, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader) = PPMEMBERS ($ppconstant_error(P, $ptascii("Class ") ++ pchheader.NAME ++ $ptascii(" declares abstract method ") ++ ptbytes ++ $ptascii("() and must therefore be declared abstract"), P.LOCATION.LINE)) ppropertydesc* pmethoddesc*
  -- if ~$ppproperty_flag(flags, 64) /\ $ppproperty_flag(flags, 16) /\ ~$ppproperty_flag(flags, 32) /\ ~pchheader.ABSTRACT /\ pchheader.KIND =/= "trait"
def $ppmethod_checked(P, pcpath, flags, b, ptbytes, phpType16, phpType18, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader) = PPMEMBERS ($ppconstant_error(P, $ptascii("Abstract function ") ++ pchheader.NAME ++ $ptascii("::") ++ ptbytes ++ $ptascii("() cannot be declared private"), P.LOCATION.LINE)) ppropertydesc* pmethoddesc*
  -- if ~$ppproperty_flag(flags, 64) /\ $ppproperty_flag(flags, 16) /\ ~$ppproperty_flag(flags, 32) /\ $ppproperty_flag(flags, 4) /\ pchheader.ABSTRACT /\ pchheader.KIND =/= "trait"
def $ppmethod_checked(P, pcpath, flags, b, ptbytes, phpType16, phpType18, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader) = PPMEMBERS ($ppconstant_error(P, $ptascii("Abstract function ") ++ pchheader.NAME ++ $ptascii("::") ++ ptbytes ++ $ptascii("() cannot contain body"), P.LOCATION.LINE)) ppropertydesc* pmethoddesc*
  -- if ~$ppproperty_flag(flags, 64) /\ $ppproperty_flag(flags, 16) /\ (pchheader.ABSTRACT \/ pchheader.KIND = "trait") /\ phpType47 =/= ABSENT
def $ppmethod_checked(P, pcpath, flags, b, ptbytes, phpType16, phpType18, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader) = PPMEMBERS ($ppconstant_error(P, $ptascii("Non-abstract method ") ++ pchheader.NAME ++ $ptascii("::") ++ ptbytes ++ $ptascii("() must contain body"), P.LOCATION.LINE)) ppropertydesc* pmethoddesc*
  -- if ~$ppproperty_flag(flags, 64) /\ ~$ppproperty_flag(flags, 16) /\ phpType47 = ABSENT
def $ppmethod_checked(P, pcpath, flags, b, ptbytes, phpType16, phpType18, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader) = PPMEMBERS ($ppconstant_error(P, $ptascii("Cannot redeclare ") ++ pchheader.NAME ++ $ptascii("::") ++ ptbytes ++ $ptascii("()"), P.LOCATION.LINE)) ppropertydesc* pmethoddesc*
  -- if $ppmethod_prechecked(flags, ptbytes, phpType47, pchheader)
  -- if $ppmethod_at(pmethoddesc*, ptbytes)
def $ppmethod_checked(P, pcpath, flags, b, ptbytes, phpType16, phpType18, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader) = PPMEMBERS ($ppunsupported(P, "method visibility, static, or magic consumer")) ppropertydesc* pmethoddesc*
  -- if $ppmethod_prechecked(flags, ptbytes, phpType47, pchheader) /\ ~$ppmethod_at(pmethoddesc*, ptbytes)
  -- if flags <- [0,1,2,4,8,9,10,12,16,17,18,24,25,26,32,33,34,36,40,41,42,44] /\ $ppmethod_magic(ptbytes) /\ ~$ppmethod_tostring(ptbytes) /\ ~($ptlc(ptbytes) <- [$ptascii("__wakeup"), $ptascii("__destruct"), $ptascii("__clone")]) /\ ~$ppmethod_invoke(flags, ptbytes) /\ ~$ppmethod_get(flags, ptbytes)
def $ppmethod_checked(P, pcpath, flags, b, ptbytes, phpType16, phpType18, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader) = $ppmethod_begin(P, pcpath, flags, b, ptbytes, phpType16, phpType18, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader)
  -- if $ppmethod_prechecked(flags, ptbytes, phpType47, pchheader) /\ ($ppmethod_get(flags, ptbytes) \/ $ppmethod_tostring(ptbytes) \/ $ptlc(ptbytes) <- [$ptascii("__wakeup"), $ptascii("__destruct"), $ptascii("__clone")] \/ $ppmethod_invoke(flags, ptbytes)) /\ ~$ppmethod_at(pmethoddesc*, ptbytes)
def $ppmethod_checked(P, pcpath, flags, b, ptbytes, phpType16, phpType18, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader) = $ppmethod_begin(P, pcpath, flags, b, ptbytes, phpType16, phpType18, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader)
  -- if $ppmethod_prechecked(flags, ptbytes, phpType47, pchheader) /\ $ppmethod_flags(flags, pchheader.KIND) /\ ~$ppmethod_magic(ptbytes) /\ ~$ppmethod_at(pmethoddesc*, ptbytes)
def $ppmethod_checked(P, pcpath, flags, b, ptbytes, phpType16, phpType18, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader) = PPMEMBERS ($ppunsupported(P, "method visibility, static, or modifiers")) ppropertydesc* pmethoddesc* -- otherwise

def $ppmethod_begin(P, pcpath, flags, b, ptbytes, phpType16, phpType18, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader) = $ppmethod_step(P_warn, P_method, pcpath, flags, ptbytes, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader, $psstep_start(phpType16, phpType18, b, $ppmethod_context(P, pchheader, ptbytes, P.LOCATION.LINE)))
  -- if P_warn = $ppmethod_warning(P, flags, ptbytes)
  -- if P_method = $ppfunction_start(P_warn[.CLASSCONTEXT = ($ppmethod_context(P, pchheader, ptbytes, P.LOCATION.LINE))], pchheader.NAME ++ $ptascii("::") ++ ptbytes, {PARAMETERS eps, RETURNS eps, BYREF b})[.GOTOROOT = pcpath]

def $ppmethod_default_path(pcpath, n) = pcpath ++ [PCFIELD 4, PCINDEX n, PCFIELD 6]
def $ppmethod_default_parameter(P, pcpath, n) = P[.EXPRESSIONS = P.EXPRESSIONS ++ [PPCEXPR (pcpath ++ [PCFIELD 4, PCINDEX n]) P.LOCATION.LINE eps]]
def $ppmethod_defaults(P, pcpath, eps, n) = eps
def $ppmethod_defaults(P, pcpath, psparam :: psparam_tail*, n) = $ppmethod_defaults(P, pcpath, psparam_tail*, $(n + 1))
  -- if psparam.DEFAULT = PSNONE
def $ppmethod_defaults(P, pcpath, psparam :: psparam_tail*, n) = { INDEX n, ORIGIN PORIGIN P.FOLD.SOURCE.ID $ppmethod_default_path(pcpath, n), KIND $ppdefault_descriptor(P, $ppmethod_default_path(pcpath, n)) } :: $ppmethod_defaults(P, pcpath, psparam_tail*, $(n + 1))
  -- if $pshasdefault(psparam.DEFAULT)

def $ppmethod_step(P_outer, P, pcpath, flags, ptbytes, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader, psprogress) = PPMEMBERS P ppropertydesc* pmethoddesc*
  -- if P.COMPLETION =/= PPCNORMAL
def $ppmethod_step(P_outer, P, pcpath, flags, ptbytes, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader, PSSDONE (PSUNSUPPORTED text)) = PPMEMBERS ($ppunsupported(P, text)) ppropertydesc* pmethoddesc*
  -- if P.COMPLETION = PPCNORMAL
def $ppmethod_step(P_outer, P, pcpath, flags, ptbytes, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader, PSSDONE (PSERROR psdiagnostic*)) = PPMEMBERS ($ppsignature_diagnostics(P, psdiagnostic*)) ppropertydesc* pmethoddesc*
  -- if P.COMPLETION = PPCNORMAL
def $ppmethod_step(P_outer, P, pcpath, flags, ptbytes, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader, PSSDONE (PSOK pssignature psdiagnostic*)) = PPMEMBERS ($ppunsupported($ppsignature_diagnostics(P, psdiagnostic*), "dependent method type")) ppropertydesc* pmethoddesc*
  -- if P.COMPLETION = PPCNORMAL
  -- if ~$ppmethod_supported_signature(pssignature, pchheader.KIND)
def $ppmethod_step(P_outer, P, pcpath, flags, ptbytes, (SEQUENCE statement*), metadata, ppropertydesc*, pmethoddesc*, pchheader, PSSDONE (PSOK pssignature psdiagnostic*)) = $ppmethod_finish(P_outer, $ppgoto_finish(P_body), pcpath, flags, ptbytes, pssignature, metadata, ppropertydesc*, pmethoddesc*, pchheader)
  -- if P.COMPLETION = PPCNORMAL
  -- if $ppmethod_supported_signature(pssignature, pchheader.KIND)
  -- if pssignature_effective = $ppmethod_returns(ptbytes, pssignature)
  -- if psparam* = pssignature.PARAMETERS
  -- if P_header = $ppsignature_diagnostics(P, psdiagnostic*)[.RETURNREF = pssignature.BYREF][.RETURNS = pssignature_effective.RETURNS][.CVS = (psparam.NAME)*][.HEADERASSIGNED = ($ptascii("http_response_header") <- (psparam.NAME)*)][.FOLD = P.FOLD[.DEFAULT = false][.CONSTANT = false][.VALUE = eps]]
  -- if P_body = $ppgenerator_body(P_header, pcpath ++ [PCFIELD 6], statement*)
def $ppmethod_step(P_outer, P, pcpath, flags, ptbytes, ABSENT, metadata, ppropertydesc*, pmethoddesc*, pchheader, PSSDONE (PSOK pssignature psdiagnostic*)) = $ppmethod_finish(P_outer, P_header, pcpath, flags, ptbytes, pssignature, metadata, ppropertydesc*, pmethoddesc*, pchheader)
  -- if P.COMPLETION = PPCNORMAL
  -- if $ppmethod_supported_signature(pssignature, pchheader.KIND)
  -- if pssignature_effective = $ppmethod_returns(ptbytes, pssignature)
  -- if psparam* = pssignature.PARAMETERS
  -- if P_header = $ppsignature_diagnostics(P, psdiagnostic*)[.RETURNREF = pssignature.BYREF][.RETURNS = pssignature_effective.RETURNS][.CVS = (psparam.NAME)*][.HEADERASSIGNED = ($ptascii("http_response_header") <- (psparam.NAME)*)][.FOLD = P.FOLD[.DEFAULT = false][.CONSTANT = false][.VALUE = eps]]
def $ppmethod_step(P_outer, P, pcpath, flags, ptbytes, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader, PSSDEFAULTREQUEST pscontinuation) = $ppmethod_request(P_outer, $ppsignature_diagnostics(P, pscontinuation.DIAGNOSTICS), pcpath, flags, ptbytes, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader, pscontinuation[.DIAGNOSTICS = eps])
  -- if P.COMPLETION = PPCNORMAL
def $ppmethod_step(P_outer, P, pcpath, flags, ptbytes, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader, PSSATTRIBUTETARGETREQUEST pscontinuation phpType14) = PPMEMBERS ($ppsignature_attribute($ppsignature_diagnostics(P, pscontinuation.DIAGNOSTICS), pcpath ++ [PCFIELD 4, PCINDEX (|pscontinuation.SIGNATURE.PARAMETERS|)], pscontinuation, phpType14)) ppropertydesc* pmethoddesc*
  -- if P.COMPLETION = PPCNORMAL

def $ppmethod_request(P_outer, P, pcpath, flags, ptbytes, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader, pscontinuation) = $ppmethod_parameter(P_outer, $ppmethod_default_parameter(P[.LOCATION.LINE = pscontinuation.PARAMETER.LINE], pcpath, n), pcpath, flags, ptbytes, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader, pscontinuation, $psdefaultready(pscontinuation.CONTEXT[.LINE = pscontinuation.PARAMETER.LINE][.POSITION = PTPARAMETER], pscontinuation.PARAMETER, pscontinuation.REST, PSNONE))
  -- if pscontinuation.PARAMETER.DEFAULT = ABSENT
  -- if n = |pscontinuation.SIGNATURE.PARAMETERS|
def $ppmethod_request(P_outer, P, pcpath, flags, ptbytes, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader, pscontinuation) = $ppmethod_ready(P_outer, $ppdefault_prepare(P[.LOCATION.LINE = pscontinuation.PARAMETER.LINE][.FOLD = P.FOLD[.DEFAULT = true][.CONSTANT = true]], $ppmethod_default_path(pcpath, n), expression), pcpath, flags, ptbytes, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader, pscontinuation, expression)
  -- if pscontinuation.PARAMETER.DEFAULT = (expression)
  -- if n = |pscontinuation.SIGNATURE.PARAMETERS|
def $ppmethod_ready(P_outer, P, pcpath, flags, ptbytes, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader, pscontinuation, expression) = PPMEMBERS P ppropertydesc* pmethoddesc*
  -- if P.COMPLETION =/= PPCNORMAL
def $ppmethod_ready(P_outer, P, pcpath, flags, ptbytes, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader, pscontinuation, expression) = $ppmethod_parameter(P_outer, $ppmethod_default_parameter(P, pcpath, n), pcpath, flags, ptbytes, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader, pscontinuation, $psdefaultready(pscontinuation.CONTEXT[.LINE = pscontinuation.PARAMETER.LINE][.POSITION = PTPARAMETER], pscontinuation.PARAMETER, pscontinuation.REST, psdefault))
  -- if P.COMPLETION = PPCNORMAL
  -- if n = |pscontinuation.SIGNATURE.PARAMETERS|
  -- if psdefault = PSDEFAULT expression $ppdefault_kind(P.FOLD.VALUE)

;; Each promoted declaration follows this parameter's default/type checks and
;; precedes the next parameter. Its origin remains the real source NParam.
def $ppmethod_parameter(P_outer, P, pcpath, flags, ptbytes, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader, pscontinuation, PSONE psparam psdiagnostic*) = $ppmethod_step(P_outer, P_next, pcpath, flags, ptbytes, phpType47, metadata, ppropertydesc_next*, pmethoddesc*, pchheader, $psafterone_start(pscontinuation.CONTEXT, pscontinuation.REST, pscontinuation.SIGNATURE, pscontinuation.DIAGNOSTICS, PSONE psparam eps))
  -- if n = |pscontinuation.SIGNATURE.PARAMETERS|
  -- if PPROPERTIES P_next ppropertydesc_next* = $pppromotion_parameter($ppsignature_diagnostics(P, psdiagnostic*), pcpath ++ [PCFIELD 4, PCINDEX n], flags, pscontinuation.PARAMETER, ppropertydesc*, pchheader)
def $ppmethod_parameter(P_outer, P, pcpath, flags, ptbytes, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader, pscontinuation, psoneresult) = $ppmethod_step(P_outer, P, pcpath, flags, ptbytes, phpType47, metadata, ppropertydesc*, pmethoddesc*, pchheader, $psafterone_start(pscontinuation.CONTEXT, pscontinuation.REST, pscontinuation.SIGNATURE, pscontinuation.DIAGNOSTICS, psoneresult)) -- otherwise

def $pppromotion_parameter(P, pcpath, flags, psraw, ppropertydesc*, pchheader) = PPROPERTIES P ppropertydesc*
  -- if psraw.FLAGS = 0
def $pppromotion_parameter(P, pcpath, flags, psraw, ppropertydesc*, pchheader) = PPROPERTIES ($ppconstant_error(P, $ptascii("Cannot declare promoted property in an abstract constructor"), psraw.LINE)) ppropertydesc*
  -- if psraw.FLAGS =/= 0
  -- if $ppproperty_flag(flags, 16) \/ pchheader.KIND = "interface"
def $pppromotion_parameter(P, pcpath, flags, psraw, ppropertydesc*, pchheader) = PPROPERTIES ($ppconstant_error(P, $ptascii("Cannot declare variadic promoted property"), psraw.LINE)) ppropertydesc*
  -- if psraw.FLAGS =/= 0
  -- if ~$ppproperty_flag(flags, 16) /\ pchheader.KIND =/= "interface"
  -- if psraw.VARIADIC
def $pppromotion_parameter(P, pcpath, flags, psraw, ppropertydesc*, pchheader) = PPROPERTIES ($ppconstant_error(P, $ptascii("Cannot redeclare ") ++ pchheader.NAME ++ $ptascii("::$") ++ psraw.NAME, psraw.LINE)) ppropertydesc*
  -- if psraw.FLAGS =/= 0
  -- if ~$ppproperty_flag(flags, 16) /\ pchheader.KIND =/= "interface" /\ ~psraw.VARIADIC
  -- if $ppproperty_at(ppropertydesc*, psraw.NAME)
def $pppromotion_parameter(P, pcpath, flags, psraw, ppropertydesc*, pchheader) = $ppproperty_typed(P, pcpath, psraw.FLAGS, ABSENT, psraw.NAME, $ptype_normalize(psraw.TYPE, $ppproperty_context(P, pchheader, psraw.NAME, psraw.LINE)), ppropertydesc*, pchheader, psraw.LINE)
  -- if psraw.FLAGS =/= 0
  -- if ~$ppproperty_flag(flags, 16) /\ pchheader.KIND =/= "interface" /\ ~psraw.VARIADIC
  -- if ~$ppproperty_at(ppropertydesc*, psraw.NAME)

def $ppmethod_finish(P_outer, P_body, pcpath, flags, ptbytes, pssignature, metadata, ppropertydesc*, pmethoddesc*, pchheader) = PPMEMBERS P_body ppropertydesc* pmethoddesc*
  -- if P_body.COMPLETION =/= PPCNORMAL
def $ppmethod_finish(P_outer, P_body, pcpath, flags, ptbytes, pssignature, metadata, ppropertydesc*, pmethoddesc*, pchheader) = PPMEMBERS ($ppconstant_error(P_body, $ptascii("Method ") ++ pchheader.NAME ++ $ptascii("::__toString() cannot take arguments"), $ppmethod_line(metadata))) ppropertydesc* pmethoddesc*
  -- if P_body.COMPLETION = PPCNORMAL
  -- if $ppmethod_tostring(ptbytes) /\ pssignature.PARAMETERS =/= eps
def $ppmethod_finish(P_outer, P_body, pcpath, flags, ptbytes, pssignature, metadata, ppropertydesc*, pmethoddesc*, pchheader) = PPMEMBERS ($ppconstant_error(P_body, $ptascii("Method ") ++ pchheader.NAME ++ $ptascii("::__toString() cannot be static"), $ppmethod_line(metadata))) ppropertydesc* pmethoddesc*
  -- if P_body.COMPLETION = PPCNORMAL
  -- if $ppmethod_tostring(ptbytes) /\ pssignature.PARAMETERS = eps /\ $ppproperty_flag(flags, 8)
def $ppmethod_finish(P_outer, P_body, pcpath, flags, ptbytes, pssignature, metadata, ppropertydesc*, pmethoddesc*, pchheader) = PPMEMBERS ($ppconstant_error(P_body, $ptascii("Method ") ++ pchheader.NAME ++ $ptascii("::") ++ ptbytes ++ $ptascii("() cannot be static"), $ppmethod_line(metadata))) ppropertydesc* pmethoddesc*
  -- if P_body.COMPLETION = PPCNORMAL
  -- if $ptlc(ptbytes) = $ptascii("__invoke") /\ $ppproperty_flag(flags, 8)
def $ppmethod_finish(P_outer, P_body, pcpath, flags, ptbytes, pssignature, metadata, ppropertydesc*, pmethoddesc*, pchheader) = PPMEMBERS ($ppconstant_error(P_body, $ptascii("Method ") ++ pchheader.NAME ++ $ptascii("::") ++ ptbytes ++ $ptascii("() cannot take arguments"), $ppmethod_line(metadata))) ppropertydesc* pmethoddesc*
  -- if P_body.COMPLETION = PPCNORMAL
  -- if $ptlc(ptbytes) <- [$ptascii("__wakeup"), $ptascii("__destruct"), $ptascii("__clone")] /\ ~$ppmethod_wakeup_args_valid(pssignature.PARAMETERS)
def $ppmethod_finish(P_outer, P_body, pcpath, flags, ptbytes, pssignature, metadata, ppropertydesc*, pmethoddesc*, pchheader) = PPMEMBERS ($ppconstant_error(P_body, $ptascii("Method ") ++ pchheader.NAME ++ $ptascii("::") ++ ptbytes ++ $ptascii("() cannot be static"), $ppmethod_line(metadata))) ppropertydesc* pmethoddesc*
  -- if P_body.COMPLETION = PPCNORMAL
  -- if $ptlc(ptbytes) <- [$ptascii("__wakeup"), $ptascii("__destruct"), $ptascii("__clone")] /\ $ppmethod_wakeup_args_valid(pssignature.PARAMETERS) /\ $ppproperty_flag(flags, 8)
def $ppmethod_finish(P_outer, P_body, pcpath, flags, ptbytes, pssignature, metadata, ppropertydesc*, pmethoddesc*, pchheader) = PPMEMBERS ($ppconstant_error(P_checked, pchheader.NAME ++ $ptascii("::__toString(): Return type must be string when declared"), $ppmethod_line(metadata))) ppropertydesc* pmethoddesc*
  -- if P_body.COMPLETION = PPCNORMAL
  -- if $ppmethod_tostring(ptbytes) /\ pssignature.PARAMETERS = eps /\ ~$ppproperty_flag(flags, 8)
  -- if P_checked = $ppmethod_visibility_warning(P_body, flags, ptbytes, pchheader.NAME, $ppmethod_line(metadata))
  -- if ~$ppmethod_return_valid(pssignature.RETURNS)
def $ppmethod_finish(P_outer, P_body, pcpath, flags, ptbytes, pssignature, metadata, ppropertydesc*, pmethoddesc*, pchheader) = PPMEMBERS ($ppconstant_error(P_checked, $ptascii("Access level to ") ++ pchheader.NAME ++ $ptascii("::__toString() must be public (as in class Stringable)"), $ppmethod_line(metadata))) ppropertydesc* pmethoddesc*
  -- if P_body.COMPLETION = PPCNORMAL
  -- if $ppmethod_tostring(ptbytes) /\ pssignature.PARAMETERS = eps /\ ~$ppproperty_flag(flags, 8)
  -- if P_checked = $ppmethod_visibility_warning(P_body, flags, ptbytes, pchheader.NAME, $ppmethod_line(metadata))
  -- if $ppmethod_return_valid(pssignature.RETURNS) /\ $ppmethod_visibility(flags) =/= PROPERTY_PUBLIC
def $ppmethod_finish(P_outer, P_body, pcpath, flags, ptbytes, pssignature, metadata, ppropertydesc*, pmethoddesc*, pchheader) = PPMEMBERS ($ppconstant_error(P_body, $ptascii("Method ") ++ pchheader.NAME ++ $ptascii("::") ++ ptbytes ++ $ptascii("() cannot declare a return type"), $ppmethod_line(metadata))) ppropertydesc* pmethoddesc*
  -- if P_body.COMPLETION = PPCNORMAL
  -- if ($ptlc(ptbytes) = $ptascii("__construct") \/ ($ptlc(ptbytes) = $ptascii("__destruct") /\ $ppmethod_wakeup_args_valid(pssignature.PARAMETERS) /\ ~$ppproperty_flag(flags, 8))) /\ pssignature.RETURNS =/= eps
def $ppmethod_finish(P_outer, P_body, pcpath, flags, ptbytes, pssignature, metadata, ppropertydesc*, pmethoddesc*, pchheader) = PPMEMBERS ($ppconstant_error(P_checked, pchheader.NAME ++ $ptascii("::") ++ ptbytes ++ $ptascii("(): Return type must be void when declared"), $ppmethod_line(metadata))) ppropertydesc* pmethoddesc*
  -- if P_body.COMPLETION = PPCNORMAL
  -- if $ptlc(ptbytes) <- [$ptascii("__wakeup"), $ptascii("__clone")] /\ $ppmethod_wakeup_args_valid(pssignature.PARAMETERS) /\ ~$ppproperty_flag(flags, 8)
  -- if P_checked = $ppmethod_visibility_warning(P_body, flags, ptbytes, pchheader.NAME, $ppmethod_line(metadata))
  -- if ~$ppmethod_wakeup_return_valid(pssignature.RETURNS)
def $ppmethod_finish(P_outer, P_body, pcpath, flags, ptbytes, pssignature, metadata, ppropertydesc*, pmethoddesc*, pchheader) = PPMEMBERS ($ppunsupported(P_body, "magic getter signature")) ppropertydesc* pmethoddesc*
  -- if P_body.COMPLETION = PPCNORMAL
  -- if $ppmethod_get(flags, ptbytes) /\ ~$ppmethod_get_signature(pssignature)
def $ppmethod_finish(P_outer, P_body, pcpath, flags, ptbytes, pssignature, metadata, ppropertydesc*, pmethoddesc*, pchheader) = PPMEMBERS P_restored ppropertydesc* (pmethoddesc* ++ [{ NAME ptbytes, FUNCTION { DEFAULTS $ppmethod_defaults(P_body, pcpath, pssignature.PARAMETERS, 0), ORIGIN PORIGIN P_outer.FOLD.SOURCE.ID pcpath, NAME (pchheader.NAME ++ $ptascii("::") ++ ptbytes), SIGNATURE pssignature_effective, CVS P_body.CVS, ENV P_outer.ENV, CODE $ppfunction_code(P_body), BODY (pcpath ++ [PCFIELD 6]), EARLY false, LINE $ppmethod_line(metadata), ENDLINE $psendline(metadata) }, OWNER PORIGIN P_outer.FOLD.SOURCE.ID pcpath[0:$nabs($( |pcpath| - 2))], VISIBILITY $ppmethod_visibility(flags), STATIC $ppproperty_flag(flags, 8), FINAL $ppproperty_flag(flags, 32), ABSTRACT $ppproperty_flag(flags, 16) }])
  -- if P_body.COMPLETION = PPCNORMAL
  -- if ~($ptlc(ptbytes) = $ptascii("__invoke") /\ $ppproperty_flag(flags, 8))
  -- if ~($ptlc(ptbytes) = $ptascii("__construct") /\ pssignature.RETURNS =/= eps) /\ (~($ptlc(ptbytes) <- [$ptascii("__wakeup"), $ptascii("__clone")]) \/ ($ppmethod_wakeup_args_valid(pssignature.PARAMETERS) /\ ~$ppproperty_flag(flags, 8) /\ $ppmethod_wakeup_return_valid(pssignature.RETURNS)))
  -- if $ptlc(ptbytes) =/= $ptascii("__destruct") \/ ($ppmethod_wakeup_args_valid(pssignature.PARAMETERS) /\ ~$ppproperty_flag(flags, 8) /\ pssignature.RETURNS = eps)
  -- if ~$ppmethod_tostring(ptbytes) \/ (pssignature.PARAMETERS = eps /\ ~$ppproperty_flag(flags, 8) /\ $ppmethod_visibility(flags) = PROPERTY_PUBLIC /\ $ppmethod_return_valid(pssignature.RETURNS))
  -- if ~$ppmethod_get(flags, ptbytes) \/ $ppmethod_get_signature(pssignature)
  -- if pssignature_effective = $ppmethod_returns(ptbytes, pssignature)
  -- if P_checked = $ppmethod_visibility_warning(P_body, flags, ptbytes, pchheader.NAME, $ppmethod_line(metadata))
  -- if P_restored = P_checked[.CLOSURE = P_outer.CLOSURE][.CLASSCONTEXT = P_outer.CLASSCONTEXT][.RETURNREF = P_outer.RETURNREF][.RETURNS = P_outer.RETURNS][.CVS = P_outer.CVS][.HEADERASSIGNED = P_outer.HEADERASSIGNED][.LOOPS = P_outer.LOOPS][.SWITCHES = P_outer.SWITCHES][.GOTOROOT = P_outer.GOTOROOT][.LABELS = P_outer.LABELS][.GOTOS = P_outer.GOTOS][.EARLY = P_outer.EARLY][.FOLD = P_body.FOLD[.FUNCTION = P_outer.FOLD.FUNCTION][.CLASSCONTEXT = P_outer.FOLD.CLASSCONTEXT][.CLOSURE = P_outer.FOLD.CLOSURE][.VALUE = eps]][.LOCATION = P_outer.LOCATION][.EXPRESSIONS = P_outer.EXPRESSIONS ++ P_body.EXPRESSIONS][.ACCESS = P_outer.ACCESS ++ P_body.ACCESS][.NAMES = P_outer.NAMES ++ P_body.NAMES][.REDIRECTS = P_outer.REDIRECTS ++ P_body.REDIRECTS][.WRITES = P_outer.WRITES ++ P_body.WRITES][.GLOBALS = P_outer.GLOBALS ++ P_body.GLOBALS]

;; An inherited method table keeps a class's own insertion order, then adds
;; absent parent entries. The parent's table order decides the first error.
syntax ppmethodinherited = PPMINHERITED pmethoddesc pclassdesc
;; The finite internal interface table is defined after source link rules.
dec $pil_internal_signature(ptbytes) : pssignature?
dec $pil_concrete_signature(text, ptbytes) : pssignature?
dec $pil_concrete_owner(text, ptbytes) : ptbytes
dec $pil_internal_name(ptbytes) : ptbytes
dec $pil_internal_method(ptbytes, ptbytes, ptbytes) : pmmethod?
dec $pil_signature_method(ptbytes, ptbytes, ptbytes, pssignature) : pmmethod
dec $pil_internal_scope(ptbytes) : pvclass
dec $pil_internal_compare(pstate, pmmethod, pvclass, pmmethod, pvclass) : pmdiagresult?
dec $pil_internal_compared(pstate, pmmethod, pvclass, pmmethod, pvclass, pmcheck) : pmdiagresult?
dec $pil_internal_proto_owner(ptbytes) : ptbytes
dec $pil_internal_source_one(pstate, pclassdesc, pmethoddesc) : pmethodissue
dec $pil_internal_source_result(pmethoddesc, pmdiagresult?) : pmethodissue
dec $pil_internal_source_infos(pstate, ppmethodinherited*) : pmethodissue
dec $pil_internal_selected(pstate, pclassdesc, pclassdesc, pmethoddesc, text) : pmethodissue
dec $pil_internal_selected_owner(pstate, pclassdesc, pclassdesc, pmethoddesc, ptbytes, pssignature) : pmethodissue
dec $pil_internal_selected_result(pmdiagresult?) : pmethodissue
dec $pil_internal_later_infos(pstate, pclassdesc, ppmethodinherited*, ppmethodinherited*) : pmethodissue
dec $pil_internal_later_one(pstate, pclassdesc, ppmethodinherited, ppmethodinherited*) : pmethodissue
dec $pil_info_extra(pstate, porigin, ppmethodinherited*, nat) : ppmethodinherited*
dec $pil_layout_extra(pstate, porigin, ppmethodinherited*, nat) : ppmethodinherited*
dec $ppmethod_own(pclassdesc, pmethoddesc*) : ppmethodinherited*
dec $ppmethod_extra(ppmethodinherited*, pmethoddesc*) : ppmethodinherited*
dec $ppmethod_abstracts(ppmethodinherited*) : ppmethodinherited*
dec $ppmethod_abstract_names(ppmethodinherited*, nat) : ptbytes
dec $ppmethod_abstract_message(pclassdesc, ppmethodinherited*) : ptbytes?
def $ppmethod_own(pclassdesc, eps) = eps
def $ppmethod_own(pclassdesc, pmethoddesc :: pmethoddesc_tail*) = (PPMINHERITED pmethoddesc pclassdesc) :: $ppmethod_own(pclassdesc, pmethoddesc_tail*)
def $ppmethod_extra(eps, pmethoddesc*) = eps
def $ppmethod_extra((PPMINHERITED pmethoddesc pclassdesc) :: ppmethodinherited_tail*, pmethoddesc_own*) = $ppmethod_extra(ppmethodinherited_tail*, pmethoddesc_own*)
  -- if $ppmethod_at(pmethoddesc_own*, pmethoddesc.NAME)
def $ppmethod_extra((PPMINHERITED pmethoddesc pclassdesc) :: ppmethodinherited_tail*, pmethoddesc_own*) = (PPMINHERITED pmethoddesc pclassdesc) :: $ppmethod_extra(ppmethodinherited_tail*, pmethoddesc_own*)
  -- if ~$ppmethod_at(pmethoddesc_own*, pmethoddesc.NAME)
def $ppmethod_abstracts(eps) = eps
def $ppmethod_abstracts((PPMINHERITED pmethoddesc pclassdesc) :: ppmethodinherited_tail*) = (PPMINHERITED pmethoddesc pclassdesc) :: $ppmethod_abstracts(ppmethodinherited_tail*)
  -- if pmethoddesc.ABSTRACT
def $ppmethod_abstracts((PPMINHERITED pmethoddesc pclassdesc) :: ppmethodinherited_tail*) = $ppmethod_abstracts(ppmethodinherited_tail*)
  -- if ~pmethoddesc.ABSTRACT
def $ppmethod_abstract_names(eps, n) = eps
def $ppmethod_abstract_names(ppmethodinherited :: ppmethodinherited_tail*, 0) = $ptascii("...")
def $ppmethod_abstract_names((PPMINHERITED pmethoddesc pclassdesc) :: ppmethodinherited_tail*, n) = pclassdesc.NAME ++ $ptascii("::") ++ pmethoddesc.NAME
  -- if $(n > 0) /\ ppmethodinherited_tail* = eps
def $ppmethod_abstract_names((PPMINHERITED pmethoddesc pclassdesc) :: ppmethodinherited_tail*, n) = pclassdesc.NAME ++ $ptascii("::") ++ pmethoddesc.NAME ++ $ptascii(", ") ++ $ppmethod_abstract_names(ppmethodinherited_tail*, $nabs($(n - 1)))
  -- if $(n > 0) /\ ppmethodinherited_tail* =/= eps
def $ppmethod_abstract_message(pclassdesc, ppmethodinherited*) = eps
  -- if pclassdesc.ABSTRACT \/ $ppmethod_abstracts(ppmethodinherited*) = eps
def $ppmethod_abstract_message(pclassdesc, ppmethodinherited*) = ($ptascii("Class ") ++ pclassdesc.NAME ++ $ptascii(" contains 1 abstract method and must therefore be declared abstract or implement the remaining method (") ++ $ppmethod_abstract_names(ppmethodinherited_abstract*, 3) ++ [41])
  -- if ~pclassdesc.ABSTRACT
  -- if ppmethodinherited_abstract* = $ppmethod_abstracts(ppmethodinherited*)
  -- if |ppmethodinherited_abstract*| = 1
def $ppmethod_abstract_message(pclassdesc, ppmethodinherited*) = ($ptascii("Class ") ++ pclassdesc.NAME ++ $ptascii(" contains ") ++ $ntunsigned(|ppmethodinherited_abstract*|) ++ $ptascii(" abstract methods and must therefore be declared abstract or implement the remaining methods (") ++ $ppmethod_abstract_names(ppmethodinherited_abstract*, 3) ++ [41])
  -- if ~pclassdesc.ABSTRACT
  -- if ppmethodinherited_abstract* = $ppmethod_abstracts(ppmethodinherited*)
  -- if $(|ppmethodinherited_abstract*| > 1)
;; Instance calls compile receiver, computed name and argument sends in source
;; order. A deferred target leaves parameter acquisition to runtime selection.
dec $ppmethod_call_name(ppstate, pcpath, phpType20) : ppstate
dec $ppscoped_named(phpType19) : bool
dec $ppscoped_keyword(phpType19) : bool
dec $ppscoped_class(ppstate, pcpath, phpType19) : ppstate
def $ppscoped_named(NName phpType33 metadata) = true
def $ppscoped_named(NNameFullyQualified phpType33 metadata) = true
def $ppscoped_named(NNameRelative phpType33 metadata) = true
def $ppscoped_named(phpType19) = false -- otherwise
def $ppscoped_keyword(NName (BYTES text) metadata) = ($ptlc($base64(text)) <- [$ptascii("self"), $ptascii("parent"), $ptascii("static")])
def $ppscoped_keyword(phpType19) = false -- otherwise
def $ppscoped_class(P, pcpath, NName (BYTES text) metadata) = $ppclearvalue(P)
  -- if $ptlc($base64(text)) <- [$ptascii("self"), $ptascii("parent"), $ptascii("static")]
def $ppscoped_class(P, pcpath, name) = $ppclass_name(P, pcpath, $pnclassresolve(P.ENV, name))
  -- if $ppscoped_named(name) /\ ~$ppscoped_keyword(name)
def $ppscoped_class(P, pcpath, expression) = $ppclearvalue($ppexpr(P, pcpath ++ [PCFIELD 0], expression, PPR))
  -- if ~$ppscoped_named(expression)
def $ppmethod_call_name(P, pcpath, NIdentifier phpType33 metadata) = $pplocate($ppclearvalue(P), pcpath, $source_line(metadata))
def $ppmethod_call_name(P, pcpath, expression) = $ppclearvalue($ppexpr(P, pcpath ++ [PCFIELD 1], expression, PPR))
def $ppcall_deferred(NExprMethodCall expression phpType20 phpType6 metadata) = PPR
def $ppcall_deferred(NExprNullsafeMethodCall expression phpType20 phpType6 metadata) = PPR
def $ppcall_deferred(NExprStaticCall phpType19 phpType20 phpType6 metadata) = PPR
