  -- if $dynamic_defined_query(pconfigcall) = ((ptbytes_class, ptbytes_member))
def $class_constant_api_value(S, pconfigcall, pclassconstantdesc) = S[.TODO = ptask_tail*][.RESULT = KNOWN pdefaultcache.VALUE][.BASE = BASE_VALUE (KNOWN PNULL)]
