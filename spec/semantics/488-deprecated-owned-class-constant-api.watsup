;; Direct-global acquisition keeps the real donor and declaring cache identity.
;; Eligibility never copies a VALUE into the pending notice task.
dec $class_constant_api_owned_global(pstate, pclassconstantdesc) : puserconstant?
def $class_constant_api_owned_global(S, pclassconstantdesc) = (puserconstant)
  -- if $owned_class_constant_source(S, pclassconstantdesc)
  -- if $dynamic_class_constant_global(S, pclassconstantdesc) = (ptbytes_global)
  -- if $user_constant_at(S.USERCONSTANTS, $user_constant_key(ptbytes_global)) = (puserconstant)
