  -- if $global_constant_class_supported(puserconstant.CLASS)
  -- if $constant_value_class_valid(S, puserconstant.VALUE, puserconstant.CLASS)
def $class_constant_api_owned_global(S, pclassconstantdesc) = eps -- otherwise

def $class_constant_api_value(S, pconfigcall, pclassconstantdesc) = $class_constant_begin(S, pclassconstantdesc, CLASS_CONST_CALL pconfigcall, ptbytes_class, pconfigcall.LINE)
