;; Trait constant ASTs share a callable target cache. Each copied declaration
;; still selects its own called class at its genuine publication prefix.
def $constant_callable_imported_context(S, porigin_site) = true
  -- if $constant_callable_context(S, porigin_site) = ((porigin_decl, porigin_owner))
  -- if porigin_decl = TRAIT_MEMBER_ORIGIN porigin_owner porigin_member
  -- if $class_constant_origin(S.CLASSES, porigin_decl) = (pclassconstantdesc)
  -- if pclassconstantdesc.OWNER = porigin_owner
def $constant_callable_imported_context(S, porigin_site) = false -- otherwise
def $constant_callable_imported_record(S, pconstantclosure) = true
  -- if pconstantclosure.DECL = TRAIT_MEMBER_ORIGIN porigin_owner porigin_member
  -- if $class_constant_origin(S.CLASSES, pconstantclosure.DECL) = (pclassconstantdesc)
  -- if pclassconstantdesc.OWNER = porigin_owner
def $constant_callable_imported_record(S, pconstantclosure) = false -- otherwise
def $constant_callable_record_prefix(S, pconstantclosure) = true
  -- if $constant_callable_imported_record(S, pconstantclosure)
  -- if $firstclass_site(S, pconstantclosure.SITE) \/ $constant_callable_method_site(S, pconstantclosure.SITE)
  -- if $constant_callable_first(S.CONSTANTCLOSURES, pconstantclosure.SITE) = (pconstantclosure_first)
  -- if $(pconstantclosure_first.OBJECT <= pconstantclosure.OBJECT)
  -- if $(pconstantclosure_first.PREFIX <= pconstantclosure.PREFIX)

;; This header does not call birth, scope-row or record validation. It can
;; authenticate the first cached target after its failed value has retired.
dec $class_constant_callable_receipt_owner(pstate, pconstantclosure) : porigin?
def $class_constant_callable_receipt_owner(S, pconstantclosure) = (pclassconstantdesc.OWNER)
  -- if $(pconstantclosure.OBJECT < |S.OBJECTS|) /\ $(pconstantclosure.PREFIX <= |S.DECLARATIONS|)
  -- if $class_constant_origin(S.CLASSES, pconstantclosure.DECL) = (pclassconstantdesc)
  -- if ~pclassconstantdesc.FOLDED
  -- if $constant_callable_published(S.DECLARATIONS[0:pconstantclosure.PREFIX], pclassconstantdesc.OWNER)
  -- if $constant_callable_path(S, pconstantclosure.SITE, pclassconstantdesc.INITIALIZER)
  -- if $origin_node(S.SOURCES, pconstantclosure.SITE) = (pcnode)
  -- if $constant_callable_form(pcnode)
  -- if $constant_callable_record_prefix(S, pconstantclosure)
def $class_constant_callable_receipt_owner(S, pconstantclosure) = eps -- otherwise

dec $class_constant_callable_cached_method(pstate, porigin) : pmethoddesc?
def $class_constant_callable_cached_method(S, porigin_site) = (pmethoddesc)
  -- if $constant_callable_first(S.CONSTANTCLOSURES, porigin_site) = (pconstantclosure_first)
  -- if $class_constant_callable_receipt_owner(S, pconstantclosure_first) = (porigin_first_owner)
