  -- if $constant_callable_record(S.CONSTANTCLOSURES, pclosurescope.OBJECT) = (pconstantclosure)
  -- if $class_constant_closure_receipt(S, pconstantclosure, porigin_site, pclosurescope.LEXICAL)
  -- if pclosurescope.CALLED = pclosurescope.LEXICAL
  -- if pclosurescope.RECEIVER = eps /\ pclosurescope.CREATION = eps
def $class_constant_closure_scope_valid(S, porigin_site, pclosurescope) = true
  -- if $(pclosurescope.OBJECT < |S.OBJECTS|)
  -- if S.OBJECTS[pclosurescope.OBJECT] = REALCLOSURE porigin_site eps pstaticcell*
  -- if $class_constant_closure_clone_receipt(S, S.CONSTANTCLOSURES, porigin_site, pclosurescope.LEXICAL, pclosurescope.OBJECT)
  -- if pclosurescope.CALLED = pclosurescope.LEXICAL
  -- if pclosurescope.RECEIVER = eps /\ pclosurescope.CREATION = eps
def $class_constant_closure_scope_valid(S, porigin_site, pclosurescope) = false -- otherwise
def $closure_scope_classes_valid(S, porigin, pclosurescope) = true
  -- if ~$closure_scope_original_classes(S, porigin, pclosurescope)
  -- if $class_constant_closure_scope_valid(S, porigin, pclosurescope)

;; Child evidence reuses the genuine live call and copied239 creator header.
dec $class_constant_method_scope_valid(pstate, pclosurescope) : bool
def $class_constant_method_scope_valid(S, pclosurescope) = true
  -- if $(pclosurescope.OBJECT < |S.OBJECTS|)
