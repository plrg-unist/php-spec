;; REAL constant closures use the exact receipt's declaring class. A plain
;; clone borrows an earlier same-template receipt for that lexical owner.
dec $class_constant_closure_receipt(pstate, pconstantclosure, porigin, porigin) : bool
def $class_constant_closure_receipt(S, pconstantclosure, porigin_site, porigin_lexical) = true
  -- if pconstantclosure.SITE = porigin_site
  -- if $class_constant_callable_receipt_owner(S, pconstantclosure) = (porigin_lexical)
  -- if S.OBJECTS[pconstantclosure.OBJECT] = CONSTANTCLOSURE porigin_site (REALCLOSURE porigin_site eps pstaticcell*)
def $class_constant_closure_receipt(S, pconstantclosure, porigin_site, porigin_lexical) = false -- otherwise
dec $class_constant_closure_clone_receipt(pstate, pconstantclosure*, porigin, porigin, nat) : bool
def $class_constant_closure_clone_receipt(S, eps, porigin_site, porigin_lexical, n) = false
def $class_constant_closure_clone_receipt(S, pconstantclosure :: pconstantclosure_tail*, porigin_site, porigin_lexical, n) = true
  -- if $(pconstantclosure.OBJECT < n)
  -- if $class_constant_closure_receipt(S, pconstantclosure, porigin_site, porigin_lexical)
def $class_constant_closure_clone_receipt(S, pconstantclosure :: pconstantclosure_tail*, porigin_site, porigin_lexical, n) = $class_constant_closure_clone_receipt(S, pconstantclosure_tail*, porigin_site, porigin_lexical, n)
  -- if $(pconstantclosure.OBJECT >= n) \/ ~$class_constant_closure_receipt(S, pconstantclosure, porigin_site, porigin_lexical)
