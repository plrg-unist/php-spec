  -- if pclosurescope.LEXICAL = pmethoddesc.OWNER /\ pclosurescope.CALLED = porigin_requested
  -- if pclosurescope.RECEIVER = eps /\ pclosurescope.CREATION = eps
def $class_constant_callable_method_history_owner(S, pmethoddesc, porigin_site, porigin_requested, pclosurescope) = (porigin_owner)
  -- if n = pclosurescope.OBJECT
