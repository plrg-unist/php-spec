  -- if $class_constant_method_scope_valid(S, pclosurescope_creator)
  -- if $closure_nearest_owner(S, $closure_creation_owners($all_functions(S), pfunction.ORIGIN), eps) = ($origin_source(pcallcontext.FUNCTION))
  -- if $call_current_valid(S)
  -- if $closure_creation_scope(S, pfunction.ORIGIN)
