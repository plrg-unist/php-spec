  -- if $class_constant_callable_method_history_owner(S, pmethoddesc, porigin_site, porigin_requested, pclosurescope) = (porigin_owner)
def $class_constant_method_scope_valid(S, pclosurescope) = false -- otherwise
def $closure_evidence_valid(S, CLOSURE_SCOPE pclosurescope) = true
  -- if $class_constant_method_scope_valid(S, pclosurescope)
def $closure_creation_stamp(S, pfunction) = ({FUNCTION pcallcontext.FUNCTION, CALLSITE pcallcontext.CALLSITE, RECEIVER $closure_receiver_present($closure_bound_receiver(S, pfunction)), EVIDENCE (pclosurecreator)})
