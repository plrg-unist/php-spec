  -- if pmethoddesc.STATIC /\ ~pmethoddesc.ABSTRACT
  -- if $method_accessible(S, pmethoddesc, (porigin_first_owner))
def $class_constant_callable_cached_method(S, porigin_site) = eps -- otherwise
dec $class_constant_callable_cached_function(pstate, porigin) : pfunction?
def $class_constant_callable_cached_function(S, porigin_site) = (pfunction)
  -- if $constant_callable_first(S.CONSTANTCLOSURES, porigin_site) = (pconstantclosure_first)
  -- if $class_constant_callable_receipt_owner(S, pconstantclosure_first) = (porigin_first_owner)
