;; User parameter/return scalar conversion, pinned zend_check_type semantics.
;; Selection is pure; existing scalar helpers emit conversion diagnostics.
syntax ptypeconversion = TYPEDEPENDENT text | TYPEVALUE pvalue | TYPEINTEGER pvalue | TYPESTRING pvalue | TYPEBOOL pvalue | TYPEREJECT

dec $typed_tag(pvalue) : text
def $typed_tag(PNULL) = "null"
def $typed_tag(PBOOL true) = "true"
def $typed_tag(PBOOL false) = "false"
def $typed_tag(PINT i) = "int"
def $typed_tag(PFLOAT n) = "float"
def $typed_tag(PSTRING n*) = "string"
def $typed_tag(PARRAY n) = "array"
dec $typed_exact(ptbranch*, pvalue) : bool
def $typed_exact(ptbranch*, pvalue) = (ptbranch* = eps \/ "mixed" <- $ptmasks(ptbranch*) \/ $typed_tag(pvalue) <- $ptmasks(ptbranch*))
dec $typed_number(pvalue) : pnumber?
def $typed_number(PBOOL false) = (NINT 0)
def $typed_number(PBOOL true) = (NINT 1)
def $typed_number(PINT i) = (NINT i)
def $typed_number(PFLOAT n) = (NFLOAT n)
def $typed_number(PSTRING n*) = (pnumber) -- if $numeric_string(n*) = FULLNUM pnumber
def $typed_number(pvalue) = eps -- otherwise

dec $typed_integer_fit(pnumber) : bool
def $typed_integer_fit(NINT i) = true
def $typed_integer_fit(NFLOAT n) = $fparts_fits($float_decode(n))
dec $typed_string_value(pvalue) : bool
def $typed_string_value(PSTRING n*) = true
def $typed_string_value(pvalue) = false -- otherwise
dec $typed_scalar(pvalue) : bool
def $typed_scalar(PBOOL b) = true
def $typed_scalar(PINT i) = true
def $typed_scalar(PFLOAT n) = true
def $typed_scalar(PSTRING n*) = true
def $typed_scalar(pvalue) = false -- otherwise

dec $typed_int_conversion(text*, pvalue) : ptypeconversion?
def $typed_int_conversion(text*, pvalue) = (TYPEVALUE $number_value(pnumber))
  -- if "int" <- text* /\ "float" <- text*
  -- if $typed_string_value(pvalue)
  -- if $typed_number(pvalue) = (pnumber)
def $typed_int_conversion(text*, pvalue) = (TYPEINTEGER pvalue)
  -- if "int" <- text*
  -- if ~("float" <- text* /\ $typed_string_value(pvalue))
  -- if $typed_number(pvalue) = (pnumber)
  -- if $typed_integer_fit(pnumber)
def $typed_int_conversion(text*, pvalue) = eps -- otherwise

dec $typed_after_float(text*, pvalue) : ptypeconversion
dec $typed_after_string(text*, pvalue) : ptypeconversion
dec $typed_after_int(text*, pvalue) : ptypeconversion
def $typed_after_int(text*, pvalue) = TYPEVALUE (PFLOAT $num_float(pnumber))
  -- if "float" <- text*
  -- if $typed_number(pvalue) = (pnumber)
def $typed_after_int(text*, pvalue) = $typed_after_float(text*, pvalue) -- otherwise
def $typed_after_float(text*, pvalue) = TYPESTRING pvalue
  -- if "string" <- text*
  -- if $typed_scalar(pvalue)
def $typed_after_float(text*, pvalue) = $typed_after_string(text*, pvalue) -- otherwise
def $typed_after_string(text*, pvalue) = TYPEBOOL pvalue
  -- if "true" <- text* /\ "false" <- text*
  -- if $typed_scalar(pvalue)
def $typed_after_string(text*, pvalue) = TYPEREJECT -- otherwise

dec $typed_weak(text*, pvalue) : ptypeconversion
def $typed_weak(text*, pvalue) = ptypeconversion
  -- if $typed_int_conversion(text*, pvalue) = (ptypeconversion)
def $typed_weak(text*, pvalue) = $typed_after_int(text*, pvalue)
  -- if $typed_int_conversion(text*, pvalue) = eps

dec $typed_conversion(ptbranch*, pvalue, bool) : ptypeconversion
def $typed_conversion(ptbranch*, pvalue, b) = TYPEVALUE pvalue
  -- if $typed_exact(ptbranch*, pvalue)
def $typed_conversion(ptbranch*, PINT i, true) = TYPEVALUE (PFLOAT $float_of_int(i))
  -- if ~$typed_exact(ptbranch*, PINT i)
  -- if "float" <- $ptmasks(ptbranch*)
def $typed_conversion(ptbranch*, pvalue, false) = $typed_weak($ptmasks(ptbranch*), pvalue)
  -- if ~$typed_exact(ptbranch*, pvalue)
def $typed_conversion(ptbranch*, pvalue, b) = TYPEREJECT -- otherwise

dec $typed_apply(pstate, ptypeconversion, int) : pstate
def $typed_apply(S, TYPEVALUE pvalue, z) = S[.RESULT = KNOWN pvalue]
def $typed_apply(S, TYPEINTEGER pvalue, z) = $integer_coerce(S, pvalue, z)
def $typed_apply(S, TYPESTRING pvalue, z) = $stringify(S, pvalue, z)
def $typed_apply(S, TYPEBOOL pvalue, z) = $truth_value(S, pvalue, z)

;; The runtime wrapper preserves pure scalar conversion for compiler consumers.
;; Only live real closures satisfy the known Closure class in this foundation.
dec $closure_callable(pstate, nat) : bool
dec $typed_closure(pstate, nat) : bool
def $typed_closure(S, n) = $closure_callable(S, n)

dec $typed_closure_branch(ptbranch) : bool
def $typed_closure_branch(PTBRANCH ([PTCLASS ptbytes])) = ($ptlc(ptbytes) = $ptascii("closure"))
def $typed_closure_branch(ptbranch) = false -- otherwise
dec $typed_closure_type(ptbranch*) : bool
def $typed_closure_type(eps) = false
def $typed_closure_type(ptbranch :: ptbranch_tail*) = ($typed_closure_branch(ptbranch) \/ $typed_closure_type(ptbranch_tail*))
dec $typed_class_type(ptbranch*, ptbytes) : bool
dec $typed_class_branch(ptbranch, ptbytes) : bool
def $typed_class_branch(PTBRANCH ([(PTCLASS ptbytes_name)]), ptbytes) = ($ptlc(ptbytes_name) = $ptlc(ptbytes))
def $typed_class_branch(ptbranch, ptbytes) = false -- otherwise
def $typed_class_type(eps, ptbytes) = false
def $typed_class_type(ptbranch :: ptbranch_tail*, ptbytes) = ($typed_class_branch(ptbranch, ptbytes) \/ $typed_class_type(ptbranch_tail*, ptbytes))

dec $typed_callable_name(ptbytes) : ptbytes
def $typed_callable_name(92 :: n*) = n*
def $typed_callable_name(ptbytes) = ptbytes -- otherwise
dec $typed_callable_method(ptbytes, bool, bool) : bool
def $typed_callable_method(eps, b_previous, b_method) = b_method
def $typed_callable_method(58 :: n*, b_previous, b_method) = $typed_callable_method(n*, true, b_previous)
def $typed_callable_method(n :: n_tail*, b_previous, b_method) = $typed_callable_method(n_tail*, false, b_method) -- if n =/= 58

dec $typed_registered(pstate, ptbytes) : bool
def $typed_registered(S, ptbytes) = true -- if $pfunction_builtin($typed_callable_name(ptbytes))
def $typed_registered(S, ptbytes) = true
  -- if ~$pfunction_builtin($typed_callable_name(ptbytes))
  -- if $callable_at(S.CALLABLES, $ptlc($typed_callable_name(ptbytes))) = (porigin)
  -- if $function_at(S.FUNCTIONS, porigin) = (pfunction)
def $typed_registered(S, ptbytes) = false -- otherwise

;; Invalid callback array shapes are false; class/method services are pending.
dec $typed_callback_receiver(pvalue) : bool
def $typed_callback_receiver(PSTRING ptbytes) = true
def $typed_callback_receiver(POBJECT n) = true
def $typed_callback_receiver(pvalue) = false -- otherwise
dec $typed_plain_receiver(pstate, pvalue) : bool
def $typed_plain_receiver(S, POBJECT n) = $class_plain_instance(S, n)
def $typed_plain_receiver(S, pvalue) = false -- otherwise
dec $typed_callback_array(pstate, nat) : bool
def $typed_callback_array(S, n) = true
  -- if S.ARRAYS[n] = parray
  -- if |parray.ITEMS| = 2
  -- if $entry_lookup(parray.ITEMS, KINT 0) = (pitem_receiver)
  -- if $entry_lookup(parray.ITEMS, KINT 1) = (pitem_method)
  -- if $typed_callback_receiver($entry_value(S, pitem_receiver))
  -- if ~$typed_plain_receiver(S, $entry_value(S, pitem_receiver))
  -- if $entry_value(S, pitem_method) = PSTRING ptbytes
def $typed_callback_array(S, n) = false -- otherwise

dec $typed_callable(pstate, pvalue) : bool?
def $typed_callable(S, POBJECT n) = (true) -- if $typed_closure(S, n)
def $typed_callable(S, POBJECT n) = (false) -- if $class_plain_instance(S, n)
def $typed_callable(S, POBJECT n) = eps -- if ~$typed_closure(S, n) /\ ~$class_plain_instance(S, n)
def $typed_callable(S, PSTRING ptbytes) = (true) -- if $typed_registered(S, ptbytes)
def $typed_callable(S, PSTRING ptbytes) = eps
  -- if ~$typed_registered(S, ptbytes)
  -- if $typed_callable_method(ptbytes, false, false)
def $typed_callable(S, PSTRING ptbytes) = (false)
  -- if ~$typed_registered(S, ptbytes)
  -- if ~$typed_callable_method(ptbytes, false, false)
def $typed_callable(S, PARRAY n) = eps -- if $typed_callback_array(S, n)
def $typed_callable(S, PARRAY n) = (false) -- if ~$typed_callback_array(S, n)
def $typed_callable(S, pvalue) = (false) -- otherwise

dec $typed_object_exact(pstate, ptbranch*, pvalue) : bool
def $typed_object_exact(S, ptbranch*, POBJECT n) = ($typed_closure_type(ptbranch*) /\ $typed_closure(S, n))
  -- if $typed_closure(S, n)
def $typed_object_exact(S, ptbranch*, POBJECT n) = $typed_class_type(ptbranch*, pclassdesc.NAME)
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
def $typed_object_exact(S, ptbranch*, pvalue) = false -- otherwise

dec $typed_conversion_at(pstate, ptbranch*, pvalue, bool) : ptypeconversion
def $typed_conversion_at(S, ptbranch*, pvalue, b) = TYPEVALUE pvalue
  -- if $typed_exact(ptbranch*, pvalue) \/ $typed_object_exact(S, ptbranch*, pvalue)
def $typed_conversion_at(S, ptbranch*, pvalue, b) = TYPEVALUE pvalue
  -- if ~($typed_exact(ptbranch*, pvalue) \/ $typed_object_exact(S, ptbranch*, pvalue))
  -- if "callable" <- $ptmasks(ptbranch*)
  -- if $typed_callable(S, pvalue) = (true)
def $typed_conversion_at(S, ptbranch*, pvalue, b) = TYPEDEPENDENT "class or method callable type checking"
  -- if ~($typed_exact(ptbranch*, pvalue) \/ $typed_object_exact(S, ptbranch*, pvalue))
  -- if "callable" <- $ptmasks(ptbranch*)
  -- if $typed_callable(S, pvalue) = eps
def $typed_conversion_at(S, ptbranch*, pvalue, b) = $typed_conversion(ptbranch*, pvalue, b)
  -- if ~($typed_exact(ptbranch*, pvalue) \/ $typed_object_exact(S, ptbranch*, pvalue))
  -- if ~("callable" <- $ptmasks(ptbranch*)) \/ $typed_callable(S, pvalue) = (false)

dec $typed_given(pstate, pvalue) : ptbytes
def $typed_given(S, POBJECT n) = $ptascii("Closure") -- if $typed_closure(S, n)
def $typed_given(S, POBJECT n) = pclassdesc.NAME
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
def $typed_given(S, pvalue) = $ptascii($typed_tag(pvalue)) -- otherwise
def $typed_apply(S, TYPEDEPENDENT text, z) = S[.COMPLETION = UNSUPPORTED text]
