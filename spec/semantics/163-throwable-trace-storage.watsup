;; A trace is an ordinary array graph owned by the private Throwable trace
;; property. Frame descriptions exist only during allocation and error unwind.
dec $trace_items((pkey, ptracearg)*, parray) : parray
def $trace_items(eps, parray) = parray
def $trace_items((pkey, pvalue) :: (pkey_tail, pvalue_tail)*, parray) = $trace_items((pkey_tail, pvalue_tail)*, $array_insert(parray, pkey, DIRECT pvalue))

dec $trace_frame_fields(ptraceframe, nat) : parray
def $trace_frame_fields(ptraceframe, n_args) = $array_insert($array_empty(), KSTRING $ptascii("function"), DIRECT (PSTRING ptraceframe.FUNCTION))
  -- if ptraceframe.FILE = eps
  -- if ptraceframe.LINE = $(-1)
  -- if ptraceframe.CLASS = eps
  -- if ptraceframe.TYPE = eps
def $trace_frame_fields(ptraceframe, n_args) = $array_insert($array_insert($array_empty(), KSTRING $ptascii("function"), DIRECT (PSTRING ptraceframe.FUNCTION)), KSTRING $ptascii("class"), DIRECT (PSTRING preqbytes_class))
  -- if ptraceframe.FILE = eps
  -- if ptraceframe.LINE = $(-1)
  -- if ptraceframe.CLASS = (preqbytes_class)
  -- if ptraceframe.TYPE = eps
def $trace_frame_fields(ptraceframe, n_args) = $array_insert($array_insert($array_insert($array_empty(), KSTRING $ptascii("function"), DIRECT (PSTRING ptraceframe.FUNCTION)), KSTRING $ptascii("class"), DIRECT (PSTRING preqbytes_class)), KSTRING $ptascii("type"), DIRECT (PSTRING preqbytes_type))
  -- if ptraceframe.FILE = eps
  -- if ptraceframe.LINE = $(-1)
  -- if ptraceframe.CLASS = (preqbytes_class)
  -- if ptraceframe.TYPE = (preqbytes_type)
def $trace_frame_fields(ptraceframe, n_args) = $array_insert($array_insert($array_insert($array_empty(), KSTRING $ptascii("file"), DIRECT (PSTRING ptraceframe.FILE)), KSTRING $ptascii("line"), DIRECT (PINT ptraceframe.LINE)), KSTRING $ptascii("function"), DIRECT (PSTRING ptraceframe.FUNCTION))
  -- if ptraceframe.CLASS = eps
  -- if ~(ptraceframe.FILE = eps /\ ptraceframe.LINE = $(-1))
def $trace_frame_fields(ptraceframe, n_args) = $array_insert($array_insert($array_insert($array_insert($array_insert($array_empty(), KSTRING $ptascii("file"), DIRECT (PSTRING ptraceframe.FILE)), KSTRING $ptascii("line"), DIRECT (PINT ptraceframe.LINE)), KSTRING $ptascii("function"), DIRECT (PSTRING ptraceframe.FUNCTION)), KSTRING $ptascii("class"), DIRECT (PSTRING preqbytes_class)), KSTRING $ptascii("type"), DIRECT (PSTRING preqbytes_type))
  -- if ptraceframe.CLASS = (preqbytes_class)
  -- if ptraceframe.TYPE = (preqbytes_type)
  -- if ~(ptraceframe.FILE = eps /\ ptraceframe.LINE = $(-1))
dec $trace_frame_array(pstate, ptraceframe) : pstate
def $trace_frame_array(S, ptraceframe) = $allocate_array(S_args, $array_insert($trace_frame_fields(ptraceframe, n_args), KSTRING $ptascii("args"), DIRECT (PARRAY n_args)))
  -- if ptraceframe.HASARGS
  -- if S_args = $allocate_array(S, $trace_items(ptraceframe.ARGS, $array_empty()))
  -- if S_args.RESULT = KNOWN (PARRAY n_args)
def $trace_frame_array(S, ptraceframe) = $allocate_array(S, $trace_frame_fields(ptraceframe, 0))
  -- if ~ptraceframe.HASARGS

dec $trace_frames_array(pstate, ptraceframe*, nat, nat) : pstate
def $trace_frames_array(S, eps, n_outer, n_index) = S[.RESULT = KNOWN (PARRAY n_outer)]
def $trace_frames_array(S, ptraceframe :: ptraceframe_tail*, n_outer, n_index) = $trace_frames_array(S_frame[.ARRAYS = $array_replace(S_frame.ARRAYS, n_outer, $array_insert(S_frame.ARRAYS[n_outer], KINT n_index, DIRECT (PARRAY n_frame)))], ptraceframe_tail*, n_outer, $(n_index + 1))
  -- if S_frame = $trace_frame_array(S, ptraceframe)
  -- if S_frame.RESULT = KNOWN (PARRAY n_frame)

def $trace_materialize(S, ptraceframe*) = $trace_frames_array(S_outer, ptraceframe_values*, n_outer, 0)
  -- if (S_values, ptraceframe_values*) = $sensitive_trace_frames(S, ptraceframe*)
  -- if S_outer = $allocate_array(S_values, $array_empty())
  -- if S_outer.RESULT = KNOWN (PARRAY n_outer)

;; A paused state may not substitute a scalar, alias or fabricated frame array.
dec $trace_arguments_valid(pentry*) : bool
def $trace_arguments_valid(eps) = true
def $trace_arguments_valid((ENTRY pkey (DIRECT pvalue)) :: pentry_tail*) = $trace_arguments_valid(pentry_tail*)
def $trace_arguments_valid(pentry*) = false -- otherwise
dec $trace_argument_array_valid(pstate, nat) : bool
def $trace_argument_array_valid(S, n) = $trace_arguments_valid(S.ARRAYS[n].ITEMS)
  -- if $(n < |S.ARRAYS|)
  -- if (HARRAY n) <- S.ALLOCATIONS
def $trace_argument_array_valid(S, n) = false -- otherwise
dec $trace_frame_array_valid(pstate, nat, nat) : bool
def $trace_frame_array_valid(S, n, n_trace) = true
  -- if $(n < |S.ARRAYS|)
  -- if (HARRAY n) <- S.ALLOCATIONS
  -- if n =/= n_trace
  -- if S.ARRAYS[n].ITEMS = [ENTRY (KSTRING $ptascii("function")) (DIRECT (PSTRING preqbytes_function)), ENTRY (KSTRING $ptascii("args")) (DIRECT (PARRAY n_args))]
  -- if preqbytes_function =/= eps
  -- if n_args =/= n
  -- if n_args =/= n_trace
  -- if $trace_argument_array_valid(S, n_args)
def $trace_frame_array_valid(S, n, n_trace) = true
  -- if $(n < |S.ARRAYS|)
  -- if (HARRAY n) <- S.ALLOCATIONS
  -- if n =/= n_trace
  -- if S.ARRAYS[n].ITEMS = [ENTRY (KSTRING $ptascii("function")) (DIRECT (PSTRING preqbytes_function)), ENTRY (KSTRING $ptascii("class")) (DIRECT (PSTRING preqbytes_class)), ENTRY (KSTRING $ptascii("type")) (DIRECT (PSTRING preqbytes_type)), ENTRY (KSTRING $ptascii("args")) (DIRECT (PARRAY n_args))]
  -- if preqbytes_function =/= eps
  -- if preqbytes_class =/= eps
  -- if preqbytes_type <- [$ptascii("->"), $ptascii("::")]
  -- if n_args =/= n
  -- if n_args =/= n_trace
  -- if $trace_argument_array_valid(S, n_args)
def $trace_frame_array_valid(S, n, n_trace) = true
  -- if $(n < |S.ARRAYS|)
  -- if (HARRAY n) <- S.ALLOCATIONS
  -- if n =/= n_trace
  -- if S.ARRAYS[n].ITEMS = [ENTRY (KSTRING $ptascii("file")) (DIRECT (PSTRING preqbytes_file)), ENTRY (KSTRING $ptascii("line")) (DIRECT (PINT z_line)), ENTRY (KSTRING $ptascii("function")) (DIRECT (PSTRING preqbytes_function)), ENTRY (KSTRING $ptascii("args")) (DIRECT (PARRAY n_args))]
  -- if n_args =/= n
  -- if n_args =/= n_trace
  -- if $trace_argument_array_valid(S, n_args)
def $trace_frame_array_valid(S, n, n_trace) = true
  -- if $(n < |S.ARRAYS|)
  -- if (HARRAY n) <- S.ALLOCATIONS
  -- if n =/= n_trace
  -- if S.ARRAYS[n].ITEMS = [ENTRY (KSTRING $ptascii("file")) (DIRECT (PSTRING preqbytes_file)), ENTRY (KSTRING $ptascii("line")) (DIRECT (PINT z_line)), ENTRY (KSTRING $ptascii("function")) (DIRECT (PSTRING preqbytes_function)), ENTRY (KSTRING $ptascii("class")) (DIRECT (PSTRING preqbytes_class)), ENTRY (KSTRING $ptascii("type")) (DIRECT (PSTRING preqbytes_type)), ENTRY (KSTRING $ptascii("args")) (DIRECT (PARRAY n_args))]
  -- if preqbytes_type <- [$ptascii("->"), $ptascii("::")]
  -- if n_args =/= n
  -- if n_args =/= n_trace
  -- if $trace_argument_array_valid(S, n_args)
def $trace_frame_array_valid(S, n, n_trace) = true
  -- if $(n < |S.ARRAYS|)
  -- if (HARRAY n) <- S.ALLOCATIONS
  -- if n =/= n_trace
  -- if S.ARRAYS[n].ITEMS = [ENTRY (KSTRING $ptascii("file")) (DIRECT (PSTRING preqbytes_file)), ENTRY (KSTRING $ptascii("line")) (DIRECT (PINT z_line)), ENTRY (KSTRING $ptascii("function")) (DIRECT (PSTRING preqbytes_function))]
  -- if preqbytes_function <- [$ptascii("eval"), $ptascii("[constant expression]"), $ptascii("include"), $ptascii("include_once"), $ptascii("require"), $ptascii("require_once")]
def $trace_frame_array_valid(S, n, n_trace) = false -- otherwise
dec $trace_frames_valid(pstate, pentry*, nat, nat) : bool
def $trace_frames_valid(S, eps, n_index, n_trace) = true
def $trace_frames_valid(S, (ENTRY (KINT z_index) (DIRECT (PARRAY n_frame))) :: pentry_tail*, n_index, n_trace) = ($trace_frame_array_valid(S, n_frame, n_trace) /\ $trace_frames_valid(S, pentry_tail*, $(n_index + 1), n_trace))
  -- if z_index = n_index
def $trace_frames_valid(S, pentry*, n_index, n_trace) = false -- otherwise
def $trace_graph_valid(S, n_trace) = $trace_frames_valid(S, S.ARRAYS[n_trace].ITEMS, 0, n_trace)
  -- if $(n_trace < |S.ARRAYS|)
  -- if (HARRAY n_trace) <- S.ALLOCATIONS
def $trace_graph_valid(S, n_trace) = false -- otherwise

;; Pure comparison may descend through canonical frame/args arrays only when
;; every captured argument is a direct scalar (no callbacks or graph cycles).
dec $trace_compare_scalar(pstate, pvalue) : bool
def $trace_compare_scalar(S, PNULL) = true
def $trace_compare_scalar(S, PBOOL b) = true
def $trace_compare_scalar(S, PINT z) = true
def $trace_compare_scalar(S, PFLOAT n) = true
def $trace_compare_scalar(S, PSTRING preqbytes) = true
def $trace_compare_scalar(S, PSTRING_CARRIER pstringidentity preqbytes) = $string_carrier_valid(S, PSTRING_CARRIER pstringidentity preqbytes)
def $trace_compare_scalar(S, pvalue) = false -- otherwise
dec $trace_compare_args(pstate, pentry*) : bool
def $trace_compare_args(S, eps) = true
def $trace_compare_args(S, (ENTRY pkey (DIRECT pvalue)) :: pentry_tail*) = ($trace_compare_scalar(S, pvalue) /\ $trace_compare_args(S, pentry_tail*))
def $trace_compare_args(S, pentry*) = false -- otherwise
dec $trace_compare_frame(pstate, nat) : bool
def $trace_compare_frame(S, n_frame) = true
  -- if $(n_frame < |S.ARRAYS|)
  -- if (HARRAY n_frame) <- S.ALLOCATIONS
  -- if $entry_lookup(S.ARRAYS[n_frame].ITEMS, KSTRING $ptascii("args")) = eps
def $trace_compare_frame(S, n_frame) = $trace_compare_args(S, S.ARRAYS[n_args].ITEMS)
  -- if $(n_frame < |S.ARRAYS|)
  -- if (HARRAY n_frame) <- S.ALLOCATIONS
  -- if $entry_lookup(S.ARRAYS[n_frame].ITEMS, KSTRING $ptascii("args")) = (DIRECT (PARRAY n_args))
  -- if $(n_args < |S.ARRAYS|)
  -- if (HARRAY n_args) <- S.ALLOCATIONS
def $trace_compare_frame(S, n_frame) = false -- otherwise
dec $trace_compare_frames(pstate, pentry*) : bool
def $trace_compare_frames(S, eps) = true
def $trace_compare_frames(S, (ENTRY pkey (DIRECT (PARRAY n_frame))) :: pentry_tail*) = ($trace_compare_frame(S, n_frame) /\ $trace_compare_frames(S, pentry_tail*))
def $trace_compare_frames(S, pentry*) = false -- otherwise
def $trace_compare_graph(S, n_trace) = $trace_compare_frames(S, S.ARRAYS[n_trace].ITEMS)
  -- if $(n_trace < |S.ARRAYS|)
  -- if (HARRAY n_trace) <- S.ALLOCATIONS
  -- if $trace_graph_valid(S, n_trace)
def $trace_compare_graph(S, n_trace) = false -- otherwise

;; Captured array arguments may share descendants, but every path to a leaf is
;; finite and contains only direct arrays or callback-free scalar values.
dec $trace_array_payload_value(pstate, pvalue, nat*) : bool
dec $trace_array_payload_entries(pstate, pentry*, nat*) : bool
dec $trace_array_payload_node(pstate, nat, nat*) : bool
def $trace_array_payload_value(S, PARRAY n, n_seen*) = $trace_array_payload_node(S, n, n_seen*)
def $trace_array_payload_value(S, pvalue, n_seen*) = $trace_compare_scalar(S, pvalue) -- otherwise
def $trace_array_payload_entries(S, eps, n_seen*) = true
def $trace_array_payload_entries(S, (ENTRY pkey (DIRECT pvalue)) :: pentry_tail*, n_seen*) = ($trace_array_payload_value(S, pvalue, n_seen*) /\ $trace_array_payload_entries(S, pentry_tail*, n_seen*))
def $trace_array_payload_entries(S, pentry*, n_seen*) = false -- otherwise
def $trace_array_payload_node(S, n, n_seen*) = $trace_array_payload_entries(S, S.ARRAYS[n].ITEMS, n :: n_seen*)
  -- if $(n < |S.ARRAYS|)
  -- if (HARRAY n) <- S.ALLOCATIONS
  -- if ~(n <- n_seen*)
def $trace_array_payload_node(S, n, n_seen*) = false -- otherwise

dec $trace_array_frame(pstate, nat, nat) : bool
def $trace_array_frame(S, n_frame, n_trace) = true
  -- if $(n_frame < |S.ARRAYS|)
  -- if (HARRAY n_frame) <- S.ALLOCATIONS
  -- if $entry_lookup(S.ARRAYS[n_frame].ITEMS, KSTRING $ptascii("args")) = eps
def $trace_array_frame(S, n_frame, n_trace) = $trace_array_payload_entries(S, S.ARRAYS[n_args].ITEMS, [n_trace, n_frame, n_args])
  -- if $(n_frame < |S.ARRAYS|)
  -- if (HARRAY n_frame) <- S.ALLOCATIONS
  -- if $entry_lookup(S.ARRAYS[n_frame].ITEMS, KSTRING $ptascii("args")) = (DIRECT (PARRAY n_args))
  -- if $(n_args < |S.ARRAYS|)
  -- if (HARRAY n_args) <- S.ALLOCATIONS
def $trace_array_frame(S, n_frame, n_trace) = false -- otherwise
dec $trace_array_frames(pstate, pentry*, nat) : bool
def $trace_array_frames(S, eps, n_trace) = true
def $trace_array_frames(S, (ENTRY pkey (DIRECT (PARRAY n_frame))) :: pentry_tail*, n_trace) = ($trace_array_frame(S, n_frame, n_trace) /\ $trace_array_frames(S, pentry_tail*, n_trace))
def $trace_array_frames(S, pentry*, n_trace) = false -- otherwise
def $trace_array_graph(S, n_trace) = $trace_array_frames(S, S.ARRAYS[n_trace].ITEMS, n_trace)
  -- if $(n_trace < |S.ARRAYS|)
  -- if (HARRAY n_trace) <- S.ALLOCATIONS
  -- if $trace_graph_valid(S, n_trace)
def $trace_array_graph(S, n_trace) = false -- otherwise

;; A positive top-level array argument witnesses the new disjoint admission.
dec $trace_array_value_tag(pvalue) : bool
def $trace_array_value_tag(PARRAY n) = true
def $trace_array_value_tag(pvalue) = false -- otherwise
dec $trace_array_arg_items(pentry*) : bool
def $trace_array_arg_items(eps) = false
def $trace_array_arg_items((ENTRY pkey (DIRECT pvalue)) :: pentry_tail*) = ($trace_array_value_tag(pvalue) \/ $trace_array_arg_items(pentry_tail*))
def $trace_array_arg_items(pentry*) = false -- otherwise
dec $trace_frame_array_arg(pstate, nat) : bool
def $trace_frame_array_arg(S, n_frame) = $trace_array_arg_items(S.ARRAYS[n_args].ITEMS)
  -- if $(n_frame < |S.ARRAYS|)
  -- if (HARRAY n_frame) <- S.ALLOCATIONS
  -- if $entry_lookup(S.ARRAYS[n_frame].ITEMS, KSTRING $ptascii("args")) = (DIRECT (PARRAY n_args))
  -- if $(n_args < |S.ARRAYS|)
  -- if (HARRAY n_args) <- S.ALLOCATIONS
def $trace_frame_array_arg(S, n_frame) = false -- otherwise
dec $trace_frames_array_arg(pstate, pentry*) : bool
def $trace_frames_array_arg(S, eps) = false
def $trace_frames_array_arg(S, (ENTRY pkey (DIRECT (PARRAY n_frame))) :: pentry_tail*) = ($trace_frame_array_arg(S, n_frame) \/ $trace_frames_array_arg(S, pentry_tail*))
def $trace_frames_array_arg(S, pentry*) = false -- otherwise
def $trace_array_arg_present(S, n_trace) = $trace_frames_array_arg(S, S.ARRAYS[n_trace].ITEMS)
  -- if $(n_trace < |S.ARRAYS|)
  -- if (HARRAY n_trace) <- S.ALLOCATIONS
  -- if $trace_graph_valid(S, n_trace)
def $trace_array_arg_present(S, n_trace) = false -- otherwise

;; Backtrace capture copies a top-level array argument, retaining reference
;; cells inside it. A direct child keeps its captured value; an alias reads its
;; live primitive cell when the captured trace is compared.
dec $trace_alias_payload_value(pstate, pvalue, nat*) : bool
dec $trace_alias_payload_entries(pstate, pentry*, nat*) : bool
dec $trace_alias_payload_node(pstate, nat, nat*) : bool
def $trace_alias_payload_value(S, PARRAY n, n_seen*) = $trace_alias_payload_node(S, n, n_seen*)
def $trace_alias_payload_value(S, pvalue, n_seen*) = $trace_compare_scalar(S, pvalue) -- otherwise
def $trace_alias_payload_entries(S, eps, n_seen*) = true
def $trace_alias_payload_entries(S, (ENTRY pkey (DIRECT pvalue)) :: pentry_tail*, n_seen*) = ($trace_alias_payload_value(S, pvalue, n_seen*) /\ $trace_alias_payload_entries(S, pentry_tail*, n_seen*))
def $trace_alias_payload_entries(S, (ENTRY pkey (ALIAS n_cell)) :: pentry_tail*, n_seen*) = ($trace_compare_scalar(S, pvalue) /\ $trace_alias_payload_entries(S, pentry_tail*, n_seen*))
  -- if $(n_cell < |S.STORE|)
  -- if (HCELL n_cell) <- S.ALLOCATIONS
  -- if n_cell <- S.REFCELLS
  -- if S.STORE[n_cell] = DEFINED pvalue
def $trace_alias_payload_entries(S, pentry*, n_seen*) = false -- otherwise
def $trace_alias_payload_node(S, n, n_seen*) = $trace_alias_payload_entries(S, S.ARRAYS[n].ITEMS, n :: n_seen*)
  -- if $(n < |S.ARRAYS|)
  -- if (HARRAY n) <- S.ALLOCATIONS
  -- if ~(n <- n_seen*)
def $trace_alias_payload_node(S, n, n_seen*) = false -- otherwise

dec $trace_alias_frame(pstate, nat, nat) : bool
def $trace_alias_frame(S, n_frame, n_trace) = true
  -- if $(n_frame < |S.ARRAYS|)
  -- if (HARRAY n_frame) <- S.ALLOCATIONS
  -- if $entry_lookup(S.ARRAYS[n_frame].ITEMS, KSTRING $ptascii("args")) = eps
def $trace_alias_frame(S, n_frame, n_trace) = $trace_alias_payload_entries(S, S.ARRAYS[n_args].ITEMS, [n_trace, n_frame, n_args])
  -- if $(n_frame < |S.ARRAYS|)
  -- if (HARRAY n_frame) <- S.ALLOCATIONS
  -- if $entry_lookup(S.ARRAYS[n_frame].ITEMS, KSTRING $ptascii("args")) = (DIRECT (PARRAY n_args))
  -- if $(n_args < |S.ARRAYS|)
  -- if (HARRAY n_args) <- S.ALLOCATIONS
def $trace_alias_frame(S, n_frame, n_trace) = false -- otherwise
dec $trace_alias_frames(pstate, pentry*, nat) : bool
def $trace_alias_frames(S, eps, n_trace) = true
def $trace_alias_frames(S, (ENTRY pkey (DIRECT (PARRAY n_frame))) :: pentry_tail*, n_trace) = ($trace_alias_frame(S, n_frame, n_trace) /\ $trace_alias_frames(S, pentry_tail*, n_trace))
def $trace_alias_frames(S, pentry*, n_trace) = false -- otherwise
def $trace_alias_graph(S, n_trace) = $trace_alias_frames(S, S.ARRAYS[n_trace].ITEMS, n_trace)
  -- if $(n_trace < |S.ARRAYS|)
  -- if (HARRAY n_trace) <- S.ALLOCATIONS
  -- if $trace_graph_valid(S, n_trace)
def $trace_alias_graph(S, n_trace) = false -- otherwise

;; The witness is searched from captured args, with a path-local array stack.
dec $trace_alias_value_present(pstate, pvalue, nat*) : bool
dec $trace_alias_items_present(pstate, pentry*, nat*) : bool
dec $trace_alias_node_present(pstate, nat, nat*) : bool
def $trace_alias_value_present(S, PARRAY n, n_seen*) = $trace_alias_node_present(S, n, n_seen*)
def $trace_alias_value_present(S, pvalue, n_seen*) = false -- otherwise
def $trace_alias_items_present(S, eps, n_seen*) = false
def $trace_alias_items_present(S, (ENTRY pkey (ALIAS n_cell)) :: pentry_tail*, n_seen*) = true
def $trace_alias_items_present(S, (ENTRY pkey (DIRECT pvalue)) :: pentry_tail*, n_seen*) = ($trace_alias_value_present(S, pvalue, n_seen*) \/ $trace_alias_items_present(S, pentry_tail*, n_seen*))
def $trace_alias_items_present(S, pentry*, n_seen*) = false -- otherwise
def $trace_alias_node_present(S, n, n_seen*) = $trace_alias_items_present(S, S.ARRAYS[n].ITEMS, n :: n_seen*)
  -- if $(n < |S.ARRAYS|)
  -- if (HARRAY n) <- S.ALLOCATIONS
  -- if ~(n <- n_seen*)
def $trace_alias_node_present(S, n, n_seen*) = false -- otherwise
dec $trace_alias_frame_present(pstate, nat, nat) : bool
def $trace_alias_frame_present(S, n_frame, n_trace) = $trace_alias_items_present(S, S.ARRAYS[n_args].ITEMS, [n_trace, n_frame, n_args])
  -- if $(n_frame < |S.ARRAYS|)
  -- if (HARRAY n_frame) <- S.ALLOCATIONS
  -- if $entry_lookup(S.ARRAYS[n_frame].ITEMS, KSTRING $ptascii("args")) = (DIRECT (PARRAY n_args))
  -- if $(n_args < |S.ARRAYS|)
  -- if (HARRAY n_args) <- S.ALLOCATIONS
def $trace_alias_frame_present(S, n_frame, n_trace) = false -- otherwise
dec $trace_alias_frames_present(pstate, pentry*, nat) : bool
def $trace_alias_frames_present(S, eps, n_trace) = false
def $trace_alias_frames_present(S, (ENTRY pkey (DIRECT (PARRAY n_frame))) :: pentry_tail*, n_trace) = ($trace_alias_frame_present(S, n_frame, n_trace) \/ $trace_alias_frames_present(S, pentry_tail*, n_trace))
def $trace_alias_frames_present(S, pentry*, n_trace) = false -- otherwise
def $trace_alias_present(S, n_trace) = $trace_alias_frames_present(S, S.ARRAYS[n_trace].ITEMS, n_trace)
  -- if $(n_trace < |S.ARRAYS|)
  -- if (HARRAY n_trace) <- S.ALLOCATIONS
  -- if $trace_graph_valid(S, n_trace)
def $trace_alias_present(S, n_trace) = false -- otherwise

;; A nested reference cell may itself hold a live array. Carry the same
;; path-local array stack across DIRECT edges and the cell's current value.
dec $trace_array_cell_value(pstate, pvalue, nat*) : bool
dec $trace_array_cell_entries(pstate, pentry*, nat*) : bool
dec $trace_array_cell_node(pstate, nat, nat*) : bool
def $trace_array_cell_value(S, PARRAY n, n_seen*) = $trace_array_cell_node(S, n, n_seen*)
def $trace_array_cell_value(S, pvalue, n_seen*) = $trace_compare_scalar(S, pvalue) -- otherwise
def $trace_array_cell_entries(S, eps, n_seen*) = true
def $trace_array_cell_entries(S, (ENTRY pkey (DIRECT pvalue)) :: pentry_tail*, n_seen*) = ($trace_array_cell_value(S, pvalue, n_seen*) /\ $trace_array_cell_entries(S, pentry_tail*, n_seen*))
def $trace_array_cell_entries(S, (ENTRY pkey (ALIAS n_cell)) :: pentry_tail*, n_seen*) = ($trace_array_cell_value(S, pvalue, n_seen*) /\ $trace_array_cell_entries(S, pentry_tail*, n_seen*))
  -- if $(n_cell < |S.STORE|)
  -- if (HCELL n_cell) <- S.ALLOCATIONS
  -- if n_cell <- S.REFCELLS
  -- if S.STORE[n_cell] = DEFINED pvalue
def $trace_array_cell_entries(S, pentry*, n_seen*) = false -- otherwise
def $trace_array_cell_node(S, n, n_seen*) = $trace_array_cell_entries(S, S.ARRAYS[n].ITEMS, n :: n_seen*)
  -- if $(n < |S.ARRAYS|)
  -- if (HARRAY n) <- S.ALLOCATIONS
  -- if ~(n <- n_seen*)
def $trace_array_cell_node(S, n, n_seen*) = false -- otherwise

dec $trace_array_cell_frame(pstate, nat, nat) : bool
def $trace_array_cell_frame(S, n_frame, n_trace) = true
  -- if $(n_frame < |S.ARRAYS|)
  -- if (HARRAY n_frame) <- S.ALLOCATIONS
  -- if $entry_lookup(S.ARRAYS[n_frame].ITEMS, KSTRING $ptascii("args")) = eps
def $trace_array_cell_frame(S, n_frame, n_trace) = $trace_array_cell_entries(S, S.ARRAYS[n_args].ITEMS, [n_trace, n_frame, n_args])
  -- if $(n_frame < |S.ARRAYS|)
  -- if (HARRAY n_frame) <- S.ALLOCATIONS
  -- if $entry_lookup(S.ARRAYS[n_frame].ITEMS, KSTRING $ptascii("args")) = (DIRECT (PARRAY n_args))
  -- if $(n_args < |S.ARRAYS|)
  -- if (HARRAY n_args) <- S.ALLOCATIONS
def $trace_array_cell_frame(S, n_frame, n_trace) = false -- otherwise
dec $trace_array_cell_frames(pstate, pentry*, nat) : bool
def $trace_array_cell_frames(S, eps, n_trace) = true
def $trace_array_cell_frames(S, (ENTRY pkey (DIRECT (PARRAY n_frame))) :: pentry_tail*, n_trace) = ($trace_array_cell_frame(S, n_frame, n_trace) /\ $trace_array_cell_frames(S, pentry_tail*, n_trace))
def $trace_array_cell_frames(S, pentry*, n_trace) = false -- otherwise
def $trace_array_cell_graph(S, n_trace) = $trace_array_cell_frames(S, S.ARRAYS[n_trace].ITEMS, n_trace)
  -- if $(n_trace < |S.ARRAYS|)
  -- if (HARRAY n_trace) <- S.ALLOCATIONS
  -- if $trace_graph_valid(S, n_trace)
def $trace_array_cell_graph(S, n_trace) = false -- otherwise

;; Admission requires an array-valued reference in captured argument storage.
dec $trace_array_cell_value_present(pstate, pvalue, nat*) : bool
dec $trace_array_cell_items_present(pstate, pentry*, nat*) : bool
dec $trace_array_cell_node_present(pstate, nat, nat*) : bool
dec $trace_array_cell_alias_present(pstate, nat) : bool
def $trace_array_cell_value_present(S, PARRAY n, n_seen*) = $trace_array_cell_node_present(S, n, n_seen*)
def $trace_array_cell_value_present(S, pvalue, n_seen*) = false -- otherwise
def $trace_array_cell_items_present(S, eps, n_seen*) = false
def $trace_array_cell_items_present(S, (ENTRY pkey (ALIAS n_cell)) :: pentry_tail*, n_seen*) = ($trace_array_cell_alias_present(S, n_cell) \/ $trace_array_cell_items_present(S, pentry_tail*, n_seen*))
def $trace_array_cell_items_present(S, (ENTRY pkey (DIRECT pvalue)) :: pentry_tail*, n_seen*) = ($trace_array_cell_value_present(S, pvalue, n_seen*) \/ $trace_array_cell_items_present(S, pentry_tail*, n_seen*))
def $trace_array_cell_items_present(S, pentry*, n_seen*) = false -- otherwise
def $trace_array_cell_node_present(S, n, n_seen*) = $trace_array_cell_items_present(S, S.ARRAYS[n].ITEMS, n :: n_seen*)
  -- if $(n < |S.ARRAYS|)
  -- if (HARRAY n) <- S.ALLOCATIONS
  -- if ~(n <- n_seen*)
def $trace_array_cell_node_present(S, n, n_seen*) = false -- otherwise
def $trace_array_cell_alias_present(S, n_cell) = true
  -- if $(n_cell < |S.STORE|)
  -- if (HCELL n_cell) <- S.ALLOCATIONS
  -- if n_cell <- S.REFCELLS
  -- if S.STORE[n_cell] = DEFINED (PARRAY n)
  -- if $(n < |S.ARRAYS|)
  -- if (HARRAY n) <- S.ALLOCATIONS
def $trace_array_cell_alias_present(S, n_cell) = false -- otherwise
dec $trace_array_cell_frame_present(pstate, nat, nat) : bool
def $trace_array_cell_frame_present(S, n_frame, n_trace) = $trace_array_cell_items_present(S, S.ARRAYS[n_args].ITEMS, [n_trace, n_frame, n_args])
  -- if $(n_frame < |S.ARRAYS|)
  -- if (HARRAY n_frame) <- S.ALLOCATIONS
  -- if $entry_lookup(S.ARRAYS[n_frame].ITEMS, KSTRING $ptascii("args")) = (DIRECT (PARRAY n_args))
  -- if $(n_args < |S.ARRAYS|)
  -- if (HARRAY n_args) <- S.ALLOCATIONS
def $trace_array_cell_frame_present(S, n_frame, n_trace) = false -- otherwise
dec $trace_array_cell_frames_present(pstate, pentry*, nat) : bool
def $trace_array_cell_frames_present(S, eps, n_trace) = false
def $trace_array_cell_frames_present(S, (ENTRY pkey (DIRECT (PARRAY n_frame))) :: pentry_tail*, n_trace) = ($trace_array_cell_frame_present(S, n_frame, n_trace) \/ $trace_array_cell_frames_present(S, pentry_tail*, n_trace))
def $trace_array_cell_frames_present(S, pentry*, n_trace) = false -- otherwise
def $trace_array_cell_present(S, n_trace) = $trace_array_cell_frames_present(S, S.ARRAYS[n_trace].ITEMS, n_trace)
  -- if $(n_trace < |S.ARRAYS|)
  -- if (HARRAY n_trace) <- S.ALLOCATIONS
  -- if $trace_graph_valid(S, n_trace)
def $trace_array_cell_present(S, n_trace) = false -- otherwise

;; A captured stdClass argument keeps its object identity. Its current property
;; slots or already materialized table may contain only direct finite values.
dec $trace_std_slots(pstate, ppropertyslot*) : bool
def $trace_std_slots(S, eps) = true
def $trace_std_slots(S, ppropertyslot :: ppropertyslot_tail*) = ($trace_array_payload_value(S, pvalue, eps) /\ $trace_std_slots(S, ppropertyslot_tail*))
  -- if ppropertyslot.STATE = PROP_VALUE (DIRECT pvalue)
def $trace_std_slots(S, ppropertyslot*) = false -- otherwise
dec $trace_std_object(pstate, nat) : bool
def $trace_std_object(S, n) = $trace_std_slots(S, pobjectprops.SLOTS)
  -- if $(n < |S.OBJECTS|)
  -- if S.OBJECTS[n] = STDINSTANCE
  -- if (HOBJECT n) <- S.ALLOCATIONS
  -- if ~$instance_storage_freeing(S, n)
  -- if $objectprops_record_at(S.OBJECTPROPS, n) = (pobjectprops)
  -- if $stdclass_slots_valid(S, pobjectprops.SLOTS)
  -- if $object_table_at(S.OBJECTTABLES, n) = eps
def $trace_std_object(S, n) = $trace_array_payload_entries(S, S.ARRAYS[n_table].ITEMS, [n_table])
  -- if $(n < |S.OBJECTS|)
  -- if S.OBJECTS[n] = STDINSTANCE
  -- if (HOBJECT n) <- S.ALLOCATIONS
  -- if ~$instance_storage_freeing(S, n)
  -- if $objectprops_record_at(S.OBJECTPROPS, n) = (pobjectprops)
  -- if $stdclass_slots_valid(S, pobjectprops.SLOTS)
  -- if $object_table_at(S.OBJECTTABLES, n) = (n_table)
  -- if $aggregate_hash_image(S, n, n_table)
def $trace_std_object(S, n) = false -- otherwise

;; Match the two captured array shapes before using the callback-free effect
;; comparator. In particular, an object/number pair cannot suppress its Notice.
dec $trace_std_value_pair(pstate, pvalue, pvalue, nat*, nat*) : bool
dec $trace_std_entries_pair(pstate, pentry*, pentry*, nat*, nat*) : bool
dec $trace_std_array_pair(pstate, nat, nat, nat*, nat*) : bool
def $trace_std_value_pair(S, POBJECT n_left, POBJECT n_right, n_seen_left*, n_seen_right*) = ($trace_std_object(S, n_left) /\ $trace_std_object(S, n_right))
def $trace_std_value_pair(S, PARRAY n_left, PARRAY n_right, n_seen_left*, n_seen_right*) = $trace_std_array_pair(S, n_left, n_right, n_seen_left*, n_seen_right*)
def $trace_std_value_pair(S, pvalue_left, pvalue_right, n_seen_left*, n_seen_right*) = ($trace_compare_scalar(S, pvalue_left) /\ $trace_compare_scalar(S, pvalue_right)) -- otherwise
def $trace_std_entries_pair(S, eps, eps, n_seen_left*, n_seen_right*) = true
def $trace_std_entries_pair(S, (ENTRY pkey_left (DIRECT pvalue_left)) :: pentry_left*, (ENTRY pkey_right (DIRECT pvalue_right)) :: pentry_right*, n_seen_left*, n_seen_right*) = ($trace_std_value_pair(S, pvalue_left, pvalue_right, n_seen_left*, n_seen_right*) /\ $trace_std_entries_pair(S, pentry_left*, pentry_right*, n_seen_left*, n_seen_right*))
  -- if pkey_left = pkey_right
def $trace_std_entries_pair(S, pentry_left*, pentry_right*, n_seen_left*, n_seen_right*) = false -- otherwise
def $trace_std_array_pair(S, n_left, n_right, n_seen_left*, n_seen_right*) = $trace_std_entries_pair(S, S.ARRAYS[n_left].ITEMS, S.ARRAYS[n_right].ITEMS, n_left :: n_seen_left*, n_right :: n_seen_right*)
  -- if $(n_left < |S.ARRAYS| /\ n_right < |S.ARRAYS|)
  -- if $heap_subset([HARRAY n_left, HARRAY n_right], S.ALLOCATIONS)
  -- if ~(n_left <- n_seen_left* \/ n_right <- n_seen_right*)
def $trace_std_array_pair(S, n_left, n_right, n_seen_left*, n_seen_right*) = false -- otherwise
dec $trace_std_graph_pair(pstate, nat, nat) : bool
def $trace_std_graph_pair(S, n_left, n_right) = $trace_std_array_pair(S, n_left, n_right, eps, eps)
  -- if $trace_graph_valid(S, n_left) /\ $trace_graph_valid(S, n_right)
def $trace_std_graph_pair(S, n_left, n_right) = false -- otherwise

;; The positive witness is read from the captured trace, not a source CV.
dec $trace_std_value_present(pstate, pvalue, nat*) : bool
dec $trace_std_entries_present(pstate, pentry*, nat*) : bool
dec $trace_std_array_present(pstate, nat, nat*) : bool
def $trace_std_value_present(S, POBJECT n, n_seen*) = true
def $trace_std_value_present(S, PARRAY n, n_seen*) = $trace_std_array_present(S, n, n_seen*)
def $trace_std_value_present(S, pvalue, n_seen*) = false -- otherwise
def $trace_std_entries_present(S, eps, n_seen*) = false
def $trace_std_entries_present(S, (ENTRY pkey (DIRECT pvalue)) :: pentry_tail*, n_seen*) = ($trace_std_value_present(S, pvalue, n_seen*) \/ $trace_std_entries_present(S, pentry_tail*, n_seen*))
def $trace_std_entries_present(S, pentry*, n_seen*) = false -- otherwise
def $trace_std_array_present(S, n, n_seen*) = $trace_std_entries_present(S, S.ARRAYS[n].ITEMS, n :: n_seen*)
  -- if $(n < |S.ARRAYS|)
  -- if (HARRAY n) <- S.ALLOCATIONS
  -- if ~(n <- n_seen*)
def $trace_std_array_present(S, n, n_seen*) = false -- otherwise
dec $trace_std_present(pstate, nat) : bool
def $trace_std_present(S, n_trace) = $trace_std_array_present(S, n_trace, eps)
  -- if $(n_trace < |S.ARRAYS|)
  -- if (HARRAY n_trace) <- S.ALLOCATIONS
def $trace_std_present(S, n_trace) = false -- otherwise
