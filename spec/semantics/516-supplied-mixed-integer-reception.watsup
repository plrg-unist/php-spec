  -- if pcallcontext.HOLES = eps /\ pcallcontext.EXTRA = eps /\ pcallcontext.NAMED = eps
  -- if pcallcontext.CALLSITE = (porigin_call)
  -- if $origin_node(S.SOURCES, porigin_call) = (NExprFuncCall phpType19 (SEQUENCE phpType7*) metadata_call)
  -- if |phpType7*| = pcallcontext.ARGC /\ $lossy_positional_arguments(phpType7*)
  -- if $call_selected_valid(S, porigin_function, (porigin_call))
  -- if $function_at(S.FUNCTIONS, porigin_function) = (pfunction)
  -- if ~pfunction.SIGNATURE.BYREF /\ ~$function_generator(S, pfunction) /\ ~$generator_active(S)
  -- if S.ACTIVEFIBER = eps /\ S.CONSTCONTEXT = eps
  -- if $(2 <= |pfunction.SIGNATURE.PARAMETERS|) /\ $(pcallcontext.ARGC <= |pfunction.SIGNATURE.PARAMETERS|)
  -- if $lossy_required_integer_parameters(pfunction.SIGNATURE.PARAMETERS)
  -- if ~$lossy_positional_parameters(pfunction.SIGNATURE.PARAMETERS) /\ ~$lossy_positional_reference_parameters(pfunction.SIGNATURE.PARAMETERS)
  -- if ~$typed_caller_strict(S)
  -- if z = $default_parameter_line(S, porigin_function, n)
  -- if $parameter_string_site_valid(S, $default_parameter_origin(S, porigin_function, n), z)
  -- if $typed_receive_valid(S[.TODO = [TYPE_RECEIVE porigin_function n]][.ORIGIN = (porigin_function)], porigin_function, n)
def $lossy_mixed_parameter_metadata(S, porigin_function, n, z) = false -- otherwise

dec $lossy_mixed_parameter_source_valid(pstate, ptask) : bool
def $lossy_mixed_parameter_source_valid(S, LOSSY_MIXED_PARAMETER_RECEIVE porigin_function n n_cell n_bits i z) = true
  -- if $lossy_mixed_parameter_metadata(S, porigin_function, n, z)
  -- if S.ORIGIN = ($default_parameter_origin(S, porigin_function, n))
  -- if $function_at(S.FUNCTIONS, porigin_function) = (pfunction)
  -- if $lookup(S.ENV, pfunction.SIGNATURE.PARAMETERS[n].NAME) = (n_cell)
  -- if $(n_cell < |S.STORE|) /\ (HCELL n_cell) <- S.ALLOCATIONS
  -- if $lossy_parameter_snapshot(n_bits) = ((i, ptbytes))
def $lossy_mixed_parameter_source_valid(S, ptask) = false -- otherwise
def $call_task_valid(S, LOSSY_MIXED_PARAMETER_RECEIVE porigin_function n n_cell n_bits i z) = (S.TODO = [LOSSY_MIXED_PARAMETER_RECEIVE porigin_function n n_cell n_bits i z] /\ $lossy_mixed_parameter_source_valid(S, LOSSY_MIXED_PARAMETER_RECEIVE porigin_function n n_cell n_bits i z))
def $task_nodes(LOSSY_MIXED_PARAMETER_RECEIVE porigin_function n n_cell n_bits i z) = eps

dec $lossy_mixed_parameter_ready(pstate, nat, nat, nat) : bool
def $lossy_mixed_parameter_ready(S, n, n_cell, n_bits) = $lossy_positional_reference_parameter_ready(S, n, n_cell)
  -- if S.CURRENT = (pcallcontext)
  -- if $function_at(S.FUNCTIONS, pcallcontext.FUNCTION) = (pfunction)
  -- if $(n < |pfunction.SIGNATURE.PARAMETERS|)
  -- if pfunction.SIGNATURE.PARAMETERS[n].BYREF
def $lossy_mixed_parameter_ready(S, n, n_cell, n_bits) = $lossy_parameter_ready(S, n_cell, n_bits)
  -- if S.CURRENT = (pcallcontext)
  -- if $function_at(S.FUNCTIONS, pcallcontext.FUNCTION) = (pfunction)
  -- if $(n < |pfunction.SIGNATURE.PARAMETERS|)
  -- if ~pfunction.SIGNATURE.PARAMETERS[n].BYREF
def $lossy_mixed_parameter_ready(S, n, n_cell, n_bits) = false -- otherwise

dec $lossy_mixed_parameter_capture(pstate) : ptask?
def $lossy_mixed_parameter_capture(S) = (LOSSY_MIXED_PARAMETER_RECEIVE porigin_function n n_cell n_bits i z)
  -- if S.TODO = [TYPE_RECEIVE porigin_function n]
  -- if S.COMPLETION = NORMAL
  -- if $function_at(S.FUNCTIONS, porigin_function) = (pfunction)
  -- if $(n < |pfunction.SIGNATURE.PARAMETERS|)
  -- if $lookup(S.ENV, pfunction.SIGNATURE.PARAMETERS[n].NAME) = (n_cell)
  -- if $(n_cell < |S.STORE|) /\ (HCELL n_cell) <- S.ALLOCATIONS
  -- if S.STORE[n_cell] = DEFINED (PFLOAT n_bits)
  -- if z = $default_parameter_line(S, porigin_function, n)
  -- if $lossy_mixed_parameter_metadata(S, porigin_function, n, z)
  -- if $typed_parameter_conversion(S, pfunction.SIGNATURE.PARAMETERS[n], PFLOAT n_bits) = TYPEINTEGER (PFLOAT n_bits)
  -- if $lossy_parameter_snapshot(n_bits) = ((i, ptbytes))
def $lossy_mixed_parameter_capture(S) = eps -- otherwise
def $lossy_mixed_parameter_candidate(S) = ($lossy_mixed_parameter_capture(S) =/= eps)

rule PhpStep/lossy-mixed-parameter-begin: S ~> $error_dispatch(S[.TODO = [ptask_source]][.ORIGIN = (porigin_site)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], 8192, ptbytes, z, DIAGNOSTIC "Deprecated" ptbytes z, ptask_source)
