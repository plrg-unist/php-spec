;; The immutable formal mode selects a copied value or current referent.
;; This indexed conversion snapshot borrows its cell and adds no owner.
dec $lossy_required_integer_parameters(psparam*) : bool
def $lossy_required_integer_parameters(eps) = true
def $lossy_required_integer_parameters(psparam :: psparam_tail*) = (psparam.REQUIRED /\ psparam.DEFAULT = PSNONE /\ ~psparam.VARIADIC /\ $ptmasks(psparam.TYPE) = ["int"] /\ $lossy_required_integer_parameters(psparam_tail*))

dec $lossy_mixed_parameter_metadata(pstate, porigin, nat, int) : bool
def $lossy_mixed_parameter_metadata(S, porigin_function, n, z) = true
