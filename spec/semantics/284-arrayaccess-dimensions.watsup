def $access_entered(S, (pcallcontext), pframe :: pframe_tail*, pcalltarget, porigin) = $access_frame(S, pcallcontext, pframe)
  -- if $context_target(pcallcontext) = pcalltarget
  -- if pcallcontext.CALLSITE = (porigin)
def $access_entered(S, (pcallcontext), pframe :: pframe_tail*, pcalltarget, porigin) = $access_entered(S, pframe.CONTEXT, pframe_tail*, pcalltarget, porigin)
  -- if ~($context_target(pcallcontext) = pcalltarget /\ pcallcontext.CALLSITE = (porigin))
def $access_entered(S, eps, pframe :: pframe_tail*, pcalltarget, porigin) = $access_entered(S, pframe.CONTEXT, pframe_tail*, pcalltarget, porigin)
def $access_entered(S, pcallcontext?, eps, pcalltarget, porigin) = false
def $access_selected(S, pcalltarget, porigin) = ($access_pending(S, pcalltarget, porigin) \/ $access_entered(S, S.CURRENT, S.FRAMES, pcalltarget, porigin))
def $access_context_kind(S, pcallcontext) = true
  -- if $context_target(pcallcontext) = METHOD_TARGET n porigin_method
  -- if pcallcontext.CALLSITE = (porigin)
  -- if $origin_node(S.SOURCES, porigin) = (pcnode)
  -- if $class_method_origin(S.CLASSES, porigin_method) = (pmethoddesc)
  -- if $access_context_node(pcnode, $ptlc(pmethoddesc.NAME))
  -- if S.OBJECTS[n] = INSTANCE porigin_class
  -- if $effective_method(S, porigin_class, pmethoddesc.NAME, |S.CLASSES|) = (pmethoddesc)
  -- if $access_instance(S, POBJECT n)
def $access_context_kind(S, pcallcontext) = false -- otherwise
def $access_context(S, pcallcontext) = true
  -- if $access_context_kind(S, pcallcontext)
  -- if pcallcontext.CALLSITE = (porigin)
  -- if $access_entered(S, S.CURRENT, S.FRAMES, $context_target(pcallcontext), porigin)
def $access_context(S, pcallcontext) = false -- otherwise
def $access_marker(pframe) = true -- if pframe.TODO = (ACCESS_RESULT paccess) :: ptask_tail*
def $access_marker(pframe) = false -- otherwise
def $access_chain(S, eps, eps) = true
def $access_chain(S, (pcallcontext), eps) = ~$access_context_kind(S, pcallcontext)
def $access_chain(S, (pcallcontext), pframe :: pframe_tail*) = ($access_frame(S, pcallcontext, pframe) /\ $access_chain(S, pframe.CONTEXT, pframe_tail*))
  -- if $access_context_kind(S, pcallcontext) \/ $access_marker(pframe)
def $access_chain(S, (pcallcontext), pframe :: pframe_tail*) = $access_chain(S, pframe.CONTEXT, pframe_tail*)
  -- if ~$access_context_kind(S, pcallcontext)
  -- if ~$access_marker(pframe)
def $access_chain(S, eps, pframe :: pframe_tail*) = $access_chain(S, pframe.CONTEXT, pframe_tail*) -- if ~$access_marker(pframe)
def $access_chain(S, eps, pframe :: pframe_tail*) = false -- if $access_marker(pframe)

def $call_line_valid(S, (porigin), z) = true
  -- if $access_pending_site(S, porigin)
  -- if S.TODO = (CALL_ARGS pcalltarget eps n poperand* (porigin) z) :: ptask_tail*
def $call_arguments_valid(S, (porigin), n, eps, poperand*, 0) = true
  -- if $access_pending_site(S, porigin)
  -- if n = |poperand*|
  -- if S.TODO = (CALL_ARGS pcalltarget eps n poperand* (porigin) z) :: ptask_tail*
def $call_arity_valid(S, pcallcontext) = $access_context(S, pcallcontext) -- if $access_context_kind(S, pcallcontext)
def $call_extent_valid(S, pcallcontext) = $access_context(S, pcallcontext) -- if $access_context_kind(S, pcallcontext)
def $named_context_valid(S, pcallcontext) = $access_context(S, pcallcontext) -- if $access_context_kind(S, pcallcontext)

def $access_known_base(BASE_VALUE (KNOWN pvalue)) = true
def $access_known_base(pbase) = false -- otherwise
def $access_context_node(NExprArrayDimFetch expression phpType5 metadata, ptbytes) = (ptbytes <- [$ptascii("offsetexists"), $ptascii("offsetget"), $ptascii("offsetunset")])
def $access_context_node(NExprAssign (NExprArrayDimFetch expression phpType5 metadata_dim) expression_rhs metadata, ptbytes) = (ptbytes = $ptascii("offsetset"))
def $access_context_node(pcnode, ptbytes) = false -- otherwise

;; This terminal is reached from the scalar helper only after its key U. It has
;; no VM receiver pin; std_has_dimension supplies the sole handler protection.
def $access_container(S, pcontainerread, n) = $access_call(S, paccess, $ptascii("offsetExists"))
  -- if paccess = {SITE pcontainerread.READ.SITE, TARGET pcontainerread.READ.SITE, LINE pcontainerread.READ.LINE, KEYLINE pcontainerread.READ.LINE, MODE ACCESS_READ pcontainerread.READ.MODE, BASE pcontainerread.READ.OWNERS, INPUT pcontainerread.READ.INPUT, RHS KNOWN PNULL, SELECTED pcontainerread.SELECTED, OBJECT (n), OFFSET pcontainerread.READ.VALUE, VALUE PNULL, LATCH (pcontainerread.READ.PHASE = KEY_CV), OUTER false, TASK KEY_READ_DIM pcontainerread.READ.INPUT pcontainerread.READ.LINE pcontainerread.READ.MODE, PHASE ACCESS_CALL $ptascii("offsetExists")}

def $access_cv_operand(VARIABLE n_name* z) = true
def $access_cv_operand(poperand) = false -- otherwise

def $access_read_object(n, KEY_TEST b) = eps
def $access_read_object(n, pkeymode) = (n) -- if ~$key_test_mode(pkeymode)

;; This admission probe performs no user call and retains no roots. Any observed
;; diagnostic belongs to the real KEY_READ_BASE execution, not to this predicate.
def $access_probe(S, pbase) = true
  -- if S_probe = $quiet_base(S, pbase, $(-1))
  -- if S_probe.COMPLETION = NORMAL
  -- if S_probe.RESULT = KNOWN pvalue
  -- if $access_instance(S, pvalue)
def $access_probe(S, pbase) = false -- otherwise
