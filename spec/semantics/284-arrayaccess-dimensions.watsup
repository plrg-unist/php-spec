def $access_base_source(S, paccess) = $key_read_owners_source(S, {SITE paccess.TARGET, GLOBAL false, MODE KEY_R, INPUT paccess.INPUT, VALUE PNULL, BASE pvalue, OWNERS paccess.BASE, LINE paccess.KEYLINE, PHASE KEY_NULL, KEY KSTRING eps, NAME eps})
