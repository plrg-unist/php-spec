;; Zend 8.5.10 ArrayAccess contracts and language-triggered ordinary method calls.
dec $arrayaccess_members() : ptbytes*
dec $arrayaccess_parameter(text) : psparam
dec $arrayaccess_signature(ptbytes) : pssignature
dec $arrayaccess_scope() : pvclass
dec $arrayaccess_member_name(ptbytes) : ptbytes
dec $arrayaccess_method_issue(pstate, pclassdesc, pmethoddesc) : pmethodissue
dec $arrayaccess_method_compared(pstate, pclassdesc, pmethoddesc, pmmethod, pmmethod, pmcheck) : pmethodissue
dec $arrayaccess_methods(pstate, pclassdesc, ptbytes*, ppmethodinherited*) : pmethodissue
dec $arrayaccess_abstract(pstate, pclassdesc, ptbytes*, pilabstract*) : pilabstract*
dec $arrayaccess_notice_return(pstate, pclassdesc, pmethoddesc) : pmcheck
dec $arrayaccess_notice_method(pstate, pclassdesc, pclassdesc, pmethoddesc, pmcheck) : pdeclnoticeplan
dec $arrayaccess_notice_members(pstate, pclassdesc, ptbytes*, ppmethodinherited*, ppmethodinherited*) : pdeclnoticeplan
dec $access_base(pstate, pbase) : bool
dec $access_probe(pstate, pbase) : bool
dec $access_record(pstate, porigin, int, paccessmode, pbase, poperand, poperand, ptask, nat?, bool) : paccess
dec $access_dimension(pstate, poperand, int, pkeymode) : pstate
dec $access_set_plan(pstate) : paccess?
dec $access_key(pstate, paccess) : pstate
dec $access_key_done(pstate, paccess) : pstate
dec $access_value(pstate, paccess) : pstate
dec $access_offset(pstate, paccess) : pstate
dec $access_live(pstate, paccess) : pstate
dec $access_call(pstate, paccess, ptbytes) : pstate
dec $access_arguments(paccess) : poperand*
dec $access_nonobject(pstate, paccess, pvalue) : pstate
dec $access_result(pstate, paccess, pvalue) : pstate
dec $access_result_done(pstate, paccess, pvalue) : pstate
dec $access_truth_consumed(paccess) : bool
dec $access_truth_warning(pvalue) : bool
dec $access_truth_phase(paccessphase) : bool
dec $access_cv_phase(paccessphase) : bool
dec $access_predicate(pstate, paccess, bool) : pstate
dec $access_warning_name(paccess) : ptbytes
dec $access_dispatch(pstate, paccess) : pstate
dec $access_roots(paccess, bool) : pnode*
dec $access_object_roots(nat?, bool) : pnode*
dec $access_offset_roots(pvalue, bool) : pnode*
dec $access_source(pstate, paccess) : bool
dec $access_base_source(pstate, paccess) : bool
dec $access_phase(paccess) : bool
dec $access_valid(pstate, paccess) : bool
dec $access_capture_valid(paccess) : bool
dec $access_selected_valid(paccess) : bool
dec $access_rhs_selected(poperand, poperand, pvalue) : bool
dec $access_object_valid(pstate, nat?) : bool
dec $access_call_phase(paccessphase) : bool
dec $access_method_selected(pstate, paccess, pcalltarget) : bool
dec $access_pending(pstate, pcalltarget, porigin) : bool
dec $access_frame(pstate, pcallcontext, pframe) : bool
dec $access_entered(pstate, pcallcontext?, pframe*, pcalltarget, porigin) : bool
dec $access_marker(pframe) : bool
dec $access_known_base(pbase) : bool
dec $access_context_node(pcnode, ptbytes) : bool
dec $access_cv_operand(poperand) : bool
dec $access_read_object(nat, pkeymode) : nat?
def $arrayaccess_members() = [$ptascii("offsetExists"), $ptascii("offsetGet"), $ptascii("offsetSet"), $ptascii("offsetUnset")]
def $arrayaccess_parameter(text) = { NAME $ptascii(text), TYPE ([(PTBRANCH ([PTBUILTIN "mixed"]))]), BYREF false, VARIADIC false, REQUIRED true, DEFAULT PSNONE }
def $arrayaccess_signature(ptbytes) = { PARAMETERS ([$arrayaccess_parameter("offset")]), RETURNS ([(PTBRANCH ([PTBUILTIN "bool"]))]), BYREF false }
  -- if $ptlc(ptbytes) = $ptascii("offsetexists")
def $arrayaccess_signature(ptbytes) = { PARAMETERS ([$arrayaccess_parameter("offset")]), RETURNS ([(PTBRANCH ([PTBUILTIN "mixed"]))]), BYREF false }
  -- if $ptlc(ptbytes) = $ptascii("offsetget")
def $arrayaccess_signature(ptbytes) = { PARAMETERS ([$arrayaccess_parameter("offset"), $arrayaccess_parameter("value")]), RETURNS ([(PTBRANCH ([PTBUILTIN "void"]))]), BYREF false }
  -- if $ptlc(ptbytes) = $ptascii("offsetset")
def $arrayaccess_signature(ptbytes) = { PARAMETERS ([$arrayaccess_parameter("offset")]), RETURNS ([(PTBRANCH ([PTBUILTIN "void"]))]), BYREF false }
  -- if $ptlc(ptbytes) = $ptascii("offsetunset")
def $arrayaccess_scope() = { NAME $ptascii("ArrayAccess"), PARENT eps, ANCESTORS eps, FINAL false }
def $arrayaccess_member_name(ptbytes) = $ptascii("offsetExists") -- if $ptlc(ptbytes) = $ptascii("offsetexists")
def $arrayaccess_member_name(ptbytes) = $ptascii("offsetGet") -- if $ptlc(ptbytes) = $ptascii("offsetget")
def $arrayaccess_member_name(ptbytes) = $ptascii("offsetSet") -- if $ptlc(ptbytes) = $ptascii("offsetset")
def $arrayaccess_member_name(ptbytes) = $ptascii("offsetUnset") -- if $ptlc(ptbytes) = $ptascii("offsetunset")
def $arrayaccess_method_issue(S, pclassdesc, pmethoddesc) = METHOD_FILEISSUE ($ptascii("Cannot make non static method ArrayAccess::") ++ $arrayaccess_member_name(pmethoddesc.NAME) ++ $ptascii("() static in class ") ++ pclassdesc.NAME) pmethoddesc.FUNCTION.LINE pmethoddesc.FUNCTION.ORIGIN
  -- if pmethoddesc.STATIC
def $arrayaccess_method_issue(S, pclassdesc, pmethoddesc) = METHOD_FILEISSUE ($ptascii("Access level to ") ++ pclassdesc.NAME ++ $ptascii("::") ++ pmethoddesc.NAME ++ $ptascii("() must be public (as in class ArrayAccess)")) pmethoddesc.FUNCTION.LINE pmethoddesc.FUNCTION.ORIGIN
  -- if ~pmethoddesc.STATIC
  -- if pmethoddesc.VISIBILITY =/= PROPERTY_PUBLIC
def $arrayaccess_method_issue(S, pclassdesc, pmethoddesc) = $arrayaccess_method_compared(S, pclassdesc, pmethoddesc, pmmethod_selected, pmmethod_proto, $pmcompare(PMUSER pmmethod_selected, $pil_scope(S, pclassdesc), PMUSER pmmethod_proto[.SIGNATURE = pmmethod_proto.SIGNATURE[.RETURNS = eps]], $arrayaccess_scope(), $method_active_registry(S, S.CLASSNAMES)))
  -- if ~pmethoddesc.STATIC
  -- if pmethoddesc.VISIBILITY = PROPERTY_PUBLIC
  -- if pmmethod_selected = $pmethod_user(pmethoddesc, pclassdesc, $call_sourcefile(S.FILES, pmethoddesc.FUNCTION.ORIGIN))
  -- if pmmethod_proto = $pil_signature_method($ptascii("ArrayAccess"), $arrayaccess_member_name(pmethoddesc.NAME), $call_sourcefile(S.FILES, pmethoddesc.FUNCTION.ORIGIN), $arrayaccess_signature(pmethoddesc.NAME))
def $arrayaccess_method_compared(S, pclassdesc, pmethoddesc, pmmethod_selected, pmmethod_proto, PMCHECK PVYES ptbytes*) = METHOD_OK
def $arrayaccess_method_compared(S, pclassdesc, pmethoddesc, pmmethod_selected, pmmethod_proto, PMCHECK PVNO ptbytes*) = $pil_internal_source_result(pmethoddesc[.OWNER = pmethoddesc.FUNCTION.ORIGIN], $pmmismatch(pmmethod_selected, $pil_scope(S, pclassdesc), pmmethod_proto, $arrayaccess_scope(), 14))
def $arrayaccess_method_compared(S, pclassdesc, pmethoddesc, pmmethod_selected, pmmethod_proto, PMCHECK PVUNRESOLVED ptbytes*) = METHOD_UNSUPPORTED "ArrayAccess dependent method declaration"
def $arrayaccess_method_compared(S, pclassdesc, pmethoddesc, pmmethod_selected, pmmethod_proto, PMUNSUPPORTED text) = METHOD_UNSUPPORTED text
def $arrayaccess_methods(S, pclassdesc, eps, ppmethodinherited*) = METHOD_OK
def $arrayaccess_methods(S, pclassdesc, ptbytes :: ptbytes_tail*, ppmethodinherited*) = $arrayaccess_methods(S, pclassdesc, ptbytes_tail*, ppmethodinherited*)
  -- if $pil_selected(S, pclassdesc, ptbytes, ppmethodinherited*) = eps
def $arrayaccess_methods(S, pclassdesc, ptbytes :: ptbytes_tail*, ppmethodinherited*) = $arrayaccess_methods(S, pclassdesc, ptbytes_tail*, ppmethodinherited*)
  -- if $pil_selected(S, pclassdesc, ptbytes, ppmethodinherited*) = (PPMINHERITED pmethoddesc pclassdesc_selected)
  -- if $arrayaccess_method_issue(S, pclassdesc_selected, pmethoddesc) = METHOD_OK
def $arrayaccess_methods(S, pclassdesc, ptbytes :: ptbytes_tail*, ppmethodinherited*) = pmethodissue
  -- if $pil_selected(S, pclassdesc, ptbytes, ppmethodinherited*) = (PPMINHERITED pmethoddesc pclassdesc_selected)
  -- if pmethodissue = $arrayaccess_method_issue(S, pclassdesc_selected, pmethoddesc)
  -- if pmethodissue =/= METHOD_OK
def $arrayaccess_after_issue(S, pclassdesc, METHOD_OK) = $arrayaccess_methods(S, pclassdesc, $arrayaccess_members(), $pil_info_extra(S, pclassdesc.ORIGIN, $ppmethod_own(pclassdesc, pclassdesc.METHODS), |S.CLASSES|))
  -- if $class_origin_matches(S, pclassdesc.ORIGIN, $ptascii("ArrayAccess"), |S.CLASSES|)
def $arrayaccess_after_issue(S, pclassdesc, pmethodissue) = pmethodissue -- otherwise
def $pil_order_one(S, pclassdesc, PILBUILTIN ptbytes, pilref_seen*, ppmethodinherited*) = $arrayaccess_methods(S, pclassdesc, $arrayaccess_members(), ppmethodinherited*)
  -- if $ptlc(ptbytes) = $ptascii("arrayaccess")
def $arrayaccess_abstract(S, pclassdesc, eps, pilabstract*) = pilabstract*
def $arrayaccess_abstract(S, pclassdesc, ptbytes :: ptbytes_tail*, pilabstract*) = $arrayaccess_abstract(S, pclassdesc, ptbytes_tail*, $pil_abs_add(S, pclassdesc, ptbytes, $ptascii("ArrayAccess::") ++ ptbytes, pilabstract*))
def $pil_abs_refs(S, pclassdesc_child, (PILBUILTIN ptbytes) :: pilref_tail*, n, pilabstract*) = $pil_abs_refs(S, pclassdesc_child, pilref_tail*, n, $arrayaccess_abstract(S, pclassdesc_child, $arrayaccess_members(), pilabstract*))
  -- if $ptlc(ptbytes) = $ptascii("arrayaccess")
def $arrayaccess_parent_publish(S, S_parent, pclassdesc) = $pil_method_publish(S, S_parent, pclassdesc)
  -- if $class_origin_matches(S_parent, pclassdesc.ORIGIN, $ptascii("ArrayAccess"), |S_parent.CLASSES|)
def $arrayaccess_parent_publish(S, S_parent, pclassdesc) = S_parent -- otherwise

;; Tentative return declarations use the existing published-class notice queue.
def $arrayaccess_notice_return(S, pclassdesc, pmethoddesc) = $pmcompare(PMUSER pmmethod_selected, $pil_scope(S, pclassdesc), PMUSER pmmethod_proto, $arrayaccess_scope(), $method_active_registry(S, S.CLASSNAMES))
  -- if pmmethod_selected = $pmethod_user(pmethoddesc, pclassdesc, $call_sourcefile(S.FILES, pmethoddesc.FUNCTION.ORIGIN))
  -- if pmmethod_proto = $pil_signature_method($ptascii("ArrayAccess"), $arrayaccess_member_name(pmethoddesc.NAME), $call_sourcefile(S.FILES, pmethoddesc.FUNCTION.ORIGIN), $arrayaccess_signature(pmethoddesc.NAME))
def $arrayaccess_notice_method(S, pclassdesc, pclassdesc_selected, pmethoddesc, PMCHECK PVYES ptbytes*) = DECLNOTICES eps
def $arrayaccess_notice_method(S, pclassdesc, pclassdesc_selected, pmethoddesc, PMCHECK PVNO ptbytes*) = DECLNOTICES eps
  -- if $iterator_notice_suppressed(S, pmethoddesc)
def $arrayaccess_notice_method(S, pclassdesc, pclassdesc_selected, pmethoddesc, PMCHECK PVNO ptbytes*) = DECLNOTICES ([{CLASS pclassdesc.ORIGIN, METHOD pmethoddesc.FUNCTION.ORIGIN, LINE pmethoddesc.FUNCTION.LINE, MESSAGE ($ptascii("Return type of ") ++ ptbytes_child ++ $ptascii(" should either be compatible with ") ++ ptbytes_parent ++ $ptascii(", or the #[\\ReturnTypeWillChange] attribute should be used to temporarily suppress the notice"))}])
  -- if ~$iterator_notice_suppressed(S, pmethoddesc)
  -- if $pmcdisplay($pmdeclaration($pmethod_user(pmethoddesc, pclassdesc_selected, $call_sourcefile(S.FILES, pmethoddesc.FUNCTION.ORIGIN)), $pil_scope(S, pclassdesc_selected), 14)) = PMTEXT ptbytes_child
  -- if $pmcdisplay($pmdeclaration($pil_signature_method($ptascii("ArrayAccess"), $arrayaccess_member_name(pmethoddesc.NAME), $call_sourcefile(S.FILES, pmethoddesc.FUNCTION.ORIGIN), $arrayaccess_signature(pmethoddesc.NAME)), $arrayaccess_scope(), 14)) = PMTEXT ptbytes_parent
def $arrayaccess_notice_method(S, pclassdesc, pclassdesc_selected, pmethoddesc, PMCHECK PVUNRESOLVED ptbytes*) = DECLNOTICESUNSUPPORTED "ArrayAccess tentative dependent return declaration"
def $arrayaccess_notice_method(S, pclassdesc, pclassdesc_selected, pmethoddesc, PMUNSUPPORTED text) = DECLNOTICESUNSUPPORTED text
def $arrayaccess_notice_members(S, pclassdesc, eps, ppmethodinherited_mask*, ppmethodinherited*) = DECLNOTICES eps
def $arrayaccess_notice_members(S, pclassdesc, ptbytes :: ptbytes_tail*, ppmethodinherited_mask*, ppmethodinherited*) = $arrayaccess_notice_members(S, pclassdesc, ptbytes_tail*, ppmethodinherited_mask*, ppmethodinherited*)
  -- if $pil_selected(S, pclassdesc, ptbytes, ppmethodinherited*) = eps
def $arrayaccess_notice_members(S, pclassdesc, ptbytes :: ptbytes_tail*, ppmethodinherited_mask*, ppmethodinherited*) = DECLNOTICES eps
  -- if $pil_selected(S, pclassdesc, ptbytes, ppmethodinherited*) = (PPMINHERITED pmethoddesc pclassdesc_selected)
  -- if $arrayaccess_method_issue(S, pclassdesc_selected, pmethoddesc) =/= METHOD_OK
def $arrayaccess_notice_members(S, pclassdesc, ptbytes :: ptbytes_tail*, ppmethodinherited_mask*, ppmethodinherited*) = $arrayaccess_notice_members(S, pclassdesc, ptbytes_tail*, ppmethodinherited_mask*, ppmethodinherited*)
  -- if $pil_selected(S, pclassdesc, ptbytes, ppmethodinherited*) = (PPMINHERITED pmethoddesc pclassdesc_selected)
  -- if $arrayaccess_method_issue(S, pclassdesc_selected, pmethoddesc) = METHOD_OK
  -- if $pil_info_named(ppmethodinherited_mask*, ptbytes)
def $arrayaccess_notice_members(S, pclassdesc, ptbytes :: ptbytes_tail*, ppmethodinherited_mask*, ppmethodinherited*) = $iterator_notice_join($arrayaccess_notice_method(S, pclassdesc, pclassdesc_selected, pmethoddesc, $arrayaccess_notice_return(S, pclassdesc_selected, pmethoddesc)), $arrayaccess_notice_members(S, pclassdesc, ptbytes_tail*, ppmethodinherited_mask*, ppmethodinherited*))
  -- if $pil_selected(S, pclassdesc, ptbytes, ppmethodinherited*) = (PPMINHERITED pmethoddesc pclassdesc_selected)
  -- if $arrayaccess_method_issue(S, pclassdesc_selected, pmethoddesc) = METHOD_OK
  -- if ~$pil_info_named(ppmethodinherited_mask*, ptbytes)

def $arrayaccess_notice_parent(S, pclassdesc, ppmethodinherited*) = $arrayaccess_notice_members(S, pclassdesc, $arrayaccess_members(), $method_info_layout(S, porigin_parent, |S.CLASSES|), ppmethodinherited*)
  -- if $class_link_at(S.LINKEDPARENTS, pclassdesc.ORIGIN) = (SOURCE_PARENT porigin_parent)
  -- if $class_origin_matches(S, porigin_parent, $ptascii("ArrayAccess"), |S.CLASSES|)
def $arrayaccess_notice_parent(S, pclassdesc, ppmethodinherited*) = DECLNOTICES eps -- otherwise
def $arrayaccess_notice_source(S, pclassdesc, porigin, ppmethodinherited*) = DECLNOTICESUNSUPPORTED "combined Iterator/ArrayAccess source interface notice order"
  -- if $pil_nominal(S, porigin, $ptascii("Iterator"), |S.CLASSES|)
  -- if $pil_nominal(S, porigin, $ptascii("ArrayAccess"), |S.CLASSES|)
def $arrayaccess_notice_source(S, pclassdesc, porigin, ppmethodinherited*) = $arrayaccess_notice_members(S, pclassdesc, $arrayaccess_members(), $pil_proto_source(S, porigin, |S.CLASSES|), ppmethodinherited*)
  -- if $pil_nominal(S, porigin, $ptascii("ArrayAccess"), |S.CLASSES|)
  -- if ~$pil_nominal(S, porigin, $ptascii("Iterator"), |S.CLASSES|)
def $arrayaccess_notice_source(S, pclassdesc, porigin, ppmethodinherited*) = DECLNOTICES eps -- otherwise
def $iterator_notice_ref(S, pclassdesc, PILBUILTIN ptbytes, pilref_seen*, ppmethodinherited*) = $arrayaccess_notice_members(S, pclassdesc, $arrayaccess_members(), eps, ppmethodinherited*)
  -- if ~$iterator_notice_parent_has(S, pclassdesc, PILBUILTIN ptbytes)
  -- if $class_constant_interface_issue(S, pclassdesc, PILBUILTIN ptbytes, pilref_seen*) = METHOD_OK
  -- if $ptlc(ptbytes) = $ptascii("arrayaccess")
def $iterator_notice_ref(S, pclassdesc, PILSOURCE ptbytes porigin, pilref_seen*, ppmethodinherited*) = $arrayaccess_notice_source(S, pclassdesc, porigin, ppmethodinherited*)
  -- if ~$iterator_notice_parent_has(S, pclassdesc, PILSOURCE ptbytes porigin)
  -- if $class_constant_interface_issue(S, pclassdesc, PILSOURCE ptbytes porigin, pilref_seen*) = METHOD_OK
  -- if $pil_method_items(S, pclassdesc, $pil_proto_source(S, porigin, |S.CLASSES|), ppmethodinherited*) = METHOD_OK
  -- if ~$pil_nominal(S, porigin, $ptascii("Iterator"), |S.CLASSES|)
  -- if $pil_nominal(S, porigin, $ptascii("ArrayAccess"), |S.CLASSES|)

;; The original operands, the VM's outer object pin and std-handler offset copy
;; are distinct roots. SELECTED and VALUE are borrowed facts, never extra owners.
def $access_instance(S, POBJECT n) = $class_instanceof(S, POBJECT n, $ptascii("ArrayAccess"))
def $access_instance(S, pvalue) = false -- otherwise
def $access_base(S, BASE_VALUE poperand) = $access_instance(S, pvalue)
  -- if S_read = $quiet_operand(S, poperand)
  -- if S_read.RESULT = KNOWN pvalue
def $access_base(S, BASE_DIM pbase poperand z) = true
  -- if $access_base(S, pbase)
def $access_base(S, BASE_DIM pbase poperand z) = $access_probe(S, BASE_DIM pbase poperand z)
  -- if ~$access_base(S, pbase)
def $access_base(S, BASE_GLOBAL poperand z) = $access_probe(S, BASE_GLOBAL poperand z)
def $access_base(S, pbase) = false -- otherwise
def $access_read_pending(S) = true
  -- if S.ORIGIN = (porigin)
  -- if S.TODO = ptask :: ptask_tail*
  -- if $key_reader(S, porigin, ptask) =/= eps
  -- if $access_base(S, S.BASE)
def $access_read_pending(S) = false -- otherwise
def $access_dimension_pending(S) = true
  -- if S.TODO = (KEY_READ_DIM poperand z pkeymode) :: ptask_tail*
  -- if S_read = $quiet_operand(S, S.RESULT)
  -- if S_read.RESULT = KNOWN pvalue
  -- if $access_instance(S, pvalue)
def $access_dimension_pending(S) = false -- otherwise

def $access_record(S, porigin_target, z, paccessmode, pbase, poperand_key, poperand_rhs, ptask, n?, b) = {SITE porigin, TARGET porigin_target, LINE z, KEYLINE z_key, MODE paccessmode, BASE pbase, INPUT poperand_key, RHS poperand_rhs, SELECTED KNOWN PNULL, OBJECT n?, OFFSET PNULL, VALUE PNULL, LATCH false, OUTER b, TASK ptask, PHASE ACCESS_KEY_CV eps}
  -- if S.ORIGIN = (porigin)
  -- if $code_expression_at_source(S, porigin_target, [PCFIELD 1]) = (z_key)
def $access_record(S, porigin_target, z, paccessmode, pbase, poperand_key, poperand_rhs, ptask, n?, b) = {SITE porigin, TARGET porigin_target, LINE z, KEYLINE z, MODE paccessmode, BASE pbase, INPUT poperand_key, RHS poperand_rhs, SELECTED KNOWN PNULL, OBJECT n?, OFFSET PNULL, VALUE PNULL, LATCH false, OUTER b, TASK ptask, PHASE ACCESS_KEY_CV eps}
  -- if S.ORIGIN = (porigin)
  -- if $code_expression_at_source(S, porigin_target, [PCFIELD 1]) = eps

def $access_dimension(S, poperand, z, pkeymode) = $access_key(S, paccess[.SELECTED = $rcontainer_selected(S, S.RESULT)])
  -- if S_read = $quiet_operand(S, S.RESULT)
  -- if S_read.RESULT = KNOWN (POBJECT n)
  -- if S.ORIGIN = (porigin)
  -- if paccess = $access_record(S, porigin, z, ACCESS_READ pkeymode, BASE_VALUE S.RESULT, poperand, KNOWN PNULL, KEY_READ_DIM poperand z pkeymode, $access_read_object(n, pkeymode), ~$key_test_mode(pkeymode))
rule PhpStep/access-read: S ~> $access_dimension(S, poperand, z, pkeymode)
  -- if S.TODO = (KEY_READ_DIM poperand z pkeymode) :: ptask_tail*
  -- if $access_dimension_pending(S)

def $access_set_plan(S) = (paccess)
  -- if S.TODO = (ASSIGN_ARRAY (BASE_DIM (BASE_VALUE poperand_base) poperand z_key) z b) :: ptask_tail*
  -- if S.ORIGIN = (porigin)
  -- if $origin_child((porigin), [PCFIELD 0]) = (porigin_target)
  -- if S_base = $quiet_operand(S, poperand_base)
  -- if S_base.RESULT = KNOWN (POBJECT n)
  -- if $access_instance(S, POBJECT n)
  -- if paccess = $access_record(S, porigin_target, z, ACCESS_SET, BASE_VALUE poperand_base, poperand, S.RESULT, ASSIGN_ARRAY (BASE_DIM (BASE_VALUE poperand_base) poperand z_key) z b, (n), true)
def $access_set_plan(S) = (paccess)
  -- if S.TODO = (ASSIGN_ARRAY (BASE_APPEND (BASE_VALUE poperand_base) z_base) z b) :: ptask_tail*
  -- if S.ORIGIN = (porigin)
  -- if $origin_child((porigin), [PCFIELD 0]) = (porigin_target)
  -- if S_base = $quiet_operand(S, poperand_base)
  -- if S_base.RESULT = KNOWN (POBJECT n)
  -- if $access_instance(S, POBJECT n)
  -- if paccess = $access_record(S, porigin_target, z, ACCESS_SET, BASE_VALUE poperand_base, KNOWN PNULL, S.RESULT, ASSIGN_ARRAY (BASE_APPEND (BASE_VALUE poperand_base) z_base) z b, (n), true)
def $access_set_plan(S) = eps -- otherwise
def $access_set_pending(S) = ($access_set_plan(S) =/= eps)
rule PhpStep/access-set: S ~> $access_key(S, paccess)
  -- if $access_set_plan(S) = (paccess)

def $access_unset_pending(S) = true
  -- if S.TODO = UNSET_ARRAY :: ptask_tail*
  -- if S.BASE = BASE_DIM (BASE_VALUE poperand_base) poperand z
  -- if S_base = $quiet_operand(S, poperand_base)
  -- if S_base.RESULT = KNOWN (POBJECT n)
  -- if $access_instance(S, POBJECT n) \/ $error_missing_operand(S, poperand)
def $access_unset_pending(S) = false -- otherwise
rule PhpStep/access-unset: S ~> $access_key(S, paccess[.SELECTED = $rcontainer_selected(S, poperand_base)])
  -- if $access_unset_pending(S)
  -- if S.BASE = BASE_DIM (BASE_VALUE poperand_base) poperand z
  -- if S.ORIGIN = (porigin)
  -- if paccess = $access_record(S, porigin, z, ACCESS_UNSET, BASE_VALUE poperand_base, poperand, KNOWN PNULL, UNSET_ARRAY, eps, false)

def $access_key(S, paccess) = $access_dispatch(S, paccess[.PHASE = ACCESS_KEY_CV n_name*][.LATCH = true])
  -- if paccess.INPUT = VARIABLE n_name* z
  -- if $error_missing_operand(S, paccess.INPUT)
def $access_key(S, paccess) = $access_key_done(S, paccess)
  -- if ~$error_missing_operand(S, paccess.INPUT)
def $access_key_done(S, paccess) = $access_value(S, paccess)
  -- if paccess.MODE = ACCESS_SET
def $access_key_done(S, paccess) = $access_offset(S, paccess)
  -- if paccess.MODE =/= ACCESS_SET
;; The RHS pointer is dereferenced before invoking offsetSet. Its later readback
;; can observe a changed value in the same CV or the originally selected CELL.
def $access_value(S, paccess) = $access_dispatch(S, paccess[.PHASE = ACCESS_VALUE_CV n_name*][.SELECTED = KNOWN PNULL][.VALUE = PNULL])
  -- if paccess.RHS = VARIABLE n_name* z
  -- if $error_missing_operand(S, paccess.RHS)
def $access_value(S, paccess) = $access_offset(S, paccess[.SELECTED = $rcontainer_selected(S, paccess.RHS)][.VALUE = pvalue])
  -- if ~$error_missing_operand(S, paccess.RHS)
  -- if S_read = $quiet_operand(S, paccess.RHS)
  -- if S_read.COMPLETION = NORMAL
  -- if S_read.RESULT = KNOWN pvalue
def $access_value(S, paccess) = S_read
  -- if S_read = $quiet_operand(S, paccess.RHS)
  -- if S_read.COMPLETION =/= NORMAL
def $access_offset(S, paccess) = $access_live(S, paccess[.OFFSET = PNULL])
  -- if paccess.LATCH
def $access_offset(S, paccess) = $access_live(S, paccess[.OFFSET = pvalue])
  -- if ~paccess.LATCH
  -- if S_read = $quiet_operand(S, paccess.INPUT)
  -- if S_read.COMPLETION = NORMAL
  -- if S_read.RESULT = KNOWN pvalue
def $access_offset(S, paccess) = S_read
  -- if ~paccess.LATCH
  -- if S_read = $quiet_operand(S, paccess.INPUT)
  -- if S_read.COMPLETION =/= NORMAL

def $access_live(S, paccess) = $access_call(S, paccess, $ptascii("offsetSet"))
  -- if paccess.MODE = ACCESS_SET
def $access_live(S, paccess) = $access_call(S, paccess, $ptascii("offsetGet"))
  -- if paccess.MODE = ACCESS_READ KEY_R
def $access_live(S, paccess) = $access_call(S, paccess, $ptascii("offsetExists"))
  -- if paccess.MODE = ACCESS_READ KEY_IS
def $access_live(S, paccess) = $access_call(S, paccess[.OBJECT = (n)], $ptascii("offsetExists"))
  -- if paccess.MODE = ACCESS_READ (KEY_TEST b)
  -- if paccess.BASE = BASE_VALUE poperand_base
  -- if S_read = $quiet_operand(S, paccess.SELECTED)
  -- if S_read.RESULT = KNOWN (POBJECT n)
  -- if $access_instance(S, POBJECT n)
def $access_live(S, paccess) = $access_call(S, paccess[.OBJECT = (n)], $ptascii("offsetUnset"))
  -- if paccess.MODE = ACCESS_UNSET
  -- if S_read = $quiet_operand(S, paccess.SELECTED)
  -- if S_read.RESULT = KNOWN (POBJECT n)
  -- if $access_instance(S, POBJECT n)
def $access_live(S, paccess) = $access_nonobject(S, paccess, pvalue)
  -- if paccess.MODE = ACCESS_UNSET
  -- if S_read = $quiet_operand(S, paccess.SELECTED)
  -- if S_read.RESULT = KNOWN pvalue
  -- if ~$access_instance(S, pvalue)
def $access_live(S, paccess) = $access_nonobject(S, paccess, pvalue)
  -- if paccess.MODE = ACCESS_READ (KEY_TEST b)
  -- if paccess.BASE = BASE_VALUE poperand_base
  -- if S_read = $quiet_operand(S, paccess.SELECTED)
  -- if S_read.RESULT = KNOWN pvalue
  -- if ~$access_instance(S, pvalue)
def $access_nonobject(S, paccess, pvalue) = $rcontainer_test(S, {READ {SITE paccess.TARGET, GLOBAL false, MODE KEY_TEST b, INPUT paccess.INPUT, VALUE paccess.OFFSET, BASE pvalue, OWNERS paccess.BASE, LINE paccess.LINE, PHASE KEY_NULL, KEY KSTRING eps, NAME eps}, SELECTED paccess.SELECTED, PHASE READ_OFFSET pvalue}, pvalue)
  -- if paccess.MODE = ACCESS_READ (KEY_TEST b)
def $access_nonobject(S, paccess, pvalue) = $key_read_done(S_out, PNULL)
  -- if paccess.MODE = ACCESS_UNSET
  -- if pvalue =/= PBOOL false
  -- if S_out = $unset_nonarray(S, pvalue, paccess.LINE)
  -- if S_out.COMPLETION = NORMAL
def $access_nonobject(S, paccess, pvalue) = S_out
  -- if paccess.MODE = ACCESS_UNSET
  -- if pvalue =/= PBOOL false
  -- if S_out = $unset_nonarray(S, pvalue, paccess.LINE)
  -- if S_out.COMPLETION =/= NORMAL
def $access_nonobject(S, paccess, PBOOL false) = $error_dispatch(S[.ORIGIN = (paccess.SITE)], 8192, $ptascii("Automatic conversion of false to array is deprecated"), paccess.LINE, DIAGNOSTIC "Deprecated" $ptascii("Automatic conversion of false to array is deprecated") paccess.LINE, ACCESS_RESUME paccess[.PHASE = ACCESS_UNSET_FALSE][.VALUE = PBOOL false])
  -- if paccess.MODE = ACCESS_UNSET

def $access_arguments(paccess) = [KNOWN paccess.OFFSET, KNOWN paccess.VALUE] -- if paccess.MODE = ACCESS_SET
def $access_arguments(paccess) = [KNOWN paccess.OFFSET] -- if paccess.MODE =/= ACCESS_SET
def $access_call(S, paccess, ptbytes) = S[.TODO = (CALL_ARGS (METHOD_TARGET n pmethoddesc.FUNCTION.ORIGIN) eps (|poperand*|) poperand* (paccess.SITE) paccess.LINE) :: (ACCESS_RESULT paccess[.PHASE = ACCESS_CALL ptbytes]) :: ptask_tail*][.ORIGIN = (paccess.SITE)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if paccess.OBJECT = (n)
  -- if S.OBJECTS[n] = INSTANCE porigin_class
  -- if $effective_method(S, porigin_class, ptbytes, |S.CLASSES|) = (pmethoddesc)
  -- if ~pmethoddesc.FUNCTION.SIGNATURE.BYREF
  -- if poperand* = $access_arguments(paccess)
  -- if S.TODO = ptask :: ptask_tail*
def $access_call(S, paccess, ptbytes) = S[.COMPLETION = UNSUPPORTED "ArrayAccess by-reference result protocol"]
  -- if paccess.OBJECT = (n)
  -- if S.OBJECTS[n] = INSTANCE porigin_class
  -- if $effective_method(S, porigin_class, ptbytes, |S.CLASSES|) = (pmethoddesc)
  -- if pmethoddesc.FUNCTION.SIGNATURE.BYREF

;; Call returns feed the original language consumer; there is no synthetic AST.
def $access_truth_consumed(paccess) = true
  -- if paccess.PHASE = ACCESS_CALL ptbytes
  -- if ptbytes = $ptascii("offsetExists")
  -- if paccess.MODE = ACCESS_READ KEY_IS \/ paccess.MODE = ACCESS_READ (KEY_TEST b)
def $access_truth_consumed(paccess) = true
  -- if paccess.PHASE = ACCESS_CALL ptbytes
  -- if ptbytes = $ptascii("offsetGet")
  -- if paccess.MODE = ACCESS_READ (KEY_TEST true)
def $access_truth_consumed(paccess) = false -- otherwise
def $access_truth_warning(PFLOAT n) = b_warning
  -- if (b, b_warning) = $number_bool(NFLOAT n)
def $access_truth_warning(pvalue) = false -- otherwise
def $access_truth_phase(ACCESS_TRUTH ptbytes b) = true
def $access_truth_phase(paccessphase) = false -- otherwise
def $access_cv_phase(ACCESS_KEY_CV n_name*) = true
def $access_cv_phase(ACCESS_VALUE_CV n_name*) = true
def $access_cv_phase(paccessphase) = false -- otherwise

def $access_result(S, paccess, pvalue) = $error_dispatch(S[.ORIGIN = (paccess.SITE)], 2, $ptascii("unexpected NAN value was coerced to bool"), paccess.LINE, DIAGNOSTIC "Warning" $ptascii("unexpected NAN value was coerced to bool") paccess.LINE, ACCESS_RESUME paccess[.PHASE = ACCESS_TRUTH ptbytes b][.VALUE = pvalue])
  -- if $access_truth_consumed(paccess)
  -- if $access_truth_warning(pvalue)
  -- if paccess.PHASE = ACCESS_CALL ptbytes
  -- if b = $truth(S, pvalue)
def $access_result(S, paccess, pvalue) = $access_result_done(S, paccess, pvalue)
  -- if ~($access_truth_consumed(paccess) /\ $access_truth_warning(pvalue))
def $access_predicate(S, paccess, b_result) = $key_read_done(S_capture, pvalue)
  -- if paccess.MODE = ACCESS_READ (KEY_TEST b)
  -- if S_capture = $key_test_capture(S, b, b_result)
  -- if S_capture.RESULT = KNOWN pvalue
def $access_result_done(S, paccess, pvalue) = $access_call(S, paccess, $ptascii("offsetGet"))
  -- if paccess.PHASE = ACCESS_CALL ptbytes
  -- if ptbytes = $ptascii("offsetExists")
  -- if $truth(S, pvalue)
  -- if paccess.MODE = ACCESS_READ KEY_IS \/ paccess.MODE = ACCESS_READ (KEY_TEST true)
def $access_result_done(S, paccess, pvalue) = $key_read_done(S, PNULL)
  -- if paccess.PHASE = ACCESS_CALL ptbytes
  -- if ptbytes = $ptascii("offsetExists")
  -- if ~$truth(S, pvalue)
  -- if paccess.MODE = ACCESS_READ KEY_IS
def $access_result_done(S, paccess, pvalue) = $access_predicate(S, paccess, ~$truth(S, pvalue))
  -- if paccess.PHASE = ACCESS_CALL ptbytes
  -- if ptbytes = $ptascii("offsetExists")
  -- if ~$truth(S, pvalue)
  -- if paccess.MODE = ACCESS_READ (KEY_TEST true)
def $access_result_done(S, paccess, pvalue) = $access_predicate(S, paccess, $truth(S, pvalue))
  -- if paccess.PHASE = ACCESS_CALL ptbytes
  -- if ptbytes = $ptascii("offsetExists")
  -- if paccess.MODE = ACCESS_READ (KEY_TEST false)
def $access_result_done(S, paccess, pvalue) = $access_predicate(S, paccess, ~$truth(S, pvalue))
  -- if paccess.PHASE = ACCESS_CALL ptbytes
  -- if ptbytes = $ptascii("offsetGet")
  -- if paccess.MODE = ACCESS_READ (KEY_TEST true)
def $access_result_done(S, paccess, pvalue) = $key_read_done(S, pvalue)
  -- if paccess.PHASE = ACCESS_CALL ptbytes
  -- if ptbytes = $ptascii("offsetGet")
  -- if paccess.MODE = ACCESS_READ KEY_R \/ paccess.MODE = ACCESS_READ KEY_IS
def $access_result_done(S, paccess, pvalue) = $key_read_done(S, pvalue_result)
  -- if paccess.MODE = ACCESS_SET
  -- if S_read = $quiet_operand(S, paccess.SELECTED)
  -- if S_read.RESULT = KNOWN pvalue_result
def $access_result_done(S, paccess, pvalue) = $key_read_done(S, PNULL)
  -- if paccess.MODE = ACCESS_UNSET
rule PhpStep/access-result: S ~> $access_result(S_read, paccess, pvalue)
  -- if S.TODO = (ACCESS_RESULT paccess) :: ptask_tail*
  -- if $access_valid(S, paccess)
  -- if S_read = $quiet_operand(S, S.RESULT)
  -- if S_read.COMPLETION = NORMAL
  -- if S_read.RESULT = KNOWN pvalue

def $access_warning_name(paccess) = n_name* -- if paccess.PHASE = ACCESS_KEY_CV n_name*
def $access_warning_name(paccess) = n_name* -- if paccess.PHASE = ACCESS_VALUE_CV n_name*
def $access_dispatch(S, paccess) = $error_dispatch(S[.ORIGIN = (paccess.SITE)], 2, $ptascii("Undefined variable $") ++ n_name*, paccess.LINE, WARNING n_name* paccess.LINE, ACCESS_RESUME paccess)
  -- if n_name* = $access_warning_name(paccess)
rule PhpStep/access-key-resume: S ~> $access_key_done(S, paccess)
  -- if S.TODO = (ACCESS_RESUME paccess) :: ptask_tail*
