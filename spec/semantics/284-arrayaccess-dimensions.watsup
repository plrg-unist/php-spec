def $access_roots(paccess, b_inner) = $base_nodes(paccess.BASE) ++ $operand_nodes(paccess.INPUT) ++ $operand_nodes(paccess.RHS) ++ $access_object_roots(paccess.OBJECT, paccess.OUTER) ++ $access_object_roots(paccess.OBJECT, b_inner) ++ $access_offset_roots(paccess.OFFSET, b_inner)
def $access_object_roots((n), true) = [HOBJECT n]
def $access_object_roots(n?, b) = eps -- otherwise
def $access_offset_roots(pvalue, true) = $value_nodes(pvalue)
def $access_offset_roots(pvalue, false) = eps
def $task_nodes(ACCESS_RESULT paccess) = $access_roots(paccess, true)
def $task_nodes(ACCESS_RESUME paccess) = $access_roots(paccess, $access_truth_phase(paccess.PHASE))
def $return_discard(S, ACCESS_RESULT paccess) = S[.ORIGIN = (paccess.SITE)]
def $return_discard(S, ACCESS_RESUME paccess) = S[.ORIGIN = (paccess.SITE)]

