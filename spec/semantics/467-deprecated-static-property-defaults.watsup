def $static_default_binding_head((STATIC_DEFAULT_PUBLISH pstaticdefaultcontext pvalue pvalueclass) :: ptask*, porigin) = (pstaticdefaultcontext.DECL = porigin)
def $static_default_binders_unique((STATIC_DEFAULT_PUBLISH pstaticdefaultcontext pvalue pvalueclass) :: ptask*, porigin_seen*) = (~(pstaticdefaultcontext.DECL <- porigin_seen*) /\ $static_default_binders_unique(ptask*, porigin_seen* ++ [pstaticdefaultcontext.DECL]))
def $static_default_phases((STATIC_DEFAULT_PUBLISH pstaticdefaultcontext pvalue pvalueclass) :: ptask*, b_property) = $static_default_phases(ptask*, true)

