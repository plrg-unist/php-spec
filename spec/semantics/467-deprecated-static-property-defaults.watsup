def $task_nodes(STATIC_DEFAULT_PUBLISH pstaticdefaultcontext pvalue pvalueclass) = $value_nodes(pvalue)
def $static_default_context_at((STATIC_DEFAULT_PUBLISH pstaticdefaultcontext pvalue pvalueclass) :: ptask*) = (pstaticdefaultcontext)
