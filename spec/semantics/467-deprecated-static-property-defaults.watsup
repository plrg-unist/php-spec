def $static_publication_finish(S, pstaticdefaultcontext, pvalue) = $static_default_restore($static_default_bound(S, pstaticdefaultcontext, ppropertydesc, pvalue)[.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], pstaticdefaultcontext)
