dec $static_publication_tasks(pstate, ptask*, porigin) : bool
dec $static_publication_head(pstate, ptask, porigin) : bool
def $static_publication_head(S, STATIC_DEFAULT_PUBLISH pstaticdefaultcontext pvalue pvalueclass, porigin) = (pstaticdefaultcontext.DECL = porigin /\ $static_publication_valid(S, pstaticdefaultcontext, pvalue, pvalueclass))
def $static_publication_head(S, ptask, porigin) = false -- otherwise
def $static_publication_tasks(S, eps, porigin) = false
def $static_publication_tasks(S, ptask :: ptask_tail*, porigin) = ($static_publication_head(S, ptask, porigin) \/ $static_publication_tasks(S, ptask_tail*, porigin))
