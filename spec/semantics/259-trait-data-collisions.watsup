;; zend_do_link_class records diagnostics while comparing copied constant ASTs.
;; The real handler is selected only after successful class publication.
dec $trait_record_properties(ppropertydesc*, porigin) : bool
def $trait_record_properties(eps, porigin) = false
def $trait_record_properties(ppropertydesc :: ppropertydesc_tail*, porigin) = (ppropertydesc.DEFAULT = PROP_DEFERRED porigin \/ $trait_record_properties(ppropertydesc_tail*, porigin))
dec $trait_record_constants(pclassconstantdesc*, porigin) : bool
def $trait_record_constants(eps, porigin) = false
def $trait_record_constants(pclassconstantdesc :: pclassconstantdesc_tail*, porigin) = ((~pclassconstantdesc.FOLDED /\ pclassconstantdesc.INITIALIZER = porigin) \/ $trait_record_constants(pclassconstantdesc_tail*, porigin))
dec $trait_record_members(pclassdesc, porigin) : bool
def $trait_record_members(pclassdesc, porigin) = ($trait_record_properties(pclassdesc.PROPERTIES, porigin) \/ $trait_record_constants(pclassdesc.CONSTANTS, porigin))
dec $trait_record_exports(pclassdesc*, porigin) : bool
def $trait_record_exports(eps, porigin) = false
def $trait_record_exports(pclassdesc :: pclassdesc_tail*, porigin) = ($trait_record_members(pclassdesc, porigin) \/ $trait_record_exports(pclassdesc_tail*, porigin))
def $trait_record_root(S, pclassdesc, PORIGIN n pcpath) = true
  -- if $class_at(S.CLASSES, pclassdesc.ORIGIN) = (pclassdesc)
  -- if $trait_needs_binding(S, pclassdesc)
  -- if $trait_fetch(S, $trait_plan(S, pclassdesc).TRAITS, eps) = TRAITFETCHED pclassdesc_traits*
  -- if $trait_record_members(pclassdesc, PORIGIN n pcpath) \/ $trait_record_exports(pclassdesc_traits*, PORIGIN n pcpath)
  -- if $source_unit(S.SOURCES, n) = (pcunit)
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (expression)
  -- if $($expression_line(expression) > 0)
def $trait_record_root(S, pclassdesc, porigin) = false -- otherwise
dec $trait_recording(pfstate, pcpath) : bool
def $trait_recording(F, pcpath) = $trait_cache_recording(F, pcpath)

;; AST evaluation restores its parent's line after each child. Bare constant
;; roots retain the executing declaration line used by zval constant lookup.
dec $trait_record_root_line(pfshape, int, int) : int
def $trait_record_root_line(PFNAME name, z_source, z) = z
def $trait_record_root_line(pfshape, z_source, z) = z_source -- otherwise
def $pffold_line(F, pcpath, expression, z) = $trait_record_root_line($pfshape(expression), $expression_line(expression), z)
  -- if $trait_recording(F, pcpath)
  -- if F.RECORD = (pfrecorder)
  -- if $trait_cache_fold_root(F) = (PORIGIN F.SOURCE.ID pcpath)
def $pffold_line(F, pcpath, expression, z) = $expression_line(expression)
  -- if $trait_recording(F, pcpath)
  -- if F.RECORD = (pfrecorder)
  -- if $trait_cache_fold_root(F) = (porigin_root)
  -- if porigin_root =/= PORIGIN F.SOURCE.ID pcpath

dec $trait_record_name(pfstate, pcpath, ptbytes, ptbytes?, int) : pfstate
def $trait_record_name(F, pcpath, ptbytes, ptbytes_fallback?, z) = $pfremember(F[.RECORDED = F.RECORDED ++ [{SITE PORIGIN F.SOURCE.ID pcpath, OWNER porigin_owner, LEVEL 8192, MESSAGE $deprecated_constant_message(), LINE z}]], pcpath, (PINT 2048), z)
  -- if $trait_fold_owner(F) = (porigin_owner)
  -- if F.EXTERNAL = (S_external)
  -- if $deprecated_constant_name(S_external, ptbytes, ptbytes_fallback?)
def $trait_record_name(F, pcpath, ptbytes, ptbytes_fallback?, z) = $pfremember(F, pcpath, $trait_fold_name_value(S_external, ptbytes, ptbytes_fallback?), z)
  -- if F.EXTERNAL = (S_external)
  -- if ~$deprecated_constant_name(S_external, ptbytes, ptbytes_fallback?)
def $pfdispatch(F, pcpath, PFNAME name, z) = $trait_record_name(F, pcpath, ptbytes, ptbytes_fallback?, z)
  -- if $trait_recording(F, pcpath)
  -- if F.EXTERNAL = (S_external)
  -- if $code_at(S_external.CODE, F.SOURCE.ID) = (pcode)
  -- if $code_name(pcode.NAMES, pcpath) = ((ptbytes, ptbytes_fallback?))

dec $trait_record_event(porigin, porigin, pevent) : pfdiagnostic?
def $trait_record_event(porigin_owner, porigin, DIAGNOSTIC "Warning" ptbytes z) = ({SITE porigin, OWNER porigin_owner, LEVEL 2, MESSAGE ptbytes, LINE z})
def $trait_record_event(porigin_owner, porigin, DIAGNOSTIC "Deprecated" ptbytes z) = ({SITE porigin, OWNER porigin_owner, LEVEL 8192, MESSAGE ptbytes, LINE z})
def $trait_record_event(porigin_owner, porigin, DISPLAY_STDOUT pevent) = $trait_record_event(porigin_owner, porigin, pevent)
def $trait_record_event(porigin_owner, porigin, pevent) = eps -- otherwise
dec $trait_record_events(porigin, porigin, pevent*) : pfdiagnostic*?
def $trait_record_events(porigin_owner, porigin, eps) = (eps)
def $trait_record_events(porigin_owner, porigin, pevent :: pevent_tail*) = (pfdiagnostic :: pfdiagnostic_tail*)
  -- if $trait_record_event(porigin_owner, porigin, pevent) = (pfdiagnostic)
  -- if $trait_record_events(porigin_owner, porigin, pevent_tail*) = (pfdiagnostic_tail*)
def $trait_record_events(porigin_owner, porigin, pevent*) = eps -- otherwise
def $pfwarned(F, pcpath, S) = F[.MEMORY = S[.EVENTS = F.MEMORY.EVENTS]][.RECORDED = F.RECORDED ++ pfdiagnostic*][.VALUE = (pvalue)]
  -- if $trait_recording(F, pcpath)
  -- if S.RESULT = KNOWN pvalue
  -- if $(|F.MEMORY.EVENTS| <= |S.EVENTS|)
  -- if S.EVENTS[0:|F.MEMORY.EVENTS|] = F.MEMORY.EVENTS
  -- if n_events = $nabs($(|S.EVENTS| - |F.MEMORY.EVENTS|))
  -- if $trait_fold_owner(F) = (porigin_owner)
  -- if $trait_record_events(porigin_owner, PORIGIN F.SOURCE.ID pcpath, S.EVENTS[|F.MEMORY.EVENTS|:n_events]) = (pfdiagnostic*)

;; A source-owned scratch operation always records its raw diagnostics. The
;; real handler, reporting mask and display destination are used at delivery.
def $pfpure_value(F, pcpath, S, z) = ($pfremember(F_result, pcpath, (pvalue), z))
  -- if $trait_recording(F, pcpath)
  -- if S.COMPLETION = NORMAL
  -- if S.TODO = F.MEMORY.TODO
  -- if S.RESULT = KNOWN pvalue
  -- if F_result = $pfwarned(F, pcpath, S)
;; zend_ast_evaluate_ex demands each key, then its value, then insertion.
;; The compiler's two-pass value-first fold remains the RECORD=eps path.
dec $trait_record_array(pfstate, pcpath, nat, nat, phpType13*, int, pvalueclass?) : pfstate
dec $trait_record_array_key(pfstate, pcpath, nat, nat, pvalue, pfkey, phpType13*, int, pvalueclass?, pvalueclass?) : pfstate
dec $trait_record_array_insert(pfstate, pcpath, nat, nat, pkey?, pvalue, phpType13*, int, pvalueclass?, pvalueclass?) : pfstate
dec $trait_record_key_ready(pfkey) : bool
def $trait_record_key_ready(PFNO_KEY) = true
def $trait_record_key_ready(PFKEY (pvalue)) = true
def $trait_record_key_ready(pfkey) = false -- otherwise
def $pfdispatch(F, pcpath, PFARRAY phpType13*, z) = $trait_record_array(F[.MEMORY = S], pcpath, n, 0, phpType13*, z, $pfclass_array_start(F.CONSTANT, phpType13* = eps))
  -- if $trait_recording(F, pcpath)
  -- if S = $allocate_array(F.MEMORY, $array_empty())
  -- if S.RESULT = KNOWN (PARRAY n)
def $trait_record_array(F, pcpath, n, n_item, eps, z, pvalueclass?) = $pfclass_record($pfremember(F, pcpath, (PARRAY n), z), pcpath, pvalueclass?)
  -- if F.MEMORY.COMPLETION = NORMAL
def $trait_record_array(F, pcpath, n, n_item, (NArrayItem phpType5 expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType13*, z, pvalueclass?) = $trait_record_array_key(F_value, pcpath, n, $(n_item + 1), pvalue, pfkey, phpType13*, z, pvalueclass?, $pfclass_at(F_value.CLASSFACTS, pcpath_item ++ [PCFIELD 1]))
  -- if F.MEMORY.COMPLETION = NORMAL
  -- if pcpath_item = pcpath ++ [PCFIELD 0, PCINDEX n_item]
  -- if F_key = $pfitemkey(F, pcpath_item ++ [PCFIELD 0], phpType5, z)
  -- if F_key.MEMORY.COMPLETION = NORMAL
  -- if pfkey = $pfkey(phpType5, F_key.VALUE)
  -- if $trait_record_key_ready(pfkey)
  -- if F_value = $pffold(F_key, pcpath_item ++ [PCFIELD 1], expression, z)
  -- if F_value.MEMORY.COMPLETION = NORMAL
  -- if F_value.VALUE = (pvalue)
def $trait_record_array_key(F, pcpath, n, n_item, pvalue, PFNO_KEY, phpType13*, z, pvalueclass?, pvalueclass_item?) = $trait_record_array_insert(F, pcpath, n, n_item, eps, pvalue, phpType13*, z, pvalueclass?, pvalueclass_item?)
def $trait_record_array_key(F, pcpath, n, n_item, pvalue, PFKEY (pvalue_key), phpType13*, z, pvalueclass?, pvalueclass_item?) = $trait_record_array_insert(F_key, pcpath, n, n_item, (S_key.KEY), pvalue, phpType13*, z, pvalueclass?, pvalueclass_item?)
  -- if S_key = $key_value(F.MEMORY, pvalue_key, false, z)
  -- if S_key.COMPLETION = NORMAL
  -- if F_key = $pfwarned(F, pcpath, S_key)
def $trait_record_array_key(F, pcpath, n, n_item, pvalue, pfkey, phpType13*, z, pvalueclass?, pvalueclass_item?) = F[.VALUE = eps] -- otherwise
def $trait_record_array_insert(F, pcpath, n, n_item, pkey?, pvalue, phpType13*, z, pvalueclass?, pvalueclass_item?) = $trait_record_array(F_insert, pcpath, n, n_item, phpType13*, z, $pfclass_insert(pvalueclass?, F.MEMORY.ARRAYS[n].NEXT, pkey?, pvalueclass_item?))
  -- if S_insert = $literal_insert(F.MEMORY, n, pkey?, pvalue, z)
  -- if S_insert.COMPLETION = NORMAL
  -- if F_insert = $pfwarned(F, pcpath, S_insert)
def $trait_record_array_insert(F, pcpath, n, n_item, pkey?, pvalue, phpType13*, z, pvalueclass?, pvalueclass_item?) = F[.VALUE = eps] -- otherwise
def $trait_record_array(F, pcpath, n, n_item, (NArrayItem ABSENT expression (BOOLEAN false) (BOOLEAN true) metadata) :: phpType13*, z, pvalueclass?) = $trait_record_array(F_spread, pcpath, n, $(n_item + 1), phpType13*, z, $pfclass_spread(pvalueclass?, F_value.MEMORY.ARRAYS[n].NEXT, $pfclass_at(F_value.CLASSFACTS, pcpath_value)))
  -- if F.MEMORY.COMPLETION = NORMAL
  -- if pcpath_value = pcpath ++ [PCFIELD 0, PCINDEX n_item, PCFIELD 1]
  -- if F_value = $pffold(F, pcpath_value, expression, z)
  -- if F_value.MEMORY.COMPLETION = NORMAL
  -- if F_value.VALUE = (PARRAY n_source)
  -- if S_spread = $array_unpack(F_value.MEMORY, n, PARRAY n_source, z)
  -- if S_spread.COMPLETION = NORMAL
  -- if F_spread = $pfwarned(F_value, pcpath, S_spread)
def $trait_record_array(F, pcpath, n, n_item, phpType13*, z, pvalueclass?) = F[.VALUE = eps] -- otherwise

dec $trait_value_notices(ptraitdatavalue) : pfdiagnostic*
def $trait_value_notices(TRAITVALUE S pvalue pfdiagnostic*) = pfdiagnostic*
def $trait_value_notices(TRAITVALUEUNKNOWN text pfdiagnostic*) = pfdiagnostic*
def $trait_value_notices(TRAITUNINITIALIZED) = eps
def $trait_comparison(ptraitdatavalue_left, ptraitdatavalue_right) = { CHECK $trait_data_compare(ptraitdatavalue_left, ptraitdatavalue_right), NOTICES ($trait_value_notices(ptraitdatavalue_left) ++ $trait_value_notices(ptraitdatavalue_right)), MEMORY $trait_comparison_memory(ptraitdatavalue_left, ptraitdatavalue_right) }
dec $trait_notice_records(porigin, nat, nat, pfdiagnostic*) : pdeclnoticeitem*
def $trait_notice_records(porigin, n_prefix, n_user, eps) = eps
def $trait_notice_records(porigin, n_prefix, n_user, pfdiagnostic :: pfdiagnostic_tail*) = (TRAIT_DATA_NOTICE porigin n_prefix n_user pfdiagnostic) :: $trait_notice_records(porigin, n_prefix, n_user, pfdiagnostic_tail*)
def $trait_comparison_seed(S, pclassdesc, S_result, eps) = S_result
def $trait_comparison_seed(S, pclassdesc, S_result, pfdiagnostic*) = S_result[.TODO = S_result.TODO ++ [TRAIT_DATA_SEED $trait_notice_records(pclassdesc.ORIGIN, |S.DECLARATIONS|, |S.USERCONSTANTS|, pfdiagnostic*)]]
  -- if pfdiagnostic* =/= eps
;; Private-final adaptations are recorded at their real method-binding phase.
;; E_COMPILE_WARNING remains handler-ineligible when the batch is delivered.
def $trait_compile_warning_seed(S, pclassdesc) = $trait_comparison_seed(S, pclassdesc, S, [{SITE pclassdesc.ORIGIN, OWNER pclassdesc.ORIGIN, LEVEL 128, MESSAGE $ptascii("Private methods cannot be final as they are never overridden by other classes"), LINE pclassdesc.LINE}])
def $iterator_notice_seed_task(TRAIT_DATA_SEED pdeclnoticeitem*) = true
def $iterator_notice_seed_items(TRAIT_DATA_SEED pdeclnoticeitem*) = pdeclnoticeitem*
def $call_task_valid(S, TRAIT_DATA_SEED pdeclnoticeitem*) = false
def $task_nodes(TRAIT_DATA_SEED pdeclnoticeitem*) = eps
def $iterator_notice_level(TRAIT_DATA_NOTICE porigin n_prefix n_user pfdiagnostic) = pfdiagnostic.LEVEL
def $iterator_notice_line(TRAIT_DATA_NOTICE porigin n_prefix n_user pfdiagnostic) = pfdiagnostic.LINE
def $iterator_notice_origin(TRAIT_DATA_NOTICE porigin n_prefix n_user pfdiagnostic) = porigin
def $iterator_notice_message(TRAIT_DATA_NOTICE porigin n_prefix n_user pfdiagnostic) = pfdiagnostic.MESSAGE
def $iterator_notice_event(TRAIT_DATA_NOTICE porigin n_prefix n_user pfdiagnostic) = DIAGNOSTIC_SOURCE n "Deprecated" pfdiagnostic.MESSAGE pfdiagnostic.LINE
  -- if $origin_source(pfdiagnostic.OWNER) = PORIGIN n pcpath
  -- if pfdiagnostic.LEVEL = 8192
def $iterator_notice_event(TRAIT_DATA_NOTICE porigin n_prefix n_user pfdiagnostic) = DIAGNOSTIC_SOURCE n "Warning" pfdiagnostic.MESSAGE pfdiagnostic.LINE
  -- if $origin_source(pfdiagnostic.OWNER) = PORIGIN n pcpath
  -- if pfdiagnostic.LEVEL = 2 \/ pfdiagnostic.LEVEL = 128

;; Replay only source data composition at its real publication prefix. Handler
;; writes cannot change the name environment sampled by the earlier comparison.
def $trait_notice_items(eps) = false
def $trait_notice_items((TRAIT_DATA_NOTICE porigin n_prefix n_user pfdiagnostic) :: pdeclnoticeitem*) = true
def $trait_notice_items((METHOD_NOTICE pdeclnotice) :: pdeclnoticeitem*) = $trait_notice_items(pdeclnoticeitem*)
def $trait_notice_items((COMPILER_NOTICE pldiagnostic) :: pdeclnoticeitem*) = $trait_notice_items(pdeclnoticeitem*)
dec $trait_notice_first(pdeclnoticeitem*) : (porigin, nat, nat)?
def $trait_notice_first((TRAIT_DATA_NOTICE porigin n_prefix n_user pfdiagnostic) :: pdeclnoticeitem*) = ((porigin, n_prefix, n_user))
def $trait_notice_first((METHOD_NOTICE pdeclnotice) :: pdeclnoticeitem*) = $trait_notice_first(pdeclnoticeitem*)
def $trait_notice_first((COMPILER_NOTICE pldiagnostic) :: pdeclnoticeitem*) = $trait_notice_first(pdeclnoticeitem*)
def $trait_notice_first(eps) = eps
dec $trait_notice_own_property(ppropertyid) : bool
def $trait_notice_own_property(PORIGIN n pcpath) = true
def $trait_notice_own_property(ppropertyid) = false -- otherwise
dec $trait_notice_own_properties(ppropertydesc*) : ppropertydesc*
def $trait_notice_own_properties(eps) = eps
def $trait_notice_own_properties(ppropertydesc :: ppropertydesc_tail*) = ppropertydesc :: $trait_notice_own_properties(ppropertydesc_tail*)
  -- if ppropertydesc.ORIGIN = PORIGIN n pcpath
def $trait_notice_own_properties(ppropertydesc :: ppropertydesc_tail*) = $trait_notice_own_properties(ppropertydesc_tail*)
  -- if ~$trait_notice_own_property(ppropertydesc.ORIGIN)
dec $trait_notice_own_constants(pclassconstantdesc*) : pclassconstantdesc*
def $trait_notice_own_constants(eps) = eps
def $trait_notice_own_constants(pclassconstantdesc :: pclassconstantdesc_tail*) = pclassconstantdesc :: $trait_notice_own_constants(pclassconstantdesc_tail*)
  -- if pclassconstantdesc.ORIGIN = $origin_source(pclassconstantdesc.ORIGIN)
def $trait_notice_own_constants(pclassconstantdesc :: pclassconstantdesc_tail*) = $trait_notice_own_constants(pclassconstantdesc_tail*)
  -- if pclassconstantdesc.ORIGIN =/= $origin_source(pclassconstantdesc.ORIGIN)
dec $trait_notice_own_methods(pmethoddesc*, porigin) : pmethoddesc*
def $trait_notice_own_methods(eps, porigin) = eps
def $trait_notice_own_methods(pmethoddesc :: pmethoddesc_tail*, porigin) = pmethoddesc :: $trait_notice_own_methods(pmethoddesc_tail*, porigin)
  -- if pmethoddesc.OWNER = porigin
  -- if ~$trait_imported_origin(pmethoddesc.FUNCTION.ORIGIN)
def $trait_notice_own_methods(pmethoddesc :: pmethoddesc_tail*, porigin) = $trait_notice_own_methods(pmethoddesc_tail*, porigin)
  -- if pmethoddesc.OWNER =/= porigin \/ $trait_imported_origin(pmethoddesc.FUNCTION.ORIGIN)
dec $trait_notice_name(pstate, pdeclaration) : (preqbytes, porigin)*
def $trait_notice_name(S, PDRCLASS porigin pdeclcause) = [($ptlc(pclassdesc.NAME), porigin)]
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
def $trait_notice_name(S, PDECLASS n porigin) = [($ptlc(pclassdesc.NAME), porigin)]
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
def $trait_notice_name(S, pdeclaration) = eps -- otherwise
dec $trait_notice_names(pstate, pdeclaration*) : (preqbytes, porigin)*
def $trait_notice_names(S, eps) = eps
def $trait_notice_names(S, pdeclaration :: pdeclaration_tail*) = $trait_notice_name(S, pdeclaration) ++ $trait_notice_names(S, pdeclaration_tail*)
dec $trait_notice_cache_item(pstate, pclassconstantevent, nat) : pdefaultcache*
def $trait_notice_cache_item(S, CCCACHE porigin porigin_trigger n, n_prefix) = [pdefaultcache]
  -- if $(n <= n_prefix)
  -- if $default_cache_at(S.CLASSCONSTANTCACHE, porigin) = (pdefaultcache)
def $trait_notice_cache_item(S, pclassconstantevent, n_prefix) = eps -- otherwise
dec $trait_notice_cache_prefix(pstate, pclassconstantevent*, nat) : pdefaultcache*
dec $trait_cache_notice_prefix(pstate, pclassconstantevent*, porigin, nat) : pdefaultcache*
dec $trait_cache_preinherit(pstate, porigin) : pstate
def $trait_notice_cache_prefix(S, eps, n_prefix) = eps
def $trait_notice_cache_prefix(S, pclassconstantevent :: pclassconstantevent_tail*, n_prefix) = $trait_notice_cache_item(S, pclassconstantevent, n_prefix) ++ $trait_notice_cache_prefix(S, pclassconstantevent_tail*, n_prefix)
dec $trait_notice_plan(pstate, porigin, nat, nat) : pdeclnoticeitem*?
def $trait_notice_plan(S, porigin, n_prefix, n_user) = ($iterator_notice_seeds(S_required.TODO))
  -- if $(n_prefix < |S.DECLARATIONS| /\ n_user <= |S.USERCONSTANTS|)
  -- if $iterator_notice_publication_index(S.DECLARATIONS, porigin, 0) = (n_prefix)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if pclassdesc_raw = pclassdesc[.PROPERTIES = $trait_notice_own_properties(pclassdesc.PROPERTIES)][.CONSTANTS = $trait_notice_own_constants(pclassdesc.CONSTANTS)][.METHODS = $trait_notice_own_methods(pclassdesc.METHODS, porigin)]
  -- if S_before = $trait_cache_preinherit(S[.CLASSES = $trait_class_set(S.CLASSES, pclassdesc_raw)][.CLASSNAMES = $trait_notice_names(S, S.DECLARATIONS[0:n_prefix])][.CLASSCONSTANTCACHE = $trait_cache_notice_prefix(S, S.CLASSCONSTANTHISTORY, porigin, n_prefix)][.USERCONSTANTS = S.USERCONSTANTS[0:n_user]][.DECLARATIONS = S.DECLARATIONS[0:n_prefix]][.TODO = eps][.COMPLETION = NORMAL], porigin)
  -- if $trait_fetch(S_before, $trait_plan(S_before, pclassdesc_raw).TRAITS, eps) = TRAITFETCHED pclassdesc_traits*
  -- if ptraitplan = $trait_plan(S_before, pclassdesc_raw)
  -- if $trait_exclusions(S_before, pclassdesc_raw, pclassdesc_traits*, ptraitplan.PRECEDENCES, eps) = TRAITEXCLUSIONS (ptbytes_trait, ptbytes_method)*
  -- if $trait_aliases(S_before, pclassdesc_raw, pclassdesc_traits*, ptraitplan.ALIASES, eps) = TRAITALIASES ptraitalias*
  -- if $trait_copy_traits(pclassdesc_raw, pclassdesc_traits*, ptraitalias*, (ptbytes_trait, ptbytes_method)*, TRAITCOMPOSE S_before eps eps) = TRAITCOMPOSE S_methods ptraitmethod* ptraitmethod_required*
  -- if S_methods.COMPLETION = NORMAL
  -- if pclassdesc_methods = pclassdesc_raw[.METHODS = pclassdesc_raw.METHODS ++ $trait_composed_methods(ptraitmethod*)]
  -- if S_composed = S_methods[.CLASSES = $trait_class_set(S_methods.CLASSES, pclassdesc_methods)]
  -- if S_constants = $trait_data_constants(S_composed, pclassdesc_methods, pclassdesc_traits*, eps)
  -- if S_constants.COMPLETION = NORMAL
  -- if $class_at(S_constants.CLASSES, porigin) = (pclassdesc_constants)
  -- if S_data = $trait_data_properties(S_constants, pclassdesc_constants, pclassdesc_traits*, eps)
  -- if S_data.COMPLETION = NORMAL
  -- if $class_at(S_data.CLASSES, porigin) = (pclassdesc_data)
  -- if S_required = $trait_requirements(S_data, pclassdesc_data, ptraitmethod_required*)
  -- if S_required.COMPLETION = NORMAL
def $trait_notice_plan(S, porigin, n_prefix, n_user) = eps -- otherwise
def $iterator_notice_batch_items(S, pdeclnoticebatch) = true
  -- if pdeclnoticebatch.KIND = NOTICE_RUNTIME
  -- if $trait_notice_first(pdeclnoticebatch.NOTICES) = ((porigin, n_prefix, n_user))
  -- if pdeclnoticebatch.CLASSES = [(porigin, n_prefix)]
  -- if $trait_notice_plan(S, porigin, n_prefix, n_user) = (pdeclnoticeitem*)
  -- if $iterator_notice_classes_plan(S, pdeclnoticebatch.CLASSES) = DECLNOTICES pdeclnotice*
  -- if pdeclnoticebatch.NOTICES = pdeclnoticeitem* ++ $iterator_notice_items(pdeclnotice*)
