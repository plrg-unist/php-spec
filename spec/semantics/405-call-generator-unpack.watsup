def $generator_unpack_send(S, pgeneratorunpack, ptask*) = S[.TODO = (GENERATOR_UNPACK pgeneratorunpack_next "next") :: ptask*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if $fiber_traversal_key($generator_cached_value(S, pgeneratorunpack.OBJECT, true)) = (pkey)
