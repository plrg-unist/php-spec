  -- if S.OBJECTS[pgeneratorunpack.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.PHASE <- [GENERATOR_PAUSED, GENERATOR_CLOSED]
def $fiber_traversal_complete(S, pgeneratorop) = S[.COMPLETION = UNSUPPORTED "Generator unpack delegated producer"]
  -- if pgeneratorop.STARTPACK /\ pgeneratorop.BORROWED
  -- if S.TODO = (GENERATOR_UNPACK pgeneratorunpack text) :: ptask*
  -- if $generator_unpack_header(S, pgeneratorop, pgeneratorunpack, text)
  -- if $generator_unpack_valid(S, pgeneratorunpack, text)
  -- if S.OBJECTS[pgeneratorunpack.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.PHASE = GENERATOR_DELEGATING
;; An explicit limitation retains its authenticated owners instead of invoking
;; terminal frame/Generator cleanup for behavior beyond this protocol.
def $generator_unpack_delegated_blocked(S) = true
  -- if S.COMPLETION = UNSUPPORTED "Generator unpack delegated producer"
  -- if ~S.COMPILESTOP
  -- if S.TODO = (GENERATOR_UNPACK pgeneratorunpack text) :: ptask*
