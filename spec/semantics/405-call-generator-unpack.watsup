;; SEND_UNPACK uses the native Generator iterator, without PHP method frames.
;; Its marker owns the input and acquired DATA; the resume operation borrows DATA.
dec $generator_unpack_input(pstate, pgeneratorunpack) : bool
dec $generator_unpack_abort_input(pstate, pgeneratorunpack) : bool
dec $generator_unpack_shape(pgeneratorunpack, text) : bool
dec $generator_unpack_valid(pstate, pgeneratorunpack, text) : bool
dec $generator_unpack_count(ptask*) : nat
dec $generator_unpack_task_count(ptask) : nat
dec $generator_unpack_header(pstate, pgeneratorop, pgeneratorunpack, text) : bool
dec $generator_unpack_operation_tasks(pstate, pgeneratorop, ptask*) : bool
dec $generator_unpack_operation_frames(pstate, pgeneratorop, pframe*) : bool
dec $generator_unpack_operation_valid(pstate, pgeneratorop) : bool
dec $generator_unpack_run(pstate, pgeneratorunpack, text, ptask*) : pstate
dec $generator_unpack_send(pstate, pgeneratorunpack, ptask*) : pstate
dec $generator_unpack_nodes(pgeneratorunpack, text) : pnode*
dec $generator_unpack_finish(pstate, pgeneratorunpack, ptask*) : pstate
dec $generator_unpack_discard(pstate, pgeneratorunpack, text) : pstate
dec $generator_unpack_delegated_blocked(pstate) : bool

def $generator_unpack_input(S, pgeneratorunpack) = $iterator_unpack_input(S, pgeneratorunpack.CALL, pgeneratorunpack.INPUT)
  -- if pgeneratorunpack.INPUT = VARIABLE ptbytes z
def $generator_unpack_input(S, pgeneratorunpack) = $iterator_unpack_input(S, pgeneratorunpack.CALL, pgeneratorunpack.INPUT)
  -- if pgeneratorunpack.INPUT = REFERENCE n
def $generator_unpack_input(S, pgeneratorunpack) = true
  -- if pgeneratorunpack.INPUT = KNOWN (POBJECT n)
  -- if n = pgeneratorunpack.OBJECT
  -- if $unpack_class(S, pgeneratorunpack.CALL) =/= (UNPACK_CV)
  -- if $unpack_class(S, pgeneratorunpack.CALL) =/= eps
def $generator_unpack_input(S, pgeneratorunpack) = false -- otherwise

def $unpack_prepared(S, S_prepared, punpackcall, ptask_tail*) = S_prepared[.ORIGIN = $unpack_origin(S, punpackcall)][.TODO = (GENERATOR_UNPACK pgeneratorunpack "acquire") :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)][.HELD = S.HELD]
  -- if S_prepared.RESULT = KNOWN (POBJECT n)
  -- if $generator_object(S_prepared, n)
  -- if pgeneratorunpack = {CALL punpackcall, OBJECT n, INPUT S.RESULT, COUNT 0, NAMED false}
  -- if $iterator_unpack_plain(S, punpackcall)
  -- if $generator_unpack_input(S_prepared, pgeneratorunpack)
def $unpack_prepared(S, S_prepared, punpackcall, ptask_tail*) = S_prepared[.COMPLETION = UNSUPPORTED "Generator unpack target or operand ownership"][.HELD = S.HELD]
  -- if S_prepared.RESULT = KNOWN (POBJECT n)
  -- if $generator_object(S_prepared, n)
  -- if pgeneratorunpack = {CALL punpackcall, OBJECT n, INPUT S.RESULT, COUNT 0, NAMED false}
  -- if ~($iterator_unpack_plain(S, punpackcall) /\ $generator_unpack_input(S_prepared, pgeneratorunpack))

def $generator_unpack_shape(pgeneratorunpack, "acquire") = (pgeneratorunpack.COUNT = 0 /\ ~pgeneratorunpack.NAMED)
def $generator_unpack_shape(pgeneratorunpack, "rewind") = (pgeneratorunpack.COUNT = 0 /\ ~pgeneratorunpack.NAMED)
def $generator_unpack_shape(pgeneratorunpack, "next") = $(pgeneratorunpack.COUNT > 0)
def $generator_unpack_shape(pgeneratorunpack, "ready") = (pgeneratorunpack.COUNT =/= 0 \/ ~pgeneratorunpack.NAMED)
def $generator_unpack_shape(pgeneratorunpack, text) = false -- otherwise
def $generator_unpack_task_count(GENERATOR_UNPACK pgeneratorunpack text) = 1
def $generator_unpack_task_count(ptask) = 0 -- otherwise
def $generator_unpack_count(eps) = 0
def $generator_unpack_count(ptask :: ptask_tail*) = $($generator_unpack_task_count(ptask) + $generator_unpack_count(ptask_tail*))
def $generator_unpack_valid(S, pgeneratorunpack, text) = true
  -- if $generator_unpack_shape(pgeneratorunpack, text)
  -- if $unpack_origin(S, pgeneratorunpack.CALL) = (porigin)
  -- if S.ORIGIN = (porigin)
  -- if $iterator_unpack_plain(S, pgeneratorunpack.CALL)
  -- if $unpack_pending_valid(S[.ORIGIN = pgeneratorunpack.CALL.CALLSITE], pgeneratorunpack.CALL, 1)
  -- if $unpack_source_kind(S, pgeneratorunpack.CALL, true)
  -- if $generator_unpack_input(S, pgeneratorunpack)
  -- if $generator_object(S, pgeneratorunpack.OBJECT)
  -- if (HOBJECT pgeneratorunpack.OBJECT) <- S.ALLOCATIONS
  -- if $(pgeneratorunpack.COUNT <= $unpack_sent_count(pgeneratorunpack.CALL.SENT.SLOTS) + |pgeneratorunpack.CALL.SENT.NAMED|)
  -- if pgeneratorunpack.COUNT =/= 0 \/ $unpack_before_valid(S[.ORIGIN = pgeneratorunpack.CALL.CALLSITE], pgeneratorunpack.CALL, 1)
  -- if S.OBJECTS[pgeneratorunpack.OBJECT] = GENERATOR pgenerator
  -- if text =/= "ready" \/ (pgenerator.PHASE <- [GENERATOR_PAUSED, GENERATOR_CLOSED])
  -- if text =/= "next" \/ pgenerator.PHASE =/= GENERATOR_FRESH
  -- if $generator_unpack_count(S.TODO) = 1
def $generator_unpack_valid(S, pgeneratorunpack, text) = false -- otherwise

;; STARTPACK/BORROWED true/true is separate from Fiber start and yield-from.
;; Source argument authority and the real saved resumer are required as well.
def $generator_unpack_header(S, pgeneratorop, pgeneratorunpack, text) = true
  -- if pgeneratorop.STARTPACK /\ pgeneratorop.BORROWED
  -- if pgeneratorop.OBJECT = pgeneratorunpack.OBJECT
  -- if $unpack_origin(S, pgeneratorunpack.CALL) = (pgeneratorop.SITE)
  -- if pgeneratorop.LINE = $unpack_line(S, pgeneratorunpack.CALL)
  -- if pgeneratorop.LOOP = eps /\ pgeneratorop.ARGUMENTS = eps
  -- if ~pgeneratorop.ADVANCE
  -- if pgeneratorop.NAME = text /\ (text <- ["rewind", "next"])
  -- if $generator_unpack_shape(pgeneratorunpack, text)
def $generator_unpack_header(S, pgeneratorop, pgeneratorunpack, text) = false -- otherwise
def $generator_unpack_operation_tasks(S, pgeneratorop, (GENERATOR_RESUME pgeneratorop) :: (GENERATOR_UNPACK pgeneratorunpack text) :: ptask*) = true
  -- if $generator_unpack_header(S, pgeneratorop, pgeneratorunpack, text)
  -- if $generator_unpack_valid(S, pgeneratorunpack, text)
  -- if $generator_flat_tasks(S.TODO)
def $generator_unpack_operation_tasks(S, pgeneratorop, (THROW_SEARCH n) :: ptask*) = $generator_unpack_operation_tasks(S, pgeneratorop, ptask*)
def $generator_unpack_operation_tasks(S, pgeneratorop, ptask*) = false -- otherwise
def $generator_unpack_operation_frames(S, pgeneratorop, eps) = false
def $generator_unpack_operation_frames(S, pgeneratorop, pframe :: pframe_tail*) = ($generator_unpack_operation_tasks($constant_frame_scope(S, pframe, pframe_tail*), pgeneratorop, pframe.TODO) \/ $generator_unpack_operation_frames(S, pgeneratorop, pframe_tail*))
def $generator_unpack_operation_valid(S, pgeneratorop) = ($generator_unpack_operation_tasks(S, pgeneratorop, S.TODO) \/ $generator_unpack_operation_frames(S, pgeneratorop, S.FRAMES))
def $generator_operation_site(S, pgeneratorop) = $generator_unpack_operation_valid(S, pgeneratorop)
  -- if pgeneratorop.STARTPACK /\ pgeneratorop.BORROWED
  -- if ~$generator_from_site(S, pgeneratorop.SITE)
def $generator_resumption_valid(S, pgeneratorop) = ($generator_operation_valid(S, pgeneratorop) /\ $generator_resumption_stage(S, pgeneratorop))
  -- if pgeneratorop.STARTPACK /\ pgeneratorop.BORROWED
  -- if ~$generator_from_site(S, pgeneratorop.SITE)
def $generator_operation_trace(S, pgeneratorop) = eps
  -- if pgeneratorop.STARTPACK /\ pgeneratorop.BORROWED
  -- if ~$generator_from_site(S, pgeneratorop.SITE)
def $fiber_traversal_complete(S, pgeneratorop) = S[.TODO = (GENERATOR_UNPACK pgeneratorunpack "ready") :: ptask*]
  -- if pgeneratorop.STARTPACK /\ pgeneratorop.BORROWED
  -- if S.TODO = (GENERATOR_UNPACK pgeneratorunpack text) :: ptask*
