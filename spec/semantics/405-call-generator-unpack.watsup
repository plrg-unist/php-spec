  -- if $generator_unpack_valid(S, pgeneratorunpack, text)
  -- if S.OBJECTS[pgeneratorunpack.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.PHASE = GENERATOR_DELEGATING
def $generator_unpack_delegated_blocked(S) = false -- otherwise
def $generator_close_terminal_pending(S) = true -- if $generator_unpack_delegated_blocked(S)
def $drive_steps(S, n) = S -- if $generator_unpack_delegated_blocked(S)
def $generator_unpack_run(S, pgeneratorunpack, text, ptask*) = $generator_operate(S[.TODO = (GENERATOR_UNPACK pgeneratorunpack text) :: ptask*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], {OBJECT pgeneratorunpack.OBJECT, NAME text, SITE porigin, LINE $unpack_line(S, pgeneratorunpack.CALL), LOOP eps, ADVANCE false, ARGUMENTS eps, STARTPACK true, BORROWED true})
  -- if $generator_unpack_valid(S, pgeneratorunpack, text)
  -- if $unpack_origin(S, pgeneratorunpack.CALL) = (porigin)

rule PhpStep/generator-unpack-closed: S ~> $throw_scalar(S, "Exception", $ptascii("Cannot traverse an already closed generator"), $unpack_line(S, pgeneratorunpack.CALL))
  -- if S.TODO = (GENERATOR_UNPACK pgeneratorunpack "acquire") :: ptask*
  -- if S.OBJECTS[pgeneratorunpack.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.PHASE = GENERATOR_CLOSED
rule PhpStep/generator-unpack-acquire: S ~> S[.TODO = (GENERATOR_UNPACK pgeneratorunpack "rewind") :: ptask*]
  -- if S.TODO = (GENERATOR_UNPACK pgeneratorunpack "acquire") :: ptask*
  -- if S.OBJECTS[pgeneratorunpack.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.PHASE =/= GENERATOR_CLOSED
rule PhpStep/generator-unpack-rewind: S ~> $generator_unpack_run(S, pgeneratorunpack, "rewind", ptask*)
  -- if S.TODO = (GENERATOR_UNPACK pgeneratorunpack "rewind") :: ptask*
  -- if S.OBJECTS[pgeneratorunpack.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.PHASE =/= GENERATOR_CLOSED
rule PhpStep/generator-unpack-next: S ~> $generator_unpack_run(S, pgeneratorunpack, "next", ptask*)
  -- if S.TODO = (GENERATOR_UNPACK pgeneratorunpack "next") :: ptask*

;; The current-data pointer is borrowed; key checking precedes payload capture.
def $generator_unpack_send(S, pgeneratorunpack, ptask*) = $throw_scalar(S, "Error", $ptascii("Keys must be of type int|string during argument unpacking"), $unpack_line(S, pgeneratorunpack.CALL))
  -- if $fiber_traversal_key($generator_cached_value(S, pgeneratorunpack.OBJECT, true)) = eps
def $generator_unpack_send(S, pgeneratorunpack, ptask*) = S_check
