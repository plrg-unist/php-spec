rule PhpStep/generator-unpack-item: S ~> $generator_unpack_send(S, pgeneratorunpack, ptask*)
  -- if S.TODO = (GENERATOR_UNPACK pgeneratorunpack "ready") :: ptask*
  -- if S.OBJECTS[pgeneratorunpack.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.PHASE =/= GENERATOR_CLOSED
def $generator_unpack_nodes(pgeneratorunpack, "acquire") = $operand_nodes(pgeneratorunpack.INPUT)
def $generator_unpack_nodes(pgeneratorunpack, text) = [HOBJECT pgeneratorunpack.OBJECT] ++ $operand_nodes(pgeneratorunpack.INPUT) -- otherwise
def $generator_unpack_finish(S, pgeneratorunpack, ptask*) = $fiber_start_unpack_release(S[.ORIGIN = pgeneratorunpack.CALL.CALLSITE][.TODO = (UNPACK_ARGS $unpack_advance(pgeneratorunpack.CALL, pgeneratorunpack.CALL.SENT)) :: ptask*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], $generator_unpack_nodes(pgeneratorunpack, "ready"))
rule PhpStep/generator-unpack-finish: S ~> $generator_unpack_finish(S, pgeneratorunpack, ptask*)
  -- if S.TODO = (GENERATOR_UNPACK pgeneratorunpack "ready") :: ptask*
  -- if S.OBJECTS[pgeneratorunpack.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.PHASE = GENERATOR_CLOSED

def $task_nodes(GENERATOR_UNPACK pgeneratorunpack text) = $generator_unpack_nodes(pgeneratorunpack, text) ++ $unpack_call_roots(pgeneratorunpack.CALL)
def $call_task_valid(S, GENERATOR_UNPACK pgeneratorunpack text) = $generator_unpack_valid(S, pgeneratorunpack, text)
def $generator_internal_task(GENERATOR_UNPACK pgeneratorunpack text) = true
def $eager_explicit_task(GENERATOR_UNPACK pgeneratorunpack text) = true
def $return_discard(S, GENERATOR_RESUME pgeneratorop) = S[.ORIGIN = (pgeneratorop.SITE)]
  -- if pgeneratorop.STARTPACK /\ pgeneratorop.BORROWED
  -- if S.TODO = (THROW_SEARCH n) :: (GENERATOR_UNPACK pgeneratorunpack text) :: ptask*
  -- if $generator_unpack_header(S, pgeneratorop, pgeneratorunpack, text)
  -- if $generator_unpack_valid(S, pgeneratorunpack, text)

;; Abort SOURCE is documentary: input mode and syntax remain checkable after
;; DATA, caches and sent values retire. No live cache/array/store read is required.
def $generator_unpack_abort_input(S, pgeneratorunpack) = $generator_unpack_input(S, pgeneratorunpack)
  -- if pgeneratorunpack.INPUT = VARIABLE ptbytes z
def $generator_unpack_abort_input(S, pgeneratorunpack) = true
  -- if pgeneratorunpack.INPUT = KNOWN (POBJECT n)
  -- if n = pgeneratorunpack.OBJECT
  -- if $unpack_class(S, pgeneratorunpack.CALL) =/= (UNPACK_CV)
  -- if $unpack_class(S, pgeneratorunpack.CALL) =/= eps
def $generator_unpack_abort_input(S, pgeneratorunpack) = true
  -- if pgeneratorunpack.INPUT = REFERENCE n
  -- if $(n < |S.STORE|)
  -- if $unpack_class(S, pgeneratorunpack.CALL) =/= (UNPACK_CV)
  -- if $unpack_class(S, pgeneratorunpack.CALL) =/= eps
def $generator_unpack_abort_input(S, pgeneratorunpack) = false -- otherwise
