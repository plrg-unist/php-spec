  -- if S_active = $gc_worker_start_vm(S_running, n, pfiber)[.TODO = [GC_WORKER_SCAN pgcpublic]][.ACTIVEFIBER = (n)][.FIBERCALLERS = pfibercaller :: S_caller.FIBERCALLERS][.FIBERSEQ = $(S_caller.FIBERSEQ + 1)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]

def $gc_worker_replacement_tasks((GC_WORKER_PHYSICAL_REPLACE pgcplan pgcscan) :: ptask_tail*, pgcplan) = true
def $gc_worker_replace_tasks((GC_WORKER_PHYSICAL_REPLACE pgcplan pgcscan) :: ptask_tail*, pgcplan, pgcplan_new) = (GC_WORKER_PHYSICAL_REPLACE pgcplan_new pgcscan) :: ptask_tail*

;; Cache release may close the detached worker before its replacement starts.
;; Only the actual private-control release tail gains storage admission.
dec $gc_worker_physical_retiring(pstate, nat) : bool
dec $gc_worker_physical_retiring_mode(pstate, nat, pfiber, pdestructionrelease, pdestructionoperation, pgcplan) : bool
