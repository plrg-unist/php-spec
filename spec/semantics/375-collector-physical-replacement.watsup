;; A physical residual callback suspends through the real GC_WAIT caller.
;; Its guard becomes detached; a new worker reloads the remaining global
;; interval without assigning the old target any fresh-plan progress.
dec $gc_worker_physical_suspend(pstate, pconfigcall) : pstate
dec $gc_worker_physical_plan_ready(pgcplan, pgcpublic) : bool
dec $gc_worker_physical_cursor(pgcplan, pgcguard, pgcscan) : bool
dec $gc_worker_physical_plan(pgcplan, pgcscan) : pgcplan
dec $gc_worker_physical_replace_valid(pstate, pgcplan, pgcscan) : bool
dec $gc_worker_physical_replace_pass(pstate, pgcplan, pgcscan) : bool
dec $gc_worker_physical_start(pstate, pgcplan, pgcscan) : pstate

def $gc_worker_physical_suspend_ready(S) = true
  -- if $gc_worker_guard_at(S) = (pgcguard)
  -- if pgcguard.PUBLIC = (pgcpublic)
  -- if $gc_worker_api(pgcpublic.API)
  -- if S.GC.PLAN = (pgcplan)
  -- if $gc_worker_physical_plan_ready(pgcplan, pgcpublic)
  -- if pgcplan.INDEX = 0 /\ pgcplan.STEPS = eps /\ pgcplan.DONE = eps
  -- if S.GC.SCAN.END = |pgcplan.BUFFER|
  -- if $gc_worker_physical_cursor(pgcplan, pgcguard, S.GC.SCAN)
  -- if S.FIBERCALLERS = pfibercaller :: pfibercaller_tail*
  -- if pfibercaller.API = pgcpublic.API
  -- if pfibercaller.OBJECT = pgcguard.WORKER
  -- if pfibercaller.VM.TODO = (GC_WORKER_WAIT pgcguard.WORKER pgcplan) :: ptask_tail*
  -- if $fiber_caller_wait(S, pfibercaller)
  -- if ~$fiber_close_boundary(S)
def $gc_worker_physical_plan_ready(pgcplan, pgcpublic) = pgcpublic.RESIDUAL -- if pgcplan.SCAN = eps
def $gc_worker_physical_plan_ready(pgcplan, pgcpublic) = true
  -- if pgcplan.SCAN =/= eps
  -- if pgcplan.BUFFER = $gc_unmarked_slots(pgcplan.BUFFER)
def $gc_worker_physical_plan_ready(pgcplan, pgcpublic) = false -- otherwise
def $gc_worker_physical_cursor(pgcplan, pgcguard, pgcscan) = true
  -- if pgcguard.PUBLIC = (pgcpublic)
  -- if pgcpublic.RESIDUAL \/ (HOBJECT pgcguard.OBJECT) <- pgcplan.DTORS
  -- if pgcscan.INDEX = pgcguard.INDEX
def $gc_worker_physical_cursor(pgcplan, pgcguard, pgcscan) = true
  -- if pgcguard.PUBLIC = (pgcpublic)
  -- if ~pgcpublic.RESIDUAL
  -- if ~((HOBJECT pgcguard.OBJECT) <- pgcplan.DTORS)
  -- if pgcscan.INDEX = 0
def $gc_worker_physical_cursor(pgcplan, pgcguard, pgcscan) = false -- otherwise
def $fiber_suspend(S, pconfigcall, pvalue) = $gc_worker_physical_suspend(S, pconfigcall)
  -- if $gc_worker_physical_suspend_ready(S)
def $gc_worker_physical_suspend(S, pconfigcall) = $destructor_release_begin(S_detached, [DESTRUCTION_VALUE (HOBJECT n)])
  -- if S.ACTIVEFIBER = (n)
  -- if $fiber_at(S, n) = (pfiber)
  -- if pfiber.GC = (pgcworker)
  -- if pgcworker.GUARD = (pgcguard)
