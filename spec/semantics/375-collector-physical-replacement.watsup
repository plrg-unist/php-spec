def $gc_worker_physical_replace_pass(S, pgcplan, pgcscan) = true
  -- if pgcplan.SCAN = (pgcscan)
  -- if pgcplan.BUFFER = $gc_unmarked_slots(pgcplan.BUFFER)
def $gc_worker_physical_replace_pass(S, pgcplan, pgcscan) = false -- otherwise
def $gc_worker_internal_scan_range(pgcplan, pgcpublic) = true
  -- if pgcplan.SCAN = (pgcscan)
  -- if pgcplan.BUFFER = $gc_unmarked_slots(pgcplan.BUFFER)
  -- if pgcscan.END = pgcpublic.END
  -- if $(pgcscan.INDEX <= pgcpublic.INDEX)
def $call_task_valid(S, GC_WORKER_PHYSICAL_REPLACE pgcplan pgcscan) = $gc_worker_physical_replace_valid(S, pgcplan, pgcscan)
rule PhpStep/gc-worker-physical-replace: S ~> $gc_worker_physical_start(S, pgcplan, pgcscan)
  -- if S.TODO = (GC_WORKER_PHYSICAL_REPLACE pgcplan pgcscan) :: ptask_tail*
  -- if $gc_worker_physical_replace_valid(S, pgcplan, pgcscan)
def $gc_worker_physical_start(S, pgcplan, pgcscan) = $gc_worker_internal_next(S_active, pgcpublic)
