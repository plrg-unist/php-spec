  -- if S_saved = S_plain[.TODO = (FIBER_CONTINUE pfiberapi) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S_suspended = $fiber_put(S_saved, n, pfiber[.GC = (pgcworker[.GUARD = (pgcguard_new)])][.STATUS = FIBER_SUSPENDED][.VM = ($fiber_vm(S_saved))])
  -- if S_returned = $fiber_vm_restore(S_suspended, pfibercaller.VM)[.ACTIVEFIBER = pfibercaller.PREVIOUS][.FIBERCALLERS = pfibercaller_tail*]
  -- if S_returned.TODO = (GC_WORKER_WAIT n pgcplan) :: ptask_return*
  -- if pgcscan = S_returned.GC.SCAN[.INDEX = $(S_returned.GC.SCAN.INDEX + 1)]
  -- if pgcplan_next = $gc_worker_physical_plan(pgcplan, pgcscan)
  -- if S_detached = S_returned[.GC.WORKER = eps][.GC.SCAN = pgcscan][.GC.PLAN = (pgcplan_next)][.GC.ACTIVE = (pgcplan_next.CALL)][.TODO = (GC_WORKER_PHYSICAL_REPLACE pgcplan_next pgcscan) :: ptask_return*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)][.COMPLETION = NORMAL]
def $gc_worker_physical_plan(pgcplan, pgcscan) = pgcplan -- if pgcplan.SCAN = eps
def $gc_worker_physical_plan(pgcplan, pgcscan) = pgcplan[.SCAN = (pgcscan)] -- if pgcplan.SCAN =/= eps

def $gc_task_consumer(GC_WORKER_PHYSICAL_REPLACE pgcplan pgcscan, pgccall) = 1 -- if pgcplan.CALL = pgccall
def $gc_task_plan_consumer(GC_WORKER_PHYSICAL_REPLACE pgcplan_task pgcscan, pgcplan) = 1 -- if pgcplan_task = pgcplan
def $task_nodes(GC_WORKER_PHYSICAL_REPLACE pgcplan pgcscan) = $instance_roots(pgcplan.CALL.CALL.OWNER) ++ $instance_roots(pgcplan.CALL.PENDING)
def $eager_explicit_task(GC_WORKER_PHYSICAL_REPLACE pgcplan pgcscan) = true
