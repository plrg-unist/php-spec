def $value_order_effect(S, POBJECT n, PSTRING n_bytes*, pnode_seen*, z) = (S[.COMPLETION = UNSUPPORTED "Throwable string comparison"], ORDER 0)
  -- if $throwable_object(S, n)
def $value_order_effect(S, PSTRING n_bytes*, POBJECT n, pnode_seen*, z) = (S[.COMPLETION = UNSUPPORTED "Throwable string comparison"], ORDER 0)
  -- if $throwable_object(S, n)
def $foreach_start(S, statement, plocation, b, z) = S[.COMPLETION = UNSUPPORTED "Throwable property traversal"]
  -- if S.RESULT = KNOWN (POBJECT n)
