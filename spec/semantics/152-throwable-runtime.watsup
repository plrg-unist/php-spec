def $typed_callable(S, POBJECT n) = (false) -- if $throwable_object(S, n)

def $firstclass_value(S, porigin, z_init) = $throw_scalar(S, "Error", $ptascii("Object of type ") ++ $object_name(S, n) ++ $ptascii(" is not callable"), z_init)
  -- if S.COMPLETION = NORMAL
  -- if S.RESULT = KNOWN (POBJECT n)
  -- if $throwable_object(S, n)

;; Source-derived CV identity is checked without reconstructing mutable values.
dec $throwable_operand_valid(pstate, porigin) : bool
def $throwable_operand_valid(S, PORIGIN n pcpath) = true
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $source_unit(S.SOURCES, n) = (pcunit)
  -- if $ppunpack_class(pcode, pcunit, pcpath ++ [PCFIELD 0]) = (UNPACK_CV)
  -- if $exit_cv_operand(pcode, pcunit, pcpath ++ [PCFIELD 0]) = (S.RESULT)
def $throwable_operand_valid(S, PORIGIN n pcpath) = true
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $source_unit(S.SOURCES, n) = (pcunit)
  -- if $ppunpack_class(pcode, pcunit, pcpath ++ [PCFIELD 0]) = (punpackclass)
  -- if punpackclass =/= UNPACK_CV
  -- if $unpack_owned(S, S.RESULT)
def $throwable_operand_valid(S, porigin) = false -- otherwise
def $throwable_result_valid(S) = $throwable_result_valid(S[.ORIGIN = (porigin)][.TODO = ptask :: ptask_tail*])
  -- if S.TODO = (AT porigin ptask) :: ptask_tail*
def $throwable_result_valid(S) = $throwable_result_valid(S[.ORIGIN = porigin?][.TODO = ptask_tail*])
  -- if S.TODO = (ORIGIN_RETURN porigin?) :: ptask_tail*
def $throwable_result_valid(S) = $throwable_operand_valid(S, porigin)
  -- if S.TODO = (THROW_VALUE porigin z) :: ptask_tail*
def $throwable_result_valid(S) = (S.RESULT = KNOWN PNULL /\ S.BASE = BASE_VALUE (KNOWN PNULL))
  -- if S.TODO = (THROW_SEARCH n) :: ptask_tail*
def $throwable_result_valid(S) = (S.RESULT = KNOWN PNULL /\ S.BASE = BASE_VALUE (KNOWN PNULL))
  -- if S.TODO = (CATCH_BIND porigin n_index n) :: ptask_tail*
def $throwable_result_valid(S) = true -- otherwise

;; Throwable instances never own a Closure lexical scope row.
def $closure_scope_complete(S, (HOBJECT n) :: pnode_tail*) = $closure_scope_complete(S, pnode_tail*)
  -- if $(n < |S.OBJECTS|)
  -- if S.OBJECTS[n] = THROWABLE pthrowable
  -- if $closure_scope_at(S.CLOSURESCOPES, n) = eps
