  -- if pcpath_property = pcpath_hook[0:$nabs($( |pcpath_hook| - 2))] ++ [PCFIELD 3, PCINDEX 0]
  -- if $hook_property_at(pclassdesc.PROPERTIES, TRAIT_MEMBER_ORIGIN porigin_owner (PORIGIN n_hook pcpath_property)) = (ppropertydesc)
  -- if $property_set_trait_origin(S, ppropertydesc) = (pfunction.ORIGIN)
  -- if $property_hook_trait_function(S, ppropertydesc) = (pfunction)
  -- if pfunction.BODY = pcpath_hook ++ [PCFIELD 5]
  -- if $origin_node(S.SOURCES, PORIGIN n_hook pcpath_hook) = (NPropertyHook phpType14 phpType24 phpType4 phpType11 phpType16 (SEQUENCE statement*) metadata)
  -- if phpType16 =/= SEQUENCE eps

dec $property_set_function(pstate, ppropertyhook) : pfunction?
def $property_set_function(S, ppropertyhook) = (pfunction)
  -- if $(ppropertyhook.OBJECT < |S.OBJECTS|)
  -- if S.OBJECTS[ppropertyhook.OBJECT] = INSTANCE porigin_class
