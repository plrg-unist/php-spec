  -- if $property_set_origin(S, ppropertydesc) = (ppropertyhook.HOOK)
  -- if $property_declaring_class(S.CLASSES, ppropertydesc.ORIGIN) = (porigin_owner)
  -- if $class_at(S.CLASSES, porigin_owner) = (pclassdesc_owner)
  -- if pclassdesc_owner.KIND = "class"
  -- if $function_at($all_functions(S), ppropertyhook.HOOK) = (pfunction)
  -- if pfunction.NAME = pclassdesc_owner.NAME ++ $ptascii("::") ++ $property_set_name(ppropertydesc.NAME)
  -- if $property_set_signature_at(S, ppropertydesc) = (pssignature)
  -- if pfunction.SIGNATURE = pssignature
  -- if pfunction.DEFAULTS = eps /\ ~pfunction.EARLY
  -- if pfunction.ORIGIN = ppropertyhook.HOOK
  -- if $origin_source(pfunction.ORIGIN) = PORIGIN n pcpath_hook
  -- if pfunction.BODY = pcpath_hook ++ [PCFIELD 5]
  -- if ~$function_generator(S, pfunction)
def $property_set_function(S, ppropertyhook) = eps -- otherwise

dec $property_set_valid(pstate, ppropertyhook) : bool
def $property_set_valid(S, ppropertyhook) = true
  -- if $property_set_function(S, ppropertyhook) = (pfunction)
  -- if (HOBJECT ppropertyhook.OBJECT) <- S.ALLOCATIONS
  -- if ~$instance_storage_freeing(S, ppropertyhook.OBJECT)
  -- if ppropertyhook.SITE = PORIGIN n pcpath
  -- if $origin_node(S.SOURCES, ppropertyhook.SITE) = (NExprAssign (NExprPropertyFetch (NExprVariable (BYTES text_receiver) metadata_receiver) (NIdentifier (BYTES text_name) metadata_name) metadata_property) expression_rhs metadata)
  -- if $source_emission_cv(S, n, pcpath ++ [PCFIELD 0, PCFIELD 0], NExprVariable (BYTES text_receiver) metadata_receiver) \/ $source_emission_this_fetch(S, n, pcpath ++ [PCFIELD 0, PCFIELD 0], NExprVariable (BYTES text_receiver) metadata_receiver)
  -- if $property_effective_desc(S, ppropertyhook.OBJECT, $base64(text_name)) = (ppropertydesc)
  -- if ppropertydesc.ORIGIN = ppropertyhook.PROPERTY
  -- if $property_assign_task(S[.ORIGIN = (ppropertyhook.SITE)], NExprPropertyFetch (NExprVariable (BYTES text_receiver) metadata_receiver) (NIdentifier (BYTES text_name) metadata_name) metadata_property, expression_rhs)
  -- if $call_line_valid(S, (ppropertyhook.SITE), ppropertyhook.LINE)
def $property_set_valid(S, ppropertyhook) = false -- otherwise

dec $property_set_context_valid(pstate, pcallcontext) : bool
def $property_set_backing(S, n, ppropertydesc) = true
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.TARGET = PROPERTY_HOOK_TARGET ppropertyhook
  -- if $property_set_origin(S, ppropertydesc) =/= eps
  -- if $property_hook_backing(S, n, ppropertydesc)
  -- if $property_hook_context_valid(S, pcallcontext)
def $property_set_backing(S, n, ppropertydesc) = true
  -- if S.CURRENT = (pcallcontext)
