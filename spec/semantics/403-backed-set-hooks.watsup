  -- if $hook_body_backed(phpType39, ppropertydesc.NAME)
def $property_set_backing(S, n, ppropertydesc) = false -- otherwise
dec $property_set_virtual_active(pstate, nat, ppropertydesc) : bool
def $property_set_virtual_active(S, n, ppropertydesc) = true
  -- if $property_hook_virtual(S, ppropertydesc)
