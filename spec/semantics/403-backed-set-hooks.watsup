  -- if pfunction.ORIGIN = PORIGIN n pcpath_hook
  -- if pfunction.BODY = pcpath_hook ++ [PCFIELD 5]
  -- if $property_declaring_class(S.CLASSES, ppropertydesc.ORIGIN) = (porigin_owner)
  -- if $class_at(S.CLASSES, porigin_owner) = (pclassdesc)

def $property_hook_trait_function(S, ppropertydesc) = (pfunction[.ORIGIN = porigin_hook][.NAME = pclassdesc.NAME ++ $ptascii("::") ++ $property_set_name(ppropertydesc.NAME)])
  -- if ~$property_hook_pair_declared(S, ppropertydesc)
  -- if $property_set_trait_origin(S, ppropertydesc) = (porigin_hook)
  -- if $origin_node(S.SOURCES, porigin_hook) = (NPropertyHook phpType14_hook phpType24_hook phpType4_hook phpType11_hook phpType16_hook phpType39_hook metadata_hook)
  -- if phpType16_hook =/= SEQUENCE eps
  -- if ppropertydesc.ORIGIN = TRAIT_MEMBER_ORIGIN porigin_owner (PORIGIN n pcpath)
  -- if $class_at(S.CLASSES, porigin_owner) = (pclassdesc)
  -- if $trait_property_source_at(S.CLASSES, PORIGIN n pcpath) = (ppropertydesc_source)
  -- if ppropertydesc_source.ORIGIN = PORIGIN n pcpath
  -- if $property_set_signature_at(S, ppropertydesc_source) = (pssignature)
  -- if $property_set_builtin_types(ppropertydesc_source.TYPE) /\ $property_set_builtin_types(pssignature.PARAMETERS[0].TYPE)
  -- if $function_at(S.FUNCTIONS, $origin_source(porigin_hook)) = (pfunction)
  -- if $property_declaring_class(S.CLASSES, PORIGIN n pcpath) = (porigin_trait)
  -- if $class_at(S.CLASSES, porigin_trait) = (pclassdesc_trait)
  -- if pfunction.NAME = pclassdesc_trait.NAME ++ $ptascii("::") ++ $property_set_name(ppropertydesc_source.NAME)
  -- if pfunction.SIGNATURE = pssignature /\ pfunction.DEFAULTS = eps /\ ~pfunction.EARLY
  -- if pfunction.ORIGIN = $origin_source(porigin_hook)
  -- if pfunction.ORIGIN = PORIGIN n_hook pcpath_hook
  -- if pfunction.BODY = pcpath_hook ++ [PCFIELD 5]

def $property_set_signature_at(S, ppropertydesc) = ($property_set_signature(ppropertydesc))
  -- if $property_set_origin(S, ppropertydesc) = (porigin_hook)
  -- if $origin_node(S.SOURCES, porigin_hook) = (NPropertyHook phpType14 phpType24 phpType4 phpType11 (SEQUENCE eps) phpType39 metadata)
def $property_set_signature_at(S, ppropertydesc) = (pssignature)
  -- if $property_set_origin(S, ppropertydesc) = (porigin_hook)
  -- if $origin_node(S.SOURCES, porigin_hook) = (NPropertyHook phpType14 phpType24 phpType4 phpType11 phpType16 phpType39 metadata)
  -- if phpType16 =/= SEQUENCE eps
  -- if $property_declaring_class(S.CLASSES, ppropertydesc.ORIGIN) = (porigin_owner)
  -- if $class_at(S.CLASSES, porigin_owner) = (pclassdesc)
  -- if $function_at(S.FUNCTIONS, porigin_hook) = (pfunction)
  -- if porigin_hook = PORIGIN n pcpath_hook
  -- if phpType16 = SEQUENCE ([phpType17_parameter])
  -- if $origin_node(S.SOURCES, PORIGIN n (pcpath_hook ++ [PCFIELD 4, PCINDEX 0])) = (phpType17_parameter)
  -- if $(|pcpath_hook| >= 2)
  -- if pcpath_group = pcpath_hook[0:$nabs($( |pcpath_hook| - 2))]
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath_group) = (NStmtProperty phpType14_property phpType24_property phpType18_property phpType56_property phpType37_property metadata_property)
  -- if ptcontext = {NAMESPACE pfunction.ENV.NAMESPACE, IMPORTS pfunction.ENV.CLASSES, SCOPE PTKNOWN pclassdesc.NAME eps, POSITION PTRETURN, OWNER pclassdesc.NAME, MEMBER $property_set_name(ppropertydesc.NAME), FILE $call_sourcefile(S.FILES, porigin_hook), LINE $psline(metadata)}
  -- if $ptype_normalize(phpType18_property, ptcontext[.POSITION = PTPROPERTY][.MEMBER = ppropertydesc.NAME][.LINE = $psline(metadata_property)]) = PTOK ptbranch_property* eps
  -- if ptbranch_property* = ppropertydesc.TYPE
  -- if $property_set_explicit_signature(phpType16, ptcontext) = (pssignature)
  -- if $property_set_variance(ppropertydesc.TYPE, pssignature.PARAMETERS[0].TYPE, pclassdesc.NAME, pclassdesc.FINAL) = PVCOMPATIBLE
def $property_set_signature_at(S, ppropertydesc) = (pssignature)
  -- if ppropertydesc.ORIGIN = TRAIT_MEMBER_ORIGIN porigin_owner (PORIGIN n pcpath)
  -- if $property_set_trait_origin(S, ppropertydesc) = (porigin_hook)
  -- if $origin_node(S.SOURCES, porigin_hook) = (NPropertyHook phpType14 phpType24 phpType4 phpType11 phpType16 phpType39 metadata)
