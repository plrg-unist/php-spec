  -- if $property_slot_at(pobjectprops.SLOTS, ptbytes) = eps
def $property_set_write_only(S, n, ptbytes) = false -- otherwise
def $property_read_key(S, POBJECT n, ptbytes, z) = $throw_scalar(S, "Error", $ptascii("Property ") ++ $object_name(S, n) ++ $ptascii("::$") ++ $c_string($property_visible_name(S, n, ptbytes)) ++ $ptascii(" is write-only"), z)
  -- if ~$instance_storage_freeing(S, n)
  -- if ~$property_hook_read_needed(S, n, ptbytes)
  -- if ~$property_get_needed(S, n, ptbytes)
  -- if $property_set_write_only(S, n, ptbytes)

;; Call authority is checked in the original caller and again through its frame.
dec $property_set_access_allowed(pstate, ppropertyhook) : bool
def $property_set_access_allowed(S, ppropertyhook) = true
  -- if S.OBJECTS[ppropertyhook.OBJECT] = INSTANCE porigin_class
  -- if $hook_property_at($property_layout(S, porigin_class, |S.CLASSES|), ppropertyhook.PROPERTY) = (ppropertydesc)
  -- if ~$property_set_denied(S, ppropertyhook.OBJECT, ppropertydesc.KEY)
def $property_set_access_allowed(S, ppropertyhook) = false -- otherwise

;; Pending receiver/name resolution precedes RHS dereference, as in ordinary assignment.
dec $property_set_plan(pstate) : ppropertyhook?
def $property_set_plan(S) = (ppropertyhook)
  -- if S.TODO = (ASSIGN_ARRAY (BASE_PROPERTY_PENDING pbase poperand z_receiver) z false) :: ptask_tail*
  -- if S.ORIGIN = (porigin_site)
  -- if $property_pending_assign_valid(S, BASE_PROPERTY_PENDING pbase poperand z_receiver, z, false)
  -- if S_target = $property_pending_resolve(S, pbase, poperand, PPW, z_receiver, z)
  -- if S_target.COMPLETION = NORMAL
  -- if S_target.BASE = BASE_PROPERTY (POBJECT n) ptbytes
  -- if $property_set_needed(S, n, ptbytes)
  -- if $property_resolve(S, n, ptbytes) = PROPERTY_ACCESS ptbytes
  -- if $property_effective_desc(S, n, ptbytes) = (ppropertydesc)
  -- if ~$property_set_virtual_active(S, n, ppropertydesc)
  -- if $property_set_origin(S, ppropertydesc) = (porigin_hook)
  -- if porigin_property = ppropertydesc.ORIGIN
  -- if ppropertyhook = {SITE porigin_site, OBJECT n, PROPERTY porigin_property, HOOK porigin_hook, LINE z}
  -- if $property_set_valid(S, ppropertyhook)
  -- if $property_set_access_allowed(S, ppropertyhook)
def $property_set_plan(S) = eps -- otherwise

;; Denial follows operand resolution, but precedes setter argument reception.
dec $property_set_denied_plan(pstate) : ppropertyhook?
def $property_set_denied_plan(S) = (ppropertyhook)
  -- if S.TODO = (ASSIGN_ARRAY (BASE_PROPERTY_PENDING pbase poperand z_receiver) z false) :: ptask_tail*
  -- if S.ORIGIN = (porigin_site)
  -- if $property_pending_assign_valid(S, BASE_PROPERTY_PENDING pbase poperand z_receiver, z, false)
  -- if S_target = $property_pending_resolve(S, pbase, poperand, PPW, z_receiver, z)
  -- if S_target.COMPLETION = NORMAL
  -- if S_target.BASE = BASE_PROPERTY (POBJECT n) ptbytes
  -- if $property_set_needed(S, n, ptbytes)
  -- if $property_resolve(S, n, ptbytes) = PROPERTY_ACCESS ptbytes
  -- if $property_effective_desc(S, n, ptbytes) = (ppropertydesc)
  -- if $property_set_denied(S, n, ptbytes)
  -- if $property_set_origin(S, ppropertydesc) = (porigin_hook)
  -- if porigin_property = ppropertydesc.ORIGIN
  -- if ppropertyhook = {SITE porigin_site, OBJECT n, PROPERTY porigin_property, HOOK porigin_hook, LINE z}
  -- if $property_set_valid(S, ppropertyhook)
def $property_set_denied_plan(S) = eps -- otherwise

;; Active virtual SET has no backing store, even through a same-object alias.
;; This slice resolves an actual defined CV input before the handler Error.
dec $property_set_virtual_write_error(pstate) : ppropertyhook?
def $property_set_virtual_write_error(S) = (ppropertyhook)
  -- if S.TODO = (ASSIGN_ARRAY (BASE_PROPERTY_PENDING pbase poperand z_receiver) z false) :: ptask_tail*
  -- if S.ORIGIN = (PORIGIN n_site pcpath_site)
  -- if $property_pending_assign_valid(S, BASE_PROPERTY_PENDING pbase poperand z_receiver, z, false)
  -- if S_target = $property_pending_resolve(S, pbase, poperand, PPW, z_receiver, z)
  -- if S_target.COMPLETION = NORMAL
  -- if S_target.BASE = BASE_PROPERTY (POBJECT n) ptbytes
  -- if $property_set_needed(S, n, ptbytes)
  -- if $property_resolve(S, n, ptbytes) = PROPERTY_ACCESS ptbytes
  -- if $property_effective_desc(S, n, ptbytes) = (ppropertydesc)
  -- if $property_set_virtual_active(S, n, ppropertydesc)
  -- if $property_set_origin(S, ppropertydesc) = (porigin_hook)
  -- if porigin_property = ppropertydesc.ORIGIN
  -- if ppropertyhook = {SITE (PORIGIN n_site pcpath_site), OBJECT n, PROPERTY porigin_property, HOOK porigin_hook, LINE z}
  -- if $property_set_valid(S, ppropertyhook)
  -- if $origin_node(S.SOURCES, PORIGIN n_site pcpath_site) = (NExprAssign expression_target (NExprVariable (BYTES text_input) metadata_input) metadata)
  -- if $source_emission_cv(S, n_site, pcpath_site ++ [PCFIELD 1], NExprVariable (BYTES text_input) metadata_input)
  -- if S.RESULT = VARIABLE ($base64(text_input)) z_input
  -- if $lookup(S.ENV, $base64(text_input)) = (n_input)
  -- if S.STORE[n_input] = DEFINED pvalue_input
def $property_set_virtual_write_error(S) = eps -- otherwise
def $property_set_pending(S) = true
  -- if S.TODO = (ASSIGN_ARRAY (BASE_PROPERTY_PENDING pbase poperand z_receiver) z b) :: ptask_tail*
  -- if S_target = $property_pending_resolve(S, pbase, poperand, PPW, z_receiver, z)
  -- if S_target.COMPLETION = NORMAL
  -- if S_target.BASE = BASE_PROPERTY (POBJECT n) ptbytes
  -- if $property_set_needed(S, n, ptbytes)
def $property_set_pending(S) = false -- otherwise

rule PhpStep/property-set-call: S ~> S_rhs[.TODO = [(CALL_ARGS (PROPERTY_SET_TARGET ppropertyhook) eps 1 ([KNOWN pvalue]) (ppropertyhook.SITE) ppropertyhook.LINE), PROPERTY_SET_RESULT ppropertyhook pvalue] ++ ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (ASSIGN_ARRAY (BASE_PROPERTY_PENDING pbase poperand z_receiver) z false) :: ptask_tail*
  -- if $property_set_plan(S) = (ppropertyhook)
  -- if S_target = $property_pending_resolve(S, pbase, poperand, PPW, z_receiver, z)
  -- if S_rhs = $resolve_at(S_target, S.RESULT, z)
  -- if S_rhs.COMPLETION = NORMAL
  -- if S_rhs.RESULT = KNOWN pvalue
rule PhpStep/property-set-rhs-abrupt: S ~> S_rhs[.TODO = eps]
  -- if S.TODO = (ASSIGN_ARRAY (BASE_PROPERTY_PENDING pbase poperand z_receiver) z false) :: ptask_tail*
  -- if $property_set_plan(S) = (ppropertyhook)
  -- if S_target = $property_pending_resolve(S, pbase, poperand, PPW, z_receiver, z)
  -- if S_rhs = $resolve_at(S_target, S.RESULT, z)
  -- if S_rhs.COMPLETION =/= NORMAL
rule PhpStep/property-set-denied: S ~> $property_set_check(S_rhs[.TODO = ptask_tail*], ppropertyhook.OBJECT, ptbytes, $ptascii("modify"), z)
  -- if S.TODO = (ASSIGN_ARRAY (BASE_PROPERTY_PENDING pbase poperand z_receiver) z false) :: ptask_tail*
  -- if $property_set_denied_plan(S) = (ppropertyhook)
  -- if S_target = $property_pending_resolve(S, pbase, poperand, PPW, z_receiver, z)
  -- if S_target.BASE = BASE_PROPERTY (POBJECT ppropertyhook.OBJECT) ptbytes
  -- if S_rhs = $resolve_at(S_target, S.RESULT, z)
  -- if S_rhs.COMPLETION = NORMAL
rule PhpStep/property-set-denied-rhs-abrupt: S ~> S_rhs[.TODO = ptask_tail*]
  -- if S.TODO = (ASSIGN_ARRAY (BASE_PROPERTY_PENDING pbase poperand z_receiver) z false) :: ptask_tail*
  -- if $property_set_denied_plan(S) = (ppropertyhook)
  -- if S_target = $property_pending_resolve(S, pbase, poperand, PPW, z_receiver, z)
  -- if S_rhs = $resolve_at(S_target, S.RESULT, z)
  -- if S_rhs.COMPLETION =/= NORMAL
rule PhpStep/property-set-virtual-write-error: S ~> $throw_scalar(S_rhs[.TODO = ptask_tail*], "Error", $ptascii("Must not write to virtual property ") ++ $object_name(S_rhs, ppropertyhook.OBJECT) ++ $ptascii("::$") ++ $c_string(ptbytes), z)
  -- if S.TODO = (ASSIGN_ARRAY (BASE_PROPERTY_PENDING pbase poperand z_receiver) z false) :: ptask_tail*
  -- if $property_set_virtual_write_error(S) = (ppropertyhook)
  -- if S_target = $property_pending_resolve(S, pbase, poperand, PPW, z_receiver, z)
  -- if S_target.BASE = BASE_PROPERTY (POBJECT ppropertyhook.OBJECT) ptbytes
  -- if S_rhs = $resolve_at(S_target, S.RESULT, z)
  -- if S_rhs.COMPLETION = NORMAL
rule PhpStep/property-set-virtual-write-rhs-abrupt: S ~> S_rhs[.TODO = ptask_tail*]
  -- if S.TODO = (ASSIGN_ARRAY (BASE_PROPERTY_PENDING pbase poperand z_receiver) z false) :: ptask_tail*
  -- if $property_set_virtual_write_error(S) = (ppropertyhook)
  -- if S_target = $property_pending_resolve(S, pbase, poperand, PPW, z_receiver, z)
  -- if S_rhs = $resolve_at(S_target, S.RESULT, z)
  -- if S_rhs.COMPLETION =/= NORMAL
rule PhpStep/property-set-unsupported: S ~> S[.COMPLETION = UNSUPPORTED "set hook assignment source or function"]
  -- if $property_set_pending(S)
  -- if $property_set_plan(S) = eps
  -- if $property_set_virtual_write_error(S) = eps
  -- if $property_set_denied_plan(S) = eps
rule PhpStep/property-set-result: S ~> S[.TODO = ptask_tail*][.RESULT = KNOWN pvalue][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (PROPERTY_SET_RESULT ppropertyhook pvalue) :: ptask_tail*
  -- if S.COMPLETION = NORMAL /\ S.RESULT = KNOWN PNULL
  -- if S.ORIGIN = (ppropertyhook.SITE)
  -- if $property_set_valid(S, ppropertyhook)
  -- if $property_set_access_allowed(S, ppropertyhook)

;; The saved result owns the receiver across entry and frame restoration.
def $target_nodes(PROPERTY_SET_TARGET ppropertyhook) = eps
def $call_receiver_roots(pcallcontext) = eps
  -- if pcallcontext.TARGET = PROPERTY_SET_TARGET ppropertyhook
def $target_instance(PROPERTY_SET_TARGET ppropertyhook) = eps
def $target_receiver(S, PROPERTY_SET_TARGET ppropertyhook) = (ppropertyhook.OBJECT)
def $target_lexical_class(S, PROPERTY_SET_TARGET ppropertyhook) = $property_declaring_class(S.CLASSES, ppropertyhook.PROPERTY)
def $target_called_class(S, PROPERTY_SET_TARGET ppropertyhook) = (porigin)
  -- if S.OBJECTS[ppropertyhook.OBJECT] = INSTANCE porigin
def $target_function(S, PROPERTY_SET_TARGET ppropertyhook) = $property_set_function(S, ppropertyhook)
  -- if $property_set_valid(S, ppropertyhook)
  -- if $property_set_access_allowed(S, ppropertyhook)
def $task_nodes(PROPERTY_SET_RESULT ppropertyhook pvalue) = [HOBJECT ppropertyhook.OBJECT] ++ $value_nodes(pvalue)

dec $property_set_tail(pstate, ppropertyhook, ptask*) : bool
def $property_set_tail(S, ppropertyhook, (PROPERTY_SET_RESULT ppropertyhook pvalue) :: ptask_tail*) = ($property_set_valid(S, ppropertyhook) /\ $property_set_access_allowed(S, ppropertyhook))
def $property_set_tail(S, ppropertyhook, ptask*) = false -- otherwise
dec $property_set_pending_call(pstate, ppropertyhook) : bool
def $property_set_pending_call(S, ppropertyhook) = true
  -- if S.TODO = (CALL_ARGS (PROPERTY_SET_TARGET ppropertyhook) eps 1 ([KNOWN pvalue]) (ppropertyhook.SITE) ppropertyhook.LINE) :: (PROPERTY_SET_RESULT ppropertyhook pvalue) :: ptask_tail*
  -- if S.ORIGIN = (ppropertyhook.SITE)
  -- if $property_set_valid(S, ppropertyhook)
  -- if $property_set_access_allowed(S, ppropertyhook)
def $property_set_pending_call(S, ppropertyhook) = false -- otherwise
dec $property_set_frame(pstate, pcallcontext, pframe, ppropertyhook) : bool
def $property_set_frame(S, pcallcontext, pframe, ppropertyhook) = true
  -- if pcallcontext.TARGET = PROPERTY_SET_TARGET ppropertyhook
  -- if pcallcontext.CALLSITE = (ppropertyhook.SITE) /\ pcallcontext.LINE = ppropertyhook.LINE
  -- if pcallcontext.ARGC = 1 /\ pcallcontext.EXTRA = eps /\ pcallcontext.NAMED = eps /\ pcallcontext.WRAPPER = eps /\ pcallcontext.HOLES = eps
  -- if pframe.ORIGIN = (ppropertyhook.SITE)
  -- if $property_set_tail(S[.CURRENT = pframe.CONTEXT], ppropertyhook, pframe.TODO)
def $property_set_frame(S, pcallcontext, pframe, ppropertyhook) = false -- otherwise
dec $property_set_entered(pstate, pcallcontext?, pframe*, ppropertyhook) : bool
def $property_set_entered(S, (pcallcontext), pframe :: pframe_tail*, ppropertyhook) = $property_set_frame(S, pcallcontext, pframe, ppropertyhook)
  -- if pcallcontext.TARGET = PROPERTY_SET_TARGET ppropertyhook
def $property_set_entered(S, (pcallcontext), pframe :: pframe_tail*, ppropertyhook) = $property_set_entered(S, pframe.CONTEXT, pframe_tail*, ppropertyhook)
  -- if pcallcontext.TARGET =/= PROPERTY_SET_TARGET ppropertyhook
def $property_set_entered(S, eps, pframe :: pframe_tail*, ppropertyhook) = $property_set_entered(S, pframe.CONTEXT, pframe_tail*, ppropertyhook)
def $property_set_entered(S, pcallcontext?, eps, ppropertyhook) = false
def $property_set_context_valid(S, pcallcontext) = true
  -- if pcallcontext.TARGET = PROPERTY_SET_TARGET ppropertyhook
  -- if pcallcontext.CALLSITE = (ppropertyhook.SITE) /\ pcallcontext.LINE = ppropertyhook.LINE
  -- if pcallcontext.ARGC = 1 /\ pcallcontext.EXTRA = eps /\ pcallcontext.NAMED = eps /\ pcallcontext.WRAPPER = eps /\ pcallcontext.HOLES = eps
  -- if $property_set_entered(S, S.CURRENT, S.FRAMES, ppropertyhook)
def $property_set_context_valid(S, pcallcontext) = false -- otherwise

def $call_selected_valid(S, PROPERTY_SET_TARGET ppropertyhook, (porigin)) = (porigin = ppropertyhook.SITE /\ ($property_set_pending_call(S, ppropertyhook) \/ $property_set_entered(S, S.CURRENT, S.FRAMES, ppropertyhook)))
def $call_arguments_valid(S, (porigin), 1, eps, poperand :: eps, 0) = true
  -- if poperand = KNOWN pvalue
  -- if S.TODO = (CALL_ARGS (PROPERTY_SET_TARGET ppropertyhook) eps 1 (poperand :: eps) (porigin) z) :: ptask_tail*
  -- if $property_set_pending_call(S, ppropertyhook)
def $call_arity_valid(S, pcallcontext) = $property_set_context_valid(S, pcallcontext)
  -- if pcallcontext.TARGET = PROPERTY_SET_TARGET ppropertyhook
def $call_extent_valid(S, pcallcontext) = $property_set_context_valid(S, pcallcontext)
  -- if pcallcontext.TARGET = PROPERTY_SET_TARGET ppropertyhook
def $named_context_valid(S, pcallcontext) = $property_set_context_valid(S, pcallcontext)
  -- if pcallcontext.TARGET = PROPERTY_SET_TARGET ppropertyhook
def $named_receives_ready(S, pfunction) = true
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.FUNCTION = pfunction.ORIGIN
  -- if $property_set_context_valid(S, pcallcontext)
def $call_task_valid(S, PROPERTY_SET_RESULT ppropertyhook pvalue) = ($property_set_pending_call(S, ppropertyhook) \/ $property_set_tail(S, ppropertyhook, S.TODO))
def $default_parameter_line(S, porigin, 0) = $source_line(metadata)
  -- if $origin_node(S.SOURCES, porigin) = (NPropertyHook (SEQUENCE eps) (INTEGER 0) (BOOLEAN false) (NIdentifier (BYTES text_set) metadata_name) (SEQUENCE eps) (SEQUENCE statement*) metadata)
  -- if $ptlc($base64(text_set)) = $ptascii("set")
