  -- if $property_set_builtin_types(ppropertydesc_source.TYPE) /\ $property_set_builtin_types(pssignature.PARAMETERS[0].TYPE)
def $property_set_signature_at(S, ppropertydesc) = eps -- otherwise

def $function_body_tasks(S, pfunction) = $statement_tasks(statement*, (PORIGIN n_hook pfunction.BODY), 0) ++ [$function_fallthrough(S, pfunction)]
  -- if pfunction.ORIGIN = TRAIT_ORIGIN porigin_owner (PORIGIN n_hook pcpath_hook) ptbytes_hook
  -- if $class_at(S.CLASSES, porigin_owner) = (pclassdesc)
