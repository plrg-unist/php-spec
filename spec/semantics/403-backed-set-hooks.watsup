;; A backed class setter has either the implicit value or one actual source Param.
dec $property_set_name(ptbytes) : ptbytes
def $property_set_name(ptbytes) = [36] ++ ptbytes ++ $ptascii("::set")
dec $property_set_signature(ppropertydesc) : pssignature
def $property_set_signature(ppropertydesc) = {PARAMETERS ([{NAME $ptascii("value"), TYPE ppropertydesc.TYPE, BYREF false, VARIADIC false, REQUIRED true, DEFAULT PSNONE}]), RETURNS ([(PTBRANCH ([PTBUILTIN "void"]))]), BYREF false}

def $pphook_owner_shape(pchheader, NVarLikeIdentifier (BYTES text) metadata_name, NPropertyHook (SEQUENCE eps) (INTEGER 0) (BOOLEAN false) (NIdentifier (BYTES text_set) metadata_set) (SEQUENCE eps) (SEQUENCE statement*) metadata, phpType5) = true
  -- if pchheader.KIND = "trait" /\ pchheader.PARENT = eps
  -- if $ptlc($base64(text_set)) = $ptascii("set")
  -- if $hook_body_backed(SEQUENCE statement*, $base64(text))

;; The asymmetric setter slice keeps a public backing key and one implicit hook.
def $ppproperty_hook_group(P, pcpath, NStmtProperty (SEQUENCE eps) (INTEGER flags) phpType18 (SEQUENCE ([NPropertyItem (NVarLikeIdentifier (BYTES text) metadata_name) phpType5 metadata_item])) (SEQUENCE ([NPropertyHook (SEQUENCE eps) (INTEGER 0) (BOOLEAN false) (NIdentifier (BYTES text_set) metadata_set) (SEQUENCE eps) (SEQUENCE statement*) metadata_hook])) metadata, ppropertydesc*, pchheader) = PPROPERTIES $pphook_compile(P_next, pcpath ++ [PCFIELD 4, PCINDEX 0], ppropertydesc_new, NPropertyHook (SEQUENCE eps) (INTEGER 0) (BOOLEAN false) (NIdentifier (BYTES text_set) metadata_set) (SEQUENCE eps) (SEQUENCE statement*) metadata_hook, pchheader) ppropertydesc_next*
  -- if flags <- [256,257,512,513] /\ phpType18 =/= ABSENT
  -- if pchheader.KIND = "class" /\ pchheader.PARENT = eps /\ ~pchheader.READONLY /\ ~$pptrait_body_uses(pchheader.BODY)
  -- if $ptlc($base64(text_set)) = $ptascii("set") /\ $hook_body_backed(SEQUENCE statement*, $base64(text))
  -- if $ppproperty_group_line_valid(P, metadata)
  -- if PPROPERTIES P_next ppropertydesc_next* = $ppproperty_group($pplocate(P, pcpath, $source_line(metadata)), pcpath, flags, phpType18, [NPropertyItem (NVarLikeIdentifier (BYTES text) metadata_name) phpType5 metadata_item], ppropertydesc*, pchheader, $source_line(metadata))
  -- if P_next.COMPLETION = PPCNORMAL
  -- if |ppropertydesc_next*| = $(|ppropertydesc*| + 1)
  -- if ppropertydesc_new = ppropertydesc_next*[|ppropertydesc*|]
def $ppproperty_hook_group(P, pcpath, NStmtProperty (SEQUENCE eps) (INTEGER flags) phpType18 (SEQUENCE ([NPropertyItem (NVarLikeIdentifier (BYTES text) metadata_name) phpType5 metadata_item])) (SEQUENCE ([NPropertyHook (SEQUENCE eps) (INTEGER 0) (BOOLEAN false) (NIdentifier (BYTES text_set) metadata_set) (SEQUENCE eps) (SEQUENCE statement*) metadata_hook])) metadata, ppropertydesc*, pchheader) = PPROPERTIES P_next ppropertydesc_next*
  -- if flags <- [256,257,512,513] /\ phpType18 =/= ABSENT
  -- if pchheader.KIND = "class" /\ pchheader.PARENT = eps /\ ~pchheader.READONLY /\ ~$pptrait_body_uses(pchheader.BODY)
  -- if $ptlc($base64(text_set)) = $ptascii("set") /\ $hook_body_backed(SEQUENCE statement*, $base64(text))
  -- if $ppproperty_group_line_valid(P, metadata)
  -- if PPROPERTIES P_next ppropertydesc_next* = $ppproperty_group($pplocate(P, pcpath, $source_line(metadata)), pcpath, flags, phpType18, [NPropertyItem (NVarLikeIdentifier (BYTES text) metadata_name) phpType5 metadata_item], ppropertydesc*, pchheader, $source_line(metadata))
  -- if P_next.COMPLETION =/= PPCNORMAL

