def $property_set_parameters(phpType16) = false -- otherwise
def $property_set_builtin_types(eps) = true
def $property_set_builtin_types((PTBRANCH ([PTBUILTIN text])) :: ptbranch*) = $property_set_builtin_types(ptbranch*)
def $property_set_builtin_types(ptbranch*) = false -- otherwise

def $pphook_owner_shape(pchheader, NVarLikeIdentifier (BYTES text) metadata_name, NPropertyHook (SEQUENCE eps) (INTEGER 0) (BOOLEAN false) (NIdentifier (BYTES text_set) metadata_set) phpType16 (SEQUENCE statement*) metadata, phpType5) = true
