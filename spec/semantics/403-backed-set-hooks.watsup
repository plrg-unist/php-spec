dec $property_set_variance(ptbranch*, ptbranch*, ptbytes, bool) : pvresult
def $property_set_variance(ptbranch_property*, ptbranch_parameter*, ptbytes, b_final) = $pvcovariant(ptbranch_property*, pvclass, ptbranch_parameter*, pvclass, eps)
  -- if pvclass = {NAME ptbytes, PARENT eps, ANCESTORS eps, FINAL b_final}
dec $ppset_explicit_finish(ppstate, ppstate, pcpath, ppropertydesc, pssignature, metadata, pchheader) : ppstate
def $ppset_explicit_finish(P, P_body, pcpath, ppropertydesc, pssignature, metadata, pchheader) = P_body
  -- if P_body.COMPLETION =/= PPCNORMAL
def $ppset_explicit_finish(P, P_body, pcpath, ppropertydesc, pssignature, metadata, pchheader) = $pphook_finish_named(P, P_body, pcpath, pchheader.NAME ++ $ptascii("::") ++ $property_set_name(ppropertydesc.NAME), pssignature, metadata)
  -- if P_body.COMPLETION = PPCNORMAL
  -- if $property_set_variance(ppropertydesc.TYPE, pssignature.PARAMETERS[0].TYPE, pchheader.NAME, pchheader.FINAL) = PVCOMPATIBLE
def $ppset_explicit_finish(P, P_body, pcpath, ppropertydesc, pssignature, metadata, pchheader) = $ppsignature_issue(P_body, "fatal", $ptascii("Type of parameter $") ++ pssignature.PARAMETERS[0].NAME ++ $ptascii(" of hook ") ++ pchheader.NAME ++ $ptascii("::$") ++ ppropertydesc.NAME ++ $ptascii("::set must be compatible with property type"), $psendline(metadata))
  -- if P_body.COMPLETION = PPCNORMAL
  -- if $property_set_variance(ppropertydesc.TYPE, pssignature.PARAMETERS[0].TYPE, pchheader.NAME, pchheader.FINAL) = PVINCOMPATIBLE
def $ppset_explicit_finish(P, P_body, pcpath, ppropertydesc, pssignature, metadata, pchheader) = $ppunsupported(P_body, "set hook parameter type variance")
  -- if P_body.COMPLETION = PPCNORMAL
  -- if $property_set_variance(ppropertydesc.TYPE, pssignature.PARAMETERS[0].TYPE, pchheader.NAME, pchheader.FINAL) =/= PVCOMPATIBLE
  -- if $property_set_variance(ppropertydesc.TYPE, pssignature.PARAMETERS[0].TYPE, pchheader.NAME, pchheader.FINAL) =/= PVINCOMPATIBLE
def $pphook_compile(P, pcpath, ppropertydesc, NPropertyHook (SEQUENCE eps) (INTEGER 0) (BOOLEAN false) (NIdentifier (BYTES text_set) metadata_name) phpType16 (SEQUENCE statement*) metadata, pchheader) = $ppset_explicit_finish(P, $ppgoto_finish($ppstatements(P_parameter, pcpath ++ [PCFIELD 5], 0, statement*)), pcpath, ppropertydesc, pssignature, metadata, pchheader)
  -- if $ptlc($base64(text_set)) = $ptascii("set")
  -- if pchheader.KIND <- ["class","trait"] /\ pchheader.PARENT = eps
  -- if ppropertydesc.TYPE =/= eps /\ $hook_body_backed(SEQUENCE statement*, ppropertydesc.NAME)
  -- if z = $source_line(metadata)
  -- if $(z > 0 /\ z <= $source_end_line(metadata))
  -- if $property_set_explicit_signature(phpType16, $ppmethod_context(P, pchheader, $property_set_name(ppropertydesc.NAME), z)) = (pssignature)
  -- if pchheader.KIND = "class" \/ ($property_set_builtin_types(ppropertydesc.TYPE) /\ $property_set_builtin_types(pssignature.PARAMETERS[0].TYPE))
  -- if phpType16 = SEQUENCE ([NParam phpType14_param phpType24_param phpType18_param phpType4_ref phpType4_var phpType10_param phpType5_param phpType37_param metadata_param])
  -- if ptbytes_name = pchheader.NAME ++ $ptascii("::") ++ $property_set_name(ppropertydesc.NAME)
  -- if P_hook = $ppfunction_start($pplocate(P[.CLASSCONTEXT = ($ppmethod_context(P, pchheader, $property_set_name(ppropertydesc.NAME), z))], pcpath, z), ptbytes_name, pssignature)[.RETURNREF = false][.RETURNS = pssignature.RETURNS][.GOTOROOT = pcpath][.FOLD = P.FOLD[.FUNCTION = ptbytes_name][.CLASSCONTEXT = ($ppmethod_context(P, pchheader, $property_set_name(ppropertydesc.NAME), z))][.CLOSURE = false][.DEFAULT = false][.CONSTANT = false][.VALUE = eps]]
  -- if P_parameter = $ppmethod_default_parameter(P_hook[.LOCATION.LINE = $psline(metadata_param)], pcpath, 0)

def $function_body_tasks(S, pfunction) = $statement_tasks(statement*, (PORIGIN n pfunction.BODY), 0) ++ [$function_fallthrough(S, pfunction)]
  -- if pfunction.ORIGIN = PORIGIN n pcpath
  -- if pfunction.BODY = pcpath ++ [PCFIELD 5]
  -- if $origin_node(S.SOURCES, pfunction.ORIGIN) = (NPropertyHook (SEQUENCE eps) (INTEGER 0) (BOOLEAN false) (NIdentifier (BYTES text_set) metadata_name) phpType16 (SEQUENCE statement*) metadata)
  -- if $ptlc($base64(text_set)) = $ptascii("set")
  -- if phpType16 =/= SEQUENCE eps /\ $property_set_parameters(phpType16)

def $pphook_compile(P, pcpath, ppropertydesc, NPropertyHook (SEQUENCE eps) (INTEGER 0) (BOOLEAN false) (NIdentifier (BYTES text_set) metadata_name) (SEQUENCE eps) (SEQUENCE statement*) metadata, pchheader) = $pphook_finish_named(P, $ppgoto_finish($ppstatements(P_hook, pcpath ++ [PCFIELD 5], 0, statement*)), pcpath, ptbytes_name, pssignature, metadata)
