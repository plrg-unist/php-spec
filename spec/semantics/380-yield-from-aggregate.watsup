def $yield_from_iterator_warning_caller_claims(S, eps) = eps
def $yield_from_iterator_warning_caller_claims(S, pfibercaller :: pfibercaller_tail*) = $yield_from_iterator_warning_vm_claims(S, pfibercaller.VM) ++ $yield_from_iterator_warning_caller_claims(S, pfibercaller_tail*)
def $yield_from_iterator_warning_closer_claims(S, eps) = eps
def $yield_from_iterator_warning_closer_claims(S, pfiberclose :: pfiberclose_tail*) = $yield_from_iterator_warning_vm_claims(S, pfiberclose.VM) ++ $yield_from_iterator_warning_closer_claims(S, pfiberclose_tail*)
def $generator_from_saved_fiber_claims(S) = $yield_from_iterator_warning_object_claims(S, S.ALLOCATIONS) ++ $yield_from_iterator_warning_caller_claims(S, S.FIBERCALLERS) ++ $yield_from_iterator_warning_closer_claims(S, S.FIBERCLOSERS)
