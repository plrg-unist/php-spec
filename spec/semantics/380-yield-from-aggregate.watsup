def $yield_from_iterator_operation_valid(S, pgeneratorop) = ($yield_from_iterator_operation_tasks(S, pgeneratorop, S.TODO, S.CURRENT) \/ $yield_from_iterator_operation_frames(S, pgeneratorop, S.FRAMES))
