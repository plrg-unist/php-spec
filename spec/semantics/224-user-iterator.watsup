;; PHP 8.5.10 zend_interfaces.stub.php and zend_user_it_* supply these
;; language protocols. Tentative-return notices are a separate pending slice.
dec $useriter_members() : ptbytes*
def $useriter_members() = [$ptascii("current"), $ptascii("next"), $ptascii("key"), $ptascii("valid"), $ptascii("rewind")]
def $useriter_builtin(ptbytes) = ($ptlc(ptbytes) <- [$ptascii("iterator"), $ptascii("traversable")])
dec $useriter_signature(ptbytes) : pssignature
def $useriter_signature(ptbytes) = { PARAMETERS eps, RETURNS ([(PTBRANCH ([PTBUILTIN "mixed"]))]), BYREF false }
  -- if $ptlc(ptbytes) <- [$ptascii("current"), $ptascii("key")]
def $useriter_signature(ptbytes) = { PARAMETERS eps, RETURNS ([(PTBRANCH ([PTBUILTIN "bool"]))]), BYREF false }
  -- if $ptlc(ptbytes) = $ptascii("valid")
def $useriter_signature(ptbytes) = { PARAMETERS eps, RETURNS ([(PTBRANCH ([PTBUILTIN "void"]))]), BYREF false }
  -- if $ptlc(ptbytes) <- [$ptascii("next"), $ptascii("rewind")]
dec $useriter_scope() : pvclass
def $useriter_scope() = { NAME $ptascii("Iterator"), PARENT eps, ANCESTORS ([$ptascii("Traversable")]), FINAL false }

dec $useriter_method_issue(pstate, pclassdesc, pmethoddesc) : pmethodissue
dec $useriter_method_compared(pstate, pclassdesc, pmethoddesc, pmmethod, pmmethod, pmcheck) : pmethodissue
dec $useriter_return_compared(pmethoddesc, pmcheck) : pmethodissue
def $useriter_method_issue(S, pclassdesc, pmethoddesc) = METHOD_FILEISSUE ($ptascii("Cannot make non static method Iterator::") ++ $ptlc(pmethoddesc.NAME) ++ $ptascii("() static in class ") ++ pclassdesc.NAME) pmethoddesc.FUNCTION.LINE pmethoddesc.FUNCTION.ORIGIN
  -- if pmethoddesc.STATIC
def $useriter_method_issue(S, pclassdesc, pmethoddesc) = METHOD_FILEISSUE ($ptascii("Access level to ") ++ pclassdesc.NAME ++ $ptascii("::") ++ pmethoddesc.NAME ++ $ptascii("() must be public (as in class Iterator)")) pmethoddesc.FUNCTION.LINE pmethoddesc.FUNCTION.ORIGIN
  -- if ~pmethoddesc.STATIC
  -- if pmethoddesc.VISIBILITY =/= PROPERTY_PUBLIC
def $useriter_method_issue(S, pclassdesc, pmethoddesc) = $useriter_method_compared(S, pclassdesc, pmethoddesc, pmmethod_selected, pmmethod_proto, $pmcompare(PMUSER pmmethod_selected, $pil_scope(S, pclassdesc), PMUSER pmmethod_proto[.SIGNATURE = pmmethod_proto.SIGNATURE[.RETURNS = eps]], $useriter_scope(), $method_active_registry(S, S.CLASSNAMES)))
  -- if ~pmethoddesc.STATIC
  -- if pmethoddesc.VISIBILITY = PROPERTY_PUBLIC
  -- if pmmethod_selected = $pmethod_user(pmethoddesc, pclassdesc, $call_sourcefile(S.FILES, pmethoddesc.FUNCTION.ORIGIN))
  -- if pmmethod_proto = $pil_signature_method($ptascii("Iterator"), $ptlc(pmethoddesc.NAME), $call_sourcefile(S.FILES, pmethoddesc.FUNCTION.ORIGIN), $useriter_signature(pmethoddesc.NAME))
def $useriter_method_compared(S, pclassdesc, pmethoddesc, pmmethod_selected, pmmethod_proto, PMCHECK PVYES ptbytes*) = $useriter_return_compared(pmethoddesc, $pmcompare(PMUSER pmmethod_selected, $pil_scope(S, pclassdesc), PMUSER pmmethod_proto, $useriter_scope(), $method_active_registry(S, S.CLASSNAMES)))
def $useriter_method_compared(S, pclassdesc, pmethoddesc, pmmethod_selected, pmmethod_proto, PMCHECK PVNO ptbytes*) = $pil_internal_source_result(pmethoddesc[.OWNER = pmethoddesc.FUNCTION.ORIGIN], $pmmismatch(pmmethod_selected, $pil_scope(S, pclassdesc), pmmethod_proto, $useriter_scope(), 14))
def $useriter_method_compared(S, pclassdesc, pmethoddesc, pmmethod_selected, pmmethod_proto, PMCHECK PVUNRESOLVED ptbytes*) = METHOD_UNSUPPORTED "Iterator dependent method declaration"
def $useriter_method_compared(S, pclassdesc, pmethoddesc, pmmethod_selected, pmmethod_proto, PMUNSUPPORTED text) = METHOD_UNSUPPORTED text
def $useriter_return_compared(pmethoddesc, PMCHECK PVYES ptbytes*) = METHOD_OK
def $useriter_return_compared(pmethoddesc, PMCHECK PVNO ptbytes*) = METHOD_UNSUPPORTED "Iterator tentative return declaration"
def $useriter_return_compared(pmethoddesc, PMCHECK PVUNRESOLVED ptbytes*) = METHOD_UNSUPPORTED "Iterator tentative dependent return declaration"
def $useriter_return_compared(pmethoddesc, PMUNSUPPORTED text) = METHOD_UNSUPPORTED text

dec $useriter_methods(pstate, pclassdesc, ptbytes*, ppmethodinherited*) : pmethodissue
def $useriter_methods(S, pclassdesc, eps, ppmethodinherited*) = METHOD_OK
def $useriter_methods(S, pclassdesc, ptbytes :: ptbytes_tail*, ppmethodinherited*) = $useriter_methods(S, pclassdesc, ptbytes_tail*, ppmethodinherited*)
  -- if $pil_selected(S, pclassdesc, ptbytes, ppmethodinherited*) = eps
def $useriter_methods(S, pclassdesc, ptbytes :: ptbytes_tail*, ppmethodinherited*) = $useriter_methods(S, pclassdesc, ptbytes_tail*, ppmethodinherited*)
  -- if $pil_selected(S, pclassdesc, ptbytes, ppmethodinherited*) = (PPMINHERITED pmethoddesc pclassdesc_selected)
  -- if $useriter_method_issue(S, pclassdesc_selected, pmethoddesc) = METHOD_OK
def $useriter_methods(S, pclassdesc, ptbytes :: ptbytes_tail*, ppmethodinherited*) = pmethodissue
  -- if $pil_selected(S, pclassdesc, ptbytes, ppmethodinherited*) = (PPMINHERITED pmethoddesc pclassdesc_selected)
  -- if pmethodissue = $useriter_method_issue(S, pclassdesc_selected, pmethoddesc)
  -- if pmethodissue =/= METHOD_OK
def $useriter_contract(S, pclassdesc) = $useriter_methods(S, pclassdesc, $useriter_members(), $pil_info_extra(S, pclassdesc.ORIGIN, $ppmethod_own(pclassdesc, pclassdesc.METHODS), |S.CLASSES|))
  -- if $class_origin_matches(S, pclassdesc.ORIGIN, $ptascii("Iterator"), |S.CLASSES|)
def $useriter_contract(S, pclassdesc) = METHOD_UNSUPPORTED "concrete Traversable-only class core fatal"
  -- if pclassdesc.KIND = "class"
  -- if ~pclassdesc.ABSTRACT
  -- if ~$class_origin_matches(S, pclassdesc.ORIGIN, $ptascii("Iterator"), |S.CLASSES|)
  -- if $class_origin_matches(S, pclassdesc.ORIGIN, $ptascii("Traversable"), |S.CLASSES|)
def $useriter_contract(S, pclassdesc) = METHOD_OK -- otherwise
def $useriter_after_issue(S, pclassdesc, METHOD_OK) = $useriter_contract(S, pclassdesc)
def $useriter_after_issue(S, pclassdesc, pmethodissue) = pmethodissue -- otherwise
def $useriter_parent_publish(S, S_parent, pclassdesc) = $pil_method_publish(S, S_parent, pclassdesc)
  -- if $class_origin_matches(S_parent, pclassdesc.ORIGIN, $ptascii("Iterator"), |S_parent.CLASSES|) \/ (pclassdesc.INTERFACES = eps /\ $class_origin_matches(S_parent, pclassdesc.ORIGIN, $ptascii("Traversable"), |S_parent.CLASSES|))
def $useriter_parent_publish(S, S_parent, pclassdesc) = S_parent -- otherwise
def $pil_order_one(S, pclassdesc, PILBUILTIN ptbytes, pilref_seen*, ppmethodinherited*) = $useriter_methods(S, pclassdesc, $useriter_members(), ppmethodinherited*)
  -- if $ptlc(ptbytes) = $ptascii("iterator")
def $pil_order_one(S, pclassdesc, PILBUILTIN ptbytes, pilref_seen*, ppmethodinherited*) = METHOD_OK
  -- if $ptlc(ptbytes) = $ptascii("traversable")
def $pil_ref_names(S, (PILBUILTIN ptbytes) :: pilref_tail*, n) = [ptbytes, $ptascii("Traversable")] ++ $pil_ref_names(S, pilref_tail*, n)
  -- if $ptlc(ptbytes) = $ptascii("iterator")
dec $useriter_abstract(pstate, pclassdesc, ptbytes*, pilabstract*) : pilabstract*
def $useriter_abstract(S, pclassdesc, eps, pilabstract*) = pilabstract*
def $useriter_abstract(S, pclassdesc, ptbytes :: ptbytes_tail*, pilabstract*) = $useriter_abstract(S, pclassdesc, ptbytes_tail*, $pil_abs_add(S, pclassdesc, ptbytes, $ptascii("Iterator::") ++ ptbytes, pilabstract*))
def $pil_abs_refs(S, pclassdesc_child, (PILBUILTIN ptbytes) :: pilref_tail*, n, pilabstract*) = $pil_abs_refs(S, pclassdesc_child, pilref_tail*, n, $useriter_abstract(S, pclassdesc_child, $useriter_members(), pilabstract*))
  -- if $ptlc(ptbytes) = $ptascii("iterator")

