dec $useriter_pending(pstate, pcalltarget, porigin) : bool
def $useriter_pending(S, METHOD_TARGET n_object porigin_method, porigin_site) = true
  -- if S.ORIGIN = (porigin_site)
  -- if S.TODO = (CALL_ARGS (METHOD_TARGET n_object porigin_method) eps 0 eps (porigin_site) z) :: (USERITER_RESULT n n_object statement porigin_site z text_stage poperand) :: ptask_tail*
  -- if $useriter_result_valid(S, n, n_object, statement, porigin_site, z, text_stage, poperand)
