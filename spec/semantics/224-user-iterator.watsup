def $useriter_marker(pframe) = true
  -- if pframe.TODO = (USERITER_RESULT n n_object statement porigin_site z text_stage poperand) :: ptask_tail*
def $useriter_marker(pframe) = false -- otherwise
dec $useriter_task_ids(ptask) : nat*
def $useriter_task_ids(USERITER_RESULT n n_object statement porigin_site z text_stage poperand) = [n]
def $useriter_task_ids(USERITER_NEXT n n_object statement porigin_site z poperand) = [n]
def $useriter_task_ids(AT porigin ptask) = $useriter_task_ids(ptask)
def $useriter_task_ids(ptask) = eps -- otherwise
dec $useriter_tasks_ids(ptask*) : nat*
def $useriter_tasks_ids(eps) = eps
def $useriter_tasks_ids(ptask :: ptask_tail*) = $useriter_task_ids(ptask) ++ $useriter_tasks_ids(ptask_tail*)
dec $useriter_frames_ids(pframe*) : nat*
def $useriter_frames_ids(eps) = eps
def $useriter_frames_ids(pframe :: pframe_tail*) = $useriter_tasks_ids(pframe.TODO) ++ $useriter_frames_ids(pframe_tail*)
dec $useriter_ids_unique(nat*) : bool
def $useriter_ids_unique(eps) = true
def $useriter_ids_unique(n :: n_tail*) = (~(n <- n_tail*) /\ $useriter_ids_unique(n_tail*))
dec $useriter_chain_walk(pstate, pcallcontext?, pframe*) : bool
def $useriter_chain_walk(S, eps, eps) = true
def $useriter_chain_walk(S, (pcallcontext), eps) = ~$useriter_context_kind(S, pcallcontext)
def $useriter_chain_walk(S, (pcallcontext), pframe :: pframe_tail*) = ($useriter_frame(S, pcallcontext, pframe) /\ $useriter_chain_walk(S, pframe.CONTEXT, pframe_tail*))
  -- if $useriter_context_kind(S, pcallcontext) \/ $useriter_marker(pframe)
def $useriter_chain_walk(S, (pcallcontext), pframe :: pframe_tail*) = $useriter_chain_walk(S, pframe.CONTEXT, pframe_tail*)
  -- if ~$useriter_context_kind(S, pcallcontext)
  -- if ~$useriter_marker(pframe)
def $useriter_chain_walk(S, eps, pframe :: pframe_tail*) = $useriter_chain_walk(S, pframe.CONTEXT, pframe_tail*)
  -- if ~$useriter_marker(pframe)
def $useriter_chain_walk(S, eps, pframe :: pframe_tail*) = false -- if $useriter_marker(pframe)
def $useriter_chain_valid(S, pcallcontext?, pframe*) = ($useriter_ids_unique($useriter_tasks_ids(S.TODO) ++ $useriter_frames_ids(pframe*)) /\ $useriter_chain_walk(S, pcallcontext?, pframe*))

def $call_line_valid(S, (porigin_site), z) = true
  -- if $origin_node(S.SOURCES, porigin_site) = (statement)
  -- if $useriter_site(S, statement, porigin_site, z)
def $call_arguments_valid(S, (porigin_site), 0, eps, eps, 0) = $useriter_pending_site(S, porigin_site)
  -- if $useriter_pending_site(S, porigin_site)
def $call_arity_valid(S, pcallcontext) = true -- if $useriter_context(S, pcallcontext)
def $call_extent_valid(S, pcallcontext) = true -- if $useriter_context(S, pcallcontext)
def $named_context_valid(S, pcallcontext) = true -- if $useriter_context(S, pcallcontext)
def $call_task_valid(S, USERITER_RESULT n n_object statement porigin_site z text_stage poperand) = $useriter_result_valid(S, n, n_object, statement, porigin_site, z, text_stage, poperand)
dec $useriter_next_valid(pstate, nat, nat, statement, porigin, int, poperand) : bool
def $useriter_next_valid(S, n, n_object, statement, porigin_site, z, poperand) = true
