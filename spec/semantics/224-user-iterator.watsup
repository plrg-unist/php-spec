def $useriter_pending_site(S, porigin_site) = false -- otherwise
dec $useriter_frame(pstate, pcallcontext, pframe) : bool
def $useriter_frame(S, pcallcontext, pframe) = true
  -- if pcallcontext.CALLSITE = (porigin_site)
  -- if $context_target(pcallcontext) = METHOD_TARGET n_object porigin_method
  -- if pframe.ORIGIN = (porigin_site)
  -- if pframe.TODO = (USERITER_RESULT n n_object statement porigin_site z text_stage poperand) :: ptask_tail*
