def $useriter_pending(S, pcalltarget, porigin_site) = false -- otherwise
def $useriter_pending_site(S, porigin_site) = true
  -- if S.TODO = (CALL_ARGS pcalltarget eps 0 eps (porigin_site) z) :: ptask_tail*
