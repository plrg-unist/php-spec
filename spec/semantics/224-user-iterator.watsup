  -- if $context_target(pcallcontext) = METHOD_TARGET n_object porigin_method
  -- if $useriter_instance(S, n_object)
def $useriter_context_kind(S, pcallcontext) = false -- otherwise
def $useriter_context(S, pcallcontext) = true
  -- if $useriter_context_kind(S, pcallcontext)
  -- if pcallcontext.CALLSITE = (porigin_site)
  -- if $useriter_entered(S, S.CURRENT, S.FRAMES, $context_target(pcallcontext), porigin_site)
def $useriter_context(S, pcallcontext) = false -- otherwise
