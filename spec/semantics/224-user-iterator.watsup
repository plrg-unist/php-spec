  -- if $useriter_method_selected(S, n_object, porigin_method, text_stage)
def $useriter_frame(S, pcallcontext, pframe) = false -- otherwise
dec $useriter_entered(pstate, pcallcontext?, pframe*, pcalltarget, porigin) : bool
def $useriter_entered(S, (pcallcontext), pframe :: pframe_tail*, pcalltarget, porigin_site) = $useriter_frame(S, pcallcontext, pframe)
  -- if $context_target(pcallcontext) = pcalltarget
  -- if pcallcontext.CALLSITE = (porigin_site)
def $useriter_entered(S, (pcallcontext), pframe :: pframe_tail*, pcalltarget, porigin_site) = $useriter_entered(S, pframe.CONTEXT, pframe_tail*, pcalltarget, porigin_site)
  -- if ~($context_target(pcallcontext) = pcalltarget /\ pcallcontext.CALLSITE = (porigin_site))
def $useriter_entered(S, eps, pframe :: pframe_tail*, pcalltarget, porigin_site) = $useriter_entered(S, pframe.CONTEXT, pframe_tail*, pcalltarget, porigin_site)
def $useriter_entered(S, pcallcontext?, eps, pcalltarget, porigin_site) = false
def $useriter_selected(S, pcalltarget, porigin_site) = ($useriter_pending(S, pcalltarget, porigin_site) \/ $useriter_entered(S, S.CURRENT, S.FRAMES, pcalltarget, porigin_site))
def $useriter_context_kind(S, pcallcontext) = true
  -- if pcallcontext.CALLSITE = (porigin_site)
