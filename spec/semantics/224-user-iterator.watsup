  -- if $class_origin_matches(S, porigin_class, $ptascii("Iterator"), |S.CLASSES|)
def $useriter_instance(S, n) = false -- otherwise
dec $useriter_site(pstate, statement, porigin, int) : bool
def $useriter_site(S, statement, porigin_site, z) = true
