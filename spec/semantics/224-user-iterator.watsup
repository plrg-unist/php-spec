dec $useriter_key_tasks(pstate, phpType5, pvalue) : ptask*
def $useriter_key_tasks(S, ABSENT, pvalue) = eps
def $useriter_key_tasks(S, expression, pvalue) = [$at_task($origin_child(S.ORIGIN, [PCFIELD 1]), LIST_STORE expression (KNOWN pvalue) false $runtime_line(S, [PCFIELD 1], expression))]
dec $useriter_body(pstate, nat, nat, statement, porigin, int, poperand, pvalue) : pstate
def $useriter_body(S, n, n_object, statement_foreach, porigin_site, z, poperand, pvalue_key) = S_read[.TODO = [$foreach_value_task(S_read, expression_value, KNOWN pvalue, false, z)] ++ $useriter_key_tasks(S_read, phpType5, pvalue_key) ++ $statement_tasks(statement*, $origin_child((porigin_site), [PCFIELD 4]), 0) ++ [(USERITER_NEXT n n_object statement_foreach porigin_site z poperand)] ++ ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = ptask :: ptask_tail*
  -- if statement_foreach = NStmtForeach expression_iterable phpType5 phpType4 expression_value (SEQUENCE statement*) phpType4_else metadata
  -- if S_read = $resolve_at(S[.ORIGIN = (porigin_site)], poperand, z)
  -- if S_read.COMPLETION = NORMAL
  -- if S_read.RESULT = KNOWN pvalue
rule PhpStep/useriter-current-value: S ~> $useriter_body(S, n, n_object, statement, porigin_site, z, S.RESULT, PNULL)
  -- if S.TODO = (USERITER_RESULT n n_object statement porigin_site z "current" poperand) :: ptask_tail*
  -- if statement = NStmtForeach expression_iterable ABSENT phpType4 expression_value phpType23 phpType4_else metadata
rule PhpStep/useriter-key-body: S ~> $useriter_body(S_read, n, n_object, statement, porigin_site, z, poperand, pvalue_key)
  -- if S.TODO = (USERITER_RESULT n n_object statement porigin_site z "key" poperand) :: ptask_tail*
  -- if S_read = $resolve_at(S, S.RESULT, z)
  -- if S_read.COMPLETION = NORMAL
  -- if S_read.RESULT = KNOWN pvalue_key
rule PhpStep/useriter-body-next: S ~> $useriter_call(S, n, n_object, statement, porigin_site, z, "next", KNOWN PNULL, ptask_tail*)
  -- if S.TODO = (USERITER_NEXT n n_object statement porigin_site z poperand) :: ptask_tail*

;; The cached current result owns its actual returned reference/value through
;; key() and the body, and is retired before next(). PHP keys need no coercion.
def $task_nodes(USERITER_RESULT n n_object statement porigin_site z text_stage poperand) = [HOBJECT n_object] ++ $operand_nodes(poperand)
def $task_nodes(USERITER_NEXT n n_object statement porigin_site z poperand) = [HOBJECT n_object] ++ $operand_nodes(poperand)
def $return_discard(S, USERITER_RESULT n n_object statement porigin_site z text_stage poperand) = S[.ITERATORS = $iterator_remove(S.ITERATORS, n)][.ORIGIN = (porigin_site)]
def $return_discard(S, USERITER_NEXT n n_object statement porigin_site z poperand) = S[.ITERATORS = $iterator_remove(S.ITERATORS, n)][.ORIGIN = (porigin_site)]
def $loop_marker(USERITER_NEXT n n_object statement porigin_site z poperand) = true
def $jump_loop(S, porigin_source, 1, n_original, false) = $foreach_finish(S[.ORIGIN = (porigin_site)], n)
  -- if S.TODO = (USERITER_NEXT n n_object statement porigin_site z poperand) :: ptask_tail*
def $jump_loop(S, porigin_source, 1, n_original, true) = S[.ORIGIN = (porigin_site)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (USERITER_NEXT n n_object statement porigin_site z poperand) :: ptask_tail*
def $jump_loop(S, porigin_source, n_depth, n_original, b) = $jump_loop($foreach_finish(S, n), porigin_source, $nabs($(n_depth - 1)), n_original, b)
  -- if S.TODO = (USERITER_NEXT n n_object statement porigin_site z poperand) :: ptask_tail*
  -- if $(n_depth > 1)
def $goto_foreach_task(USERITER_NEXT n n_object statement porigin_site z poperand) = true
def $goto_marker_valid(S, USERITER_NEXT n n_object statement porigin_site z poperand) = $useriter_next_valid(S, n, n_object, statement, porigin_site, z, poperand)
def $goto_drop_iterators(piterator*, (USERITER_NEXT n n_object statement porigin_owner z poperand) :: ptask_tail*, porigin_target) = $goto_drop_iterators(piterator*, ptask_tail*, porigin_target)
  -- if $goto_foreach_keep((porigin_owner), porigin_target)
def $goto_drop_iterators(piterator*, (USERITER_NEXT n n_object statement porigin_owner z poperand) :: ptask_tail*, porigin_target) = $goto_drop_iterators($iterator_remove(piterator*, n), ptask_tail*, porigin_target)
  -- if ~$goto_foreach_keep((porigin_owner), porigin_target)
def $goto_saved((USERITER_NEXT n n_object statement porigin z poperand) :: ptask_tail*, porigin) = GOTOTASKS ((USERITER_NEXT n n_object statement porigin z poperand) :: ptask_tail*)
def $goto_saved_match(USERITER_NEXT n n_object statement porigin_marker z poperand, porigin) = (porigin_marker = porigin)
def $goto_marker_origin(USERITER_NEXT n n_object statement porigin_site z poperand) = (porigin_site)

def $error_task_iterator(USERITER_RESULT n n_object statement porigin_site z text_stage poperand) = [n]
def $error_task_iterator(USERITER_NEXT n n_object statement porigin_site z poperand) = [n]

def $useriter_source_contract(S, pclassdesc, porigin) = $useriter_contract(S, pclassdesc)
  -- if $pil_nominal(S, porigin, $ptascii("Iterator"), |S.CLASSES|)
def $useriter_source_contract(S, pclassdesc, porigin) = METHOD_OK -- otherwise
def $useriter_source_after(S, pclassdesc, porigin, METHOD_OK) = $useriter_source_contract(S, pclassdesc, porigin)
def $useriter_source_after(S, pclassdesc, porigin, pmethodissue) = pmethodissue -- otherwise
