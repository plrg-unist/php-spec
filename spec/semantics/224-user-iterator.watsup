def $useriter_next_valid(S, n, n_object, statement, porigin_site, z, poperand) = false -- otherwise
def $call_task_valid(S, USERITER_NEXT n n_object statement porigin_site z poperand) = $useriter_next_valid(S, n, n_object, statement, porigin_site, z, poperand)

dec $useriter_call(pstate, nat, nat, statement, porigin, int, text, poperand, ptask*) : pstate
def $useriter_call(S, n, n_object, statement, porigin_site, z, text_stage, poperand, ptask_tail*) = S[.ORIGIN = (porigin_site)][.TODO = (CALL_ARGS (METHOD_TARGET n_object pmethoddesc.FUNCTION.ORIGIN) eps 0 eps (porigin_site) z) :: (USERITER_RESULT n n_object statement porigin_site z text_stage poperand) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.OBJECTS[n_object] = INSTANCE porigin_class
  -- if $effective_method(S, porigin_class, $ptascii(text_stage), |S.CLASSES|) = (pmethoddesc)
def $foreach_start(S, statement, plocation, false, z) = $useriter_call(S[.ITERATORS = S.ITERATORS ++ [OBJECTITER n n_object 0 false]][.NEXTITER = $(n + 1)], n, n_object, statement, porigin_site, z, "rewind", KNOWN PNULL, ptask_tail*)
  -- if S.TODO = ptask :: ptask_tail*
  -- if S.ORIGIN = (porigin_site)
  -- if S.RESULT = KNOWN (POBJECT n_object)
  -- if $useriter_instance(S, n_object)
  -- if n = S.NEXTITER
def $foreach_start(S, statement, plocation, true, z) = $throw_scalar(S, "Error", $ptascii("An iterator cannot be used with foreach by reference"), z)
  -- if S.RESULT = KNOWN (POBJECT n_object)
  -- if $useriter_instance(S, n_object)

rule PhpStep/useriter-rewind-next: S ~> $useriter_call(S, n, n_object, statement, porigin_site, z, "valid", KNOWN PNULL, ptask_tail*)
