def $useriter_site(S, statement, porigin_site, z) = false -- otherwise
dec $useriter_has_key(statement) : bool
def $useriter_has_key(NStmtForeach expression_iterable ABSENT phpType4 expression_value phpType23 phpType4_else metadata) = false
def $useriter_has_key(NStmtForeach expression_iterable expression_key phpType4 expression_value phpType23 phpType4_else metadata) = true
def $useriter_has_key(statement) = false -- otherwise
dec $useriter_result_valid(pstate, nat, nat, statement, porigin, int, text, poperand) : bool
dec $useriter_cursor_id(piterator) : nat
def $useriter_cursor_id(ITERATOR n n_array b pcursor*) = n
def $useriter_cursor_id(OBJECTITER n n_object n_position b) = n
dec $useriter_cursor_count(piterator*, nat) : nat
def $useriter_cursor_count(eps, n) = 0
def $useriter_cursor_count(piterator :: piterator_tail*, n) = $(1 + $useriter_cursor_count(piterator_tail*, n))
  -- if $useriter_cursor_id(piterator) = n
def $useriter_cursor_count(piterator :: piterator_tail*, n) = $useriter_cursor_count(piterator_tail*, n)
  -- if $useriter_cursor_id(piterator) =/= n
dec $useriter_cursor_valid(pstate, nat, nat) : bool
def $useriter_cursor_valid(S, n, n_object) = true
  -- if $(n < S.NEXTITER)
  -- if $useriter_cursor_count(S.ITERATORS, n) = 1
  -- if $iterator_lookup(S.ITERATORS, n) = (OBJECTITER n n_object 0 false)
def $useriter_cursor_valid(S, n, n_object) = false -- otherwise
def $useriter_result_valid(S, n, n_object, statement, porigin_site, z, text_stage, poperand) = true
