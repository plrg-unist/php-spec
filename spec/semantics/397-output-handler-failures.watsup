def $output_string_certificate(S, pobstringrelease) = true
  -- if S_history = S[.CURRENT = pobstringrelease.CONTEXT][.ORIGIN = ($output_caller_site(pobstringrelease.CALLER))][.ALLOCATIONS = S.ALLOCATIONS ++ [HOBJECT pobstringrelease.OBJECT]]
  -- if $output_source_valid(S_history, pobstringrelease.CALLER)
  -- if $output_string_owned(S_history, pobstringrelease.CALLER, pobstringrelease.OBJECT)
def $output_string_certificate(S, pobstringrelease) = false -- otherwise
def $output_string_release_valid(S, pobstringrelease) = ($output_string_certificate(S, pobstringrelease) /\ (HOBJECT pobstringrelease.OBJECT) <- S.ALLOCATIONS /\ S.CURRENT = pobstringrelease.CONTEXT /\ S.ORIGIN = ($output_caller_site(pobstringrelease.CALLER)) /\ $source_operand_suffix(S.TODO, OUTPUT_STRING_RELEASE pobstringrelease, pobstringrelease.TAIL))
def $task_nodes(OUTPUT_STRING_RELEASE pobstringrelease) = [HOBJECT pobstringrelease.OBJECT]
def $call_task_valid(S, OUTPUT_STRING_RELEASE pobstringrelease) = $output_string_release_valid(S, pobstringrelease)
rule PhpStep/output-string-release: S ~> S[.TODO = ptask_tail*]
  -- if S.TODO = (OUTPUT_STRING_RELEASE pobstringrelease) :: ptask_tail*
  -- if $call_task_valid(S, OUTPUT_STRING_RELEASE pobstringrelease)
def $eager_operation_source(S, THROW_SEARCH n) = OUTPUT_STRING_RELEASE pobstringrelease
  -- if S.TODO = (THROW_SEARCH n) :: (OUTPUT_STRING_RELEASE pobstringrelease) :: ptask_tail*
  -- if $call_task_valid(S, OUTPUT_STRING_RELEASE pobstringrelease)
def $output_string_exit_frames(eps, pdestructionoperation, pobstringrelease) = false
def $output_string_exit_frames(pframe :: pframe_tail*, pdestructionoperation, pobstringrelease) = ((pframe.CONTEXT = pobstringrelease.CONTEXT /\ pframe.ORIGIN = ($output_caller_site(pobstringrelease.CALLER)) /\ $source_operand_suffix(pframe.TODO, DESTRUCTOR_OPERATION_EXIT pdestructionoperation, pobstringrelease.TAIL)) \/ $output_string_exit_frames(pframe_tail*, pdestructionoperation, pobstringrelease))
def $output_string_exit(S, pdestructionoperation, pobstringrelease) = ((S.CURRENT = pobstringrelease.CONTEXT /\ S.ORIGIN = ($output_caller_site(pobstringrelease.CALLER)) /\ $source_operand_suffix(S.TODO, DESTRUCTOR_OPERATION_EXIT pdestructionoperation, pobstringrelease.TAIL)) \/ $output_string_exit_frames(S.FRAMES, pdestructionoperation, pobstringrelease))
def $eager_operation_source_guard(S, pdestructionoperation) = ($output_string_certificate(S, pobstringrelease) /\ $output_string_exit(S, pdestructionoperation, pobstringrelease) /\ pdestructionoperation.CALLER = pobstringrelease.CONTEXT /\ pdestructionoperation.ORIGIN = ($output_caller_site(pobstringrelease.CALLER)) /\ pdestructionoperation.COMPLETION = NORMAL)
  -- if pdestructionoperation.SOURCE = OUTPUT_STRING_RELEASE pobstringrelease
