  -- if pobstringrelease = {OBJECT n, CALLER pobcaller, CONTEXT S.CURRENT, TAIL ptask_tail*}
def $stringify_return_state(S, ptask, pvalue_text, ptask_tail*) = S[.COMPLETION = UNSUPPORTED "owned Stringable output operand outside direct named construction"]
  -- if S.TODO = (STRINGIFY_RESULT n porigin z) :: ptask :: ptask_tail*
  -- if $output_string_caller(porigin, z, ptask) = (pobcaller)
