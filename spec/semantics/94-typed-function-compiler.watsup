;; Builtin scalar/container signatures reuse16/17 normalization and90 defaults.
;; Object protocols, return references and variadics require their later consumers.
dec $ppreturn_issue(ptbranch*, bool, pvalue?) : text?
dec $ppreturn_null(pvalue?) : bool
dec $ppreturn_bare(ptbranch*) : bool
dec $ppreturn_finish(ppstate, pcpath, text?) : ppstate

def $ppsupported_types(eps) = true
def $ppsupported_types((PTBRANCH ([(PTBUILTIN text)])) :: ptbranch*) = (text <- ["null", "true", "false", "bool", "int", "float", "string", "array", "mixed", "void", "never"] /\ $ppsupported_types(ptbranch*))
def $ppsupported_types(ptbranch*) = false -- otherwise

;; Compile the expression first, then preserve Zend's emitted return/check line.
def $ppreturn_compile(P, pcpath, b) = P
  -- if P.COMPLETION =/= PPCNORMAL
def $ppreturn_compile(P, pcpath, b) = $ppreturn_finish(P, pcpath, $ppreturn_issue(P.RETURNS, b, P.FOLD.VALUE))
  -- if P.COMPLETION = PPCNORMAL
def $ppreturn_finish(P, pcpath, eps) = P[.EXPRESSIONS = P.EXPRESSIONS ++ [PPCEXPR pcpath P.LOCATION.LINE eps]]
def $ppreturn_finish(P, pcpath, (text)) = $ppconstant_error(P, $ptascii(text), P.LOCATION.LINE)

def $ppreturn_null((pvalue)) = (pvalue = PNULL)
def $ppreturn_null(eps) = false

def $ppreturn_issue(ptbranch*, true, pvalue?) = ("A void function must not return a value (did you mean \"return;\" instead of \"return null;\"?)")
  -- if "void" <- $ptmasks(ptbranch*)
  -- if $ppreturn_null(pvalue?)
def $ppreturn_issue(ptbranch*, true, pvalue?) = ("A void function must not return a value")
  -- if "void" <- $ptmasks(ptbranch*)
  -- if ~$ppreturn_null(pvalue?)
def $ppreturn_issue(ptbranch*, b, pvalue?) = ("A never-returning function must not return")
  -- if "never" <- $ptmasks(ptbranch*)
def $ppreturn_issue(ptbranch*, false, pvalue?) = ("A function with return type must return a value (did you mean \"return null;\" instead of \"return;\"?)")
  -- if $ppreturn_bare(ptbranch*)
  -- if "null" <- $ptmasks(ptbranch*) \/ "mixed" <- $ptmasks(ptbranch*)
def $ppreturn_issue(ptbranch*, false, pvalue?) = ("A function with return type must return a value")
  -- if $ppreturn_bare(ptbranch*)
  -- if ~("null" <- $ptmasks(ptbranch*) \/ "mixed" <- $ptmasks(ptbranch*))
def $ppreturn_issue(ptbranch*, b, pvalue?) = eps -- otherwise

def $ppreturn_bare(ptbranch*) = (ptbranch* =/= eps /\ ~("void" <- $ptmasks(ptbranch*) \/ "never" <- $ptmasks(ptbranch*)))
