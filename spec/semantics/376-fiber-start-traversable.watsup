;; SEND_UNPACK uses native Generator hooks or real Iterator callbacks. Its
;; operand and iterator data are distinct owners; completed history owns neither.
dec $fiber_traversal_object(pstate, nat, bool) : bool
dec $fiber_traversal_input(pstate, pfibertraversal) : bool
dec $fiber_traversal_operand(expression, nat, poperand) : poperand
dec $fiber_traversal_history(pstate, porigin, ptraversablepack) : bool
dec $fiber_traversal_valid(pstate, pfibertraversal) : bool
dec $fiber_traversal_stage(pstate, pfibertraversal, text) : bool
dec $fiber_traversal_call_count(ptask*, porigin) : nat
dec $fiber_traversal_call_at(ptask, porigin) : bool
dec $fiber_traversal_result_valid(pstate, pfibertraversal, text) : bool
dec $fiber_traversal_pending(pstate, pcalltarget, porigin) : bool
dec $fiber_traversal_frame(pstate, pcallcontext, pframe, pframe*) : bool
dec $fiber_traversal_entered(pstate, pcallcontext?, pframe*, pcalltarget, porigin) : bool
dec $fiber_traversal_line(pstate, pcallcontext?, pframe*, porigin, int) : bool
dec $fiber_traversal_frame_line(pstate, pcallcontext?, pframe, pframe*, porigin, int) : bool
dec $fiber_traversal_source_line(pstate, porigin, int) : bool
dec $fiber_traversal_pending_line(pstate, porigin, int) : bool
dec $fiber_traversal_call(pstate, pfibertraversal, text, ptask*) : pstate
dec $fiber_traversal_generator_header(pgeneratorop, pfibertraversal, text) : bool
dec $fiber_traversal_generator_tasks(pstate, pgeneratorop, ptask*) : bool
dec $fiber_traversal_generator_frames(pstate, pgeneratorop, pframe*) : bool
dec $fiber_traversal_generator_valid(pstate, pgeneratorop) : bool
dec $fiber_traversal_generator_marker_valid(pstate, pfibertraversal, text) : bool
dec $fiber_traversal_promote(ptask*) : ptask*
dec $fiber_traversal_generator_task(ptask) : bool
dec $fiber_traversal_generator(pstate, pfibertraversal, text, ptask*) : pstate
dec $fiber_traversal_begin(pstate, nat?, pfiberstart, nat, poperand, porigin, int, ptask*) : pstate
dec $fiber_traversal_finish(pstate, pfibertraversal, ptask*) : pstate
dec $fiber_traversal_key(pvalue) : pkey?
dec $fiber_traversal_key_valid(pfibertraversal, pvalue) : bool
dec $fiber_traversal_send(pstate, pfibertraversal, pvalue, pvalue, ptask*) : pstate
