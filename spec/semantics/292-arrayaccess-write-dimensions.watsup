  -- if $location_slot(S, S.LOCATION) = DEFINED pvalue
  -- if ~$access_instance(S, pvalue)
def $access_terminal_pending(S) = false -- otherwise
def $access_terminal_value(S, pkeywriter, poperand, z) = $assign_dimension(S, (poperand), pkeywriter.RHS, z, $key_write_line(pkeywriter.TASK))
  -- if pkeywriter.TASK = ASSIGN_ARRAY pbase z_write b
def $access_terminal_value(S, pkeywriter, poperand, z) = $compound_operands($compound_dimension(S, (poperand), z), pbin, pkeywriter.RHS, z)
  -- if pkeywriter.TASK = COMPOUND_APPLY pbin pbase b z_write
def $access_terminal_value(S, pkeywriter, poperand, z) = S_place
  -- if pkeywriter.TASK = UPDATE_PREP pupdate b z_update
  -- if S_place = $rw_dimension(S, (poperand), STRINGINCDEC, z)
  -- if S_place.COMPLETION =/= NORMAL
def $access_terminal_value(S, pkeywriter, poperand, z) = $update_location(S_place, pupdate, b, z_update)
  -- if pkeywriter.TASK = UPDATE_PREP pupdate b z_update
  -- if S_place = $rw_dimension(S, (poperand), STRINGINCDEC, z)
  -- if S_place.COMPLETION = NORMAL
def $access_terminal_value(S, pkeywriter, poperand, z) = $dimension_location(S, (poperand), STRINGREFERENCE, z)
  -- if $key_write_reference_task(pkeywriter.TASK) \/ $reference_write_task(pkeywriter.TASK) \/ $key_write_named_task(pkeywriter.TASK)
rule PhpStep/access-terminal-dimension: S ~> S_out[.TODO = $access_write_end(ptask_tail*)][.ORIGIN = (pkeywriter.SITE)][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (KEY_WRITE_DIM poperand z b) :: ptask_tail*
