def $access_release_selected(S, ELEMENT n pkey, porigin) = $access_extract(S_cut, pitem, porigin)
  -- if $entry_lookup(S.ARRAYS[n].ITEMS, pkey) = (pitem)
  -- if S_cut = S[.TODO = $access_cut_tasks(S.TODO, porigin, BASE_PLACE porigin (ELEMENT n pkey))]
  -- if $heap_owners($heap_prune($heap_graph(S_cut)), HARRAY n) = 0
def $access_release_selected(S, NOWHERE, porigin) = $access_extract(S, DIRECT PNULL, porigin)
def $access_release_selected(S, plocation, porigin) = S -- otherwise
def $access_extract(S, ALIAS n, porigin) = S[.TODO = $access_cut_tasks(S.TODO, porigin, BASE_RETURNED porigin n)][.LOCATION = ROOT n]
def $access_extract(S, DIRECT pvalue, porigin) = S[.TODO = $access_cut_tasks(S.TODO, porigin, BASE_RETURNED porigin n)][.STORE = S.STORE ++ [DEFINED pvalue]][.ALLOCATIONS = S.ALLOCATIONS ++ [HCELL n]][.LOCATION = ROOT n]
  -- if n = |S.STORE|
def $access_extract(S, UNINITIALIZED, porigin) = S[.TODO = $access_cut_tasks(S.TODO, porigin, BASE_RETURNED porigin n)][.STORE = S.STORE ++ [UNDEFINED]][.ALLOCATIONS = S.ALLOCATIONS ++ [HCELL n]][.LOCATION = ROOT n]
  -- if n = |S.STORE|

;; ASSIGN_REF's target must be INDIRECT. Its source demand still occurs before
;; the native invalid-target Error, unlike acquisition of a detached reference.
def $access_reference_temporary(S, pkeywriter) = true
  -- if $reference_write_task(pkeywriter.TASK)
  -- if pkeywriter.BASE = BASE_RETURNED pkeywriter.TARGET n
  -- if S.LOCATION = ROOT n
def $access_reference_temporary(S, pkeywriter) = false -- otherwise
rule PhpStep/access-reference-temporary: S ~> S[.LOCATION = NOWHERE]
  -- if S.TODO = (KEY_WRITE_FINISH pkeywriter) :: ptask_tail*
  -- if S.ORIGIN = (pkeywriter.SITE)
  -- if $key_writer_valid(S, pkeywriter, ptask_tail*)
  -- if $access_reference_temporary(S, pkeywriter)

;; A final string/scalar consumer keeps its own existing error kind. Earlier
;; FETCHes continue to use the nested kind; string warning producers stay open.
def $access_terminal_pending(S) = true
  -- if S.TODO = (KEY_WRITE_DIM poperand z b) :: ptask_tail*
  -- if $access_write_final(ptask_tail*)
