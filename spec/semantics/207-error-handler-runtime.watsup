  -- if $reference_notice_producer_target(S, porigin_argument) = (pfunction_producer)
  -- if $origin_node(S.SOURCES, pfunction_producer.ORIGIN) = (NStmtFunction (SEQUENCE eps) (BOOLEAN false) phpType11_producer phpType16_producer phpType18_producer phpType23_producer metadata_producer)
