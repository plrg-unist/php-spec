  -- if psparam.BYREF /\ psparam.TYPE = eps
def $positional_reference_notice_source(S, pcalltarget, n, porigin?) = false -- otherwise

def $positional_reference_notice_pending(S) = true
  -- if S.TODO = (CALL_SEND pcalltarget phpType7* n poperand* porigin? z) :: ptask_tail*
