rule PhpStep/positional-reference-send-notice: S ~> $error_dispatch(S_reference[.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], 8, $ptascii("Only variables should be passed by reference"), z_notice, DIAGNOSTIC "Notice" $ptascii("Only variables should be passed by reference") z_notice, ptask_resume)
