;; Positional source SENDs use the same private reference, owned by the
;; actual next CALL_ARGS vector rather than a separate diagnostic snapshot.
def $positional_reference_notice_operands(S, eps) = true
def $positional_reference_notice_operands(S, poperand :: poperand_tail*) = ($named_reference_notice_operand(S, poperand) /\ $positional_reference_notice_operands(S, poperand_tail*))
def $positional_reference_notice_source(S, porigin_function, n, (porigin)) = true
  -- if S.ORIGIN = (porigin)
  -- if $function_at(S.FUNCTIONS, porigin_function) = (pfunction)
  -- if $origin_node(S.SOURCES, porigin_function) = (NStmtFunction (SEQUENCE eps) (BOOLEAN b) phpType11 phpType16 phpType18 phpType23 metadata)
