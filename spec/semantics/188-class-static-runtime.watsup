def $class_static_attach_source(S, ppropertyid, n_cell) = S -- otherwise

dec $class_static_detach_source(pstate, ppropertyid) : pstate
def $class_static_detach_source(S, ppropertyid) = S[.PROPREFS = $propref_detach(S.PROPREFS, n_old, CLASS_PROP_SOURCE ppropertyid)]
  -- if $class_static_at(S.CLASSSTATICS, ppropertyid) = (pclassstatic)
  -- if pclassstatic.STATE = PROP_VALUE (ALIAS n_old)
  -- if $propref_source_present(S.PROPREFS, n_old, CLASS_PROP_SOURCE ppropertyid)
def $class_static_detach_source(S, ppropertyid) = S -- otherwise

dec $class_static_reference_fetch_ordinary(pstate, ppropertyid, int) : pstate
def $class_static_reference_fetch_ordinary(S, ppropertyid, z) = $reference_cell(S, n_cell)[.CELL = n_cell][.RESULT = REFERENCE n_cell]
  -- if $class_static_at(S.CLASSSTATICS, ppropertyid) = (pclassstatic)
  -- if pclassstatic.STATE = PROP_VALUE (ALIAS n_cell)
def $class_static_reference_fetch_ordinary(S, ppropertyid, z) = S_attached[.CLASSSTATICS = $class_static_set(S_attached.CLASSSTATICS, ppropertyid, PROP_VALUE (ALIAS n_cell))][.CELL = n_cell][.RESULT = REFERENCE n_cell]
  -- if $class_static_at(S.CLASSSTATICS, ppropertyid) = (pclassstatic)
  -- if pclassstatic.STATE = PROP_VALUE (DIRECT pvalue)
  -- if n_cell = |S.STORE|
  -- if S_attached = $class_static_attach_source($reference_cell(S[.STORE = S.STORE ++ [DEFINED pvalue]][.ALLOCATIONS = S.ALLOCATIONS ++ [HCELL n_cell]], n_cell), ppropertyid, n_cell)
def $class_static_reference_fetch_ordinary(S, ppropertyid, z) = $throw_scalar(S, "Error", $ptascii("Cannot access uninitialized non-nullable property ") ++ $property_declaring_name(S.CLASSES, ppropertydesc.ORIGIN) ++ $ptascii("::$") ++ ppropertydesc.NAME ++ $ptascii(" by reference"), z)
  -- if $class_static_at(S.CLASSSTATICS, ppropertyid) = (pclassstatic)
  -- if pclassstatic.STATE = PROP_INITIAL
  -- if $class_static_active_desc(S, S.CLASSNAMES, ppropertyid) = (ppropertydesc)
  -- if $typed_conversion_at(S, ppropertydesc.TYPE, PNULL, false) = TYPEREJECT
def $class_static_reference_fetch_ordinary(S, ppropertyid, z) = $class_static_reference_fetch_ordinary(S[.CLASSSTATICS = $class_static_set(S.CLASSSTATICS, ppropertyid, PROP_VALUE (DIRECT PNULL))], ppropertyid, z)
  -- if $class_static_at(S.CLASSSTATICS, ppropertyid) = (pclassstatic)
  -- if pclassstatic.STATE = PROP_INITIAL
