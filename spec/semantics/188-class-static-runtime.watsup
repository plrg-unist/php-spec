def $assign_class_static_reference(S, ppropertyid, n_cell, z) = S_attached[.CLASSSTATICS = $class_static_set(S_attached.CLASSSTATICS, ppropertyid, PROP_VALUE (ALIAS n_cell))][.RESULT = REFERENCE n_cell]
