;; zend_compile_static_prop evaluates the class reference before a computed
;; property name. A literal $name is a declaration name, not a CV read.
dec $class_static_computed_name(phpType31) : bool
dec $trait_static_property_deprecation_needed(pstate, porigin, ptbytes) : bool
def $class_static_computed_name(NVarLikeIdentifier phpType33 metadata) = false
def $class_static_computed_name(phpType31) = true -- otherwise
def $ppdispatch(P, pcpath, NExprStaticPropertyFetch phpType19 phpType31 metadata, ppmode) = $ppconstant_error(P, $ptascii("Cannot use \"parent\" when current class scope has no parent"), P.LOCATION.LINE)
  -- if $ppscoped_parent_missing(P, phpType19)
def $ppdispatch(P, pcpath, NExprStaticPropertyFetch phpType19 (NVarLikeIdentifier (BYTES text) metadata_name) metadata, ppmode) = $pplocate($ppclearvalue($ppscoped_class(P, pcpath, phpType19)), pcpath, $source_line(metadata_name))
  -- if ~$ppscoped_parent_missing(P, phpType19)
def $ppdispatch(P, pcpath, NExprStaticPropertyFetch phpType19 expression_name metadata, ppmode) = $ppclearvalue($ppexpr($ppscoped_class(P, pcpath, phpType19), pcpath ++ [PCFIELD 1], expression_name, PPR))
  -- if ~$ppscoped_parent_missing(P, phpType19)
  -- if $class_static_computed_name(expression_name)

dec $ppstatic_refetch_class(ppstate, pcpath, phpType19) : ppstate
def $ppstatic_refetch_class(P, pcpath, phpType19) = P -- if $ppscoped_named(phpType19)
def $ppstatic_refetch_class(P, pcpath, expression_class) = $ppmemo(P, pcpath ++ [PCFIELD 0], expression_class)
  -- if ~$ppscoped_named(expression_class)
def $pprefetchbody(P, pcpath, NExprStaticPropertyFetch phpType19 (NVarLikeIdentifier (BYTES text) metadata_name) metadata) = $pplocate($ppclearvalue($ppstatic_refetch_class(P, pcpath, phpType19)), pcpath, $source_line(metadata_name))
def $pprefetchbody(P, pcpath, NExprStaticPropertyFetch phpType19 expression_name metadata) = $ppclearvalue($ppmemo($ppstatic_refetch_class(P, pcpath, phpType19), pcpath ++ [PCFIELD 1], expression_name))
  -- if $class_static_computed_name(expression_name)

dec $class_static_info(pstate, porigin, ptbytes) : ppropertydesc?
def $class_static_info(S, porigin_requested, ptbytes) = $ppproperty_desc_at($property_info_layout(S, porigin_requested, |S.CLASSES|), ptbytes)
def $class_static_select(S, porigin_requested, ptbytes) = (ppropertydesc)
  -- if $class_static_info(S, porigin_requested, ptbytes) = (ppropertydesc)
  -- if ppropertydesc.STATIC
def $class_static_select(S, porigin_requested, ptbytes) = eps -- otherwise

def $class_static_accessible(S, ppropertydesc) = true
  -- if ppropertydesc.VISIBILITY = PROPERTY_PUBLIC
def $class_static_accessible(S, ppropertydesc) = true
  -- if ppropertydesc.VISIBILITY = PROPERTY_PRIVATE
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.LEXICAL_CLASS = $property_declaring_class(S.CLASSES, ppropertydesc.ORIGIN)
def $class_static_accessible(S, ppropertydesc) = true
  -- if ppropertydesc.VISIBILITY = PROPERTY_PROTECTED
  -- if $property_protected_allowed(S, ppropertydesc)
def $class_static_accessible(S, ppropertydesc) = false -- otherwise

;; Zend checks access before rejecting an instance declaration reached through
;; static syntax. Quiet lookup still treats either denial as an absent value.
dec $class_static_undeclared(pstate, porigin, ptbytes) : bool
def $class_static_undeclared(S, porigin_requested, ptbytes) = true
  -- if $class_static_info(S, porigin_requested, ptbytes) = eps
def $class_static_undeclared(S, porigin_requested, ptbytes) = true
  -- if $class_static_info(S, porigin_requested, ptbytes) = (ppropertydesc)
  -- if $class_static_accessible(S, ppropertydesc)
  -- if ~ppropertydesc.STATIC
def $class_static_undeclared(S, porigin_requested, ptbytes) = false -- otherwise

dec $class_static_read(pstate, porigin, ptbytes, int) : pstate
def $class_static_read(S, porigin_requested, ptbytes, z) = $throw_scalar(S, "Error", $ptascii("Access to undeclared static property ") ++ pclassdesc.NAME ++ $ptascii("::$") ++ $c_string(ptbytes), z)
  -- if $class_at(S.CLASSES, porigin_requested) = (pclassdesc)
  -- if $class_static_undeclared(S, porigin_requested, ptbytes)
def $class_static_read(S, porigin_requested, ptbytes, z) = $throw_scalar(S, "Error", $ptascii("Cannot access ") ++ $property_visibility_name(ppropertydesc.VISIBILITY) ++ $ptascii(" property ") ++ pclassdesc.NAME ++ $ptascii("::$") ++ ppropertydesc.NAME, z)
  -- if $class_at(S.CLASSES, porigin_requested) = (pclassdesc)
  -- if $class_static_info(S, porigin_requested, ptbytes) = (ppropertydesc)
  -- if ~$class_static_accessible(S, ppropertydesc)
def $class_static_read(S, porigin_requested, ptbytes, z) = $throw_scalar(S, "Error", $ptascii("Typed static property ") ++ $property_declaring_name(S.CLASSES, ppropertydesc.ORIGIN) ++ $ptascii("::$") ++ ppropertydesc.NAME ++ $ptascii(" must not be accessed before initialization"), z)
  -- if $class_static_select(S, porigin_requested, ptbytes) = (ppropertydesc)
  -- if $class_static_accessible(S, ppropertydesc)
  -- if $class_static_at(S.CLASSSTATICS, ppropertydesc.ORIGIN) = (pclassstatic)
  -- if pclassstatic.STATE = PROP_INITIAL
def $class_static_read(S, porigin_requested, ptbytes, z) = S[.RESULT = KNOWN $entry_value(S, pitem)]
  -- if $class_static_select(S, porigin_requested, ptbytes) = (ppropertydesc)
  -- if $class_static_accessible(S, ppropertydesc)
  -- if $class_static_at(S.CLASSSTATICS, ppropertydesc.ORIGIN) = (pclassstatic)
  -- if pclassstatic.STATE = PROP_VALUE pitem
def $class_static_read(S, porigin_requested, ptbytes, z) = S[.COMPLETION = UNSUPPORTED "class static storage integrity"] -- otherwise
def $base_read(S, BASE_CLASS_STATIC porigin_requested ptbytes, z) = $class_static_read(S, porigin_requested, ptbytes, z)

dec $class_static_set(pclassstatic*, ppropertyid, ppropstate) : pclassstatic*
def $class_static_set(eps, ppropertyid, ppropstate) = eps
def $class_static_set(pclassstatic :: pclassstatic_tail*, ppropertyid, ppropstate) = pclassstatic[.STATE = ppropstate] :: pclassstatic_tail*
  -- if pclassstatic.DECL = ppropertyid
def $class_static_set(pclassstatic :: pclassstatic_tail*, ppropertyid, ppropstate) = pclassstatic :: $class_static_set(pclassstatic_tail*, ppropertyid, ppropstate)
  -- if pclassstatic.DECL =/= ppropertyid

dec $class_static_store_ordinary(pstate, porigin, ptbytes, pvalue, int) : pstate
def $class_static_store_ordinary(S, porigin_requested, ptbytes, pvalue, z) = $throw_scalar(S, "Error", $ptascii("Access to undeclared static property ") ++ pclassdesc.NAME ++ $ptascii("::$") ++ $c_string(ptbytes), z)
  -- if $class_at(S.CLASSES, porigin_requested) = (pclassdesc)
  -- if $class_static_undeclared(S, porigin_requested, ptbytes)
def $class_static_store_ordinary(S, porigin_requested, ptbytes, pvalue, z) = $throw_scalar(S, "Error", $ptascii("Cannot access ") ++ $property_visibility_name(ppropertydesc.VISIBILITY) ++ $ptascii(" property ") ++ pclassdesc.NAME ++ $ptascii("::$") ++ ppropertydesc.NAME, z)
  -- if $class_at(S.CLASSES, porigin_requested) = (pclassdesc)
  -- if $class_static_info(S, porigin_requested, ptbytes) = (ppropertydesc)
  -- if ~$class_static_accessible(S, ppropertydesc)
;; Typed property syntax verifies its declaration before assigning a live alias.
def $class_static_store_ordinary(S, porigin_requested, ptbytes, pvalue, z) = $write_cell_checked(S, n_cell, pvalue, z)
  -- if $class_static_select(S, porigin_requested, ptbytes) = (ppropertydesc)
  -- if $class_static_accessible(S, ppropertydesc)
  -- if $class_static_at(S.CLASSSTATICS, ppropertydesc.ORIGIN) = (pclassstatic)
  -- if pclassstatic.STATE = PROP_VALUE (ALIAS n_cell)
  -- if ppropertydesc.TYPE = eps
def $class_static_store_ordinary(S, porigin_requested, ptbytes, pvalue, z) = S[.CLASSSTATICS = $class_static_set(S.CLASSSTATICS, ppropertydesc.ORIGIN, PROP_VALUE (DIRECT pvalue))][.RESULT = KNOWN pvalue]
  -- if $class_static_select(S, porigin_requested, ptbytes) = (ppropertydesc)
  -- if $class_static_accessible(S, ppropertydesc)
  -- if $class_static_at(S.CLASSSTATICS, ppropertydesc.ORIGIN) = (pclassstatic)
  -- if ~$property_alias(pclassstatic.STATE)
  -- if ppropertydesc.TYPE = eps
def $class_static_store_ordinary(S, porigin_requested, ptbytes, pvalue, z) = $write_cell_checked(S_converted, n_cell, pvalue_new, z)
  -- if $class_static_select(S, porigin_requested, ptbytes) = (ppropertydesc)
  -- if $class_static_accessible(S, ppropertydesc)
  -- if $class_static_at(S.CLASSSTATICS, ppropertydesc.ORIGIN) = (pclassstatic)
  -- if ppropertydesc.TYPE =/= eps
  -- if ptypeconversion = $typed_conversion_at(S, ppropertydesc.TYPE, pvalue, $property_strict(S))
  -- if ptypeconversion =/= TYPEREJECT
  -- if S_converted = $typed_apply(S, ptypeconversion, z)
  -- if S_converted.COMPLETION = NORMAL
  -- if S_converted.RESULT = KNOWN pvalue_new
  -- if $class_static_at(S_converted.CLASSSTATICS, ppropertydesc.ORIGIN) = (pclassstatic_new)
  -- if pclassstatic_new.STATE = PROP_VALUE (ALIAS n_cell)
def $class_static_store_ordinary(S, porigin_requested, ptbytes, pvalue, z) = S_converted[.CLASSSTATICS = $class_static_set(S_converted.CLASSSTATICS, ppropertydesc.ORIGIN, PROP_VALUE (DIRECT pvalue_new))][.RESULT = KNOWN pvalue_new]
  -- if $class_static_select(S, porigin_requested, ptbytes) = (ppropertydesc)
  -- if $class_static_accessible(S, ppropertydesc)
  -- if $class_static_at(S.CLASSSTATICS, ppropertydesc.ORIGIN) = (pclassstatic)
  -- if ppropertydesc.TYPE =/= eps
  -- if ptypeconversion = $typed_conversion_at(S, ppropertydesc.TYPE, pvalue, $property_strict(S))
  -- if ptypeconversion =/= TYPEREJECT
  -- if S_converted = $typed_apply(S, ptypeconversion, z)
  -- if S_converted.COMPLETION = NORMAL
  -- if S_converted.RESULT = KNOWN pvalue_new
  -- if $class_static_at(S_converted.CLASSSTATICS, ppropertydesc.ORIGIN) = (pclassstatic_new)
  -- if ~$property_alias(pclassstatic_new.STATE)
def $class_static_store_ordinary(S, porigin_requested, ptbytes, pvalue, z) = S_converted
  -- if $class_static_select(S, porigin_requested, ptbytes) = (ppropertydesc)
  -- if $class_static_accessible(S, ppropertydesc)
  -- if $class_static_at(S.CLASSSTATICS, ppropertydesc.ORIGIN) = (pclassstatic)
  -- if ppropertydesc.TYPE =/= eps
  -- if ptypeconversion = $typed_conversion_at(S, ppropertydesc.TYPE, pvalue, $property_strict(S))
  -- if ptypeconversion =/= TYPEREJECT
  -- if S_converted = $typed_apply(S, ptypeconversion, z)
  -- if S_converted.COMPLETION =/= NORMAL
def $class_static_store_ordinary(S, porigin_requested, ptbytes, pvalue, z) = $throw_scalar(S, "TypeError", $ptascii("Cannot assign ") ++ $typed_given(S, pvalue) ++ $ptascii(" to property ") ++ $property_declaring_name(S.CLASSES, ppropertydesc.ORIGIN) ++ $ptascii("::$") ++ ppropertydesc.NAME ++ $ptascii(" of type ") ++ $property_type_name(S, ppropertydesc), z)
  -- if $class_static_select(S, porigin_requested, ptbytes) = (ppropertydesc)
  -- if $class_static_accessible(S, ppropertydesc)
  -- if $class_static_at(S.CLASSSTATICS, ppropertydesc.ORIGIN) = (pclassstatic)
  -- if $typed_conversion_at(S, ppropertydesc.TYPE, pvalue, $property_strict(S)) = TYPEREJECT
def $class_static_store_ordinary(S, porigin_requested, ptbytes, pvalue, z) = S[.COMPLETION = UNSUPPORTED "class static storage integrity"] -- otherwise

dec $class_static_quiet(pstate, porigin, ptbytes) : pstate
def $class_static_quiet(S, porigin_requested, ptbytes) = S[.RESULT = KNOWN $entry_value(S, pitem)]
  -- if $class_static_select(S, porigin_requested, ptbytes) = (ppropertydesc)
  -- if $class_static_accessible(S, ppropertydesc)
  -- if $class_static_at(S.CLASSSTATICS, ppropertydesc.ORIGIN) = (pclassstatic)
  -- if pclassstatic.STATE = PROP_VALUE pitem
def $class_static_quiet(S, porigin_requested, ptbytes) = S[.RESULT = KNOWN PNULL] -- otherwise
def $quiet_base(S, BASE_CLASS_STATIC porigin_requested ptbytes, z) = $class_static_quiet(S, porigin_requested, ptbytes)
def $isset_base(S, BASE_CLASS_STATIC porigin_requested ptbytes, b, z) = $isset_simple(S, BASE_CLASS_STATIC porigin_requested ptbytes, b, z)
def $memoized_write_base(S, BASE_CLASS_STATIC porigin_requested ptbytes, pcpath) = BASE_CLASS_STATIC porigin_requested ptbytes
def $coalesce_assign(S, BASE_CLASS_STATIC porigin_requested ptbytes, poperand, z) = $assign_array(S, BASE_CLASS_STATIC porigin_requested ptbytes, poperand, z)

dec $class_static_acquire(pstate, porigin, ptbytes, int) : pstate
def $class_static_acquire(S, porigin_requested, ptbytes, z) = S[.LOCATION = CLASS_STATIC ppropertydesc.ORIGIN]
  -- if $class_constant_static_reference_ready(S, porigin_requested, ptbytes, z)
  -- if $class_static_select(S, porigin_requested, ptbytes) = (ppropertydesc)
  -- if $class_static_accessible(S, ppropertydesc)
  -- if $class_static_at(S.CLASSSTATICS, ppropertydesc.ORIGIN) = (pclassstatic)
def $class_static_acquire(S, porigin_requested, ptbytes, z) = $class_static_read(S, porigin_requested, ptbytes, z)
  -- if $class_constant_static_reference_ready(S, porigin_requested, ptbytes, z)
  -- if $class_static_select(S, porigin_requested, ptbytes) = eps
def $class_static_acquire(S, porigin_requested, ptbytes, z) = $class_static_read(S, porigin_requested, ptbytes, z)
  -- if $class_constant_static_reference_ready(S, porigin_requested, ptbytes, z)
  -- if $class_static_select(S, porigin_requested, ptbytes) = (ppropertydesc)
  -- if ~$class_static_accessible(S, ppropertydesc)

def $class_static_acquire(S, porigin_requested, ptbytes, z) = S[.COMPLETION = UNSUPPORTED "class constant update before static reference"]
  -- if ~$class_constant_static_reference_ready(S, porigin_requested, ptbytes, z)

dec $class_static_attach_source(pstate, ppropertyid, nat) : pstate
def $class_static_attach_source(S, ppropertyid, n_cell) = S[.PROPREFS = $propref_attach(S.PROPREFS, n_cell, CLASS_PROP_SOURCE ppropertyid)]
  -- if $class_static_active_desc(S, S.CLASSNAMES, ppropertyid) = (ppropertydesc)
