;; A reached eval first reserves a source identity and stops for the checked
;; parser service. The continuation is installed only after its response.
def $ppdispatch(P, pcpath, NExprEval expression metadata, PPR) = $ppclearvalue($ppexpr(P, pcpath ++ [PCFIELD 0], expression, PPR))

dec $next_eval_unit(psourcefile*) : nat
def $next_eval_unit(eps) = 1
def $next_eval_unit((SOURCEFILE n n_file*) :: psourcefile*) = n_next
  -- if n_tail = $next_eval_unit(psourcefile*)
  -- if $(n_tail > n)
  -- if n_next = n_tail
def $next_eval_unit((SOURCEFILE n n_file*) :: psourcefile*) = $(n + 1)
  -- if n_tail = $next_eval_unit(psourcefile*)
  -- if $(n_tail <= n)

dec $eval_site_valid(pstate, porigin, int) : bool
dec $eval_site_line(pstate, porigin) : int
dec $eval_operand_site_valid(pstate, porigin, porigin, int) : bool
dec $eval_operand_child_site(pstate, porigin, int) : bool
def $eval_site_valid(S, porigin, z) = ($eval_site_line(S, porigin) = z /\ $(z > 0) /\ $source_filename($call_sourcefile(S.FILES, porigin)))
def $eval_operand_site_valid(S, porigin_parent, porigin_child, z) = true
  -- if $origin_node(S.SOURCES, porigin_parent) = (NExprEval expression metadata)
  -- if $origin_child((porigin_parent), [PCFIELD 0]) = (porigin_child)
  -- if $origin_node(S.SOURCES, porigin_child) = (expression)
  -- if $eval_site_valid(S, porigin_parent, z)
def $eval_operand_site_valid(S, porigin_parent, porigin_child, z) = false -- otherwise
def $eval_operand_child_site(S, porigin_child, z) = $eval_operand_site_valid(S, porigin_parent, porigin_child, z)
  -- if $reference_origin_parent(porigin_child, 1) = ((porigin_parent, [PCFIELD 0]))
def $eval_operand_child_site(S, porigin_child, z) = false -- otherwise

dec $eval_filename(pstate, porigin, int, pconstantlocation?) : preqbytes
def $eval_filename(S, porigin, z, eps) = $call_sourcefile(S.FILES, porigin) ++ [40] ++ $decimal_integer(z) ++ $ptascii(") : eval()'d code")
def $eval_filename(S, porigin, z, (pconstantlocation)) = $call_sourcefile(S.FILES, pconstantlocation.CLASS) ++ [40] ++ $decimal_integer(z_child) ++ $ptascii(") : eval()'d code")
  -- if $class_constant_source_location(S, (pconstantlocation.CHILD)) = ((porigin_child, z_child))
def $eval_filename(S, porigin, z, pconstantlocation?) = eps -- otherwise
dec $eval_location_valid(pstate, nat, pconstantlocation?) : bool
def $eval_location_valid(S, n, eps) = true
def $eval_location_valid(S, n, (pconstantlocation)) = $constant_location_valid(S, pconstantlocation, n)
dec $eval_location_available(pstate, pconstantlocation?) : bool
def $eval_location_available(S, eps) = true
def $eval_location_available(S, (pconstantlocation)) = $declaration_active_class(S, (pconstantlocation.CLASS))

dec $eval_string_result(pvalue) : bool
def $eval_string_result(PSTRING n*) = true
def $eval_string_result(pvalue) = false -- otherwise
dec $eval_operand(pstate, int) : pstate
dec $eval_callback_ready(pstate, int) : bool
dec $source_array_ready(pstate, int) : bool
dec $source_read_ready(pstate) : bool
dec $source_string_begin(pstate, poperand, nat, porigin, int, int, ptask*) : pstate
dec $source_operand_tail(ptask*) : ptask*
dec $source_fast_unit(pstate, nat) : bool
def $source_fast_unit(S, n) = false -- otherwise
dec $source_operand_work(pstate, nat, ptask*, ptask*) : ptask*
dec $source_operand_contexts(pevalcontext*, nat) : pevalcontext*
dec $source_operand_throw(nat, ptask*) : ptask*
def $eval_callback_ready(S, z) = true
  -- if S_read = $resolve_at(S, S.RESULT, z)
  -- if S_read.COMPLETION = NORMAL
  -- if S_read.RESULT = KNOWN (POBJECT n)
  -- if $stringable_instance(S_read, n)
def $eval_callback_ready(S, z) = false -- otherwise
def $eval_operand(S, z) = $stringify(S_read, pvalue, z)
  -- if S_read = $resolve_at(S, S.RESULT, z)
  -- if S_read.COMPLETION = NORMAL
  -- if S_read.RESULT = KNOWN pvalue
def $eval_operand(S, z) = S_read
  -- if S_read = $resolve_at(S, S.RESULT, z)
  -- if S_read.COMPLETION =/= NORMAL

dec $eval_request_start(pstate, porigin, int, ptask*) : pstate
dec $source_helper_result(pstate, psourcehelper, ptask*) : pstate
def $source_helper_result(S, psourcehelper, ptask_tail*) = S[.TODO = ptask_tail*] -- otherwise
dec $eval_class_origin(pstate) : porigin?
def $eval_class_origin(S) = pcallcontext.LEXICAL_CLASS -- if S.CURRENT = (pcallcontext)
def $eval_class_origin(S) = eps -- otherwise
def $eval_request_start(S, porigin, z, ptask_tail*) = $source_helper_result(S[.RESULT = KNOWN (PBOOL false)][.BASE = BASE_VALUE (KNOWN PNULL)], HELPER_EMPTY_EVAL, ptask_tail*)
  -- if $eval_site_valid(S, porigin, z)
  -- if S.RESULT = KNOWN (PSTRING eps)
def $eval_request_start(S, porigin, z, ptask_tail*) = $declaration_enter(S, n_unit, (porigin))[.FILES = S.FILES ++ [SOURCEFILE n_unit n_file*]][.EVALCONTEXTS = pevalcontext :: S.EVALCONTEXTS][.TODO = (EVAL_AWAIT n_unit) :: ptask_tail*][.ORIGIN = (porigin)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)][.COMPLETION = SOURCE_PENDING]
  -- if $eval_site_valid(S, porigin, z)
  -- if S.RESULT = KNOWN (PSTRING (n_byte :: n_tail*))
  -- if n_unit = $next_eval_unit(S.FILES)
  -- if n_file* = $eval_filename(S, porigin, z, $class_constant_location(S))
  -- if n_owner = |S.FRAMES|
  -- if pevalcontext = {UNIT n_unit, SITE porigin, BYTES (n_byte :: n_tail*), FILE n_file*, LEXICAL_CLASS $eval_class_origin(S), OWNER n_owner, PHASE PARSER_WAIT, TAIL ptask_tail*, LOCATION $class_constant_location(S)}
def $eval_request_start(S, porigin, z, ptask_tail*) = S[.COMPLETION = UNSUPPORTED "invalid eval request"]
  -- if ~$eval_site_valid(S, porigin, z)
def $eval_request_start(S, porigin, z, ptask_tail*) = S[.COMPLETION = UNSUPPORTED "invalid eval request"]
  -- if $eval_site_valid(S, porigin, z)
  -- if S.RESULT = KNOWN pvalue
  -- if ~$eval_string_result(pvalue)

rule PhpStep/eval-expression: S ~> S[.TODO = [$at_task($origin_child(S.ORIGIN, [PCFIELD 0]), EVAL expression), $at_task($origin_child(S.ORIGIN, [PCFIELD 0]), EVAL_REQUEST porigin z)] ++ ptask_tail*]
  -- if S.TODO = (EVAL (NExprEval expression metadata)) :: ptask_tail*
  -- if S.ORIGIN = (porigin)
  -- if z = $runtime_line(S, [PCFIELD 0], expression)
rule PhpStep/eval-request-object: S ~> $source_string_begin(S_read, S.RESULT, n, porigin_parent, z, 0, ptask_tail*)
  -- if S.TODO = (EVAL_REQUEST porigin_parent z) :: ptask_tail*
  -- if S.ORIGIN = (porigin_child)
  -- if $eval_operand_site_valid(S, porigin_parent, porigin_child, z)
  -- if S_read = $resolve_at(S, S.RESULT, z)
  -- if S_read.COMPLETION = NORMAL
  -- if S_read.RESULT = KNOWN (POBJECT n)
  -- if $stringable_instance(S_read, n)
rule PhpStep/eval-request: S ~> $eval_request_start(S_value, porigin, z, ptask_tail*)
  -- if S.TODO = (EVAL_REQUEST porigin z) :: ptask_tail*
  -- if ~$eval_callback_ready(S, z)
  -- if ~$source_array_ready(S, z)
  -- if ~$source_read_ready(S)
  -- if S_value = $eval_operand(S, z)
  -- if S_value.COMPLETION = NORMAL
rule PhpStep/eval-request-abrupt: S ~> S_value
  -- if S.TODO = (EVAL_REQUEST porigin z) :: ptask_tail*
  -- if ~$eval_callback_ready(S, z)
  -- if ~$source_array_ready(S, z)
  -- if ~$source_read_ready(S)
  -- if S_value = $eval_operand(S, z)
  -- if S_value.COMPLETION =/= NORMAL

def $call_task_valid(S, EVAL_REQUEST porigin z) = $eval_operand_site_valid(S, porigin, porigin_child, z)
  -- if S.ORIGIN = (porigin_child)

;; The context is independent of the task marker. A pause cannot discard,
;; duplicate, move or change the phase of the sole owned marker.
