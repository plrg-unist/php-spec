def $eval_binding_at(pevalbinding :: pevalbinding_tail*, n) = (pevalbinding)
  -- if pevalbinding.UNIT = n
def $eval_binding_at(pevalbinding :: pevalbinding_tail*, n) = $eval_binding_at(pevalbinding_tail*, n)
  -- if pevalbinding.UNIT =/= n
def $eval_context_at(eps, n) = eps
def $eval_context_at(pevalcontext :: pevalcontext_tail*, n) = (pevalcontext)
  -- if pevalcontext.UNIT = n
def $eval_context_at(pevalcontext :: pevalcontext_tail*, n) = $eval_context_at(pevalcontext_tail*, n)
  -- if pevalcontext.UNIT =/= n
dec $eval_context_phase(pevalcontext*, nat) : pevalphase?
def $eval_context_phase(pevalcontext_all*, n) = (pevalcontext.PHASE)
  -- if $eval_context_at(pevalcontext_all*, n) = (pevalcontext)
def $eval_context_phase(pevalcontext_all*, n) = eps
  -- if $eval_context_at(pevalcontext_all*, n) = eps
def $eval_top_level(S) = true
  -- if S.ORIGIN = (PORIGIN n pcpath)
  -- if $eval_context_at(S.EVALCONTEXTS, n) = (pevalcontext)
  -- if pevalcontext.PHASE = UNIT_RUN
  -- if S.CURRENT = eps
def $eval_top_level(S) = true
  -- if S.ORIGIN = (PORIGIN n pcpath)
  -- if $eval_context_at(S.EVALCONTEXTS, n) = (pevalcontext)
  -- if pevalcontext.PHASE = UNIT_RUN
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.FUNCTION = PORIGIN n_function pcpath_function
  -- if n_function =/= n
def $eval_top_level(S) = false -- otherwise
def $eval_end_marker(EVAL_END n) = true
def $eval_end_marker(ptask) = false -- otherwise
dec $failed_source_at(pfailedsource*, nat) : pfailedsource?
dec $failed_source_kind(pfailedkind) : text
dec $failed_source_record_valid(pstate, pfailedsource) : bool
def $failed_source_at(eps, n) = eps
def $failed_source_at(pfailedsource :: pfailedsource_tail*, n) = (pfailedsource)
  -- if pfailedsource.UNIT = n
def $failed_source_at(pfailedsource :: pfailedsource_tail*, n) = $failed_source_at(pfailedsource_tail*, n)
  -- if pfailedsource.UNIT =/= n
dec $throwable_origin_valid(pstate, porigin?) : bool
def $throwable_origin_valid(S, (porigin)) = true
  -- if $origin_node(S.SOURCES, porigin) =/= eps
def $throwable_origin_valid(S, (PORIGIN n eps)) = true
  -- if $failed_source_at(S.FAILEDSOURCES, n) = (pfailedsource)
  -- if $failed_source_record_valid(S, pfailedsource)
def $throwable_origin_valid(S, porigin?) = false -- otherwise
def $throwable_source_origin_valid(S, n_object, pthrowable) = true
  -- if pthrowable.ORIGIN = (porigin)
  -- if $origin_node(S.SOURCES, porigin) =/= eps
  -- if $throwable_origin_valid(S, pthrowable.FILEORIGIN)
def $throwable_source_origin_valid(S, n_object, pthrowable) = true
  -- if pthrowable.ORIGIN = (PORIGIN n eps)
  -- if pthrowable.FILEORIGIN = pthrowable.ORIGIN
  -- if $failed_source_at(S.FAILEDSOURCES, n) = (pfailedsource)
  -- if $failed_source_record_valid(S, pfailedsource)
  -- if pthrowable.KIND = $failed_source_kind(pfailedsource.KIND)
  -- if $throwable_field(S, n_object, "line") = PINT pfailedsource.LINE
def $throwable_source_origin_valid(S, n_object, pthrowable) = false -- otherwise
def $failed_source_kind(FAILED_PARSE) = "ParseError"
def $failed_source_kind(FAILED_COMPILE) = "CompileError"
def $failed_source_record_valid(S, pfailedsource) = ($eval_site_valid(S, pfailedsource.SITE, z) /\ $(pfailedsource.UNIT > 0) /\ pfailedsource.BYTES =/= eps /\ pfailedsource.MESSAGE =/= eps /\ $(pfailedsource.LINE > 0) /\ $source_unit(S.SOURCES, pfailedsource.UNIT) = eps /\ $sourcefile_count(S.FILES, pfailedsource.UNIT) = 1 /\ pfailedsource.FILE = $call_sourcefile(S.FILES, PORIGIN pfailedsource.UNIT eps) /\ $eval_location_valid(S, pfailedsource.UNIT, pfailedsource.LOCATION) /\ pfailedsource.FILE = $eval_filename(S, pfailedsource.SITE, z, pfailedsource.LOCATION))
  -- if pfailedsource.ISFILE = false
  -- if z = $eval_site_line(S, pfailedsource.SITE)
dec $file_failed_source_record_valid(pstate, pfailedsource) : bool
def $failed_source_record_valid(S, pfailedsource) = $file_failed_source_record_valid(S, pfailedsource)
  -- if pfailedsource.ISFILE = true
dec $failed_sources_valid(pstate, pfailedsource*) : bool
def $failed_sources_valid(S, eps) = true
dec $file_context_unit_present(pfilecontext*, nat) : bool
def $failed_sources_valid(S, pfailedsource :: pfailedsource_tail*) = ($failed_source_at(pfailedsource_tail*, pfailedsource.UNIT) = eps /\ $eval_context_at(S.EVALCONTEXTS, pfailedsource.UNIT) = eps /\ ~$file_context_unit_present(S.FILECONTEXTS, pfailedsource.UNIT) /\ $failed_source_record_valid(S, pfailedsource) /\ $failed_sources_valid(S, pfailedsource_tail*))
dec $eval_marker_id(ptask) : nat?
def $eval_marker_id(EVAL_AWAIT n) = (n)
def $eval_marker_id(EVAL_END n) = (n)
def $eval_marker_id(EVAL_COMPILE_END n) = (n)
def $eval_marker_id(ptask) = eps -- otherwise
dec $eval_marker_count(ptask*, nat) : nat
def $eval_marker_count(eps, n) = 0
def $eval_marker_count(ptask :: ptask_tail*, n) = $(1 + $eval_marker_count(ptask_tail*, n))
  -- if $eval_marker_id(ptask) = (n)
def $eval_marker_count(ptask :: ptask_tail*, n) = $eval_marker_count(ptask_tail*, n)
  -- if $eval_marker_id(ptask) =/= (n)
dec $eval_marker_suffix_valid(ptask*, nat, ptask*) : bool
def $eval_marker_suffix_valid(eps, n, ptask_tail_expected*) = false
def $eval_marker_suffix_valid(ptask :: ptask_tail*, n, ptask_tail_expected*) = (ptask_tail* = ptask_tail_expected*)
  -- if $eval_marker_id(ptask) = (n)
def $eval_marker_suffix_valid(ptask :: ptask_tail*, n, ptask_tail_expected*) = $eval_marker_suffix_valid(ptask_tail*, n, ptask_tail_expected*)
  -- if $eval_marker_id(ptask) =/= (n)
dec $eval_frame_marker_count(pframe*, nat) : nat
def $eval_frame_marker_count(eps, n) = 0
def $eval_frame_marker_count(pframe :: pframe_tail*, n) = $($eval_marker_count(pframe.TODO, n) + $eval_frame_marker_count(pframe_tail*, n))
dec $eval_frame_tasks(pframe*, nat) : ptask*
def $eval_frame_tasks(pframe :: pframe_tail*, 0) = pframe.TODO
def $eval_frame_tasks(pframe :: pframe_tail*, n) = $eval_frame_tasks(pframe_tail*, n_next)
  -- if $(n > 0)
  -- if n_next = $(n - 1)
def $eval_frame_tasks(eps, n) = eps
dec $eval_owner_marker_count(pstate, pevalcontext) : nat
dec $eval_owner_tasks(pstate, pevalcontext) : ptask*
def $eval_owner_tasks(S, pevalcontext) = S.TODO
  -- if pevalcontext.OWNER = |S.FRAMES|
def $eval_owner_tasks(S, pevalcontext) = $eval_frame_tasks(S.FRAMES, n_index)
  -- if $(pevalcontext.OWNER < |S.FRAMES|)
  -- if n_index = $(|S.FRAMES| - pevalcontext.OWNER - 1)
def $eval_owner_tasks(S, pevalcontext) = eps
  -- if $(pevalcontext.OWNER > |S.FRAMES|)
def $eval_owner_marker_count(S, pevalcontext) = $eval_marker_count($eval_owner_tasks(S, pevalcontext), pevalcontext.UNIT)
dec $eval_marker_valid(pstate, ptask) : bool
dec $eval_wrapped_marker(ptask) : bool
dec $eval_nested_markers(ptask*) : bool
def $eval_nested_markers(eps) = false
def $eval_nested_markers(ptask :: ptask_tail*) = ($eval_wrapped_marker(ptask) \/ $eval_nested_markers(ptask_tail*))
def $eval_wrapped_marker(EVAL_AWAIT n) = true
def $eval_wrapped_marker(EVAL_END n) = true
def $eval_wrapped_marker(EVAL_COMPILE_END n) = true
def $eval_wrapped_marker(AT porigin ptask) = $eval_wrapped_marker(ptask)
def $eval_wrapped_marker(CHOOSE ptask_left* ptask_right* z) = ($eval_nested_markers(ptask_left*) \/ $eval_nested_markers(ptask_right*))
def $eval_wrapped_marker(ptask) = false -- otherwise
def $eval_marker_valid(S, EVAL_AWAIT n) = ($eval_context_phase(S.EVALCONTEXTS, n) = (PARSER_WAIT))
def $eval_marker_valid(S, EVAL_END n) = ($eval_context_phase(S.EVALCONTEXTS, n) = (UNIT_RUN))
def $eval_marker_valid(S, EVAL_COMPILE_END n) = ($eval_context_phase(S.EVALCONTEXTS, n) = (EVAL_COMPILE))
def $eval_marker_valid(S, AT porigin ptask) = ~$eval_wrapped_marker(ptask)
def $eval_marker_valid(S, CHOOSE ptask_left* ptask_right* z) = ~($eval_nested_markers(ptask_left*) \/ $eval_nested_markers(ptask_right*))
def $eval_marker_valid(S, ptask) = true -- otherwise
dec $eval_tasks_markers_valid(pstate, ptask*) : bool
dec $eval_requests_owned(ptask*) : bool
dec $eval_request_task(ptask) : bool
def $eval_request_task(EVAL_REQUEST porigin z) = true
def $eval_request_task(ptask) = false -- otherwise
def $eval_requests_owned(eps) = true
def $eval_requests_owned((EVAL_REQUEST porigin z) :: (ORIGIN_RETURN (porigin)) :: ptask_tail*) = $eval_requests_owned(ptask_tail*)
def $eval_requests_owned(ptask :: ptask_tail*) = $eval_requests_owned(ptask_tail*)
  -- if ~$eval_request_task(ptask)
def $eval_requests_owned(ptask*) = false -- otherwise
def $eval_tasks_markers_valid(S, eps) = true
def $eval_tasks_markers_valid(S, ptask :: ptask_tail*) = ($eval_marker_valid(S, ptask) /\ $eval_tasks_markers_valid(S, ptask_tail*))
dec $eval_frames_markers_valid(pstate, pframe*) : bool
def $eval_frames_markers_valid(S, eps) = true
def $eval_frames_markers_valid(S, pframe :: pframe_tail*) = ($eval_tasks_markers_valid(S, pframe.TODO) /\ $eval_requests_owned(pframe.TODO) /\ $eval_frames_markers_valid(S, pframe_tail*))
dec $eval_wait_completion(pcompletion) : bool
def $eval_wait_completion(SOURCE_PENDING) = true
def $eval_wait_completion(UNSUPPORTED text) = true
def $eval_wait_completion(pcompletion) = false -- otherwise
dec $eval_context_phase_valid(pstate, pevalcontext) : bool
dec $eval_head_context(pevalcontext*, pevalcontext) : bool
def $eval_head_context(pevalcontext :: pevalcontext_tail*, pevalcontext) = true
def $eval_head_context(pevalcontext_list*, pevalcontext) = false -- otherwise
dec $eval_await_head(ptask*, nat) : bool
def $eval_await_head((EVAL_AWAIT n) :: ptask_tail*, n) = true
def $eval_await_head(ptask*, n) = false -- otherwise
def $eval_context_phase_valid(S, pevalcontext) = ((pevalcontext.PHASE = PARSER_WAIT /\ $eval_head_context(S.EVALCONTEXTS, pevalcontext) /\ $eval_await_head(S.TODO, pevalcontext.UNIT) /\ pevalcontext.OWNER = |S.FRAMES| /\ S.ORIGIN = (pevalcontext.SITE) /\ pevalcontext.LEXICAL_CLASS = $eval_class_origin(S) /\ pevalcontext.LOCATION = $class_constant_location(S) /\ $source_unit(S.SOURCES, pevalcontext.UNIT) = eps /\ $eval_binding_at(S.EVALBINDINGS, pevalcontext.UNIT) = eps /\ $eval_wait_completion(S.COMPLETION)) \/ ((pevalcontext.PHASE = UNIT_RUN \/ pevalcontext.PHASE = EVAL_COMPILE) /\ $source_unit(S.SOURCES, pevalcontext.UNIT) =/= eps /\ $eval_binding_at(S.EVALBINDINGS, pevalcontext.UNIT) = ({UNIT pevalcontext.UNIT, SITE pevalcontext.SITE, CLASS pevalcontext.LEXICAL_CLASS, LOCATION pevalcontext.LOCATION}) /\ $code_at(S.CODE, pevalcontext.UNIT) =/= eps))
def $eval_site_line(S, porigin) = $runtime_line(S[.ORIGIN = (porigin)][.CONSTCONTEXT = eps], [PCFIELD 0], expression)
  -- if $origin_node(S.SOURCES, porigin) = (NExprEval expression metadata)
def $eval_site_line(S, porigin) = 0 -- otherwise
dec $eval_context_valid(pstate, pevalcontext) : bool
def $eval_context_valid(S, pevalcontext) = ($eval_site_valid(S, pevalcontext.SITE, z) /\ pevalcontext.BYTES =/= eps /\ $(pevalcontext.UNIT > 0) /\ $failed_source_at(S.FAILEDSOURCES, pevalcontext.UNIT) = eps /\ $eval_binding_class_valid(S, pevalcontext.LEXICAL_CLASS) /\ $sourcefile_count(S.FILES, pevalcontext.UNIT) = 1 /\ $call_sourcefile(S.FILES, PORIGIN pevalcontext.UNIT eps) = pevalcontext.FILE /\ $eval_location_valid(S, pevalcontext.UNIT, pevalcontext.LOCATION) /\ pevalcontext.FILE = $eval_filename(S, pevalcontext.SITE, z, pevalcontext.LOCATION) /\ $($eval_marker_count(S.TODO, pevalcontext.UNIT) + $eval_frame_marker_count(S.FRAMES, pevalcontext.UNIT)) = 1 /\ $eval_owner_marker_count(S, pevalcontext) = 1 /\ $eval_marker_suffix_valid($eval_owner_tasks(S, pevalcontext), pevalcontext.UNIT, pevalcontext.TAIL) /\ $eval_context_phase_valid(S, pevalcontext))
  -- if z = $eval_site_line(S, pevalcontext.SITE)
dec $eval_contexts_valid(pstate, pevalcontext*) : bool
def $eval_contexts_valid(S, eps) = true
def $eval_contexts_valid(S, pevalcontext :: pevalcontext_tail*) = ($eval_context_at(pevalcontext_tail*, pevalcontext.UNIT) = eps /\ $eval_context_valid(S, pevalcontext) /\ $eval_contexts_valid(S, pevalcontext_tail*))
dec $eval_before(ptask*, nat, nat) : bool
def $eval_before(eps, n_new, n_old) = false
def $eval_before(ptask :: ptask_tail*, n_new, n_old) = true
  -- if $eval_marker_id(ptask) = (n_new)
def $eval_before(ptask :: ptask_tail*, n_new, n_old) = false
  -- if $eval_marker_id(ptask) = (n_old)
  -- if n_new =/= n_old
def $eval_before(ptask :: ptask_tail*, n_new, n_old) = $eval_before(ptask_tail*, n_new, n_old)
  -- if $eval_marker_id(ptask) =/= (n_new)
  -- if $eval_marker_id(ptask) =/= (n_old)
dec $eval_stack_ordered(pstate, pevalcontext*) : bool
def $eval_stack_ordered(S, eps) = true
