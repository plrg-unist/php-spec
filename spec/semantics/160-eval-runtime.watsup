  -- if P.COMPLETION = PPCNORMAL
  -- if $code_at(S_compiled.CODE, pevalcontext.UNIT) = eps
def $eval_compile_result(S_compiled, pevalcontext, pevalcontext_tail*, P) = S_compiled[.EVALCONTEXTS = pevalcontext_tail*][.TODO = pevalcontext.TAIL][.SERVICELEFT = eps]
  -- if S_compiled.COMPLETION = UNSUPPORTED text

dec $eval_resume_accepted(pstate, pevalcontext, pevalcontext*, program) : pstate
dec $eval_resume_rejected(pstate, pevalcontext, pevalcontext*, pfailedkind, nat*, int) : pstate
dec $eval_compiler_class(pstate) : ptbytes?
def $eval_compiler_class(S) = (pclassdesc.NAME)
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.LEXICAL_CLASS = (porigin_class)
  -- if $class_at(S.CLASSES, porigin_class) = (pclassdesc)
def $eval_compiler_class(S) = eps -- otherwise
def $eval_binding_class_valid(S, eps) = true
def $eval_binding_class_valid(S, (porigin_class)) = ($class_at(S.CLASSES, porigin_class) =/= eps)
def $eval_bindings_valid(S, eps) = true
def $eval_bindings_valid(S, pevalbinding :: pevalbinding_tail*) = ($(pevalbinding.UNIT > 0) /\ $eval_binding_at(pevalbinding_tail*, pevalbinding.UNIT) = eps /\ $source_unit(S.SOURCES, pevalbinding.UNIT) =/= eps /\ $eval_site_valid(S, pevalbinding.SITE, z) /\ $eval_location_valid(S, pevalbinding.UNIT, pevalbinding.LOCATION) /\ $call_sourcefile(S.FILES, PORIGIN pevalbinding.UNIT eps) = $eval_filename(S, pevalbinding.SITE, z, pevalbinding.LOCATION) /\ $eval_binding_class_valid(S, pevalbinding.CLASS) /\ $eval_bindings_valid(S, pevalbinding_tail*))
  -- if z = $eval_site_line(S, pevalbinding.SITE)
def $eval_units_bound(S, eps) = true
def $eval_units_bound(S, pcunit :: pcunit_tail*) = $eval_units_bound(S, pcunit_tail*)
  -- if pcunit.ID = 0
def $eval_units_bound(S, pcunit :: pcunit_tail*) = (($eval_binding_at(S.EVALBINDINGS, pcunit.ID) =/= eps /\ $file_binding_at(S.FILEBINDINGS, pcunit.ID) = eps) \/ ($eval_binding_at(S.EVALBINDINGS, pcunit.ID) = eps /\ $file_binding_at(S.FILEBINDINGS, pcunit.ID) =/= eps)) /\ $eval_units_bound(S, pcunit_tail*)
  -- if $(pcunit.ID > 0)
dec $file_source_ppstate(pstate, pcunit) : ppstate
dec $eval_source_ppstate_body(pstate, pcunit) : ppstate
def $eval_source_ppstate(S, pcunit) = $eval_source_ppstate_body(S, pcunit)
def $eval_source_ppstate_body(S, pcunit) = $file_source_ppstate(S, pcunit)
  -- if $file_binding_at(S.FILEBINDINGS, pcunit.ID) = (pfilebinding)
def $eval_source_ppstate_body(S, pcunit) = $ppstart_eval_state(S, pcunit.ID, pcunit.AST, $call_sourcefile(S.FILES, PORIGIN pcunit.ID eps), $call_request_cwd(S.REQUEST), (pclassdesc.NAME))
  -- if $eval_binding_at(S.EVALBINDINGS, pcunit.ID) = (pevalbinding)
  -- if pevalbinding.CLASS = (porigin_class)
  -- if $class_at(S.CLASSES, porigin_class) = (pclassdesc)
def $eval_source_ppstate_body(S, pcunit) = $ppstart_eval_state(S, pcunit.ID, pcunit.AST, $call_sourcefile(S.FILES, PORIGIN pcunit.ID eps), $call_request_cwd(S.REQUEST), eps)
  -- if $eval_binding_at(S.EVALBINDINGS, pcunit.ID) = (pevalbinding)
  -- if pevalbinding.CLASS = eps
def $eval_source_ppstate_body(S, pcunit) = $ppstart_eval_state(S, pcunit.ID, pcunit.AST, $call_sourcefile(S.FILES, PORIGIN pcunit.ID eps), $call_request_cwd(S.REQUEST), eps)
  -- if pcunit.ID = 0
  -- if $eval_binding_at(S.EVALBINDINGS, pcunit.ID) = eps
def $eval_resume_accepted(S, pevalcontext, pevalcontext_tail*, program) = $eval_compile_result(S_compiled, pevalcontext, pevalcontext_tail*, P)
  -- if P = $ppstart_eval_state(S, pevalcontext.UNIT, program, pevalcontext.FILE, $call_request_cwd(S.REQUEST), $eval_compiler_class(S))
  -- if ~$declaration_parser_rejects($declaration_preflight(P.FOLD.SOURCE.OCCURRENCES))
  -- if pevalbinding = {UNIT pevalcontext.UNIT, SITE pevalcontext.SITE, CLASS pevalcontext.LEXICAL_CLASS, LOCATION pevalcontext.LOCATION}
  -- if S_compiled = $compile_source_append(S[.COMPLETION = NORMAL][.EVALBINDINGS = S.EVALBINDINGS ++ [pevalbinding]][.EVALCONTEXTS = pevalcontext[.PHASE = EVAL_COMPILE] :: pevalcontext_tail*], P)
def $eval_resume_accepted(S, pevalcontext, pevalcontext_tail*, program) = $eval_resume_rejected(S, pevalcontext, pevalcontext_tail*, FAILED_COMPILE, ptbytes_message, z)
  -- if $declaration_preflight($pcsource(pevalcontext.UNIT, program).OCCURRENCES) = (COMPILETHROWN ptbytes_message z)
dec $eval_resume_valid(pstate, psourceresponse) : pstate
def $eval_resume_valid(S, SOURCE_ACCEPT n n_bytes* program) = $eval_resume_accepted(S, pevalcontext, pevalcontext_tail*, program)
  -- if S.EVALCONTEXTS = pevalcontext :: pevalcontext_tail*
def $eval_resume_rejected(S, pevalcontext, pevalcontext_tail*, pfailedkind, n_message*, z) = S_object[.EVALCONTEXTS = pevalcontext_tail*][.TODO = $source_operand_throw(n_object, pevalcontext.TAIL)][.ORIGIN = (pevalcontext.SITE)][.SERVICELEFT = eps][.COMPLETION = NORMAL][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)][.HELD = eps][.CONSTCONTEXT = eps]
  -- if ~$source_eval_pending_marker(pevalcontext)
  -- if pfailedsource = {UNIT pevalcontext.UNIT, SITE pevalcontext.SITE, BYTES pevalcontext.BYTES, FILE pevalcontext.FILE, ISFILE false, KIND pfailedkind, MESSAGE n_message*, LINE z, LOCATION pevalcontext.LOCATION}
  -- if S_failed = $declaration_exit(S, pevalcontext.UNIT, PCSREJECT)[.FAILEDSOURCES = pfailedsource :: S.FAILEDSOURCES][.ORIGIN = (PORIGIN pevalcontext.UNIT eps)][.COMPLETION = THROWN $failed_source_kind(pfailedkind) n_message* z]
  -- if S_object = $throwable_allocate_at(S_failed, $failed_source_kind(pfailedkind), n_message*, PORIGIN pevalcontext.UNIT eps, z, $eval_exception_trace(S_failed))
  -- if S_object.COMPLETION = THROWING n_object
def $eval_resume_rejected(S, pevalcontext, pevalcontext_tail*, pfailedkind, n_message*, z) = S_object[.EVALCONTEXTS = pevalcontext_tail*][.TODO = pevalcontext.TAIL][.SERVICELEFT = eps]
  -- if ~$source_eval_pending_marker(pevalcontext)
  -- if pfailedsource = {UNIT pevalcontext.UNIT, SITE pevalcontext.SITE, BYTES pevalcontext.BYTES, FILE pevalcontext.FILE, ISFILE false, KIND pfailedkind, MESSAGE n_message*, LINE z, LOCATION pevalcontext.LOCATION}
  -- if S_failed = $declaration_exit(S, pevalcontext.UNIT, PCSREJECT)[.FAILEDSOURCES = pfailedsource :: S.FAILEDSOURCES][.ORIGIN = (PORIGIN pevalcontext.UNIT eps)][.COMPLETION = THROWN $failed_source_kind(pfailedkind) n_message* z]
  -- if S_object = $throwable_allocate_at(S_failed, $failed_source_kind(pfailedkind), n_message*, PORIGIN pevalcontext.UNIT eps, z, $eval_exception_trace(S_failed))
  -- if ~$eval_allocated_throw(S_object.COMPLETION)
def $eval_resume_valid(S, SOURCE_PARSE_REJECT n n_bytes* n_message* z) = $eval_resume_rejected(S, pevalcontext, pevalcontext_tail*, FAILED_PARSE, n_message*, z)
  -- if S.EVALCONTEXTS = pevalcontext :: pevalcontext_tail*
def $eval_resume_valid(S, SOURCE_COMPILE_REJECT n n_bytes* n_message* z) = $eval_resume_rejected(S, pevalcontext, pevalcontext_tail*, FAILED_COMPILE, n_message*, z)
  -- if S.EVALCONTEXTS = pevalcontext :: pevalcontext_tail*
dec $eval_resume(pstate, psourceresponse) : pstate
def $eval_resume(S, psourceresponse) = $eval_resume_valid(S, psourceresponse)
  -- if $eval_response_valid(S, psourceresponse)
def $eval_resume(S, psourceresponse) = S[.COMPLETION = UNSUPPORTED "invalid eval parser response"]
  -- if ~$eval_response_valid(S, psourceresponse)
dec $eval_continue(pstate, psourceresponse) : pstate
def $eval_continue(S, psourceresponse) = $drive_steps(S_next, n)
  -- if S.SERVICELEFT = (n)
  -- if S_next = $eval_resume(S, psourceresponse)
  -- if S_next.COMPLETION = NORMAL \/ $shutdown_ready(S_next) \/ $destructor_ready(S_next)
def $eval_continue(S, psourceresponse) = S_next
  -- if S_next = $eval_resume(S, psourceresponse)
  -- if S_next.COMPLETION =/= NORMAL
  -- if ~$shutdown_ready(S_next) /\ ~$destructor_ready(S_next)

rule PhpStep/eval-end: S ~> S[.EVALCONTEXTS = pevalcontext_tail*][.TODO = ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)][.ORIGIN = (pevalcontext.SITE)]
  -- if S.TODO = (EVAL_END n) :: ptask_tail*
  -- if S.EVALCONTEXTS = pevalcontext :: pevalcontext_tail*
  -- if pevalcontext.UNIT = n
  -- if pevalcontext.PHASE = UNIT_RUN
  -- if pevalcontext.TAIL = ptask_tail*

def $return_step(S, poperand, (PORIGIN n pcpath_source), (EVAL_END n) :: ptask_tail*) = S[.EVALCONTEXTS = pevalcontext_tail*][.TODO = ptask_tail*][.RESULT = poperand][.BASE = BASE_VALUE (KNOWN PNULL)][.ORIGIN = (pevalcontext.SITE)][.HELD = eps]
  -- if S.EVALCONTEXTS = pevalcontext :: pevalcontext_tail*
  -- if pevalcontext.UNIT = n
  -- if pevalcontext.PHASE = UNIT_RUN
  -- if pevalcontext.OWNER = |S.FRAMES|
  -- if pevalcontext.TAIL = ptask_tail*
def $throwable_marker(EVAL_END n) = true
rule PhpStep/eval-throw-cross: S ~> S[.EVALCONTEXTS = pevalcontext_tail*][.TODO = (THROW_SEARCH n_object) :: ptask_tail*][.ORIGIN = (pevalcontext.SITE)][.HELD = eps]
  -- if S.TODO = (THROW_SEARCH n_object) :: (EVAL_END n_unit) :: ptask_tail*
  -- if S.EVALCONTEXTS = pevalcontext :: pevalcontext_tail*
  -- if pevalcontext.UNIT = n_unit
  -- if pevalcontext.PHASE = UNIT_RUN
  -- if pevalcontext.OWNER = |S.FRAMES|
  -- if pevalcontext.TAIL = ptask_tail*
