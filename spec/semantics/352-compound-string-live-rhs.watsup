;; A result pointer selected before a callback still names that CV slot,
;; even if the callback has since installed a reference container there.
def $compound_live_write(S, pcompoundstring, pvalue) = $write_name($unset_name(S, n_name*), n_name*, pvalue)
  -- if pcompoundstring.CV
  -- if $compound_live_cv_name(S, pcompoundstring.SITE, [PCFIELD 0]) = (n_name*)
  -- if $lookup(S.ENV, n_name*) = (n)
  -- if n <- S.REFCELLS
def $compound_live_write(S, pcompoundstring, pvalue) = $write_name(S, n_name*, pvalue)
  -- if pcompoundstring.CV
  -- if $compound_live_cv_name(S, pcompoundstring.SITE, [PCFIELD 0]) = (n_name*)
  -- if $lookup(S.ENV, n_name*) = (n)
  -- if ~(n <- S.REFCELLS)
def $compound_live_write(S, pcompoundstring, pvalue) = $write_name(S, n_name*, pvalue)
  -- if pcompoundstring.CV
  -- if $compound_live_cv_name(S, pcompoundstring.SITE, [PCFIELD 0]) = (n_name*)
  -- if $lookup(S.ENV, n_name*) = eps
def $compound_live_write(S, pcompoundstring, pvalue) = $compound_string_write(S, pcompoundstring.PLACE, pcompoundstring.SITE, pvalue)
  -- if ~pcompoundstring.CV
rule PhpStep/compound-live-store: S ~> $compound_live_write(S[.TODO = (COMPOUND_LIVE_RELEASE pcompoundstring) :: ptask*][.LOCATION = pcompoundstring.PLACE][.RESULT = KNOWN pvalue], pcompoundstring, pvalue)
  -- if S.TODO = (COMPOUND_LIVE_RIGHT pcompoundstring ptbytes_left) :: ptask*
  -- if S.RESULT = KNOWN (PSTRING ptbytes_right)
  -- if pvalue = PSTRING (ptbytes_left ++ ptbytes_right)
rule PhpStep/compound-live-release: S ~> S[.TODO = (COMPOUND_LIVE_DONE pcompoundstring) :: ptask*]
  -- if S.TODO = (COMPOUND_LIVE_RELEASE pcompoundstring) :: ptask*
rule PhpStep/compound-live-done: S ~> S[.TODO = ptask*]
  -- if S.TODO = (COMPOUND_LIVE_DONE pcompoundstring) :: ptask*
