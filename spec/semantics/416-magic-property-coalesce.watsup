def $property_coalesce_source(S, ppropertycoalesce) = true
  -- if ppropertycoalesce.SITE = PORIGIN n pcpath
  -- if $origin_node(S.SOURCES, ppropertycoalesce.SITE) = (expression_left)
  -- if expression_left = NExprPropertyFetch (NExprVariable (BYTES text_receiver) metadata_receiver) (NIdentifier (BYTES text_name) metadata_name) metadata
  -- if $base64(text_receiver) =/= $ptascii("this") /\ ppropertycoalesce.NAME = $base64(text_name)
  -- if $(|pcpath| > 0)
  -- if pcpath_parent = pcpath[0:$nabs($(|pcpath| - 1))]
  -- if pcpath = pcpath_parent ++ [PCFIELD 0]
  -- if porigin_parent = PORIGIN n pcpath_parent
  -- if $origin_node(S.SOURCES, porigin_parent) = (NExprBinaryOpCoalesce expression_left expression_right metadata_parent)
  -- if ppropertycoalesce.TAIL = (ORIGIN_RETURN (porigin_parent)) :: (COALESCE_QUIET expression_right z_left z_right) :: ptask_tail*
  -- if ppropertycoalesce.LINE = z_left
  -- if $property_source_task(S[.ORIGIN = (ppropertycoalesce.SITE)], expression_left)
  -- if ppropertycoalesce.LINE = $runtime_line(S[.ORIGIN = (ppropertycoalesce.SITE)], eps, expression_left)
  -- if z_right = $runtime_line(S[.ORIGIN = (porigin_parent)], [PCFIELD 1], expression_right)
  -- if $source_emission_cv(S, n, pcpath ++ [PCFIELD 0], NExprVariable (BYTES text_receiver) metadata_receiver)
  -- if ~$scope_global(S[.ORIGIN = (ppropertycoalesce.SITE)], [PCFIELD 0])
  -- if $compiled_effects(S, ppropertycoalesce.SITE) = eps
def $property_coalesce_source(S, ppropertycoalesce) = false -- otherwise

