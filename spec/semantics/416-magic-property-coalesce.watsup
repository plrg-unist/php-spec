  -- if $property_coalesce_entered(S, S.CURRENT, S.FRAMES, ppropertycoalesce, b_get)
def $property_coalesce_context(S, pcallcontext) = false -- otherwise
def $call_arity_valid(S, pcallcontext) = $property_coalesce_context(S, pcallcontext)
  -- if pcallcontext.TARGET = PROPERTY_COALESCE_TARGET ppropertycoalesce b_get
def $call_extent_valid(S, pcallcontext) = $property_coalesce_context(S, pcallcontext)
  -- if pcallcontext.TARGET = PROPERTY_COALESCE_TARGET ppropertycoalesce b_get
def $named_context_valid(S, pcallcontext) = $property_coalesce_context(S, pcallcontext)
  -- if pcallcontext.TARGET = PROPERTY_COALESCE_TARGET ppropertycoalesce b_get
def $named_receives_ready(S, pfunction) = true
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.FUNCTION = pfunction.ORIGIN
  -- if $property_coalesce_context(S, pcallcontext)
def $call_task_valid(S, PROPERTY_COALESCE_RESULT ppropertycoalesce b_get) = ($property_coalesce_pending_call(S, ppropertycoalesce, b_get) \/ $property_coalesce_tail(S, ppropertycoalesce, b_get, S.TODO) \/ $property_coalesce_throw_tail(S, ppropertycoalesce, b_get) \/ $property_coalesce_exit(S, S.TODO, ppropertycoalesce, b_get) =/= eps)

;; These guards follow only the active call, not the queued result/receiver hold.
def $property_isset_guard_frame(S, pcallcontext, pframe, n, ptbytes) = true
  -- if pcallcontext.TARGET = PROPERTY_COALESCE_TARGET ppropertycoalesce false
  -- if ppropertycoalesce.OBJECT = n /\ ppropertycoalesce.NAME = ptbytes
  -- if $property_coalesce_entered(S, S.CURRENT, S.FRAMES, ppropertycoalesce, false)
def $property_isset_guard_task(S, PROPERTY_COALESCE_RESULT ppropertycoalesce false, n, ptbytes) = true
  -- if $property_coalesce_exit_guard(S, PROPERTY_COALESCE_RESULT ppropertycoalesce false, n, ptbytes, false)
def $property_empty_get_active(S, n, ptbytes) = true
  -- if $property_coalesce_active(S, S.CURRENT, S.FRAMES, n, ptbytes, true)
