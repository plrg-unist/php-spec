;; Identifier members keep their literal proof; other members require their
;; own immutable compiled string and cannot borrow a mutable CV operand.
dec $class_constant_compiled_member(pstate, porigin, phpType20) : ptbytes?
def $class_constant_compiled_member(S, porigin, NIdentifier (BYTES text) metadata) = $pfclass_constant_member(NIdentifier (BYTES text) metadata, eps)
def $class_constant_compiled_member(S, porigin, expression_member) = $pfclass_constant_member(expression_member, $compiled_read(S, porigin))
  -- if ~$method_receiver_is_variable(expression_member)
def $class_constant_compiled_member(S, porigin, phpType20) = eps -- otherwise

