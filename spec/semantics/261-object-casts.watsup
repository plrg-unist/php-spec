def $object_foreach_deliver(S, n, n_object, statement, z, ptbytes, poperand, b_ref) = $error_dispatch(S[.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], 8, preqbytes_warning, z, DIAGNOSTIC "Notice" preqbytes_warning z, OBJECT_FOREACH_KEY pobjectforeach)
