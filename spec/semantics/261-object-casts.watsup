;; stdClass may own the same HashTable as an array or another stdClass. Its
;; projected slots are lookup metadata; only the table owns their items.
def $object_table_at(eps, n) = eps
def $object_table_at(pobjecttable :: pobjecttable_tail*, n) = (pobjecttable.TABLE)
  -- if pobjecttable.OBJECT = n
def $object_table_at(pobjecttable :: pobjecttable_tail*, n) = $object_table_at(pobjecttable_tail*, n)
  -- if pobjecttable.OBJECT =/= n
dec $object_table_remove(pobjecttable*, nat) : pobjecttable*
def $object_table_remove(eps, n) = eps
def $object_table_remove(pobjecttable :: pobjecttable_tail*, n) = pobjecttable_tail*
  -- if pobjecttable.OBJECT = n
def $object_table_remove(pobjecttable :: pobjecttable_tail*, n) = pobjecttable :: $object_table_remove(pobjecttable_tail*, n)
  -- if pobjecttable.OBJECT =/= n
def $object_tables_prune(eps, pnode*) = eps
def $object_tables_prune(pobjecttable :: pobjecttable_tail*, pnode*) = pobjecttable :: $object_tables_prune(pobjecttable_tail*, pnode*)
  -- if (HOBJECT pobjecttable.OBJECT) <- pnode*
def $object_tables_prune(pobjecttable :: pobjecttable_tail*, pnode*) = $object_tables_prune(pobjecttable_tail*, pnode*)
  -- if ~((HOBJECT pobjecttable.OBJECT) <- pnode*)

dec $object_table_slots(pentry*) : ppropertyslot*
def $object_table_slots(eps) = eps
def $object_table_slots((ENTRY (KSTRING ptbytes) pitem) :: pentry_tail*) = {DECL eps, NAME ptbytes, STATE PROP_VALUE pitem} :: $object_table_slots(pentry_tail*)
dec $object_table_item_valid(pstate, pitem) : bool
def $object_table_item_valid(S, ALIAS n) = true
  -- if $(n < |S.STORE|)
  -- if S.STORE[n] = DEFINED pvalue
  -- if n <- S.REFCELLS
  -- if (HCELL n) <- S.ALLOCATIONS
def $object_table_item_valid(S, DIRECT pvalue) = true
def $object_table_item_valid(S, UNINITIALIZED) = true
def $object_table_item_valid(S, pitem) = false -- otherwise
dec $object_table_entries_valid(pstate, pentry*) : bool
def $object_table_entries_valid(S, eps) = true
def $object_table_entries_valid(S, (ENTRY (KSTRING ptbytes) pitem) :: pentry_tail*) = ($object_table_item_valid(S, pitem) /\ $object_table_entries_valid(S, pentry_tail*))
  -- if $startup_bytes(ptbytes)
  -- if $entry_lookup(pentry_tail*, KSTRING ptbytes) = eps
def $object_table_entries_valid(S, pentry*) = false -- otherwise
def $stdclass_slots_valid(S, eps) = true
def $stdclass_slots_valid(S, ppropertyslot :: ppropertyslot_tail*) = ($object_table_item_valid(S, pitem) /\ $stdclass_slots_valid(S, ppropertyslot_tail*))
  -- if ppropertyslot.DECL = eps
  -- if ppropertyslot.STATE = PROP_VALUE pitem
  -- if $startup_bytes(ppropertyslot.NAME)
def $stdclass_slots_valid(S, ppropertyslot :: ppropertyslot_tail*) = $stdclass_slots_valid(S, ppropertyslot_tail*)
  -- if ppropertyslot.DECL = eps
  -- if ppropertyslot.STATE = PROP_UNSET
  -- if $startup_bytes(ppropertyslot.NAME)
def $stdclass_slots_valid(S, ppropertyslot*) = false -- otherwise
dec $object_tables_list_valid(pstate, pobjecttable*) : bool
def $object_tables_list_valid(S, eps) = true
def $object_tables_list_valid(S, pobjecttable :: pobjecttable_tail*) = $object_tables_list_valid(S, pobjecttable_tail*)
  -- if $(pobjecttable.OBJECT < |S.OBJECTS|)
  -- if $(pobjecttable.TABLE < |S.ARRAYS|)
  -- if S.OBJECTS[pobjecttable.OBJECT] = STDINSTANCE
  -- if (HOBJECT pobjecttable.OBJECT) <- S.ALLOCATIONS
  -- if (HARRAY pobjecttable.TABLE) <- S.ALLOCATIONS
  -- if $object_table_at(pobjecttable_tail*, pobjecttable.OBJECT) = eps
  -- if $objectprops_record_at(S.OBJECTPROPS, pobjecttable.OBJECT) = (pobjectprops)
  -- if pobjectprops.MATERIALIZED
  -- if $object_table_entries_valid(S, S.ARRAYS[pobjecttable.TABLE].ITEMS)
  -- if $property_entries(pobjectprops.SLOTS) = S.ARRAYS[pobjecttable.TABLE].ITEMS
def $object_tables_list_valid(S, pobjecttable*) = false -- otherwise
def $object_tables_valid(S) = $object_tables_list_valid(S, S.OBJECTTABLES)

;; Writable lookup separates a shared property table even when the selected
;; entry is already a reference. A sole table keeps its existing wrappers.
dec $object_table_write_slots(pstate, nat, ppropertyslot*) : ppropertyslot*
def $object_table_write_slots(S, n_table, eps) = eps
def $object_table_write_slots(S, n_table, ppropertyslot :: ppropertyslot_tail*) = ppropertyslot[.STATE = PROP_UNSET] :: $object_table_write_slots(S, n_table, ppropertyslot_tail*)
  -- if ppropertyslot.STATE = PROP_VALUE UNINITIALIZED
def $object_table_write_slots(S, n_table, ppropertyslot :: ppropertyslot_tail*) = ppropertyslot[.STATE = PROP_VALUE $duplicate_item(S, n_table, pitem)] :: $object_table_write_slots(S, n_table, ppropertyslot_tail*)
  -- if ppropertyslot.STATE = PROP_VALUE pitem
  -- if pitem =/= UNINITIALIZED
def $object_table_write_slots(S, n_table, ppropertyslot :: ppropertyslot_tail*) = ppropertyslot :: $object_table_write_slots(S, n_table, ppropertyslot_tail*)
  -- if ppropertyslot.STATE = PROP_UNSET
def $object_table_write(S, n) = S[.ARRAYS = S.ARRAYS ++ [S.ARRAYS[n_table][.ITEMS = $property_entries(ppropertyslot_new*)][.POSITIONS = $defined_positions(S.ARRAYS[n_table].POSITIONS, $property_entries(ppropertyslot_new*))]]][.ALLOCATIONS = S.ALLOCATIONS ++ [HARRAY n_new]][.OBJECTTABLES = $object_table_remove(S.OBJECTTABLES, n) ++ [{OBJECT n, TABLE n_new}]][.OBJECTPROPS = $objectprops_set(S.OBJECTPROPS, n, ppropertyslot_new*)]
  -- if $object_table_at(S.OBJECTTABLES, n) = (n_table)
  -- if $objectprops_record_at(S.OBJECTPROPS, n) = (pobjectprops)
  -- if $($heap_owners($heap_prune($heap_graph(S)), HARRAY n_table) > 1)
  -- if ppropertyslot_new* = $object_table_write_slots(S, n_table, pobjectprops.SLOTS)
  -- if n_new = |S.ARRAYS|
def $object_table_write(S, n) = S
  -- if $object_table_at(S.OBJECTTABLES, n) = (n_table)
  -- if $heap_owners($heap_prune($heap_graph(S)), HARRAY n_table) = 1
def $object_table_write(S, n) = S
  -- if $object_table_at(S.OBJECTTABLES, n) = eps
def $object_table_write_value(S, POBJECT n) = $object_table_write(S, n)
def $object_table_write_value(S, pvalue) = S -- otherwise

dec $object_table_all_strings(pentry*) : bool
def $object_table_all_strings(eps) = true
def $object_table_all_strings((ENTRY (KSTRING ptbytes) pitem) :: pentry_tail*) = $object_table_all_strings(pentry_tail*)
def $object_table_all_strings(pentry*) = false -- otherwise
dec $object_table_key(pkey) : ptbytes
def $object_table_key(KSTRING ptbytes) = ptbytes
def $object_table_key(KINT z) = $decimal_integer(z)
dec $object_table_copy_item(pstate, nat, pitem) : pitem
def $object_table_copy_item(S, n_source, ALIAS n_cell) = DIRECT pvalue
  -- if H = $heap_prune($heap_graph(S)[.ROOTS = $machine_roots(S) ++ [HARRAY n_source]])
  -- if $heap_owners(H, HCELL n_cell) = 1
  -- if S.STORE[n_cell] = DEFINED pvalue
def $object_table_copy_item(S, n_source, pitem) = pitem -- otherwise
dec $object_table_from_array(pstate, nat, pentry*, parray) : parray
def $object_table_from_array(S, n_source, eps, parray) = parray
def $object_table_from_array(S, n_source, (ENTRY pkey UNINITIALIZED) :: pentry_tail*, parray) = $object_table_from_array(S, n_source, pentry_tail*, parray)
def $object_table_from_array(S, n_source, (ENTRY pkey pitem) :: pentry_tail*, parray) = $object_table_from_array(S, n_source, pentry_tail*, $array_insert(parray, KSTRING $object_table_key(pkey), $object_table_copy_item(S, n_source, pitem)))
  -- if pitem =/= UNINITIALIZED
dec $object_cast_array(pstate, nat) : pstate
def $object_cast_array(S, n_source) = S_new[.OBJECTTABLES = S_new.OBJECTTABLES ++ [{OBJECT n, TABLE n_source}]][.OBJECTPROPS = $objectprops_set(S_new.OBJECTPROPS, n, $object_table_slots(S.ARRAYS[n_source].ITEMS))]
  -- if $object_table_all_strings(S.ARRAYS[n_source].ITEMS)
  -- if S_new = $objectprops_mark($new_class(S, $ptascii("stdClass"), 0), |S.OBJECTS|)
  -- if n = |S.OBJECTS|
def $object_cast_array(S, n_source) = $object_cast_array(S_table, |S.ARRAYS|)
  -- if ~$object_table_all_strings(S.ARRAYS[n_source].ITEMS)
  -- if parray = $object_table_from_array(S, n_source, S.ARRAYS[n_source].ITEMS, $array_empty())
  -- if S_table = $allocate_array(S, parray)
dec $object_cast_scalar(pstate, pitem) : pstate
def $object_cast_scalar(S, pitem) = $objectprops_mark(S_new[.OBJECTPROPS = $objectprops_set(S_new.OBJECTPROPS, |S.OBJECTS|, [{DECL eps, NAME ($ptascii("scalar")), STATE PROP_VALUE pitem}])], |S.OBJECTS|)
  -- if S_new = $new_class(S, $ptascii("stdClass"), 0)
def $cast_value(S, CASTOBJECT, PARRAY n, z) = $object_cast_array(S, n)
  -- if S.ARRAYS[n].ITEMS =/= eps
def $cast_value(S, CASTOBJECT, PUNDEFINED, z) = $object_cast_scalar(S, UNINITIALIZED)
def $cast_value(S, CASTOBJECT, pvalue, z) = $object_cast_scalar(S, DIRECT pvalue)
  -- if ~($is_array_value(pvalue) \/ $cast_object_value(pvalue) \/ pvalue = PNULL)
  -- if pvalue =/= PUNDEFINED
def $cast_value(S, CASTINT, PUNDEFINED, z) = S[.RESULT = KNOWN (PINT 0)]

;; Cast-to-array and fast stdClass clone can reuse the real property table.
def $object_table_materialize(S, n) = S
  -- if $object_table_at(S.OBJECTTABLES, n) = (n_table)
def $object_table_materialize(S, n) = S[.ARRAYS = S.ARRAYS ++ [$property_cast_array(pobjectprops.SLOTS)]][.ALLOCATIONS = S.ALLOCATIONS ++ [HARRAY n_table]][.OBJECTTABLES = S.OBJECTTABLES ++ [{OBJECT n, TABLE n_table}]][.OBJECTPROPS = $objectprops_mark(S, n).OBJECTPROPS]
  -- if $object_table_at(S.OBJECTTABLES, n) = eps
  -- if $objectprops_record_at(S.OBJECTPROPS, n) = (pobjectprops)
  -- if n_table = |S.ARRAYS|
dec $object_table_numeric_keys(pentry*) : bool
def $object_table_numeric_keys(eps) = false
def $object_table_numeric_keys((ENTRY (KSTRING ptbytes) pitem) :: pentry_tail*) = true
  -- if $string_key(ptbytes) = INTEGERKEY z
def $object_table_numeric_keys((ENTRY (KSTRING ptbytes) pitem) :: pentry_tail*) = $object_table_numeric_keys(pentry_tail*)
  -- if $string_key(ptbytes) = STRINGKEY
dec $object_table_to_array(pstate, nat, pentry*, parray) : parray
def $object_table_to_array(S, n_source, eps, parray) = parray
def $object_table_to_array(S, n_source, (ENTRY (KSTRING ptbytes) UNINITIALIZED) :: pentry_tail*, parray) = $object_table_to_array(S, n_source, pentry_tail*, parray)
def $object_table_to_array(S, n_source, (ENTRY (KSTRING ptbytes) pitem) :: pentry_tail*, parray) = $object_table_to_array(S, n_source, pentry_tail*, $array_insert(parray, KINT z, $object_table_copy_item(S, n_source, pitem)))
  -- if pitem =/= UNINITIALIZED
  -- if $string_key(ptbytes) = INTEGERKEY z
def $object_table_to_array(S, n_source, (ENTRY (KSTRING ptbytes) pitem) :: pentry_tail*, parray) = $object_table_to_array(S, n_source, pentry_tail*, $array_insert(parray, KSTRING ptbytes, $object_table_copy_item(S, n_source, pitem)))
  -- if pitem =/= UNINITIALIZED
  -- if $string_key(ptbytes) = STRINGKEY
def $stdclass_cast_array(S, n) = S_table[.RESULT = KNOWN (PARRAY n_table)]
  -- if S_table = $object_table_materialize(S, n)
  -- if $object_table_at(S_table.OBJECTTABLES, n) = (n_table)
  -- if ~$object_table_numeric_keys(S_table.ARRAYS[n_table].ITEMS)
def $stdclass_cast_array(S, n) = $allocate_array(S_table, $object_table_to_array(S_table, n_table, S_table.ARRAYS[n_table].ITEMS, $array_empty()))
  -- if S_table = $object_table_materialize(S, n)
  -- if $object_table_at(S_table.OBJECTTABLES, n) = (n_table)
  -- if $object_table_numeric_keys(S_table.ARRAYS[n_table].ITEMS)
def $stdclass_clone(S, n_source) = S_table[.OBJECTS = S_table.OBJECTS ++ [STDINSTANCE]][.OBJECTPROPS = S_table.OBJECTPROPS ++ [{OBJECT n, SLOTS pobjectprops.SLOTS, MATERIALIZED true}]][.OBJECTTABLES = S_table.OBJECTTABLES ++ [{OBJECT n, TABLE n_table}]][.ALLOCATIONS = S_table.ALLOCATIONS ++ [HOBJECT n]][.RESULT = KNOWN (POBJECT n)]
  -- if S_table = $object_table_materialize(S, n_source)
  -- if $objectprops_record_at(S_table.OBJECTPROPS, n_source) = (pobjectprops)
  -- if $object_table_at(S_table.OBJECTTABLES, n_source) = (n_table)
  -- if n = |S_table.OBJECTS|

;; Synchronize the lookup projection after a writable helper, retaining bucket
;; serials for existing keys and allocating a new serial only for new entries.
dec $object_table_prune_keys(pentry*, pentry*, parray) : parray
def $object_table_prune_keys(eps, pentry_new*, parray) = parray
def $object_table_prune_keys((ENTRY pkey pitem) :: pentry_tail*, pentry_new*, parray) = $object_table_prune_keys(pentry_tail*, pentry_new*, parray[.ITEMS = $entry_delete(parray.ITEMS, pkey)][.POSITIONS = $position_delete(parray.POSITIONS, pkey)])
  -- if $entry_lookup(pentry_new*, pkey) = eps
def $object_table_prune_keys((ENTRY pkey pitem) :: pentry_tail*, pentry_new*, parray) = $object_table_prune_keys(pentry_tail*, pentry_new*, parray)
  -- if $entry_lookup(pentry_new*, pkey) = (pitem_new)
dec $object_table_insert_entries(pentry*, parray) : parray
def $object_table_insert_entries(eps, parray) = parray
def $object_table_insert_entries((ENTRY pkey pitem) :: pentry_tail*, parray) = $object_table_insert_entries(pentry_tail*, $array_insert(parray, pkey, pitem))
def $object_table_sync(S, n) = S[.ARRAYS = $array_replace(S.ARRAYS, n_table, $object_table_insert_entries(pentry*, $object_table_prune_keys(S.ARRAYS[n_table].ITEMS, pentry*, S.ARRAYS[n_table])))]
  -- if $object_table_at(S.OBJECTTABLES, n) = (n_table)
  -- if $objectprops_record_at(S.OBJECTPROPS, n) = (pobjectprops)
  -- if pentry* = $property_entries(pobjectprops.SLOTS)
def $object_table_sync(S, n) = S
  -- if $object_table_at(S.OBJECTTABLES, n) = eps
def $object_table_sync_value(S, POBJECT n) = $object_table_sync(S, n)
def $object_table_sync_value(S, pvalue) = S -- otherwise

;; FE_FETCH_RW promotes its selected bucket directly, after key diagnostics.
;; A clone made since reset shares that write; this is not writable lookup.
dec $object_table_reference_slots(pstate, nat, ptbytes, nat, pobjectprops*) : pobjectprops*
def $object_table_reference_slots(S, n_table, ptbytes, n_cell, eps) = eps
def $object_table_reference_slots(S, n_table, ptbytes, n_cell, pobjectprops :: pobjectprops_tail*) = pobjectprops[.SLOTS = $property_slot_set(pobjectprops.SLOTS, ptbytes, PROP_VALUE (ALIAS n_cell))] :: $object_table_reference_slots(S, n_table, ptbytes, n_cell, pobjectprops_tail*)
  -- if $object_table_at(S.OBJECTTABLES, pobjectprops.OBJECT) = (n_table)
def $object_table_reference_slots(S, n_table, ptbytes, n_cell, pobjectprops :: pobjectprops_tail*) = pobjectprops :: $object_table_reference_slots(S, n_table, ptbytes, n_cell, pobjectprops_tail*)
  -- if $object_table_at(S.OBJECTTABLES, pobjectprops.OBJECT) =/= (n_table)
dec $object_table_reference_bucket(pstate, nat, ptbytes) : pstate
def $object_table_reference_bucket(S, n_table, ptbytes) = $reference_cell(S, n_cell)[.CELL = n_cell][.RESULT = REFERENCE n_cell]
  -- if $entry_lookup(S.ARRAYS[n_table].ITEMS, KSTRING ptbytes) = (ALIAS n_cell)
def $object_table_reference_bucket(S, n_table, ptbytes) = S_ref[.ARRAYS = $array_replace(S_ref.ARRAYS, n_table, $array_insert(S_ref.ARRAYS[n_table], KSTRING ptbytes, ALIAS n_cell))][.OBJECTPROPS = $object_table_reference_slots(S_ref, n_table, ptbytes, n_cell, S_ref.OBJECTPROPS)][.CELL = n_cell][.RESULT = REFERENCE n_cell]
  -- if $entry_lookup(S.ARRAYS[n_table].ITEMS, KSTRING ptbytes) = (DIRECT pvalue)
  -- if n_cell = |S.STORE|
  -- if S_ref = $reference_cell(S[.STORE = S.STORE ++ [DEFINED pvalue]][.ALLOCATIONS = S.ALLOCATIONS ++ [HCELL n_cell]], n_cell)

;; ZEND_CAST allocates the object before the NaN warning. A CV is a borrowed
;; zval location; preexisting references were dereferenced before dispatch.
def $object_cast_warning(S, CASTOBJECT, PFLOAT n) = $fparts_nan($float_decode(n))
def $object_cast_warning(S, pcast, pvalue) = false -- otherwise
dec $object_cast_input_cell(pstate, poperand) : nat?
def $object_cast_input_cell(S, VARIABLE ptbytes z) = $lookup(S.ENV, ptbytes)
def $object_cast_input_cell(S, REFERENCE n) = (n)
def $object_cast_input_cell(S, KNOWN pvalue) = eps
dec $object_cast_referenced(pstate, nat?) : bool
def $object_cast_referenced(S, (n)) = (n <- S.REFCELLS)
def $object_cast_referenced(S, eps) = false

dec $object_cast_input_source(pstate, pobjectcast) : bool
dec $object_cast_source(pstate, pobjectcast) : bool
def $object_cast_source(S, pobjectcast) = true
  -- if $origin_node(S.SOURCES, pobjectcast.SITE) = (NExprCastObject expression metadata)
  -- if $code_expression_at_source(S, pobjectcast.SITE, [PCFIELD 0]) = (z)
  -- if pobjectcast.LINE = $runtime_line(S[.ORIGIN = (pobjectcast.SITE)], [PCFIELD 0], expression)
  -- if $object_cast_input_source(S, pobjectcast)
def $object_cast_source(S, pobjectcast) = false -- otherwise
def $object_cast_input_source(S, pobjectcast) = true
  -- if pobjectcast.INPUT = KNOWN (PFLOAT n)
  -- if $origin_node(S.SOURCES, pobjectcast.SITE) = (NExprCastObject expression metadata)
  -- if $reference_cv(expression) = eps
  -- if $fparts_nan($float_decode(n))
  -- if pobjectcast.CELL = eps
  -- if ~pobjectcast.REFERENCED
def $object_cast_input_source(S, pobjectcast) = true
  -- if pobjectcast.INPUT = VARIABLE ptbytes z
  -- if $error_variable_source(S, (pobjectcast.SITE), [PCFIELD 0], ptbytes)
  -- if $code_expression_at_source(S, pobjectcast.SITE, [PCFIELD 0]) = (z)
  -- if pobjectcast.CELL = (n)
  -- if $(n < |S.STORE|)
def $object_cast_input_source(S, pobjectcast) = true
  -- if pobjectcast.INPUT = REFERENCE n
  -- if $origin_node(S.SOURCES, pobjectcast.SITE) = (NExprCastObject expression metadata)
  -- if $reference_cv(expression) = eps
  -- if pobjectcast.CELL = (n)
  -- if $(n < |S.STORE|)
  -- if pobjectcast.REFERENCED
  -- if n <- S.REFCELLS
  -- if (HCELL n) <- S.ALLOCATIONS
def $object_cast_input_source(S, pobjectcast) = false -- otherwise

dec $object_cast_valid(pstate, pobjectcast) : bool
def $object_cast_valid(S, pobjectcast) = true
  -- if S.OBJECTCAST = (pobjectcast)
  -- if S.ORIGIN = (pobjectcast.SITE)
  -- if $object_cast_source(S, pobjectcast)
  -- if $(pobjectcast.OBJECT < |S.OBJECTS|)
  -- if S.OBJECTS[pobjectcast.OBJECT] = STDINSTANCE
  -- if $objectprops_at(S.OBJECTPROPS, pobjectcast.OBJECT) = (eps)
  -- if (HOBJECT pobjectcast.OBJECT) <- S.ALLOCATIONS
  -- if $heap_owners($heap_prune($heap_graph(S)), HOBJECT pobjectcast.OBJECT) = 1
def $object_cast_valid(S, pobjectcast) = false -- otherwise

dec $object_cast_task_count(ptask, pobjectcast) : nat
def $object_cast_task_count(OBJECT_CAST_RESULT pobjectcast, pobjectcast) = 1
def $object_cast_task_count(ERROR_HANDLER_INVOKE perrorcall, pobjectcast) = $object_cast_task_count(perrorcall.RESUME, pobjectcast)
def $object_cast_task_count(ERROR_HANDLER_RESULT perrorcall, pobjectcast) = $object_cast_task_count(perrorcall.RESUME, pobjectcast)
def $object_cast_task_count(AT porigin ptask, pobjectcast) = $object_cast_task_count(ptask, pobjectcast)
def $object_cast_task_count(ptask, pobjectcast) = 0 -- otherwise
dec $object_cast_tasks_count(ptask*, pobjectcast) : nat
def $object_cast_tasks_count(eps, pobjectcast) = 0
def $object_cast_tasks_count(ptask :: ptask_tail*, pobjectcast) = $($object_cast_task_count(ptask, pobjectcast) + $object_cast_tasks_count(ptask_tail*, pobjectcast))
def $object_cast_scope_valid(S) = true -- if S.OBJECTCAST = eps
def $object_cast_scope_valid(S) = ($object_cast_valid(S, pobjectcast) /\ $object_cast_tasks_count(S.TODO, pobjectcast) = 1)
  -- if S.OBJECTCAST = (pobjectcast)
def $task_nodes(OBJECT_CAST_RESULT pobjectcast) = [HOBJECT pobjectcast.OBJECT] ++ $operand_nodes(pobjectcast.INPUT)
def $call_task_valid(S, OBJECT_CAST_RESULT pobjectcast) = $object_cast_valid(S, pobjectcast)
def $error_call_valid(S, perrorcall) = true
  -- if perrorcall.RESUME = OBJECT_CAST_RESULT pobjectcast
  -- if $object_cast_valid(S, pobjectcast)
  -- if perrorcall.SITE = pobjectcast.SITE
  -- if perrorcall.LEVEL = 2
  -- if perrorcall.LINE = pobjectcast.LINE
  -- if perrorcall.MESSAGE = $ptascii("unexpected NAN value was coerced to object")
  -- if perrorcall.EVENT = DIAGNOSTIC "Warning" perrorcall.MESSAGE perrorcall.LINE

dec $object_cast_after_item(pstate, pobjectcast) : pitem?
def $object_cast_after_item(S, pobjectcast) = (DIRECT (PFLOAT n))
  -- if pobjectcast.INPUT = KNOWN (PFLOAT n)
  -- if pobjectcast.CELL = eps
def $object_cast_after_item(S, pobjectcast) = (DIRECT pvalue)
  -- if pobjectcast.CELL = (n)
  -- if pobjectcast.REFERENCED
  -- if (HCELL n) <- S.ALLOCATIONS
  -- if S.STORE[n] = DEFINED pvalue
def $object_cast_after_item(S, pobjectcast) = (ALIAS n)
  -- if pobjectcast.INPUT = VARIABLE ptbytes z
  -- if pobjectcast.CELL = (n)
  -- if ~pobjectcast.REFERENCED
  -- if $lookup(S.ENV, ptbytes) = (n)
  -- if S.STORE[n] = DEFINED pvalue
  -- if n <- S.REFCELLS
def $object_cast_after_item(S, pobjectcast) = (DIRECT pvalue)
  -- if pobjectcast.INPUT = VARIABLE ptbytes z
  -- if pobjectcast.CELL = (n)
  -- if ~pobjectcast.REFERENCED
  -- if $lookup(S.ENV, ptbytes) = (n)
  -- if S.STORE[n] = DEFINED pvalue
  -- if ~(n <- S.REFCELLS)
def $object_cast_after_item(S, pobjectcast) = (UNINITIALIZED)
  -- if pobjectcast.INPUT = VARIABLE ptbytes z
  -- if ~pobjectcast.REFERENCED
  -- if pobjectcast.CELL = (n)
  -- if $lookup(S.ENV, ptbytes) =/= (n)
def $object_cast_after_item(S, pobjectcast) = eps -- otherwise

rule PhpStep/object-cast-nan: S ~> $error_dispatch(S_new[.OBJECTCAST = (pobjectcast)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], 2, $ptascii("unexpected NAN value was coerced to object"), z, DIAGNOSTIC "Warning" ($ptascii("unexpected NAN value was coerced to object")) z, OBJECT_CAST_RESULT pobjectcast)
  -- if S.TODO = (CAST_RESULT CASTOBJECT z) :: ptask_tail*
  -- if S.OBJECTCAST = eps
  -- if S_read = $resolve_at(S, S.RESULT, z)
  -- if S_read.COMPLETION = NORMAL
  -- if S_read.RESULT = KNOWN (PFLOAT n_bits)
  -- if $fparts_nan($float_decode(n_bits))
