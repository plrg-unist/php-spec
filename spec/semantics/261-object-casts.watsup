  -- if pobjectcast = {SITE porigin, LINE z, OBJECT (|S.OBJECTS|), INPUT S.RESULT, CELL $object_cast_input_cell(S, S.RESULT), REFERENCED $object_cast_referenced(S, $object_cast_input_cell(S, S.RESULT))}
  -- if $object_cast_source(S, pobjectcast)
  -- if S_new = $new_class(S_read, $ptascii("stdClass"), z)
rule PhpStep/object-cast-nan-result: S ~> $objectprops_mark(S[.OBJECTCAST = eps][.OBJECTPROPS = $objectprops_set(S.OBJECTPROPS, pobjectcast.OBJECT, [{DECL eps, NAME ($ptascii("scalar")), STATE PROP_VALUE pitem}])][.RESULT = KNOWN (POBJECT pobjectcast.OBJECT)][.BASE = BASE_VALUE (KNOWN PNULL)][.TODO = ptask_tail*], pobjectcast.OBJECT)
  -- if S.TODO = (OBJECT_CAST_RESULT pobjectcast) :: ptask_tail*
  -- if $object_cast_valid(S, pobjectcast)
  -- if $object_cast_after_item(S, pobjectcast) = (pitem)
rule PhpStep/object-cast-nan-expired: S ~> S[.OBJECTCAST = eps][.TODO = eps][.COMPLETION = UNSUPPORTED "borrowed object-cast operand lifetime"]
  -- if S.TODO = (OBJECT_CAST_RESULT pobjectcast) :: ptask_tail*
  -- if $object_cast_valid(S, pobjectcast)
  -- if $object_cast_after_item(S, pobjectcast) = eps
def $return_discard(S, OBJECT_CAST_RESULT pobjectcast) = S[.OBJECTCAST = eps]
  -- if S.OBJECTCAST = (pobjectcast)
def $error_read_discard(S, OBJECT_CAST_RESULT pobjectcast) = S[.OBJECTCAST = eps]
  -- if S.OBJECTCAST = (pobjectcast)

;; Raw IS_UNDEF can be exposed by the post-warning scalar insertion. Quiet
;; reads and hash comparison retain their own null/skip rules.
def $entry_read_value(S, UNINITIALIZED) = PUNDEFINED
def $entry_read_value(S, pitem) = $entry_value(S, pitem) -- otherwise
def $stdclass_raw_undefined(S, POBJECT n, ptbytes) = true
  -- if S.OBJECTS[n] = STDINSTANCE
  -- if $property_resolve(S, n, ptbytes) = PROPERTY_ACCESS ptbytes
  -- if $objectprops_at(S.OBJECTPROPS, n) = (ppropertyslot_all*)
  -- if $property_slot_at(ppropertyslot_all*, ptbytes) = (ppropertyslot)
  -- if ppropertyslot.STATE = PROP_VALUE UNINITIALIZED
def $stdclass_raw_undefined(S, pvalue, ptbytes) = false -- otherwise

;; Key unmangling happens after the iterator advances, but before the selected
;; bucket is copied into the value target. The bucket pointer is borrowed.
dec $object_member_tail(ptbytes, nat) : preqbytes
dec $object_member_name(ptbytes) : (preqbytes?, preqbytes)
def $object_member_name(ptbytes) = (eps, ptbytes)
  -- if ~$property_bad_name(ptbytes)
def $object_member_name(0 :: ptbytes_tail) = (($ptascii("Illegal member variable name")), 0 :: ptbytes_tail)
  -- if $(|ptbytes_tail| < 2)
def $object_member_name(0 :: ptbytes_tail) = (($ptascii("Illegal member variable name")), 0 :: ptbytes_tail)
  -- if $(|ptbytes_tail| >= 2)
  -- if ptbytes_tail[0] = 0
def $object_member_name(0 :: ptbytes_tail) = (($ptascii("Corrupt member variable name")), 0 :: ptbytes_tail)
  -- if $(|ptbytes_tail| >= 2)
  -- if ptbytes_tail[0] =/= 0
  -- if $(|$c_string(ptbytes_tail)| >= |ptbytes_tail| - 1)
def $object_member_name(0 :: ptbytes_tail) = (eps, $object_member_tail(ptbytes_tail, |$c_string(ptbytes_tail)|))
  -- if $(|ptbytes_tail| >= 2)
  -- if ptbytes_tail[0] =/= 0
  -- if $(|$c_string(ptbytes_tail)| < |ptbytes_tail| - 1)
def $object_member_tail(ptbytes, n_class) = ptbytes[n_start : n_length]
  -- if n_start = $(n_class + 1)
  -- if n_length = $(|ptbytes| - n_start)
  -- if |$c_string(ptbytes[n_start : n_length])| = n_length
def $object_member_tail(ptbytes, n_class) = ptbytes[n_start : n_length]
  -- if n_initial = $(n_class + 1)
  -- if n_initial_length = $(|ptbytes| - n_initial)
  -- if n_anon = |$c_string(ptbytes[n_initial : n_initial_length])|
  -- if $(n_anon < n_initial_length)
  -- if n_start = $(n_initial + n_anon + 1)
  -- if n_length = $(|ptbytes| - n_start)

def $object_foreach_reset(S, n) = $objectprops_mark($object_table_materialize($object_table_write(S, n), n), n)
  -- if S.OBJECTS[n] = STDINSTANCE
def $object_foreach_reset(S, n) = $objectprops_mark(S, n)
  -- if S.OBJECTS[n] =/= STDINSTANCE

dec $object_foreach_key_used(statement) : bool
def $object_foreach_key_used(NStmtForeach expression phpType5 (BOOLEAN b_ref) expression_value phpType23 (BOOLEAN false) metadata) = (phpType5 =/= ABSENT)
def $object_foreach_key_used(statement) = false -- otherwise
dec $object_foreach_notice(statement, ptbytes) : preqbytes?
def $object_foreach_notice(statement, ptbytes) = preqbytes_notice?
