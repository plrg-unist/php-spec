dec $object_foreach_task_count(ptask, nat) : nat
def $object_foreach_task_count(OBJECT_FOREACH_KEY pobjectforeach, n) = 1
  -- if pobjectforeach.ITERATOR = n
def $object_foreach_task_count(FOREACH_NEXT n pnode statement porigin? z, n) = 1
def $object_foreach_task_count(ERROR_HANDLER_INVOKE perrorcall, n) = $object_foreach_task_count(perrorcall.RESUME, n)
def $object_foreach_task_count(ERROR_HANDLER_RESULT perrorcall, n) = $object_foreach_task_count(perrorcall.RESUME, n)
def $object_foreach_task_count(AT porigin ptask, n) = $object_foreach_task_count(ptask, n)
def $object_foreach_task_count(ptask, n) = 0 -- otherwise
dec $object_foreach_tasks_count(ptask*, nat) : nat
def $object_foreach_tasks_count(eps, n) = 0
def $object_foreach_tasks_count(ptask :: ptask_tail*, n) = $($object_foreach_task_count(ptask, n) + $object_foreach_tasks_count(ptask_tail*, n))
