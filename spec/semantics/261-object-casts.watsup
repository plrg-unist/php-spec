def $object_foreach_fetch(S, n, n_object, statement, porigin?, z, ptbytes, pitem, n_next, false) = $object_foreach_deliver(S[.ORIGIN = porigin?][.ITERATORS = $iterator_set(S.ITERATORS, OBJECTITER n n_object n_next false)], n, n_object, statement, z, $property_visible_name(S, n_object, ptbytes), KNOWN $entry_read_value(S, pitem), false)
def $object_foreach_fetch(S, n, n_object, statement, porigin?, z, ptbytes, pitem, n_next, true) = $object_foreach_deliver(S[.ORIGIN = porigin?][.ITERATORS = $iterator_set(S.ITERATORS, OBJECTITER n n_object n_next true)], n, n_object, statement, z, ptbytes, KNOWN PNULL, true)
