def $object_foreach_notice(statement, ptbytes) = eps
  -- if ~$object_foreach_key_used(statement)

dec $object_foreach_deliver(pstate, nat, nat, statement, int, ptbytes, poperand, bool) : pstate
def $object_foreach_deliver(S, n, n_object, statement, z, ptbytes, poperand, b_ref) = $foreach_body(S, n, HOBJECT n_object, statement, z, KSTRING preqbytes, poperand, b_ref)
