def $ob_object_live(S, ptask, pobobjectreturn) = ($ob_object_metadata(S, ptask, pobobjectreturn) /\ $integer_standard_object_handlers(S, POBJECT pobobjectreturn.OBJECT) /\ $destructor_pending_valid(S, pobobjectreturn.PENDING))
def $ob_object_nodes(pobobjectreturn) = $ob_user_nodes(pobobjectreturn.INVOKE) ++ [HOBJECT pobobjectreturn.OBJECT] ++ $instance_roots(pobobjectreturn.PENDING)
def $ob_object_from_ref(pobrefreturn, n) = {INVOKE pobrefreturn.INVOKE, OBJECT n, CELL (pobrefreturn.CELL), RETURNED eps, PENDING pobrefreturn.PENDING, CALLER pobrefreturn.CALLER, TAIL pobrefreturn.TAIL}

