def $output_task_write(OB_USER_OBJECT_NOTICE pobobjectreturn n_cell n_pending) = $output_call_write(pobobjectreturn.INVOKE.CALL)
def $output_task_write(OB_USER_OBJECT_RELEASE pobobjectreturn poboutput) = $output_call_write(pobobjectreturn.INVOKE.CALL)
def $output_task_write(OB_USER_OBJECT_DONE pobobjectreturn poboutput) = $output_call_write(pobobjectreturn.INVOKE.CALL)
