def $ob_user_active_task(OB_USER_OBJECT_RETURN pobobjectreturn poperand) = (pobobjectreturn.INVOKE.BUFFER.ID)
def $ob_user_active_task(OB_USER_OBJECT_NOTICE pobobjectreturn n_cell n_pending) = (pobobjectreturn.INVOKE.BUFFER.ID)
def $ob_user_active_task(OB_USER_OBJECT_RELEASE pobobjectreturn poboutput) = (pobobjectreturn.INVOKE.BUFFER.ID)
def $ob_user_active_task(OB_USER_OBJECT_DONE pobobjectreturn poboutput) = (pobobjectreturn.INVOKE.BUFFER.ID)
def $ob_user_active_task(OB_USER_OBJECT_COMMIT pobobjectreturn poboutput) = (pobobjectreturn.INVOKE.BUFFER.ID)
def $ob_user_disabled_task(OB_USER_OBJECT_DEPRECATED pobobjectreturn, n) = (pobobjectreturn.INVOKE.BUFFER.ID = n)
def $output_task_write(OB_USER_REF_OBJECT pobrefreturn n) = $output_call_write(pobrefreturn.INVOKE.CALL)
def $output_task_write(OB_USER_OBJECT_DEPRECATED pobobjectreturn) = $output_call_write(pobobjectreturn.INVOKE.CALL)
def $output_task_write(OB_USER_OBJECT_CAST pobobjectreturn) = $output_call_write(pobobjectreturn.INVOKE.CALL)
def $output_task_write(OB_USER_OBJECT_SKIP pobobjectreturn) = $output_call_write(pobobjectreturn.INVOKE.CALL)
