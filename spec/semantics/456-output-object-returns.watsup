def $ob_user_resume_api(OB_USER_OBJECT_DEPRECATED pobobjectreturn) = $ob_call_api(pobobjectreturn.INVOKE.CALL)

def $call_task_valid(S, OB_USER_REF_OBJECT pobrefreturn n) = ($ob_ref_valid(S, OB_USER_REF_OBJECT pobrefreturn n, pobrefreturn, true) /\ S.STORE[pobrefreturn.CELL] = DEFINED (POBJECT n) /\ $integer_standard_object_handlers(S, POBJECT n) /\ $long_and(poutputbuffer.FLAGS, 40960) = 0)
  -- if $output_selected(S, pobrefreturn.INVOKE) = (poutputbuffer)
def $call_task_valid(S, OB_USER_OBJECT_DEPRECATED pobobjectreturn) = ($ob_object_live(S, OB_USER_OBJECT_DEPRECATED pobobjectreturn, pobobjectreturn) /\ pobobjectreturn.PENDING = eps /\ $ob_user_temporary(S, poutputbuffer.ID) /\ $long_and(poutputbuffer.FLAGS, 40960) = 8192)
  -- if $output_selected(S, pobobjectreturn.INVOKE) = (poutputbuffer)
def $call_task_valid(S, OB_USER_OBJECT_CAST pobobjectreturn) = ($ob_object_live(S, OB_USER_OBJECT_CAST pobobjectreturn, pobobjectreturn) /\ $long_and(poutputbuffer.FLAGS, 40960) = 0)
  -- if $output_selected(S, pobobjectreturn.INVOKE) = (poutputbuffer)
def $call_task_valid(S, OB_USER_OBJECT_STRING pobobjectreturn) = ($ob_object_live(S, OB_USER_OBJECT_STRING pobobjectreturn, pobobjectreturn) /\ $ob_object_string_owner(S, pobobjectreturn) /\ pobobjectreturn.PENDING = eps /\ pobobjectreturn.RETURNED = eps /\ ~$ob_user_disabled(poutputbuffer))
  -- if $output_selected(S, pobobjectreturn.INVOKE) = (poutputbuffer)
def $call_task_valid(S, OB_USER_OBJECT_SKIP pobobjectreturn) = ($ob_object_live(S, OB_USER_OBJECT_SKIP pobobjectreturn, pobobjectreturn) /\ pobobjectreturn.PENDING =/= eps /\ pobobjectreturn.RETURNED = eps /\ $stringable_instance(S, pobobjectreturn.OBJECT) /\ ~$ob_user_disabled(poutputbuffer))
  -- if $output_selected(S, pobobjectreturn.INVOKE) = (poutputbuffer)
def $call_task_valid(S, OB_USER_OBJECT_RETURN pobobjectreturn poperand) = ($ob_object_live(S, OB_USER_OBJECT_RETURN pobobjectreturn poperand, pobobjectreturn) /\ pobobjectreturn.RETURNED = (poperand) /\ $ob_object_normal_operand(S, poperand) /\ ~$ob_user_disabled(poutputbuffer))
