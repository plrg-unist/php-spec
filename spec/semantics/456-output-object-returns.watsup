def $ob_normal_value(S, POBJECT n) = $integer_standard_object_handlers(S, POBJECT n)
def $ob_object_current(S, pobobjectreturn) = (S.CURRENT = pobobjectreturn.CALLER /\ S.ORIGIN = ($ob_call_site(pobobjectreturn.INVOKE.CALL)))
def $ob_object_metadata(S, ptask, pobobjectreturn) = true
  -- if $ob_return_context(S, ptask, pobobjectreturn.CALLER, $ob_call_site(pobobjectreturn.INVOKE.CALL), pobobjectreturn.TAIL)
  -- if S_scope = S[.CURRENT = pobobjectreturn.CALLER][.ORIGIN = ($ob_call_site(pobobjectreturn.INVOKE.CALL))][.TODO = (OB_USER_RESULT pobobjectreturn.INVOKE) :: pobobjectreturn.TAIL]
  -- if $call_task_valid(S_scope, OB_USER_RESULT pobobjectreturn.INVOKE)
def $ob_object_metadata(S, ptask, pobobjectreturn) = false -- otherwise
def $ob_object_live(S, ptask, pobobjectreturn) = ($ob_object_metadata(S, ptask, pobobjectreturn) /\ $integer_standard_object_handlers(S, POBJECT pobobjectreturn.OBJECT) /\ $destructor_pending_valid(S, pobobjectreturn.PENDING))
def $ob_object_nodes(pobobjectreturn) = $ob_user_nodes(pobobjectreturn.INVOKE) ++ [HOBJECT pobobjectreturn.OBJECT] ++ $instance_roots(pobobjectreturn.PENDING)
def $ob_object_from_ref(pobrefreturn, n) = {INVOKE pobrefreturn.INVOKE, OBJECT n, CELL (pobrefreturn.CELL), RETURNED eps, PENDING pobrefreturn.PENDING, CALLER pobrefreturn.CALLER, TAIL pobrefreturn.TAIL, SOURCE eps}

def $task_nodes(OB_USER_REF_OBJECT pobrefreturn n) = $ob_ref_nodes(pobrefreturn)
def $task_nodes(OB_USER_OBJECT_DEPRECATED pobobjectreturn) = $ob_object_nodes(pobobjectreturn)
def $task_nodes(OB_USER_OBJECT_CAST pobobjectreturn) = $ob_object_nodes(pobobjectreturn)
def $task_nodes(OB_USER_OBJECT_SKIP pobobjectreturn) = $ob_object_nodes(pobobjectreturn) ++ [HOBJECT pobobjectreturn.OBJECT]
;; STRINGIFY_RESULT owns the actual RV; CALL_ARGS/current receiver represents
;; the additional native cast guard. This consumer only owns the saved FCI.
def $task_nodes(OB_USER_OBJECT_STRING pobobjectreturn) = $ob_user_nodes(pobobjectreturn.INVOKE)
def $task_nodes(OB_USER_OBJECT_NORMAL pobobjectreturn pdestructionframe) = eps
def $task_nodes(OB_USER_OBJECT_PENDING pobobjectreturn pdestructionframe) = $operand_nodes(pdestructionframe.VALUE) ++ $instance_roots(pdestructionframe.PENDING)
def $task_nodes(OB_USER_OBJECT_RETURN pobobjectreturn poperand) = $ob_object_nodes(pobobjectreturn) ++ $operand_nodes(poperand)
def $task_nodes(OB_USER_OBJECT_NOTICE pobobjectreturn n_cell n_pending) = $ob_object_nodes(pobobjectreturn) ++ [HCELL n_cell]
def $task_nodes(OB_USER_OBJECT_RELEASE pobobjectreturn poboutput) = $ob_object_nodes(pobobjectreturn) ++ $value_nodes(poboutput.VALUE)
def $task_nodes(OB_USER_OBJECT_DONE pobobjectreturn poboutput) = $ob_user_nodes(pobobjectreturn.INVOKE) ++ $value_nodes(poboutput.VALUE)
def $task_nodes(OB_USER_OBJECT_COMMIT pobobjectreturn poboutput) = $ob_user_nodes(pobobjectreturn.INVOKE) ++ $value_nodes(poboutput.VALUE) ++ $instance_roots(pobobjectreturn.PENDING)
def $ob_user_active_task(OB_USER_REF_OBJECT pobrefreturn n) = (pobrefreturn.INVOKE.BUFFER.ID)
def $ob_user_active_task(OB_USER_OBJECT_DEPRECATED pobobjectreturn) = (pobobjectreturn.INVOKE.BUFFER.ID)
def $ob_user_active_task(OB_USER_OBJECT_CAST pobobjectreturn) = (pobobjectreturn.INVOKE.BUFFER.ID)
def $ob_user_active_task(OB_USER_OBJECT_SKIP pobobjectreturn) = (pobobjectreturn.INVOKE.BUFFER.ID)
