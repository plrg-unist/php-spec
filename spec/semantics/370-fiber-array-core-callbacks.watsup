def $fiber_raw_core_call(S, pfiberapi) = eps -- otherwise
def $fiber_api_valid(S, pfiberapi) = true -- if $fiber_raw_core_call(S, pfiberapi) =/= eps
def $fiber_caller_api_trace(S, pfiberapi) = $config_trace_frames(S, pconfigcall, $trace_extra(S, $getclass_trace_operands(pconfigcall.SENT)))
  -- if $fiber_raw_core_call(S, pfiberapi) = (pconfigcall)
def $fiber_api_valid(S, pfiberapi) = true
  -- if S.TODO = [GC_WORKER_PUBLIC pfiberapi]
