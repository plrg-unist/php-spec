  -- if pfiberapi.SENT = $fiber_config_sent(pconfigcall)
def $fiber_raw_core_call(S, pfiberapi) = (pconfigcall)
  -- if $(pfiberapi.SEQUENCE > 0) /\ $(pfiberapi.SEQUENCE < S.FIBERSEQ)
  -- if $fiber_at(S, pfiberapi.OBJECT) =/= eps
  -- if S.TODO = (FIBER_WAIT pfiberapi) :: (FIBER_CORE_RESULT n_runner pconfigcall) :: ptask_tail*
  -- if ptask_tail* = [FIBER_FINISH n_runner]
