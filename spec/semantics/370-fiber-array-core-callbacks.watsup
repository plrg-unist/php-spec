  -- if $fiber_api_valid(S_outer, pfibercaller.API)
def $fiber_raw_outer_valid(S, n_runner) = false -- otherwise
def $fiber_core_site_valid(S, pconfigcall) = ($fiber_raw_cached_valid(S, pfiber) /\ $fiber_raw_receiver_live(S, pfiberrawapi) /\ $fiber_raw_outer_valid(S, n_runner) /\ ($fiber_method_site(S, pconfigcall.SITE, eps) \/ $fiber_capture_call_site(S, pconfigcall.SITE)))
  -- if S.ACTIVEFIBER = (n_runner)
  -- if $fiber_at(S, n_runner) = (pfiber)
  -- if pfiber.TARGET = (FIBER_ARRAY_TARGET pfiberrawapi)

;; During resume/throw the C handler owns the copied transfer value, while
;; its bound receiver remains borrowed from the cached callback selection.
def $fiber_caller_api_nodes(pfibercaller) = $fiber_value_nodes(pfiberapi.SENT)
  -- if pfiberapi = pfibercaller.API
  -- if pfibercaller.VM.TODO = (FIBER_WAIT pfiberapi) :: (FIBER_CORE_RESULT n_runner pconfigcall) :: ptask_tail*
