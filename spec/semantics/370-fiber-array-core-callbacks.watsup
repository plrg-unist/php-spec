;; Fiber retains the raw callback array. Its function cache borrows the
;; selected receiver, even after reference members select different values.
dec $fiber_raw_target(pstate, pvalue) : pfiberrawapi?
dec $fiber_raw_cached_valid(pstate, pfiber) : bool
dec $fiber_raw_input_valid(pvalue, pfiberrawapi) : bool
dec $fiber_raw_receiver_live(pstate, pfiberrawapi) : bool
dec $fiber_raw_owner(pfiberrawapi, nat) : nat?
dec $fiber_raw_outer_valid(pstate, nat) : bool
dec $fiber_raw_core_call(pstate, pfiberapi) : pconfigcall?

def $fiber_raw_target(S, pvalue) = (pfiberrawapi)
  -- if pvalue = PARRAY n
  -- if $fiber_factory_candidate(S, pvalue)
  -- if pentry* = $fiber_factory_items(S, pvalue)
  -- if $fiber_factory_selection(S, pvalue, pentry*) = ((pintrinsic, ptbytes, n_input?))
  -- if pfiberrawapi = {ITEMS pentry*, KIND pintrinsic, NAME ptbytes, INPUT n_input?}
def $fiber_raw_target(S, pvalue) = eps -- otherwise
def $fiber_callback_resolution(S, pvalue) = HANDLERRESOLVED (FIBER_ARRAY_TARGET pfiberrawapi)
  -- if $fiber_raw_target(S, pvalue) = (pfiberrawapi)
def $fiber_core_callback_target(FIBER_ARRAY_TARGET pfiberrawapi) = true
def $fiber_callable_target_tag(FIBER_ARRAY_TARGET pfiberrawapi) = true
def $target_nodes(FIBER_ARRAY_TARGET pfiberrawapi) = eps
def $fiber_receive_value(S, pconfigcall, pvalue) = $fiber_done($fiber_put(S_birth, n, pfiber[.READY = true][.CALL = (pconfigcall)][.RAW = pvalue][.TARGET = (FIBER_ARRAY_TARGET pfiberrawapi)][.BIRTH = $dynamic_new_find(S, S.TODO, pconfigcall.SITE)][.CAPTURE = $consumer_capture_current(S, pconfigcall.SITE)][.PRODUCER = $consumer_producer_current(S)]), PNULL)
  -- if pconfigcall.KIND = INTRINSIC_FIBER_CONSTRUCT
  -- if $fiber_raw_target(S, pvalue) = (pfiberrawapi)
  -- if pconfigcall.OWNER = (n)
  -- if $fiber_at(S, n) = (pfiber)
  -- if ~pfiber.READY
  -- if S_birth = $consumer_clone_birth_record(S, pconfigcall, n)

;; The completed constructor CALL authenticates RAW. Frozen ITEMS, rather
;; than the current array/reference cells, authenticate its selected cache.
def $fiber_raw_cached_valid(S, pfiber) = true
  -- if pfiber.RAW = PARRAY n
  -- if pfiber.TARGET = (FIBER_ARRAY_TARGET pfiberrawapi)
  -- if $fiber_factory_members(S, pfiber.RAW, pfiberrawapi.ITEMS) = ((pvalue_receiver, pfiberrawapi.NAME))
  -- if $fiber_factory_receiver(S, pvalue_receiver)
  -- if ~$typed_callable_method(pfiberrawapi.NAME, false, false)
  -- if $fiber_factory_method(pfiberrawapi.NAME) = (pfiberrawapi.KIND)
  -- if $fiber_raw_input_valid(pvalue_receiver, pfiberrawapi)
def $fiber_raw_cached_valid(S, pfiber) = false -- otherwise
def $fiber_raw_input_valid(PSTRING ptbytes, pfiberrawapi) = (pfiberrawapi.INPUT = eps /\ $fiber_static(pfiberrawapi.KIND))
def $fiber_raw_input_valid(POBJECT n_input, pfiberrawapi) = (pfiberrawapi.INPUT = (n_input))
def $fiber_raw_input_valid(pvalue, pfiberrawapi) = false -- otherwise
def $fiber_cached_target_valid(S, pfiber) = true -- if $fiber_raw_cached_valid(S, pfiber)
def $fiber_raw_receiver_live(S, pfiberrawapi) = true -- if $fiber_static(pfiberrawapi.KIND)
def $fiber_raw_receiver_live(S, pfiberrawapi) = true
  -- if ~$fiber_static(pfiberrawapi.KIND)
  -- if pfiberrawapi.INPUT = (n_input)
  -- if $fiber_at(S, n_input) =/= eps
def $fiber_raw_receiver_live(S, pfiberrawapi) = false -- otherwise
def $fiber_raw_owner(pfiberrawapi, n_runner) = (n_runner) -- if $fiber_static(pfiberrawapi.KIND)
def $fiber_raw_owner(pfiberrawapi, n_runner) = pfiberrawapi.INPUT -- if ~$fiber_static(pfiberrawapi.KIND)

;; SELECTION names the genuine runner, not a Closure or a selected-call nonce.
;; The existing borrowed Fiber tag keeps CONFIG's copied arguments as its
;; only roots; FIBER_CORE_RESULT introduces no extra function_name owner.
def $fiber_core_binding(S, pfiber) = (n_owner?, n_selection?)
  -- if pfiber.TARGET = (FIBER_ARRAY_TARGET pfiberrawapi)
  -- if $fiber_raw_cached_valid(S, pfiber)
  -- if pfiber.CALL = (pconfigcall)
  -- if pconfigcall.OWNER = (n_runner)
  -- if n_owner? = $fiber_raw_owner(pfiberrawapi, n_runner)
  -- if n_selection? = (n_runner)
def $fiber_core_callback_kind(S, pfiber) = (pfiberrawapi.KIND)
  -- if pfiber.TARGET = (FIBER_ARRAY_TARGET pfiberrawapi)
  -- if $fiber_raw_cached_valid(S, pfiber)
  -- if $fiber_kind(pfiberrawapi.KIND)
def $fiber_core_result_task(S, n_runner, pfiber, pconfigcall) = FIBER_CORE_RESULT n_runner pconfigcall
  -- if pfiber.TARGET = (FIBER_ARRAY_TARGET pfiberrawapi)
  -- if $fiber_raw_cached_valid(S, pfiber)
  -- if $fiber_kind(pfiberrawapi.KIND)

def $fiber_raw_outer_valid(S, n_runner) = true
  -- if S.FIBERCALLERS = eps
  -- if $fiber_at(S, n_runner) = (pfiber)
  -- if pfiber.STATUS = FIBER_SUSPENDED
def $fiber_raw_outer_valid(S, n_runner) = true
  -- if S.FIBERCALLERS = pfibercaller :: pfibercaller_tail*
  -- if pfibercaller.OBJECT = n_runner /\ pfibercaller.API.OBJECT = n_runner
