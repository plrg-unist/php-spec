;; Discard the companion before the next public integrity check. Callback
;; exceptions retain their identity; ordinary live-write errors get this same
;; atomic tail when152 reconstructs the predecessor's pending continuation.
def $return_discard(S, STATIC_STRING_RESULT pstaticstring) = S[.TODO = ptask_unwind :: ptask_tail*]
