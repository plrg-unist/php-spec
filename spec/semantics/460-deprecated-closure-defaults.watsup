def $parameter_closure_bind_task(DEFAULT_BIND porigin n) = ((porigin, n))
def $parameter_closure_bind_task(NAMED_DEFAULT_BIND porigin n) = ((porigin, n))
def $parameter_closure_bind_task(ptask) = eps -- otherwise
