;; INIT_METHOD_CALL/static selects the function from an initialized string CV
;; before argument effects. The actual target/CALLS retains that function;
;; the mutable name CV is neither reread nor retained as an owner.
dec $parameter_cv_method_site(pstate, porigin) : bool
def $parameter_cv_method_site(S, porigin) = true
  -- if $origin_node(S.SOURCES, porigin) = (NExprMethodCall expression (NExprVariable phpType32 metadata_name) (SEQUENCE phpType7*) metadata)
  -- if $cv_name(phpType32) = (ptbytes)
  -- if ~$direct_this(phpType32) /\ ~$ppfirstclass(phpType7*)
def $parameter_cv_method_site(S, porigin) = true
  -- if $origin_node(S.SOURCES, porigin) = (NExprStaticCall name (NExprVariable phpType32 metadata_name) (SEQUENCE phpType7*) metadata)
  -- if $cv_name(phpType32) = (ptbytes)
  -- if ~$direct_this(phpType32) /\ ~$ppfirstclass(phpType7*)
def $parameter_cv_method_site(S, porigin) = false -- otherwise

;; Only ordinary selected method targets supply this entry authority.
dec $parameter_cv_method_selected(pstate, pcalltarget, porigin) : bool
def $parameter_cv_method_selected(S, METHOD_TARGET n porigin, porigin_site) = $method_call_selected(S, METHOD_TARGET n porigin, (porigin_site))
def $parameter_cv_method_selected(S, STATIC_METHOD_TARGET porigin_class porigin, porigin_site) = $method_call_selected(S, STATIC_METHOD_TARGET porigin_class porigin, (porigin_site))
def $parameter_cv_method_selected(S, SCOPED_TARGET porigin_requested porigin porigin_called n_receiver? poperand, porigin_site) = $scoped_call_selected(S, SCOPED_TARGET porigin_requested porigin porigin_called n_receiver? poperand, porigin_site)
def $parameter_cv_method_selected(S, pcalltarget, porigin) = false -- otherwise
dec $parameter_cv_method_current(pstate, pfunction) : bool
def $parameter_cv_method_current(S, pfunction) = true
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.FUNCTION = pfunction.ORIGIN /\ pcallcontext.NAME = pfunction.NAME
  -- if pcallcontext.CALLSITE = (porigin_site)
  -- if $parameter_cv_method_site(S, porigin_site)
  -- if $parameter_method_source(S, pfunction) = (pmethoddesc)
  -- if pmethoddesc.VISIBILITY = PROPERTY_PUBLIC
  -- if pcallcontext.INSTANCE = eps /\ pcallcontext.WRAPPER = eps /\ pcallcontext.CACHE = eps
  -- if $target_function(S, pcallcontext.TARGET) = (pfunction)
  -- if pcallcontext.RECEIVER = $target_receiver(S, pcallcontext.TARGET)
  -- if pcallcontext.LEXICAL_CLASS = (pmethoddesc.OWNER)
  -- if pcallcontext.CALLED_CLASS = $target_called_class(S, pcallcontext.TARGET)
  -- if $parameter_cv_method_selected(S, pcallcontext.TARGET, porigin_site)
def $parameter_cv_method_current(S, pfunction) = false -- otherwise
def $parameter_method_current_valid(S, pfunction) = $parameter_cv_method_current(S, pfunction)
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.CALLSITE = (porigin_site)
  -- if $parameter_cv_method_site(S, porigin_site)

