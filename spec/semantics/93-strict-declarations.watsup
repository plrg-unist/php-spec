  -- if $origin_accepts(S.SOURCES, porigin, STMT (NStmtDeclare (SEQUENCE phpType49*) phpType47 metadata))
def $unknown_declare_valid(S, statement) = false -- otherwise

rule PhpStep/unknown-declare: S ~> S[.TODO = ptask_tail*]
