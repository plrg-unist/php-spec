  -- if $fiber_factory_members(S, PARRAY n, $fiber_factory_items(S, PARRAY n)) = ((pvalue, ptbytes))
  -- if $fiber_factory_method(ptbytes) = eps
def $fiber_array_capture_new(S, n, porigin, z_init, z_convert) = $throw_scalar(S, "Error", $ptascii("Non-static method Fiber::") ++ $fiber_method_name(pintrinsic) ++ $ptascii("() cannot be called statically"), z_init)
