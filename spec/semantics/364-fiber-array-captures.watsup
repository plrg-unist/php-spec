def $fiber_array_capture_source_valid(S, pfiberarray) = false -- otherwise
def $fiber_array_at_site(FIBER_ARRAY_CONVERT pfiberarray, porigin) = (pfiberarray.SITE = porigin)
def $fiber_array_convert_valid(S, pfiberarray) = true
