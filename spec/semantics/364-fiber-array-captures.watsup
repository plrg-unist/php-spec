def $fiber_array_convert_valid(S, pfiberarray) = false -- otherwise
def $task_nodes(FIBER_ARRAY_CONVERT pfiberarray) = $exit_owner_nodes($fiber_array_owner(pfiberarray))
def $call_task_valid(S, FIBER_ARRAY_CONVERT pfiberarray) = $fiber_array_convert_valid(S, pfiberarray)
def $fiber_marker(FIBER_ARRAY_CONVERT pfiberarray) = true
def $generator_internal_task(FIBER_ARRAY_CONVERT pfiberarray) = true
rule PhpStep/fiber-array-convert: S ~> S[.TODO = ptask_tail*][.OBJECTS = S.OBJECTS ++ [FIBERAPICLOSURE pfibercapture]][.ALLOCATIONS = S.ALLOCATIONS ++ [HOBJECT n]][.RESULT = KNOWN (POBJECT n)][.BASE = BASE_VALUE (KNOWN PNULL)]
