  -- if $fiber_factory_method(ptbytes) = (pintrinsic)
  -- if ~$fiber_static(pintrinsic)
def $fiber_array_capture_new(S, n, porigin, z_init, z_convert) = S[.TODO = (FIBER_ARRAY_CONVERT pfiberarray) :: S.TODO][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if pentry* = $fiber_factory_items(S, PARRAY n)
