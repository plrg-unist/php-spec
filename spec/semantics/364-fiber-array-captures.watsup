;; Array FCC selection has its own durable source witness. The temporary
;; convert task owns EX(This); the resulting Closure replaces that owner.
dec $fiber_array_capture_new(pstate, nat, porigin, int, int) : pstate
dec $fiber_array_capture_source_valid(pstate, pfiberarray) : bool
dec $fiber_array_convert_valid(pstate, pfiberarray) : bool

def $array_firstclass_value(S, n, PORIGIN n_unit pcpath, z_init) = $fiber_array_capture_new(S, n, PORIGIN n_unit pcpath, z_init, z_convert)
