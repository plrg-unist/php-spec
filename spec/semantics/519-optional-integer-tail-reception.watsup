;; Literal optional tails borrow the existing indexed mixed-mode receive.
;; Named extent includes default holes; only NAMED_SENT grants supplied authority.
dec $lossy_optional_integer_tail(pstate, pfunction, psparam*, nat) : bool
def $lossy_optional_integer_tail(S, pfunction, eps, n) = true
def $lossy_optional_integer_tail(S, pfunction, psparam :: psparam_tail*, n) = true
  -- if ~psparam.REQUIRED /\ ~psparam.VARIADIC /\ $ptmasks(psparam.TYPE) = ["int"]
  -- if psparam.DEFAULT = PSDEFAULT (NScalarInt (INTEGER i) metadata_default) "int"
  -- if $default_parameter_origin(S, pfunction.ORIGIN, n) = PORIGIN n_unit pcpath_parameter
  -- if porigin_default = PORIGIN n_unit (pcpath_parameter ++ [PCFIELD 6])
  -- if $origin_node(S.SOURCES, porigin_default) = (NScalarInt (INTEGER i) metadata_default)
  -- if $default_at(pfunction.DEFAULTS, n) = ({INDEX n, ORIGIN porigin_default, KIND PDSTORED})
  -- if $compiled_read(S, porigin_default) = (PINT i)
  -- if $lossy_optional_integer_tail(S, pfunction, psparam_tail*, $(n + 1))
def $lossy_optional_integer_tail(S, pfunction, psparam*, n) = false -- otherwise

dec $lossy_optional_integer_header(pstate, pfunction, psparam*, nat) : bool
def $lossy_optional_integer_header(S, pfunction, psparam :: psparam_tail*, n) = $lossy_optional_integer_header(S, pfunction, psparam_tail*, $(n + 1))
  -- if psparam.REQUIRED /\ psparam.DEFAULT = PSNONE /\ ~psparam.VARIADIC /\ $ptmasks(psparam.TYPE) = ["int"]
def $lossy_optional_integer_header(S, pfunction, psparam :: psparam_tail*, n) = $lossy_optional_integer_tail(S, pfunction, psparam :: psparam_tail*, n)
  -- if ~psparam.REQUIRED
def $lossy_optional_integer_header(S, pfunction, psparam*, n) = false -- otherwise

dec $lossy_optional_integer_mode(psparam*, bool) : bool
def $lossy_optional_integer_mode(eps, b) = false
def $lossy_optional_integer_mode(psparam :: psparam_tail*, b) = (psparam.BYREF = b \/ $lossy_optional_integer_mode(psparam_tail*, b))

