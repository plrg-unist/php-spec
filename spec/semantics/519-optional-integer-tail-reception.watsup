;; The stored projection also serves compile-time DIM folding. Deferred defaults
;; need an independent runtime-quiet domain; this conservative one excludes DIM.
dec $lossy_optional_integer_quiet_shape(expression) : bool
dec $lossy_optional_integer_quiet_optional(phpType5) : bool
def $lossy_optional_integer_quiet_shape(NScalarInt (INTEGER i) metadata) = true
def $lossy_optional_integer_quiet_shape(NScalarFloat (FLOAT text) metadata) = true
def $lossy_optional_integer_quiet_shape(NScalarString (BYTES text) metadata) = true
def $lossy_optional_integer_quiet_shape(NExprConstFetch name metadata) = true
def $lossy_optional_integer_quiet_shape(expression) = $lossy_optional_integer_quiet_shape(expression_child)
  -- if $pfshape(expression) = PFUNARY punary expression_child
  -- if punary <- [POSITIVE, NEGATIVE]
def $lossy_optional_integer_quiet_shape(expression) = $lossy_optional_integer_quiet_shape(expression_child)
  -- if $pfshape(expression) = PFNOT expression_child
def $lossy_optional_integer_quiet_shape(expression) = $lossy_optional_integer_quiet_shape(expression_child)
  -- if $pfshape(expression) = PFBITNOT expression_child
def $lossy_optional_integer_quiet_shape(expression) = $lossy_optional_integer_quiet_shape(expression_child)
  -- if $pfshape(expression) = PFCAST pcast expression_child
  -- if pcast <- [CASTINT, CASTFLOAT, CASTBOOL, CASTSTRING]
def $lossy_optional_integer_quiet_shape(expression) = ($lossy_optional_integer_quiet_shape(expression_left) /\ $lossy_optional_integer_quiet_shape(expression_right))
  -- if $pfshape(expression) = PFBINARY pbin expression_left expression_right
  -- if pbin <- [ADD, SUBTRACT, MULTIPLY, DIVIDE, MODULO, SHIFTLEFT, SHIFTRIGHT, BITAND, BITOR, BITXOR, POWER, LOGICALXOR, EQUAL, NOTEQUAL, IDENTICAL, NOTIDENTICAL, LESS, LESSEQUAL, GREATER, GREATEREQUAL, SPACESHIP]
def $lossy_optional_integer_quiet_shape(expression) = ($lossy_optional_integer_quiet_shape(expression_left) /\ $lossy_optional_integer_quiet_shape(expression_right))
  -- if $pfshape(expression) = PFSHORT b expression_left expression_right
def $lossy_optional_integer_quiet_shape(NExprBinaryOpConcat expression_left expression_right metadata) = ($lossy_optional_integer_quiet_shape(expression_left) /\ $lossy_optional_integer_quiet_shape(expression_right))
def $lossy_optional_integer_quiet_shape(NExprBinaryOpCoalesce expression_left expression_right metadata) = ($lossy_optional_integer_quiet_shape(expression_left) /\ $lossy_optional_integer_quiet_shape(expression_right))
def $lossy_optional_integer_quiet_shape(NExprTernary expression_cond phpType5 expression_false metadata) = ($lossy_optional_integer_quiet_shape(expression_cond) /\ $lossy_optional_integer_quiet_optional(phpType5) /\ $lossy_optional_integer_quiet_shape(expression_false))
def $lossy_optional_integer_quiet_shape(expression) = false -- otherwise
def $lossy_optional_integer_quiet_optional(ABSENT) = true
def $lossy_optional_integer_quiet_optional(expression) = $lossy_optional_integer_quiet_shape(expression)

;; Folded special names can have a pool fact without an executable child read.
;; Every other name must retain its unique actual compiled resolution. Missing
;; records, including pruned names, conservatively refuse this certificate.
dec $lossy_optional_integer_deferred_bindings(pstate, plenv, porigin) : bool
dec $lossy_optional_integer_deferred_children(pstate, plenv, nat, pcoccurrence*) : bool
def $lossy_optional_integer_deferred_bindings(S, plenv, PORIGIN n pcpath) = true
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (NExprConstFetch name metadata)
  -- if $pool_value(S.POOLS, PORIGIN n pcpath) = (pvalue)
  -- if $lossy_optional_integer_special(plenv, NExprConstFetch name metadata) = (pvalue)
def $lossy_optional_integer_deferred_bindings(S, plenv, PORIGIN n pcpath) = true
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (NExprConstFetch name metadata)
  -- if $pool_value(S.POOLS, PORIGIN n pcpath) = eps
  -- if $pnresolve(plenv, PLCONSTANT, name) = PNRESOLVED pnreference
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $call_name_count(pcode.NAMES, pcpath) = 1
  -- if $code_name(pcode.NAMES, pcpath) = ((pnreference.RESOLVED, pnreference.FALLBACK))
def $lossy_optional_integer_deferred_bindings(S, plenv, PORIGIN n pcpath) = $lossy_optional_integer_deferred_children(S, plenv, n, $pcchildren(pcnode, pcpath))
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (pcnode)
  -- if ~$parameter_default_const_fetch(pcnode)
def $lossy_optional_integer_deferred_bindings(S, plenv, porigin) = false -- otherwise
def $lossy_optional_integer_deferred_children(S, plenv, n, eps) = true
def $lossy_optional_integer_deferred_children(S, plenv, n, (PCOCCURRENCE pcpath pcnode) :: pcoccurrence*) = ($lossy_optional_integer_deferred_bindings(S, plenv, PORIGIN n pcpath) /\ $lossy_optional_integer_deferred_children(S, plenv, n, pcoccurrence*))

