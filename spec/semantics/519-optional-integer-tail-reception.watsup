;; Finite integer operator and selection trees borrow the indexed receive.
;; Named extent includes default holes; only NAMED_SENT grants supplied authority.
;; Production uses the declaration ENV; the old projection wraps an empty ENV.
dec $lossy_optional_integer_default(expression) : int?
dec $lossy_optional_integer_default_in(plenv, expression) : int?
dec $lossy_optional_integer_special(plenv, expression) : pvalue?
dec $lossy_optional_integer_condition(plenv, expression) : bool?

def $lossy_optional_integer_default(expression) = $lossy_optional_integer_default_in($plempty(false), expression)
def $lossy_optional_integer_special(plenv, NExprConstFetch name metadata) = $special_constant($pnfoldname(pnreference))
  -- if $pnresolve(plenv, PLCONSTANT, name) = PNRESOLVED pnreference
def $lossy_optional_integer_special(plenv, expression) = eps -- otherwise
def $lossy_optional_integer_condition(plenv, expression) = (b)
  -- if $lossy_optional_integer_special(plenv, expression) = (PBOOL b)
def $lossy_optional_integer_condition(plenv, expression) = (false)
  -- if $lossy_optional_integer_special(plenv, expression) = (PNULL)
def $lossy_optional_integer_condition(plenv, expression) = (~b)
  -- if $pfshape(expression) = PFNOT expression_child
  -- if $lossy_optional_integer_condition(plenv, expression_child) = (b)
def $lossy_optional_integer_condition(plenv, expression) = (b_or)
  -- if $pfshape(expression) = PFSHORT b_or expression_left expression_right
  -- if $lossy_optional_integer_condition(plenv, expression_left) = (b_or)
def $lossy_optional_integer_condition(plenv, expression) = (b_right)
  -- if $pfshape(expression) = PFSHORT b_or expression_left expression_right
  -- if $lossy_optional_integer_condition(plenv, expression_left) = (b_left)
  -- if b_left =/= b_or
  -- if $lossy_optional_integer_condition(plenv, expression_right) = (b_right)
def $lossy_optional_integer_condition(plenv, expression) = (b_left =/= b_right)
  -- if $pfshape(expression) = PFBINARY LOGICALXOR expression_left expression_right
  -- if $lossy_optional_integer_condition(plenv, expression_left) = (b_left)
  -- if $lossy_optional_integer_condition(plenv, expression_right) = (b_right)
def $lossy_optional_integer_condition(plenv, expression) = (b)
  -- if $lossy_optional_integer_default_in(plenv, expression) = (i)
  -- if $long_range(i)
  -- if b = (i =/= 0)
def $lossy_optional_integer_condition(plenv, expression) = eps -- otherwise

def $lossy_optional_integer_default_in(plenv, NExprBinaryOpPlus expression_left expression_right metadata) = (i)
  -- if $lossy_optional_integer_default_in(plenv, expression_left) = (i_left)
  -- if $lossy_optional_integer_default_in(plenv, expression_right) = (i_right)
  -- if $long_range(i_left) /\ $long_range(i_right)
  -- if i = $(i_left + i_right)
  -- if $long_range(i)
def $lossy_optional_integer_default_in(plenv, NExprBinaryOpMinus expression_left expression_right metadata) = (i)
  -- if $lossy_optional_integer_default_in(plenv, expression_left) = (i_left)
  -- if $lossy_optional_integer_default_in(plenv, expression_right) = (i_right)
  -- if $long_range(i_left) /\ $long_range(i_right)
  -- if i = $(i_left - i_right)
  -- if $long_range(i)
def $lossy_optional_integer_default_in(plenv, NExprBinaryOpMul expression_left expression_right metadata) = (i)
  -- if $lossy_optional_integer_default_in(plenv, expression_left) = (i_left)
  -- if $lossy_optional_integer_default_in(plenv, expression_right) = (i_right)
  -- if $long_range(i_left) /\ $long_range(i_right)
  -- if i = $(i_left * i_right)
  -- if $long_range(i)
def $lossy_optional_integer_default_in(plenv, NExprBinaryOpPow expression_left expression_right metadata) = (i)
  -- if $lossy_optional_integer_default_in(plenv, expression_left) = (i_left)
  -- if $lossy_optional_integer_default_in(plenv, expression_right) = (i_right)
  -- if $long_range(i_left) /\ $long_range(i_right)
  -- if $(i_right >= 0)
  -- if $power_prepare(NINT i_left, NINT i_right) = POWERDONE (NINT i) false
  -- if $long_range(i)
def $lossy_optional_integer_default_in(plenv, NExprBinaryOpDiv expression_left expression_right metadata) = (i)
  -- if $lossy_optional_integer_default_in(plenv, expression_left) = (i_left)
  -- if $lossy_optional_integer_default_in(plenv, expression_right) = (i_right)
  -- if $long_range(i_left) /\ $long_range(i_right)
  -- if i_right =/= 0
  -- if $(i_left \ i_right) = 0
  -- if i = $(i_left / i_right)
  -- if $long_range(i)
def $lossy_optional_integer_default_in(plenv, NExprBinaryOpMod expression_left expression_right metadata) = (i)
  -- if $lossy_optional_integer_default_in(plenv, expression_left) = (i_left)
  -- if $lossy_optional_integer_default_in(plenv, expression_right) = (i_right)
  -- if $long_range(i_left) /\ $long_range(i_right)
  -- if $long_mod(i_left, i_right) = IRESULT i
  -- if $long_range(i)
def $lossy_optional_integer_default_in(plenv, NExprBinaryOpShiftLeft expression_left expression_right metadata) = (i)
  -- if $lossy_optional_integer_default_in(plenv, expression_left) = (i_left)
  -- if $lossy_optional_integer_default_in(plenv, expression_right) = (i_right)
  -- if $long_range(i_left) /\ $long_range(i_right)
  -- if $long_shl(i_left, i_right) = IRESULT i
  -- if $long_range(i)
def $lossy_optional_integer_default_in(plenv, NExprBinaryOpShiftRight expression_left expression_right metadata) = (i)
  -- if $lossy_optional_integer_default_in(plenv, expression_left) = (i_left)
  -- if $lossy_optional_integer_default_in(plenv, expression_right) = (i_right)
  -- if $long_range(i_left) /\ $long_range(i_right)
  -- if $long_shr(i_left, i_right) = IRESULT i
  -- if $long_range(i)
def $lossy_optional_integer_default_in(plenv, NExprBinaryOpBitwiseAnd expression_left expression_right metadata) = (i)
  -- if $lossy_optional_integer_default_in(plenv, expression_left) = (i_left)
  -- if $lossy_optional_integer_default_in(plenv, expression_right) = (i_right)
  -- if $long_range(i_left) /\ $long_range(i_right)
  -- if i = $long_and(i_left, i_right)
  -- if $long_range(i)
def $lossy_optional_integer_default_in(plenv, NExprBinaryOpBitwiseOr expression_left expression_right metadata) = (i)
  -- if $lossy_optional_integer_default_in(plenv, expression_left) = (i_left)
  -- if $lossy_optional_integer_default_in(plenv, expression_right) = (i_right)
  -- if $long_range(i_left) /\ $long_range(i_right)
  -- if i = $long_or(i_left, i_right)
  -- if $long_range(i)
def $lossy_optional_integer_default_in(plenv, NExprBinaryOpBitwiseXor expression_left expression_right metadata) = (i)
  -- if $lossy_optional_integer_default_in(plenv, expression_left) = (i_left)
  -- if $lossy_optional_integer_default_in(plenv, expression_right) = (i_right)
  -- if $long_range(i_left) /\ $long_range(i_right)
  -- if i = $long_xor(i_left, i_right)
  -- if $long_range(i)
def $lossy_optional_integer_default_in(plenv, NExprBitwiseNot expression metadata) = (i)
  -- if $lossy_optional_integer_default_in(plenv, expression) = (i_child)
  -- if $long_range(i_child)
  -- if i = $long_not(i_child)
  -- if $long_range(i)
def $lossy_optional_integer_default_in(plenv, NExprUnaryPlus expression metadata) = (i)
  -- if $psnumber(NExprUnaryPlus expression metadata) = PSNONNUMERIC
  -- if $lossy_optional_integer_default_in(plenv, expression) = (i)
  -- if $long_range(i)
def $lossy_optional_integer_default_in(plenv, NExprUnaryMinus expression metadata) = (i)
  -- if $psnumber(NExprUnaryMinus expression metadata) = PSNONNUMERIC
  -- if $lossy_optional_integer_default_in(plenv, expression) = (i_child)
  -- if $long_range(i_child)
  -- if i = $(-i_child)
  -- if $long_range(i)
def $lossy_optional_integer_default_in(plenv, NExprTernary expression_cond expression_true expression_false metadata) = (i)
  -- if $lossy_optional_integer_condition(plenv, expression_cond) = (true)
  -- if $lossy_optional_integer_default_in(plenv, expression_true) = (i)
  -- if $long_range(i)
def $lossy_optional_integer_default_in(plenv, NExprTernary expression_cond phpType5 expression_false metadata) = (i)
  -- if $lossy_optional_integer_condition(plenv, expression_cond) = (false)
  -- if $lossy_optional_integer_default_in(plenv, expression_false) = (i)
  -- if $long_range(i)
def $lossy_optional_integer_default_in(plenv, NExprTernary expression_cond ABSENT expression_false metadata) = (i)
  -- if $lossy_optional_integer_default_in(plenv, expression_cond) = (i)
  -- if $long_range(i)
  -- if i =/= 0
def $lossy_optional_integer_default_in(plenv, NExprBinaryOpCoalesce expression_left expression_right metadata) = (i)
  -- if $lossy_optional_integer_default_in(plenv, expression_left) = (i)
  -- if $long_range(i)
def $lossy_optional_integer_default_in(plenv, NExprBinaryOpCoalesce expression_left expression_right metadata) = (i)
  -- if $lossy_optional_integer_special(plenv, expression_left) = (PNULL)
  -- if $lossy_optional_integer_default_in(plenv, expression_right) = (i)
  -- if $long_range(i)
def $lossy_optional_integer_default_in(plenv, expression) = (i)
  -- if $psnumber(expression) = PSINTEGER i
def $lossy_optional_integer_default_in(plenv, expression) = eps -- otherwise

dec $lossy_optional_integer_tail(pstate, pfunction, psparam*, nat) : bool
def $lossy_optional_integer_tail(S, pfunction, eps, n) = true
def $lossy_optional_integer_tail(S, pfunction, psparam :: psparam_tail*, n) = true
  -- if ~psparam.REQUIRED /\ ~psparam.VARIADIC /\ $ptmasks(psparam.TYPE) = ["int"]
  -- if psparam.DEFAULT = PSDEFAULT expression_default "int"
  -- if $lossy_optional_integer_default_in(pfunction.ENV, expression_default) = (i)
  -- if $default_parameter_origin(S, pfunction.ORIGIN, n) = PORIGIN n_unit pcpath_parameter
  -- if porigin_default = PORIGIN n_unit (pcpath_parameter ++ [PCFIELD 6])
  -- if $origin_node(S.SOURCES, porigin_default) = (expression_default)
  -- if $default_at(pfunction.DEFAULTS, n) = ({INDEX n, ORIGIN porigin_default, KIND PDSTORED})
  -- if $compiled_read(S, porigin_default) = (PINT i)
  -- if $lossy_optional_integer_tail(S, pfunction, psparam_tail*, $(n + 1))
def $lossy_optional_integer_tail(S, pfunction, psparam*, n) = false -- otherwise

dec $lossy_optional_integer_header(pstate, pfunction, psparam*, nat) : bool
def $lossy_optional_integer_header(S, pfunction, psparam :: psparam_tail*, n) = $lossy_optional_integer_header(S, pfunction, psparam_tail*, $(n + 1))
  -- if psparam.REQUIRED /\ psparam.DEFAULT = PSNONE /\ ~psparam.VARIADIC /\ $ptmasks(psparam.TYPE) = ["int"]
def $lossy_optional_integer_header(S, pfunction, psparam :: psparam_tail*, n) = $lossy_optional_integer_tail(S, pfunction, psparam :: psparam_tail*, n)
  -- if ~psparam.REQUIRED
def $lossy_optional_integer_header(S, pfunction, psparam*, n) = false -- otherwise

dec $lossy_optional_integer_mode(psparam*, bool) : bool
def $lossy_optional_integer_mode(eps, b) = false
def $lossy_optional_integer_mode(psparam :: psparam_tail*, b) = (psparam.BYREF = b \/ $lossy_optional_integer_mode(psparam_tail*, b))

