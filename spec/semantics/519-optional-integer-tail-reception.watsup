dec $lossy_default_parameter_begin(pstate, pfunction, nat, nat) : pstate
def $typed_default_store(S, pfunction, n, PFLOAT n_bits) = $lossy_default_parameter_begin($write_name(S, pfunction.SIGNATURE.PARAMETERS[n].NAME, PFLOAT n_bits), pfunction, n, n_bits)
  -- if $lossy_default_parameter_candidate(S, pfunction, n, PFLOAT n_bits)
def $lossy_default_parameter_begin(S, pfunction, n, n_bits) = $error_dispatch(S[.TODO = [ptask_source]][.ORIGIN = (porigin_site)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], 8192, ptbytes, z, DIAGNOSTIC "Deprecated" ptbytes z, ptask_source)
  -- if $lookup(S.ENV, pfunction.SIGNATURE.PARAMETERS[n].NAME) = (n_cell)
  -- if $lossy_parameter_ready(S, n_cell, n_bits)
  -- if $lossy_parameter_snapshot(n_bits) = ((i, ptbytes))
  -- if z = $default_parameter_line(S, pfunction.ORIGIN, n)
  -- if porigin_site = $default_parameter_origin(S, pfunction.ORIGIN, n)
  -- if ptask_source = LOSSY_DEFAULT_PARAMETER_RECEIVE pfunction.ORIGIN n n_cell n_bits i z
def $lossy_default_parameter_begin(S, pfunction, n, n_bits) = S[.COMPLETION = UNSUPPORTED "lossy deferred default receive context"] -- otherwise

dec $lossy_default_parameter_source_valid(pstate, ptask) : bool
def $lossy_default_parameter_source_valid(S, LOSSY_DEFAULT_PARAMETER_RECEIVE porigin n n_cell n_bits i z) = true
  -- if $function_at(S.FUNCTIONS, porigin) = (pfunction)
  -- if $lossy_default_parameter_context(S, pfunction, n, n_bits, z)
  -- if S.ORIGIN = ($default_parameter_origin(S, porigin, n))
  -- if $lookup(S.ENV, pfunction.SIGNATURE.PARAMETERS[n].NAME) = (n_cell)
  -- if $(n_cell < |S.STORE|) /\ (HCELL n_cell) <- S.ALLOCATIONS
  -- if $lossy_parameter_snapshot(n_bits) = ((i, ptbytes))
def $lossy_default_parameter_source_valid(S, ptask) = false -- otherwise
def $call_task_valid(S, LOSSY_DEFAULT_PARAMETER_RECEIVE porigin n n_cell n_bits i z) = (S.TODO = [LOSSY_DEFAULT_PARAMETER_RECEIVE porigin n n_cell n_bits i z] /\ $lossy_default_parameter_source_valid(S, LOSSY_DEFAULT_PARAMETER_RECEIVE porigin n n_cell n_bits i z))
def $task_nodes(LOSSY_DEFAULT_PARAMETER_RECEIVE porigin n n_cell n_bits i z) = eps

def $error_call_valid(S, perrorcall) = true
  -- if perrorcall.RESUME = LOSSY_DEFAULT_PARAMETER_RECEIVE porigin n n_cell n_bits i z
  -- if $lossy_default_parameter_source_valid(S, perrorcall.RESUME)
  -- if $lossy_parameter_snapshot(n_bits) = ((i, ptbytes))
  -- if perrorcall.SITE = $default_parameter_origin(S, porigin, n)
  -- if perrorcall.LEVEL = 8192 /\ perrorcall.MESSAGE = ptbytes /\ perrorcall.LINE = z
  -- if perrorcall.EVENT = DIAGNOSTIC "Deprecated" ptbytes z

rule PhpStep/lossy-default-parameter-finish: S ~> $default_store(S, pfunction, n, PINT i)
  -- if S.TODO = [LOSSY_DEFAULT_PARAMETER_RECEIVE porigin n n_cell n_bits i z]
  -- if $lossy_default_parameter_source_valid(S, LOSSY_DEFAULT_PARAMETER_RECEIVE porigin n n_cell n_bits i z)
  -- if $lossy_parameter_ready(S, n_cell, n_bits)
  -- if $function_at(S.FUNCTIONS, porigin) = (pfunction)
rule PhpStep/lossy-default-parameter-finish-refused: S ~> S[.COMPLETION = UNSUPPORTED "lossy deferred default receive continuation"]
  -- if S.TODO = [LOSSY_DEFAULT_PARAMETER_RECEIVE porigin n n_cell n_bits i z]
  -- if $lossy_default_parameter_source_valid(S, LOSSY_DEFAULT_PARAMETER_RECEIVE porigin n n_cell n_bits i z)
  -- if ~$lossy_parameter_ready(S, n_cell, n_bits)
