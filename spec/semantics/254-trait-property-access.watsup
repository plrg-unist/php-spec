def $trait_static_property_read_pending((NULLSAFE_CHECK phpType20 z b) :: ptask*) = ~b
def $trait_static_property_read_pending((NULLSAFE_PROP_PREP phpType20 z b) :: ptask*) = ~b
def $trait_static_property_read_pending((NULLSAFE_DIM_INDEX expression z b) :: ptask*) = ~b

;; zend_std_get_static_property returns the address even when the handler
;; throws. The current opcode completes before NEXT_OPCODE propagates it.
dec $trait_property_opcode_context(pstate, porigin, ptask*) : (porigin, ptask, ptask*)?
dec $trait_property_opcode(pstate, ptraitproperty, porigin, ptask) : pstate
