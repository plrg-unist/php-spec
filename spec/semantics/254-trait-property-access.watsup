def $trait_static_property_read_pending((DIM_INDEX expression z) :: ptask*) = $trait_static_property_read_pending(ptask*)
def $trait_static_property_read_pending((UPDATE_PREP pupdate b z) :: ptask*) = true
def $trait_static_property_read_pending((COMPOUND_PREP pbin expression_left expression_right z) :: ptask*) = true
