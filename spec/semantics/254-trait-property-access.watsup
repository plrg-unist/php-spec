;; zend_std_get_static_property_with_info retains an address, not its value.
;; Source mode and the consuming continuation survive ordinary handler frames.
dec $trait_property_source(pstate, porigin, porigin, ptbytes, int) : bool
dec $trait_property_selected(pstate, ptraitproperty) : bool
dec $trait_property_phase_valid(pstate, ptraitproperty, nat) : bool
dec $trait_property_tail(ptask*, ptraitproperty) : ptask*?
dec $trait_property_target_kind(pcnode) : ppmode?
dec $trait_property_quiet_kind(bool) : ppmode
dec $trait_property_source_kind(pstate, porigin) : ppmode?
dec $trait_property_consumer(pstate, porigin, porigin, ptask*) : ppmode?
dec $trait_property_below(porigin, porigin) : bool
dec $trait_property_prepare(pstate, porigin, ptbytes, int) : pstate
dec $trait_property_message(pstate, ptraitproperty) : ptbytes
dec $trait_property_write_valid(pstate, ptraitpropertywrite) : bool
dec $trait_property_store_valid(pstate, porigin, pbin?, poperand, int) : bool
dec $trait_property_operand_valid(pstate, poperand) : bool
dec $trait_property_write_start(pstate, pbin?) : pstate
dec $trait_property_write_ready(pstate, ptraitpropertywrite, ptask*) : pstate

def $trait_property_below(PORIGIN n pcpath, PORIGIN n pcpath_site) = $effect_below(pcpath, pcpath_site)
def $trait_property_below(porigin, porigin_site) = false -- otherwise
def $trait_property_target_kind(NExprAssign expression_left expression_right metadata) = (PPW)
def $trait_property_target_kind(NExprAssignRef expression_left expression_right metadata) = (PPW)
def $trait_property_target_kind(pcnode) = (PPRW) -- if $key_write_op(pcnode) =/= eps
def $trait_property_target_kind(pcnode) = (PPRW) -- if $key_write_update(pcnode) =/= eps
def $trait_property_target_kind(NExprAssignOpCoalesce expression_left expression_right metadata) = (PPIS)
def $trait_property_target_kind(NExprBinaryOpCoalesce expression_left expression_right metadata) = (PPIS)
def $trait_property_target_kind(NExprEmpty expression metadata) = (PPIS)
def $trait_property_target_kind(pcnode) = eps -- otherwise
def $trait_property_quiet_kind(true) = PPIS
def $trait_property_quiet_kind(false) = PPR

;; Array/object left chains inherit the compiler's outer fetch mode. Argument
;; mode is selected by the authenticated receiving function, not by its AST.
def $trait_property_source_kind(S, porigin) = $trait_property_source_kind(S, porigin_parent)
  -- if $reference_origin_parent(porigin, 1) = ((porigin_parent, [PCFIELD 0]))
  -- if $origin_node(S.SOURCES, porigin_parent) = (NExprArrayDimFetch expression phpType5 metadata)
def $trait_property_source_kind(S, porigin) = $trait_property_source_kind(S, porigin_parent)
  -- if $reference_origin_parent(porigin, 1) = ((porigin_parent, [PCFIELD 0]))
  -- if $origin_node(S.SOURCES, porigin_parent) = (NExprPropertyFetch expression phpType20 metadata)
def $trait_property_source_kind(S, porigin) = $trait_property_source_kind(S, porigin_parent)
  -- if $reference_origin_parent(porigin, 1) = ((porigin_parent, [PCFIELD 0]))
  -- if $origin_node(S.SOURCES, porigin_parent) = (NExprNullsafePropertyFetch expression phpType20 metadata)
def $trait_property_source_kind(S, porigin) = (ppmode)
  -- if $reference_origin_parent(porigin, 1) = ((porigin_parent, [PCFIELD 0]))
  -- if $origin_node(S.SOURCES, porigin_parent) = (pcnode)
  -- if $trait_property_target_kind(pcnode) = (ppmode)
def $trait_property_source_kind(S, porigin) = (PPIS)
  -- if $reference_origin_parent(porigin, 2) = ((porigin_parent, [PCFIELD 0, PCINDEX n]))
  -- if $origin_node(S.SOURCES, porigin_parent) = (NExprIsset (SEQUENCE expression*) metadata)
  -- if $(n < |expression*|)
def $trait_property_source_kind(S, porigin) = (PPW)
  -- if $reference_origin_parent(porigin, 1) = ((porigin_parent, [PCFIELD 1]))
  -- if $origin_node(S.SOURCES, porigin_parent) = (NExprAssignRef expression_left expression_right metadata)
def $trait_property_source_kind(S, porigin) = (PPW)
  -- if $reference_origin_parent(porigin, 1) = ((porigin_parent, [PCFIELD 1]))
  -- if $origin_node(S.SOURCES, porigin_parent) = (NArrayItem phpType5 expression (BOOLEAN true) (BOOLEAN false) metadata)
def $trait_property_source_kind(S, porigin) = eps
  -- if $reference_origin_parent(porigin, 1) = ((porigin_parent, [PCFIELD 1]))
  -- if $origin_node(S.SOURCES, porigin_parent) = (NArg phpType3 expression (BOOLEAN false) (BOOLEAN false) metadata)
def $trait_property_source_kind(S, porigin) = (PPR) -- otherwise

def $trait_property_consumer(S, porigin_site, porigin, (ORIGIN_RETURN (porigin_outer)) :: ptask_tail*) = $trait_property_consumer(S, porigin_site, porigin_outer, ptask_tail*)
  -- if $trait_property_below(porigin_outer, porigin_site)
def $trait_property_consumer(S, porigin_site, porigin, (DIM_INDEX expression_key z) :: ptask_tail*) = $trait_property_consumer(S, porigin_site, porigin, ptask_tail*)
  -- if $origin_node(S.SOURCES, porigin) = (NExprArrayDimFetch expression expression_key metadata)
  -- if $origin_child((porigin), [PCFIELD 0]) = (porigin_base)
  -- if $trait_property_below(porigin_base, porigin_site)
  -- if z = $runtime_line(S[.ORIGIN = (porigin)], [PCFIELD 1], expression_key)
def $trait_property_consumer(S, porigin_site, porigin, (DIM_APPEND z) :: ptask_tail*) = $trait_property_consumer(S, porigin_site, porigin, ptask_tail*)
  -- if $origin_node(S.SOURCES, porigin) = (NExprArrayDimFetch expression ABSENT metadata)
  -- if $origin_child((porigin), [PCFIELD 0]) = (porigin_base)
  -- if $trait_property_below(porigin_base, porigin_site)
  -- if z = $runtime_line(S[.ORIGIN = (porigin)], [PCFIELD 0], expression)
def $trait_property_consumer(S, porigin_site, porigin, (NULLSAFE_CHECK phpType20 z b) :: ptask_tail*) = ($trait_property_quiet_kind(b))
  -- if $nullsafe_property_task(S[.ORIGIN = (porigin)], phpType20, z, b, true)
  -- if $origin_child((porigin), [PCFIELD 0]) = (porigin_base)
  -- if $trait_property_below(porigin_base, porigin_site)
def $trait_property_consumer(S, porigin_site, porigin, (NULLSAFE_PROP_PREP phpType20 z b) :: ptask_tail*) = ($trait_property_quiet_kind(b))
  -- if $nullsafe_property_task(S[.ORIGIN = (porigin)], phpType20, z, b, false)
  -- if $origin_child((porigin), [PCFIELD 0]) = (porigin_base)
  -- if $trait_property_below(porigin_base, porigin_site)
def $trait_property_consumer(S, porigin_site, porigin, (NULLSAFE_DIM_INDEX expression_key z b) :: ptask_tail*) = ($trait_property_quiet_kind(b))
  -- if $nullsafe_index_task(S[.ORIGIN = (porigin)], expression_key, z, b)
  -- if $origin_child((porigin), [PCFIELD 0]) = (porigin_base)
  -- if $trait_property_below(porigin_base, porigin_site)
def $trait_property_consumer(S, porigin_site, porigin, (DIM_FETCH z) :: ptask_tail*) = (PPR)
  -- if $trait_property_below(porigin, porigin_site)
  -- if $origin_node(S.SOURCES, porigin) = (expression)
  -- if z = $runtime_line(S[.ORIGIN = (porigin)], eps, expression)
def $trait_property_consumer(S, porigin_site, porigin, (ASSIGN_PREP expression_target expression_rhs) :: ptask_tail*) = (PPW)
  -- if $origin_node(S.SOURCES, porigin) = (NExprAssign expression_target expression_rhs metadata)
  -- if $origin_child((porigin), [PCFIELD 0]) = (porigin_target)
  -- if $trait_property_below(porigin_target, porigin_site)
def $trait_property_consumer(S, porigin_site, porigin, (COMPOUND_PREP pbin expression_target expression_rhs z) :: ptask_tail*) = (PPRW)
  -- if $origin_node(S.SOURCES, porigin) = (pcnode)
  -- if $key_write_op(pcnode) = (pbin)
  -- if $origin_child((porigin), [PCFIELD 0]) = (porigin_target)
  -- if $origin_child((porigin), [PCFIELD 1]) = (porigin_rhs)
  -- if $origin_node(S.SOURCES, porigin_target) = (expression_target)
  -- if $origin_node(S.SOURCES, porigin_rhs) = (expression_rhs)
  -- if $trait_property_below(porigin_target, porigin_site)
  -- if z = $runtime_line(S[.ORIGIN = (porigin)], eps, pcnode)
def $trait_property_consumer(S, porigin_site, porigin, (UPDATE_PREP pupdate b z) :: ptask_tail*) = (PPRW)
  -- if $origin_node(S.SOURCES, porigin) = (pcnode)
  -- if $key_write_update(pcnode) = ((pupdate, b))
  -- if $origin_child((porigin), [PCFIELD 0]) = (porigin_target)
  -- if $trait_property_below(porigin_target, porigin_site)
  -- if z = $runtime_line(S[.ORIGIN = (porigin)], eps, pcnode)
def $trait_property_consumer(S, porigin_site, porigin, (ISSET_RESULT b z) :: ptask_tail*) = (PPIS)
  -- if $trait_property_below(porigin, porigin_site)
  -- if $origin_node(S.SOURCES, porigin) = (expression)
  -- if z = $runtime_line(S[.ORIGIN = (porigin)], eps, expression)
  -- if $trait_property_source_kind(S, porigin) = (PPIS)
def $trait_property_consumer(S, porigin_site, porigin, (COALESCE_QUIET expression_rhs z_left z_right) :: ptask_tail*) = (PPIS)
  -- if $origin_node(S.SOURCES, porigin) = (NExprBinaryOpCoalesce expression_left expression_rhs metadata)
  -- if $origin_child((porigin), [PCFIELD 0]) = (porigin_left)
  -- if $trait_property_below(porigin_left, porigin_site)
  -- if z_left = $runtime_line(S[.ORIGIN = (porigin)], [PCFIELD 0], expression_left)
  -- if z_right = $runtime_line(S[.ORIGIN = (porigin)], [PCFIELD 1], expression_rhs)
def $trait_property_consumer(S, porigin_site, porigin, (COALESCE_ASSIGN_PREP expression_left expression_rhs z) :: ptask_tail*) = (PPIS)
  -- if $origin_node(S.SOURCES, porigin) = (NExprAssignOpCoalesce expression_left expression_rhs metadata)
  -- if $origin_child((porigin), [PCFIELD 0]) = (porigin_left)
  -- if $trait_property_below(porigin_left, porigin_site)
  -- if z = $runtime_line(S[.ORIGIN = (porigin)], eps, NExprAssignOpCoalesce expression_left expression_rhs metadata)
def $trait_property_consumer(S, porigin_site, porigin, (PROPERTY_REF_PREP expression_rhs z) :: ptask_tail*) = (PPW)
  -- if $origin_node(S.SOURCES, porigin) = (NExprAssignRef expression_target expression_rhs metadata)
  -- if $origin_child((porigin), [PCFIELD 0]) = (porigin_target)
  -- if $trait_property_below(porigin_target, porigin_site)
  -- if $property_ref_assignment_task(S[.ORIGIN = (porigin)], expression_rhs, z)
def $trait_property_consumer(S, porigin_site, porigin, (PROPERTY_REF_BIND pbase n_cell z) :: ptask_tail*) = (PPW)
  -- if $origin_node(S.SOURCES, porigin) = (NExprAssignRef expression_target expression_rhs metadata)
  -- if $origin_child((porigin), [PCFIELD 0]) = (porigin_target)
  -- if $trait_property_below(porigin_target, porigin_site)
  -- if $call_task_valid(S[.ORIGIN = (porigin)][.TODO = (PROPERTY_REF_BIND pbase n_cell z) :: ptask_tail*][.BASE = pbase], PROPERTY_REF_BIND pbase n_cell z)
def $trait_property_consumer(S, porigin_site, porigin, (PROPERTY_REF_FETCH z) :: ptask_tail*) = (PPW)
  -- if porigin_site = porigin
  -- if $class_static_ref_fetch_task(S[.ORIGIN = (porigin)][.TODO = (PROPERTY_REF_FETCH z) :: ptask_tail*][.BASE = BASE_CLASS_STATIC porigin_root ptbytes], z)
  -- if S.BASE = BASE_CLASS_STATIC porigin_root ptbytes
;; A property read as a source call argument uses the selected signature.
def $trait_property_consumer(S, porigin_site, porigin, (CALL_REF_FETCH pcalltarget n porigin_call?) :: ptask_tail*) = (PPW)
  -- if $trait_property_below(porigin, porigin_site)
  -- if $call_task_valid(S[.ORIGIN = (porigin)], CALL_REF_FETCH pcalltarget n porigin_call?)
def $trait_property_consumer(S, porigin_site, porigin, (TRAIT_PROPERTY_STORE porigin_site pbin? poperand z) :: ptask_tail*) = $trait_property_target_kind(pcnode)
  -- if $trait_property_store_valid(S, porigin_site, pbin?, poperand, z)
  -- if $reference_origin_parent(porigin_site, 1) = ((porigin_parent, [PCFIELD 0]))
  -- if $origin_node(S.SOURCES, porigin_parent) = (pcnode)
def $trait_property_consumer(S, porigin_site, porigin, ptask*) = eps -- otherwise

def $trait_property_source(S, porigin_site, porigin_root, ptbytes, z) = true
  -- if $origin_node(S.SOURCES, porigin_site) = (NExprStaticPropertyFetch phpType19 phpType31 metadata)
  -- if $class_static_source_task(S[.ORIGIN = (porigin_site)], NExprStaticPropertyFetch phpType19 phpType31 metadata)
  -- if z = $runtime_line(S[.ORIGIN = (porigin_site)], eps, NExprStaticPropertyFetch phpType19 phpType31 metadata)
  -- if $class_static_ref_name_matches(phpType31, ptbytes)
  -- if $class_at(S.CLASSES, porigin_root) = (pclassdesc)
  -- if $class_static_selector_source_name(S[.ORIGIN = (porigin_site)], phpType19) = (ptbytes_source)
  -- if $ptlc(ptbytes_source) = $ptlc(pclassdesc.NAME)
def $trait_property_source(S, porigin_site, porigin_root, ptbytes, z) = true
  -- if $origin_node(S.SOURCES, porigin_site) = (NExprStaticPropertyFetch phpType19 phpType31 metadata)
  -- if $class_static_source_task(S[.ORIGIN = (porigin_site)], NExprStaticPropertyFetch phpType19 phpType31 metadata)
  -- if z = $runtime_line(S[.ORIGIN = (porigin_site)], eps, NExprStaticPropertyFetch phpType19 phpType31 metadata)
  -- if $class_static_ref_name_matches(phpType31, ptbytes)
  -- if $class_static_selector_source_name(S[.ORIGIN = (porigin_site)], phpType19) = eps
  -- if ~$ppscoped_named(phpType19) /\ ~$class_static_literal_class(phpType19)
def $trait_property_source(S, porigin_site, porigin_root, ptbytes, z) = false -- otherwise

def $trait_property_tail((TRAIT_PROPERTY_PHASE ptraitproperty n) :: ptask_tail*, ptraitproperty) = (ptask_tail*) -- if n <- [0,1]
def $trait_property_tail((ERROR_HANDLER_INVOKE perrorcall) :: ptask_tail*, ptraitproperty) = (ptask_tail*) -- if perrorcall.RESUME = TRAIT_PROPERTY_PHASE ptraitproperty 1
def $trait_property_tail((ERROR_HANDLER_RESULT perrorcall) :: ptask_tail*, ptraitproperty) = (ptask_tail*) -- if perrorcall.RESUME = TRAIT_PROPERTY_PHASE ptraitproperty 1
def $trait_property_tail(ptask*, ptraitproperty) = eps -- otherwise

def $trait_property_selected(S, ptraitproperty) = true
  -- if S.ORIGIN = (ptraitproperty.SITE)
  -- if $trait_property_source(S, ptraitproperty.SITE, ptraitproperty.ROOT, ptraitproperty.NAME, ptraitproperty.LINE)
  -- if $trait_property_tail(S.TODO, ptraitproperty) = (ptask_tail*)
  -- if S_view = S[.BASE = BASE_CLASS_STATIC ptraitproperty.ROOT ptraitproperty.NAME]
  -- if $trait_property_consumer(S_view, ptraitproperty.SITE, ptraitproperty.SITE, ptask_tail*) = (ptraitproperty.MODE)
  -- if $trait_property_source_kind(S, ptraitproperty.SITE) = eps \/ $trait_property_source_kind(S, ptraitproperty.SITE) = (ptraitproperty.MODE)
  -- if $class_at(S.CLASSES, ptraitproperty.ROOT) = (pclassdesc)
  -- if pclassdesc.KIND = "trait"
  -- if $class_named(S.CLASSNAMES, $ptlc(pclassdesc.NAME)) = (ptraitproperty.ROOT)
  -- if $class_static_select(S, ptraitproperty.ROOT, ptraitproperty.NAME) = (ppropertydesc)
  -- if ppropertydesc.ORIGIN = ptraitproperty.DECL
  -- if $class_static_accessible(S, ppropertydesc)
  -- if $class_static_at(S.CLASSSTATICS, ptraitproperty.DECL) = (pclassstatic)
  -- if ~$static_default_pending(pclassstatic.STATE)
  -- if $class_constant_static_work(S_view[.TODO = ptask_tail*], KNOWN (PSTRING pclassdesc.NAME), ptraitproperty.NAME, ptraitproperty.LINE) = eps
  -- if $call_current_valid(S)
def $trait_property_selected(S, ptraitproperty) = false -- otherwise

def $trait_property_phase_valid(S, ptraitproperty, 0) = true
  -- if $trait_property_selected(S, ptraitproperty)
  -- if S.BASE = BASE_CLASS_STATIC ptraitproperty.ROOT ptraitproperty.NAME
  -- if $class_static_at(S.CLASSSTATICS, ptraitproperty.DECL) = (pclassstatic)
  -- if pclassstatic.STATE =/= PROP_INITIAL \/ ~(ptraitproperty.MODE = PPR \/ ptraitproperty.MODE = PPRW)
def $trait_property_phase_valid(S, ptraitproperty, 1) = $trait_property_selected(S, ptraitproperty)
def $trait_property_phase_valid(S, ptraitproperty, n) = false -- otherwise

def $trait_property_prepare(S, porigin_root, ptbytes, z) = S_ready
  -- if S.ORIGIN = (porigin_site)
  -- if $class_static_select(S, porigin_root, ptbytes) = (ppropertydesc)
  -- if $trait_property_consumer(S[.BASE = BASE_CLASS_STATIC porigin_root ptbytes], porigin_site, porigin_site, S.TODO) = (ppmode)
  -- if ptraitproperty = {SITE porigin_site, ROOT porigin_root, DECL ppropertydesc.ORIGIN, NAME ptbytes, MODE ppmode, LINE z}
  -- if S_ready = S[.BASE = BASE_CLASS_STATIC porigin_root ptbytes][.TODO = (TRAIT_PROPERTY_PHASE ptraitproperty 0) :: S.TODO][.RESULT = KNOWN PNULL]
  -- if $trait_property_phase_valid(S_ready, ptraitproperty, 0)
def $trait_property_prepare(S, porigin_root, ptbytes, z) = S[.COMPLETION = UNSUPPORTED "uncertified trait static-property deprecation"] -- otherwise
def $class_static_prepare_base_ready(S, poperand_selector, ptbytes, z) = $trait_property_prepare(S, porigin_requested, ptbytes, z)
  -- if $scoped_selector_class(S, poperand_selector) = (porigin_requested)
  -- if $trait_static_property_deprecation_needed(S, porigin_requested, ptbytes)

def $trait_property_message(S, ptraitproperty) = $ptascii("Accessing static trait property ") ++ $property_declaring_name(S.CLASSES, ptraitproperty.DECL) ++ $ptascii("::$") ++ ptraitproperty.NAME ++ $ptascii(" is deprecated, it should only be accessed on a class using the trait")
def $call_task_valid(S, TRAIT_PROPERTY_PHASE ptraitproperty n) = $trait_property_phase_valid(S, ptraitproperty, n)
def $task_nodes(TRAIT_PROPERTY_PHASE ptraitproperty n) = eps
rule PhpStep/trait-property-deprecated: S ~> $error_dispatch(S, 8192, $trait_property_message(S, ptraitproperty), ptraitproperty.LINE, DIAGNOSTIC "Deprecated" $trait_property_message(S, ptraitproperty) ptraitproperty.LINE, TRAIT_PROPERTY_PHASE ptraitproperty 1)
  -- if S.TODO = (TRAIT_PROPERTY_PHASE ptraitproperty 0) :: ptask_tail*
  -- if $trait_property_phase_valid(S, ptraitproperty, 0)
rule PhpStep/trait-property-resume: S ~> S[.TODO = ptask_tail*][.BASE = BASE_CLASS_STATIC ptraitproperty.ROOT ptraitproperty.NAME][.RESULT = KNOWN PNULL]
  -- if S.TODO = (TRAIT_PROPERTY_PHASE ptraitproperty 1) :: ptask_tail*
  -- if $trait_property_phase_valid(S, ptraitproperty, 1)
def $error_call_valid(S, perrorcall) = true
  -- if perrorcall.RESUME = TRAIT_PROPERTY_PHASE ptraitproperty 1
  -- if $trait_property_selected(S, ptraitproperty)
  -- if perrorcall.SITE = ptraitproperty.SITE
  -- if perrorcall.LEVEL = 8192
  -- if perrorcall.LINE = ptraitproperty.LINE
  -- if perrorcall.MESSAGE = $trait_property_message(S, ptraitproperty)
  -- if perrorcall.EVENT = DIAGNOSTIC "Deprecated" perrorcall.MESSAGE perrorcall.LINE

;; Saved emitter views intentionally lack BASE. Only a source-bound future
;; reference fetch borrows this address; an executing fetch stays strict.
def $class_static_ref_fetch_pending(S, z, (TRAIT_PROPERTY_PHASE ptraitproperty n) :: (PROPERTY_REF_FETCH z) :: ptask_tail*) = $class_static_ref_fetch_task(S[.BASE = BASE_CLASS_STATIC ptraitproperty.ROOT ptraitproperty.NAME][.TODO = (PROPERTY_REF_FETCH z) :: ptask_tail*], z)
  -- if n <- [0,1]
  -- if $trait_property_selected(S, ptraitproperty)
  -- if z = ptraitproperty.LINE
def $class_static_ref_fetch_pending(S, z, (ERROR_HANDLER_INVOKE perrorcall) :: (PROPERTY_REF_FETCH z) :: ptask_tail*) = $class_static_ref_fetch_task(S[.BASE = BASE_CLASS_STATIC ptraitproperty.ROOT ptraitproperty.NAME][.TODO = (PROPERTY_REF_FETCH z) :: ptask_tail*], z)
  -- if perrorcall.RESUME = TRAIT_PROPERTY_PHASE ptraitproperty 1
  -- if $error_call_valid(S, perrorcall)
  -- if z = ptraitproperty.LINE
def $class_static_ref_fetch_pending(S, z, (ERROR_HANDLER_RESULT perrorcall) :: (PROPERTY_REF_FETCH z) :: ptask_tail*) = $class_static_ref_fetch_task(S[.BASE = BASE_CLASS_STATIC ptraitproperty.ROOT ptraitproperty.NAME][.TODO = (PROPERTY_REF_FETCH z) :: ptask_tail*], z)
  -- if perrorcall.RESUME = TRAIT_PROPERTY_PHASE ptraitproperty 1
  -- if $error_call_valid(S, perrorcall)
  -- if z = ptraitproperty.LINE

;; Class FETCH_CLASS has already selected its entry. A property-name CV and
;; address lookup remain delayed until a non-CV RHS has evaluated.
def $trait_property_write_pending(S, poperand, (ORIGIN_RETURN (porigin)) :: ptask_tail*) = $trait_property_write_pending(S[.ORIGIN = (porigin)], poperand, ptask_tail*)
def $trait_property_write_pending(S, poperand, (ASSIGN_PREP expression_target expression_rhs) :: ptask_tail*) = true
  -- if $reference_cv(expression_rhs) = eps
  -- if $class_static_assign_task(S, expression_target, expression_rhs)
  -- if $scoped_selector_class(S, poperand) = (porigin_root)
