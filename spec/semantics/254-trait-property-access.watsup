def $call_task_valid(S, TRAIT_PROPERTY_STORE porigin pbin? poperand z) = $trait_property_store_valid(S, porigin, pbin?, poperand, z)
def $task_nodes(TRAIT_PROPERTY_WRITE ptraitpropertywrite) = $operand_nodes(ptraitpropertywrite.CLASS) ++ $operand_nodes(ptraitpropertywrite.NAME)
def $task_nodes(TRAIT_PROPERTY_STORE porigin pbin? poperand z) = $operand_nodes(poperand)

