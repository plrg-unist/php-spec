def $trait_property_operand_valid(S, KNOWN (PARRAY n)) = ($(n < |S.ARRAYS|) /\ (HARRAY n) <- S.ALLOCATIONS)
def $trait_property_operand_valid(S, KNOWN (POBJECT n)) = ($(n < |S.OBJECTS|) /\ (HOBJECT n) <- S.ALLOCATIONS)
