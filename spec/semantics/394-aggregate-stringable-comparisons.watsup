def $aggregate_compare_suffix((AGGREGATE_COMPARE_RESULT paggregatecompare) :: ptask_tail*, paggregatecompare) = (ptask_tail* = paggregatecompare.TAIL)
def $aggregate_compare_suffix(ptask :: ptask_tail*, paggregatecompare) = $aggregate_compare_suffix(ptask_tail*, paggregatecompare)
  -- if ptask =/= AGGREGATE_COMPARE_RESULT paggregatecompare
def $aggregate_compare_suffix(eps, paggregatecompare) = false
def $task_nodes(AGGREGATE_COMPARE_RESULT paggregatecompare) = $operand_nodes(paggregatecompare.LEFT) ++ $operand_nodes(paggregatecompare.RIGHT) ++ $base_nodes(paggregatecompare.INPUTBASE) ++ $aggregate_cursor_pins(paggregatecompare.CAST.STACK)
def $call_task_valid(S, AGGREGATE_COMPARE_RESULT paggregatecompare) = ($aggregate_compare_valid(S, paggregatecompare) /\ S.ORIGIN = (paggregatecompare.CASTSITE) /\ $aggregate_compare_suffix(S.TODO, paggregatecompare))
def $stringify_source(S, porigin, z, AGGREGATE_COMPARE_RESULT paggregatecompare) = ($aggregate_compare_valid(S, paggregatecompare) /\ porigin = paggregatecompare.CASTSITE /\ z = paggregatecompare.LINE)
def $stringify_source_consumer(AGGREGATE_COMPARE_RESULT paggregatecompare) = true
def $stringify_consumer_tail_valid(S, porigin, z, AGGREGATE_COMPARE_RESULT paggregatecompare, ptask_tail*) = ($stringify_source(S, porigin, z, AGGREGATE_COMPARE_RESULT paggregatecompare) /\ ptask_tail* = paggregatecompare.TAIL)
def $stringify_consumer_receiver_valid(S, n, AGGREGATE_COMPARE_RESULT paggregatecompare) = (n = paggregatecompare.CAST.RECEIVER)
dec $aggregate_compare_redispatch_valid(pstate, paggregatecompare, nat, pvalue) : bool
def $aggregate_compare_redispatch_valid(S, paggregatecompare, n, pvalue) = ($aggregate_compare_valid(S, paggregatecompare) /\ $(n < |S.OBJECTS|) /\ $string_compare_text_valid(S, pvalue))
dec $aggregate_compare_redispatch_suffix(ptask*, paggregatecompare, nat, pvalue) : bool
def $aggregate_compare_redispatch_suffix((AGGREGATE_COMPARE_REDISPATCH_RESULT paggregatecompare n pvalue) :: ptask_tail*, paggregatecompare, n, pvalue) = (ptask_tail* = paggregatecompare.TAIL)
def $aggregate_compare_redispatch_suffix(ptask :: ptask_tail*, paggregatecompare, n, pvalue) = $aggregate_compare_redispatch_suffix(ptask_tail*, paggregatecompare, n, pvalue)
  -- if ptask =/= AGGREGATE_COMPARE_REDISPATCH_RESULT paggregatecompare n pvalue
def $aggregate_compare_redispatch_suffix(eps, paggregatecompare, n, pvalue) = false
def $task_nodes(AGGREGATE_COMPARE_REDISPATCH_RESULT paggregatecompare n pvalue) = $task_nodes(AGGREGATE_COMPARE_RESULT paggregatecompare)
def $call_task_valid(S, AGGREGATE_COMPARE_REDISPATCH_RESULT paggregatecompare n pvalue) = ($aggregate_compare_redispatch_valid(S, paggregatecompare, n, pvalue) /\ S.ORIGIN = (paggregatecompare.CASTSITE) /\ $aggregate_compare_redispatch_suffix(S.TODO, paggregatecompare, n, pvalue))
def $stringify_source(S, porigin, z, AGGREGATE_COMPARE_REDISPATCH_RESULT paggregatecompare n pvalue) = ($aggregate_compare_redispatch_valid(S, paggregatecompare, n, pvalue) /\ porigin = paggregatecompare.CASTSITE /\ z = paggregatecompare.LINE)
def $stringify_source_consumer(AGGREGATE_COMPARE_REDISPATCH_RESULT paggregatecompare n pvalue) = true
def $stringify_consumer_tail_valid(S, porigin, z, AGGREGATE_COMPARE_REDISPATCH_RESULT paggregatecompare n pvalue, ptask_tail*) = ($stringify_source(S, porigin, z, AGGREGATE_COMPARE_REDISPATCH_RESULT paggregatecompare n pvalue) /\ ptask_tail* = paggregatecompare.TAIL)
def $stringify_consumer_receiver_valid(S, n, AGGREGATE_COMPARE_REDISPATCH_RESULT paggregatecompare n_second pvalue) = (n = n_second)
def $aggregate_frame_pair((STRINGIFY_RESULT n porigin z) :: (AGGREGATE_COMPARE_RESULT paggregatecompare) :: ptask_tail*) = (n = paggregatecompare.CAST.RECEIVER /\ porigin = paggregatecompare.CASTSITE /\ z = paggregatecompare.LINE /\ ptask_tail* = paggregatecompare.TAIL)
def $aggregate_frame_pair((STRINGIFY_RESULT n porigin z) :: (AGGREGATE_COMPARE_REDISPATCH_RESULT paggregatecompare n_second pvalue) :: ptask_tail*) = (n = n_second /\ porigin = paggregatecompare.CASTSITE /\ z = paggregatecompare.LINE /\ ptask_tail* = paggregatecompare.TAIL)
def $aggregate_frame_pair(ptask*) = false -- otherwise
def $parameter_string_frame_scope(S, pframe, pframe_tail*) = $constant_frame_scope(S, pframe, pframe_tail*)
  -- if $aggregate_frame_pair(pframe.TODO)

;; Guards are exposed only by the actual pending caster or its immediately
;; saved caller pair. Unwinding that pair removes both the guard and its pins.
