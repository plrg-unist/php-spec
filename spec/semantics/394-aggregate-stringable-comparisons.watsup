def $aggregate_property_effect(S, n_left, n_right, n_index, pcompareguard_seen*, z) = (S, ORDER 1) -- otherwise
def $aggregate_property_continue(S, ORDER 0, n_left, n_right, n_index, pcompareguard_seen*, z) = $aggregate_property_effect(S, n_left, n_right, n_index, pcompareguard_seen*, z)
def $aggregate_property_continue(S, porder, n_left, n_right, n_index, pcompareguard_seen*, z) = (S, porder) -- otherwise

