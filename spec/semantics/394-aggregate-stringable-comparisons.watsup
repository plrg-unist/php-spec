  -- if n_index = |$aggregate_object_keys(S, n_left)|
def $aggregate_property_effect(S, n_left, n_right, n_index, pcompareguard_seen*, z) = $aggregate_property_effect(S, n_left, n_right, $(n_index + 1), pcompareguard_seen*, z)
