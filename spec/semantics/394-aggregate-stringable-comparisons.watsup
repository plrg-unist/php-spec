  -- if pvalue_right = $entry_read_value(S, pitem_right)
  -- if (S_next, porder) = $aggregate_item_order_effect(S, pitem_left, pitem_right, pcompareguard_seen*, z)
  -- if n_next = $(n_index + 1)
  -- if paggregatecursor = {KIND AGGREGATE_PLAIN, LEFT HARRAY n_left, RIGHT HARRAY n_right, INDEX n_next, WIDTH n_width, KEY pkey, LEFTITEM pitem_left, RIGHTITEM pitem_right, LEFTVALUE pvalue_left, RIGHTVALUE pvalue_right}
def $aggregate_array_continue(S, ORDER 0, n_left, n_right, n_index, n_width, pcompareguard_seen*, z) = $aggregate_array_effect(S, n_left, n_right, n_index, n_width, pcompareguard_seen*, z)
def $aggregate_array_continue(S, porder, n_left, n_right, n_index, n_width, pcompareguard_seen*, z) = (S, porder) -- otherwise

