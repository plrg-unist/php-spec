def $aggregate_frame_seen(S, (pcallcontext), pframe, pframe_tail*) = $aggregate_cursor_lefts(paggregatecompare.CAST.STACK)
  -- if pframe.TODO = (STRINGIFY_RESULT n porigin_site z) :: (AGGREGATE_COMPARE_REDISPATCH_RESULT paggregatecompare n pvalue) :: ptask_tail*
