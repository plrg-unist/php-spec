;; zend_hash_compare and zend_std_compare_objects retain both aggregates and
;; protect only the left one until their reached child comparison returns.
syntax paggregatecompare = {SITE porigin, CASTSITE porigin, OP pbin, LINE int, LEFT poperand, RIGHT poperand, ROOTLEFT pvalue, ROOTRIGHT pvalue, INPUTBASE pbase, CALLER pcallcontext?, OWNER nat, CONSUMER ptask, TAIL ptask*, CAST paggregatecallback}
syntax paggregatevm = {OBJECT nat?, VM pfibervm}

dec $aggregate_node_value(pnode) : pvalue
dec $aggregate_property_keys(pstate, ppropertydesc*) : ptbytes*
dec $aggregate_object_keys(pstate, nat) : ptbytes*
dec $aggregate_kind_pins(paggregatekind) : pnode*
dec $aggregate_cursor_guard(paggregatecursor) : pcompareguard
dec $aggregate_table_count(pentry*) : nat
dec $aggregate_std_stack(paggregatecursor*, nat, nat, nat, nat) : paggregatecursor*
dec $aggregate_std_order_result(porder, nat, nat, nat, nat) : porder
dec $aggregate_std_tables(pstate, nat, nat, nat, nat, pcompareguard*, int) : (pstate, porder)
dec $aggregate_std_effect(pstate, nat, nat, nat, nat, nat, nat, pcompareguard*, int) : (pstate, porder)
dec $aggregate_cursor_pins(paggregatecursor*) : pnode*
dec $aggregate_cursor_lefts(paggregatecursor*) : pcompareguard*
dec $aggregate_other_item(paggregatecursor, bool) : pitem
dec $aggregate_pointer(paggregatecursor, bool) : paggregatepointer
dec $aggregate_pointer_value(pstate, paggregatepointer) : pvalue?
dec $aggregate_push(porder, paggregatecursor) : porder
dec $aggregate_array_continue(pstate, porder, nat, nat, nat, nat, pcompareguard*, int) : (pstate, porder)
dec $aggregate_property_continue(pstate, porder, nat, nat, nat, pcompareguard*, int) : (pstate, porder)
dec $aggregate_cursor_valid(pstate, paggregatecursor) : bool
dec $aggregate_item_image(pitem, pvalue) : bool
dec $aggregate_stack_image(pstate, paggregatecursor*, pvalue, pvalue, pvalue, pvalue) : bool
dec $aggregate_compare_source(pstate, paggregatecompare) : bool
dec $aggregate_callback_image(paggregatecallback) : bool
dec $aggregate_compare_valid(pstate, paggregatecompare) : bool
dec $aggregate_compare_suffix(ptask*, paggregatecompare) : bool
dec $aggregate_frame_pair(ptask*) : bool
dec $aggregate_current_seen(pstate) : pcompareguard*
dec $aggregate_frame_seen(pstate, pcallcontext?, pframe, pframe*) : pcompareguard*
dec $aggregate_frames_seen(pstate, pcallcontext?, pframe*) : pcompareguard*
dec $aggregate_local_seen(pstate) : pcompareguard*
dec $aggregate_local_declared(pstate, nat) : bool
dec $aggregate_vm_scope(pstate, paggregatevm) : pstate
dec $aggregate_suspended_view(pstate, pnode) : paggregatevm*
dec $aggregate_suspended_views(pstate, pnode*) : paggregatevm*
dec $aggregate_caller_view(pstate, pfibercaller) : paggregatevm*
dec $aggregate_caller_views(pstate, pfibercaller*) : paggregatevm*
dec $aggregate_closer_view(pstate, pfiberclose) : paggregatevm*
dec $aggregate_closer_views(pstate, pfiberclose*) : paggregatevm*
dec $aggregate_parked_views(pstate) : paggregatevm*
dec $aggregate_views_seen(pstate, paggregatevm*) : pcompareguard*
dec $aggregate_views_declared(pstate, paggregatevm*, nat) : bool
dec $aggregate_order_values(pbin, pvalue, pvalue) : (pvalue, pvalue)
dec $aggregate_leaf_values(paggregatecallback, pvalue, pvalue) : (pvalue, pvalue)
dec $aggregate_order_cast(porder) : bool
dec $aggregate_order(pstate, pbin, pvalue, pvalue, int) : (pstate, porder)
dec $aggregate_pending_order(pstate) : porder?
dec $aggregate_compare_begin(pstate, pstate, porigin, porigin, pbin, poperand, poperand, pvalue, pvalue, int, ptask, ptask*, paggregatecallback) : pstate
dec $aggregate_order_finish(pstate, paggregatecompare, porder) : pstate
dec $aggregate_resume(pstate, porder, paggregatecursor*, int) : (pstate, porder)
dec $aggregate_resume_join(pstate, porder, paggregatecursor*, int) : (pstate, porder)
dec $aggregate_compare_return(pstate, paggregatecompare, pvalue, pvalue) : pstate

dec $aggregate_std_kind(paggregatekind) : bool
dec $aggregate_decl_kind(paggregatekind) : bool
dec $aggregate_guards_unique(pcompareguard*) : bool
dec $aggregate_decl_rows(pstate, nat, ppropertyslot*) : bool
dec $aggregate_decl_keys(ppropertyslot*) : ptbytes*
dec $aggregate_decl_image(pstate, nat, ptbytes*) : bool
dec $aggregate_decl_effect(pstate, nat, nat, ptbytes*, nat, pcompareguard*, int) : (pstate, porder)
dec $aggregate_decl_continue(pstate, porder, nat, nat, ptbytes*, nat, pcompareguard*, int) : (pstate, porder)
dec $aggregate_tasks_declared(ptask*, nat) : bool
dec $aggregate_frames_declared(pstate, pcallcontext?, pframe*, nat) : bool
dec $aggregate_cursor_declared(paggregatecursor*, nat) : bool
dec $aggregate_hash_image(pstate, nat, nat) : bool
dec $aggregate_item_order(pstate, pitem, pitem, pcompareguard*) : porder
dec $aggregate_item_order_effect(pstate, pitem, pitem, pcompareguard*, int) : (pstate, porder)
dec $aggregate_entries_order(pstate, pentry*, pentry*, pcompareguard*) : porder

;; A concrete stdClass table is pinned in addition to each enclosing object.
;; Its captured identity survives COW even when the live object map changes.
def $aggregate_std_pair(S, n_left, n_right) = true
  -- if $(n_left < |S.OBJECTS| /\ n_right < |S.OBJECTS|)
  -- if S.OBJECTS[n_left] = STDINSTANCE
  -- if S.OBJECTS[n_right] = STDINSTANCE
  -- if ~($instance_storage_freeing(S, n_left) \/ $instance_storage_freeing(S, n_right))
def $aggregate_std_pair(S, n_left, n_right) = true
  -- if $object_table_ordinary(S, n_left) /\ $object_table_ordinary(S, n_right)
  -- if S.OBJECTS[n_left] = INSTANCE porigin
  -- if S.OBJECTS[n_right] = INSTANCE porigin
  -- if $object_table_at(S.OBJECTTABLES, n_left) =/= eps \/ $object_table_at(S.OBJECTTABLES, n_right) =/= eps
  -- if ~($instance_storage_freeing(S, n_left) \/ $instance_storage_freeing(S, n_right))
def $aggregate_std_pair(S, n_left, n_right) = false -- otherwise
def $aggregate_std_same_table(S, n_left, n_right) = true
  -- if $aggregate_std_pair(S, n_left, n_right)
  -- if $object_table_at(S.OBJECTTABLES, n_left) = (n_table)
  -- if $object_table_at(S.OBJECTTABLES, n_right) = (n_table)
def $aggregate_std_same_table(S, n_left, n_right) = false -- otherwise
def $aggregate_object_guard(S, n_left, n_right) = HARRAY n_table
  -- if $aggregate_std_pair(S, n_left, n_right)
  -- if $object_table_at(S.OBJECTTABLES, n_left) = (n_table)
def $aggregate_object_guard(S, n_left, n_right) = DECLARED_TABLE n_left
  -- if ~$aggregate_std_pair(S, n_left, n_right)
  -- if S.OBJECTS[n_left] = INSTANCE porigin
  -- if S.OBJECTS[n_right] = INSTANCE porigin
  -- if $objectprops_materialized(S.OBJECTPROPS, n_left) \/ $objectprops_materialized(S.OBJECTPROPS, n_right)
def $aggregate_object_guard(S, n_left, n_right) = HOBJECT n_left -- otherwise
def $aggregate_std_kind(AGGREGATE_STD_HASH n_left n_right) = true
def $aggregate_std_kind(paggregatekind) = false -- otherwise
def $aggregate_decl_kind(AGGREGATE_DECL_HASH ptbytes*) = true
def $aggregate_decl_kind(paggregatekind) = false -- otherwise
def $aggregate_guards_unique(eps) = true
def $aggregate_guards_unique(pcompareguard :: pcompareguard_tail*) = (~(pcompareguard <- pcompareguard_tail*) /\ $aggregate_guards_unique(pcompareguard_tail*))
def $aggregate_table_count(eps) = 0
def $aggregate_table_count((ENTRY pkey UNINITIALIZED) :: pentry_tail*) = $aggregate_table_count(pentry_tail*)
def $aggregate_table_count((ENTRY pkey pitem) :: pentry_tail*) = $(1 + $aggregate_table_count(pentry_tail*)) -- if pitem =/= UNINITIALIZED

;; The last cursor belongs to this table; any reached inner cursors stay first.
def $aggregate_std_stack([paggregatecursor], n_left, n_right, n_tableleft, n_tableright) = [paggregatecursor[.KIND = AGGREGATE_STD_HASH n_tableleft n_tableright][.LEFT = HOBJECT n_left][.RIGHT = HOBJECT n_right]]
def $aggregate_std_stack(paggregatecursor :: paggregatecursor_tail*, n_left, n_right, n_tableleft, n_tableright) = paggregatecursor :: $aggregate_std_stack(paggregatecursor_tail*, n_left, n_right, n_tableleft, n_tableright)
  -- if paggregatecursor_tail* =/= eps
def $aggregate_std_order_result(ORDERSTRING paggregatecallback, n_left, n_right, n_tableleft, n_tableright) = ORDERSTRING paggregatecallback[.STACK = $aggregate_std_stack(paggregatecallback.STACK, n_left, n_right, n_tableleft, n_tableright)]
def $aggregate_std_order_result(porder, n_left, n_right, n_tableleft, n_tableright) = porder -- otherwise
def $aggregate_std_effect(S, n_left, n_right, n_tableleft, n_tableright, n_index, n_width, pcompareguard_seen*, z) = (S_next, $aggregate_std_order_result(porder, n_left, n_right, n_tableleft, n_tableright))
  -- if (S_next, porder) = $aggregate_array_effect(S, n_tableleft, n_tableright, n_index, n_width, pcompareguard_seen*, z)
def $aggregate_std_tables(S, n_left, n_right, n_table, n_table, pcompareguard_seen*, z) = (S, ORDER 0)
def $aggregate_std_tables(S, n_left, n_right, n_tableleft, n_tableright, pcompareguard_seen*, z) = (S, ORDERRECURSIVE)
  -- if n_tableleft =/= n_tableright
  -- if (HARRAY n_tableleft) <- (pcompareguard_seen* ++ $aggregate_compare_seen(S))
def $aggregate_std_tables(S, n_left, n_right, n_tableleft, n_tableright, pcompareguard_seen*, z) = (S, ORDER $compare_int($aggregate_table_count(S.ARRAYS[n_tableleft].ITEMS), $aggregate_table_count(S.ARRAYS[n_tableright].ITEMS)))
  -- if n_tableleft =/= n_tableright
  -- if ~((HARRAY n_tableleft) <- (pcompareguard_seen* ++ $aggregate_compare_seen(S)))
  -- if $aggregate_table_count(S.ARRAYS[n_tableleft].ITEMS) =/= $aggregate_table_count(S.ARRAYS[n_tableright].ITEMS)
def $aggregate_std_tables(S, n_left, n_right, n_tableleft, n_tableright, pcompareguard_seen*, z) = $aggregate_std_effect(S, n_left, n_right, n_tableleft, n_tableright, 0, |S.ARRAYS[n_tableleft].ITEMS|, (HARRAY n_tableleft) :: pcompareguard_seen*, z)
  -- if n_tableleft =/= n_tableright
  -- if ~((HARRAY n_tableleft) <- (pcompareguard_seen* ++ $aggregate_compare_seen(S)))
  -- if $aggregate_table_count(S.ARRAYS[n_tableleft].ITEMS) = $aggregate_table_count(S.ARRAYS[n_tableright].ITEMS)
def $aggregate_std_order(S, n_left, n_right, pcompareguard_seen*, z) = $aggregate_std_tables(S_tables, n_left, n_right, n_tableleft, n_tableright, pcompareguard_seen*, z)
  -- if S_left = $object_table_materialize(S, n_left)
  -- if S_left.COMPLETION = NORMAL
  -- if S_tables = $object_table_materialize(S_left, n_right)
  -- if S_tables.COMPLETION = NORMAL
  -- if $object_table_at(S_tables.OBJECTTABLES, n_left) = (n_tableleft)
  -- if $object_table_at(S_tables.OBJECTTABLES, n_right) = (n_tableright)
def $aggregate_std_order(S, n_left, n_right, pcompareguard_seen*, z) = (S_left, ORDERUNSUPPORTED text)
  -- if S_left = $object_table_materialize(S, n_left)
  -- if S_left.COMPLETION = UNSUPPORTED text
def $aggregate_std_order(S, n_left, n_right, pcompareguard_seen*, z) = (S_tables, ORDERUNSUPPORTED text)
  -- if S_left = $object_table_materialize(S, n_left)
  -- if S_left.COMPLETION = NORMAL
  -- if S_tables = $object_table_materialize(S_left, n_right)
  -- if S_tables.COMPLETION = UNSUPPORTED text

;; DEINDIRECT happens before reference unwrapping. Physical bucket counts stay
;; unchanged by an inline unset; its resulting UNDEF has explicit child order.
def $aggregate_item_order(S, UNINITIALIZED, UNINITIALIZED, pcompareguard_seen*) = ORDER 0
def $aggregate_item_order(S, UNINITIALIZED, pitem, pcompareguard_seen*) = ORDER $(-1) -- if pitem =/= UNINITIALIZED
def $aggregate_item_order(S, pitem, UNINITIALIZED, pcompareguard_seen*) = ORDER 1 -- if pitem =/= UNINITIALIZED
def $aggregate_item_order(S, pitem_left, pitem_right, pcompareguard_seen*) = $value_order(S, $entry_value(S, pitem_left), $entry_value(S, pitem_right), pcompareguard_seen*)
  -- if pitem_left =/= UNINITIALIZED /\ pitem_right =/= UNINITIALIZED
def $aggregate_item_order_effect(S, UNINITIALIZED, UNINITIALIZED, pcompareguard_seen*, z) = (S, ORDER 0)
def $aggregate_item_order_effect(S, UNINITIALIZED, pitem, pcompareguard_seen*, z) = (S, ORDER $(-1)) -- if pitem =/= UNINITIALIZED
def $aggregate_item_order_effect(S, pitem, UNINITIALIZED, pcompareguard_seen*, z) = (S, ORDER 1) -- if pitem =/= UNINITIALIZED
def $aggregate_item_order_effect(S, pitem_left, pitem_right, pcompareguard_seen*, z) = $value_order_effect(S, $entry_value(S, pitem_left), $entry_value(S, pitem_right), pcompareguard_seen*, z)
  -- if pitem_left =/= UNINITIALIZED /\ pitem_right =/= UNINITIALIZED
def $aggregate_entries_order(S, eps, pentry_right*, pcompareguard_seen*) = ORDER 0
def $aggregate_entries_order(S, (ENTRY pkey UNINITIALIZED) :: pentry_left*, pentry_right*, pcompareguard_seen*) = $aggregate_entries_order(S, pentry_left*, pentry_right*, pcompareguard_seen*)
def $aggregate_entries_order(S, (ENTRY pkey pitem) :: pentry_left*, pentry_right*, pcompareguard_seen*) = ORDER 1
  -- if pitem =/= UNINITIALIZED
  -- if $entry_lookup(pentry_right*, pkey) = eps \/ $entry_lookup(pentry_right*, pkey) = (UNINITIALIZED)
def $aggregate_entries_order(S, (ENTRY pkey pitem_left) :: pentry_left*, pentry_right*, pcompareguard_seen*) = $aggregate_entries_order(S, pentry_left*, pentry_right*, pcompareguard_seen*)
  -- if pitem_left =/= UNINITIALIZED
  -- if $entry_lookup(pentry_right*, pkey) = (pitem_right)
  -- if pitem_right =/= UNINITIALIZED
  -- if $aggregate_item_order(S, $object_table_item(S, pitem_left), $object_table_item(S, pitem_right), pcompareguard_seen*) = ORDER 0
def $aggregate_entries_order(S, (ENTRY pkey pitem_left) :: pentry_left*, pentry_right*, pcompareguard_seen*) = porder
  -- if pitem_left =/= UNINITIALIZED
  -- if $entry_lookup(pentry_right*, pkey) = (pitem_right)
  -- if pitem_right =/= UNINITIALIZED
  -- if porder = $aggregate_item_order(S, $object_table_item(S, pitem_left), $object_table_item(S, pitem_right), pcompareguard_seen*)
  -- if porder =/= ORDER 0
def $aggregate_cached_order(S, n_left, n_right, pcompareguard_seen*) = ORDERRECURSIVE
  -- if $object_table_at(S.OBJECTTABLES, n_left) = (n_tableleft)
  -- if $object_table_at(S.OBJECTTABLES, n_right) = (n_tableright)
  -- if n_tableleft =/= n_tableright
  -- if (HARRAY n_tableleft) <- (pcompareguard_seen* ++ $aggregate_compare_seen(S))
def $aggregate_cached_order(S, n_left, n_right, pcompareguard_seen*) = ORDER 0
  -- if $object_table_at(S.OBJECTTABLES, n_left) = (n_table)
  -- if $object_table_at(S.OBJECTTABLES, n_right) = (n_table)
def $aggregate_cached_order(S, n_left, n_right, pcompareguard_seen*) = ORDER $compare_int($aggregate_table_count(S.ARRAYS[n_tableleft].ITEMS), $aggregate_table_count(S.ARRAYS[n_tableright].ITEMS))
  -- if $object_table_at(S.OBJECTTABLES, n_left) = (n_tableleft)
  -- if $object_table_at(S.OBJECTTABLES, n_right) = (n_tableright)
  -- if n_tableleft =/= n_tableright
  -- if ~((HARRAY n_tableleft) <- (pcompareguard_seen* ++ $aggregate_compare_seen(S)))
  -- if $aggregate_table_count(S.ARRAYS[n_tableleft].ITEMS) =/= $aggregate_table_count(S.ARRAYS[n_tableright].ITEMS)
def $aggregate_cached_order(S, n_left, n_right, pcompareguard_seen*) = $aggregate_entries_order(S, S.ARRAYS[n_tableleft].ITEMS, S.ARRAYS[n_tableright].ITEMS, (HARRAY n_tableleft) :: pcompareguard_seen*)
  -- if $object_table_at(S.OBJECTTABLES, n_left) = (n_tableleft)
  -- if $object_table_at(S.OBJECTTABLES, n_right) = (n_tableright)
  -- if n_tableleft =/= n_tableright
  -- if ~((HARRAY n_tableleft) <- (pcompareguard_seen* ++ $aggregate_compare_seen(S)))
  -- if $aggregate_table_count(S.ARRAYS[n_tableleft].ITEMS) = $aggregate_table_count(S.ARRAYS[n_tableright].ITEMS)
def $aggregate_cached_order(S, n_left, n_right, pcompareguard_seen*) = ORDERUNSUPPORTED "cached property-table comparison materialization"
  -- if $object_table_at(S.OBJECTTABLES, n_left) = eps \/ $object_table_at(S.OBJECTTABLES, n_right) = eps

;; A declared-only hash contains indirect pointers to initialized public slots.
;; Key order is captured, while selected and future slot values remain live.
def $aggregate_decl_rows(S, n, eps) = true
def $aggregate_decl_rows(S, n, ppropertyslot :: ppropertyslot_tail*) = ($aggregate_decl_rows(S, n, ppropertyslot_tail*))
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if ppropertyslot.DECL = (ppropertyid)
  -- if $property_desc_at($property_layout(S, porigin, |S.CLASSES|), ppropertyslot.NAME) = (ppropertydesc)
  -- if ppropertydesc.ORIGIN = ppropertyid
  -- if ppropertydesc.VISIBILITY = PROPERTY_PUBLIC
  -- if ppropertydesc.KEY = ppropertyslot.NAME
  -- if ~$property_hook_declared(S, n, ppropertyslot.NAME)
  -- if ppropertyslot.STATE = PROP_VALUE pitem
  -- if pitem =/= UNINITIALIZED
def $aggregate_decl_rows(S, n, ppropertyslot*) = false -- otherwise
def $aggregate_decl_keys(eps) = eps
def $aggregate_decl_keys(ppropertyslot :: ppropertyslot_tail*) = ppropertyslot.NAME :: $aggregate_decl_keys(ppropertyslot_tail*)
def $aggregate_decl_image(S, n, ptbytes*) = true
  -- if $(n < |S.OBJECTS|)
  -- if (HOBJECT n) <- S.ALLOCATIONS
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if ~$property_hook_instance(S, n)
  -- if $objectprops_at(S.OBJECTPROPS, n) = (ppropertyslot_rows*)
  -- if $aggregate_decl_rows(S, n, ppropertyslot_rows*)
  -- if ptbytes* = $aggregate_decl_keys(ppropertyslot_rows*)
def $aggregate_decl_image(S, n, ptbytes*) = false -- otherwise
def $aggregate_decl_pair(S, n_left, n_right) = true
  -- if ~$aggregate_std_pair(S, n_left, n_right)
  -- if $(n_left < |S.OBJECTS| /\ n_right < |S.OBJECTS|)
  -- if S.OBJECTS[n_left] = INSTANCE porigin
  -- if S.OBJECTS[n_right] = INSTANCE porigin
  -- if ~($instance_storage_freeing(S, n_left) \/ $instance_storage_freeing(S, n_right))
  -- if $objectprops_materialized(S.OBJECTPROPS, n_left) \/ $objectprops_materialized(S.OBJECTPROPS, n_right)
  -- if $objectprops_at(S.OBJECTPROPS, n_left) = (ppropertyslot_left_rows*)
  -- if $objectprops_at(S.OBJECTPROPS, n_right) = (ppropertyslot_right_rows*)
  -- if $aggregate_decl_image(S, n_left, $aggregate_decl_keys(ppropertyslot_left_rows*))
  -- if $aggregate_decl_image(S, n_right, $aggregate_decl_keys(ppropertyslot_right_rows*))
def $aggregate_decl_pair(S, n_left, n_right) = false -- otherwise
def $aggregate_decl_order(S, n_left, n_right, pcompareguard_seen*, z) = (S, ORDERRECURSIVE)
  -- if (DECLARED_TABLE n_left) <- (pcompareguard_seen* ++ $aggregate_compare_seen(S))
def $aggregate_decl_order(S, n_left, n_right, pcompareguard_seen*, z) = $aggregate_decl_effect($objectprops_mark($objectprops_mark(S, n_left), n_right), n_left, n_right, $aggregate_decl_keys(ppropertyslot_rows*), 0, (DECLARED_TABLE n_left) :: pcompareguard_seen*, z)
  -- if ~((DECLARED_TABLE n_left) <- (pcompareguard_seen* ++ $aggregate_compare_seen(S)))
  -- if $objectprops_at(S.OBJECTPROPS, n_left) = (ppropertyslot_rows*)
def $aggregate_decl_effect(S, n_left, n_right, ptbytes*, n_index, pcompareguard_seen*, z) = (S, ORDER 0)
  -- if n_index = |ptbytes*|
def $aggregate_decl_effect(S, n_left, n_right, ptbytes*, n_index, pcompareguard_seen*, z) = $aggregate_decl_continue(S_next, $aggregate_push(porder, paggregatecursor), n_left, n_right, ptbytes*, $(n_index + 1), pcompareguard_seen*, z)
  -- if $(n_index < |ptbytes*|)
  -- if $objectprops_at(S.OBJECTPROPS, n_left) = (ppropertyslot_left_rows*)
  -- if $objectprops_at(S.OBJECTPROPS, n_right) = (ppropertyslot_right_rows*)
  -- if $property_slot_at(ppropertyslot_left_rows*, ptbytes*[n_index]) = (ppropertyslot_left)
  -- if $property_slot_at(ppropertyslot_right_rows*, ptbytes*[n_index]) = (ppropertyslot_right)
  -- if ppropertyslot_left.STATE = PROP_VALUE pitem_left
  -- if ppropertyslot_right.STATE = PROP_VALUE pitem_right
  -- if pvalue_left = $entry_value(S, pitem_left)
  -- if pvalue_right = $entry_value(S, pitem_right)
  -- if (S_next, porder) = $value_order_effect(S, pvalue_left, pvalue_right, pcompareguard_seen*, z)
  -- if n_next = $(n_index + 1)
  -- if n_width = |ptbytes*|
  -- if pkey = KSTRING ptbytes*[n_index]
  -- if paggregatecursor = {KIND AGGREGATE_DECL_HASH ptbytes*, LEFT HOBJECT n_left, RIGHT HOBJECT n_right, INDEX n_next, WIDTH n_width, KEY pkey, LEFTITEM pitem_left, RIGHTITEM pitem_right, LEFTVALUE pvalue_left, RIGHTVALUE pvalue_right}
def $aggregate_decl_effect(S, n_left, n_right, ptbytes*, n_index, pcompareguard_seen*, z) = (S, ORDERUNSUPPORTED "declared property-table comparison shape change") -- otherwise
def $aggregate_decl_continue(S, ORDER 0, n_left, n_right, ptbytes*, n_index, pcompareguard_seen*, z) = $aggregate_decl_effect(S, n_left, n_right, ptbytes*, n_index, pcompareguard_seen*, z)
def $aggregate_decl_continue(S, porder, n_left, n_right, ptbytes*, n_index, pcompareguard_seen*, z) = (S, porder) -- otherwise

;; Comparison images add no value roots. Membership mutation cannot detach an
;; abstract declared table; that boundary is explicit rather than reclassified.
def $aggregate_cursor_declared(eps, n) = false
def $aggregate_cursor_declared(paggregatecursor :: paggregatecursor_tail*, n) = (($aggregate_decl_kind(paggregatecursor.KIND) /\ (paggregatecursor.LEFT = HOBJECT n \/ paggregatecursor.RIGHT = HOBJECT n)) \/ $aggregate_cursor_declared(paggregatecursor_tail*, n))
def $aggregate_tasks_declared((CALL_ARGS pcalltarget phpType7* n_index poperand* porigin? z) :: (STRINGIFY_RESULT n_receiver porigin_site z_line) :: (AGGREGATE_COMPARE_RESULT paggregatecompare) :: ptask_tail*, n) = $aggregate_cursor_declared(paggregatecompare.CAST.STACK, n)
