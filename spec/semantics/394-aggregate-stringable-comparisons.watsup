def $aggregate_current_seen(S) = $aggregate_cursor_lefts(paggregatecompare.CAST.STACK)
  -- if S.TODO = (STRINGIFY_RESULT n porigin_site z) :: (AGGREGATE_COMPARE_REDISPATCH_RESULT paggregatecompare n pvalue) :: ptask_tail*
