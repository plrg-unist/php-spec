def $aggregate_tasks_declared((AGGREGATE_COMPARE_REDISPATCH_RESULT paggregatecompare n_second pvalue) :: ptask_tail*, n) = $aggregate_cursor_declared(paggregatecompare.CAST.STACK, n)
def $aggregate_tasks_declared(ptask*, n) = false -- otherwise
def $aggregate_frames_declared(S, pcallcontext?, eps, n) = false
def $aggregate_frames_declared(S, pcallcontext?, pframe :: pframe_tail*, n) = (($aggregate_frame_seen(S, pcallcontext?, pframe, pframe_tail*) =/= eps /\ $aggregate_tasks_declared(pframe.TODO, n)) \/ $aggregate_frames_declared(S, pframe.CONTEXT, pframe_tail*, n))
def $aggregate_local_declared(S, n) = (($aggregate_current_seen(S) =/= eps /\ $aggregate_tasks_declared(S.TODO, n)) \/ $aggregate_frames_declared(S, S.CURRENT, S.FRAMES, n))
