def $dynamic_new_class_valid(S, z, z_fetch) = false -- otherwise
def $call_task_valid(S, DYNAMIC_NEW_CLASS z z_fetch) = $dynamic_new_class_valid(S, z, z_fetch)
dec $dynamic_new_finish_head(pstate, pdynamicnew) : bool
def $dynamic_new_finish_head(S, pdynamicnew) = true
