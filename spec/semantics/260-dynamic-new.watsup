  -- if pdynamicnew.CALLED = (porigin_called)
  -- if $class_constant_parent_chain(S, porigin_called, pmethoddesc.OWNER, |S.CLASSES|)
def $dynamic_new_record_scope(S, pdynamicnew) = true
  -- if $dynamic_new_keyword(S, pdynamicnew.SITE) =/= eps
  -- if pdynamicnew.CLOSURE = (pclosureevidence)
  -- if $closure_evidence_valid(S, pclosureevidence)
  -- if $closure_evidence_body(S, $closure_evidence_object(pclosureevidence)) = (porigin_function)
  -- if pdynamicnew.SITE = PORIGIN n pcpath
  -- if $goto_source_owner($all_functions(S), n, pcpath) = (pfunction)
  -- if pfunction.ORIGIN = $origin_source(porigin_function)
  -- if pdynamicnew.SCOPE = $closure_evidence_lexical(pclosureevidence)
  -- if pdynamicnew.CALLED = $closure_evidence_called(pclosureevidence)
def $dynamic_new_record_scope(S, pdynamicnew) = false -- otherwise
