def $dynamic_new_finish_result(S, pdynamicnew) = false -- otherwise
def $call_task_valid(S, DYNAMIC_NEW_FINISH pdynamicnew) = ($dynamic_new_valid(S, pdynamicnew) /\ (~$dynamic_new_finish_head(S, pdynamicnew) \/ S.COMPLETION =/= NORMAL \/ $dynamic_new_finish_result(S, pdynamicnew)))
def $task_nodes(DYNAMIC_NEW_FINISH pdynamicnew) = eps

