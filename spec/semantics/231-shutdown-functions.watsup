def $shutdown_send_valid(S, n_index, n, poperand*) = false -- otherwise
def $call_task_valid(S, SHUTDOWN_SEND n_index n poperand*) = ($shutdown_send_valid(S, n_index, n, poperand*) /\ S.ORIGIN = eps)
def $task_nodes(SHUTDOWN_SEND n_index n poperand*) = $operands_roots(poperand*)
def $call_after_origin(S, SHUTDOWN_SEND n_index n poperand*) = S[.ORIGIN = eps]
