def $variadic_context_receive_valid(S, n_extra) = false -- otherwise
def $variadic_context_coerced(S, n_extra, KNOWN pvalue) = S[.SHUTDOWN.RECEIVED = $variadic_replace(S.SHUTDOWN.RECEIVED, n_extra, KNOWN pvalue)]
