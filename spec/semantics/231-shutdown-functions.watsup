def $drive_steps(S, n) = $drive_steps($prune_allocations($shutdown_render_begin(S, n_object)), n)
  -- if $shutdown_render_ready(S)
  -- if S.COMPLETION = UNCAUGHT n_object

def $shutdown_render_path(S, n_root, n_current, eps) = (n_root = n_current)
def $shutdown_render_path(S, n_root, n_current, n :: nat_tail*) = (~(n_current <- n :: nat_tail*) /\ $throwable_previous_id(S, n) = (n_current) /\ $shutdown_render_path(S, n_root, n, nat_tail*))
def $shutdown_render_value(PARRAY n) = $ptascii("Array")
def $shutdown_render_value(pvalue) = $echo_value(pvalue) -- otherwise
def $shutdown_render_pending_valid(S, pshutdownrender) = true -- if pshutdownrender.PENDING = eps
