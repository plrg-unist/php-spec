def $shutdown_render_valid(S, pshutdownrender) = ($shutdown_render_state_valid(S) /\ S.SHUTDOWN.RENDER = (pshutdownrender) /\ $shutdown_task_scope(S) /\ S.ORIGIN = ($shutdown_render_origin(S, pshutdownrender.ROOT)))
def $call_task_valid(S, SHUTDOWN_RENDER pshutdownrender) = $shutdown_render_valid(S, pshutdownrender)
def $task_nodes(SHUTDOWN_RENDER pshutdownrender) = [HOBJECT pshutdownrender.ROOT] ++ $completion_roots(THROWING n)
  -- if pshutdownrender.PENDING = (n)
