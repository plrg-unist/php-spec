  -- if (n_fixed = |pfunction.SIGNATURE.PARAMETERS| /\ S.SHUTDOWN.RECEIVED = poperand*) \/ ($(n_fixed < |pfunction.SIGNATURE.PARAMETERS|) /\ $shutdown_received_suffix(poperand*, S.SHUTDOWN.RECEIVED))
def $shutdown_received_valid(S) = false -- otherwise
def $shutdown_send_valid(S, n_index, n, poperand*) = true
