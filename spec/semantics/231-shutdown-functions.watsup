def $shutdown_parse_kind(preqbytes) = (4, $ptascii("Parse error: ")) -- if preqbytes = $ptascii("ParseError")
def $shutdown_parse_kind(preqbytes) = (64, $ptascii("Fatal error: ")) -- if preqbytes = $ptascii("CompileError")

;; All selected callback members are fixed here, including referenced selectors.
;; This snapshot is a certificate; neither it nor CALL roots the old raw array.
def $shutdown_snapshot_items(S, eps) = eps
def $shutdown_snapshot_items(S, (ENTRY pkey pitem) :: pentry*) = (ENTRY pkey (DIRECT $entry_value(S, pitem))) :: $shutdown_snapshot_items(S, pentry*)
def $shutdown_snapshot(S, PARRAY n) = (S.ARRAYS[n][.ITEMS = $shutdown_snapshot_items(S, S.ARRAYS[n].ITEMS)])
def $shutdown_snapshot(S, pvalue) = eps -- otherwise

;; zend_exception_error calls the builtin __toString before emitting its fatal.
;; A warning throw is deferred until that internal body stores its string cache.
;; RENDER is a borrowed certificate; its task owns the original receiver and,
;; while the body runs, the pending exception. It confers no source method scope.
def $shutdown_render_chain_warning(S, n, nat_seen*) = false -- if n <- nat_seen*
def $shutdown_render_chain_warning(S, n, nat_seen*) = true
  -- if ~(n <- nat_seen*)
  -- if $throwable_field(S, n, "message") = PARRAY n_array
def $shutdown_render_chain_warning(S, n, nat_seen*) = $shutdown_render_chain_warning(S, n_previous, n :: nat_seen*)
  -- if ~(n <- nat_seen*)
  -- if ~$shutdown_render_array_value($throwable_field(S, n, "message"))
  -- if $throwable_previous_id(S, n) = (n_previous)
def $shutdown_render_chain_warning(S, n, nat_seen*) = false -- otherwise
def $shutdown_render_ready(S) = true
  -- if S.COMPLETION = UNCAUGHT n
  -- if S.FRAMES = eps
