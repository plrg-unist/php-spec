def $shutdown_render_finish(S, pshutdownrender) = S_cached[.SHUTDOWN.RENDER = (pshutdownrender_next)][.TODO = [THROW_SEARCH n, SHUTDOWN_RENDER pshutdownrender_next]]
  -- if pshutdownrender.PENDING = (n)
  -- if ptbytes = $shutdown_render_join(S, pshutdownrender)
  -- if S_cached = $throwable_string_cache(S, pshutdownrender.ROOT, ptbytes)
  -- if pshutdownrender_next = pshutdownrender[.TEXT = ptbytes][.PHASE = SHUTDOWN_RENDER_RETURN]
def $throwable_marker(SHUTDOWN_RENDER pshutdownrender) = true -- if pshutdownrender.PHASE = SHUTDOWN_RENDER_RETURN
def $exception_terminal_tail(S, (SHUTDOWN_RENDER pshutdownrender) :: ptask_tail*) = ($shutdown_render_valid(S, pshutdownrender) /\ pshutdownrender.PHASE = SHUTDOWN_RENDER_RETURN /\ pshutdownrender.PENDING =/= eps)
  -- if ptask_tail* = eps
