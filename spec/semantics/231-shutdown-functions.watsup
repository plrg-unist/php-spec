def $task_nodes(SHUTDOWN_RENDER pshutdownrender) = [HOBJECT pshutdownrender.ROOT]
  -- if pshutdownrender.PENDING = eps \/ ~(pshutdownrender.PHASE <- [SHUTDOWN_RENDER_MESSAGE, SHUTDOWN_RENDER_TRACE])

def $shutdown_render_warning_message(S, pshutdownrender) = $ptascii("Array to string conversion")
  -- if pshutdownrender.PHASE = SHUTDOWN_RENDER_TRACE
def $shutdown_render_warning_message(S, pshutdownrender) = $object_name(S, pshutdownrender.ROOT) ++ $ptascii("::__toString() must return a string")
