def $task_nodes(SHUTDOWN_ENTER n_index poperand*) = $operands_roots(poperand*)
rule PhpStep/shutdown-enter: S ~> $call_arity($target_after_enter($call_enter(S[.SHUTDOWN.RECEIVED = poperand*[n_received:n_extra]][.TODO = [SHUTDOWN_RESULT n_index poperand*]], pfunction, poperand*, eps, $(-1)), pshutdownentry.TARGET), pfunction, |poperand*|, eps, $(-1))
