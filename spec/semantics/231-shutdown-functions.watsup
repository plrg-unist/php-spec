def $shutdown_current_sent_valid(S) = (S.SHUTDOWN.SENT = eps)
  -- if S.SHUTDOWN.PHASE =/= SHUTDOWN_RUNNING
def $shutdown_current_sent_valid(S) = false -- otherwise
;; RECEIVED is borrowed from EXTRA. Only the ordinary receive/coercion hook
;; changes it; SENT continues to certify the original C argument wrappers.
def $shutdown_received_suffix(eps, eps) = true
def $shutdown_received_suffix((KNOWN pvalue) :: poperand*, (KNOWN pvalue_received) :: poperand_received*) = $shutdown_received_suffix(poperand*, poperand_received*)
def $shutdown_received_suffix((REFERENCE n) :: poperand*, (REFERENCE n) :: poperand_received*) = $shutdown_received_suffix(poperand*, poperand_received*)
def $shutdown_received_suffix(poperand*, poperand_received*) = false -- otherwise
def $shutdown_received_valid(S) = true -- if S.SHUTDOWN.RECEIVED = eps
def $shutdown_received_valid(S) = true
