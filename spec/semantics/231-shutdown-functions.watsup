def $shutdown_render_warning(S, pshutdownrender) = $error_dispatch(S[.SHUTDOWN.RENDER = (pshutdownrender)], 2, ptbytes, 0, DIAGNOSTIC_INTERNAL "Warning" ptbytes 0, SHUTDOWN_RENDER pshutdownrender)
  -- if ptbytes = $shutdown_render_warning_message(S, pshutdownrender)
rule PhpStep/shutdown-render-message-warning: S ~> $shutdown_render_warning(S, pshutdownrender_next)
