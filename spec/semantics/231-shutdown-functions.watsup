def $shutdown_render_finish(S, pshutdownrender) = S_cached[.SHUTDOWN.RENDER = (pshutdownrender_next)][.TODO = [SHUTDOWN_RENDER pshutdownrender_next]]
  -- if pshutdownrender.PENDING = eps
