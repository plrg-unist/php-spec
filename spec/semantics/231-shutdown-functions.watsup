def $shutdown_render_array_value(PARRAY n) = true
def $shutdown_render_array_value(pvalue) = false -- otherwise
def $shutdown_render_root_message(pshutdownrender, ptbytes) = ptbytes -- if pshutdownrender.CURRENT = pshutdownrender.ROOT
