def $shutdown_context_valid(S, pcallcontext) = false -- otherwise
def $error_context_kind(S, pcallcontext) = true -- if $shutdown_context_kind(S, pcallcontext)
def $error_context_valid(S, pcallcontext) = true -- if $shutdown_context_valid(S, pcallcontext)
def $typed_caller_strict(S) = false -- if S.CURRENT = (pcallcontext) -- if $shutdown_context_valid(S, pcallcontext)
def $wrapper_called_suffix(S, pcallcontext) = eps -- if $shutdown_context_kind(S, pcallcontext)
def $wrapper_passed_suffix(S, pcallcontext) = $ptascii(" passed") -- if $shutdown_context_kind(S, pcallcontext)
def $trace_context(S, pbinding*, (pcallcontext)) = [{FILE eps, LINE $(-1), FUNCTION $trace_context_function(S, pcallcontext), CLASS $trace_context_class(S, pcallcontext), TYPE $trace_context_type(S, pcallcontext), ARGS $trace_indexed_args(pvalue*, 0), HASARGS true}]
  -- if $shutdown_context_kind(S, pcallcontext)
