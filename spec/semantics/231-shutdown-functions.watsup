;; This internal trace record authenticates the saved warning anchor. It does
;; not manufacture a user callcontext or grant the renderer's receiver scope.
def $shutdown_render_frame_call(S, pframe, pframe_tail*) = (pshutdownrender)
  -- if pframe.CONTEXT = eps /\ pframe.LOCALS = eps
  -- if pframe.TODO = (ERROR_HANDLER_RESULT perrorcall) :: ptask_tail*
  -- if ptask_tail* = eps
