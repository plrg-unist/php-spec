;; Zend stores a selected FCC and copied values, not a live raw registration.
;; Its owners survive this queue into the later destructor/output/free phases.
dec $shutdown_unknown_source(pstate, pconfigcall, nat) : bool
dec $shutdown_unknown_items(pentry*) : bool
dec $shutdown_unknown_item(pentry) : bool
dec $shutdown_unknown_packs(pconfigpack*) : bool
dec $shutdown_argument_named_unknown(pstate, porigin, nat) : bool
dec $shutdown_previous_source(pstate, pconfigcall, preqbytes, nat) : bool
dec $shutdown_source_named_at(pstate, porigin, nat, preqbytes) : bool
dec $shutdown_named_items(pentry*, preqbytes) : bool
dec $shutdown_previous_pack(pconfigpack, nat, nat, preqbytes) : bool
dec $shutdown_previous_packs(pconfigpack*, nat, nat, preqbytes) : bool
dec $shutdown_unpack_cursor(pstate) : nat
dec $shutdown_previous_named(pstate, pconfigcall, preqbytes) : bool
dec $shutdown_unknown_named(pstate, pconfigcall) : bool
dec $shutdown_values(pnamedslot*) : pvalue*
dec $shutdown_register(pstate, pconfigcall, pvalue) : pstate
dec $shutdown_registration_valid(pstate, pconfigcall) : bool
dec $shutdown_selection_scope(pstate, pshutdownentry) : bool
dec $shutdown_scoped_target(pcalltarget) : bool
dec $shutdown_capture_scope(pstate, porigin, pmethodcapture?) : porigin?
dec $shutdown_capture_valid(pstate, porigin, pmethodcapture?) : bool
dec $shutdown_entry_valid(pstate, pshutdownentry) : bool
dec $shutdown_entries_valid(pstate, pshutdownentry*) : bool
dec $shutdown_known(pvalue*) : poperand*
dec $shutdown_args_valid(pstate, pvalue*) : bool
dec $shutdown_reported(pstate, preqbytes, preqbytes, int, preqbytes, bool) : pstate
dec $shutdown_file(pstate) : preqbytes
dec $shutdown_fatal_suffix(pstate, bool) : preqbytes
dec $shutdown_exception_suffix(pstate, nat) : preqbytes
dec $shutdown_freeze(pstate) : pstate
dec $shutdown_frozen(pcompletion) : bool
dec $shutdown_terminal(pcompletion) : bool
dec $shutdown_abort_frames(pstate) : pstate
dec $shutdown_clean(pstate) : pstate
dec $shutdown_begin(pstate) : pstate
dec $shutdown_stop(pstate) : pstate
dec $request_fatal_state(pstate) : pstate
def $request_fatal_state(S) = S -- otherwise
dec $shutdown_freeze_marked(pstate) : pstate
dec $shutdown_task_scope(pstate) : bool
dec $shutdown_sent_valid(pstate, pshutdownentry, poperand*, nat) : bool
dec $shutdown_current_sent_valid(pstate) : bool
dec $shutdown_received_valid(pstate) : bool
dec $shutdown_received_suffix(poperand*, poperand*) : bool
dec $shutdown_send_valid(pstate, nat, nat, poperand*) : bool
dec $shutdown_reference_warning(pstate, nat, nat) : preqbytes
dec $shutdown_reference_valid(pstate, nat, nat, poperand*) : bool
dec $shutdown_enter_valid(pstate, nat, poperand*) : bool
dec $shutdown_result_valid(pstate, nat, poperand*) : bool
dec $shutdown_context_call(pcallcontext, pcallcontext?, pframe*) : (nat, poperand*)?
dec $shutdown_context_kind(pstate, pcallcontext) : bool
dec $shutdown_context_valid(pstate, pcallcontext) : bool
dec $shutdown_parse_kind(preqbytes) : (int, preqbytes)
dec $shutdown_snapshot_items(pstate, pentry*) : pentry*
dec $shutdown_snapshot(pstate, pvalue) : parray?
dec $shutdown_render_state_valid(pstate) : bool

def $intrinsic_name(INTRINSIC_REGISTER_SHUTDOWN_FUNCTION) = $ptascii("register_shutdown_function")
def $intrinsic_named(preqbytes) = (INTRINSIC_REGISTER_SHUTDOWN_FUNCTION) -- if $ptlc(preqbytes) = $ptascii("register_shutdown_function")
def $error_api_kind(INTRINSIC_REGISTER_SHUTDOWN_FUNCTION) = true
def $error_api_min(INTRINSIC_REGISTER_SHUTDOWN_FUNCTION) = 1
def $error_api_max(INTRINSIC_REGISTER_SHUTDOWN_FUNCTION) = 9223372036854775807
def $config_parameter(INTRINSIC_REGISTER_SHUTDOWN_FUNCTION, preqbytes) = (0) -- if preqbytes = $ptascii("callback")
def $config_parameter_name(INTRINSIC_REGISTER_SHUTDOWN_FUNCTION, 0) = $ptascii("callback")
def $config_destination(INTRINSIC_REGISTER_SHUTDOWN_FUNCTION, (preqbytes), n) = (0) -- if preqbytes = $ptascii("callback")
def $config_destination(INTRINSIC_REGISTER_SHUTDOWN_FUNCTION, (preqbytes), 0) = (1) -- if preqbytes =/= $ptascii("callback")
def $config_destination(INTRINSIC_REGISTER_SHUTDOWN_FUNCTION, (preqbytes), n) = (n) -- if preqbytes =/= $ptascii("callback") -- if $(n > 0)

def $shutdown_unknown_source(S, pconfigcall, n) = true
  -- if $(n < pconfigcall.INDEX)
  -- if $shutdown_argument_named_unknown(S, pconfigcall.SITE, n)
def $shutdown_unknown_source(S, pconfigcall, n) = $shutdown_unknown_source(S, pconfigcall, $(n + 1))
  -- if $(n < pconfigcall.INDEX)
  -- if ~$shutdown_argument_named_unknown(S, pconfigcall.SITE, n)
def $shutdown_unknown_source(S, pconfigcall, n) = false -- if $(n >= pconfigcall.INDEX)
def $shutdown_argument_named_unknown(S, porigin_site, n) = true
  -- if $intrinsic_argument(S, porigin_site, n) = ((expression, false, preqbytes_name?, porigin, z))
  -- if preqbytes_name? = (ptbytes_name)
  -- if ptbytes_name =/= $ptascii("callback")
def $shutdown_argument_named_unknown(S, porigin, n) = false -- otherwise
def $shutdown_unknown_items(eps) = false
def $shutdown_unknown_item(ENTRY (KSTRING preqbytes) pitem) = (preqbytes =/= $ptascii("callback"))
def $shutdown_unknown_item(pentry) = false -- otherwise
def $shutdown_unknown_items(pentry :: pentry_tail*) = ($shutdown_unknown_item(pentry) \/ $shutdown_unknown_items(pentry_tail*))
def $shutdown_unknown_packs(eps) = false
def $shutdown_unknown_packs(pconfigpack :: pconfigpack_tail*) = ($shutdown_unknown_items(pconfigpack.ITEMS) \/ $shutdown_unknown_packs(pconfigpack_tail*))
def $shutdown_unknown_named(S, pconfigcall) = ($shutdown_unknown_source(S, pconfigcall, 0) \/ $shutdown_unknown_packs(pconfigcall.PACKS))
;; Extra names remain forbidden by ZPP, but SEND diagnoses duplicates first.
def $shutdown_previous_source(S, pconfigcall, preqbytes, n) = true
  -- if $(n < pconfigcall.INDEX)
  -- if $shutdown_source_named_at(S, pconfigcall.SITE, n, preqbytes)
def $shutdown_previous_source(S, pconfigcall, preqbytes, n) = $shutdown_previous_source(S, pconfigcall, preqbytes, $(n + 1))
  -- if $(n < pconfigcall.INDEX)
  -- if ~$shutdown_source_named_at(S, pconfigcall.SITE, n, preqbytes)
def $shutdown_previous_source(S, pconfigcall, preqbytes, n) = false -- if $(n >= pconfigcall.INDEX)
def $shutdown_source_named_at(S, porigin_site, n, preqbytes) = true
  -- if $intrinsic_argument(S, porigin_site, n) = ((expression, false, preqbytes_name?, porigin, z))
  -- if preqbytes_name? = (preqbytes)
def $shutdown_source_named_at(S, porigin_site, n, preqbytes) = false -- otherwise
def $shutdown_named_items(eps, preqbytes) = false
def $shutdown_named_items((ENTRY pkey pitem) :: pentry_tail*, preqbytes) = ($exit_key_name(pkey) = (preqbytes) \/ $shutdown_named_items(pentry_tail*, preqbytes))
def $shutdown_previous_pack(pconfigpack, n_index, n_cursor, preqbytes) = $shutdown_named_items(pconfigpack.ITEMS, preqbytes)
  -- if $(pconfigpack.INDEX < n_index)
def $shutdown_previous_pack(pconfigpack, n_index, n_cursor, preqbytes) = $shutdown_named_items(pconfigpack.ITEMS[0:n_cursor], preqbytes)
  -- if pconfigpack.INDEX = n_index
  -- if $(n_cursor <= |pconfigpack.ITEMS|)
def $shutdown_previous_pack(pconfigpack, n_index, n_cursor, preqbytes) = false -- otherwise
def $shutdown_previous_packs(eps, n_index, n_cursor, preqbytes) = false
def $shutdown_previous_packs(pconfigpack :: pconfigpack_tail*, n_index, n_cursor, preqbytes) = ($shutdown_previous_pack(pconfigpack, n_index, n_cursor, preqbytes) \/ $shutdown_previous_packs(pconfigpack_tail*, n_index, n_cursor, preqbytes))
def $shutdown_unpack_cursor(S) = n -- if S.TODO = (CONFIG_UNPACK_NEXT pconfigcall poperand n) :: ptask_tail*
def $shutdown_unpack_cursor(S) = 0 -- otherwise
def $shutdown_previous_named(S, pconfigcall, preqbytes) = ($shutdown_previous_source(S, pconfigcall, preqbytes, 0) \/ $shutdown_previous_packs(pconfigcall.PACKS, pconfigcall.INDEX, $shutdown_unpack_cursor(S), preqbytes))
def $config_send_check(S, pconfigcall, (preqbytes), z) = $throw_scalar(S, "Error", $ptascii("Named parameter $") ++ preqbytes ++ $ptascii(" overwrites previous argument"), z)
  -- if pconfigcall.KIND = INTRINSIC_REGISTER_SHUTDOWN_FUNCTION
  -- if preqbytes =/= $ptascii("callback")
  -- if $shutdown_previous_named(S, pconfigcall, preqbytes)
def $error_api_arity(S, pconfigcall) = $config_error(S, pconfigcall, "ArgumentCountError", $ptascii("register_shutdown_function() does not accept unknown named parameters"))
  -- if pconfigcall.KIND = INTRINSIC_REGISTER_SHUTDOWN_FUNCTION
  -- if $shutdown_unknown_named(S, pconfigcall)
def $error_api_arity(S, pconfigcall) = $config_error(S, pconfigcall, "ArgumentCountError", $ptascii("register_shutdown_function() expects at least 1 argument, 0 given"))
  -- if pconfigcall.KIND = INTRINSIC_REGISTER_SHUTDOWN_FUNCTION
  -- if ~$shutdown_unknown_named(S, pconfigcall)
  -- if pconfigcall.SENT = eps
def $error_api_arity(S, pconfigcall) = $config_error(S, pconfigcall, "ArgumentCountError", $ptascii("register_shutdown_function(): Argument #1 ($callback) not passed"))
  -- if pconfigcall.KIND = INTRINSIC_REGISTER_SHUTDOWN_FUNCTION
  -- if ~$shutdown_unknown_named(S, pconfigcall)
  -- if pconfigcall.SENT = NAMED_HOLE :: pnamedslot*

def $shutdown_values(eps) = eps
def $shutdown_values((NAMED_SENT (KNOWN pvalue)) :: pnamedslot*) = pvalue :: $shutdown_values(pnamedslot*)
def $error_api_body(S, pconfigcall) = $shutdown_register(S, pconfigcall, $error_api_value(pconfigcall, 0, PNULL)) -- if pconfigcall.KIND = INTRINSIC_REGISTER_SHUTDOWN_FUNCTION
def $shutdown_register(S, pconfigcall, pvalue) = S[.SHUTDOWN.ENTRIES = S.SHUTDOWN.ENTRIES ++ [pshutdownentry]][.RESULT = KNOWN PNULL]
  -- if ~$exception_deprecated_raw(S, pvalue)
  -- if $error_handler_resolution(S, pvalue) = HANDLERRESOLVED pcalltarget
  -- if pconfigcall.SENT = (NAMED_SENT (KNOWN pvalue)) :: pnamedslot*
  -- if pshutdownentry = {CALL pconfigcall, CAPTURE $method_capture_current(S, pconfigcall.SITE), PRODUCER eps, RAW $shutdown_snapshot(S, pvalue), TARGET pcalltarget, ARGS $shutdown_values(pnamedslot*)}
def $shutdown_register(S, pconfigcall, pvalue) = $config_error(S, pconfigcall, "TypeError", $ptascii("register_shutdown_function(): Argument #1 ($callback) must be a valid callback, ") ++ ptbytes)
  -- if ~$exception_deprecated_raw(S, pvalue)
  -- if $error_handler_resolution(S, pvalue) = HANDLERINVALID ptbytes
def $shutdown_register(S, pconfigcall, pvalue) = S[.COMPLETION = UNSUPPORTED "shutdown callback outside admitted source callable forms"]
  -- if ~$exception_deprecated_raw(S, pvalue)
  -- if $error_handler_resolution(S, pvalue) = HANDLERUNKNOWN text
def $shutdown_register(S, pconfigcall, pvalue) = S[.COMPLETION = UNSUPPORTED "shutdown keyword/compound callback ingress requires effectful API resolution"]
  -- if $exception_deprecated_raw(S, pvalue)

dec $shutdown_render_chain_warning(pstate, nat, nat*) : bool
dec $shutdown_render_origin(pstate, nat) : porigin
dec $shutdown_render_base(pstate, nat) : preqbytes
dec $shutdown_render_begin(pstate, nat) : pstate
dec $shutdown_render_valid(pstate, pshutdownrender) : bool
dec $shutdown_render_pending_valid(pstate, pshutdownrender) : bool
dec $shutdown_render_message(pstate, nat, preqbytes) : preqbytes
dec $shutdown_render_trace(pstate, pshutdownrender) : preqbytes
dec $shutdown_render_piece(pstate, pshutdownrender) : preqbytes
dec $shutdown_render_join(pstate, pshutdownrender) : preqbytes
dec $shutdown_render_next(pstate, pshutdownrender) : nat?
dec $shutdown_render_finish(pstate, pshutdownrender) : pstate
dec $shutdown_render_warning_message(pstate, pshutdownrender) : preqbytes
dec $shutdown_render_warning(pstate, pshutdownrender) : pstate
dec $shutdown_render_frame_call(pstate, pframe, pframe*) : pshutdownrender?
dec $shutdown_render_array_value(pvalue) : bool
dec $shutdown_render_root_message(pshutdownrender, preqbytes) : preqbytes
dec $shutdown_render_message_prefix(preqbytes) : preqbytes
dec $shutdown_render_value(pvalue) : preqbytes
dec $shutdown_render_path(pstate, nat, nat, nat*) : bool
dec $shutdown_compiler_snapshot(pcompletion) : pcompletion?

;; Registration facts stay valid after subsequent selections or maker retirement.
def $shutdown_registration_valid(S, pconfigcall) = true
  -- if pconfigcall.KIND = INTRINSIC_REGISTER_SHUTDOWN_FUNCTION
  -- if pconfigcall.OWNER = eps /\ pconfigcall.SELECTION = eps
  -- if $exit_fixed(S, pconfigcall.SITE) = ((preqbytes, preqbytes_fallback?))
  -- if $intrinsic_lookup(preqbytes, preqbytes_fallback?) = (pconfigcall.KIND)
  -- if $call_line_valid(S, (pconfigcall.SITE), pconfigcall.LINE)
def $shutdown_registration_valid(S, pconfigcall) = true
  -- if pconfigcall.KIND = INTRINSIC_REGISTER_SHUTDOWN_FUNCTION
  -- if pconfigcall.OWNER = eps
  -- if pconfigcall.SELECTION = (n)
  -- if $(n < |S.SELECTEDCALLS|)
  -- if S.SELECTEDCALLS[n] = pselectedcall
  -- if pselectedcall.NONCE = n /\ pselectedcall.SITE = pconfigcall.SITE
  -- if pselectedcall.KIND = pconfigcall.KIND /\ pselectedcall.LINE = pconfigcall.LINE
  -- if $selected_entry_source_valid(S, pselectedcall)
def $shutdown_registration_valid(S, pconfigcall) = true
  -- if pconfigcall.KIND = INTRINSIC_REGISTER_SHUTDOWN_FUNCTION
  -- if pconfigcall.OWNER = (n)
  -- if pconfigcall.SELECTION = eps
  -- if $(n < |S.OBJECTS|)
  -- if S.OBJECTS[n] = INTRINSICCLOSURE pconfigcall.KIND
  -- if ($exit_fixed(S, pconfigcall.SITE) = eps /\ $exit_dynamic_site(S, pconfigcall.SITE)) \/ $exit_method_site(S, pconfigcall.SITE)
  -- if $call_line_valid(S, (pconfigcall.SITE), pconfigcall.LINE)
def $shutdown_registration_valid(S, pconfigcall) = false -- otherwise
def $shutdown_selection_scope(S, pshutdownentry) = true
  -- if pshutdownentry.TARGET = HANDLER_METHOD_TARGET b_class porigin ptbytes (SCOPE_METHOD_TARGET pcalltarget pcallableaccess)
  -- if pcallableaccess.SITE = eps /\ pcallableaccess.CREATION = eps
  -- if $shutdown_capture_valid(S, pshutdownentry.CALL.SITE, pshutdownentry.CAPTURE)
  -- if pcallableaccess.SCOPE = $shutdown_capture_scope(S, pshutdownentry.CALL.SITE, pshutdownentry.CAPTURE)
def $shutdown_selection_scope(S, pshutdownentry) = true -- if ~$shutdown_scoped_target(pshutdownentry.TARGET)
def $shutdown_scoped_target(HANDLER_METHOD_TARGET b_class porigin ptbytes (SCOPE_METHOD_TARGET pcalltarget pcallableaccess)) = true
def $shutdown_scoped_target(pcalltarget) = false -- otherwise
def $shutdown_capture_scope(S, porigin, eps) = $closure_source_class(S, porigin)
def $shutdown_capture_scope(S, porigin, (pmethodcapture)) = pmethodcapture.LEXICAL_CLASS
def $shutdown_capture_valid(S, porigin_site, eps) = true
def $shutdown_capture_valid(S, porigin_site, (pmethodcapture)) = true
  -- if $closure_nearest_owner(S, $closure_creation_owners($all_functions(S), porigin_site), eps) = (pmethodcapture.FUNCTION)
  -- if $method_capture_template(S, pmethodcapture.FUNCTION)
  -- if pmethodcapture.LEXICAL_CLASS =/= $closure_source_class(S, porigin_site) \/ $method_capture_called_scope(S, porigin_site, pmethodcapture)
  -- if $method_capture_class_valid(S, pmethodcapture.LEXICAL_CLASS)
  -- if $method_capture_class_valid(S, pmethodcapture.CALLED_CLASS)
  -- if pmethodcapture.CALLSITE = (porigin_call)
  -- if $method_capture_invocation_valid(S, pmethodcapture, porigin_call)
def $shutdown_capture_valid(S, porigin_site, (pmethodcapture)) = true
  -- if $trait_imported_origin(pmethodcapture.FUNCTION)
  -- if $method_capture_certificate_valid(S, porigin_site, (pmethodcapture))
def $shutdown_capture_valid(S, porigin_site, pmethodcapture?) = false -- otherwise
def $shutdown_selection_scope(S, pshutdownentry) = false -- otherwise
def $shutdown_entry_valid(S, pshutdownentry) = true
  -- if $shutdown_registration_valid(S, pshutdownentry.CALL)
  -- if pshutdownentry.CALL.SENT = (NAMED_SENT (KNOWN pvalue)) :: pnamedslot*
  -- if pshutdownentry.ARGS = $shutdown_values(pnamedslot*)
  -- if $exception_raw_selected(S, pvalue, pshutdownentry.RAW, pshutdownentry.TARGET)
  -- if $shutdown_selection_scope(S, pshutdownentry)
  -- if $target_function(S, pshutdownentry.TARGET) = (pfunction)
  -- if $shutdown_args_valid(S, pshutdownentry.ARGS)
def $shutdown_entry_valid(S, pshutdownentry) = false -- otherwise
def $shutdown_entries_valid(S, eps) = true
def $shutdown_entries_valid(S, pshutdownentry :: pshutdownentry_tail*) = ($shutdown_entry_valid(S, pshutdownentry) /\ $shutdown_entries_valid(S, pshutdownentry_tail*))
def $shutdown_roots(eps) = eps
def $shutdown_roots(pshutdownentry :: pshutdownentry_tail*) = $target_nodes(pshutdownentry.TARGET) ++ $operands_roots($shutdown_known(pshutdownentry.ARGS)) ++ $shutdown_roots(pshutdownentry_tail*)

def $shutdown_known(eps) = eps
def $shutdown_known(pvalue :: pvalue_tail*) = (KNOWN pvalue) :: $shutdown_known(pvalue_tail*)
def $shutdown_args_valid(S, eps) = true
def $shutdown_args_valid(S, pvalue :: pvalue_tail*) = ($config_slots_valid(S, [NAMED_SENT (KNOWN pvalue)]) /\ $shutdown_args_valid(S, pvalue_tail*))

;; Snapshot terminal reporting before shutdown callbacks can mutate its inputs.
def $shutdown_reported(S, preqbytes_class, preqbytes_message, z, preqbytes, true) = S[.COMPLETION = REQUESTFATAL preqbytes_class preqbytes_message z][.EVENTS = S.EVENTS ++ $display_events(S, STDERR preqbytes)]
def $shutdown_reported(S, preqbytes_class, preqbytes_message, z, preqbytes, false) = S[.COMPLETION = REQUESTFATAL preqbytes_class preqbytes_message z]
def $shutdown_file(S) = $call_sourcefile(S.FILES, porigin) -- if S.ERRORORIGIN = (porigin)
def $shutdown_file(S) = $call_sourcefile(S.FILES, PORIGIN 0 eps) -- if S.ERRORORIGIN = eps
def $shutdown_fatal_suffix(S, true) = [10] ++ $ptascii("Stack trace:") ++ [10] ++ $error_trace_lines(S, S.TRACE, 0) ++ [10]
def $shutdown_fatal_suffix(S, false) = [10]
def $shutdown_exception_suffix(S, n) = [10] ++ $ptascii("  thrown in ") ++ preqbytes_file ++ $ptascii(" on line ") ++ $decimal_integer(z) ++ [10]
  -- if $throwable_field(S, n, "file") = PSTRING preqbytes_file
  -- if $throwable_field(S, n, "line") = PINT z
def $shutdown_freeze_marked(S) = S -- if S.COMPLETION = NORMAL \/ $exit_completion(S.COMPLETION) \/ $shutdown_frozen(S.COMPLETION)
def $shutdown_freeze_marked(S) = $shutdown_reported(S, $object_name(S, n), $echo_value($throwable_field(S, n, "message")), z, $ptascii("Fatal error: Uncaught ") ++ $throwable_chain_string(S, n, eps) ++ $shutdown_exception_suffix(S, n), $long_and(S.REPORTING, 1) =/= 0)
  -- if S.COMPLETION = UNCAUGHT n
  -- if $object_name(S, n) =/= $ptascii("ParseError") /\ $object_name(S, n) =/= $ptascii("CompileError")
  -- if $throwable_field(S, n, "line") = PINT z
def $shutdown_freeze_marked(S) = $shutdown_reported(S, $object_name(S, n), ptbytes_message, z, ptbytes_prefix ++ ptbytes_message ++ $ptascii(" in ") ++ ptbytes_file ++ $ptascii(" on line ") ++ $decimal_integer(z) ++ [10], $long_and(S.REPORTING, i) =/= 0)
  -- if S.COMPLETION = UNCAUGHT n
  -- if (i, ptbytes_prefix) = $shutdown_parse_kind($object_name(S, n))
  -- if ptbytes_message = $echo_value($throwable_field(S, n, "message"))
  -- if $throwable_field(S, n, "line") = PINT z
  -- if $throwable_field(S, n, "file") = PSTRING ptbytes_file
def $shutdown_freeze_marked(S) = $shutdown_reported(S, $object_name(S, n), ptbytes, z, $ptascii("Fatal error: Uncaught ") ++ ptbytes ++ $shutdown_exception_suffix(S, n), $long_and(S.REPORTING, 1) =/= 0)
  -- if S.COMPLETION = UNCAUGHT_RENDERED n ptbytes
  -- if $throwable_field(S, n, "line") = PINT z
def $shutdown_freeze_marked(S) = $shutdown_reported(S, $ptascii("Error"), ptbytes, z, $ptascii("Fatal error: ") ++ ptbytes ++ $ptascii(" in ") ++ $shutdown_file(S) ++ $ptascii(" on line ") ++ $decimal_integer(z) ++ $shutdown_fatal_suffix(S, S.TRACE =/= eps), b)
  -- if S.COMPLETION = USERFATAL ptbytes z b
def $shutdown_freeze_marked(S) = $shutdown_reported(S, $ptascii("Error"), ptbytes, 0, $ptascii("Fatal error: ") ++ ptbytes ++ $ptascii(" in Unknown on line 0") ++ $shutdown_fatal_suffix(S, true), b)
  -- if S.COMPLETION = INTERNALFATAL ptbytes b
def $shutdown_freeze_marked(S) = $shutdown_reported(S, $ptascii("Error"), ptbytes, z, $ptascii("Fatal error: ") ++ ptbytes ++ $ptascii(" in ") ++ $shutdown_file(S) ++ $ptascii(" on line ") ++ $decimal_integer(z) ++ $shutdown_fatal_suffix(S, true), $long_and(S.REPORTING, 1) =/= 0)
  -- if S.COMPLETION = FATAL ptbytes z
def $shutdown_freeze_marked(S) = $shutdown_reported(S, $ptascii("CompileError"), ptbytes, z, $ptascii("Fatal error: ") ++ ptbytes ++ $ptascii(" in ") ++ $shutdown_file(S) ++ $ptascii(" on line ") ++ $decimal_integer(z) ++ $shutdown_fatal_suffix(S, true), $long_and(S.REPORTING, 64) =/= 0)
  -- if S.COMPLETION = STATICBYTES ptbytes z
def $shutdown_freeze_marked(S) = $shutdown_reported(S, $ptascii("CompileError"), ptbytes, z, $ptascii("Fatal error: ") ++ ptbytes ++ $ptascii(" in ") ++ $shutdown_file(S) ++ $ptascii(" on line ") ++ $decimal_integer(z) ++ $shutdown_fatal_suffix(S, false), $long_and(S.REPORTING, 64) =/= 0)
  -- if S.COMPLETION = COMPILETHROWN ptbytes z
def $shutdown_freeze_marked(S) = $shutdown_reported(S, $ptascii("CompileError"), $ptascii(text), z, $ptascii("Fatal error: ") ++ $ptascii(text) ++ $ptascii(" in ") ++ $shutdown_file(S) ++ $ptascii(" on line ") ++ $decimal_integer(z) ++ $shutdown_fatal_suffix(S, true), $long_and(S.REPORTING, 64) =/= 0)
  -- if S.COMPLETION = STATICERROR text z

def $shutdown_frozen(REQUESTFATAL ptbytes_class ptbytes_message z) = true
def $shutdown_frozen(pcompletion) = false -- otherwise
def $shutdown_terminal(NORMAL) = true
def $shutdown_terminal(EXITED z) = true
def $shutdown_terminal(UNCAUGHT n) = true
def $shutdown_terminal(UNCAUGHT_RENDERED n ptbytes) = true
def $shutdown_terminal(FATAL ptbytes z) = true
def $shutdown_terminal(USERFATAL ptbytes z b) = true
def $shutdown_terminal(INTERNALFATAL ptbytes b) = true
def $shutdown_terminal(STATICERROR text z) = true
def $shutdown_terminal(STATICBYTES ptbytes z) = true
def $shutdown_terminal(COMPILETHROWN ptbytes z) = true
def $shutdown_terminal(pcompletion) = $shutdown_frozen(pcompletion) -- otherwise

def $shutdown_ready(S) = true
  -- if ~$eval_compile_exit_pending(S) \/ ~$exit_completion(S.COMPLETION)
  -- if S.SHUTDOWN.PHASE = SHUTDOWN_PENDING /\ S.SHUTDOWN.ENTRIES =/= eps
  -- if $shutdown_terminal(S.COMPLETION)
  -- if ~$shutdown_render_ready(S)
  -- if S.COMPLETION =/= NORMAL \/ S.TODO = eps
  -- if S.COMPILESTOP \/ S.FRAMES = eps
def $shutdown_ready(S) = true
  -- if ~$eval_compile_exit_pending(S) \/ ~$exit_completion(S.COMPLETION)
  -- if S.SHUTDOWN.PHASE = SHUTDOWN_RUNNING
  -- if S.COMPLETION =/= NORMAL /\ $shutdown_terminal(S.COMPLETION)
  -- if ~$shutdown_render_ready(S)
  -- if S.COMPILESTOP \/ S.FRAMES = eps
def $shutdown_ready(S) = false -- otherwise
def $shutdown_abort_frames(S) = $shutdown_abort_frames($restore_frame($file_warning_drop_scope(S))) -- if S.FRAMES =/= eps
def $shutdown_abort_frames(S) = $file_warning_drop_scope(S) -- if S.FRAMES = eps
def $shutdown_clean(S) = $eval_compile_unwind($shutdown_render_release($error_release_iterators($release_temporaries($silence_unwind($shutdown_abort_frames(S))))[.CURRENT = eps][.TODO = eps][.CONSTCONTEXT = eps][.HELD = eps][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)][.ORIGIN = eps][.COMPILESTOP = false][.TRACE = eps][.ERRORFATALTRACE = eps][.ERRORORIGIN = eps]))
def $shutdown_begin(S) = S_clean[.SHUTDOWN.PHASE = SHUTDOWN_RUNNING][.SHUTDOWN.SENT = eps][.SHUTDOWN.RECEIVED = eps][.SHUTDOWN.COMPLETION = S_report.COMPLETION][.COMPLETION = NORMAL][.TODO = [SHUTDOWN_SEND 0 0 eps]]
  -- if S_report = $shutdown_freeze(S)
  -- if S_clean = $shutdown_clean(S_report)
def $shutdown_stop(S) = S_clean[.SHUTDOWN.PHASE = SHUTDOWN_DONE][.SHUTDOWN.SENT = eps][.SHUTDOWN.RECEIVED = eps]
  -- if S_clean = $shutdown_clean($shutdown_freeze(S))
def $drive_steps(S, n) = $drive_steps($prune_allocations($shutdown_begin(S)), n)
  -- if $shutdown_ready(S)
  -- if S.SHUTDOWN.PHASE = SHUTDOWN_PENDING
def $drive_steps(S, n) = $drive_steps($prune_allocations($shutdown_stop(S)), n)
  -- if $shutdown_ready(S)
  -- if S.SHUTDOWN.PHASE = SHUTDOWN_RUNNING

def $shutdown_state_valid(S) = true
  -- if $shutdown_entries_valid(S, S.SHUTDOWN.ENTRIES)
  -- if $(S.SHUTDOWN.INDEX <= |S.SHUTDOWN.ENTRIES|)
  -- if S.SHUTDOWN.COMPLETION = NORMAL \/ $exit_completion(S.SHUTDOWN.COMPLETION) \/ $shutdown_frozen(S.SHUTDOWN.COMPLETION)
  -- if S.SHUTDOWN.PHASE =/= SHUTDOWN_PENDING \/ (S.SHUTDOWN.INDEX = 0 /\ S.SHUTDOWN.COMPLETION = NORMAL)
  -- if $shutdown_current_sent_valid(S)
  -- if $shutdown_received_valid(S)
  -- if $shutdown_render_state_valid(S)
def $shutdown_state_valid(S) = false -- otherwise

;; C argument preparation precedes ordinary arity and weak type reception.
def $shutdown_task_scope(S) = (S.CURRENT = eps /\ S.FRAMES = eps /\ S.CONSTCONTEXT = eps)
def $shutdown_sent_valid(S, pshutdownentry, eps, n) = true
def $shutdown_sent_valid(S, pshutdownentry, (KNOWN pvalue) :: poperand*, n) = true
  -- if $(n < |pshutdownentry.ARGS|)
  -- if pshutdownentry.ARGS[n] = pvalue
  -- if ~$call_parameter_reference(S, pshutdownentry.TARGET, n)
  -- if $shutdown_sent_valid(S, pshutdownentry, poperand*, $(n + 1))
def $shutdown_sent_valid(S, pshutdownentry, (REFERENCE n_cell) :: poperand*, n) = true
  -- if $(n < |pshutdownentry.ARGS|) /\ $(n_cell < |S.STORE|)
  -- if n_cell <- S.REFCELLS
  -- if $call_parameter_reference(S, pshutdownentry.TARGET, n)
  -- if $shutdown_sent_valid(S, pshutdownentry, poperand*, $(n + 1))
def $shutdown_sent_valid(S, pshutdownentry, poperand*, n) = false -- otherwise
;; The current prefix is borrowed. It fixes genuine wrapper cells across rebinding.
def $shutdown_current_sent_valid(S) = true
  -- if S.SHUTDOWN.PHASE = SHUTDOWN_RUNNING
  -- if $(S.SHUTDOWN.INDEX < |S.SHUTDOWN.ENTRIES|)
