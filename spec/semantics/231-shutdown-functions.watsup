def $task_nodes(SHUTDOWN_RESULT n_index poperand*) = eps
def $call_after_origin(S, SHUTDOWN_RESULT n_index poperand*) = S[.ORIGIN = eps]
rule PhpStep/shutdown-result-next: S ~> S[.SHUTDOWN.INDEX = $(n_index + 1)][.SHUTDOWN.SENT = eps][.SHUTDOWN.RECEIVED = eps][.TODO = [SHUTDOWN_SEND $(n_index + 1) 0 eps]][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
