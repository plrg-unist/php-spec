def $throwable_marker(SHUTDOWN_RESULT n_index poperand*) = true
def $exception_terminal_tail(S, (SHUTDOWN_RESULT n_index poperand*) :: ptask_tail*) = $shutdown_result_valid(S, n_index, poperand*)
