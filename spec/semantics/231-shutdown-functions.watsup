def $shutdown_render_message(S, n, ptbytes) = $trace_display_message(pthrowable.KIND, ptbytes) -- if S.OBJECTS[n] = THROWABLE pthrowable
def $shutdown_render_message(S, n, ptbytes) = ptbytes -- otherwise
def $shutdown_render_trace(S, pshutdownrender) = $ptascii("#0 {main}") ++ [10] -- if pshutdownrender.PENDING =/= eps
def $shutdown_render_trace(S, pshutdownrender) = $trace_array_string(S, n_trace)
  -- if pshutdownrender.PENDING = eps
  -- if $throwable_field(S, pshutdownrender.CURRENT, "trace") = PARRAY n_trace
def $shutdown_render_piece(S, pshutdownrender) = $object_name(S, pshutdownrender.CURRENT) ++ ptbytes_message ++ $ptascii(" in ") ++ ptbytes_file ++ [58] ++ $decimal_integer(z) ++ [10] ++ $ptascii("Stack trace:") ++ [10] ++ $shutdown_render_trace(S, pshutdownrender)
  -- if ptbytes_message = $shutdown_render_message_prefix($shutdown_render_message(S, pshutdownrender.CURRENT, pshutdownrender.MESSAGE))
  -- if $throwable_field(S, pshutdownrender.CURRENT, "file") = PSTRING ptbytes_file
  -- if $throwable_field(S, pshutdownrender.CURRENT, "line") = PINT z
def $shutdown_render_message_prefix(eps) = eps
def $shutdown_render_message_prefix(ptbytes) = $ptascii(": ") ++ ptbytes -- if ptbytes =/= eps
def $shutdown_render_join(S, pshutdownrender) = $shutdown_render_piece(S, pshutdownrender) -- if pshutdownrender.TEXT = eps
def $shutdown_render_join(S, pshutdownrender) = $shutdown_render_piece(S, pshutdownrender) ++ [10,10] ++ $ptascii("Next ") ++ pshutdownrender.TEXT -- if pshutdownrender.TEXT =/= eps
def $shutdown_render_next(S, pshutdownrender) = (n)
  -- if $throwable_previous_id(S, pshutdownrender.CURRENT) = (n)
  -- if n =/= pshutdownrender.CURRENT /\ ~(n <- pshutdownrender.SEEN)
def $shutdown_render_next(S, pshutdownrender) = eps -- otherwise
