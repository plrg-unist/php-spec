def $shutdown_render_frame_call(S, pframe, pframe_tail*) = eps -- otherwise
def $shutdown_render_trace_frame(S, pframe, pframe_tail*) = [{FILE eps, LINE $(-1), FUNCTION $ptascii("__toString"), CLASS ($shutdown_render_base(S, pshutdownrender.ROOT)), TYPE ($ptascii("->")), ARGS eps, HASARGS true}]
  -- if $shutdown_render_frame_call(S, pframe, pframe_tail*) = (pshutdownrender)
def $shutdown_render_trace_frame(S, pframe, pframe_tail*) = eps -- otherwise

;; A fatal compiler cutoff remains authenticated after request shutdown clears
;; its ordinary execute state. Replay still checks the exact failed publications;
;; only this frozen request snapshot permits subsequent callback declarations.
def $shutdown_compiler_snapshot(FATAL ptbytes z) = (REQUESTFATAL $ptascii("Error") ptbytes z)
def $shutdown_compiler_snapshot(STATICBYTES ptbytes z) = (REQUESTFATAL $ptascii("CompileError") ptbytes z)
def $shutdown_compiler_snapshot(STATICERROR text z) = (REQUESTFATAL $ptascii("CompileError") $ptascii(text) z)
def $shutdown_compiler_snapshot(pcompletion) = eps -- otherwise
def $shutdown_compiler_released(S, S_compiled) = true
  -- if ~S.COMPILESTOP
  -- if S.SHUTDOWN.PHASE <- [SHUTDOWN_RUNNING, SHUTDOWN_DONE]
  -- if S.SHUTDOWN.ENTRIES =/= eps
  -- if $shutdown_state_valid(S)
  -- if $shutdown_compiler_snapshot(S_compiled.COMPLETION) = (pcompletion)
  -- if S.SHUTDOWN.COMPLETION = pcompletion \/ (S.SHUTDOWN.PHASE = SHUTDOWN_DONE /\ S.COMPLETION = pcompletion)
def $shutdown_compiler_released(S, S_compiled) = false -- otherwise

def $shutdown_freeze(S) = $shutdown_freeze_marked($request_fatal_state(S))
