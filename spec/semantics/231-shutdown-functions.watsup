def $shutdown_render_ready(S) = false -- otherwise
def $shutdown_render_release(S) = S[.SHUTDOWN.RENDER = eps]
def $shutdown_render_origin(S, n) = porigin -- if S.OBJECTS[n] = THROWABLE pthrowable -- if pthrowable.ORIGIN = (porigin)
def $shutdown_render_origin(S, n) = porigin -- if S.OBJECTS[n] = INSTANCE porigin
def $shutdown_render_base(S, n) = $ptascii($throwable_base(pthrowable.KIND)) -- if S.OBJECTS[n] = THROWABLE pthrowable
def $shutdown_render_base(S, n) = $ptascii($throwable_base(text_kind))
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $class_throwable_kind(S, porigin, |S.CLASSES|) = (text_kind)
def $shutdown_render_begin(S, n) = S_clean[.SHUTDOWN.RENDER = (pshutdownrender)][.TODO = [SHUTDOWN_RENDER pshutdownrender]][.ORIGIN = ($shutdown_render_origin(S, n))][.COMPLETION = NORMAL]
