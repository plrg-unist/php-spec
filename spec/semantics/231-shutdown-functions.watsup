  -- if pcallcontext_other? =/= (pcallcontext)
def $shutdown_context_call(pcallcontext, pcallcontext_other?, pframe*) = eps -- otherwise
def $shutdown_context_kind(S, pcallcontext) = ($shutdown_context_call(pcallcontext, S.CURRENT, S.FRAMES) =/= eps)
def $shutdown_context_valid(S, pcallcontext) = true
