dec $invoke_capture_source(pstate, porigin) : bool
;; Closure::__invoke(...) captures an owned alias of the selected Closure.
;; Calling it enters the original closure directly, retaining its lexical
;; scope, static cells and trace function name.
def $invoke_capture(S, n_source, (porigin_site)) = S[.TODO = ptask_tail*][.RESULT = KNOWN (POBJECT n_source)][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = ptask :: ptask_tail*
  -- if $invoke_capture_source(S, porigin_site)
  -- if $closure_callable(S, n_source)

def $invoke_capture_source(S, porigin_site) = true
