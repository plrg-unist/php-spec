;; The initial script owns one op-array static table. Aggregate unit code also
;; contains nested functions, so a MAIN slot must be outside their source paths.
dec $main_static_function(pcnode, pcpath, pcpath) : bool
def $main_static_function(NStmtFunction phpType14 phpType4 phpType11 phpType16 phpType18 phpType23 metadata, pcpath_function, pcpath) = $effect_below(pcpath_function, pcpath)
def $main_static_function(pcnode, pcpath_function, pcpath) = false -- otherwise
dec $main_static_nested(pcoccurrence*, pcpath) : bool
def $main_static_nested(eps, pcpath) = false
def $main_static_nested((PCOCCURRENCE pcpath_node pcnode) :: pcoccurrence*, pcpath) = ($main_static_function(pcnode, pcpath_node, pcpath) \/ $main_static_nested(pcoccurrence*, pcpath))

