  -- if n_prefix = |S.DECLARATIONS|
  -- if n_history = |S.CLASSCONSTANTHISTORY ++ pclassconstantevent*|
  -- if pinstanceglobalcertificate = {TARGET porigin_class, DECL pstaticdefaultcontext.DECL, ROOT pstaticdefaultcontext.ROOT, TRIGGER porigin_trigger, SELECTION $class_static_selection_at(S.TODO), VALUE pvalue, CLASS pvalueclass, PREFIX n_prefix, HISTORY n_history, FACTS pconstantcontext.FACTS}
def $class_constant_event_ordinal(CCINSTANCE_LOOKUP pinstanceglobalcertificate) = pinstanceglobalcertificate.PREFIX
def $class_constant_compile_events(S, (CCINSTANCE_LOOKUP pinstanceglobalcertificate) :: pclassconstantevent*, S_entry) = $class_constant_compile_events(S, pclassconstantevent*, S_entry)
def $class_constant_history_fills(S, (CCINSTANCE_LOOKUP pinstanceglobalcertificate) :: pclassconstantevent*, (porigin_flag, b_flag)*, porigin_cached*, porigin_filled*, n_previous) = $class_constant_history_fills(S, pclassconstantevent*, (porigin_flag, b_flag)*, porigin_cached*, porigin_filled*, pinstanceglobalcertificate.PREFIX)
