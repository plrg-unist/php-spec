def $instance_global_value_valid(S, ppropertydesc, pvalue, pvalueclass, pconstantfact*) = (puserconstant.VALUE = pvalue)
  -- if ppropertydesc.ORIGIN = porigin_decl
  -- if ppropertydesc.DEFAULT = PROP_DEFERRED porigin_initializer
