dec $instance_global_certificate(pinstanceobjectcertificate) : pinstanceglobalcertificate?
def $instance_global_certificate(INSTANCE_GLOBAL_BIND pinstanceglobalcertificate) = (pinstanceglobalcertificate)
def $instance_global_certificate(INSTANCE_OBJECT_COPY porigin n pinstanceobjectcertificate) = $instance_global_certificate(pinstanceobjectcertificate)
def $instance_global_certificate(pinstanceobjectcertificate) = eps -- otherwise
def $instance_object_certificate_prefix(S, INSTANCE_GLOBAL_BIND pinstanceglobalcertificate) = ($(pinstanceglobalcertificate.HISTORY + 1))
def $instance_object_certificate_valid(S, INSTANCE_GLOBAL_BIND pinstanceglobalcertificate, porigin_class, porigin_decl, pvalueclass) = (pinstanceglobalcertificate.TARGET = porigin_class /\ pinstanceglobalcertificate.DECL = porigin_decl /\ pinstanceglobalcertificate.CLASS = pvalueclass /\ $instance_global_record_valid(S, pinstanceglobalcertificate))
def $instance_object_payload_valid(S, pinstanceobjectcertificate, pvalue) = (pvalue = pinstanceglobalcertificate.VALUE)
  -- if $instance_global_certificate(pinstanceobjectcertificate) = (pinstanceglobalcertificate)
def $instance_default_transfer_valid(S, pinstancetemplate, ppropertydesc, pvalueclass) = true
