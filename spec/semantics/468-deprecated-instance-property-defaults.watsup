;; Instance initialization precedes object allocation. The recipient is a
;; class-qualified template, and a later object gets its own property copy.
dec $owned_instance_source(pstate, ppropertydesc) : bool
def $owned_instance_source(S, ppropertydesc) = (~ppropertydesc.STATIC /\ $owned_property_source(S, ppropertydesc))
