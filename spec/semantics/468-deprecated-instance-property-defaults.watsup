dec $instance_publication_head(pstate, ptask, porigin, porigin) : bool
dec $instance_publication_tasks(pstate, ptask*, porigin, porigin) : bool
def $instance_publication_head(S, INSTANCE_DEFAULT_PUBLISH porigin_target pstaticdefaultcontext pvalue pvalueclass, porigin_class, porigin_decl) = (porigin_target = porigin_class /\ pstaticdefaultcontext.DECL = porigin_decl /\ $instance_publication_valid(S, porigin_target, pstaticdefaultcontext, pvalue, pvalueclass))
