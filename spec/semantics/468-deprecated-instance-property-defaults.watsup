def $instance_global_value_valid(S, ppropertydesc, pvalue, pvalueclass, pconstantfact_saved*) = (puserconstant.VALUE = pvalue)
  -- if ppropertydesc.ORIGIN = porigin_decl
  -- if ppropertydesc.DEFAULT = PROP_DEFERRED porigin_initializer
  -- if $owned_instance_lookup_required(S, porigin_decl, {ORIGIN porigin_initializer, VALUE eps, CLASS pvalueclass, LOOKUP eps})
  -- if $constant_fact_at(pconstantfact_saved*, porigin_initializer) = (pconstantfact)
  -- if pconstantfact.CLASS = pvalueclass
  -- if $global_constant_lookup_valid(S, porigin_decl, pconstantfact, S.USERCONSTANTS)
  -- if pconstantfact.LOOKUP = (pconstantlookup)
  -- if $global_constant_alias(S, S.USERCONSTANTS[0:pconstantlookup.PREFIX], porigin_initializer) = (puserconstant)
def $instance_global_value_valid(S, ppropertydesc, pvalue, pvalueclass, pconstantfact*) = false -- otherwise
dec $instance_global_history_facts_valid(pstate, porigin, pconstantfact*) : bool
def $instance_global_history_facts_valid(S, porigin_decl, eps) = true
def $instance_global_history_facts_valid(S, porigin_decl, pconstantfact :: pconstantfact_tail*) = ($constant_expression_below(S, porigin_decl, pconstantfact.ORIGIN) /\ $constant_fact_value_valid(pconstantfact) /\ $constant_fact_pool_valid(S, pconstantfact) /\ $global_constant_fact_lookup_valid(S, porigin_decl, pconstantfact) /\ $constant_fact_at(pconstantfact_tail*, pconstantfact.ORIGIN) = eps /\ $instance_global_history_facts_valid(S, porigin_decl, pconstantfact_tail*))
