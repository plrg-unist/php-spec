def $instance_publication_frames(S, pframe :: pframe_tail*, porigin_class, porigin_decl) = ($instance_publication_tasks($constant_frame_scope(S, pframe, pframe_tail*), pframe.TODO, porigin_class, porigin_decl) \/ $instance_publication_frames(S, pframe_tail*, porigin_class, porigin_decl))
dec $instance_publication_row_valid(pstate, pinstancetemplate) : bool
def $instance_publication_row_valid(S, pinstancetemplate) = ($instance_publication_tasks(S, S.TODO, pinstancetemplate.CLASS, pinstancetemplate.DECL) \/ $instance_publication_frames(S, S.FRAMES, pinstancetemplate.CLASS, pinstancetemplate.DECL))
def $instance_default_row_state_valid(S, pinstancetemplate, ppropertydesc) = $instance_publication_row_valid(S, pinstancetemplate)
  -- if pinstancetemplate.STATE = INSTANCE_BINDING
def $instance_default_history_payload(S, pinstancetemplate) = $instance_publication_row_valid(S, pinstancetemplate)
  -- if pinstancetemplate.STATE = INSTANCE_BINDING
def $call_task_valid(S, INSTANCE_DEFAULT_PUBLISH porigin pstaticdefaultcontext pvalue pvalueclass) = $instance_publication_valid(S, porigin, pstaticdefaultcontext, pvalue, pvalueclass)
def $instance_default_commit(S, porigin_target, pstaticdefaultcontext, ppropertydesc, pvalue, pvalueclass, ptask_tail*) = $destructor_release_begin(S_stage, $destruction_values($value_nodes(pvalue_old)))
  -- if $owned_instance_source(S, ppropertydesc)
  -- if $instance_default_at(S.INSTANCEDEFAULTS, porigin_target, pstaticdefaultcontext.DECL) = (pinstancetemplate)
  -- if $instance_default_value(pinstancetemplate.STATE) = ((pvalue_old, pvalueclass_old))
  -- if $value_nodes(pvalue_old) =/= eps
  -- if S_stage = S[.INSTANCEDEFAULTS = $instance_default_set(S.INSTANCEDEFAULTS, porigin_target, pstaticdefaultcontext.DECL, INSTANCE_BINDING)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)][.TODO = (INSTANCE_DEFAULT_PUBLISH porigin_target pstaticdefaultcontext pvalue pvalueclass) :: ptask_tail*]
dec $instance_publication_finish(pstate, porigin, pstaticdefaultcontext, pvalue, pvalueclass) : pstate
def $instance_publication_finish(S, porigin_target, pstaticdefaultcontext, pvalue, pvalueclass) = $static_default_restore($instance_default_bound(S, porigin_target, pstaticdefaultcontext, ppropertydesc, pvalue, pvalueclass)[.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], pstaticdefaultcontext)
  -- if $property_default_active_desc(S, pstaticdefaultcontext.DECL) = (ppropertydesc)
def $instance_publication_finish(S, porigin_target, pstaticdefaultcontext, pvalue, pvalueclass) = S -- otherwise
rule PhpStep/instance-default-publish: S ~> $instance_publication_finish(S[.TODO = ptask_tail*], porigin_target, pstaticdefaultcontext, pvalue, pvalueclass)
  -- if S.TODO = (INSTANCE_DEFAULT_PUBLISH porigin_target pstaticdefaultcontext pvalue pvalueclass) :: ptask_tail*
  -- if $instance_publication_valid(S, porigin_target, pstaticdefaultcontext, pvalue, pvalueclass)
def $call_after_origin(S, INSTANCE_DEFAULT_PUBLISH porigin_target pstaticdefaultcontext pvalue pvalueclass) = $instance_publication_finish(S, porigin_target, pstaticdefaultcontext, pvalue, pvalueclass)
def $return_discard(S, INSTANCE_DEFAULT_PUBLISH porigin_target pstaticdefaultcontext pvalue pvalueclass) = S[.TODO = (INSTANCE_DEFAULT_PUBLISH porigin_target pstaticdefaultcontext pvalue pvalueclass) :: S.TODO][.COMPLETION = UNSUPPORTED "uncertified instance-default old-release abrupt completion"]
  -- if $instance_default_at(S.INSTANCEDEFAULTS, porigin_target, pstaticdefaultcontext.DECL) = (pinstancetemplate)
  -- if pinstancetemplate.STATE = INSTANCE_BINDING
def $property_template_state(S, porigin_target, ppropertydesc) = eps
  -- if ppropertydesc.ORIGIN = porigin_decl
  -- if $instance_default_at(S.INSTANCEDEFAULTS, porigin_target, porigin_decl) = (pinstancetemplate)
  -- if pinstancetemplate.STATE = INSTANCE_BINDING
rule PhpStep/instance-default-update-releasing: S ~> S[.COMPLETION = UNSUPPORTED "instance default template release"]
  -- if S.TODO = (INSTANCE_DEFAULT_UPDATE porigin_target porigin_decl z) :: ptask*
  -- if $instance_default_at(S.INSTANCEDEFAULTS, porigin_target, porigin_decl) = (pinstancetemplate)
  -- if pinstancetemplate.STATE = INSTANCE_BINDING
dec $instance_default_class_releasing(pinstancetemplate*, porigin) : bool
def $instance_default_class_releasing(eps, porigin) = false
def $instance_default_class_releasing(pinstancetemplate :: pinstancetemplate_tail*, porigin) = ((pinstancetemplate.CLASS = porigin /\ pinstancetemplate.STATE = INSTANCE_BINDING) \/ $instance_default_class_releasing(pinstancetemplate_tail*, porigin))
def $runtime_class_link_result(S, S_result, pclassdesc) = S[.COMPLETION = UNSUPPORTED "instance default template release"]
  -- if S_result.COMPLETION = NORMAL
  -- if $class_link_at(S_result.LINKEDPARENTS, pclassdesc.ORIGIN) = (SOURCE_PARENT porigin_parent)
  -- if $instance_default_class_releasing(S.INSTANCEDEFAULTS, porigin_parent)

dec $instance_publication_abrupt_tail(pstate, ptask*) : bool
def $instance_publication_abrupt_tail(S, (DESTRUCTOR_RESULT pdestructorcall) :: ptask*) = true
  -- if S.TODO = (THROW_SEARCH n) :: (DESTRUCTOR_RESULT pdestructorcall) :: ptask*
  -- if ~pdestructorcall.USER /\ ~pdestructorcall.STORE /\ pdestructorcall.RELEASE =/= eps
  -- if $destructor_result_valid(S, pdestructorcall)
  -- if pdestructorcall.CONSTCONTEXT = (pconstantcontext)
  -- if $instance_default_context_at(S.TODO) = (porigin_target)
  -- if $instance_publication_tasks(S, S.TODO, porigin_target, pconstantcontext.ORIGIN)
def $instance_publication_abrupt_tail(S, (DESTRUCTOR_C_RETURN pdestructorcall) :: (DESTRUCTOR_RESULT pdestructorcall) :: ptask*) = true
  -- if S.TODO = (THROW_SEARCH n) :: (DESTRUCTOR_C_RETURN pdestructorcall) :: (DESTRUCTOR_RESULT pdestructorcall) :: ptask*
  -- if ~pdestructorcall.STORE /\ pdestructorcall.RELEASE =/= eps
  -- if $destructor_c_return_valid(S, pdestructorcall)
  -- if pdestructorcall.CONSTCONTEXT = (pconstantcontext)
  -- if $instance_default_context_at(S.TODO) = (porigin_target)
  -- if $instance_publication_tasks(S, S.TODO, porigin_target, pconstantcontext.ORIGIN)
def $instance_publication_abrupt_tail(S, ptask*) = false -- otherwise
def $class_write_abrupt_tail(S, ptask*) = true
  -- if $instance_publication_abrupt_tail(S, ptask*)
def $class_write_abrupt_reason(S) = "uncertified instance-default old-release abrupt completion"
