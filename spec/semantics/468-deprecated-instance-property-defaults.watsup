  -- if $instance_object_payload_valid(S, pinstanceobjectcertificate, pvalue)
def $instance_default_bound(S, porigin_class, pstaticdefaultcontext, ppropertydesc, pvalue, pvalueclass) = S[.INSTANCEDEFAULTS = $instance_default_set(S.INSTANCEDEFAULTS, porigin_class, pstaticdefaultcontext.DECL, INSTANCE_OBJECT_VALUE pvalue pvalueclass (INSTANCE_GLOBAL_BIND pinstanceglobalcertificate))][.CLASSCONSTANTHISTORY = S.CLASSCONSTANTHISTORY ++ pclassconstantevent* ++ [CCINSTANCE_LOOKUP pinstanceglobalcertificate]]
