def $instance_publication_tasks(S, eps, porigin_class, porigin_decl) = false
def $instance_publication_tasks(S, ptask :: ptask_tail*, porigin_class, porigin_decl) = ($instance_publication_head(S, ptask, porigin_class, porigin_decl) \/ $instance_publication_tasks(S, ptask_tail*, porigin_class, porigin_decl))
