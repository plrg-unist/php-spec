;; History records borrow values. Validation here uses source and frozen read
;; facts; it does not require a retired template container to remain allocated.
dec $instance_global_value_valid(pstate, ppropertydesc, pvalue, pvalueclass, pconstantfact*) : bool
def $instance_global_value_valid(S, ppropertydesc, pvalue, pvalueclass, pconstantfact*) = true
