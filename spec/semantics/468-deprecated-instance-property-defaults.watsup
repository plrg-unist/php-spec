;; One publication task protects the new value while the previous template's
;; ownership is released. The marker and historical certificate own nothing.
def $instance_default_roots(pinstancetemplate :: pinstancetemplate_tail*) = $instance_default_roots(pinstancetemplate_tail*)
  -- if pinstancetemplate.STATE = INSTANCE_BINDING
def $task_nodes(INSTANCE_DEFAULT_PUBLISH porigin pstaticdefaultcontext pvalue pvalueclass) = $value_nodes(pvalue)
def $static_default_context_at((INSTANCE_DEFAULT_PUBLISH porigin pstaticdefaultcontext pvalue pvalueclass) :: ptask*) = (pstaticdefaultcontext)
def $static_default_bind_marker(INSTANCE_DEFAULT_PUBLISH porigin pstaticdefaultcontext pvalue pvalueclass) = true
def $static_default_binding_head((INSTANCE_DEFAULT_PUBLISH porigin pstaticdefaultcontext pvalue pvalueclass) :: ptask*, porigin_decl) = (pstaticdefaultcontext.DECL = porigin_decl)
def $instance_default_context_at((INSTANCE_DEFAULT_PUBLISH porigin pstaticdefaultcontext pvalue pvalueclass) :: ptask*) = (porigin)
def $instance_default_bind_marker(INSTANCE_DEFAULT_PUBLISH porigin pstaticdefaultcontext pvalue pvalueclass) = true
def $instance_default_binders_unique((INSTANCE_DEFAULT_PUBLISH porigin pstaticdefaultcontext pvalue pvalueclass) :: ptask*, (porigin_seen_class, porigin_seen_decl)*) = (~((porigin, pstaticdefaultcontext.DECL) <- (porigin_seen_class, porigin_seen_decl)*) /\ $instance_default_binders_unique(ptask*, (porigin_seen_class, porigin_seen_decl)* ++ [(porigin, pstaticdefaultcontext.DECL)]))
def $static_default_binders_unique((INSTANCE_DEFAULT_PUBLISH porigin pstaticdefaultcontext pvalue pvalueclass) :: ptask*, porigin_seen*) = $static_default_binders_unique(ptask*, porigin_seen*)
def $static_default_phases((INSTANCE_DEFAULT_PUBLISH porigin pstaticdefaultcontext pvalue pvalueclass) :: ptask*, b_property) = $static_default_phases(ptask*, b_property)
def $property_default_phases((INSTANCE_DEFAULT_PUBLISH porigin pstaticdefaultcontext pvalue pvalueclass) :: ptask*, n_phase) = $property_default_phases(ptask*, 1)
  -- if $(n_phase <= 1)
