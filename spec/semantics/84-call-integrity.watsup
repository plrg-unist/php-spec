def $call_task_valid(S, CALL_ARGS pcalltarget_function phpType7* n poperand* porigin? z) = ($call_selected_valid(S, pcalltarget_function, porigin?) /\ ($call_line_valid(S, porigin?, z) \/ $concat_pending_line_valid(S, pcalltarget_function, porigin?, z) \/ $interpolation_pending_line_valid(S, pcalltarget_function, porigin?, z) \/ $typed_return_pending_line_valid(S, pcalltarget_function, porigin?, z) \/ $config_string_pending_line_valid(S, pcalltarget_function, porigin?, z) \/ $static_string_pending_line_valid(S, pcalltarget_function, porigin?, z) \/ $property_string_pending_line_valid(S, pcalltarget_function, porigin?, z) \/ $default_internal_string_pending_line_valid(S, pcalltarget_function, porigin?, z)) /\ $call_arguments_valid(S, porigin?, n, phpType7*, poperand*, 0) /\ $call_sent_operands_valid(S, pcalltarget_function, 0, poperand*))
