rule PhpStep/array-unset: S ~> S[.TODO = [DIM_PREP (NExprArrayDimFetch expression phpType5 metadata), UNSET_ARRAY] ++ ptask_tail*]
  -- if S.TODO = (UNSET (NExprArrayDimFetch expression phpType5 metadata)) :: ptask_tail*
rule PhpStep/array-unset-location: S ~> S_unset[.TODO = ptask_tail*][.BASE = BASE_VALUE (KNOWN PNULL)][.RESULT = KNOWN PNULL]
  -- if S.TODO = UNSET_ARRAY :: ptask_tail*
  -- if S_unset = $unset_array(S, S.BASE)
