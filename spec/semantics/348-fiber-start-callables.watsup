  -- if S_check.COMPLETION = NORMAL
  -- if S_read = $resolve_at(S_check, S.RESULT, z)
  -- if S_read.COMPLETION =/= NORMAL
rule PhpStep/fiber-start-capture-enter: S ~> S[.TODO = (FIBER_START_CAPTURE_ARGS n pfiberstart) :: (FIBER_START_CAPTURE_RESULT n pfiberstart b) :: ptask_tail*]
  -- if S.TODO = (FIBER_START_CAPTURE_ARGS n pfiberstart) :: (FIBER_CAPTURE_RELEASE n porigin) :: ptask_tail*
  -- if porigin = pfiberstart.SITE
  -- if $fiber_start_capture_valid(S, n, pfiberstart, false)
