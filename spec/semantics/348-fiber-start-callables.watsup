dec $fiber_start_capture_trace(pstate, pfiberstart, bool) : ptraceframe*
dec $fiber_start_capture_invoke(pstate, pfiberstart, bool) : pstate
def $fiber_start_capture_trace(S, pfiberstart, false) = [$fiber_api_trace(S, pfiberapi)]
  -- if pfiberapi = {SITE pfiberstart.SITE, OBJECT pfiberstart.OBJECT, KIND eps, START (pfiberstart.SENT), SENT eps, LINE pfiberstart.LINE, SEQUENCE S.FIBERSEQ}
def $fiber_start_capture_trace(S, pfiberstart, true) = [$fiber_api_trace(S, pfiberapi), ptraceframe]
  -- if pfiberapi = {SITE pfiberstart.SITE, OBJECT pfiberstart.OBJECT, KIND eps, START (pfiberstart.SENT), SENT eps, LINE pfiberstart.LINE, SEQUENCE S.FIBERSEQ}
  -- if ptraceframe = {FILE $call_sourcefile(S.FILES, pfiberstart.SITE), LINE pfiberstart.LINE, FUNCTION $ptascii("__invoke"), CLASS ($ptascii("Closure")), TYPE ($ptascii("->")), ARGS $fiber_api_trace_args(S, pfiberapi), HASARGS true}
def $fiber_start_capture_invoke(S, pfiberstart, b) = $throwable_allocate_at(S_started[.COMPLETION = NORMAL], text, ptbytes, pfiberstart.SITE, z, $source_trace_prefixed(S, $fiber_start_capture_trace(S, pfiberstart, b)))
  -- if S_started = $fiber_start(S, pfiberstart)
  -- if S_started.COMPLETION = THROWN text ptbytes z
def $fiber_start_capture_invoke(S, pfiberstart, b) = S_started
  -- if S_started = $fiber_start(S, pfiberstart)
  -- if S_started.COMPLETION = NORMAL
def $fiber_start_capture_invoke(S, pfiberstart, b) = S_started
  -- if S_started = $fiber_start(S, pfiberstart)
  -- if S_started.COMPLETION = UNSUPPORTED text
rule PhpStep/fiber-start-capture-invoke: S ~> $fiber_start_capture_invoke(S, pfiberstart, b)
  -- if S.TODO = (FIBER_START_CAPTURE_ARGS n pfiberstart) :: (FIBER_START_CAPTURE_RESULT n pfiberstart b) :: ptask_tail*
  -- if $fiber_start_capture_result_valid(S, n, pfiberstart, b)

def $task_nodes(FIBER_START_CAPTURE_ARGS n pfiberstart) = $named_slots_roots(pfiberstart.SENT.SLOTS) ++ $named_roots(pfiberstart.SENT.NAMED)
def $task_nodes(FIBER_START_CAPTURE_SEND n pfiberstart) = $named_slots_roots(pfiberstart.SENT.SLOTS) ++ $named_roots(pfiberstart.SENT.NAMED)
def $task_nodes(FIBER_START_CAPTURE_RESULT n pfiberstart false) = [HOBJECT n]
def $task_nodes(FIBER_START_CAPTURE_RESULT n pfiberstart true) = [HOBJECT n, HOBJECT n] ++ $named_slots_roots(pfiberstart.SENT.SLOTS) ++ $named_roots(pfiberstart.SENT.NAMED)
def $fiber_caller_api_nodes(pfibercaller) = $named_slots_roots(pfiberstart.SENT.SLOTS) ++ $named_roots(pfiberstart.SENT.NAMED)
  -- if pfiberapi = pfibercaller.API
  -- if pfibercaller.VM.TODO = (FIBER_WAIT pfiberapi) :: (FIBER_START_CAPTURE_RESULT n pfiberstart b) :: ptask_tail*
  -- if pfiberapi.KIND = eps /\ pfiberapi.SENT = eps
  -- if pfiberapi.START = (pfiberstart.SENT)
  -- if pfiberapi.OBJECT = pfiberstart.OBJECT
  -- if pfiberapi.SITE = pfiberstart.SITE /\ pfiberapi.LINE = pfiberstart.LINE
def $fiber_api_valid(S, pfiberapi) = true
  -- if $(pfiberapi.SEQUENCE > 0) /\ $(pfiberapi.SEQUENCE < S.FIBERSEQ)
  -- if $fiber_at(S, pfiberapi.OBJECT) =/= eps
  -- if S.TODO = (FIBER_WAIT pfiberapi) :: (FIBER_START_CAPTURE_RESULT n pfiberstart b) :: ptask_tail*
  -- if $fiber_start_capture_result_valid(S, n, pfiberstart, b)
  -- if pfiberapi.KIND = eps /\ pfiberapi.SENT = eps
  -- if pfiberapi.START = (pfiberstart.SENT)
  -- if pfiberapi.OBJECT = pfiberstart.OBJECT
  -- if pfiberapi.SITE = pfiberstart.SITE /\ pfiberapi.LINE = pfiberstart.LINE
def $fiber_caller_api_trace(S, pfiberapi) = $fiber_start_capture_trace(S, pfiberstart, b)
  -- if S.TODO = (FIBER_WAIT pfiberapi) :: (FIBER_START_CAPTURE_RESULT n pfiberstart b) :: ptask_tail*
  -- if $fiber_api_valid(S, pfiberapi)
def $call_task_valid(S, FIBER_START_CAPTURE_ARGS n pfiberstart) = $fiber_start_capture_valid(S, n, pfiberstart, false)
def $call_task_valid(S, FIBER_START_CAPTURE_SEND n pfiberstart) = $fiber_start_capture_valid(S, n, pfiberstart, true)
def $call_task_valid(S, FIBER_START_CAPTURE_RESULT n pfiberstart b) = $fiber_start_capture_result_valid(S, n, pfiberstart, b)
rule PhpStep/fiber-start-capture-result: S ~> S[.TODO = ptask_tail*]
  -- if S.TODO = (FIBER_START_CAPTURE_RESULT n pfiberstart false) :: ptask_tail*
  -- if $fiber_start_capture_result_valid(S, n, pfiberstart, false)
rule PhpStep/fiber-start-capture-invoke-result: S ~> S[.TODO = (FIBER_CAPTURE_RELEASE n pfiberstart.SITE) :: ptask_tail*]
  -- if S.TODO = (FIBER_START_CAPTURE_RESULT n pfiberstart true) :: ptask_tail*
  -- if $fiber_start_capture_result_valid(S, n, pfiberstart, true)
rule PhpStep/fiber-start-capture-throw-result: S ~> S[.TODO = (THROW_SEARCH n_throwable) :: ptask_tail*]
  -- if S.TODO = (THROW_SEARCH n_throwable) :: (FIBER_START_CAPTURE_RESULT n pfiberstart false) :: ptask_tail*
  -- if $fiber_start_capture_result_valid(S, n, pfiberstart, false)
  -- if $throwable_live(S, n_throwable)
rule PhpStep/fiber-start-capture-invoke-throw-result: S ~> S[.TODO = (THROW_SEARCH n_throwable) :: (FIBER_CAPTURE_RELEASE n pfiberstart.SITE) :: ptask_tail*]
  -- if S.TODO = (THROW_SEARCH n_throwable) :: (FIBER_START_CAPTURE_RESULT n pfiberstart true) :: ptask_tail*
