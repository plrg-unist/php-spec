  -- if $throwable_live(S, n_throwable)
def $fiber_marker(FIBER_START_CAPTURE_RESULT n pfiberstart b) = true
def $generator_internal_task(FIBER_START_CAPTURE_ARGS n pfiberstart) = true
def $generator_internal_task(FIBER_START_CAPTURE_SEND n pfiberstart) = true
def $generator_internal_task(FIBER_START_CAPTURE_RESULT n pfiberstart b) = true
