rule PhpStep/foreach-fetch-value: S ~> $foreach_body(S_next, n, HARRAY n_array, statement, z, pkey, KNOWN $entry_value(S_next, pitem), false)
  -- if S.TODO = (FOREACH_NEXT n (HARRAY n_array) statement porigin? z) :: ptask_tail*
  -- if $iterator_lookup(S.ITERATORS, n) = (ITERATOR n n_array false (CURSOR n_table n_saved)*)
  -- if $cursor_position((CURSOR n_table n_saved)*, n_array) = (n_position)
  -- if $position_next(S.ARRAYS[n_array].POSITIONS, n_position) = (pkey, n_serial)
  -- if $entry_lookup(S.ARRAYS[n_array].ITEMS, pkey) = (pitem)
  -- if S_next = $foreach_advance(S[.ORIGIN = porigin?], n, n_array, $(n_serial + 1))
rule PhpStep/foreach-fetch-reference: S ~> $foreach_body(S_ref, n, HCELL n_cell, statement, z, pkey, REFERENCE S_ref.CELL, true)
  -- if S.TODO = (FOREACH_NEXT n (HCELL n_cell) statement porigin? z) :: ptask_tail*
  -- if $foreach_owner_value(S, HCELL n_cell) = PARRAY n_original
  -- if S_selected = $foreach_select(S[.ORIGIN = porigin?], n, HCELL n_cell, z)
  -- if $foreach_owner_value(S_selected, HCELL n_cell) = PARRAY n_array
  -- if $iterator_lookup(S_selected.ITERATORS, n) = (ITERATOR n n_array true (CURSOR n_table n_saved)*)
  -- if $cursor_position((CURSOR n_table n_saved)*, n_array) = (n_position)
  -- if $position_next(S_selected.ARRAYS[n_array].POSITIONS, n_position) = (pkey, n_serial)
  -- if S_next = $foreach_advance(S_selected, n, n_array, $(n_serial + 1))
  -- if S_ref = $element_reference(S_next, n_array, pkey)

;; Unwinding drops this iterator's saved copies, not the surviving value alias.
def $loop_marker(FOREACH_NEXT n pnode statement porigin? z) = true
def $jump_loop(S, 1, false) = $foreach_finish(S[.ORIGIN = porigin?], n)
  -- if S.TODO = (FOREACH_NEXT n pnode statement porigin? z) :: ptask_tail*
def $jump_loop(S, 1, true) = S[.ORIGIN = porigin?][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (FOREACH_NEXT n pnode statement porigin? z) :: ptask_tail*
def $jump_loop(S, n_depth, b) = $jump_loop($foreach_finish(S, n), $nabs($(n_depth - 1)), b)
  -- if S.TODO = (FOREACH_NEXT n pnode statement porigin? z) :: ptask_tail*
  -- if $(n_depth > 1)

def $task_nodes(FOREACH_NEXT n pnode statement porigin? z) = [pnode]
