def $foreach_reset_location(S, statement, z) = S -- if S.COMPLETION =/= NORMAL
def $foreach_reset_location(S, statement, z) = $foreach_start(S[.RESULT = KNOWN pvalue], statement, S.LOCATION, true, z)
  -- if S.COMPLETION = NORMAL
  -- if $location_slot(S, S.LOCATION) = DEFINED pvalue
def $foreach_reset_location(S, statement, z) = $foreach_start($location_write(S, S.LOCATION, PNULL)[.RESULT = KNOWN PNULL], statement, S.LOCATION, true, z)
  -- if S.COMPLETION = NORMAL
  -- if $location_slot(S, S.LOCATION) = UNDEFINED

dec $foreach_reset_target(plocation, bool, poperand) : plocation
def $foreach_reset_target(NOWHERE, true, REFERENCE n) = ROOT n
def $foreach_reset_target(plocation, b, poperand) = plocation -- otherwise

rule PhpStep/foreach-reset: S ~> $foreach_start(S_read, statement, $foreach_reset_target(plocation, b, S.RESULT), b, z)
  -- if S.TODO = (FOREACH_RESET statement plocation b z) :: ptask_tail*
  -- if S_read = $resolve_at(S, S.RESULT, z)
  -- if S_read.COMPLETION = NORMAL
rule PhpStep/foreach-reset-abrupt: S ~> S_read
  -- if S.TODO = (FOREACH_RESET statement plocation b z) :: ptask_tail*
  -- if S_read = $resolve_at(S, S.RESULT, z)
  -- if S_read.COMPLETION =/= NORMAL

;; Dispatch is completed below: cursor selection, value/key binding and cleanup.
dec $foreach_owner_value(pstate, pnode) : pvalue
def $foreach_owner_value(S, HARRAY n) = PARRAY n
def $foreach_owner_value(S, HCELL n) = pvalue -- if S.STORE[n] = DEFINED pvalue

dec $foreach_select(pstate, nat, pnode, int) : pstate
def $foreach_select(S, n, HARRAY n_array, z) = S
def $foreach_select(S, n, HCELL n_cell, z) = S
  -- if S.STORE[n_cell] = DEFINED (PARRAY n_array)
  -- if $iterator_lookup(S.ITERATORS, n) = (ITERATOR n n_array true (CURSOR n_table n_saved)*)
def $foreach_select(S, n, HCELL n_cell, z) = S[.ITERATORS = $iterator_set(S.ITERATORS, ITERATOR n n_array true ([(CURSOR n_array n_position)]))]
  -- if S.STORE[n_cell] = DEFINED (PARRAY n_array)
  -- if $iterator_lookup(S.ITERATORS, n) = (ITERATOR n n_old true (CURSOR n_table n_saved)*)
  -- if n_array =/= n_old
  -- if $cursor_position((CURSOR n_table n_saved)*, n_array) = (n_position)
def $foreach_select(S, n, HCELL n_cell, z) = S_array[.ITERATORS = $iterator_set(S_array.ITERATORS, ITERATOR n n_new true ([(CURSOR n_new 0)]))][.RESULT = KNOWN PNULL]
  -- if S.STORE[n_cell] = DEFINED (PARRAY n_array)
  -- if $iterator_lookup(S.ITERATORS, n) = (ITERATOR n n_old true (CURSOR n_table n_saved)*)
  -- if n_array =/= n_old
  -- if $cursor_position((CURSOR n_table n_saved)*, n_array) = eps
  -- if S_array = $location_array(S, ROOT n_cell, z)
  -- if S_array.RESULT = KNOWN (PARRAY n_new)

dec $foreach_advance(pstate, nat, nat, nat) : pstate
def $foreach_advance(S, n, n_array, n_position) = S[.ITERATORS = $iterator_set(S.ITERATORS, ITERATOR n n_array b ($cursor_set((CURSOR n_table n_saved)*, n_array, n_position)))]
  -- if $iterator_lookup(S.ITERATORS, n) = (ITERATOR n n_array b (CURSOR n_table n_saved)*)

dec $foreach_value_task(pstate, expression, poperand, bool, int) : ptask
def $foreach_value_task(S, expression, poperand, b, z) = $at_task($origin_child(S.ORIGIN, [PCFIELD 3]), LIST_PATTERN expression poperand z)
  -- if $list_pattern(expression) = (phpType13*)
def $foreach_value_task(S, expression, poperand, b, z) = $at_task($origin_child(S.ORIGIN, [PCFIELD 3]), LIST_STORE expression poperand b $runtime_line(S, [PCFIELD 3], expression))
  -- if $list_pattern(expression) = eps

dec $foreach_key_value(pkey) : pvalue
def $foreach_key_value(KINT i) = PINT i
def $foreach_key_value(KSTRING n*) = PSTRING n*
dec $foreach_key_tasks(pstate, phpType5, pkey) : ptask*
def $foreach_key_tasks(S, ABSENT, pkey) = eps
def $foreach_key_tasks(S, expression, pkey) = [$at_task($origin_child(S.ORIGIN, [PCFIELD 1]), LIST_STORE expression (KNOWN $foreach_key_value(pkey)) false $runtime_line(S, [PCFIELD 1], expression))]

dec $foreach_body(pstate, nat, pnode, statement, int, pkey, poperand, bool) : pstate
def $foreach_body(S, n, pnode, statement_foreach, z, pkey, poperand, b) = S[.TODO = [$foreach_value_task(S, expression_value, poperand, b, z)] ++ $foreach_key_tasks(S, phpType5, pkey) ++ $statement_tasks(statement*, $origin_child(S.ORIGIN, [PCFIELD 4]), 0) ++ [(FOREACH_NEXT n pnode statement_foreach S.ORIGIN z)] ++ ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = ptask :: ptask_tail*
  -- if statement_foreach = NStmtForeach expression_iterable phpType5 (BOOLEAN b_ref) expression_value (SEQUENCE statement*) (BOOLEAN false) metadata

dec $foreach_finish(pstate, nat) : pstate
def $foreach_finish(S, n) = S[.TODO = ptask_tail*][.ITERATORS = $iterator_remove(S.ITERATORS, n)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = ptask :: ptask_tail*

rule PhpStep/foreach-fetch-scalar: S ~> $foreach_finish($foreach_warning(S[.ORIGIN = porigin?], pvalue, z), n)
  -- if S.TODO = (FOREACH_NEXT n pnode statement porigin? z) :: ptask_tail*
  -- if pvalue = $foreach_owner_value(S, pnode)
  -- if ~$is_array_value(pvalue)
rule PhpStep/foreach-fetch-end: S ~> $foreach_finish(S_selected, n)
  -- if S.TODO = (FOREACH_NEXT n pnode statement porigin? z) :: ptask_tail*
