dec $foreach_reset_location(pstate, statement, int) : pstate
;; Array foreach owns a snapshot value or an actual reference wrapper. The
;; compiler has already visited iterable, value target, key target and body.
dec $foreach_warning(pstate, pvalue, int) : pstate
def $foreach_warning(S, pvalue, z) = $diagnostic(S, "Warning", [102,111,114,101,97,99,104,40,41,32,97,114,103,117,109,101,110,116,32,109,117,115,116,32,98,101,32,111,102,32,116,121,112,101,32,97,114,114,97,121,124,111,98,106,101,99,116,44,32] ++ $unpack_type_bytes(pvalue) ++ [32,103,105,118,101,110], z)

dec $foreach_reference_at(pstate, plocation, pvalue) : pstate
def $foreach_reference_at(S, ROOT n, pvalue) = $reference_cell(S, n)[.CELL = n]
def $foreach_reference_at(S, ELEMENT n pkey, pvalue) = $element_reference(S, n, pkey)
def $foreach_reference_at(S, NOWHERE, pvalue) = $reference_cell(S[.STORE = S.STORE ++ [DEFINED pvalue]][.ALLOCATIONS = S.ALLOCATIONS ++ [HCELL n]], n)[.CELL = n]
  -- if n = |S.STORE|

dec $foreach_start(pstate, statement, plocation, bool, int) : pstate
def $foreach_start(S, statement, plocation, false, z) = S[.TODO = (FOREACH_NEXT n_iterator (HARRAY n_array) statement S.ORIGIN z) :: ptask_tail*][.ITERATORS = S.ITERATORS ++ [ITERATOR n_iterator n_array false ([(CURSOR n_array 0)])]][.NEXTITER = $(n_iterator + 1)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = ptask :: ptask_tail*
  -- if S.RESULT = KNOWN (PARRAY n_array)
  -- if n_iterator = S.NEXTITER
def $foreach_start(S, statement, plocation, true, z) = S_array[.TODO = (FOREACH_NEXT n_iterator (HCELL n_cell) statement S.ORIGIN z) :: ptask_tail*][.ITERATORS = S_array.ITERATORS ++ [ITERATOR n_iterator n_array true ([(CURSOR n_array 0)])]][.NEXTITER = $(n_iterator + 1)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)][.HELD = S.HELD]
  -- if S.TODO = ptask :: ptask_tail*
  -- if S.RESULT = KNOWN (PARRAY n_value)
  -- if S_ref = $foreach_reference_at(S, plocation, PARRAY n_value)
  -- if n_cell = S_ref.CELL
  -- if S_array = $location_array(S_ref[.HELD = S.HELD ++ [HCELL n_cell]][.BASE = BASE_VALUE (KNOWN PNULL)], ROOT n_cell, z)
  -- if S_array.RESULT = KNOWN (PARRAY n_array)
  -- if n_iterator = S.NEXTITER
def $foreach_start(S, statement, plocation, b, z) = $foreach_warning(S, pvalue, z)[.TODO = ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = ptask :: ptask_tail*
  -- if S.RESULT = KNOWN pvalue
  -- if ~$is_array_value(pvalue)

