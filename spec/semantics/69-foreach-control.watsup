  -- if S_selected = $foreach_select(S[.ORIGIN = porigin?], n, pnode, z)
  -- if $foreach_owner_value(S_selected, pnode) = PARRAY n_array
  -- if $iterator_lookup(S_selected.ITERATORS, n) = (ITERATOR n n_array b (CURSOR n_table n_saved)*)
  -- if $cursor_position((CURSOR n_table n_saved)*, n_array) = (n_position)
