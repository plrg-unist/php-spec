dec $trait_type_atom_names(ptatom*) : nat
dec $trait_type_atom_nominal(ptatom) : nat
dec $trait_data_needs(pvresult) : bool
dec $trait_static_property_read_pending(ptask*) : bool
dec $trait_data_fatal(pstate, pclassdesc, ptbytes) : pstate

def $trait_data_import_type(pclassdesc, ptbranch*) = ptbranch* -- if pclassdesc.KIND = "trait"
def $trait_data_import_type(pclassdesc, ptbranch*) = $trait_type_branches(ptbranch*, pclassdesc.NAME, pclassdesc.PARENT) -- if pclassdesc.KIND =/= "trait"
def $trait_data_private_key(ppropertydesc, ptbytes) = [0] ++ ptbytes ++ [0] ++ ppropertydesc.NAME -- if ppropertydesc.VISIBILITY = PROPERTY_PRIVATE
def $trait_data_private_key(ppropertydesc, ptbytes) = ppropertydesc.KEY -- if ppropertydesc.VISIBILITY =/= PROPERTY_PRIVATE
def $trait_data_property(pclassdesc, ppropertydesc) = ppropertydesc[.ORIGIN = TRAIT_MEMBER_ORIGIN pclassdesc.ORIGIN ($origin_source(porigin))][.KEY = $trait_data_private_key(ppropertydesc, pclassdesc.NAME)][.TYPE = $trait_data_import_type(pclassdesc, ppropertydesc.TYPE)]
  -- if ppropertydesc.ORIGIN = porigin
def $trait_data_constant(pclassdesc, pclassconstantdesc) = pclassconstantdesc[.ORIGIN = TRAIT_MEMBER_ORIGIN pclassdesc.ORIGIN ($origin_source(pclassconstantdesc.ORIGIN))][.OWNER = pclassdesc.ORIGIN][.OWNERNAME = pclassdesc.NAME][.TYPE = $trait_data_import_type(pclassdesc, pclassconstantdesc.TYPE)]

;; Even a compatible earlier trait is the exporter named by a later conflict.
def $trait_data_prior(eps, ptbytes, b_constant, ptbytes_owner) = ptbytes_owner
def $trait_data_prior(pclassdesc :: pclassdesc_tail*, ptbytes, true, ptbytes_owner) = pclassdesc.NAME -- if $class_constant_desc(pclassdesc.CONSTANTS, ptbytes) =/= eps
def $trait_data_prior(pclassdesc :: pclassdesc_tail*, ptbytes, false, ptbytes_owner) = pclassdesc.NAME -- if $ppproperty_desc_at(pclassdesc.PROPERTIES, ptbytes) =/= eps
def $trait_data_prior(pclassdesc :: pclassdesc_tail*, ptbytes, true, ptbytes_owner) = $trait_data_prior(pclassdesc_tail*, ptbytes, true, ptbytes_owner) -- if $class_constant_desc(pclassdesc.CONSTANTS, ptbytes) = eps
def $trait_data_prior(pclassdesc :: pclassdesc_tail*, ptbytes, false, ptbytes_owner) = $trait_data_prior(pclassdesc_tail*, ptbytes, false, ptbytes_owner) -- if $ppproperty_desc_at(pclassdesc.PROPERTIES, ptbytes) = eps

def $trait_data_ancestors(S, pclassdesc) = [pclassdesc_parent.NAME] ++ $method_all_ancestor_names(S, pclassdesc_parent.ORIGIN, |S.CLASSES|)
  -- if pclassdesc.PARENT = (ptbytes)
  -- if $class_named(S.CLASSNAMES, $ptlc(ptbytes)) = (porigin)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc_parent)
def $trait_data_ancestors(S, pclassdesc) = eps -- otherwise
def $trait_data_scope(S, pclassdesc) = $pmethod_scope(pclassdesc, $trait_data_ancestors(S, pclassdesc))
def $trait_property_source_items(eps, porigin) = eps
def $trait_property_source_items(ppropertydesc :: ppropertydesc_tail*, porigin) = (ppropertydesc) -- if ppropertydesc.ORIGIN = porigin
def $trait_property_source_items(ppropertydesc :: ppropertydesc_tail*, porigin) = $trait_property_source_items(ppropertydesc_tail*, porigin) -- if ppropertydesc.ORIGIN =/= porigin
def $trait_property_source_at(eps, porigin) = eps
def $trait_property_source_at(pclassdesc :: pclassdesc_tail*, porigin) = (ppropertydesc) -- if $trait_property_source_items(pclassdesc.PROPERTIES, porigin) = (ppropertydesc)
def $trait_property_source_at(pclassdesc :: pclassdesc_tail*, porigin) = $trait_property_source_at(pclassdesc_tail*, porigin) -- if $trait_property_source_items(pclassdesc.PROPERTIES, porigin) = eps
def $property_type_name(S, ppropertydesc) = $pttypename($trait_member_display_type(S, porigin, $trait_property_source_type(S, ppropertydesc))) -- if ppropertydesc.ORIGIN = porigin
def $property_type_name(S, ppropertydesc) = $pttypename(ppropertydesc.TYPE) -- otherwise
def $trait_constant_type_name(S, pclassconstantdesc) = $pttypename($trait_member_display_type(S, pclassconstantdesc.ORIGIN, $trait_constant_source_type(S, pclassconstantdesc)))
def $trait_property_source_type(S, ppropertydesc) = ppropertydesc_source.TYPE
  -- if ppropertydesc.ORIGIN = porigin
  -- if $trait_property_source_at(S.CLASSES, $origin_source(porigin)) = (ppropertydesc_source)
def $trait_property_source_type(S, ppropertydesc) = ppropertydesc.TYPE -- otherwise
;; Zend's identical raw mask/name shortcut precedes scoped type comparison.
;; This comparison-only view keeps the published bound types and every flag.
def $trait_property_inherit_message(S, ptbytes_child, ptbytes_parent, ppropertydesc_parent, ppropertydesc_child) = $ppproperty_inherit_message(ptbytes_child, ptbytes_parent, ppropertydesc_parent, ppropertydesc_child[.TYPE = ppropertydesc_parent.TYPE])
  -- if $trait_property_source_fast_equal(S, ppropertydesc_parent, ppropertydesc_child)
def $trait_property_inherit_message(S, ptbytes_child, ptbytes_parent, ppropertydesc_parent, ppropertydesc_child) = $ppproperty_inherit_message(ptbytes_child, ptbytes_parent, ppropertydesc_parent, ppropertydesc_child)
  -- if ~$trait_property_source_fast_equal(S, ppropertydesc_parent, ppropertydesc_child)
def $trait_data_types(S, pclassdesc_left, eps, pclassdesc_right, eps, b_constant, b_fast) = TRAITDATAOK
def $trait_data_types(S, pclassdesc_left, ptbranch_left*, pclassdesc_right, ptbranch_right*, b_constant, b_fast) = TRAITDATABAD
  -- if (ptbranch_left* = eps /\ ptbranch_right* =/= eps) \/ (ptbranch_left* =/= eps /\ ptbranch_right* = eps)
def $trait_data_types(S, pclassdesc_left, ptbranch_left*, pclassdesc_right, ptbranch_right*, false, true) = TRAITDATAOK
  -- if ptbranch_left* =/= eps /\ ptbranch_right* =/= eps
def $trait_data_types(S, pclassdesc_left, ptbranch_left*, pclassdesc_right, ptbranch_right*, b_constant, b_fast) = $trait_data_covariance($pvcovariant(ptbranch_left*, pvclass_left, ptbranch_right*, pvclass_right, pvclasses), $pvcovariant(ptbranch_right*, pvclass_right, ptbranch_left*, pvclass_left, pvclasses), b_constant)
  -- if ptbranch_left* =/= eps /\ ptbranch_right* =/= eps
  -- if b_constant \/ ~b_fast
  -- if pvclass_left = $trait_data_scope(S, pclassdesc_left)
  -- if pvclass_right = $trait_data_scope(S, pclassdesc_right)
  -- if pvclasses = $method_active_registry(S, S.CLASSNAMES)
def $trait_data_covariance(PVINCOMPATIBLE, pvresult, b_constant) = TRAITDATABAD
def $trait_data_covariance(pvresult, PVINCOMPATIBLE, b_constant) = TRAITDATABAD -- if pvresult =/= PVINCOMPATIBLE
def $trait_data_covariance(PVCOMPATIBLE, PVCOMPATIBLE, b_constant) = TRAITDATAOK
def $trait_data_covariance(PVNEEDS ptbytes*, pvresult, true) = TRAITDATAOK -- if pvresult = PVCOMPATIBLE \/ $trait_data_needs(pvresult)
def $trait_data_covariance(PVCOMPATIBLE, PVNEEDS ptbytes*, true) = TRAITDATAOK
def $trait_data_covariance(pvresult_left, pvresult_right, false) = TRAITDATABAD
  -- if $trait_data_needs(pvresult_left) \/ $trait_data_needs(pvresult_right)
  -- if pvresult_left =/= PVINCOMPATIBLE /\ pvresult_right =/= PVINCOMPATIBLE
def $trait_data_covariance(pvresult_left, pvresult_right, b_constant) = TRAITDATAUNKNOWN "unsupported trait data type compatibility" -- otherwise
def $trait_property_fast_equal(ptbranch_left*, ptbranch_right*) = ($ppproperty_type_equal(ptbranch_left*, ptbranch_right*) /\ $($trait_type_names(ptbranch_left*) <= 1))
def $trait_property_source_fast_equal(S, ppropertydesc_left, ppropertydesc_right) = $trait_property_fast_equal($trait_property_source_type(S, ppropertydesc_left), $trait_property_source_type(S, ppropertydesc_right))
  -- if ~$trait_type_contextual($trait_property_source_type(S, ppropertydesc_left))
def $trait_property_source_fast_equal(S, ppropertydesc_left, ppropertydesc_right) = ($trait_property_fast_equal($trait_property_source_type(S, ppropertydesc_left), $trait_property_source_type(S, ppropertydesc_right)) /\ ($trait_property_keyword_spelling(S, ppropertydesc_left) =/= eps /\ $trait_property_keyword_spelling(S, ppropertydesc_left) = $trait_property_keyword_spelling(S, ppropertydesc_right)))
  -- if $trait_type_contextual($trait_property_source_type(S, ppropertydesc_left))
def $trait_type_contextual(eps) = false
def $trait_type_contextual((PTBRANCH ptatom*) :: ptbranch*) = ($trait_type_contextual_atoms(ptatom*) \/ $trait_type_contextual(ptbranch*))
def $trait_type_contextual_atoms(eps) = false
def $trait_type_contextual_atoms(ptatom :: ptatom_tail*) = (ptatom <- [PTSELF, PTPARENT, PTSTATIC] \/ $trait_type_contextual_atoms(ptatom_tail*))
def $trait_property_keyword_spelling(S, ppropertydesc) = $trait_type_keyword_spelling($ptast(phpType18))
  -- if ppropertydesc.ORIGIN = porigin
  -- if $origin_source(porigin) = PORIGIN n pcpath
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (NPropertyItem phpType40 expression metadata)
  -- if $(|pcpath| >= 2)
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath[0:$nabs($(|pcpath| - 2))]) = (NStmtProperty phpType14 phpType24 phpType18 phpType56 phpType37 metadata_group)
def $trait_property_keyword_spelling(S, ppropertydesc) = eps -- otherwise
def $trait_property_keyword_spelling(S, ppropertydesc) = $trait_type_keyword_spelling($ptast(phpType18))
  -- if ppropertydesc.ORIGIN = porigin
  -- if $origin_node(S.SOURCES, $origin_source(porigin)) = (NParam phpType14 phpType24 phpType18 phpType4_ref phpType4_var phpType10 phpType5 phpType37 metadata)
;; Only diagnostics project source keyword spelling; stored and checked types
;; remain normalized and bound to their authentic declaring owner.
def $trait_member_type_input(S, porigin) = ($ptast(phpType18))
  -- if $origin_source(porigin) = PORIGIN n pcpath
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (NPropertyItem phpType40 expression metadata)
  -- if $(|pcpath| >= 2)
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath[0:$nabs($(|pcpath| - 2))]) = (NStmtProperty phpType14 phpType24 phpType18 phpType56 phpType37 metadata_group)
def $trait_member_type_input(S, porigin) = ($ptast(phpType18))
  -- if $origin_source(porigin) = PORIGIN n pcpath
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (NConst phpType11 expression metadata)
  -- if $(|pcpath| >= 2)
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath[0:$nabs($(|pcpath| - 2))]) = (NStmtClassConst phpType14 phpType24 phpType18 phpType45 metadata_group)
def $trait_member_type_input(S, porigin) = eps -- otherwise
def $trait_member_type_input(S, porigin) = ($ptast(phpType18))
  -- if $origin_node(S.SOURCES, $origin_source(porigin)) = (NParam phpType14 phpType24 phpType18 phpType4_ref phpType4_var phpType10 phpType5 phpType37 metadata)
def $trait_member_display_type(S, porigin, ptbranch*) = $trait_type_display(ptbranch*, ptinput) -- if $trait_member_type_input(S, porigin) = (ptinput)
def $trait_member_display_type(S, porigin, ptbranch*) = ptbranch* -- if $trait_member_type_input(S, porigin) = eps
def $trait_type_display(ptbranch*, ptinput) = ($trait_type_display_branch(ptbranch, ptinput))*
def $trait_type_display_branch(PTBRANCH ptatom*, ptinput) = PTBRANCH ($trait_type_display_atom(ptatom, ptinput))*
def $trait_type_display_atom(ptatom, ptinput) = PTCLASS ptbytes
  -- if ptatom <- [PTSELF, PTPARENT, PTSTATIC]
  -- if $trait_type_keyword_named(ptinput, $ptatomname(ptatom)) = (ptbytes)
def $trait_type_display_atom(ptatom, ptinput) = ptatom -- otherwise
def $trait_type_keyword_named(PTNAME PTPLAIN ptbytes, ptbytes_keyword) = (ptbytes) -- if $ptlc(ptbytes) = ptbytes_keyword
def $trait_type_keyword_named(PTNULLABLE ptinput, ptbytes) = $trait_type_keyword_named(ptinput, ptbytes)
def $trait_type_keyword_named(PTUNION ptinput*, ptbytes) = $trait_type_keyword_names(ptinput*, ptbytes)
def $trait_type_keyword_named(PTINTER ptinput*, ptbytes) = $trait_type_keyword_names(ptinput*, ptbytes)
def $trait_type_keyword_named(ptinput, ptbytes) = eps -- otherwise
def $trait_type_keyword_names(eps, ptbytes) = eps
def $trait_type_keyword_names(ptinput :: ptinput_tail*, ptbytes) = (ptbytes_raw) -- if $trait_type_keyword_named(ptinput, ptbytes) = (ptbytes_raw)
def $trait_type_keyword_names(ptinput :: ptinput_tail*, ptbytes) = $trait_type_keyword_names(ptinput_tail*, ptbytes) -- if $trait_type_keyword_named(ptinput, ptbytes) = eps
def $trait_type_keyword_spelling(PTNAME PTPLAIN ptbytes) = (ptbytes) -- if $ptlc(ptbytes) <- [$ptascii("self"), $ptascii("parent"), $ptascii("static")]
def $trait_type_keyword_spelling(PTNULLABLE ptinput) = $trait_type_keyword_spelling(ptinput)
def $trait_type_keyword_spelling(PTUNION ptinput*) = $trait_type_keyword_spellings(ptinput*)
def $trait_type_keyword_spelling(PTINTER ptinput*) = $trait_type_keyword_spellings(ptinput*)
def $trait_type_keyword_spelling(ptinput) = eps -- otherwise
def $trait_type_keyword_spellings(eps) = eps
def $trait_type_keyword_spellings(ptinput :: ptinput_tail*) = (ptbytes) -- if $trait_type_keyword_spelling(ptinput) = (ptbytes)
def $trait_type_keyword_spellings(ptinput :: ptinput_tail*) = $trait_type_keyword_spellings(ptinput_tail*) -- if $trait_type_keyword_spelling(ptinput) = eps
def $trait_type_names(eps) = 0
def $trait_type_names((PTBRANCH ptatom*) :: ptbranch*) = $($trait_type_atom_names(ptatom*) + $trait_type_names(ptbranch*))
def $trait_type_atom_names(eps) = 0
def $trait_type_atom_names(ptatom :: ptatom_tail*) = $($trait_type_atom_nominal(ptatom) + $trait_type_atom_names(ptatom_tail*))
def $trait_type_atom_nominal(PTCLASS ptbytes) = 1
def $trait_type_atom_nominal(PTSELF) = 1
def $trait_type_atom_nominal(PTPARENT) = 1
def $trait_type_atom_nominal(PTSTATIC) = 1
def $trait_type_atom_nominal(ptatom) = 0 -- otherwise
def $trait_data_needs(PVNEEDS ptbytes*) = true
def $trait_data_needs(pvresult) = false -- otherwise

;; Reuse the checked expression folder in a scratch arena. Scratch arrays never
;; become descriptor values or live heap owners. Effectful work remains deferred.
def $trait_member_fold(S, pclassdesc, PORIGIN n pcpath) = (F_result)
  -- if $source_unit(S.SOURCES, n) = (pcunit)
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (expression)
  -- if $($expression_line(expression) > 0)
  -- if $source_precision(S, (PORIGIN n pcpath)) = (z_precision)
  -- if F = $pfbegin(n, pcunit.AST)[.PARSEPRECISION = z_precision]
  -- if porigin_member = PORIGIN n pcpath[0:$nabs($(|pcpath| - 1))]
  -- if S_memory = S[.CONSTCONTEXT = ({ORIGIN TRAIT_MEMBER_ORIGIN pclassdesc.ORIGIN porigin_member, LINE $expression_line(expression), FACTS eps})][.ORIGIN = eps][.ERRORHANDLER = {CALLBACK eps, LEVELS 0}][.ERRORFATALTRACE = eps][.DISPLAYINI = ($ptascii("stderr"))]
  -- if ptcontext = {NAMESPACE eps, IMPORTS eps, SCOPE PTKNOWN pclassdesc.NAME pclassdesc.PARENT, POSITION PTCONSTANT, OWNER pclassdesc.NAME, MEMBER eps, FILE $call_sourcefile(S.FILES, PORIGIN n pcpath), LINE $nabs($expression_line(expression))}
  -- if $pool_at(S.POOLS, n) = (ppool)
  -- if $trait_record_root(S, pclassdesc, PORIGIN n pcpath)
  -- if F_result = $pfprepare(F[.RECORD = ({CLASS pclassdesc.ORIGIN, ROOT PORIGIN n pcpath, TABLE pclassdesc.CONSTANTS})][.FACTS = $trait_pool_facts(S, n, ppool.CONSTANTS)][.CLASSFACTS = $trait_pool_classes(ppool.CONSTANTS)][.CLASSES = S.CLASSES][.CLASSCONSTANTS = pclassdesc.CONSTANTS][.EXTERNAL = (S)][.DEFAULT = true][.CONSTANT = true][.CLASSCONTEXT = (ptcontext)][.FILE = ($call_sourcefile(S.FILES, PORIGIN n pcpath))][.CWD = ($call_request_cwd(S.REQUEST))][.MEMORY = S_memory[.REPORTING = 32767][.EVENTS = eps]], pcpath, expression, $plempty(false), pclassdesc.LINE)
def $trait_member_fold(S, pclassdesc, porigin) = eps -- otherwise
def $trait_pool_facts(S, n, eps) = eps
def $trait_pool_facts(S, n, (PCONSTANT pcpath pvalue) :: pconstant*) = (PFFACT pcpath pvalue $expression_line(expression)) :: $trait_pool_facts(S, n, pconstant*)
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (expression)
def $trait_pool_facts(S, n, (PCONSTANT pcpath pvalue) :: pconstant*) = $trait_pool_facts(S, n, pconstant*)
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = eps
def $trait_pool_facts(S, n, (PCCLASS pcpath pvalueclass) :: pconstant*) = $trait_pool_facts(S, n, pconstant*)
def $trait_pool_facts(S, n, (PCCPRECISION pcpath z) :: pconstant*) = $trait_pool_facts(S, n, pconstant*)
def $trait_pool_classes(eps) = eps
def $trait_pool_classes((PCCLASS pcpath pvalueclass) :: pconstant*) = (pcpath, pvalueclass) :: $trait_pool_classes(pconstant*)
def $trait_pool_classes((PCONSTANT pcpath pvalue) :: pconstant*) = $trait_pool_classes(pconstant*)
def $trait_pool_classes((PCCPRECISION pcpath z) :: pconstant*) = $trait_pool_classes(pconstant*)

def $trait_fold_owner(F) = (porigin_owner)
  -- if F.LOOKUPS = eps
  -- if F.MEMORY.CONSTCONTEXT = (pconstantcontext)
