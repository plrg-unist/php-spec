dec $trait_type_display_atom(ptatom, ptinput) : ptatom
dec $trait_type_keyword_named(ptinput, ptbytes) : ptbytes?
dec $trait_type_keyword_names(ptinput*, ptbytes) : ptbytes?
dec $trait_type_keyword_spelling(ptinput) : ptbytes?
dec $trait_type_keyword_spellings(ptinput*) : ptbytes?
dec $trait_type_contextual(ptbranch*) : bool
