dec $closure_call_copy_pending(ptask) : bool
def $closure_call_copy_pending(CLOSURE_CALL_COPY_RESULT pclosurecall n_copy) = true
def $closure_call_copy_pending(CLOSURE_CALL_COPY_FORWARD pclosurecall n_copy n pnamedargs n_base) = true
def $closure_call_copy_pending(CLOSURE_CALL_COPY_REFERENCE pclosurecall n_copy n pnamedargs n_base) = true
def $closure_call_copy_pending(ERROR_HANDLER_RESULT perrorcall) = $closure_call_copy_pending(perrorcall.RESUME)
def $closure_call_copy_pending(ERROR_HANDLER_INVOKE perrorcall) = $closure_call_copy_pending(perrorcall.RESUME)
def $closure_call_copy_pending(ptask) = false -- otherwise
