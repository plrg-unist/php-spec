  -- if $(pclosurecall.INDEX > 0)
  -- if $(pclosurecall.INDEX <= |phpType7_all*|)
  -- if phpType7_done* = phpType7_all*[0:pclosurecall.INDEX]
  -- if phpType7_forward* = $closure_call_forward_source(phpType7_done*)
  -- if $closure_call_source(S, pclosurecall.SOURCE)
  -- if $closure_call_named_receiver_valid(S, pclosurecall, phpType7_done*)
  -- if $closure_call_raw_keys(pclosurecall.RAW) = $closure_call_source_keys(phpType7_forward*, 0)
  -- if $closure_call_raw_unique_names(pclosurecall.RAW)
  -- if $closure_call_invalid_sent_valid(S, $closure_call_parameters(S, pclosurecall.SOURCE), pclosurecall, phpType7_forward*)
def $closure_call_progress_valid(S, pclosurecall) = true
  -- if pclosurecall.PACKS = eps
  -- if ~$closure_call_array_pack_site(S, pclosurecall.SITE)
  -- if $closure_call_args_at(S, pclosurecall.SITE) = (NArg ABSENT expression_first (BOOLEAN false) (BOOLEAN false) metadata_first) :: phpType7_tail*
  -- if $(pclosurecall.INDEX > 0)
  -- if $(pclosurecall.INDEX <= |phpType7_tail*| + 1)
  -- if $closure_call_source(S, pclosurecall.SOURCE)
  -- if $closure_call_positional_receiver_valid(S, pclosurecall)
  -- if n_done = $(pclosurecall.INDEX - 1)
  -- if $closure_call_raw_keys(pclosurecall.RAW) = $closure_call_source_keys(phpType7_tail*[0:n_done], 0)
  -- if $closure_call_raw_unique_names(pclosurecall.RAW)
  -- if $closure_call_invalid_sent_valid(S, $closure_call_parameters(S, pclosurecall.SOURCE), pclosurecall, phpType7_tail*[0:n_done])
def $closure_call_progress_valid(S, pclosurecall) = false -- otherwise
def $closure_call_positional_receiver_valid(S, pclosurecall) = $closure_call_pending_object(S, n_receiver)
  -- if pclosurecall.FIRST = (POBJECT n_receiver)
  -- if pclosurecall.RECEIVER = (n_receiver)
def $closure_call_positional_receiver_valid(S, pclosurecall) = true
  -- if pclosurecall.FIRST = (pvalue)
  -- if $closure_call_nonobject(pvalue)
  -- if pclosurecall.RECEIVER = eps
def $closure_call_positional_receiver_valid(S, pclosurecall) = false -- otherwise

def $call_task_valid(S, CLOSURE_CALL_ARGS pclosurecall) = ($closure_call_task_valid(S, pclosurecall) /\ $closure_call_initial_source_valid(S, pclosurecall) /\ $closure_call_initial_receiver_valid(S, pclosurecall))
def $call_task_valid(S, CLOSURE_CALL_SEND pclosurecall) = $closure_call_task_valid(S, pclosurecall)
def $call_task_valid(S, CLOSURE_CALL_INVOKE pclosurecall) = $closure_call_task_valid(S, pclosurecall)
def $task_nodes(CLOSURE_CALL_RESULT porigin z) = eps
dec $closure_call_result_valid(pstate, porigin, int) : bool
def $closure_call_result_valid(S, porigin, z) = true
  -- if $closure_call_args_at(S, porigin) = phpType7*
  -- if $call_line_valid(S, (porigin), z)
def $closure_call_result_valid(S, porigin, z) = false -- otherwise
def $call_task_valid(S, CLOSURE_CALL_RESULT porigin z) = $closure_call_result_valid(S, porigin, z)
rule PhpStep/closure-call-result: S ~> S_read[.TODO = ptask_tail*][.BASE = BASE_VALUE S_read.RESULT]
  -- if S.TODO = (CLOSURE_CALL_RESULT porigin z) :: ptask_tail*
