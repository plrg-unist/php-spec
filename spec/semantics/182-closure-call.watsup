def $closure_call_function_name(S, pfunction, n_receiver) = $bind_scope_name(S, $bind_object_scope(S, n_receiver)) ++ $ptascii("::") ++ $closure_call_body_name(S, pfunction)

def $call_function_name(S, pfunction) = $closure_call_function_name(S, pfunction, n_receiver)
