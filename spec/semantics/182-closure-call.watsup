dec $closure_call_forward_args_at(pstate, porigin) : phpType7*
def $closure_call_forward_args_at(S, porigin) = phpType7_tail*
  -- if $closure_call_args_at(S, porigin) = (NArg ABSENT expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType7_tail*
def $closure_call_forward_args_at(S, porigin) = $closure_call_forward_source(phpType7*)
  -- if $closure_call_args_at(S, porigin) = (NArg (NIdentifier (BYTES text) metadata_name) expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType7_tail*
  -- if phpType7* = (NArg (NIdentifier (BYTES text) metadata_name) expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType7_tail*
  -- if $closure_call_named_form(phpType7*)
def $closure_call_args_at(S, porigin) = phpType7*
  -- if $origin_node(S.SOURCES, porigin) = (NExprMethodCall expression phpType20 (SEQUENCE phpType7*) metadata)
  -- if $method_source_name(phpType20, $ptascii("call"))
def $closure_call_args_at(S, porigin) = phpType7*
  -- if $origin_node(S.SOURCES, porigin) = (NExprNullsafeMethodCall expression phpType20 (SEQUENCE phpType7*) metadata)
  -- if $method_source_name(phpType20, $ptascii("call"))
def $closure_call_source_expression(S, porigin) = expression
  -- if $origin_node(S.SOURCES, porigin) = (NExprMethodCall expression phpType20 phpType6 metadata)
def $closure_call_source_expression(S, porigin) = expression
  -- if $origin_node(S.SOURCES, porigin) = (NExprNullsafeMethodCall expression phpType20 phpType6 metadata)

def $method_select(S, poperand, ptbytes, phpType7*, z) = S_read[.TODO = [CLOSURE_CALL_ARGS {SITE porigin_site, SOURCE n, FIRST eps, RECEIVER eps, INDEX 0, SENT {SLOTS eps, NAMED eps}, RAW eps, ERROR eps, LINE z, PACKS eps}, CLOSURE_CALL_RESULT porigin_site z, METHOD_RESULT] ++ ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
