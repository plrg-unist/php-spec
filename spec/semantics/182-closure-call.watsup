  -- if $ptlc(ptbytes) = $ptascii("call")
  -- if ~$ppfirstclass(phpType7*)
  -- if $closure_call_args_at(S_read, porigin_site) = phpType7*

def $target_nodes(CLOSURE_CALL_TARGET n_source n_receiver) = [HOBJECT n_source, HOBJECT n_receiver]
def $target_function(S, CLOSURE_CALL_TARGET n_source n_receiver) = $target_function(S, CLOSURE_TARGET n_source)
def $target_instance(CLOSURE_CALL_TARGET n_source n_receiver) = (n_source)
def $target_receiver(S, CLOSURE_CALL_TARGET n_source n_receiver) = (n_receiver)
def $target_lexical_class(S, CLOSURE_CALL_TARGET n_source n_receiver) = $bind_scope_origin($bind_object_scope(S, n_receiver))
def $target_called_class(S, CLOSURE_CALL_TARGET n_source n_receiver) = $bind_scope_origin($bind_object_scope(S, n_receiver))

def $closure_call_target(CLOSURE_CALL_TARGET n_source n_receiver) = true
def $closure_call_target(pcalltarget) = false -- otherwise

