rule PhpStep/closure-call-invalid-this: S ~> $throwable_allocate(S[.TODO = ptask_tail*][.ORIGIN = (pclosurecall.SITE)], "TypeError", $ptascii("Closure::call(): Argument #1 ($newThis) must be of type object, ") ++ $typed_given(S, pvalue) ++ $ptascii(" given"), pclosurecall.LINE, [ptraceframe] ++ $eval_exception_trace_raw(S))
