  -- if ~$closure_call_reference_formal(pfunction.SIGNATURE.PARAMETERS)
  -- if ptraceframe = {FILE $call_sourcefile(S.FILES, pclosurecall.SITE), LINE pclosurecall.LINE, FUNCTION $ptascii("call"), CLASS ($ptascii("Closure")), TYPE ($ptascii("->")), ARGS ((KINT 0, POBJECT n_receiver) :: $closure_call_trace_raw(S, pclosurecall.RAW)), HASARGS true}

dec $closure_call_enter(pstate, pfunction, pclosurecall, nat) : pstate
dec $closure_call_wrapper((pkey, poperand)*) : pnamedargs
def $closure_call_wrapper(eps) = {SLOTS eps, NAMED eps}
def $closure_call_wrapper((KINT z, poperand) :: (pkey_tail, poperand_tail)*) = pnamedargs[.SLOTS = (NAMED_SENT poperand) :: pnamedargs.SLOTS]
  -- if pnamedargs = $closure_call_wrapper((pkey_tail, poperand_tail)*)
def $closure_call_wrapper((KSTRING preqbytes, poperand) :: (pkey_tail, poperand_tail)*) = pnamedargs[.NAMED = (preqbytes, poperand) :: pnamedargs.NAMED]
  -- if pnamedargs = $closure_call_wrapper((pkey_tail, poperand_tail)*)
dec $closure_call_wrapper_shape(phpType7*) : pnamedargs
def $closure_call_wrapper_shape(eps) = {SLOTS eps, NAMED eps}
def $closure_call_wrapper_shape((NArg ABSENT expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType7*) = pnamedargs[.SLOTS = (NAMED_SENT (KNOWN PNULL)) :: pnamedargs.SLOTS]
  -- if pnamedargs = $closure_call_wrapper_shape(phpType7*)
def $closure_call_wrapper_shape((NArg (NIdentifier (BYTES text) metadata_name) expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType7*) = pnamedargs[.NAMED = ($base64(text), KNOWN PNULL) :: pnamedargs.NAMED]
  -- if pnamedargs = $closure_call_wrapper_shape(phpType7*)
def $closure_call_wrapper_slots_valid(eps, eps) = true
def $closure_call_wrapper_slots_valid(NAMED_HOLE :: pnamedslot*, NAMED_HOLE :: pnamedslot_shape*) = $closure_call_wrapper_slots_valid(pnamedslot*, pnamedslot_shape*)
def $closure_call_wrapper_slots_valid((NAMED_SENT (KNOWN pvalue)) :: pnamedslot*, (NAMED_SENT poperand) :: pnamedslot_shape*) = $closure_call_wrapper_slots_valid(pnamedslot*, pnamedslot_shape*)
def $closure_call_wrapper_slots_valid(pnamedslot*, pnamedslot_shape*) = false -- otherwise
def $closure_call_wrapper_names_valid(eps, eps) = true
def $closure_call_wrapper_names_valid((preqbytes, KNOWN pvalue) :: (preqbytes_tail, poperand_tail)*, (preqbytes, poperand) :: (preqbytes_shape, poperand_shape)*) = $closure_call_wrapper_names_valid((preqbytes_tail, poperand_tail)*, (preqbytes_shape, poperand_shape)*)
def $closure_call_wrapper_names_valid((preqbytes, poperand)*, (preqbytes_shape, poperand_shape)*) = false -- otherwise
rule PhpStep/closure-call-invoke: S ~> $closure_call_enter(S[.TODO = ptask_tail*], pfunction, pclosurecall, n_receiver)
  -- if S.TODO = (CLOSURE_CALL_INVOKE pclosurecall) :: ptask_tail*
  -- if pclosurecall.RECEIVER = (n_receiver)
  -- if $target_function(S, CLOSURE_CALL_TARGET pclosurecall.SOURCE n_receiver) = (pfunction)
  -- if pclosurecall.ERROR = eps \/ $closure_call_copy_required(S, pfunction, pclosurecall)
  -- if $closure_call_warning(S, pclosurecall.SOURCE, n_receiver) = eps
  -- if $deprecated_api_allowed(S, pfunction)
  -- if ~$closure_call_reference_formal(pfunction.SIGNATURE.PARAMETERS) \/ $closure_call_copy_required(S, pfunction, pclosurecall)
rule PhpStep/closure-call-deprecated-api: S ~> S[.COMPLETION = UNSUPPORTED "Deprecated internal API timing"]
  -- if S.TODO = (CLOSURE_CALL_INVOKE pclosurecall) :: ptask_tail*
  -- if $call_task_valid(S, CLOSURE_CALL_INVOKE pclosurecall)
  -- if pclosurecall.RECEIVER = (n_receiver)
  -- if $target_function(S, CLOSURE_CALL_TARGET pclosurecall.SOURCE n_receiver) = (pfunction)
  -- if $closure_call_warning(S, pclosurecall.SOURCE, n_receiver) = eps
  -- if ~$deprecated_api_allowed(S, pfunction)

;; The internal API forwards values in outer source order. Reference formals
;; warn and receive fresh cells, never the caller's reference operands.
dec $closure_call_reference_name(psparam*, nat) : ptbytes
def $closure_call_reference_name(psparam_parameters*, n) = $ptascii(" ($") ++ psparam.NAME ++ [41]
  -- if $(n < |$call_fixed_parameters(psparam_parameters*)|)
  -- if $call_parameter_at(psparam_parameters*, n) = (psparam)
def $closure_call_reference_name(psparam*, n) = eps -- otherwise
dec $closure_call_forward_operand(pstate, pfunction, nat, pnamedtarget, pvalue, int) : pstate
def $closure_call_forward_operand(S, pfunction, n_receiver, pnamedtarget, pvalue, z) = S[.RESULT = KNOWN pvalue]
  -- if ~$named_reference(pfunction, pnamedtarget)

dec $closure_call_sent_operand(pnamedargs, pnamedtarget) : poperand?
