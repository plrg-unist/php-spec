dec $closure_call_progress_valid(pstate, pclosurecall) : bool
def $closure_call_task_valid(S, pclosurecall) = ($call_line_valid(S, (pclosurecall.SITE), pclosurecall.LINE) /\ $closure_call_raw_evaluated(pclosurecall.RAW) /\ $closure_call_progress_valid(S, pclosurecall))
