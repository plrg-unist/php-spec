  -- if pvalue* = $trace_parameters(S, pbinding*, (psparam.NAME)*, pcallcontext.ARGC) ++ $trace_extra(S, pcallcontext.EXTRA)
def $wrapper_trace(S, pcallcontext) = [{FILE $call_sourcefile(S.FILES, porigin_site), LINE pcallcontext.LINE, FUNCTION $ptascii("call"), CLASS ($ptascii("Closure")), TYPE ($ptascii("->")), ARGS ((KINT 0, POBJECT n_receiver) :: $trace_indexed_args(pvalue*, 1) ++ $trace_named_args(S, pnamedargs.NAMED)), HASARGS true}]
