;; Closure::call invokes the selected real closure with a temporary receiver.
;; The closure object and its static cells are not cloned.
dec $closure_call_args_at(pstate, porigin) : phpType7*
dec $closure_call_function_name(pstate, pfunction, nat) : preqbytes
dec $closure_call_wrapper_names_valid((preqbytes, poperand)*, (preqbytes, poperand)*) : bool
dec $closure_call_wrapper_slots_valid(pnamedslot*, pnamedslot*) : bool
dec $closure_call_forward_source(phpType7*) : phpType7*
dec $closure_call_named_form(phpType7*) : bool
dec $closure_call_reference_formal(psparam*) : bool
def $closure_call_reference_formal(eps) = false
def $closure_call_reference_formal(psparam :: psparam_tail*) = true -- if psparam.BYREF
def $closure_call_reference_formal(psparam :: psparam_tail*) = $closure_call_reference_formal(psparam_tail*) -- if ~psparam.BYREF
dec $closure_call_forward_args_at(pstate, porigin) : phpType7*
def $closure_call_forward_args_at(S, porigin) = phpType7_tail*
  -- if $closure_call_args_at(S, porigin) = (NArg ABSENT expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType7_tail*
def $closure_call_forward_args_at(S, porigin) = $closure_call_forward_source(phpType7*)
  -- if $closure_call_args_at(S, porigin) = (NArg (NIdentifier (BYTES text) metadata_name) expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType7_tail*
  -- if phpType7* = (NArg (NIdentifier (BYTES text) metadata_name) expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType7_tail*
  -- if $closure_call_named_form(phpType7*)
def $closure_call_args_at(S, porigin) = phpType7*
  -- if $origin_node(S.SOURCES, porigin) = (NExprMethodCall expression (NIdentifier (BYTES text_name) metadata_name) (SEQUENCE phpType7*) metadata)
  -- if $ptlc($base64(text_name)) = $ptascii("call")

def $method_select(S, poperand, ptbytes, phpType7*, z) = S_read[.TODO = [CLOSURE_CALL_ARGS {SITE porigin_site, SOURCE n, FIRST eps, RECEIVER eps, INDEX 0, SENT {SLOTS eps, NAMED eps}, RAW eps, ERROR eps, LINE z}, CLOSURE_CALL_RESULT porigin_site z, METHOD_RESULT] ++ ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
