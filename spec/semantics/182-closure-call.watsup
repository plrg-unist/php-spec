dec $closure_call_raw_roots((pkey, poperand)*) : pnode*
def $closure_call_raw_roots(eps) = eps
def $closure_call_raw_roots((pkey, poperand) :: (pkey_tail, poperand_tail)*) = $operand_nodes(poperand) ++ $closure_call_raw_roots((pkey_tail, poperand_tail)*)
dec $closure_call_raw_evaluated((pkey, poperand)*) : bool
def $closure_call_raw_evaluated(eps) = true
def $closure_call_raw_evaluated((pkey, KNOWN pvalue) :: (pkey_tail, poperand_tail)*) = $closure_call_raw_evaluated((pkey_tail, poperand_tail)*)
def $closure_call_raw_evaluated((pkey, poperand)*) = false -- otherwise
dec $closure_call_raw_keys((pkey, poperand)*) : pkey*
def $closure_call_raw_keys(eps) = eps
def $closure_call_raw_keys((pkey, poperand) :: (pkey_tail, poperand_tail)*) = pkey :: $closure_call_raw_keys((pkey_tail, poperand_tail)*)
dec $closure_call_source_keys(phpType7*, nat) : pkey*
def $closure_call_source_keys(eps, n) = eps
def $closure_call_source_keys((NArg ABSENT expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType7*, n) = (KINT $(n + 1)) :: $closure_call_source_keys(phpType7*, $(n + 1))
def $closure_call_source_keys((NArg (NIdentifier (BYTES text) metadata_name) expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType7*, n) = (KSTRING $base64(text)) :: $closure_call_source_keys(phpType7*, $(n + 1))
def $closure_call_named_form(eps) = true
def $closure_call_named_form((NArg (NIdentifier (BYTES text) metadata_name) expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType7*) = $closure_call_named_form(phpType7*)
def $closure_call_named_form(phpType7*) = false -- otherwise
dec $closure_call_newthis_name(phpType3) : bool
def $closure_call_newthis_name(NIdentifier (BYTES text) metadata) = ($base64(text) = $ptascii("newThis"))
def $closure_call_newthis_name(phpType3) = false -- otherwise
def $closure_call_forward_source(eps) = eps
def $closure_call_forward_source((NArg (NIdentifier (BYTES text) metadata_name) expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType7*) = $closure_call_forward_source(phpType7*)
  -- if $base64(text) = $ptascii("newThis")
def $closure_call_forward_source((NArg phpType3 expression phpType4_ref phpType4_unpack metadata) :: phpType7*) = (NArg phpType3 expression phpType4_ref phpType4_unpack metadata) :: $closure_call_forward_source(phpType7*)
  -- if ~$closure_call_newthis_name(phpType3)
dec $closure_call_newthis_seen(phpType7*) : bool
def $closure_call_newthis_seen(eps) = false
def $closure_call_newthis_seen((NArg phpType3 expression phpType4_ref phpType4_unpack metadata) :: phpType7*) = ($closure_call_newthis_name(phpType3) \/ $closure_call_newthis_seen(phpType7*))
dec $closure_call_forward_index(phpType7*, nat) : nat
def $closure_call_forward_index((NArg ABSENT expression phpType4_ref phpType4_unpack metadata) :: phpType7*, n) = $nabs($(n - 1))
  -- if $(n > 0)
def $closure_call_forward_index((NArg (NIdentifier (BYTES text) metadata_name) expression phpType4_ref phpType4_unpack metadata) :: phpType7*, n) = n
dec $closure_call_arg_key(phpType3, nat) : pkey
def $closure_call_arg_key(ABSENT, n) = KINT $(n + 1)
def $closure_call_arg_key(NIdentifier (BYTES text) metadata_name, n) = KSTRING $base64(text)
dec $closure_call_named_seen((pkey, poperand)*, preqbytes) : bool
dec $closure_call_outer_duplicate(pvalue?, (pkey, poperand)*, phpType3) : bool
def $closure_call_named_seen(eps, n_name*) = false
def $closure_call_named_seen((KSTRING n_name*, poperand) :: (pkey_tail, poperand_tail)*, n_name*) = true
def $closure_call_named_seen((KSTRING n_other*, poperand) :: (pkey_tail, poperand_tail)*, n_name*) = $closure_call_named_seen((pkey_tail, poperand_tail)*, n_name*)
  -- if n_other* =/= n_name*
def $closure_call_named_seen((KINT n, poperand) :: (pkey_tail, poperand_tail)*, n_name*) = $closure_call_named_seen((pkey_tail, poperand_tail)*, n_name*)
dec $closure_call_raw_unique_names((pkey, poperand)*) : bool
def $closure_call_raw_unique_names(eps) = true
def $closure_call_raw_unique_names((KSTRING n_name*, poperand) :: (pkey_tail, poperand_tail)*) = (n_name* =/= $ptascii("newThis") /\ ~$closure_call_named_seen((pkey_tail, poperand_tail)*, n_name*) /\ $closure_call_raw_unique_names((pkey_tail, poperand_tail)*))
def $closure_call_raw_unique_names((KINT n, poperand) :: (pkey_tail, poperand_tail)*) = $closure_call_raw_unique_names((pkey_tail, poperand_tail)*)
dec $closure_call_trace_raw(pstate, (pkey, poperand)*) : (pkey, pvalue)*
def $closure_call_trace_raw(S, eps) = eps
def $closure_call_trace_raw(S, (pkey, poperand) :: (pkey_tail, poperand_tail)*) = (pkey, $variadic_operand_value(S, poperand)) :: $closure_call_trace_raw(S, (pkey_tail, poperand_tail)*)
dec $closure_call_raw_sent(psparam*, phpType7*, (pkey, poperand)*, nat, pnamedargs) : pnamedargs
def $closure_call_raw_sent(psparam*, eps, eps, n, pnamedargs) = pnamedargs
def $closure_call_raw_sent(psparam*, (NArg phpType3 expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType7_tail*, (pkey, poperand) :: (pkey_tail, poperand_tail)*, n, pnamedargs) = $closure_call_raw_sent(psparam*, phpType7_tail*, (pkey_tail, poperand_tail)*, $(n + 1), $named_store(pnamedargs, $named_target(psparam*, phpType3, n), poperand))
dec $closure_call_source_error(psparam*, phpType7*, nat, pnamedargs) : ptbytes?
def $closure_call_source_error(psparam*, eps, n, pnamedargs) = eps
def $closure_call_source_error(psparam*, (NArg (NIdentifier (BYTES text) metadata_name) expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType7*, n, pnamedargs) = ($ptascii("Unknown named parameter $") ++ $c_string($base64(text)))
  -- if $named_target(psparam*, NIdentifier (BYTES text) metadata_name, n) = NAMED_UNKNOWN preqbytes
def $closure_call_source_error(psparam*, (NArg (NIdentifier (BYTES text) metadata_name) expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType7*, n, pnamedargs) = ($ptascii("Named parameter $") ++ $c_string($base64(text)) ++ $ptascii(" overwrites previous argument"))
  -- if $named_target(psparam*, NIdentifier (BYTES text) metadata_name, n) = NAMED_POSITION n_target
  -- if ~$named_can_store(pnamedargs, NAMED_POSITION n_target)
def $closure_call_source_error(psparam*, (NArg (NIdentifier (BYTES text) metadata_name) expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType7*, n, pnamedargs) = ($ptascii("Named parameter $") ++ $c_string($base64(text)) ++ $ptascii(" overwrites previous argument"))
  -- if $named_target(psparam*, NIdentifier (BYTES text) metadata_name, n) = NAMED_EXTRA preqbytes
  -- if ~$named_can_store(pnamedargs, NAMED_EXTRA preqbytes)
def $closure_call_source_error(psparam*, (NArg phpType3 expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType7*, n, pnamedargs) = $closure_call_source_error(psparam*, phpType7*, $(n + 1), $named_store(pnamedargs, pnamedtarget, KNOWN PNULL))
  -- if pnamedtarget = $named_target(psparam*, phpType3, n)
  -- if $named_can_store(pnamedargs, pnamedtarget)

dec $closure_call_first_roots(pvalue?) : pnode*
def $closure_call_first_roots(eps) = eps
def $closure_call_first_roots((pvalue)) = $value_nodes(pvalue)
def $task_nodes(CLOSURE_CALL_ARGS pclosurecall) = [HOBJECT pclosurecall.SOURCE] ++ $closure_call_first_roots(pclosurecall.FIRST) ++ $instance_roots(pclosurecall.RECEIVER) ++ $named_slots_roots(pclosurecall.SENT.SLOTS) ++ $named_roots(pclosurecall.SENT.NAMED) ++ $closure_call_raw_roots(pclosurecall.RAW)
def $task_nodes(CLOSURE_CALL_SEND pclosurecall) = [HOBJECT pclosurecall.SOURCE] ++ $closure_call_first_roots(pclosurecall.FIRST) ++ $instance_roots(pclosurecall.RECEIVER) ++ $named_slots_roots(pclosurecall.SENT.SLOTS) ++ $named_roots(pclosurecall.SENT.NAMED) ++ $closure_call_raw_roots(pclosurecall.RAW)
def $task_nodes(CLOSURE_CALL_INVOKE pclosurecall) = [HOBJECT pclosurecall.SOURCE] ++ $closure_call_first_roots(pclosurecall.FIRST) ++ $instance_roots(pclosurecall.RECEIVER) ++ $named_slots_roots(pclosurecall.SENT.SLOTS) ++ $named_roots(pclosurecall.SENT.NAMED) ++ $closure_call_raw_roots(pclosurecall.RAW)

dec $closure_call_initial_source_valid(pstate, pclosurecall) : bool
def $closure_call_initial_source_valid(S, pclosurecall) = $bind_variable_matches(S, $base64(text), pclosurecall.SOURCE)
  -- if pclosurecall.INDEX = 0
  -- if $origin_node(S.SOURCES, pclosurecall.SITE) = (NExprMethodCall (NExprVariable (BYTES text) metadata_var) phpType20 (SEQUENCE phpType7*) metadata)
def $closure_call_initial_source_valid(S, pclosurecall) = true
  -- if pclosurecall.INDEX = 0
  -- if $origin_node(S.SOURCES, pclosurecall.SITE) = (NExprMethodCall expression phpType20 (SEQUENCE phpType7*) metadata)
  -- if ~$bind_simple_variable(expression)
def $closure_call_initial_source_valid(S, pclosurecall) = true
  -- if $(pclosurecall.INDEX > 0)
def $closure_call_initial_source_valid(S, pclosurecall) = false -- otherwise

