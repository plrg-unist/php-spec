rule PhpStep/closure-call-missing-this: S ~> $throwable_allocate(S[.TODO = ptask_tail*][.ORIGIN = (pclosurecall.SITE)], "ArgumentCountError", $ptascii("Closure::call() expects at least 1 argument, 0 given"), pclosurecall.LINE, [ptraceframe] ++ $eval_exception_trace_raw(S))
  -- if S.TODO = (CLOSURE_CALL_INVOKE pclosurecall) :: ptask_tail*
