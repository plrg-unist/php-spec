  -- if S_read = $resolve_at(S, S.RESULT, pclosurecall.LINE)
  -- if S_read.COMPLETION = NORMAL
rule PhpStep/closure-call-send-named-abrupt: S ~> S_read[.TODO = (CLOSURE_CALL_ARGS pclosurecall[.INDEX = $(pclosurecall.INDEX + 1)][.SENT = {SLOTS eps, NAMED eps}][.RAW = pclosurecall.RAW ++ [(KSTRING $base64(text_name), KNOWN pvalue)]][.ERROR = (n_message*)]) :: ptask_tail*][.RESULT = KNOWN PNULL]
