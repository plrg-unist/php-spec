;; No-Generator throws retain their copy after the callee frame has unwound.
;; Earlier warning/mapping cursors still own their prepared argv prefixes.
dec $closure_call_copy_warning_pending(ptask) : bool
def $closure_call_copy_warning_pending(CLOSURE_CALL_COPY_REFERENCE pclosurecall n_copy n pnamedargs n_base) = true
