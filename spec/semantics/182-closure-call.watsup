rule PhpStep/closure-call-arguments-done: S ~> S[.TODO = (CLOSURE_CALL_INVOKE pclosurecall) :: ptask_tail*]
  -- if S.TODO = (CLOSURE_CALL_ARGS pclosurecall) :: ptask_tail*
