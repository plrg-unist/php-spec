def $closure_call_outer_duplicate(eps, (pkey, poperand)*, NIdentifier (BYTES text) metadata_name) = false
  -- if $base64(text) = $ptascii("newThis")
def $closure_call_outer_duplicate(eps, (pkey, poperand)*, NIdentifier (BYTES text) metadata_name) = $closure_call_named_seen((pkey, poperand)*, $base64(text))
  -- if $base64(text) =/= $ptascii("newThis")
def $closure_call_outer_duplicate((pvalue), (pkey, poperand)*, NIdentifier (BYTES text) metadata_name) = ($base64(text) = $ptascii("newThis") \/ $closure_call_named_seen((pkey, poperand)*, $base64(text)))
def $closure_call_outer_duplicate(pvalue?, (pkey, poperand)*, phpType3) = false -- otherwise
rule PhpStep/closure-call-send-duplicate-outer: S ~> $throwable_allocate(S_read[.TODO = ptask_tail*][.ORIGIN = (pclosurecall.SITE)], "Error", $ptascii("Named parameter $") ++ $c_string($base64(text_name)) ++ $ptascii(" overwrites previous argument"), $named_line(S, (pclosurecall.SITE), pclosurecall.INDEX), $eval_exception_trace_raw(S_read))
  -- if S.TODO = (CLOSURE_CALL_SEND pclosurecall) :: ptask_tail*
  -- if $(pclosurecall.INDEX > 0)
