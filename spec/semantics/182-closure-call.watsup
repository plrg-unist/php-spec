rule PhpStep/closure-call-named-error: S ~> $throwable_allocate(S[.TODO = ptask_tail*][.ORIGIN = (pclosurecall.SITE)], "Error", preqbytes, pclosurecall.LINE, [ptraceframe] ++ $eval_exception_trace_raw(S))
  -- if S.TODO = (CLOSURE_CALL_INVOKE pclosurecall) :: ptask_tail*
