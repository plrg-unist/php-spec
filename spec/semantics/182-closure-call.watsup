def $closure_call_named_operand(eps, ptbytes) = eps
def $closure_call_named_operand((ptbytes, poperand) :: (ptbytes_tail, poperand_tail)*, ptbytes) = (poperand)
def $closure_call_named_operand((ptbytes_other, poperand) :: (ptbytes_tail, poperand_tail)*, ptbytes) = $closure_call_named_operand((ptbytes_tail, poperand_tail)*, ptbytes)
