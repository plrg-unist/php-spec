  -- if S_checked.COMPLETION = THROWN "Error" n_message* z_error
rule PhpStep/closure-call-send-after-error: S ~> S_read[.TODO = (CLOSURE_CALL_ARGS pclosurecall[.INDEX = $(pclosurecall.INDEX + 1)][.RAW = pclosurecall.RAW ++ [($closure_call_arg_key(phpType3, n_forward), KNOWN pvalue)]]) :: ptask_tail*][.RESULT = KNOWN PNULL]
