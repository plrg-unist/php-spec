;; Completed rows belonging to this receive advance in source effect order.
;; Earlier closed-receive donors retain their own cuts, never the current id.
def $parameter_multiple_registrations(S, preceivebirth, n_owner, preceiveorder, eps, n_index, porigin_previous?) = true
def $parameter_multiple_registrations(S, preceivebirth, n_owner, preceiveorder, puserconstant :: puserconstant_tail*, n_index, porigin_previous?) = $parameter_multiple_registrations(S, preceivebirth, n_owner, preceiveorder, puserconstant_tail*, $(n_index + 1), porigin_previous?)
  -- if $(n_index < preceivebirth.PREFIX)
  -- if $parameter_receive_producer(S, puserconstant, n_owner) = eps
  -- if $parameter_receive_cut_at(puserconstant.RECEIVES, n_owner) = eps
def $parameter_multiple_registrations(S, preceivebirth, n_owner, preceiveorder, puserconstant :: puserconstant_tail*, n_index, porigin_previous?) = $parameter_multiple_registrations(S, preceivebirth, n_owner, preceiveorder, puserconstant_tail*, $(n_index + 1), (porigin_site))
  -- if $(preceivebirth.PREFIX <= n_index)
  -- if $parameter_receive_producer(S, puserconstant, n_owner) =/= eps
  -- if $parameter_receive_cut_at(puserconstant.RECEIVES, n_owner) = (preceivecut)
  -- if $parameter_receive_frontier_site(preceivecut.FRONTIER) = (porigin_site)
  -- if porigin_site <- preceiveorder.EFFECTS
  -- if $parameter_receive_cut_valid(S, preceivebirth, porigin_site, puserconstant, preceivecut)
  -- if $parameter_multiple_forward(preceiveorder.EFFECTS, porigin_previous?, porigin_site)
def $parameter_multiple_registrations(S, preceivebirth, n_owner, preceiveorder, puserconstant*, n_index, porigin_previous?) = false -- otherwise

;; A read sees exactly the rows published by preceding source frontiers.
;; An unrelated later registration still advances the required table prefix.
def $parameter_multiple_prefix(S, preceivebirth, n_owner, preceiveorder, porigin_leaf, eps, n_index, n_prefix) = (n_prefix)
def $parameter_multiple_prefix(S, preceivebirth, n_owner, preceiveorder, porigin_leaf, puserconstant :: puserconstant_tail*, n_index, n_prefix) = $parameter_multiple_prefix(S, preceivebirth, n_owner, preceiveorder, porigin_leaf, puserconstant_tail*, $(n_index + 1), n_prefix)
  -- if $(n_index < preceivebirth.PREFIX)
def $parameter_multiple_prefix(S, preceivebirth, n_owner, preceiveorder, porigin_leaf, puserconstant :: puserconstant_tail*, n_index, n_prefix) = $parameter_multiple_prefix(S, preceivebirth, n_owner, preceiveorder, porigin_leaf, puserconstant_tail*, $(n_index + 1), $(n_index + 1))
  -- if $(preceivebirth.PREFIX <= n_index)
  -- if $parameter_receive_cut_at(puserconstant.RECEIVES, n_owner) = (preceivecut)
  -- if $parameter_receive_frontier_site(preceivecut.FRONTIER) = (porigin_effect)
  -- if $parameter_receive_before(preceiveorder.LEAVES, porigin_effect, porigin_leaf)
def $parameter_multiple_prefix(S, preceivebirth, n_owner, preceiveorder, porigin_leaf, puserconstant :: puserconstant_tail*, n_index, n_prefix) = $parameter_multiple_prefix(S, preceivebirth, n_owner, preceiveorder, porigin_leaf, puserconstant_tail*, $(n_index + 1), n_prefix)
  -- if $(preceivebirth.PREFIX <= n_index)
  -- if $parameter_receive_cut_at(puserconstant.RECEIVES, n_owner) = (preceivecut)
  -- if $parameter_receive_frontier_site(preceivecut.FRONTIER) = (porigin_effect)
  -- if ~$parameter_receive_before(preceiveorder.LEAVES, porigin_effect, porigin_leaf)
def $parameter_multiple_prefix(S, preceivebirth, n_owner, preceiveorder, porigin_leaf, puserconstant*, n_index, n_prefix) = eps -- otherwise
def $parameter_multiple_lookup_prefix(S, preceivebirth, n_owner, preceiveorder, porigin_leaf) = $parameter_multiple_prefix(S, preceivebirth, n_owner, preceiveorder, porigin_leaf, S.USERCONSTANTS, 0, preceivebirth.PREFIX)
  -- if porigin_leaf <- preceiveorder.LEAVES
def $parameter_multiple_lookup_prefix(S, preceivebirth, n_owner, preceiveorder, porigin_leaf) = eps -- otherwise

def $parameter_multiple_facts(S, preceivebirth, n_owner, preceiveorder, eps) = true
def $parameter_multiple_facts(S, preceivebirth, n_owner, preceiveorder, pconstantfact :: pconstantfact_tail*) = true
  -- if pconstantfact.LOOKUP = (pconstantlookup)
