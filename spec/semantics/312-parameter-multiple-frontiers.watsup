def $parameter_multiple_facts(S, preceivebirth, n_owner, preceiveorder, pconstantfact :: pconstantfact_tail*) = $parameter_multiple_facts(S, preceivebirth, n_owner, preceiveorder, pconstantfact_tail*)
  -- if pconstantfact.LOOKUP = eps
def $parameter_multiple_facts(S, preceivebirth, n_owner, preceiveorder, pconstantfact*) = false -- otherwise

;; A potential deprecated site may already have been shadowed by an earlier
;; callback. Its own read prefix selects the captured builtin or user payload.
