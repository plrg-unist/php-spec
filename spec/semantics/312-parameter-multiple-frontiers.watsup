def $parameter_multiple_values(S, preceivebirth, n_owner, preceiveorder, eps) = true
def $parameter_multiple_values(S, preceivebirth, n_owner, preceiveorder, porigin_effect :: porigin_tail*) = ($parameter_multiple_effect_value(S, preceivebirth, n_owner, preceiveorder, porigin_effect) /\ $parameter_multiple_values(S, preceivebirth, n_owner, preceiveorder, porigin_tail*))

