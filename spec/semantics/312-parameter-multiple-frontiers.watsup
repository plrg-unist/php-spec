;; Multiple source effects retain separate callback cuts and intermediate reads.
;; This branch is disjoint from quiet295 and single-emitter306.
dec $parameter_multiple_unique(porigin*) : bool
dec $parameter_multiple_order(pstate, preceivebirth, porigin?) : preceiveorder?
dec $parameter_multiple_site(pstate, preceivebirth, porigin) : bool
dec $parameter_multiple_forward(porigin*, porigin?, porigin) : bool
dec $parameter_multiple_registrations(pstate, preceivebirth, nat, preceiveorder, puserconstant*, nat, porigin?) : bool
dec $parameter_multiple_prefix(pstate, preceivebirth, nat, preceiveorder, porigin, puserconstant*, nat, nat) : nat?
dec $parameter_multiple_lookup_prefix(pstate, preceivebirth, nat, preceiveorder, porigin) : nat?
dec $parameter_multiple_facts(pstate, preceivebirth, nat, preceiveorder, pconstantfact*) : bool
dec $parameter_multiple_effect_value(pstate, preceivebirth, nat, preceiveorder, porigin) : bool
dec $parameter_multiple_values(pstate, preceivebirth, nat, preceiveorder, porigin*) : bool

def $parameter_multiple_unique(eps) = true
def $parameter_multiple_unique(porigin :: porigin_tail*) = $parameter_multiple_unique(porigin_tail*)
  -- if ~(porigin <- porigin_tail*)
def $parameter_multiple_unique(porigin*) = false -- otherwise
def $parameter_multiple_order(S, preceivebirth, porigin_scope?) = (preceiveorder)
  -- if $constant_expression_root(S, preceivebirth.ORIGIN) = (porigin_initializer)
  -- if $parameter_receive_order(S, preceivebirth, porigin_initializer, porigin_scope?, eps) = (preceiveorder)
  -- if $(|preceiveorder.EFFECTS| > 1)
  -- if $parameter_multiple_unique(preceiveorder.EFFECTS)
def $parameter_multiple_order(S, preceivebirth, porigin_scope?) = eps -- otherwise
def $parameter_multiple_site(S, preceivebirth, porigin_site) = true
  -- if $parameter_multiple_order(S, preceivebirth, eps) = (preceiveorder)
  -- if porigin_site <- preceiveorder.EFFECTS
def $parameter_multiple_site(S, preceivebirth, porigin_site) = false -- otherwise
def $parameter_multiple_forward(porigin_effects*, eps, porigin_site) = true
def $parameter_multiple_forward(porigin_effects*, (porigin_previous), porigin_site) = (porigin_previous = porigin_site \/ $parameter_receive_before(porigin_effects*, porigin_previous, porigin_site))

;; The same genuine handler/frame/target checks apply at every source frontier.
