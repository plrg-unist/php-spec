  -- if F.CLASSCONTEXT = (ptcontext)
  -- if $ptlc(ptcontext.OWNER) =/= $ptlc(pclassconstantdesc.OWNERNAME)
def $pfclass_constant_visible(F, pclassconstantdesc) = false -- otherwise

def $pfclass_constant(F, pcpath, phpType19, pvalue_class?, phpType20, pvalue_member?, z) = F
  -- if F.MEMORY.COMPLETION =/= NORMAL
dec $pfclass_constant_value(pfstate, pcpath, pvalue, pvalueclass?, int) : pfstate
def $pfclass_constant_value(F, pcpath, pvalue, pvalueclass?, z) = $pfclass_record($pfremember(F, pcpath, (pvalue), z), pcpath, pvalueclass?)
  -- if F.CONSTANT
def $pfclass_constant_value(F, pcpath, pvalue, pvalueclass?, z) = $pfremember(F, pcpath, (pvalue), z)
  -- if ~F.CONSTANT

def $pfclass_constant(F, pcpath, phpType19, pvalue_class?, phpType20, pvalue_member?, z) = $pfclass_constant_value(F, pcpath, pvalue, $pfclass_at(F.CLASSFACTS, pcpath_initializer), z)
