def $pfclass_constant(F, pcpath, phpType19, pvalue_class?, phpType20, pvalue_member?, z) = F[.VALUE = eps] -- otherwise

dec $ppclass_constant_fetch(ppstate, pcpath, phpType19, phpType20, metadata) : ppstate
dec $ppclass_constant_member(ppstate, pcpath, phpType20) : ppstate
def $ppdispatch(P, pcpath, NExprClassConstFetch phpType19 phpType20 metadata, PPR) = $ppclass_constant_fetch(P, pcpath, phpType19, phpType20, metadata)
  -- if ~$pfclassname_member(phpType20)
def $ppclass_constant_fetch(P, pcpath, phpType19, phpType20, metadata) = P_fold
  -- if P_fold = $ppfoldresult(P, $pfprepare($ppclass_fold(P), pcpath, NExprClassConstFetch phpType19 phpType20 metadata, P.ENV, P.LOCATION.LINE))
  -- if P_fold.COMPLETION =/= PPCNORMAL \/ P_fold.FOLD.VALUE =/= eps
def $ppclass_constant_fetch(P, pcpath, phpType19, phpType20, metadata) = $ppclass_constant_member($ppscoped_class(P_fold, pcpath, phpType19), pcpath, phpType20)
  -- if P_fold = $ppfoldresult(P, $pfprepare($ppclass_fold(P), pcpath, NExprClassConstFetch phpType19 phpType20 metadata, P.ENV, P.LOCATION.LINE))
  -- if P_fold.COMPLETION = PPCNORMAL /\ P_fold.FOLD.VALUE = eps
def $ppclass_constant_member(P, pcpath, NIdentifier phpType33 metadata) = $pplocate($ppclearvalue(P), pcpath, $source_line(metadata))
def $ppclass_constant_member(P, pcpath, expression) = $ppclearvalue($ppexpr(P, pcpath ++ [PCFIELD 1], expression, PPR))
