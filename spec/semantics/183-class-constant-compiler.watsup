def $pfclass_constant_owner_below(F, ptbytes_owner, ptbytes_scope, n) = false -- otherwise
def $pfclass_constant_visible(F, pclassconstantdesc) = $pfclass_constant_owner_below(F, pclassconstantdesc.OWNERNAME, ptcontext.OWNER, $pfclass_constant_budget(F))
