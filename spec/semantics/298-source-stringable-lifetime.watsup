  -- if $(|S.DECLARATIONS| > 0)
  -- if S.DECLARATIONS[$nabs($(|S.DECLARATIONS| - 1))] = PDEXIT n_unit PCSCOMPLETE
  -- if $eval_compile_pending_object(S, THROWING n)

def $source_eval_pending_fatal(S, pevalcontext) = true
  -- if $source_eval_pending_marker(pevalcontext)
  -- if $eval_compile_fatal_current(S) = (pevalcompilefatal)
  -- if pevalcompilefatal.CURSOR.PLAN.UNIT = pevalcontext.UNIT

;; A pending source Throwable survives an immediate hard compiler stop. Its
;; genuine fatal renderer is live work, not the retired parser-await task.
def $compile_source_work(S, n_unit, (EVAL_AWAIT n_unit) :: (SOURCE_STRING_PROPAGATE psourceoperand n_text* n) :: ptask_tail*) = S.TODO
  -- if S.COMPLETION = NORMAL
  -- if $eval_context_at(S.EVALCONTEXTS, n_unit) = (pevalcontext)
  -- if pevalcontext.TAIL = (SOURCE_STRING_PROPAGATE psourceoperand n_text* n) :: ptask_tail*
