;; Zend's sole constant RETURN is the implicit file/eval return after code
;; generation emitted no body opcodes. An explicit RETURN still emits a second
;; implicit return and therefore takes the ordinary entered-code route.
dec $source_fast_work(pstate, nat, ppwork*) : bool
dec $source_fast_statement(pstate, nat, pcpath, statement) : bool
dec $source_fast_expression(pstate, nat, pcpath, expression) : bool
dec $source_fast_call(expression) : bool
def $source_fast_call(NExprFuncCall phpType19 phpType6 metadata) = true
def $source_fast_call(expression) = false -- otherwise
dec $source_fast_constant(pvalue) : bool
def $source_fast_constant(PNULL) = true
def $source_fast_constant(PBOOL b) = true
def $source_fast_constant(PINT i) = true
def $source_fast_constant(PFLOAT n) = true
def $source_fast_constant(PSTRING n_text*) = true
def $source_fast_constant(PARRAY n) = true
def $source_fast_constant(pvalue) = false -- otherwise
def $source_fast_unit(S, n) = true
  -- if $source_unit(S.SOURCES, n) = (pcunit)
  -- if P = $declaration_compiler_state($eval_source_ppstate(S, pcunit))
  -- if P.COMPLETION = PPCNORMAL
  -- if $compilation_image_valid(S, pcunit, P)
  -- if (PDEXIT n PCSCOMPLETE) <- S.DECLARATIONS
  -- if $source_fast_work(S, n, P.WORK)
def $source_fast_work(S, n, eps) = true
def $source_fast_work(S, n, (PPCWORK pcpath statement plenv n_line) :: ppwork*) = ($source_fast_statement(S, n, pcpath, statement) /\ $source_fast_work(S, n, ppwork*))
def $source_fast_statement(S, n, pcpath, NStmtNop metadata) = true
def $source_fast_statement(S, n, pcpath, NStmtFunction phpType14 phpType4 phpType11 phpType16 phpType18 phpType23 metadata) = true
  -- if $function_at(S.FUNCTIONS, PORIGIN n pcpath) = (pfunction)
  -- if pfunction.EARLY
def $source_fast_statement(S, n, pcpath, NStmtExpression expression metadata) = $source_fast_expression(S, n, pcpath ++ [PCFIELD 0], expression)
def $source_fast_statement(S, n, pcpath, statement) = false -- otherwise
def $source_fast_expression(S, n, pcpath, expression) = true
  -- if ~$source_fast_call(expression)
  -- if $compiled_read(S, PORIGIN n pcpath) = (pvalue)
  -- if $compiled_effects(S, PORIGIN n pcpath) = eps
  -- if $source_fast_constant(pvalue)
def $source_fast_expression(S, n, pcpath, NExprFuncCall name (SEQUENCE phpType7*) metadata) = true
  -- if $ppbuiltin_arguments(phpType7*) = ([expression])
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_name(pcode.NAMES, pcpath) = ((ptbytes, eps))
  -- if $ptlc(ptbytes) = $ptascii("strlen")
  -- if $compiled_read(S, PORIGIN n (pcpath ++ [PCFIELD 1, PCINDEX 0, PCFIELD 1])) = (PSTRING ptbytes_arg)
  -- if $compiled_effects(S, PORIGIN n (pcpath ++ [PCFIELD 1, PCINDEX 0, PCFIELD 1])) = eps
def $source_fast_expression(S, n, pcpath, expression) = false -- otherwise

dec $source_fast_end(psourceoperand, nat) : ptask
dec $source_fast_value(psourceoperand) : pvalue
def $source_fast_end(psourceoperand, n) = EVAL_END n -- if psourceoperand.KIND = 0
def $source_fast_end(psourceoperand, n) = FILE_END n -- if psourceoperand.KIND =/= 0
def $source_fast_value(psourceoperand) = PNULL -- if psourceoperand.KIND = 0
def $source_fast_value(psourceoperand) = PINT 1 -- if psourceoperand.KIND =/= 0
def $source_operand_work(S, n, ptask_work*, (SOURCE_OPERAND_RELEASE psourceoperand) :: ptask_tail*) = [SOURCE_OPERAND_FAST psourceoperand n, $source_fast_end(psourceoperand, n)] ++ ptask_tail*
  -- if $source_fast_unit(S, n)

dec $source_fast_context(pstate, psourceoperand, nat) : bool
dec $source_fast_binding(pstate, psourceoperand, nat) : bool
def $source_fast_binding(S, psourceoperand, n) = true
  -- if psourceoperand.KIND = 0
  -- if $eval_binding_at(S.EVALBINDINGS, n) = (pevalbinding)
  -- if pevalbinding.SITE = psourceoperand.SITE
def $source_fast_binding(S, psourceoperand, n) = true
  -- if psourceoperand.KIND =/= 0
  -- if $file_binding_at(S.FILEBINDINGS, n) = (pfilebinding)
  -- if pfilebinding.SITE = psourceoperand.SITE
  -- if pfilebinding.KIND = psourceoperand.KIND
def $source_fast_binding(S, psourceoperand, n) = false -- otherwise
def $source_fast_context(S, psourceoperand, n) = true
  -- if $source_operand_site(S, psourceoperand)
  -- if psourceoperand.OWNER = |S.FRAMES|
  -- if $source_fast_unit(S, n)
  -- if $source_fast_binding(S, psourceoperand, n)
  -- if psourceoperand.KIND = 0
  -- if $eval_context_at(S.EVALCONTEXTS, n) = (pevalcontext)
  -- if pevalcontext.PHASE = UNIT_RUN
  -- if pevalcontext.SITE = psourceoperand.SITE
  -- if pevalcontext.OWNER = psourceoperand.OWNER
  -- if pevalcontext.TAIL = psourceoperand.TAIL
def $source_fast_context(S, psourceoperand, n) = true
  -- if $source_operand_site(S, psourceoperand)
  -- if psourceoperand.OWNER = |S.FRAMES|
  -- if $source_fast_unit(S, n)
  -- if $source_fast_binding(S, psourceoperand, n)
  -- if psourceoperand.KIND =/= 0
  -- if $source_operand_file_context(S.FILECONTEXTS, n) = (pfilecontext)
  -- if pfilecontext.PHASE = FILE_UNIT_RUN
  -- if pfilecontext.SITE = psourceoperand.SITE
  -- if pfilecontext.OWNER = psourceoperand.OWNER
  -- if pfilecontext.KIND = psourceoperand.KIND
  -- if pfilecontext.TAIL = psourceoperand.TAIL
def $source_fast_context(S, psourceoperand, n) = false -- otherwise
def $task_nodes(SOURCE_OPERAND_FAST psourceoperand n) = $operand_nodes(psourceoperand.INPUT)
def $task_nodes(SOURCE_FAST_FINISH psourceoperand n) = eps
def $call_task_valid(S, SOURCE_OPERAND_FAST psourceoperand n) = ($source_operand_valid(S, psourceoperand) /\ $source_fast_context(S, psourceoperand, n) /\ $source_operand_suffix(S.TODO, SOURCE_OPERAND_FAST psourceoperand n, $source_fast_end(psourceoperand, n) :: psourceoperand.TAIL))
def $call_task_valid(S, SOURCE_FAST_FINISH psourceoperand n) = ($source_fast_context(S, psourceoperand, n) /\ $source_operand_suffix(S.TODO, SOURCE_FAST_FINISH psourceoperand n, $source_fast_end(psourceoperand, n) :: psourceoperand.TAIL) /\ S.RESULT = KNOWN $source_fast_value(psourceoperand))
rule PhpStep/source-fast-release: S ~> S[.TODO = (SOURCE_FAST_FINISH psourceoperand n) :: ptask_tail*][.RESULT = KNOWN $source_fast_value(psourceoperand)][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (SOURCE_OPERAND_FAST psourceoperand n) :: ptask_tail*
  -- if $call_task_valid(S, SOURCE_OPERAND_FAST psourceoperand n)
rule PhpStep/source-fast-finish: S ~> S[.TODO = ptask_tail*]
  -- if S.TODO = (SOURCE_FAST_FINISH psourceoperand n) :: ptask_tail*
  -- if $call_task_valid(S, SOURCE_FAST_FINISH psourceoperand n)

;; FREE_OP1 runs after the constant result has been copied. Preserve the actual
;; eager operation and its value transfer; the source input is now documentary
;; and must not retain the retired captured object through later opcodes.
def $destructor_pending_finish(S, pdestructionoperation, n_pending, (SOURCE_FAST_FINISH psourceoperand n_unit) :: ptask_tail*) = S[.SOURCEPENDING = ({OPERAND psourceoperand, UNIT n_unit, HELPER eps, EXCEPTION n_pending, CALLER pdestructionoperation.CALLER})][.TODO = (SOURCE_FAST_FINISH psourceoperand n_unit) :: ptask_tail*][.RESULT = pdestructionoperation.VALUE][.BASE = pdestructionoperation.BASE][.CELL = pdestructionoperation.CELL][.KEY = pdestructionoperation.KEY][.LOCATION = pdestructionoperation.LOCATION][.COMPLETION = NORMAL]
  -- if pdestructionoperation.SOURCE = SOURCE_OPERAND_FAST psourceoperand n_unit
  -- if pdestructionoperation.VALUE = KNOWN $source_fast_value(psourceoperand)
  -- if pdestructionoperation.ORIGIN = (psourceoperand.SITE)
  -- if S.CURRENT = pdestructionoperation.CALLER
  -- if S.SOURCEPENDING = eps
  -- if ptask_tail* = $source_fast_end(psourceoperand, n_unit) :: psourceoperand.TAIL
  -- if $source_fast_context(S, psourceoperand, n_unit)
  -- if $eval_compile_pending_object(S, THROWING n_pending)

dec $source_pending_record_valid(pstate, psourcepending) : bool
def $source_pending_record_valid(S, psourcepending) = true
  -- if psourcepending.HELPER = eps
  -- if psourceoperand = psourcepending.OPERAND
  -- if S_owner = $source_string_owner_scope(S, psourceoperand.OWNER)
  -- if psourceoperand.OWNER = |S_owner.FRAMES|
  -- if S_owner.CURRENT = psourcepending.CALLER
  -- if $source_operand_site(S_owner, psourceoperand)
  -- if $source_fast_unit(S_owner, psourcepending.UNIT)
  -- if $source_fast_binding(S_owner, psourceoperand, psourcepending.UNIT)
  -- if $eval_compile_pending_object(S, THROWING psourcepending.EXCEPTION)
def $source_pending_record_valid(S, psourcepending) = false -- otherwise
def $source_pending_state_valid(S) = $source_pending_record_valid(S, psourcepending)
  -- if S.SOURCEPENDING = (psourcepending)

;; A latent EG(exception) suppresses eligible user error handlers while the
;; internal function still runs. Ineligible diagnostics use the normal default.
def $report_event(S, pevent, i) = S[.ERRORFATALTRACE = eps]
  -- if S.SOURCEPENDING =/= eps
  -- if ~$eval_compile_recorded_error(S, i)
  -- if $error_handler_eligible(S, i)
def $error_dispatch(S, i, n_message*, z, pevent, ptask_resume) = S[.TODO = ptask_resume :: ptask_tail*]
  -- if S.SOURCEPENDING =/= eps
  -- if ~$eval_compile_recorded_error(S, i)
  -- if $error_handler_eligible(S, i)
  -- if S.TODO = ptask :: ptask_tail*

;; ZPP argument type/value diagnostics return without allocating when an
;; exception is already pending. Parameter-count errors follow another engine
;; route and retain ordinary allocation/chaining at the transition boundary.
def $pending_error_api_argument(S, pconfigcall, text) = true
  -- if S.SOURCEPENDING =/= eps
  -- if $error_api_kind(pconfigcall.KIND)
  -- if text = "TypeError" \/ text = "ValueError"
def $config_error(S, pconfigcall, text, preqbytes) = S[.COMPLETION = THROWING psourcepending.EXCEPTION]
  -- if S.SOURCEPENDING = (psourcepending)
  -- if $pending_error_api_argument(S, pconfigcall, text)
def $error_api_error(S, pconfigcall, text, preqbytes) = S[.COMPLETION = THROWING psourcepending.EXCEPTION]
  -- if S.SOURCEPENDING = (psourcepending)
  -- if $pending_error_api_argument(S, pconfigcall, text)

;; DO_ICALL checks after the C helper has finished. Assignment and echo are
;; separate operations and retain the copied result before this checkpoint.
dec $source_pending_checkpoint(pstate, pstate) : bool
def $source_pending_checkpoint(S, S_next) = true
  -- if S.TODO = (CONFIG_INVOKE pconfigcall) :: ptask_tail*
  -- if S_next.TODO = ptask_tail*
  -- if S_next.FRAMES = S.FRAMES
  -- if S_next.CURRENT = S.CURRENT
def $source_pending_checkpoint(S, S_next) = true
  -- if S.TODO = (ERROR_TRIGGER_PHASE pconfigcall 2) :: ptask_tail*
  -- if S_next.TODO = ptask_tail*
def $source_pending_checkpoint(S, S_next) = true
  -- if S.TODO = (REPORTING_LONG_RESULT pconfigcall i) :: ptask_tail*
  -- if S_next.TODO = ptask_tail*
def $source_pending_checkpoint(S, S_next) = false -- otherwise
def $source_exception_transition(S, S_next) = $throwable_previous(S_next[.SOURCEPENDING = eps], n_new, psourcepending.EXCEPTION)
  -- if S.SOURCEPENDING = (psourcepending)
  -- if S_next.COMPLETION = THROWING n_new
def $source_exception_transition(S, S_next) = S_next[.SOURCEPENDING = eps][.COMPLETION = THROWING psourcepending.EXCEPTION][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.SOURCEPENDING = (psourcepending)
  -- if S_next.COMPLETION = NORMAL
  -- if $source_pending_checkpoint(S, S_next)
def $source_exception_terminal(S) = S[.SOURCEPENDING = eps][.COMPLETION = THROWING psourcepending.EXCEPTION]
  -- if S.SOURCEPENDING = (psourcepending)

;; Empty eval, once skips and failed includes return without an op array. Their
;; actual helper completion copies the bool before the same final FREE_OP1.
;; The saved file context is documentary after completion, not an input owner.
dec $source_helper_value(psourcehelper) : pvalue
def $source_helper_value(HELPER_EMPTY_EVAL) = PBOOL false
def $source_helper_value(HELPER_ONCE_SKIP pfilecontext n_path*) = PBOOL true
def $source_helper_value(HELPER_FAILED_INCLUDE pfilecontext) = PBOOL false

dec $source_helper_file_context(pstate, psourceoperand, pfilecontext) : bool
def $source_helper_file_context(S, psourceoperand, pfilecontext) = ($(pfilecontext.NONCE < S.FILESEQ) /\ pfilecontext.SITE = psourceoperand.SITE /\ pfilecontext.KIND = psourceoperand.KIND /\ pfilecontext.OWNER = psourceoperand.OWNER /\ pfilecontext.CALLER = $call_sourcefile(S.FILES, psourceoperand.SITE) /\ pfilecontext.LEXICAL_CLASS = $eval_class_origin(S) /\ pfilecontext.TAIL = (SOURCE_OPERAND_RELEASE psourceoperand) :: psourceoperand.TAIL /\ pfilecontext.UNIT = eps /\ pfilecontext.RESOLVED = eps /\ pfilecontext.OPENED = eps /\ pfilecontext.BYTES = eps /\ $startup_bytes(pfilecontext.REQUESTED) /\ $startup_bytes(pfilecontext.CWD) /\ $startup_bytes(pfilecontext.INCLUDEPATH))

dec $source_helper_context(pstate, psourceoperand, psourcehelper) : bool
def $source_helper_context(S, psourceoperand, HELPER_EMPTY_EVAL) = (psourceoperand.KIND = 0 /\ $source_operand_site(S, psourceoperand) /\ psourceoperand.OWNER = |S.FRAMES|)
def $source_helper_context(S, psourceoperand, HELPER_ONCE_SKIP pfilecontext n_path*) = ($source_operand_site(S, psourceoperand) /\ psourceoperand.OWNER = |S.FRAMES| /\ $source_helper_file_context(S, psourceoperand, pfilecontext) /\ $file_once_kind(psourceoperand.KIND) /\ pfilecontext.PHASE = FILE_RESOLVE_WAIT /\ $source_filename(n_path*) /\ n_path* <- S.INCLUDEDOPENED)
def $source_helper_context(S, psourceoperand, HELPER_FAILED_INCLUDE pfilecontext) = ($source_operand_site(S, psourceoperand) /\ psourceoperand.OWNER = |S.FRAMES| /\ $source_helper_file_context(S, psourceoperand, pfilecontext) /\ $file_warning_marker(pfilecontext.PHASE, 3) /\ $file_warning_payload_valid(pfilecontext))

dec $source_helper_complete(pstate, psourceoperand, psourcehelper, ptask*) : pstate
def $source_helper_complete(S, psourceoperand, psourcehelper, ptask_tail*) = S[.TODO = (SOURCE_HELPER_RELEASE psourceoperand psourcehelper) :: ptask_tail*][.ORIGIN = (psourceoperand.SITE)]
  -- if $source_operand_valid(S, psourceoperand)
  -- if psourceoperand.TAIL = ptask_tail*
  -- if $source_helper_context(S, psourceoperand, psourcehelper)
  -- if S.COMPLETION = NORMAL
  -- if S.RESULT = KNOWN $source_helper_value(psourcehelper)
def $source_helper_complete(S, psourceoperand, psourcehelper, ptask_tail*) = S[.COMPLETION = UNSUPPORTED "invalid completed source helper"] -- otherwise
def $source_helper_result(S, psourcehelper, (SOURCE_OPERAND_RELEASE psourceoperand) :: ptask_tail*) = $source_helper_complete(S, psourceoperand, psourcehelper, ptask_tail*)

def $task_nodes(SOURCE_HELPER_RELEASE psourceoperand psourcehelper) = $operand_nodes(psourceoperand.INPUT)
def $task_nodes(SOURCE_HELPER_FINISH psourceoperand psourcehelper) = eps
def $call_task_valid(S, SOURCE_HELPER_RELEASE psourceoperand psourcehelper) = ($source_operand_valid(S, psourceoperand) /\ $source_helper_context(S, psourceoperand, psourcehelper) /\ S.ORIGIN = (psourceoperand.SITE) /\ $source_operand_suffix(S.TODO, SOURCE_HELPER_RELEASE psourceoperand psourcehelper, psourceoperand.TAIL) /\ S.RESULT = KNOWN $source_helper_value(psourcehelper))
def $call_task_valid(S, SOURCE_HELPER_FINISH psourceoperand psourcehelper) = ($source_helper_context(S, psourceoperand, psourcehelper) /\ S.ORIGIN = (psourceoperand.SITE) /\ $source_operand_suffix(S.TODO, SOURCE_HELPER_FINISH psourceoperand psourcehelper, psourceoperand.TAIL) /\ S.RESULT = KNOWN $source_helper_value(psourcehelper))
rule PhpStep/source-helper-release: S ~> S[.TODO = (SOURCE_HELPER_FINISH psourceoperand psourcehelper) :: ptask_tail*]
  -- if S.TODO = (SOURCE_HELPER_RELEASE psourceoperand psourcehelper) :: ptask_tail*
  -- if $call_task_valid(S, SOURCE_HELPER_RELEASE psourceoperand psourcehelper)
rule PhpStep/source-helper-finish: S ~> S[.TODO = ptask_tail*]
  -- if S.TODO = (SOURCE_HELPER_FINISH psourceoperand psourcehelper) :: ptask_tail*
  -- if $call_task_valid(S, SOURCE_HELPER_FINISH psourceoperand psourcehelper)

def $destructor_pending_finish(S, pdestructionoperation, n_pending, (SOURCE_HELPER_FINISH psourceoperand psourcehelper) :: ptask_tail*) = S[.SOURCEPENDING = ({OPERAND psourceoperand, UNIT 0, HELPER (psourcehelper), EXCEPTION n_pending, CALLER pdestructionoperation.CALLER})][.TODO = (SOURCE_HELPER_FINISH psourceoperand psourcehelper) :: ptask_tail*][.RESULT = pdestructionoperation.VALUE][.BASE = pdestructionoperation.BASE][.CELL = pdestructionoperation.CELL][.KEY = pdestructionoperation.KEY][.LOCATION = pdestructionoperation.LOCATION][.COMPLETION = NORMAL]
  -- if pdestructionoperation.SOURCE = SOURCE_HELPER_RELEASE psourceoperand psourcehelper
  -- if pdestructionoperation.VALUE = KNOWN $source_helper_value(psourcehelper)
  -- if pdestructionoperation.ORIGIN = (psourceoperand.SITE)
  -- if S.CURRENT = pdestructionoperation.CALLER
  -- if S.SOURCEPENDING = eps
  -- if ptask_tail* = psourceoperand.TAIL
  -- if $source_helper_context(S, psourceoperand, psourcehelper)
  -- if $eval_compile_pending_object(S, THROWING n_pending)

dec $source_helper_pending_valid(pstate, psourcepending, psourcehelper) : bool
def $source_helper_pending_valid(S, psourcepending, psourcehelper) = (psourcepending.UNIT = 0 /\ psourceoperand.OWNER = |S_owner.FRAMES| /\ S_owner.CURRENT = psourcepending.CALLER /\ $source_helper_context(S_owner, psourceoperand, psourcehelper) /\ $eval_compile_pending_object(S, THROWING psourcepending.EXCEPTION))
  -- if psourceoperand = psourcepending.OPERAND
  -- if S_owner = $source_string_owner_scope(S, psourceoperand.OWNER)
def $source_pending_record_valid(S, psourcepending) = $source_helper_pending_valid(S, psourcepending, psourcehelper)
  -- if psourcepending.HELPER = (psourcehelper)

;; Ordinary nested code installs its first opcode before FREE_OP1. Skip only
;; forms already proved to emit no runtime work; a compiled constant RETURN
;; authenticates its operand occurrence and opcode line. Wider emission forms
;; retain their existing entry until their compiler behavior is represented.
dec $source_first_return_origin(pstate, nat, ppwork*) : porigin?
def $source_first_return_origin(S, n, eps) = eps
def $source_first_return_origin(S, n, (PPCWORK pcpath statement plenv n_line) :: ppwork*) = $source_first_return_origin(S, n, ppwork*)
  -- if $source_fast_statement(S, n, pcpath, statement)
def $source_first_return_origin(S, n, (PPCWORK pcpath (NStmtReturn expression metadata) plenv n_line) :: ppwork*) = (porigin)
  -- if ~$source_fast_statement(S, n, pcpath, NStmtReturn expression metadata)
  -- if porigin = PORIGIN n (pcpath ++ [PCFIELD 0])
  -- if $compiled_read(S, porigin) = (pvalue)
  -- if $compiled_effects(S, porigin) = eps
  -- if $source_fast_constant(pvalue)
def $source_first_return_origin(S, n, ppwork*) = eps -- otherwise
def $source_operand_entry_origin(S, psourceoperand, n) = (porigin)
  -- if $source_operand_enter_valid(S, psourceoperand, n)
  -- if $source_unit(S.SOURCES, n) = (pcunit)
  -- if P = $declaration_compiler_state($eval_source_ppstate(S, pcunit))
  -- if P.COMPLETION = PPCNORMAL
  -- if $compilation_image_valid(S, pcunit, P)
  -- if (PDEXIT n PCSCOMPLETE) <- S.DECLARATIONS
  -- if $source_first_return_origin(S, n, P.WORK) = (porigin)

;; A fast file helper has not entered a nested code frame. Reuse its single
;; live wrapper, but omit the filename argument while the actual operand
;; destructor is active. The saved caller certifies the completed release.
def $source_operand_fast_trace(S, pfilecontext) = true
  -- if pfilecontext.UNIT = (n_unit)
  -- if S_scope = $source_string_owner_scope(S, pfilecontext.OWNER)
  -- if S_scope.TODO = (DESTRUCTOR_RESULT pdestructorcall) :: ptask_rest*
  -- if pdestructorcall.OPERATION = (pdestructionoperation)
  -- if pdestructionoperation.SOURCE = SOURCE_OPERAND_FAST psourceoperand n_unit
  -- if psourceoperand.OWNER = pfilecontext.OWNER
  -- if pdestructionoperation.ORIGIN = (psourceoperand.SITE)
  -- if pdestructionoperation.CALLER = S_scope.CURRENT
  -- if pdestructionoperation.VALUE = KNOWN $source_fast_value(psourceoperand)
  -- if $source_operand_file_context(S.FILECONTEXTS, n_unit) = (pfilecontext)
  -- if $source_fast_context(S_scope, psourceoperand, n_unit)
  -- if $source_operand_suffix(S_scope.TODO, SOURCE_FAST_FINISH psourceoperand n_unit, $source_fast_end(psourceoperand, n_unit) :: psourceoperand.TAIL)
  -- if $destructor_call_live(S, pdestructorcall)
  -- if $eager_operation_source_valid(S, pdestructionoperation)
def $file_trace_frame_before(S, pfilecontext, preqbytes?) = $file_trace_frame(S, pfilecontext)[.ARGS = eps][.HASARGS = false]
  -- if ~$iterator_notice_file_flushing(S, pfilecontext)
  -- if $source_operand_fast_trace(S, pfilecontext)

;; NULL/fake helpers retire their provider context before the common FREE_OP1.
;; Their real completed eager operation still supplies the keyword wrapper.
def $eval_trace_preparser(S, (pcallcontext), pframe) = [{FILE $call_sourcefile(S.FILES, psourceoperand.SITE), LINE psourceoperand.LINE, FUNCTION $source_operand_keyword(psourceoperand.KIND), CLASS eps, TYPE eps, ARGS eps, HASARGS false}]
  -- if pframe.TODO = (DESTRUCTOR_RESULT pdestructorcall) :: ptask_rest*
  -- if pdestructorcall.OPERATION = (pdestructionoperation)
  -- if pdestructionoperation.SOURCE = SOURCE_HELPER_RELEASE psourceoperand psourcehelper
  -- if pdestructionoperation.VALUE = KNOWN $source_helper_value(psourcehelper)
  -- if pdestructionoperation.ORIGIN = (psourceoperand.SITE)
  -- if S_scope = $source_string_owner_scope(S, psourceoperand.OWNER)
  -- if S_scope.TODO = pframe.TODO
  -- if S_scope.ORIGIN = pframe.ORIGIN
  -- if S_scope.CURRENT = pframe.CONTEXT
  -- if pframe.CONTEXT = pdestructionoperation.CALLER
  -- if $source_helper_context(S_scope, psourceoperand, psourcehelper)
  -- if $source_operand_suffix(S_scope.TODO, SOURCE_HELPER_FINISH psourceoperand psourcehelper, psourceoperand.TAIL)
  -- if $destructor_context_valid(S, pcallcontext)
  -- if $destructor_context_call(pcallcontext, S.CURRENT, S.FRAMES) = (pdestructorcall)
  -- if pcallcontext.CALLSITE = pdestructorcall.SITE
  -- if pcallcontext.LINE = $destructor_line(pdestructorcall)
  -- if $eager_operation_source_valid(S, pdestructionoperation)

;; A saved caller validates future tasks after the genuine operation exit.
;; Restore only its authenticated copied source result in that borrowed view;
;; the live destructor RESULT, operation queue and heap keep their real state.
def $eager_operation_validation_value(S, pdestructionoperation) = pdestructionoperation.VALUE
  -- if pdestructionoperation.SOURCE = SOURCE_OPERAND_FAST psourceoperand n
  -- if pdestructionoperation.VALUE = KNOWN $source_fast_value(psourceoperand)
  -- if pdestructionoperation.ORIGIN = (psourceoperand.SITE)
  -- if $destructor_operation_valid(S, pdestructionoperation)
  -- if $source_fast_context(S, psourceoperand, n)
  -- if $source_operand_suffix(S.TODO, DESTRUCTOR_OPERATION_EXIT pdestructionoperation, (SOURCE_FAST_FINISH psourceoperand n) :: $source_fast_end(psourceoperand, n) :: psourceoperand.TAIL)
def $eager_operation_validation_value(S, pdestructionoperation) = pdestructionoperation.VALUE
  -- if pdestructionoperation.SOURCE = SOURCE_HELPER_RELEASE psourceoperand psourcehelper
  -- if pdestructionoperation.VALUE = KNOWN $source_helper_value(psourcehelper)
  -- if pdestructionoperation.ORIGIN = (psourceoperand.SITE)
  -- if $destructor_operation_valid(S, pdestructionoperation)
  -- if $source_helper_context(S, psourceoperand, psourcehelper)
  -- if $source_operand_suffix(S.TODO, DESTRUCTOR_OPERATION_EXIT pdestructionoperation, (SOURCE_HELPER_FINISH psourceoperand psourcehelper) :: psourceoperand.TAIL)

;; Authenticate source release snapshots before considering the live RESULT.
;; A matching live scalar cannot certify a different captured result or tail.
dec $source_release_operation_valid(pstate, pdestructionoperation) : bool
def $source_release_operation_valid(S, pdestructionoperation) = true
  -- if pdestructionoperation.SOURCE = SOURCE_OPERAND_FAST psourceoperand n
  -- if pdestructionoperation.VALUE = KNOWN $source_fast_value(psourceoperand)
  -- if pdestructionoperation.COMPLETION = NORMAL
  -- if S_owner = $source_string_owner_scope(S, psourceoperand.OWNER)
  -- if pdestructionoperation.CALLER = S_owner.CURRENT
  -- if pdestructionoperation.ORIGIN = (psourceoperand.SITE) /\ S_owner.ORIGIN = pdestructionoperation.ORIGIN /\ S_owner.CONSTCONTEXT = pdestructionoperation.CONSTCONTEXT
  -- if $source_fast_context(S_owner, psourceoperand, n)
  -- if $source_operand_suffix(S_owner.TODO, DESTRUCTOR_OPERATION_EXIT pdestructionoperation, (SOURCE_FAST_FINISH psourceoperand n) :: $source_fast_end(psourceoperand, n) :: psourceoperand.TAIL)
def $source_release_operation_valid(S, pdestructionoperation) = true
  -- if pdestructionoperation.SOURCE = SOURCE_HELPER_RELEASE psourceoperand psourcehelper
  -- if pdestructionoperation.VALUE = KNOWN $source_helper_value(psourcehelper)
  -- if pdestructionoperation.COMPLETION = NORMAL
  -- if S_owner = $source_string_owner_scope(S, psourceoperand.OWNER)
  -- if pdestructionoperation.CALLER = S_owner.CURRENT
  -- if pdestructionoperation.ORIGIN = (psourceoperand.SITE) /\ S_owner.ORIGIN = pdestructionoperation.ORIGIN /\ S_owner.CONSTCONTEXT = pdestructionoperation.CONSTCONTEXT
  -- if $source_helper_context(S_owner, psourceoperand, psourcehelper)
  -- if $source_operand_suffix(S_owner.TODO, DESTRUCTOR_OPERATION_EXIT pdestructionoperation, (SOURCE_HELPER_FINISH psourceoperand psourcehelper) :: psourceoperand.TAIL)
def $source_release_operation_valid(S, pdestructionoperation) = false -- otherwise
def $eager_operation_source_guard(S, pdestructionoperation) = $source_release_operation_valid(S, pdestructionoperation)
  -- if pdestructionoperation.SOURCE = SOURCE_OPERAND_FAST psourceoperand n
def $eager_operation_source_guard(S, pdestructionoperation) = $source_release_operation_valid(S, pdestructionoperation)
  -- if pdestructionoperation.SOURCE = SOURCE_HELPER_RELEASE psourceoperand psourcehelper
