  -- if $eval_compile_fatal_valid(S, pevalcompilefatal)
def $eval_compile_result(S_compiled, pevalcontext, pevalcontext_tail*, P) = S_compiled[.SERVICELEFT = eps]
  -- if pevalcontext.TAIL = (SOURCE_STRING_PROPAGATE psourceoperand n_text* n) :: ptask_tail*
  -- if S_compiled.COMPLETION = NORMAL
  -- if $source_eval_pending_context(S_compiled, pevalcontext)
  -- if $eval_compile_fatal_current(S_compiled) = (pevalcompilefatal)
  -- if pevalcompilefatal.CURSOR.PLAN.UNIT = pevalcontext.UNIT
  -- if pevalcompilefatal.CURSOR.PENDING = THROWING n
  -- if $eval_compile_fatal_valid(S_compiled, pevalcompilefatal)

;; The temporary cast receiver is released before a parser context exists.
;; Its real destructor frame still has the surrounding zero-argument keyword.
dec $source_string_ready_kind(ptask) : bool
def $source_string_ready_kind(SOURCE_STRING_READY psourceoperand n n_text*) = true
def $source_string_ready_kind(ptask) = false -- otherwise
dec $source_string_ready_record(ptask*) : (psourceoperand, nat, preqbytes)?
def $source_string_ready_record((SOURCE_STRING_READY psourceoperand n n_text*) :: ptask_tail*) = ((psourceoperand, n, n_text*))
def $source_string_ready_record(ptask :: ptask_tail*) = $source_string_ready_record(ptask_tail*)
  -- if ~$source_string_ready_kind(ptask)
def $source_string_ready_record(eps) = eps

def $eval_trace_preparser(S, (pcallcontext), pframe) = [{FILE $call_sourcefile(S.FILES, psourceoperand.SITE), LINE psourceoperand.LINE, FUNCTION $source_operand_keyword(psourceoperand.KIND), CLASS eps, TYPE eps, ARGS eps, HASARGS false}]
  -- if pframe.TODO = (DESTRUCTOR_RESULT pdestructorcall) :: ptask_rest*
  -- if pdestructorcall.OPERATION = (pdestructionoperation)
  -- if $source_string_ready_record(ptask_rest*) = ((psourceoperand, n_receiver, n_text*))
