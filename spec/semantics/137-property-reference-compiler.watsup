;; Reference fetches share authored receiver/name order with value fetches.
;; $ppexpr records the mode in transient P.ACCESS; runtime derives reference
;; demand from checked source and selected context, not from CODEEXPR.
dec $ppproperty_receiver(ppstate, pcpath, expression, ppmode) : ppstate
dec $ppproperty_constant_name(ppstate, pcpath) : ppstate
def $ppdispatch(P, pcpath, NExprPropertyFetch expression (NIdentifier (BYTES text) metadata_name) metadata, ppmode) = $pplocate($ppclearvalue($ppproperty_receiver(P, pcpath ++ [PCFIELD 0], expression, ppmode)), pcpath, $source_line(metadata_name))
def $ppdispatch(P, pcpath, NExprPropertyFetch expression_base expression_name metadata, ppmode) = $ppclearvalue($ppproperty_constant_name($ppexpr($ppproperty_receiver(P, pcpath ++ [PCFIELD 0], expression_base, ppmode), pcpath ++ [PCFIELD 1], expression_name, PPR), pcpath ++ [PCFIELD 1]))
