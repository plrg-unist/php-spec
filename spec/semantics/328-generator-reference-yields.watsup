def $generator_borrowed_task(S, n, GENERATOR_YIELD_STORE porigin poperand?) = (S.ORIGIN = (porigin) /\ $generator_yield_site(S, porigin) /\ $generator_yield_read_key_source(S, porigin, poperand?))
def $generator_borrowed_task(S, n, GENERATOR_YIELD_KEY n porigin z) = ($generator_yield_key_read_valid(S, n, porigin, z) /\ $generator_yield_key_input_valid(S, n, porigin))
def $generator_borrowed_task(S, n, GENERATOR_YIELD_REF_NOTICE n porigin poperand? pvalue z) = $generator_reference_notice_valid(S, n, porigin, poperand?, pvalue, z)
def $generator_borrowed_task(S, n, ERROR_READ_RESULT perrorread) = $generator_borrowed_task(S[.RESULT = perrorread.RESULT][.BASE = perrorread.BASE], n, perrorread.TASK)
  -- if $error_read_valid(S, perrorread)
def $generator_borrowed_task(S, n, ERROR_HANDLER_INVOKE perrorcall) = $generator_borrowed_task(S[.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], n, perrorcall.RESUME)
  -- if $error_call_valid(S, perrorcall)
def $generator_borrowed_task(S, n, ERROR_HANDLER_RESULT perrorcall) = $generator_borrowed_task(S[.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], n, perrorcall.RESUME)
  -- if $error_call_valid(S, perrorcall)
def $generator_borrowed_task(S, n, ERROR_HANDLER_CLEAN perrorcall) = $generator_borrowed_task(S[.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], n, perrorcall.RESUME)
  -- if $error_cleanup_valid(S, perrorcall)
def $generator_borrowed_task(S, n, ptask) = false -- otherwise
def $generator_borrowed_tasks(S, n, ptask_head :: ptask_tail*) = true
