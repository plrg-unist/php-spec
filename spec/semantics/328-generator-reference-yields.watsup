def $generator_borrowed_frames(S, n, eps) = false
def $generator_borrowed_frames(S, n, pframe :: pframe_tail*) = ($generator_borrowed_scope($constant_frame_scope(S, pframe, pframe_tail*), n) \/ $generator_borrowed_frames(S, n, pframe_tail*))
