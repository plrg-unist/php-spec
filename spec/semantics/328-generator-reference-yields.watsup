def $generator_borrowed_node_valid(S, n) = true -- if ~$generator_object(S, n)
def $generator_borrowed_node_valid(S, n) = false -- otherwise
def $generator_borrowed_operand_live(S, REFERENCE n) = $call_reference_operand_valid(S, REFERENCE n)
def $generator_borrowed_operand_live(S, KNOWN pvalue) = $heap_subset($value_nodes(pvalue), S.ALLOCATIONS)
def $generator_borrowed_operand_live(S, poperand) = false -- otherwise
def $generator_borrowed_readable(S, n, false) = $generator_borrowed_operand_live(S, poperand)
