  -- if ~$generator_from_cache(S, pgenerator.DELEGATE)
  -- if pgenerator.VALUE = eps /\ pgenerator.REFCELL = eps
  -- if $generator_borrowed_value(pgenerator) = (poperand)
def $generator_from_key(S, n, n_depth) = $generator_cache_value(pgeneratorborrowed.KEY)
  -- if $(n_depth > 0)
  -- if S.OBJECTS[n] = GENERATOR pgenerator
  -- if ~$generator_from_generator(S, $generator_from_input_of(pgenerator.DELEGATE))
