;; zend_object_handlers.c:zend_get_property_offset and zend_check_property_access.
;; Lookup uses raw names; storage/casts/captured locations use canonical keys.
;; The protected compatibility class is the original nonprivate prototype.
dec $property_declaring_class(pclassdesc*, ppropertyid) : porigin?
def $property_declaring_class(pclassdesc*, INTERNAL_PROPERTY text ptbytes) = eps
def $property_declaring_class(eps, porigin) = eps
def $property_declaring_class(pclassdesc :: pclassdesc_tail*, porigin) = (pclassdesc.ORIGIN)
  -- if $property_declared_at(pclassdesc.PROPERTIES, porigin)
def $property_declaring_class(pclassdesc :: pclassdesc_tail*, porigin) = $property_declaring_class(pclassdesc_tail*, porigin)
  -- if ~$property_declared_at(pclassdesc.PROPERTIES, porigin)

dec $property_prototype(pstate, porigin, ptbytes, nat) : porigin
def $property_prototype(S, porigin, ptbytes, n) = $property_prototype(S, porigin_parent, ptbytes, $nabs($(n - 1)))
  -- if $(n > 0)
  -- if $class_link_at(S.LINKEDPARENTS, porigin) = (SOURCE_PARENT porigin_parent)
  -- if $ppproperty_desc_at($property_info_layout(S, porigin_parent, |S.CLASSES|), ptbytes) = (ppropertydesc)
  -- if ppropertydesc.VISIBILITY =/= PROPERTY_PRIVATE
def $property_prototype(S, porigin, ptbytes, n) = porigin -- otherwise

dec $property_protected_allowed(pstate, ppropertydesc) : bool
def $property_protected_allowed(S, ppropertydesc) = ($class_origin_matches(S, porigin_scope, pclassdesc_prototype.NAME, |S.CLASSES|) \/ $class_origin_matches(S, porigin_prototype, pclassdesc_scope.NAME, |S.CLASSES|))
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.LEXICAL_CLASS = (porigin_scope)
  -- if $class_at(S.CLASSES, porigin_scope) = (pclassdesc_scope)
  -- if $property_declaring_class(S.CLASSES, ppropertydesc.ORIGIN) = (porigin_declaring)
  -- if porigin_prototype = $property_prototype(S, porigin_declaring, ppropertydesc.NAME, |S.CLASSES|)
  -- if $class_at(S.CLASSES, porigin_prototype) = (pclassdesc_prototype)
def $property_protected_allowed(S, ppropertydesc) = true
  -- if ppropertydesc.ORIGIN = INTERNAL_PROPERTY text_owner ptbytes_field
  -- if ppropertydesc.VISIBILITY = PROPERTY_PROTECTED
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.LEXICAL_CLASS = (porigin_scope)
  -- if $class_at(S.CLASSES, porigin_scope) = (pclassdesc_scope)
  -- if $class_throwable_kind(S, porigin_scope, |S.CLASSES|) = (text_kind)
  -- if $throwable_nominal(text_kind, $ptascii(text_owner), 4)
def $property_protected_allowed(S, ppropertydesc) = false -- otherwise

dec $property_lexical_private(pstate, nat, ptbytes) : ppropertydesc?
def $property_lexical_private(S, n, ptbytes) = (ppropertydesc)
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.LEXICAL_CLASS = (porigin_scope)
  -- if $class_at(S.CLASSES, porigin_scope) = (pclassdesc_scope)
  -- if $ppproperty_desc_at(pclassdesc_scope.PROPERTIES, ptbytes) = (ppropertydesc)
  -- if ppropertydesc.VISIBILITY = PROPERTY_PRIVATE
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $class_origin_matches(S, porigin, pclassdesc_scope.NAME, |S.CLASSES|)
def $property_lexical_private(S, n, ptbytes) = eps -- otherwise

dec $property_effective_desc(pstate, nat, ptbytes) : ppropertydesc?
def $property_effective_desc(S, n, ptbytes) = $ppproperty_desc_at($property_info_layout(S, porigin, |S.CLASSES|), ptbytes)
  -- if S.OBJECTS[n] = INSTANCE porigin
def $property_effective_desc(S, n, ptbytes) = eps -- otherwise

def $property_dynamic_name_allowed(S, porigin, ptbytes) = true
  -- if $ppproperty_desc_at($property_info_layout(S, porigin, |S.CLASSES|), ptbytes) = eps
def $property_dynamic_name_allowed(S, porigin, ptbytes) = true
  -- if $ppproperty_desc_at($property_info_layout(S, porigin, |S.CLASSES|), ptbytes) = (ppropertydesc)
  -- if ppropertydesc.VISIBILITY = PROPERTY_PRIVATE
  -- if $property_declaring_class(S.CLASSES, ppropertydesc.ORIGIN) = (porigin_declaring)
  -- if porigin_declaring =/= porigin
def $property_dynamic_name_allowed(S, porigin, ptbytes) = false -- otherwise

dec $property_resolve_desc(pstate, nat, ptbytes, ppropertydesc?) : ppropertyaccess
def $property_resolve_desc(S, n, ptbytes, eps) = PROPERTY_ACCESS ptbytes
def $property_resolve_desc(S, n, ptbytes, (ppropertydesc)) = PROPERTY_ACCESS ppropertydesc.KEY
  -- if ppropertydesc.VISIBILITY = PROPERTY_PUBLIC
def $property_resolve_desc(S, n, ptbytes, (ppropertydesc)) = PROPERTY_ACCESS ppropertydesc.KEY
  -- if ppropertydesc.VISIBILITY = PROPERTY_PROTECTED
  -- if $property_protected_allowed(S, ppropertydesc)
def $property_resolve_desc(S, n, ptbytes, (ppropertydesc)) = PROPERTY_ACCESS ptbytes
  -- if ppropertydesc.VISIBILITY = PROPERTY_PRIVATE
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $property_declaring_class(S.CLASSES, ppropertydesc.ORIGIN) = (porigin_declaring)
  -- if porigin_declaring =/= porigin
def $property_resolve_desc(S, n, ptbytes, (ppropertydesc)) = PROPERTY_DENIED ppropertydesc
  -- if ppropertydesc.VISIBILITY = PROPERTY_PROTECTED
  -- if ~$property_protected_allowed(S, ppropertydesc)
def $property_resolve_desc(S, n, ptbytes, (ppropertydesc)) = PROPERTY_DENIED ppropertydesc
  -- if ppropertydesc.VISIBILITY = PROPERTY_PRIVATE
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $property_declaring_class(S.CLASSES, ppropertydesc.ORIGIN) = (porigin)

def $property_resolve(S, n, ptbytes) = PROPERTY_BADNAME
  -- if $property_bad_name(ptbytes)
def $property_resolve(S, n, ptbytes) = PROPERTY_ACCESS ppropertydesc.KEY
  -- if ~$property_bad_name(ptbytes)
  -- if $property_lexical_private(S, n, ptbytes) = (ppropertydesc)
def $property_resolve(S, n, ptbytes) = $property_resolve_desc(S, n, ptbytes, $property_effective_desc(S, n, ptbytes))
  -- if ~$property_bad_name(ptbytes)
  -- if $property_lexical_private(S, n, ptbytes) = eps

def $property_accessible(S, n, ptbytes) = true
  -- if $property_resolve(S, n, ptbytes) = PROPERTY_ACCESS ptbytes_key
def $property_accessible(S, n, ptbytes) = false -- otherwise

def $property_visible_name(S, n, ptbytes) = ppropertydesc.NAME
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $property_desc_at($property_layout(S, porigin, |S.CLASSES|), ptbytes) = (ppropertydesc)
def $property_visible_name(S, n, ptbytes) = ptbytes -- otherwise
def $property_visible_key(S, n, ptbytes) = true
  -- if S.OBJECTS[n] = STDINSTANCE
def $property_visible_key(S, n, ptbytes) = ($property_resolve(S, n, $property_visible_name(S, n, ptbytes)) = PROPERTY_ACCESS ptbytes)
  -- if S.OBJECTS[n] =/= STDINSTANCE

dec $property_visibility_name(ppropertyvisibility) : ptbytes
def $property_visibility_name(PROPERTY_PUBLIC) = $ptascii("public")
def $property_visibility_name(PROPERTY_PROTECTED) = $ptascii("protected")
def $property_visibility_name(PROPERTY_PRIVATE) = $ptascii("private")

def $property_access_error(S, n, ptbytes, z) = $throw_scalar(S, "Error", $ptascii("Cannot access property starting with \"\\0\""), z)
  -- if $property_resolve(S, n, ptbytes) = PROPERTY_BADNAME
def $property_access_error(S, n, ptbytes, z) = $throw_scalar(S, "Error", $ptascii("Cannot access ") ++ $property_visibility_name(ppropertydesc.VISIBILITY) ++ $ptascii(" property ") ++ $object_name(S, n) ++ $ptascii("::$") ++ $c_string(ppropertydesc.NAME), z)
  -- if $property_resolve(S, n, ptbytes) = PROPERTY_DENIED ppropertydesc

def $property_read(S, POBJECT n, ptbytes, z) = $property_read_key(S, POBJECT n, ptbytes_key, z)
  -- if ~$throwable_object(S, n)
  -- if $property_resolve(S, n, ptbytes) = PROPERTY_ACCESS ptbytes_key
def $property_read(S, POBJECT n, ptbytes, z) = $property_access_error(S, n, ptbytes, z)
  -- if ~$throwable_object(S, n)
  -- if ~$property_accessible(S, n, ptbytes)
def $property_read(S, pvalue, ptbytes, z) = $property_read_key(S, pvalue, ptbytes, z)
  -- if $type_bytes(pvalue) =/= $ptascii("object")

def $property_quiet(S, POBJECT n, ptbytes, z) = $property_quiet_key(S, POBJECT n, ptbytes_key, z)
  -- if ~$throwable_object(S, n)
  -- if $property_resolve(S, n, ptbytes) = PROPERTY_ACCESS ptbytes_key
def $property_quiet(S, pvalue, ptbytes, z) = S[.RESULT = KNOWN PNULL] -- otherwise

def $property_store_value(S, n, ptbytes, pvalue, z) = $property_store_key(S, n, ptbytes_key, pvalue, z)
  -- if ~$throwable_object(S, n)
  -- if $property_resolve(S, n, ptbytes) = PROPERTY_ACCESS ptbytes_key
def $property_store_value(S, n, ptbytes, pvalue, z) = $property_access_error(S, n, ptbytes, z)
  -- if ~$throwable_object(S, n)
  -- if ~$property_accessible(S, n, ptbytes)

def $property_unset(S, POBJECT n, ptbytes, z) = $property_unset_key(S, POBJECT n, ptbytes_key, z)
  -- if ~$throwable_object(S, n)
  -- if $property_resolve(S, n, ptbytes) = PROPERTY_ACCESS ptbytes_key
def $property_unset(S, POBJECT n, ptbytes, z) = $property_access_error(S, n, ptbytes, z)
  -- if ~$throwable_object(S, n)
  -- if ~$property_accessible(S, n, ptbytes)
def $property_unset(S, pvalue, ptbytes, z) = S[.RESULT = KNOWN PNULL]
  -- if $type_bytes(pvalue) =/= $ptascii("object")

def $memoized_write_base(S, BASE_PROPERTY pvalue ptbytes, pcpath) = BASE_PROPERTY pvalue ptbytes
