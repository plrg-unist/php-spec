;; Literal scope operands keep their compiled identity. Dynamic operands are
;; the authentic bound row's frozen value, never a later CV lookup.
dec $closure_evidence_scope_fixed(expression) : bool
def $closure_evidence_scope_fixed(NExprClassConstFetch name (NIdentifier (BYTES text) metadata_name) metadata) = true
  -- if $ppscoped_named(name)
  -- if $pfclassname_keyword(name) = eps
  -- if $ptlc($base64(text)) = $ptascii("class")
def $closure_evidence_scope_fixed(expression) = false -- otherwise
