;; Scope certificates borrow arena/source identities. They never retain the
;; Closure, its receiver, captures or static cells in the heap graph.
dec $closure_evidence_object(pclosureevidence) : nat
dec $closure_evidence_lexical(pclosureevidence) : porigin?
dec $closure_evidence_called(pclosureevidence) : porigin?
dec $closure_evidence_receiver(pclosureevidence) : nat?
dec $closure_evidence_body(pstate, nat) : porigin?
dec $closure_evidence_valid(pstate, pclosureevidence) : bool
def $closure_evidence_object(CLOSURE_SCOPE pclosurescope) = pclosurescope.OBJECT
def $closure_evidence_object(CLOSURE_BINDING pclosurebinding) = pclosurebinding.OBJECT
def $closure_evidence_object(CLOSURE_CALL porigin_site n_source n_receiver porigin_class) = n_source
def $closure_evidence_lexical(CLOSURE_SCOPE pclosurescope) = (pclosurescope.LEXICAL)
def $closure_evidence_lexical(CLOSURE_BINDING pclosurebinding) = pclosurebinding.LEXICAL
def $closure_evidence_lexical(CLOSURE_CALL porigin_site n_source n_receiver porigin_class) = (porigin_class)
def $closure_evidence_called(CLOSURE_SCOPE pclosurescope) = (pclosurescope.CALLED)
def $closure_evidence_called(CLOSURE_BINDING pclosurebinding) = pclosurebinding.CALLED
def $closure_evidence_called(CLOSURE_CALL porigin_site n_source n_receiver porigin_class) = (porigin_class)
def $closure_evidence_receiver(CLOSURE_SCOPE pclosurescope) = pclosurescope.RECEIVER
def $closure_evidence_receiver(CLOSURE_BINDING pclosurebinding) = pclosurebinding.RECEIVER
def $closure_evidence_receiver(CLOSURE_CALL porigin_site n_source n_receiver porigin_class) = (n_receiver)
def $closure_evidence_body(S, n) = (porigin)
  -- if $(n < |S.OBJECTS|)
  -- if $object_body(S.OBJECTS[n]) = REALCLOSURE porigin pitem* pstaticcell*
  -- if $method_capture_template(S, porigin)
def $closure_evidence_body(S, n) = eps -- otherwise

;; A nested source Closure may inherit a rebound creator's effective scope.
;; The copied creator must precede it and own the immediate enclosing body.
dec $closure_creator_site(pstate, porigin?) : bool
def $closure_creator_site(S, eps) = true
def $closure_creator_site(S, (porigin)) = true
  -- if $origin_node(S.SOURCES, porigin) = (pcnode)
def $closure_creator_site(S, porigin?) = false -- otherwise
dec $closure_creator_callsite(pclosureevidence, porigin?) : bool
def $closure_creator_callsite(CLOSURE_CALL porigin_site n_source n_receiver porigin_class, porigin?) = (porigin? = (porigin_site))
def $closure_creator_callsite(CLOSURE_SCOPE pclosurescope, porigin?) = true
def $closure_creator_callsite(CLOSURE_BINDING pclosurebinding, porigin?) = true
