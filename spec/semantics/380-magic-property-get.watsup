  -- if ~pfunction.SIGNATURE.BYREF /\ ~$function_generator(S, pfunction)
  -- if S_view = S[.ORIGIN = (ppropertyget.SITE)]
  -- if $property_prep_task(S_view, NIdentifier (BYTES text_name) metadata_name, ppropertyget.LINE)
  -- if $compiled_effects(S, ppropertyget.SITE) = eps
def $property_get_owned_source(S, ppropertyget) = false -- otherwise
def $property_get_source(S, ppropertyget) = true -- if $property_get_owned_source(S, ppropertyget)
def $property_get_source(S, ppropertyget) = false -- otherwise

def $property_get_public(S, n, ptbytes) = true
  -- if $property_effective_desc(S, n, ptbytes) = eps
def $property_get_public(S, n, ptbytes) = (ppropertydesc.VISIBILITY = PROPERTY_PUBLIC /\ ~ppropertydesc.STATIC /\ ppropertydesc.KEY = ptbytes)
  -- if $property_effective_desc(S, n, ptbytes) = (ppropertydesc)

;; The original source certifies ordinary lexical scope after callback entry.
;; Changed Closure scope is a residual for these new nonpublic lookup forms.
def $property_get_lookup(S, ppropertyget) = PROPERTY_ACCESS ppropertyget.NAME
  -- if $property_get_public(S, ppropertyget.OBJECT, ppropertyget.NAME)
def $property_get_lookup(S, ppropertyget) = $property_resolve_scope(S, ppropertyget.OBJECT, ppropertyget.NAME, $closure_source_class(S, ppropertyget.SITE))
