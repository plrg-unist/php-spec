  -- if $property_get_entered(S, S.CURRENT, S.FRAMES, pcallcontext.TARGET, porigin)
def $property_get_context(S, pcallcontext) = false -- otherwise
def $call_arity_valid(S, pcallcontext) = $property_get_context(S, pcallcontext) -- if $property_get_context_kind(pcallcontext)
def $call_extent_valid(S, pcallcontext) = $property_get_context(S, pcallcontext) -- if $property_get_context_kind(pcallcontext)
def $named_context_valid(S, pcallcontext) = $property_get_context(S, pcallcontext) -- if $property_get_context_kind(pcallcontext)
def $reference_callback_used(S, pcallcontext) = (true)
  -- if S.CURRENT = (pcallcontext)
  -- if $property_get_context(S, pcallcontext)

;; Exact verification is identity: neither a checked write nor TYPE_SOURCES
;; attachment occurs. Coercions and constrained cells remain explicit residuals.
def $property_get_unconstrained(S, KNOWN pvalue) = true
def $property_get_unconstrained(S, REFERENCE n) = ($propref_at(S.PROPREFS, n) = eps /\ $parameter_backing_at(S.PARAMETERBACKINGS, n) = eps)
def $property_get_unconstrained(S, poperand) = false -- otherwise
def $property_get_verify(S, ppropertyget, poperand) = S -- if ppropertyget.DECL = eps
def $property_get_verify(S, ppropertyget, poperand) = S
  -- if ppropertyget.DECL = (ppropertyid)
  -- if $property_desc_at($property_layout(S, ppropertyget.CLASS, |S.CLASSES|), ppropertyget.NAME) = (ppropertydesc)
  -- if ppropertydesc.TYPE = eps
def $property_get_verify(S, ppropertyget, poperand) = $property_get_verify_value(S, ppropertyget, ppropertydesc, pvalue, $typed_conversion_at(S, ppropertydesc.TYPE, pvalue, pmethoddesc.FUNCTION.CODE.STRICT))
  -- if ppropertyget.DECL = (ppropertyid)
  -- if $property_desc_at($property_layout(S, ppropertyget.CLASS, |S.CLASSES|), ppropertyget.NAME) = (ppropertydesc)
  -- if ppropertydesc.TYPE =/= eps
  -- if $property_get_unconstrained(S, poperand)
  -- if S_read = $quiet_operand(S, poperand)
  -- if S_read.RESULT = KNOWN pvalue
  -- if $property_get_method(S, ppropertyget.OBJECT) = (pmethoddesc)
def $property_get_verify(S, ppropertyget, poperand) = S[.COMPLETION = UNSUPPORTED "magic getter typed reference sources"] -- otherwise

def $property_get_verify_value(S, ppropertyget, ppropertydesc, pvalue, TYPEVALUE pvalue) = S
def $property_get_verify_value(S, ppropertyget, ppropertydesc, pvalue, TYPEREJECT) = $throw_scalar(S, "TypeError", $ptascii("Value of type ") ++ $typed_given(S, pvalue) ++ $ptascii(" returned from ") ++ $property_declaring_name(S.CLASSES, ppropertydesc.ORIGIN) ++ $ptascii("::__get() must be compatible with unset property ") ++ $property_declaring_name(S.CLASSES, ppropertydesc.ORIGIN) ++ $ptascii("::$") ++ ppropertyget.NAME ++ $ptascii(" of type ") ++ $property_type_name(S, ppropertydesc), ppropertyget.LINE)
def $property_get_verify_value(S, ppropertyget, ppropertydesc, pvalue, ptypeconversion) = S[.COMPLETION = UNSUPPORTED "magic getter property type coercion"] -- otherwise

def $property_get_complete(S, ppropertyget, poperand) = S_checked[.TODO = (PROPERTY_GET_COPY ppropertyget poperand) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (PROPERTY_GET_RESULT ppropertyget) :: ptask_tail*
  -- if S_checked = $property_get_verify(S, ppropertyget, poperand)
;; Verification can fail after a real RV was returned. Retain that raw owner
;; while the receiver is released under the newly materialized TypeError.
def $throwable_same_frame_continuation(S, S_next, ptask_tail*) = S_next
  -- if S.TODO = (PROPERTY_GET_RESULT ppropertyget) :: ptask_tail*
  -- if $property_get_valid(S, ppropertyget, true)
  -- if $property_get_tail_valid(S, ppropertyget)
  -- if $call_reference_operand_valid(S, S.RESULT)
  -- if S_next.TODO = (PROPERTY_GET_COPY ppropertyget S.RESULT) :: ptask_tail*
  -- if S_next.RESULT = KNOWN PNULL /\ S_next.BASE = BASE_VALUE (KNOWN PNULL)
rule PhpStep/property-get-result: S ~> $property_get_complete(S, ppropertyget, S.RESULT)
  -- if S.TODO = (PROPERTY_GET_RESULT ppropertyget) :: ptask_tail*
  -- if $property_get_valid(S, ppropertyget, true)
  -- if $property_get_tail_valid(S, ppropertyget)
  -- if $call_reference_operand_valid(S, S.RESULT)

def $property_get_abrupt(S, ppropertyget) = S[.TODO = (THROW_SEARCH n) :: (PROPERTY_GET_COPY ppropertyget (KNOWN PNULL)) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (THROW_SEARCH n) :: ptask_tail*
def $return_discard(S, PROPERTY_GET_RESULT ppropertyget) = $property_get_abrupt(S, ppropertyget)

rule PhpStep/property-get-copy: S ~> S_read[.TODO = ptask_tail*][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (PROPERTY_GET_COPY ppropertyget poperand) :: ptask_tail*
  -- if $property_get_valid(S, ppropertyget, false)
  -- if $property_get_tail_valid(S, ppropertyget)
  -- if S_read = $quiet_operand(S, poperand)
  -- if S_read.RESULT = KNOWN pvalue
;; Under a pending exception the materialized temporary owns the payload in a
;; task, keeping THROW_SEARCH's RESULT null. Its next discard is ordinary270.
def $return_discard(S, PROPERTY_GET_COPY ppropertyget poperand) = S[.TODO = (THROW_SEARCH n) :: (PROPERTY_GET_BASE ppropertyget) :: (PROPERTY_GET_DROP ppropertyget pvalue) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if $property_get_owned_source(S, ppropertyget)
  -- if S.TODO = (THROW_SEARCH n) :: (PROPERTY_GET_BASE ppropertyget) :: ptask_tail*
  -- if S_read = $quiet_operand(S, poperand)
  -- if S_read.RESULT = KNOWN pvalue
def $return_discard(S, PROPERTY_GET_COPY ppropertyget poperand) = S[.TODO = (THROW_SEARCH n) :: (PROPERTY_GET_DROP ppropertyget pvalue) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if ~$property_get_owned_source(S, ppropertyget)
  -- if S.TODO = (THROW_SEARCH n) :: ptask_tail*
  -- if S_read = $quiet_operand(S, poperand)
  -- if S_read.RESULT = KNOWN pvalue

;; COPY has detached the RV and released its cell owner; aliases may retain it. Only
;; now does FREE_OP1 drop the original factory-result receiver owner.
rule PhpStep/property-get-base: S ~> S[.TODO = ptask_tail*]
  -- if S.TODO = (PROPERTY_GET_BASE ppropertyget) :: ptask_tail*
  -- if $property_get_base_valid(S, ppropertyget)
  -- if S.RESULT = KNOWN pvalue
  -- if S.BASE = BASE_VALUE (KNOWN PNULL)
def $task_nodes(PROPERTY_GET_BASE ppropertyget) = [HOBJECT ppropertyget.OBJECT]
def $call_task_valid(S, PROPERTY_GET_BASE ppropertyget) = $property_get_base_valid(S, ppropertyget)

def $task_nodes(PROPERTY_GET_RESULT ppropertyget) = [HOBJECT ppropertyget.OBJECT]
def $task_nodes(PROPERTY_GET_COPY ppropertyget poperand) = $operand_nodes(poperand)
def $task_nodes(PROPERTY_GET_DROP ppropertyget pvalue) = $value_nodes(pvalue)
def $call_task_valid(S, PROPERTY_GET_RESULT ppropertyget) = ($property_get_valid(S, ppropertyget, true) /\ $property_get_tail_valid(S, ppropertyget))
def $call_task_valid(S, PROPERTY_GET_COPY ppropertyget poperand) = ($property_get_valid(S, ppropertyget, false) /\ $property_get_tail_valid(S, ppropertyget) /\ $call_reference_operand_valid(S, poperand))
def $property_get_drop_pending(S) = true
  -- if $eager_operation_pending(S) =/= eps
def $property_get_drop_pending(S) = true
  -- if $destructor_operation_for(S) = (pdestructionoperation)
  -- if pdestructionoperation.PENDING =/= eps
  -- if $destructor_pending_valid(S, pdestructionoperation.PENDING)
def $property_get_drop_pending(S) = false -- otherwise
;; Saved-tail validation removes the operation before checking its exact DROP.
;; The adjacent exit marker authenticates that protected pending continuation.
def $property_get_projected_drop(S, (DESTRUCTOR_OPERATION_EXIT pdestructionoperation) :: (PROPERTY_GET_DROP ppropertyget_drop pvalue_drop) :: ptask_tail*, ppropertyget, pvalue) = true
  -- if ppropertyget_drop = ppropertyget /\ pvalue_drop = pvalue
  -- if ~(pdestructionoperation <- S.DESTRUCTION.OPERATIONS)
  -- if pdestructionoperation.SOURCE = THROW_SEARCH n_source
  -- if pdestructionoperation.PENDING = (n_pending)
  -- if pdestructionoperation.COMPLETION = NORMAL
  -- if pdestructionoperation.VALUE = KNOWN PNULL /\ pdestructionoperation.BASE = BASE_VALUE (KNOWN PNULL)
  -- if pdestructionoperation.CALLER = S.CURRENT /\ pdestructionoperation.ORIGIN = S.ORIGIN
  -- if pdestructionoperation.CONSTCONTEXT = S.CONSTCONTEXT
  -- if pdestructionoperation.ORIGIN = (ppropertyget.SITE)
  -- if S.RESULT = KNOWN PNULL /\ S.BASE = BASE_VALUE (KNOWN PNULL)
  -- if $property_get_owned_source(S, ppropertyget) /\ $property_get_valid(S, ppropertyget, false)
  -- if $destructor_pending_valid(S, (n_source)) /\ $destructor_pending_valid(S, (n_pending))
  -- if (HOBJECT n_source) <- S.ALLOCATIONS /\ (HOBJECT n_pending) <- S.ALLOCATIONS
def $property_get_projected_drop(S, (DESTRUCTOR_RESULT pdestructorcall) :: ptask_tail*, ppropertyget, pvalue) = $property_get_projected_drop(S, ptask_tail*, ppropertyget, pvalue)
def $property_get_projected_drop(S, (DESTRUCTOR_RELEASE pdestructionrelease) :: ptask_tail*, ppropertyget, pvalue) = $property_get_projected_drop(S, ptask_tail*, ppropertyget, pvalue)
def $property_get_projected_drop(S, ptask*, ppropertyget, pvalue) = false -- otherwise
def $call_task_valid(S, PROPERTY_GET_DROP ppropertyget pvalue) = ($property_get_valid(S, ppropertyget, false) /\ ($property_get_drop_pending(S) \/ $property_get_projected_drop(S, S.TODO, ppropertyget, pvalue)) /\ $heap_subset($value_nodes(pvalue), S.ALLOCATIONS) /\ ($property_get_base_count(S.TODO, ppropertyget.OBJECT, ppropertyget.SITE) = 0 \/ $property_get_base_drop(S.TODO, ppropertyget)))
def $eager_operation_source_guard(S, pdestructionoperation) = $property_get_valid(S, ppropertyget, false)
  -- if pdestructionoperation.SOURCE = PROPERTY_GET_RESULT ppropertyget
def $eager_operation_source_guard(S, pdestructionoperation) = ($property_get_owned_source(S, ppropertyget) /\ $property_get_valid(S, ppropertyget, false))
  -- if pdestructionoperation.SOURCE = PROPERTY_GET_BASE ppropertyget
;; If FREE_OP1 cleanup throws, OP_EXIT must preserve its copied VALUE before
;; the ordinary pending discard releases it. Explicit operation finish does not
;; schedule lost payload roots through the generic transition hook.
def $destructor_pending_finish(S, pdestructionoperation, n_pending, ptask_tail*) = S[.TODO = (THROW_SEARCH n_pending) :: (PROPERTY_GET_DROP ppropertyget pvalue) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)][.COMPLETION = NORMAL]
