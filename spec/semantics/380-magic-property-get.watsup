def $property_get_carrier(ptask, n, porigin) = 0 -- otherwise
def $property_get_carriers(eps, n, porigin) = 0
def $property_get_carriers(ptask :: ptask_tail*, n, porigin) = $($property_get_carrier(ptask, n, porigin) + $property_get_carriers(ptask_tail*, n, porigin))
