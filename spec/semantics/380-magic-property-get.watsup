def $property_get_carrier(PROPERTY_GET_RESULT ppropertyget, n, porigin) = 1
  -- if ppropertyget.OBJECT = n /\ ppropertyget.SITE = porigin
def $property_get_carrier(PROPERTY_GET_COPY ppropertyget poperand, n, porigin) = 1
