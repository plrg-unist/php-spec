def $property_get_string_copy_abrupt(S, ppropertygetstring, pvalue) = S[.COMPLETION = UNSUPPORTED "magic getter Stringable copy cleanup"] -- otherwise
def $return_discard(S, PROPERTY_GET_STRING_COPY ppropertygetstring pvalue) = $property_get_string_copy_abrupt(S, ppropertygetstring, pvalue)
