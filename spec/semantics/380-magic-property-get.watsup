  -- if ppropertygetstring.SOURCES = eps
  -- if S_written = $property_get_string_commit(S, ppropertygetstring, pvalue)
def $property_get_string_copy_abrupt(S, ppropertygetstring, pvalue) = S_linked[.TODO = (THROW_SEARCH n_new) :: (PROPERTY_GET_COPY ppropertygetstring.GET ppropertygetstring.INPUT) :: ppropertygetstring.TAIL][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)][.COMPLETION = NORMAL]
  -- if S.TODO = (THROW_SEARCH n_error) :: ppropertygetstring.TAIL
