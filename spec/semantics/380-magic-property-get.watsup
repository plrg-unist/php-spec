;; Exact verification is identity: neither a checked write nor TYPE_SOURCES
;; attachment occurs. Integer numeric strings convert only the actual RV or
;; unconstrained returned cell. Integer-to-float widening and FULLNUM/NINT or
;; NFLOAT strings and weak booleans likewise change only that RV/cell; wider coercions remain residuals.
def $property_get_unconstrained(S, KNOWN pvalue) = true
def $property_get_unconstrained(S, REFERENCE n) = ($propref_at(S.PROPREFS, n) = eps /\ $parameter_backing_at(S.PARAMETERBACKINGS, n) = eps)
