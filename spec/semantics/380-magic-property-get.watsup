  -- if $propref_at(S.PROPREFS, n_cell) = (ppropref)
  -- if ppropertygetstring.SOURCES = ppropref.SOURCES /\ ppropertygetstring.SOURCES =/= eps
def $property_get_string_sources(S, ppropertygetstring) = false -- otherwise
def $property_get_string_valid(S, ppropertygetstring) = ($property_get_string_scope(S, ppropertygetstring) /\ $property_get_string_sources(S, ppropertygetstring) /\ $stringable_instance(S, ppropertygetstring.OBJECT) /\ $source_operand_suffix(S.TODO, PROPERTY_GET_STRING_RESULT ppropertygetstring, ppropertygetstring.TAIL))

def $property_get_string_site_valid(S, porigin_site, z) = true
  -- if S_view = S[.ORIGIN = (porigin_site)]
  -- if $origin_node(S.SOURCES, porigin_site) = (NExprPropertyFetch expression (NIdentifier (BYTES text_name) metadata_name) metadata)
  -- if $property_prep_task(S_view, NIdentifier (BYTES text_name) metadata_name, z)
def $property_get_string_site_valid(S, porigin_site, z) = false -- otherwise
def $stringify_source(S, porigin_site, z, PROPERTY_GET_STRING_RESULT ppropertygetstring) = ($property_get_string_valid(S, ppropertygetstring) /\ porigin_site = ppropertygetstring.GET.SITE /\ z = ppropertygetstring.GET.LINE)
def $stringify_source_consumer(PROPERTY_GET_STRING_RESULT ppropertygetstring) = true
def $stringify_consumer_tail_valid(S, porigin_site, z, PROPERTY_GET_STRING_RESULT ppropertygetstring, ptask_tail*) = ($stringify_source(S, porigin_site, z, PROPERTY_GET_STRING_RESULT ppropertygetstring) /\ ptask_tail* = ppropertygetstring.TAIL)
def $stringify_consumer_receiver_valid(S, n_object, PROPERTY_GET_STRING_RESULT ppropertygetstring) = (n_object = ppropertygetstring.OBJECT)
def $parameter_string_frame_scope(S, pframe, pframe_tail*) = $constant_frame_scope(S, pframe, pframe_tail*)
  -- if pframe.TODO = (STRINGIFY_RESULT n_object porigin_site z) :: (PROPERTY_GET_STRING_RESULT ppropertygetstring) :: ptask_tail*
def $property_get_string_begin(S, ppropertygetstring) = $user_string_begin(S, ppropertygetstring.OBJECT, ppropertygetstring.GET.SITE, ppropertygetstring.GET.LINE, PROPERTY_GET_STRING_RESULT ppropertygetstring, ppropertygetstring.TAIL)
def $task_nodes(PROPERTY_GET_STRING_RESULT ppropertygetstring) = [HOBJECT ppropertygetstring.GET.OBJECT] ++ $operand_nodes(ppropertygetstring.INPUT)
  -- if ppropertygetstring.SOURCES = eps
def $task_nodes(PROPERTY_GET_STRING_RESULT ppropertygetstring) = [HOBJECT ppropertygetstring.GET.OBJECT, HOBJECT ppropertygetstring.OBJECT] ++ $operand_nodes(ppropertygetstring.INPUT)
  -- if ppropertygetstring.SOURCES =/= eps
def $call_task_valid(S, PROPERTY_GET_STRING_RESULT ppropertygetstring) = $property_get_string_valid(S, ppropertygetstring)

;; Generic STRINGIFY_RESULT releases only its cast pin. READY still owns the
;; original argument or copied temporary, and keeps the returned carrier intact.
def $property_get_string_value(S, pvalue) = true
  -- if $string_bytes(pvalue) = (ptbytes)
  -- if pvalue = PSTRING ptbytes \/ $string_carrier_valid(S, pvalue)
def $property_get_string_value(S, pvalue) = false -- otherwise
def $stringify_return_state(S, PROPERTY_GET_STRING_RESULT ppropertygetstring, pvalue_text, ptask_tail*) = S[.TODO = (PROPERTY_GET_STRING_READY ppropertygetstring pvalue_text) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if $property_get_string_valid(S, ppropertygetstring)
  -- if ptask_tail* = ppropertygetstring.TAIL
  -- if $property_get_string_value(S, pvalue_text)
def $task_nodes(PROPERTY_GET_STRING_READY ppropertygetstring pvalue) = $task_nodes(PROPERTY_GET_STRING_RESULT ppropertygetstring)
def $property_get_string_ready_valid(S, ppropertygetstring, pvalue) = (S.RESULT = KNOWN PNULL /\ S.BASE = BASE_VALUE (KNOWN PNULL) /\ $property_get_string_scope(S, ppropertygetstring) /\ $property_get_string_sources(S, ppropertygetstring) /\ $stringable_instance(S, ppropertygetstring.OBJECT) /\ $property_get_string_value(S, pvalue) /\ $source_operand_suffix(S.TODO, PROPERTY_GET_STRING_READY ppropertygetstring pvalue, ppropertygetstring.TAIL))
def $call_task_valid(S, PROPERTY_GET_STRING_READY ppropertygetstring pvalue) = $property_get_string_ready_valid(S, ppropertygetstring, pvalue)
rule PhpStep/property-get-string-release: S ~> S[.TODO = (PROPERTY_GET_STRING_COPY ppropertygetstring pvalue) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
