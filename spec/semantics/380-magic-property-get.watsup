rule PhpStep/property-get-string-release-invalid: S ~> S[.COMPLETION = UNSUPPORTED "magic getter Stringable release continuation"]
  -- if S.TODO = (PROPERTY_GET_STRING_READY ppropertygetstring pvalue) :: ptask_tail*
  -- if ~$property_get_string_ready_valid(S, ppropertygetstring, pvalue)

;; COPY's old object id is documentary: its release may already have retired it.
;; A REF retains raw STORE for destructor reads but owns no old-object edge.
def $task_nodes(PROPERTY_GET_STRING_COPY ppropertygetstring pvalue) = [HOBJECT ppropertygetstring.GET.OBJECT, HCELL n_cell]
  -- if ppropertygetstring.INPUT = REFERENCE n_cell
def $task_nodes(PROPERTY_GET_STRING_COPY ppropertygetstring pvalue) = [HOBJECT ppropertygetstring.GET.OBJECT]
  -- if ppropertygetstring.INPUT = KNOWN (POBJECT ppropertygetstring.OBJECT)
def $property_get_string_copy_valid(S, ppropertygetstring, pvalue) = (S.RESULT = KNOWN PNULL /\ S.BASE = BASE_VALUE (KNOWN PNULL) /\ $property_get_string_scope(S, ppropertygetstring) /\ $property_get_string_sources(S, ppropertygetstring) /\ $property_get_string_value(S, pvalue) /\ $source_operand_suffix(S.TODO, PROPERTY_GET_STRING_COPY ppropertygetstring pvalue, ppropertygetstring.TAIL))
def $call_task_valid(S, PROPERTY_GET_STRING_COPY ppropertygetstring pvalue) = $property_get_string_copy_valid(S, ppropertygetstring, pvalue)
def $property_get_string_copy_at((PROPERTY_GET_STRING_COPY ppropertygetstring pvalue) :: ptask_tail*, n_cell) = ((ppropertygetstring, pvalue))
  -- if ppropertygetstring.INPUT = REFERENCE n_cell
def $property_get_string_copy_at(ptask :: ptask_tail*, n_cell) = $property_get_string_copy_at(ptask_tail*, n_cell)
  -- if $property_get_string_record(ptask) = eps
def $property_get_string_copy_at(ptask*, n_cell) = eps -- otherwise
def $typed_cv_string_released_scope(S, n_cell) = true
  -- if $property_get_string_copy_at(S.TODO, n_cell) = ((ppropertygetstring, pvalue))
  -- if ppropertygetstring.SOURCES = eps
  -- if $property_get_string_copy_valid(S[.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], ppropertygetstring, pvalue)

def $property_get_string_commit(S, ppropertygetstring, pvalue) = S[.RESULT = KNOWN pvalue]
  -- if ppropertygetstring.INPUT = KNOWN (POBJECT ppropertygetstring.OBJECT)
  -- if ppropertygetstring.SOURCES = eps
def $property_get_string_commit(S, ppropertygetstring, pvalue) = S[.STORE = $set_cell(S.STORE, n_cell, DEFINED pvalue)][.RESULT = REFERENCE n_cell]
  -- if ppropertygetstring.INPUT = REFERENCE n_cell
  -- if ppropertygetstring.SOURCES = eps
def $property_get_string_commit(S, ppropertygetstring, pvalue) = $throw_scalar(S, "TypeError", $ptascii("Reference with value of type ") ++ $property_get_given(S, pvalue_live) ++ $ptascii(" held by ") ++ $propref_label(S, pproptypesource) ++ $ptascii(" is not compatible with property ") ++ $property_declaring_name(S.CLASSES, ppropertydesc.ORIGIN) ++ $ptascii("::$") ++ ppropertygetstring.GET.NAME ++ $ptascii(" of type ") ++ $property_type_name(S, ppropertydesc), ppropertygetstring.GET.LINE)
  -- if ppropertygetstring.SOURCES = pproptypesource :: pproptypesource_tail*
  -- if S_read = $quiet_operand(S, ppropertygetstring.INPUT)
  -- if S_read.RESULT = KNOWN pvalue_live
  -- if $property_desc_at($property_layout(S, ppropertygetstring.GET.CLASS, |S.CLASSES|), ppropertygetstring.GET.NAME) = (ppropertydesc)
def $property_get_string_finish(S, ppropertygetstring, pvalue) = S_checked[.TODO = (PROPERTY_GET_COPY ppropertygetstring.GET S_checked.RESULT) :: ppropertygetstring.TAIL][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if ppropertygetstring.SOURCES = eps
  -- if S_checked = $property_get_string_commit(S, ppropertygetstring, pvalue)
def $property_get_string_finish(S, ppropertygetstring, pvalue) = S_checked[.TODO = (PROPERTY_GET_COPY ppropertygetstring.GET ppropertygetstring.INPUT) :: ppropertygetstring.TAIL][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if ppropertygetstring.SOURCES =/= eps
  -- if S_checked = $property_get_string_commit(S, ppropertygetstring, pvalue)
rule PhpStep/property-get-string-copy: S ~> $property_get_string_finish(S, ppropertygetstring, pvalue)
  -- if S.TODO = (PROPERTY_GET_STRING_COPY ppropertygetstring pvalue) :: ptask_tail*
  -- if $property_get_string_copy_valid(S, ppropertygetstring, pvalue)
rule PhpStep/property-get-string-copy-invalid: S ~> S[.COMPLETION = UNSUPPORTED "magic getter Stringable copy continuation"]
  -- if S.TODO = (PROPERTY_GET_STRING_COPY ppropertygetstring pvalue) :: ptask_tail*
  -- if ~$property_get_string_copy_valid(S, ppropertygetstring, pvalue)
def $throwable_same_frame_continuation(S, S_next, ptask_tail*) = S_next
  -- if S.TODO = (PROPERTY_GET_STRING_COPY ppropertygetstring pvalue) :: ptask_tail*
  -- if $property_get_string_copy_valid(S, ppropertygetstring, pvalue)
  -- if S_next.TODO = (PROPERTY_GET_COPY ppropertygetstring.GET ppropertygetstring.INPUT) :: ptask_tail*
  -- if S_next.RESULT = KNOWN PNULL /\ S_next.BASE = BASE_VALUE (KNOWN PNULL)

;; Callback failure does not convert. A successful cast whose original-object
;; destructor threw still copies its saved string before propagating that error.
def $property_get_string_abrupt(S, ppropertygetstring) = S[.TODO = (THROW_SEARCH n_error) :: (PROPERTY_GET_COPY ppropertygetstring.GET ppropertygetstring.INPUT) :: ppropertygetstring.TAIL][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (THROW_SEARCH n_error) :: ppropertygetstring.TAIL
  -- if $throwable_live(S, n_error)
  -- if $property_get_string_valid(S[.TODO = (PROPERTY_GET_STRING_RESULT ppropertygetstring) :: ppropertygetstring.TAIL], ppropertygetstring)
def $property_get_string_abrupt(S, ppropertygetstring) = S[.COMPLETION = UNSUPPORTED "magic getter Stringable callback cleanup"] -- otherwise
def $return_discard(S, PROPERTY_GET_STRING_RESULT ppropertygetstring) = $property_get_string_abrupt(S, ppropertygetstring)
def $property_get_string_copy_abrupt(S, ppropertygetstring, pvalue) = S_written[.TODO = (THROW_SEARCH n_error) :: (PROPERTY_GET_COPY ppropertygetstring.GET S_written.RESULT) :: ppropertygetstring.TAIL][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
