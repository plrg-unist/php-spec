;; Accessible INITIAL does not invoke __get. The UNSET state is distinct.
def $property_get_method(S, n) = $effective_method(S, porigin, $ptascii("__get"), |S.CLASSES|)
  -- if $(n < |S.OBJECTS|)
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $class_throwable_kind(S, porigin, |S.CLASSES|) = eps
