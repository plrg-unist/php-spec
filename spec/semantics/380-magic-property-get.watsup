;; RESULT is the invocation stage; COPY no longer represents native IN_GET.
;; Thus reentry from receiver destruction after the getter returns is distinct.
def $property_get_guard_task(PROPERTY_GET_RESULT ppropertyget, n, ptbytes) = (ppropertyget.OBJECT = n /\ ppropertyget.NAME = ptbytes)
def $property_get_guard_task(ptask, n, ptbytes) = false -- otherwise
def $property_get_guard_tasks(ptask :: ptask_tail*, n, ptbytes) = ($property_get_guard_task(ptask, n, ptbytes) \/ $property_get_guard_tasks(ptask_tail*, n, ptbytes))
def $property_get_guard_tasks(eps, n, ptbytes) = false
def $property_get_guard_frames(eps, n, ptbytes) = false
def $property_get_guard_frames(pframe :: pframe_tail*, n, ptbytes) = ($property_get_guard_tasks(pframe.TODO, n, ptbytes) \/ $property_get_guard_frames(pframe_tail*, n, ptbytes))

