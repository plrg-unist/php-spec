  -- if pdestructionoperation.VALUE = KNOWN pvalue
  -- if pdestructionoperation.BASE = BASE_VALUE (KNOWN PNULL)
  -- if pdestructionoperation.CALLER = S.CURRENT /\ pdestructionoperation.ORIGIN = S.ORIGIN
  -- if S.ORIGIN = (ppropertyget.SITE)
  -- if $heap_subset($value_nodes(pvalue), S.ALLOCATIONS)
