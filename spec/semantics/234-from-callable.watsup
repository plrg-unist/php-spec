def $from_outer(pfrommethod) = papiclass.REQUESTED -- if pfrommethod.OUTER = (papiclass)
def $from_outer(pfrommethod) = pfrommethod.CLASS.REQUESTED -- if pfrommethod.OUTER = eps
def $from_live_receiver(S, pfrommethod) = true -- if pfrommethod.STATIC
def $from_live_receiver(S, pfrommethod) = true
  -- if ~pfrommethod.STATIC
  -- if pfrommethod.CLASS.RECEIVER = (n)
  -- if $(n < |S.OBJECTS|)
