def $from_identity(S, POBJECT n) = (n) -- if $closure_callable(S, n)
def $from_identity(S, PARRAY n) = (n_object)
  -- if $typed_callback_array(S, n)
  -- if $entry_lookup(S.ARRAYS[n].ITEMS, KINT 0) = (pitem_receiver)
  -- if $entry_lookup(S.ARRAYS[n].ITEMS, KINT 1) = (pitem_method)
  -- if $entry_value(S, pitem_receiver) = POBJECT n_object
  -- if $entry_value(S, pitem_method) = PSTRING ptbytes
  -- if $ptlc(ptbytes) = $ptascii("__invoke")
  -- if $closure_callable(S, n_object)
def $from_identity(S, pvalue) = eps -- otherwise

rule PhpStep/from-callable-invoke: S ~> $config_receive(S, pconfigcall)
  -- if S.TODO = (CONFIG_INVOKE pconfigcall) :: ptask_tail*
  -- if pconfigcall.KIND = INTRINSIC_FROM_CALLABLE
  -- if $config_invoke_valid(S, pconfigcall)

def $config_receive(S, pconfigcall) = $from_receive(S, pconfigcall, pvalue)
  -- if pconfigcall.KIND = INTRINSIC_FROM_CALLABLE
  -- if pconfigcall.SENT = [NAMED_SENT (KNOWN pvalue)]
def $from_done(S, n) = S[.TODO = ptask_tail*][.RESULT = KNOWN (POBJECT n)][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = ptask :: ptask_tail*
def $from_receive(S, pconfigcall, pvalue) = $from_done(S, n)
  -- if $from_identity(S, pvalue) = (n)
def $from_receive(S, pconfigcall, PARRAY n) = $api_begin(S, CONFIG_INVOKE pconfigcall, PARRAY n)
  -- if $from_identity(S, PARRAY n) = eps
  -- if $typed_callback_array(S, n)
  -- if $error_handler_array_invalid(S, n) = eps
  -- if $from_getter(S, n) = eps
def $from_receive(S, pconfigcall, PARRAY n_array) = $from_done(S[.OBJECTS = S.OBJECTS ++ [GETTERCLOSURE n_receiver pgettermethod text_base pconfigcall.SITE]][.ALLOCATIONS = S.ALLOCATIONS ++ [HOBJECT n]], n)
  -- if $from_getter(S, n_array) = ((n_receiver, pgettermethod, text_base))
  -- if n = |S.OBJECTS|
def $from_receive(S, pconfigcall, PSTRING ptbytes) = $api_begin(S, CONFIG_INVOKE pconfigcall, PSTRING ptbytes)
  -- if ~$typed_registered(S, ptbytes)
  -- if $method_string_parts(ptbytes) =/= eps
def $from_receive(S, pconfigcall, PSTRING ptbytes) = $from_done(S[.OBJECTS = S.OBJECTS ++ [NAMEDCLOSURE pfunction.ORIGIN]][.ALLOCATIONS = S.ALLOCATIONS ++ [HOBJECT n]], n)
  -- if $call_target(S, $typed_callable_name(ptbytes), eps) = (pfunction)
  -- if n = |S.OBJECTS|
def $from_receive(S, pconfigcall, PSTRING ptbytes) = $from_done(S[.OBJECTS = S.OBJECTS ++ [INTRINSICCLOSURE pintrinsic]][.ALLOCATIONS = S.ALLOCATIONS ++ [HOBJECT n]], n)
  -- if $call_target(S, $typed_callable_name(ptbytes), eps) = eps
  -- if $intrinsic_named($typed_callable_name(ptbytes)) = (pintrinsic)
  -- if n = |S.OBJECTS|
def $from_receive(S, pconfigcall, POBJECT n) = $from_allocate(S, $from_method(S, papiquery, pmethoddesc.FUNCTION.ORIGIN, $ptascii("__invoke"), false, true))
  -- if $from_identity(S, POBJECT n) = eps
  -- if $object_invoke_method(S, n) = (pmethoddesc)
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if papiquery = $api_query(S, CONFIG_INVOKE pconfigcall, POBJECT n, POBJECT n, DIRECT (PSTRING ($ptascii("__invoke"))), {REQUESTED porigin, CALLED porigin, RECEIVER (n), STRICT false}, $ptascii("__invoke"), 0, 0)
def $from_receive(S, pconfigcall, pvalue) = $from_finish(S, pconfigcall, pvalue, $error_handler_resolution(S, pvalue)) -- otherwise

def $api_source_valid(S, papiquery) = true
  -- if papiquery.SOURCE = CONFIG_INVOKE pconfigcall
  -- if pconfigcall.KIND = INTRINSIC_FROM_CALLABLE
  -- if $config_invoke_valid(S, pconfigcall)
  -- if pconfigcall.SENT = [NAMED_SENT (KNOWN papiquery.VALUE)]
def $api_finish(S, CONFIG_INVOKE pconfigcall, pvalue, phandlerresolution) = $from_finish(S, pconfigcall, pvalue, phandlerresolution)
  -- if pconfigcall.KIND = INTRINSIC_FROM_CALLABLE

def $from_finish(S, pconfigcall, pvalue, HANDLERRESOLVED (API_METHOD_TARGET papiquery porigin ptbytes b)) = $from_allocate(S, $from_method(S, papiquery, porigin, ptbytes, b, false))
def $from_finish(S, pconfigcall, pvalue, HANDLERINVALID ptbytes) = $config_error(S, pconfigcall, "TypeError", $ptascii("Failed to create closure from callable: ") ++ ptbytes)
def $from_finish(S, pconfigcall, pvalue, HANDLERUNKNOWN text) = S[.COMPLETION = UNSUPPORTED text]
def $from_finish(S, pconfigcall, pvalue, phandlerresolution) = S[.COMPLETION = UNSUPPORTED "internal Closure::fromCallable selected target"] -- otherwise

def $api_getter_scope(papiquery) = eps
  -- if papiquery.SOURCE = CONFIG_INVOKE pconfigcall
  -- if pconfigcall.KIND = INTRINSIC_FROM_CALLABLE
def $api_getter_denied(S, papiquery, pmethoddesc, ptbytes) = $ptascii("Call to ") ++ $method_visibility_name(pmethoddesc.VISIBILITY) ++ $ptascii(" method ") ++ pclassdesc.NAME ++ $ptascii("::") ++ $c_string(ptbytes) ++ $ptascii("() from scope Closure")
  -- if papiquery.SOURCE = CONFIG_INVOKE pconfigcall
  -- if pconfigcall.KIND = INTRINSIC_FROM_CALLABLE
  -- if $class_at(S.CLASSES, pmethoddesc.OWNER) = (pclassdesc)
def $api_throw(S, papiquery, ptbytes_method, ptbytes) = $throwable_previous(S_new, n_new, n_old)
  -- if papiquery.SOURCE = CONFIG_INVOKE pconfigcall
  -- if pconfigcall.KIND = INTRINSIC_FROM_CALLABLE
  -- if $class_at(S.CLASSES, papiquery.CLASS.REQUESTED) = (pclassdesc)
  -- if S_old = $throwable_materialize($config_error(S, pconfigcall, "Error", ptbytes))
  -- if S_old.COMPLETION = THROWING n_old
  -- if ptbytes_outer = $ptascii("Failed to create closure from callable: class ") ++ pclassdesc.NAME ++ $ptascii(" does not have a method \"") ++ $c_string(ptbytes_method) ++ [34]
  -- if S_new = $throwable_materialize($config_error(S_old[.COMPLETION = NORMAL], pconfigcall, "TypeError", ptbytes_outer))
  -- if S_new.COMPLETION = THROWING n_new

;; This hook runs after the failed handler frame/finally and registry restoration.
def $error_read_discard(S, API_CALLABLE_RESULT papiquery n) = $throwable_begin($throwable_previous(S_new, n_new, n_old)[.TODO = ptask_tail*])
  -- if papiquery.SOURCE = CONFIG_INVOKE pconfigcall
  -- if pconfigcall.KIND = INTRINSIC_FROM_CALLABLE
  -- if S.TODO = (THROW_SEARCH n_old) :: ptask_tail*
  -- if S_new = $throwable_materialize($config_error(S, pconfigcall, "TypeError", $ptascii("Failed to create closure from callable")))
  -- if S_new.COMPLETION = THROWING n_new
def $error_context_trigger(S, pcallcontext) = (pconfigcall)
  -- if $error_context_call(S, pcallcontext) = (perrorcall)
  -- if perrorcall.RESUME = API_CALLABLE_RESULT papiquery n
  -- if papiquery.SOURCE = CONFIG_INVOKE pconfigcall
  -- if pconfigcall.KIND = INTRINSIC_FROM_CALLABLE
def $error_handler_trace_values(S, pcallcontext, pconfigcall) = $trace_extra(S, $getclass_trace_operands(pconfigcall.SENT))
  -- if pconfigcall.KIND = INTRINSIC_FROM_CALLABLE

;; Frozen history is metadata. Static selection may remember an object that has
;; retired; an entered nonstatic closure must still own its actual receiver.
def $from_method(S, papiquery, porigin, ptbytes, b_static, b_invoke) = {SITE pconfigcall.SITE, INPUT papiquery.INPUT, METHOD ptbytes_live, SCOPE papiquery.SCOPE, CALLED papiquery.CALLED, THIS papiquery.THIS, CLASS papiquery.CLASS, OUTER papiquery.OUTER, ORIGINAL papiquery.ORIGINAL, PREFIX papiquery.PREFIX, WIDTH papiquery.WIDTH, FUNCTION porigin, NAME ptbytes, STATIC b_static, CREATION $method_capture_current(S, pconfigcall.SITE), ARRAY $is_array_value(papiquery.VALUE), INVOKE b_invoke}
  -- if papiquery.SOURCE = CONFIG_INVOKE pconfigcall
  -- if $entry_value(S, papiquery.METHOD) = PSTRING ptbytes_live
def $from_receiver(pfrommethod) = eps -- if pfrommethod.STATIC
def $from_receiver(pfrommethod) = pfrommethod.CLASS.RECEIVER -- if ~pfrommethod.STATIC
def $from_allocate(S, pfrommethod) = $from_done(S[.OBJECTS = S.OBJECTS ++ [FROMCALLABLECLOSURE pfrommethod]][.ALLOCATIONS = S.ALLOCATIONS ++ [HOBJECT n]][.CLOSURESCOPES = S.CLOSURESCOPES ++ [{OBJECT n, LEXICAL pmethoddesc.OWNER, CALLED pfrommethod.CLASS.CALLED, RECEIVER $from_receiver(pfrommethod), CREATION eps}]], n)
  -- if $class_method_origin(S.CLASSES, pfrommethod.FUNCTION) = (pmethoddesc)
  -- if n = |S.OBJECTS|
def $from_input_roots(POBJECT n) = [HOBJECT n]
def $from_input_roots(pvalue) = eps -- otherwise
def $from_history(S, pfrommethod) = S[.ALLOCATIONS = S.ALLOCATIONS ++ $from_input_roots(pfrommethod.INPUT) ++ $scoped_receiver_nodes(pfrommethod.THIS) ++ $scoped_receiver_nodes(pfrommethod.CLASS.RECEIVER)]
def $from_history_valid(S, eps) = true
def $from_history_valid(S, (HOBJECT n) :: pnode*) = true
  -- if $(n < |S.OBJECTS|)
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if $from_history_valid(S, pnode*)
def $from_history_valid(S, pnode*) = false -- otherwise

