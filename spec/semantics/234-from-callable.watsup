;; Closure::fromCallable selects once, then creates a fake closure whose only
;; heap owner is its nonstatic bound receiver. Admission runs in the selecting
;; USER scope; actual-object get_method runs in the internal Closure scope.
dec $from_site(pstate, porigin) : bool
dec $from_static_class(pstate, porigin, phpType19) : bool
dec $from_start(pstate, porigin, nat?, int) : pstate
dec $from_identity(pstate, pvalue) : nat?
dec $from_receive(pstate, pconfigcall, pvalue) : pstate
dec $from_finish(pstate, pconfigcall, pvalue, phandlerresolution) : pstate
dec $from_done(pstate, nat) : pstate
dec $from_method(pstate, papiquery, porigin, ptbytes, bool, bool) : pfrommethod
dec $from_allocate(pstate, pfrommethod) : pstate
dec $from_receiver(pfrommethod) : nat?
dec $from_input_roots(pvalue) : pnode*
dec $from_history(pstate, pfrommethod) : pstate
dec $from_history_valid(pstate, pnode*) : bool
dec $from_permission(pstate, pfrommethod) : bool
dec $from_class_valid(pstate, pfrommethod) : bool
dec $from_selected(pstate, pfrommethod) : pmethoddesc?
dec $from_valid(pstate, pfrommethod) : bool
dec $from_leaf(pfrommethod) : bool
dec $from_live_receiver(pstate, pfrommethod) : bool
dec $from_outer(pfrommethod) : porigin
dec $from_split(pfrommethod) : bool
dec $from_getter(pstate, nat) : (nat, pgettermethod, text)?
dec $from_getter_kind(pstate, nat, ptbytes) : text?
dec $from_compare(pstate, nat, nat) : bool
dec $from_object(pobject) : bool
dec $from_child_valid(pstate, porigin, pclosurescope) : bool

def $intrinsic_name(INTRINSIC_FROM_CALLABLE) = $ptascii("Closure::fromCallable")
def $config_kind(INTRINSIC_FROM_CALLABLE) = true
def $config_required(INTRINSIC_FROM_CALLABLE) = 1
def $config_parameter(INTRINSIC_FROM_CALLABLE, ptbytes) = (0) -- if ptbytes = $ptascii("callback")
def $config_parameter_name(INTRINSIC_FROM_CALLABLE, 0) = $ptascii("callback")
def $config_trace_frames(S, pconfigcall, pvalue*) = [{FILE $call_sourcefile(S.FILES, pconfigcall.SITE), LINE pconfigcall.LINE, FUNCTION $ptascii("fromCallable"), CLASS ($ptascii("Closure")), TYPE ($ptascii("::")), ARGS $trace_indexed_args(pvalue*, 0), HASARGS true}]
  -- if pconfigcall.KIND = INTRINSIC_FROM_CALLABLE

def $from_static_class(S, PORIGIN n_unit pcpath, phpType19) = true
  -- if $ppscoped_named(phpType19) /\ ~$ppscoped_keyword(phpType19)
  -- if $code_at(S.CODE, n_unit) = (pcode)
  -- if $code_name(pcode.NAMES, pcpath) = ((ptbytes, eps))
  -- if $ptlc($typed_callable_name(ptbytes)) = $ptascii("closure")
def $from_static_class(S, porigin, phpType19) = true
  -- if ~$ppscoped_named(phpType19)
  -- if phpType19 = expression
  -- if $parser_literal(expression) = eps
def $from_static_class(S, porigin, phpType19) = true
  -- if ~$ppscoped_named(phpType19)
  -- if phpType19 = expression
  -- if $parser_literal(expression) = (PSTRING ptbytes)
  -- if $ptlc($typed_callable_name(ptbytes)) = $ptascii("closure")
def $from_static_class(S, porigin, phpType19) = false -- otherwise
def $from_method_site(S, porigin) = true
  -- if $origin_node(S.SOURCES, porigin) = (NExprMethodCall expression phpType20 (SEQUENCE phpType7*) metadata)
  -- if $method_source_name(phpType20, $ptascii("fromcallable"))
  -- if ~$ppfirstclass(phpType7*)
def $from_method_site(S, porigin) = true
  -- if $origin_node(S.SOURCES, porigin) = (NExprNullsafeMethodCall expression phpType20 (SEQUENCE phpType7*) metadata)
  -- if $method_source_name(phpType20, $ptascii("fromcallable"))
  -- if ~$ppfirstclass(phpType7*)
def $from_method_site(S, porigin) = false -- otherwise
def $from_site(S, porigin) = true -- if $from_method_site(S, porigin)
def $from_site(S, porigin) = true
  -- if $origin_node(S.SOURCES, porigin) = (NExprStaticCall phpType19 phpType20 (SEQUENCE phpType7*) metadata)
  -- if $from_static_class(S, porigin, phpType19)
  -- if $method_source_name(phpType20, $ptascii("fromcallable"))
  -- if ~$ppfirstclass(phpType7*)
def $from_site(S, porigin) = false -- otherwise

def $exit_callable_arguments(S, porigin) = PCALLARGUMENTS phpType7* 2
  -- if $origin_node(S.SOURCES, porigin) = (NExprStaticCall phpType19 phpType20 (SEQUENCE phpType7*) metadata)
  -- if $from_site(S, porigin) \/ $closure_current_site(S, porigin) \/ $closure_binding_api_site(S, porigin)
def $config_selected_valid(S, pconfigcall) = true
  -- if pconfigcall.KIND = INTRINSIC_FROM_CALLABLE
  -- if pconfigcall.SELECTION = eps
  -- if pconfigcall.OWNER = eps
  -- if $from_site(S, pconfigcall.SITE)
  -- if ~$from_method_site(S, pconfigcall.SITE)
def $config_selected_valid(S, pconfigcall) = true
  -- if pconfigcall.KIND = INTRINSIC_FROM_CALLABLE
  -- if pconfigcall.SELECTION = eps
  -- if pconfigcall.OWNER = (n)
  -- if $closure_static_api_owner_valid(S, n)
  -- if $from_method_site(S, pconfigcall.SITE)

def $from_start(S, porigin, n_owner?, z) = S[.TODO = [CONFIG_ARGS {SITE porigin, KIND INTRINSIC_FROM_CALLABLE, INDEX 0, SENT eps, NAMED false, OWNER n_owner?, SELECTION eps, LINE z, PACKS eps}, METHOD_RESULT] ++ ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = ptask :: ptask_tail*
def $scoped_select(S, phpType19, KNOWN (PSTRING ptbytes_class), ptbytes_method, phpType7*, z) = $from_start(S, porigin, eps, z)
  -- if $ptlc($typed_callable_name(ptbytes_class)) = $ptascii("closure")
  -- if $ptlc(ptbytes_method) = $ptascii("fromcallable")
  -- if ~$ppfirstclass(phpType7*)
  -- if S.ORIGIN = (porigin)
  -- if $from_site(S, porigin)
def $scoped_select(S, phpType19, KNOWN (PSTRING ptbytes_class), ptbytes_method, phpType7*, z) = S[.COMPLETION = UNSUPPORTED "capture of internal Closure::fromCallable target"]
  -- if $ptlc($typed_callable_name(ptbytes_class)) = $ptascii("closure")
  -- if $ptlc(ptbytes_method) = $ptascii("fromcallable")
  -- if $ppfirstclass(phpType7*)
def $scoped_dynamic_class(S, z) = S_read[.RESULT = KNOWN (PSTRING ($ptascii("Closure")))]
  -- if S_read = $resolve_at(S, S.RESULT, z)
  -- if S_read.COMPLETION = NORMAL
  -- if S_read.RESULT = KNOWN (PSTRING ptbytes)
  -- if $ptlc($typed_callable_name(ptbytes)) = $ptascii("closure")
def $scoped_dynamic_class(S, z) = S_read[.RESULT = KNOWN (PSTRING ($ptascii("Closure")))]
  -- if S_read = $resolve_at(S, S.RESULT, z)
  -- if S_read.COMPLETION = NORMAL
  -- if S_read.RESULT = KNOWN (POBJECT n)
  -- if $closure_callable(S_read, n)
def $method_select(S, poperand, ptbytes, phpType7*, z) = $from_start(S_read, porigin, (n), z)
  -- if S_read = $resolve_at(S, poperand, z)
  -- if S_read.COMPLETION = NORMAL
  -- if S_read.RESULT = KNOWN (POBJECT n)
  -- if $closure_callable(S_read, n)
  -- if $ptlc(ptbytes) = $ptascii("fromcallable")
  -- if ~$ppfirstclass(phpType7*)
  -- if S.ORIGIN = (porigin)
  -- if $from_method_site(S, porigin)
def $method_select(S, poperand, ptbytes, phpType7*, z) = S_read[.COMPLETION = UNSUPPORTED "capture of internal Closure::fromCallable target"]
  -- if S_read = $resolve_at(S, poperand, z)
  -- if S_read.COMPLETION = NORMAL
  -- if S_read.RESULT = KNOWN (POBJECT n)
  -- if $closure_callable(S_read, n)
