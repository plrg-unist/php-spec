def $from_leaf(pfrommethod) = (pfrommethod.NAME = pfrommethod.METHOD)
  -- if pfrommethod.PREFIX = 0 /\ pfrommethod.WIDTH = 0
def $from_leaf(pfrommethod) = (pfrommethod.NAME = pfrommethod.METHOD[pfrommethod.PREFIX:pfrommethod.WIDTH])
  -- if pfrommethod.PREFIX =/= 0 \/ pfrommethod.WIDTH =/= 0
