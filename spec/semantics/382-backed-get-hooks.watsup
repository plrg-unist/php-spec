def $property_hook_virtual_edge(S, ppropertydesc_parent, ppropertydesc_child) = false -- otherwise
;; A virtual parent leaves a genuinely backed child's own slot/default intact.
def $property_hook_backed_over_virtual(S, ppropertydesc_parent, ppropertydesc_child) = true
