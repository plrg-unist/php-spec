def $property_hook_context_kind(pcallcontext) = true
  -- if pcallcontext.TARGET = PROPERTY_HOOK_TARGET ppropertyhook
def $property_hook_context_kind(pcallcontext) = false -- otherwise
dec $property_hook_context_valid(pstate, pcallcontext) : bool
def $property_hook_context_valid(S, pcallcontext) = $property_hook_entered(S, S.CURRENT, S.FRAMES, ppropertyhook)
  -- if pcallcontext.TARGET = PROPERTY_HOOK_TARGET ppropertyhook
  -- if pcallcontext.CALLSITE = (ppropertyhook.SITE) /\ pcallcontext.LINE = ppropertyhook.LINE
  -- if pcallcontext.ARGC = 0 /\ pcallcontext.EXTRA = eps /\ pcallcontext.NAMED = eps /\ pcallcontext.WRAPPER = eps /\ pcallcontext.HOLES = eps
