  -- if ppropertydesc.NAME = $base64(text_name) /\ ppropertydesc.KEY = ppropertydesc.NAME
  -- if $hook_pair_get_index(phpType38_first, phpType38_second, ppropertydesc.NAME, pclassdesc.KIND) = (n_get)
  -- if n_set = $nabs($(1 - n_get))
  -- if $origin_node(S.SOURCES, PORIGIN n (pcpath_group ++ [PCFIELD 4, PCINDEX 0])) = (phpType38_first)
  -- if $origin_node(S.SOURCES, PORIGIN n (pcpath_group ++ [PCFIELD 4, PCINDEX 1])) = (phpType38_second)
  -- if $origin_node(S.SOURCES, pclassdesc.ORIGIN) = (NStmtClass phpType14_class phpType24_class phpType3_class ABSENT phpType42_class phpType23_class metadata_class)
