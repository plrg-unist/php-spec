def $property_hook_override_shape(S, ppropertydesc_parent, ppropertydesc_child) = false -- otherwise
def $property_hook_covariance(S, ppropertydesc_parent, ppropertydesc_child) = $pvcovariant(ppropertydesc_child.TYPE, $trait_data_scope(S, pclassdesc_child), ppropertydesc_parent.TYPE, $trait_data_scope(S, pclassdesc_parent), $method_active_registry(S, S.CLASSNAMES))
