  -- if ptbytes_name = ptbytes
def $hook_uses_node(pcnode, ptbytes) = false -- if $hook_boundary(pcnode)
def $hook_uses_node(pcnode, ptbytes) = $hook_uses_children($pcchildren(pcnode, eps), ptbytes)
  -- otherwise
def $hook_uses_children(eps, ptbytes) = false
def $hook_uses_children((PCOCCURRENCE pcpath pcnode) :: pcoccurrence*, ptbytes) = ($hook_uses_node(pcnode, ptbytes) \/ $hook_uses_children(pcoccurrence*, ptbytes))
