  -- if $property_hook_inherited_backing(S, ppropertydesc_parent) \/ $property_hook_ordinary_backing(S, ppropertydesc_parent, |S.CLASSES|)
  -- if $property_hook_override_backed(S, ppropertydesc_child)
  -- if ppropertydesc_child.ORIGIN = porigin_child_property
  -- if $property_declaring_class(S.CLASSES, porigin_child_property) = (porigin_child)
  -- if $class_at(S.CLASSES, porigin_child) = (pclassdesc_child)
  -- if $hook_property_at(pclassdesc_child.PROPERTIES, porigin_child_property) = (ppropertydesc_child)
def $property_hook_missing_return_parent(S, ppropertydesc_parent, ppropertydesc_child) = false -- otherwise
dec $property_hook_get_declaration(pstate, ppropertydesc) : ptbytes?
def $property_hook_get_declaration(S, ppropertydesc) = ($pmcstring(pclassdesc.NAME ++ $ptascii("::") ++ $hook_name(ppropertydesc.NAME) ++ $ptascii("()") ++ $pmif(ppropertydesc.TYPE =/= eps, $ptascii(": ") ++ $pmtypename(ppropertydesc.TYPE, $trait_data_scope(S, pclassdesc)))))
  -- if $property_declaring_class(S.CLASSES, ppropertydesc.ORIGIN) = (porigin_class)
  -- if $class_at(S.CLASSES, porigin_class) = (pclassdesc)
  -- if $property_hook_origin(S, ppropertydesc) =/= eps
def $property_hook_get_declaration(S, ppropertydesc) = eps -- otherwise
dec $property_hook_covariance_message(pstate, ppropertydesc, ppropertydesc, pvresult) : ptbytes?
def $property_hook_covariance_message(S, ppropertydesc_parent, ppropertydesc_child, PVINCOMPATIBLE) = ($ptascii("Declaration of ") ++ ptbytes_child ++ $ptascii(" must be compatible with ") ++ ptbytes_parent)
  -- if $property_hook_get_declaration(S, ppropertydesc_child) = (ptbytes_child)
  -- if $property_hook_get_declaration(S, ppropertydesc_parent) = (ptbytes_parent)
def $property_hook_covariance_message(S, ppropertydesc_parent, ppropertydesc_child, PVINCOMPATIBLE) = ($ptascii("Type of ") ++ pclassdesc_child.NAME ++ $ptascii("::$") ++ ppropertydesc_child.NAME ++ $ptascii(" must be subtype of ") ++ $pmtypename(ppropertydesc_parent.TYPE, $trait_data_scope(S, pclassdesc_parent)) ++ $ptascii(" (as in class ") ++ pclassdesc_parent.NAME ++ [41])
  -- if $property_hook_plain_covariance_parent(S, ppropertydesc_parent, ppropertydesc_child, |S.CLASSES|)
  -- if $property_declaring_class(S.CLASSES, ppropertydesc_parent.ORIGIN) = (porigin_parent)
  -- if $class_at(S.CLASSES, porigin_parent) = (pclassdesc_parent)
  -- if $property_declaring_class(S.CLASSES, ppropertydesc_child.ORIGIN) = (porigin_child)
  -- if $class_at(S.CLASSES, porigin_child) = (pclassdesc_child)
def $property_hook_covariance_message(S, ppropertydesc_parent, ppropertydesc_child, pvresult) = eps -- otherwise
def $trait_property_inherit_message(S, ptbytes_child, ptbytes_parent, ppropertydesc_parent, ppropertydesc_child) = $property_hook_covariance_message(S, ppropertydesc_parent, ppropertydesc_child, $property_hook_covariance(S, ppropertydesc_parent, ppropertydesc_child))
  -- if $property_hook_covariance_parent(S, ppropertydesc_parent, ppropertydesc_child)
  -- if ppropertydesc_child.TYPE =/= eps
def $trait_property_inherit_message(S, ptbytes_child, ptbytes_parent, ppropertydesc_parent, ppropertydesc_child) = $property_hook_covariance_message(S, ppropertydesc_parent, ppropertydesc_child, PVINCOMPATIBLE)
  -- if $property_hook_covariance_parent(S, ppropertydesc_parent, ppropertydesc_child) /\ ppropertydesc_child.TYPE = eps
def $trait_property_inherit_message(S, ptbytes_child, ptbytes_parent, ppropertydesc_parent, ppropertydesc_child) = $property_hook_covariance_message(S, ppropertydesc_parent, ppropertydesc_child, PVINCOMPATIBLE)
  -- if $property_hook_missing_return_parent(S, ppropertydesc_parent, ppropertydesc_child)
def $trait_property_inherit_message(S, ptbytes_child, ptbytes_parent, ppropertydesc_parent, ppropertydesc_child) = eps
  -- if $property_hook_plain_protected_set_parent(S, ppropertydesc_parent, ppropertydesc_child, |S.CLASSES|)

;; The returned issue still selects the first parent-table property error.
;; Only its matching getter incompatibility uses the actual hook source line.
dec $property_hook_override_fatal_at(pstate, pclassdesc, ppropertydesc*, ppropertydesc*, ptbytes) : pstate
dec $property_hook_covariance_error_site(pstate, ppropertydesc*, ppropertydesc, ptbytes) : (porigin, int)?
def $property_hook_override_fatal(S, pclassdesc, ptbytes_message) = $property_hook_override_fatal_at(S, pclassdesc, $property_info_layout(S, porigin_parent, |S.CLASSES|), pclassdesc.PROPERTIES, ptbytes_message)
  -- if pclassdesc.PARENT = (ptbytes_parent)
  -- if $class_named(S.CLASSNAMES, $ptlc(ptbytes_parent)) = (porigin_parent)
def $property_hook_override_fatal(S, pclassdesc, ptbytes_message) = $pil_method_fatal(S, pclassdesc.ORIGIN, ptbytes_message, pclassdesc.LINE) -- otherwise
def $property_hook_override_fatal_at(S, pclassdesc, ppropertydesc_inherited*, eps, ptbytes_message) = $pil_method_fatal(S, pclassdesc.ORIGIN, ptbytes_message, pclassdesc.LINE)
def $property_hook_override_fatal_at(S, pclassdesc, ppropertydesc_inherited*, ppropertydesc_child :: ppropertydesc_tail*, ptbytes_message) = $pil_method_fatal(S, porigin_hook, ptbytes_message, z)
  -- if $property_hook_covariance_error_site(S, ppropertydesc_inherited*, ppropertydesc_child, ptbytes_message) = ((porigin_hook, z))
def $property_hook_override_fatal_at(S, pclassdesc, ppropertydesc_inherited*, ppropertydesc_child :: ppropertydesc_tail*, ptbytes_message) = $property_hook_override_fatal_at(S, pclassdesc, ppropertydesc_inherited*, ppropertydesc_tail*, ptbytes_message)
  -- if $property_hook_covariance_error_site(S, ppropertydesc_inherited*, ppropertydesc_child, ptbytes_message) = eps
def $property_hook_covariance_error_site(S, ppropertydesc_inherited*, ppropertydesc_child, ptbytes_message) = ((porigin_hook, z))
  -- if $ppproperty_desc_at(ppropertydesc_inherited*, ppropertydesc_child.NAME) = (ppropertydesc_parent)
  -- if ($property_hook_covariance_parent(S, ppropertydesc_parent, ppropertydesc_child) /\ $property_hook_covariance(S, ppropertydesc_parent, ppropertydesc_child) = PVINCOMPATIBLE) \/ $property_hook_missing_return_parent(S, ppropertydesc_parent, ppropertydesc_child)
  -- if $property_hook_covariance_message(S, ppropertydesc_parent, ppropertydesc_child, PVINCOMPATIBLE) = (ptbytes_message)
  -- if $property_hook_origin(S, ppropertydesc_child) = (porigin_hook)
  -- if $origin_node(S.SOURCES, porigin_hook) = (NPropertyHook phpType14 phpType24 phpType4 phpType11 phpType16 phpType39 metadata)
  -- if z = $source_line(metadata)
  -- if $(z > 0)
def $property_hook_covariance_error_site(S, ppropertydesc_inherited*, ppropertydesc_child, ptbytes_message) = eps -- otherwise
dec $property_hook_parent_overlap(pstate, ppropertydesc*, ppropertydesc*) : bool
dec $property_hook_parent_match(pstate, ppropertydesc, ppropertydesc?) : bool
def $property_hook_parent_overlap(S, eps, ppropertydesc_parent*) = false
def $property_hook_parent_overlap(S, ppropertydesc :: ppropertydesc_tail*, ppropertydesc_parent*) = ($property_hook_parent_match(S, ppropertydesc, $property_desc_at(ppropertydesc_parent*, ppropertydesc.KEY)) \/ $property_hook_parent_overlap(S, ppropertydesc_tail*, ppropertydesc_parent*))
def $property_hook_parent_match(S, ppropertydesc, eps) = (($property_hook_effective_origin(S, ppropertydesc) =/= eps /\ $property_hook_trait_origin(S, ppropertydesc) = eps) \/ $property_set_origin(S, ppropertydesc) =/= eps)
def $property_hook_parent_match(S, ppropertydesc, (ppropertydesc_inherited)) = ($property_set_origin(S, ppropertydesc_inherited) =/= eps \/ $property_set_origin(S, ppropertydesc) =/= eps \/ (($property_hook_effective_origin(S, ppropertydesc_inherited) =/= eps \/ $property_hook_effective_origin(S, ppropertydesc) =/= eps) /\ ~$property_hook_override_pair(S, ppropertydesc_inherited, ppropertydesc)))
def $property_hook_link_finish(S, pclassdesc, S_linked) = $trait_restore(S, S_linked[.COMPLETION = UNSUPPORTED "inherited property hook override"])
  -- if S_linked.COMPLETION = NORMAL
  -- if $class_at(S_linked.CLASSES, pclassdesc.ORIGIN) = (pclassdesc_effective)
  -- if pclassdesc_effective.PARENT =/= eps
  -- if $property_hook_parent_overlap(S_linked, pclassdesc_effective.PROPERTIES, $promotion_override_parent_layout(S_linked, pclassdesc_effective))
def $property_hook_link_finish(S, pclassdesc, S_linked) = S_linked -- otherwise

def $property_unset_indirect_check(S, n, ptbytes, z) = S[.COMPLETION = UNSUPPORTED "hooked property unset"]
  -- if $property_hook_declared(S, n, ptbytes)
