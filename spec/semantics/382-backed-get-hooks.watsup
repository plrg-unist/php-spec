;; The short SET RHS and its installed receipt authenticate both pair origins.
def $property_hook_pair_origins(S, ppropertydesc) = [PORIGIN n (pcpath_group ++ [PCFIELD 4, PCINDEX n_get]), PORIGIN n (pcpath_group ++ [PCFIELD 4, PCINDEX n_set])]
