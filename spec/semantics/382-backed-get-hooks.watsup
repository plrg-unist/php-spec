def $call_task_valid(S, PROPERTY_HOOK_RESULT ppropertyhook) = $property_hook_valid(S, ppropertyhook, false)

def $trace_context_function(S, pcallcontext) = $hook_name(ppropertydesc.NAME)
  -- if pcallcontext.TARGET = PROPERTY_HOOK_TARGET ppropertyhook
  -- if S.OBJECTS[ppropertyhook.OBJECT] = INSTANCE porigin_class
