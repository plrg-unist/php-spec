def $property_hook_backed_over_virtual(S, ppropertydesc_parent, ppropertydesc_child) = false -- otherwise
;; A child may add a backed getter to an ordinary public property.
def $property_hook_backed_over_ordinary(S, ppropertydesc_parent, ppropertydesc_child) = true
