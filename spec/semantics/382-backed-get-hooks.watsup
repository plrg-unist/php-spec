def $property_hook_source(S, ppropertyhook) = false -- otherwise

dec $property_hook_valid(pstate, ppropertyhook, bool) : bool
def $property_hook_valid(S, ppropertyhook, b_live) = ($property_hook_source(S, ppropertyhook) /\ (~b_live \/ ((HOBJECT ppropertyhook.OBJECT) <- S.ALLOCATIONS /\ ~$instance_storage_freeing(S, ppropertyhook.OBJECT))))

def $property_hook_pending(S) = true
