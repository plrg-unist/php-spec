  -- if ppropertydesc.ORIGIN = ppropertyhook.PROPERTY
def $trace_context_class(S, pcallcontext) = ($property_declaring_name(S.CLASSES, ppropertyhook.PROPERTY))
  -- if pcallcontext.TARGET = PROPERTY_HOOK_TARGET ppropertyhook
def $trace_context_type(S, pcallcontext) = ($ptascii("->"))
