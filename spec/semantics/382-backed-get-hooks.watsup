;; Backed-parent inheritance stays invariant; virtual get-only parents allow covariance.
;; Other hook inheritance cannot borrow the ordinary property merge.
def $property_hook_override_backed(S, ppropertydesc) = true
  -- if ~ppropertydesc.FINAL /\ ppropertydesc.SETVISIBILITY = eps
  -- if $property_hook_origin(S, ppropertydesc) = (porigin_hook)
