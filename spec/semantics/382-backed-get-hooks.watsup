;; PHP 8.5.10: a backed, public by-value block get is a real source function.
;; Its implicit return type is the property's type, with no ordinary method entry.
dec $hook_boundary(pcnode) : bool
def $hook_boundary(NStmtFunction phpType14 phpType4 phpType11 phpType16 phpType18 phpType23 metadata) = true
def $hook_boundary(NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata) = true
def $hook_boundary(NExprClosure phpType14 phpType4 phpType4_2 phpType16 phpType21 phpType18 phpType23 metadata) = true
def $hook_boundary(NExprArrowFunction phpType14 phpType4 phpType4_2 phpType16 phpType18 expression metadata) = true
def $hook_boundary(NStmtTrait phpType14 phpType3 phpType23 metadata) = true
def $hook_boundary(NStmtInterface phpType14 phpType3 phpType42 phpType23 metadata) = true
def $hook_boundary(NStmtEnum phpType14 phpType3 phpType50 phpType42 phpType23 metadata) = true
def $hook_boundary(pcnode) = false -- otherwise
dec $hook_uses_node(pcnode, ptbytes) : bool
dec $hook_uses_children(pcoccurrence*, ptbytes) : bool
def $hook_uses_node(NExprPropertyFetch (NExprVariable (BYTES text_this) metadata_this) (NIdentifier (BYTES text_name) metadata_name) metadata, ptbytes) = true
  -- if $base64(text_this) = $ptascii("this") /\ $base64(text_name) = ptbytes
def $hook_uses_node(NExprNullsafePropertyFetch (NExprVariable (BYTES text_this) metadata_this) (NIdentifier (BYTES text_name) metadata_name) metadata, ptbytes) = true
  -- if $base64(text_this) = $ptascii("this") /\ $base64(text_name) = ptbytes
def $hook_uses_node(pcnode, ptbytes) = false -- if $hook_boundary(pcnode)
def $hook_uses_node(pcnode, ptbytes) = $hook_uses_children($pcchildren(pcnode, eps), ptbytes)
  -- otherwise
def $hook_uses_children(eps, ptbytes) = false
def $hook_uses_children((PCOCCURRENCE pcpath pcnode) :: pcoccurrence*, ptbytes) = ($hook_uses_node(pcnode, ptbytes) \/ $hook_uses_children(pcoccurrence*, ptbytes))

dec $hook_name(ptbytes) : ptbytes
def $hook_name(ptbytes) = [36] ++ ptbytes ++ $ptascii("::get")
dec $pphook_compile(ppstate, pcpath, ppropertydesc, phpType38, pchheader) : ppstate
dec $pphook_finish(ppstate, ppstate, pcpath, ppropertydesc, metadata, pchheader) : ppstate

def $ppproperty_hook_group(P, pcpath, NStmtProperty (SEQUENCE eps) (INTEGER flags) phpType18 (SEQUENCE ([NPropertyItem (NVarLikeIdentifier (BYTES text) metadata_name) phpType5 metadata_item])) (SEQUENCE ([phpType38])) metadata, ppropertydesc*, pchheader) = PPROPERTIES $pphook_compile(P_next, pcpath ++ [PCFIELD 4, PCINDEX 0], ppropertydesc_new, phpType38, pchheader) ppropertydesc_next*
  -- if flags <- [0,1] /\ pchheader.KIND = "class" /\ ~pchheader.READONLY
  -- if pchheader.PARENT = eps /\ ~$pptrait_body_uses(pchheader.BODY)
  -- if $ppproperty_group_line_valid(P, metadata)
  -- if PPROPERTIES P_next ppropertydesc_next* = $ppproperty_group($pplocate(P, pcpath, $source_line(metadata)), pcpath, flags, phpType18, [NPropertyItem (NVarLikeIdentifier (BYTES text) metadata_name) phpType5 metadata_item], ppropertydesc*, pchheader, $source_line(metadata))
  -- if P_next.COMPLETION = PPCNORMAL
  -- if |ppropertydesc_next*| = $(|ppropertydesc*| + 1)
  -- if ppropertydesc_new = ppropertydesc_next*[|ppropertydesc*|]
def $ppproperty_hook_group(P, pcpath, NStmtProperty (SEQUENCE eps) (INTEGER flags) phpType18 (SEQUENCE ([NPropertyItem phpType40 phpType5 metadata_item])) (SEQUENCE ([phpType38])) metadata, ppropertydesc*, pchheader) = PPROPERTIES P_next ppropertydesc_next*
  -- if flags <- [0,1] /\ pchheader.KIND = "class" /\ ~pchheader.READONLY
  -- if pchheader.PARENT = eps /\ ~$pptrait_body_uses(pchheader.BODY)
  -- if $ppproperty_group_line_valid(P, metadata)
  -- if PPROPERTIES P_next ppropertydesc_next* = $ppproperty_group($pplocate(P, pcpath, $source_line(metadata)), pcpath, flags, phpType18, [NPropertyItem phpType40 phpType5 metadata_item], ppropertydesc*, pchheader, $source_line(metadata))
  -- if P_next.COMPLETION =/= PPCNORMAL
def $ppproperty_hook_group(P, pcpath, statement, ppropertydesc*, pchheader) = PPROPERTIES ($ppunsupported(P, "property hook visibility, inheritance, attributes or shape")) ppropertydesc* -- otherwise

def $pphook_compile(P, pcpath, ppropertydesc, NPropertyHook (SEQUENCE eps) (INTEGER 0) (BOOLEAN false) (NIdentifier (BYTES text_get) metadata_name) (SEQUENCE eps) (SEQUENCE statement*) metadata, pchheader) = $pphook_finish(P, $ppgoto_finish($ppstatements(P_hook, pcpath ++ [PCFIELD 5], 0, statement*)), pcpath, ppropertydesc, metadata, pchheader)
  -- if $ptlc($base64(text_get)) = $ptascii("get")
  -- if ~$generator_statements(statement*)
  -- if $hook_uses_children($pcfield_phpType39(SEQUENCE statement*, eps), ppropertydesc.NAME)
  -- if z = $source_line(metadata)
  -- if $(z > 0 /\ z <= $source_end_line(metadata))
  -- if P_hook = $ppfunction_start($pplocate(P[.CLASSCONTEXT = ($ppmethod_context(P, pchheader, $hook_name(ppropertydesc.NAME), z))], pcpath, z), pchheader.NAME ++ $ptascii("::") ++ $hook_name(ppropertydesc.NAME), {PARAMETERS eps, RETURNS ppropertydesc.TYPE, BYREF false})[.RETURNREF = false][.RETURNS = ppropertydesc.TYPE][.GOTOROOT = pcpath][.FOLD = P.FOLD[.FUNCTION = pchheader.NAME ++ $ptascii("::") ++ $hook_name(ppropertydesc.NAME)][.CLASSCONTEXT = ($ppmethod_context(P, pchheader, $hook_name(ppropertydesc.NAME), z))][.CLOSURE = false][.DEFAULT = false][.CONSTANT = false][.VALUE = eps]]
def $pphook_compile(P, pcpath, ppropertydesc, phpType38, pchheader) = $ppunsupported(P, "virtual, set, by-reference, short or attributed property hook") -- otherwise

def $pphook_finish(P_outer, P_body, pcpath, ppropertydesc, metadata, pchheader) = P_body
  -- if P_body.COMPLETION =/= PPCNORMAL
def $pphook_finish(P_outer, P_body, pcpath, ppropertydesc, metadata, pchheader) = $ppfunction_add(P_restored, {DEFAULTS eps, ORIGIN PORIGIN P_outer.FOLD.SOURCE.ID pcpath, NAME (pchheader.NAME ++ $ptascii("::") ++ $hook_name(ppropertydesc.NAME)), SIGNATURE {PARAMETERS eps, RETURNS ppropertydesc.TYPE, BYREF false}, CVS P_body.CVS, ENV P_outer.ENV, CODE $ppfunction_code(P_body), BODY (pcpath ++ [PCFIELD 5]), EARLY false, LINE $nabs($source_line(metadata)), ENDLINE $psendline(metadata)})
  -- if P_body.COMPLETION = PPCNORMAL
  -- if P_restored = P_body[.CLOSURE = P_outer.CLOSURE][.CLASSCONTEXT = P_outer.CLASSCONTEXT][.EVALCLASS = P_outer.EVALCLASS][.RETURNREF = P_outer.RETURNREF][.RETURNS = P_outer.RETURNS][.CVS = P_outer.CVS][.HEADERASSIGNED = P_outer.HEADERASSIGNED][.LOOPS = P_outer.LOOPS][.SWITCHES = P_outer.SWITCHES][.GOTOROOT = P_outer.GOTOROOT][.LABELS = P_outer.LABELS][.GOTOS = P_outer.GOTOS][.EARLY = P_outer.EARLY][.FOLD = P_body.FOLD[.FUNCTION = P_outer.FOLD.FUNCTION][.CLASSCONTEXT = P_outer.FOLD.CLASSCONTEXT][.CLOSURE = P_outer.FOLD.CLOSURE][.VALUE = eps]][.LOCATION = P_outer.LOCATION][.EXPRESSIONS = P_outer.EXPRESSIONS ++ P_body.EXPRESSIONS][.ACCESS = P_outer.ACCESS ++ P_body.ACCESS][.NAMES = P_outer.NAMES ++ P_body.NAMES][.REDIRECTS = P_outer.REDIRECTS ++ P_body.REDIRECTS][.WRITES = P_outer.WRITES ++ P_body.WRITES][.GLOBALS = P_outer.GLOBALS ++ P_body.GLOBALS]

def $function_body_tasks(S, pfunction) = $statement_tasks(statement*, (PORIGIN n pfunction.BODY), 0) ++ [$function_fallthrough(S, pfunction)]
  -- if pfunction.ORIGIN = PORIGIN n pcpath
  -- if $origin_node(S.SOURCES, pfunction.ORIGIN) = (NPropertyHook phpType14 phpType24 (BOOLEAN false) phpType11 (SEQUENCE eps) (SEQUENCE statement*) metadata)

