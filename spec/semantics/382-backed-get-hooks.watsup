rule PhpStep/property-hook-call: S ~> S[.TODO = [(CALL_ARGS (PROPERTY_HOOK_TARGET ppropertyhook) eps 0 eps (ppropertyhook.SITE) ppropertyhook.LINE), PROPERTY_HOOK_RESULT ppropertyhook] ++ ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (PROPERTY_PREP phpType20 z) :: (DIM_FETCH z) :: ptask_tail*
  -- if $property_hook_plan(S) = (ppropertyhook)
rule PhpStep/property-hook-unsupported: S ~> S[.COMPLETION = UNSUPPORTED "property hook read source or function"]
  -- if $property_hook_pending(S)
  -- if $property_hook_plan(S) = eps
rule PhpStep/property-hook-result: S ~> S[.TODO = ptask_tail*][.BASE = BASE_VALUE S.RESULT]
  -- if S.TODO = (PROPERTY_HOOK_RESULT ppropertyhook) :: ptask_tail*
  -- if S.COMPLETION = NORMAL

;; The call target owns the receiver until the genuine frame takes it over.
;; RESULT owns the returned payload before frame cleanup releases the receiver.
def $target_nodes(PROPERTY_HOOK_TARGET ppropertyhook) = [HOBJECT ppropertyhook.OBJECT]
def $target_instance(PROPERTY_HOOK_TARGET ppropertyhook) = eps
def $target_receiver(S, PROPERTY_HOOK_TARGET ppropertyhook) = (ppropertyhook.OBJECT)
def $target_lexical_class(S, PROPERTY_HOOK_TARGET ppropertyhook) = $property_declaring_class(S.CLASSES, ppropertyhook.PROPERTY)
def $target_called_class(S, PROPERTY_HOOK_TARGET ppropertyhook) = (porigin)
  -- if S.OBJECTS[ppropertyhook.OBJECT] = INSTANCE porigin
def $target_function(S, PROPERTY_HOOK_TARGET ppropertyhook) = $property_hook_function(S, ppropertyhook)
  -- if $property_hook_valid(S, ppropertyhook, true)
def $task_nodes(PROPERTY_HOOK_RESULT ppropertyhook) = eps

dec $property_hook_pending_call(pstate, ppropertyhook) : bool
def $property_hook_pending_call(S, ppropertyhook) = true
  -- if S.TODO = (CALL_ARGS (PROPERTY_HOOK_TARGET ppropertyhook) eps 0 eps (ppropertyhook.SITE) ppropertyhook.LINE) :: (PROPERTY_HOOK_RESULT ppropertyhook) :: ptask_tail*
  -- if S.ORIGIN = (ppropertyhook.SITE)
  -- if $property_hook_valid(S, ppropertyhook, true)
def $property_hook_pending_call(S, ppropertyhook) = false -- otherwise

dec $property_hook_entered(pstate, pcallcontext?, pframe*, ppropertyhook) : bool
dec $property_hook_frame(pstate, pcallcontext, pframe, ppropertyhook) : bool
def $property_hook_frame(S, pcallcontext, pframe, ppropertyhook) = true
  -- if pcallcontext.TARGET = PROPERTY_HOOK_TARGET ppropertyhook
  -- if pcallcontext.CALLSITE = (ppropertyhook.SITE) /\ pcallcontext.LINE = ppropertyhook.LINE
  -- if pcallcontext.ARGC = 0 /\ pcallcontext.EXTRA = eps /\ pcallcontext.NAMED = eps /\ pcallcontext.WRAPPER = eps /\ pcallcontext.HOLES = eps
  -- if pframe.TODO = (PROPERTY_HOOK_RESULT ppropertyhook) :: ptask_tail*
  -- if pframe.ORIGIN = (ppropertyhook.SITE)
  -- if $property_hook_valid(S, ppropertyhook, true)
def $property_hook_frame(S, pcallcontext, pframe, ppropertyhook) = false -- otherwise
def $property_hook_entered(S, (pcallcontext), pframe :: pframe_tail*, ppropertyhook) = $property_hook_frame(S, pcallcontext, pframe, ppropertyhook)
  -- if pcallcontext.TARGET = PROPERTY_HOOK_TARGET ppropertyhook
def $property_hook_entered(S, (pcallcontext), pframe :: pframe_tail*, ppropertyhook) = $property_hook_entered(S, pframe.CONTEXT, pframe_tail*, ppropertyhook)
  -- if pcallcontext.TARGET =/= PROPERTY_HOOK_TARGET ppropertyhook
def $property_hook_entered(S, eps, pframe :: pframe_tail*, ppropertyhook) = $property_hook_entered(S, pframe.CONTEXT, pframe_tail*, ppropertyhook)
def $property_hook_entered(S, pcallcontext?, eps, ppropertyhook) = false

def $call_selected_valid(S, PROPERTY_HOOK_TARGET ppropertyhook, (porigin)) = (porigin = ppropertyhook.SITE /\ ($property_hook_pending_call(S, ppropertyhook) \/ $property_hook_entered(S, S.CURRENT, S.FRAMES, ppropertyhook)))
def $call_arguments_valid(S, (porigin), 0, eps, eps, 0) = true
  -- if S.TODO = (CALL_ARGS (PROPERTY_HOOK_TARGET ppropertyhook) eps 0 eps (porigin) z) :: ptask_tail*
