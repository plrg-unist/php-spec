def $call_extent_valid(S, pcallcontext) = $property_hook_context_valid(S, pcallcontext)
  -- if $property_hook_context_kind(pcallcontext)
def $named_context_valid(S, pcallcontext) = $property_hook_context_valid(S, pcallcontext)
