;; The call target owns the receiver until the genuine frame takes it over.
;; RESULT owns the returned payload before frame cleanup releases the receiver.
def $target_nodes(PROPERTY_HOOK_TARGET ppropertyhook) = [HOBJECT ppropertyhook.OBJECT]
def $target_instance(PROPERTY_HOOK_TARGET ppropertyhook) = eps
def $target_receiver(S, PROPERTY_HOOK_TARGET ppropertyhook) = (ppropertyhook.OBJECT)
