;; Hooked indirect/reference/unset families do not borrow ordinary backing access.
def $property_instance_indirect_check(S, n, ptbytes, b_object, z) = S[.COMPLETION = UNSUPPORTED "by-value property hook indirect access"]
  -- if $property_hook_read_needed(S, n, ptbytes)

;; A plain overriding declaration cannot silently discard an inherited hook.
dec $property_hook_parent_overlap(pstate, ppropertydesc*, ppropertydesc*) : bool
dec $property_hook_parent_match(pstate, ppropertydesc?) : bool
def $property_hook_parent_overlap(S, eps, ppropertydesc_parent*) = false
def $property_hook_parent_overlap(S, ppropertydesc :: ppropertydesc_tail*, ppropertydesc_parent*) = ($property_hook_parent_match(S, $property_desc_at(ppropertydesc_parent*, ppropertydesc.KEY)) \/ $property_hook_parent_overlap(S, ppropertydesc_tail*, ppropertydesc_parent*))
def $property_hook_parent_match(S, eps) = false
def $property_hook_parent_match(S, (ppropertydesc_inherited)) = ($property_hook_origin(S, ppropertydesc_inherited) =/= eps)
def $property_hook_link_finish(S, pclassdesc, S_linked) = $trait_restore(S, S_linked[.COMPLETION = UNSUPPORTED "inherited property hook override"])
  -- if S_linked.COMPLETION = NORMAL
  -- if $class_at(S_linked.CLASSES, pclassdesc.ORIGIN) = (pclassdesc_effective)
  -- if $property_hook_parent_overlap(S_linked, pclassdesc_effective.PROPERTIES, $promotion_override_parent_layout(S_linked, pclassdesc_effective))
def $property_hook_link_finish(S, pclassdesc, S_linked) = S_linked -- otherwise

def $property_unset_indirect_check(S, n, ptbytes, z) = S[.COMPLETION = UNSUPPORTED "hooked property unset"]
  -- if $property_hook_declared(S, n, ptbytes)
