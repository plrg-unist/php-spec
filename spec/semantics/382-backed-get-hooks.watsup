  -- if $(|pcpath| >= 2)
  -- if pcpath_group = pcpath[0:$nabs($( |pcpath| - 2))]
  -- if pcpath = pcpath_group ++ [PCFIELD 3, PCINDEX 0]
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath_group) = (NStmtProperty (SEQUENCE eps) (INTEGER flags) phpType18 (SEQUENCE ([NPropertyItem (NVarLikeIdentifier (BYTES text_name) metadata_name) phpType5 metadata_item])) (SEQUENCE ([NPropertyHook (SEQUENCE eps) (INTEGER 0) (BOOLEAN false) (NIdentifier (BYTES text_get) metadata_get) (SEQUENCE eps) (SEQUENCE statement*) metadata_hook])) metadata)
  -- if flags <- [0,1] /\ ppropertydesc.VISIBILITY = PROPERTY_PUBLIC /\ ~ppropertydesc.STATIC /\ ~ppropertydesc.READONLY
  -- if ppropertydesc.NAME = $base64(text_name) /\ ppropertydesc.KEY = ppropertydesc.NAME
  -- if $ptlc($base64(text_get)) = $ptascii("get")
  -- if ~$generator_statements(statement*)
  -- if $hook_uses_children($pcfield_phpType39(SEQUENCE statement*, eps), ppropertydesc.NAME)
def $property_hook_origin(S, ppropertydesc) = eps -- otherwise

def $property_hook_declared(S, n, ptbytes) = true
