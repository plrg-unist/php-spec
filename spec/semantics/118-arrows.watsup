;; Implicit captures use the existing real object store. Undefined is a completed
;; value only in a source-authenticated implicit slot, never a callable partial.

def $closure_lexical_entry(CODEIMPLICIT pcpath ptbytes z) = [IMPLICIT ptbytes z]
dec $arrow_line_entry(pcodeexpr, pcpath) : int?
def $arrow_line_entry(CODEARROW pcpath z, pcpath) = (z)
def $arrow_line_entry(pcodeexpr, pcpath) = eps -- otherwise
dec $arrow_line(pcodeexpr*, pcpath) : int?
def $arrow_line(eps, pcpath) = eps
def $arrow_line(pcodeexpr :: pcodeexpr_tail*, pcpath) = (z)
  -- if $arrow_line_entry(pcodeexpr, pcpath) = (z)
def $arrow_line(pcodeexpr :: pcodeexpr_tail*, pcpath) = $arrow_line(pcodeexpr_tail*, pcpath)
  -- if $arrow_line_entry(pcodeexpr, pcpath) = eps

dec $implicit_item(pstate, ptbytes) : pitem
def $implicit_item(S, ptbytes) = DIRECT pvalue
  -- if $lookup(S.ENV, ptbytes) = (n)
  -- if S.STORE[n] = DEFINED pvalue
def $implicit_item(S, ptbytes) = UNINITIALIZED -- otherwise
def $closure_capture_read(S, IMPLICIT ptbytes z) = S[.COMPLETION = UNSUPPORTED "request environment variable"]
  -- if $environment_blocked(S, ptbytes)
def $closure_capture_read(S, IMPLICIT ptbytes z) = S[.RESULT = KNOWN PNULL]
  -- if ~$environment_blocked(S, ptbytes)
def $closure_capture(S, n_object, n_slot, IMPLICIT ptbytes z) = S[.OBJECTS = $object_set(S.OBJECTS, n_object, REALCLOSURE porigin $closure_item_set(pitem*, n_slot, $implicit_item(S, ptbytes)) pstaticcell*)][.RESULT = KNOWN PNULL][.TODO = (CLOSURE_CAPTURE n_object $(n_slot + 1)) :: ptask_tail*]
  -- if S.TODO = (CLOSURE_CAPTURE n_object n_slot) :: ptask_tail*
  -- if ~$environment_blocked(S, ptbytes)
  -- if S.OBJECTS[n_object] = REALCLOSURE porigin pitem* pstaticcell*

def $closure_local(S, ptbytes, UNINITIALIZED) = S_local[.STORE = $set_cell(S_local.STORE, S_local.CELL, UNDEFINED)]
  -- if S_local = $ensure(S, ptbytes)
rule PhpStep/arrow-receive-next: S ~> $closure_local(S, ptbytes, pitem*[n_slot])[.TODO = [CLOSURE_RECEIVE porigin $(n_slot + 1)]][.RESULT = KNOWN PNULL]
  -- if S.TODO = (CLOSURE_RECEIVE porigin n_slot) :: ptask_tail*
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.INSTANCE = (n_object)
  -- if S.OBJECTS[n_object] = REALCLOSURE porigin pitem* pstaticcell*
  -- if $function_at(S.CLOSURETEMPLATES, porigin) = (pfunction)
  -- if plexical* = $closure_lexicals(pfunction.CODE.EXPRESSIONS)
  -- if $(n_slot < |plexical*|)
  -- if plexical*[n_slot] = IMPLICIT ptbytes z

rule PhpStep/arrow-create: S ~> $closure_create(S[.TODO = ptask_tail*], pfunction)
  -- if S.TODO = (EVAL (NExprArrowFunction phpType14 phpType4_static phpType4_ref phpType16 phpType18 expression metadata)) :: ptask_tail*
  -- if S.ORIGIN = (porigin)
  -- if $function_at(S.CLOSURETEMPLATES, porigin) = (pfunction)

dec $arrow_tasks(pfunction, expression, int) : ptask*
def $arrow_tasks(pfunction, expression, z) = [$at_task((PORIGIN n pfunction.BODY), EVAL expression), DISCARD, $typed_fallthrough(pfunction)]
  -- if pfunction.ORIGIN = PORIGIN n pcpath
  -- if "never" <- $ptmasks(pfunction.SIGNATURE.RETURNS)
def $arrow_tasks(pfunction, expression, z) = [$at_task((PORIGIN n pfunction.BODY), EVAL expression), RETURN_VALUE z]
  -- if pfunction.ORIGIN = PORIGIN n pcpath
  -- if ~("never" <- $ptmasks(pfunction.SIGNATURE.RETURNS))
  -- if ~pfunction.SIGNATURE.BYREF
def $arrow_tasks(pfunction, expression, z) = [$at_task((PORIGIN n pfunction.BODY), DIM_PREP expression), RETURN_REF_FETCH z]
  -- if pfunction.ORIGIN = PORIGIN n pcpath
  -- if ~("never" <- $ptmasks(pfunction.SIGNATURE.RETURNS))
  -- if pfunction.SIGNATURE.BYREF
  -- if $call_reference_variable(expression)
def $arrow_tasks(pfunction, expression, z) = [$at_task((PORIGIN n pfunction.BODY), EVAL expression), RETURN_REF_VALUE z]
  -- if pfunction.ORIGIN = PORIGIN n pcpath
  -- if ~("never" <- $ptmasks(pfunction.SIGNATURE.RETURNS))
  -- if pfunction.SIGNATURE.BYREF
  -- if ~$call_reference_variable(expression)
def $closure_body(S, pfunction) = $arrow_tasks(pfunction, expression, z)
  -- if $origin_node(S.SOURCES, pfunction.ORIGIN) = (NExprArrowFunction phpType14 phpType4_static phpType4_ref phpType16 phpType18 expression metadata)
  -- if $arrow_line(pfunction.CODE.EXPRESSIONS, pfunction.BODY) = (z)

;; Source-kind and compiler-projected marker data bind the new return route.
dec $arrow_return(pstate, int) : expression?
def $arrow_return(S, z) = (expression)
  -- if S.CURRENT = (pcallcontext)
  -- if S.ORIGIN = (pcallcontext.FUNCTION)
  -- if $function_at(S.CLOSURETEMPLATES, pcallcontext.FUNCTION) = (pfunction)
  -- if $origin_node(S.SOURCES, pfunction.ORIGIN) = (NExprArrowFunction phpType14 phpType4_static phpType4_ref phpType16 phpType18 expression metadata)
  -- if $arrow_line(pfunction.CODE.EXPRESSIONS, pfunction.BODY) = (z)
  -- if ~("never" <- $ptmasks(pfunction.SIGNATURE.RETURNS))
def $arrow_return(S, z) = eps -- otherwise

def $reference_return_source(S, z) = true
  -- if $reference_returning(S)
