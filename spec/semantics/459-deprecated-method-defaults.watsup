;; Named method history retains scopes and source selection, never a receiver.
dec $parameter_method_parameters(psparam*) : bool
def $parameter_method_parameters(eps) = true
def $parameter_method_parameters(psparam :: psparam_tail*) = (~psparam.BYREF /\ ~psparam.VARIADIC /\ $parameter_method_parameters(psparam_tail*))

dec $parameter_method_source(pstate, pfunction) : pmethoddesc?
def $parameter_method_source(S, pfunction) = (pmethoddesc)
  -- if $class_method_origin(S.CLASSES, pfunction.ORIGIN) = (pmethoddesc)
  -- if pmethoddesc.FUNCTION = pfunction /\ ~pmethoddesc.ABSTRACT
  -- if ~pfunction.SIGNATURE.BYREF /\ ~$function_generator(S, pfunction)
  -- if $parameter_method_parameters(pfunction.SIGNATURE.PARAMETERS)
  -- if $class_at(S.CLASSES, pmethoddesc.OWNER) = (pclassdesc)
  -- if pclassdesc.KIND = "class"
  -- if pmethoddesc.OWNER = PORIGIN n_unit pcpath_owner
  -- if pfunction.ORIGIN = PORIGIN n_unit pcpath_method
  -- if |pcpath_method| = $(|pcpath_owner| + 2)
  -- if pcpath_method[0:|pcpath_owner|] = pcpath_owner
  -- if pcpath_method[|pcpath_owner|:2] = [PCFIELD 5, PCINDEX n_method]
  -- if $origin_node(S.SOURCES, pmethoddesc.OWNER) = (NStmtClass phpType14 (INTEGER int) (NIdentifier (BYTES text) metadata_name) phpType44 phpType42 phpType23 metadata)
def $parameter_method_source(S, pfunction) = eps -- otherwise

dec $parameter_method_call(pstate, porigin) : bool
def $parameter_method_call(S, porigin) = true
  -- if $origin_node(S.SOURCES, porigin) = (NExprMethodCall expression (NIdentifier (BYTES text) metadata_name) (SEQUENCE phpType7*) metadata)
  -- if ~$ppfirstclass(phpType7*)
def $parameter_method_call(S, porigin) = true
  -- if $origin_node(S.SOURCES, porigin) = (NExprStaticCall name (NIdentifier (BYTES text) metadata_name) (SEQUENCE phpType7*) metadata)
  -- if ~$ppfirstclass(phpType7*)
def $parameter_method_call(S, porigin) = false -- otherwise

dec $parameter_method_invocation(pstate, pfunction, pdeclcalls, nat) : bool
def $parameter_method_invocation(S, pfunction, (porigin_function, porigin_site_option?, porigin_owner_option?, porigin_called_option?) :: pdeclcalls, n_prefix) = true
  -- if porigin_function = pfunction.ORIGIN
  -- if porigin_site_option? = (porigin_site)
  -- if porigin_owner_option? = (porigin_owner)
  -- if porigin_called_option? = (porigin_called)
  -- if $parameter_method_source(S, pfunction) = (pmethoddesc)
  -- if pmethoddesc.OWNER = porigin_owner
  -- if $parameter_method_call(S, porigin_site)
  -- if $parameter_callable_function_published(S, pfunction, n_prefix)
  -- if $(n_prefix <= |S.DECLARATIONS|)
  -- if $constant_callable_published(S.DECLARATIONS[0:n_prefix], porigin_called)
  -- if $declaration_invocation(S, pfunction, porigin_site, (porigin_owner), (porigin_called), pdeclcalls)
def $parameter_method_invocation(S, pfunction, pdeclcalls, n_prefix) = false -- otherwise

dec $parameter_receive_method_entry(pstate, preceivebirth) : bool
def $parameter_receive_method_entry(S, preceivebirth) = true
  -- if $class_method_origin(S.CLASSES, preceivebirth.FUNCTION) = (pmethoddesc)
  -- if preceivebirth.CAUSE.CALLS = (preceivebirth.FUNCTION, preceivebirth.CALLSITE, porigin_owner?, porigin_called?) :: pdeclcalls
  -- if porigin_owner? = (pmethoddesc.OWNER) /\ porigin_called? =/= eps
  -- if $parameter_method_invocation(S, pmethoddesc.FUNCTION, preceivebirth.CAUSE.CALLS, preceivebirth.PUBLICATION)
def $parameter_receive_method_entry(S, preceivebirth) = false -- otherwise

dec $parameter_receive_method_dispatch(pstate, preceivebirth) : bool
def $parameter_receive_method_dispatch(S, preceivebirth) = $parameter_receive_method_entry(S, preceivebirth) -- otherwise

def $parameter_receive_deprecated_entry(S, preceivebirth) = true
  -- if $parameter_receive_named_entry(S, preceivebirth)
  -- if $(|preceivebirth.CAUSE.CALLS| > 0)
  -- if preceivebirth.CAUSE.CALLS[0] = (preceivebirth.FUNCTION, preceivebirth.CALLSITE, eps, eps)
def $parameter_receive_deprecated_entry(S, preceivebirth) = $parameter_receive_method_dispatch(S, preceivebirth)
  -- if $class_method_origin(S.CLASSES, preceivebirth.FUNCTION) =/= eps
def $parameter_receive_deprecated_entry(S, preceivebirth) = false -- otherwise

dec $parameter_method_current_valid(pstate, pfunction) : bool
def $parameter_method_current_valid(S, pfunction) = true -- otherwise
dec $parameter_method_current_invocation(pstate, pfunction, pdeclcalls, nat) : bool
def $parameter_method_current_invocation(S, pfunction, pdeclcalls, n) = $parameter_method_invocation(S, pfunction, pdeclcalls, n) -- otherwise
dec $parameter_method_ordinary_current(pstate, pfunction) : bool
def $parameter_method_ordinary_current(S, pfunction) = true -- otherwise
def $parameter_default_recipient(S, pfunction) = true
