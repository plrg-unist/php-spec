def $parameter_default_recipient(S, pfunction) = false -- otherwise

dec $parameter_receive_cache_entry(pstate, preceivebirth) : bool
def $parameter_receive_cache_entry(S, preceivebirth) = $parameter_receive_method_dispatch(S, preceivebirth)
  -- if $class_method_origin(S.CLASSES, preceivebirth.FUNCTION) =/= eps
def $parameter_receive_cache_entry(S, preceivebirth) = false -- otherwise

