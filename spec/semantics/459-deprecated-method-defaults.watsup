  -- if pcallcontext.FUNCTION = pfunction.ORIGIN
  -- if $parameter_method_ordinary_current(S, pfunction)
  -- if $receiving_function(S, pfunction.ORIGIN) = (pfunction)
  -- if pdeclcause = $declaration_cause(S)
  -- if $parameter_method_current_invocation(S, pfunction, pdeclcause.CALLS, |S.DECLARATIONS|)
