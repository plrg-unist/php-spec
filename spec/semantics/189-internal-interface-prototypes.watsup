;; The finite Throwable contract shared by interface linking and inherited
;; Exception/Error implementations. Signatures match zend_exceptions.stub.php.
def $pil_internal_signature(ptbytes) = { PARAMETERS eps, RETURNS ([(PTBRANCH ([PTBUILTIN "string"]))]), BYREF false }
  -- if $ptlc(ptbytes) <- [$ptascii("getmessage"), $ptascii("getfile"), $ptascii("gettraceasstring"), $ptascii("__tostring")]
def $pil_internal_signature(ptbytes) = { PARAMETERS eps, RETURNS ([(PTBRANCH ([PTBUILTIN "int"]))]), BYREF false }
  -- if $ptlc(ptbytes) = $ptascii("getline")
def $pil_internal_signature(ptbytes) = { PARAMETERS eps, RETURNS ([(PTBRANCH ([PTBUILTIN "array"]))]), BYREF false }
  -- if $ptlc(ptbytes) = $ptascii("gettrace")
def $pil_internal_signature(ptbytes) = { PARAMETERS eps, RETURNS ([(PTBRANCH ([PTCLASS $ptascii("Throwable")])), (PTBRANCH ([PTBUILTIN "null"]))]), BYREF false }
  -- if $ptlc(ptbytes) = $ptascii("getprevious")
def $pil_internal_signature(ptbytes) = { PARAMETERS eps, RETURNS eps, BYREF false }
  -- if $ptlc(ptbytes) = $ptascii("getcode")
def $pil_internal_signature(ptbytes) = eps -- otherwise

;; These methods belong to concrete built-in ancestors, not to Throwable's
;; interface method table. The optional defaults are retained for diagnostics.
def $pil_concrete_signature(text_kind, ptbytes) = { PARAMETERS eps, RETURNS ([(PTBRANCH ([PTBUILTIN "int"]))]), BYREF false }
  -- if text_kind = "ErrorException" /\ $ptlc(ptbytes) = $ptascii("getseverity")
def $pil_concrete_signature(text_kind, ptbytes) = { PARAMETERS eps, RETURNS ([(PTBRANCH ([PTBUILTIN "void"]))]), BYREF false }
  -- if $ptlc(ptbytes) = $ptascii("__wakeup")
def $pil_concrete_signature(text_kind, ptbytes) = { PARAMETERS ([{ NAME $ptascii("message"), TYPE ([(PTBRANCH ([PTBUILTIN "string"]))]), BYREF false, VARIADIC false, REQUIRED false, DEFAULT PSDEFAULT (NScalarString (BYTES "") eps) "string" }, { NAME $ptascii("code"), TYPE ([(PTBRANCH ([PTBUILTIN "int"]))]), BYREF false, VARIADIC false, REQUIRED false, DEFAULT PSDEFAULT (NScalarInt (INTEGER 0) eps) "int" }, { NAME $ptascii("severity"), TYPE ([(PTBRANCH ([PTBUILTIN "int"]))]), BYREF false, VARIADIC false, REQUIRED false, DEFAULT PSDEFAULT (NExprConstFetch (NName (BYTES "RV9FUlJPUg==") eps) eps) "deferred" }, { NAME $ptascii("filename"), TYPE ([(PTBRANCH ([PTBUILTIN "string"])), (PTBRANCH ([PTBUILTIN "null"]))]), BYREF false, VARIADIC false, REQUIRED false, DEFAULT PSDEFAULT (NExprConstFetch (NName (BYTES "bnVsbA==") eps) eps) "null" }, { NAME $ptascii("line"), TYPE ([(PTBRANCH ([PTBUILTIN "int"])), (PTBRANCH ([PTBUILTIN "null"]))]), BYREF false, VARIADIC false, REQUIRED false, DEFAULT PSDEFAULT (NExprConstFetch (NName (BYTES "bnVsbA==") eps) eps) "null" }, { NAME $ptascii("previous"), TYPE ([(PTBRANCH ([PTCLASS $ptascii("Throwable")])), (PTBRANCH ([PTBUILTIN "null"]))]), BYREF false, VARIADIC false, REQUIRED false, DEFAULT PSDEFAULT (NExprConstFetch (NName (BYTES "bnVsbA==") eps) eps) "null" }]), RETURNS eps, BYREF false }
  -- if text_kind = "ErrorException" /\ $ptlc(ptbytes) = $ptascii("__construct")
def $pil_concrete_signature(text_kind, ptbytes) = { PARAMETERS ([{ NAME $ptascii("message"), TYPE ([(PTBRANCH ([PTBUILTIN "string"]))]), BYREF false, VARIADIC false, REQUIRED false, DEFAULT PSDEFAULT (NScalarString (BYTES "") eps) "string" }, { NAME $ptascii("code"), TYPE ([(PTBRANCH ([PTBUILTIN "int"]))]), BYREF false, VARIADIC false, REQUIRED false, DEFAULT PSDEFAULT (NScalarInt (INTEGER 0) eps) "int" }, { NAME $ptascii("previous"), TYPE ([(PTBRANCH ([PTCLASS $ptascii("Throwable")])), (PTBRANCH ([PTBUILTIN "null"]))]), BYREF false, VARIADIC false, REQUIRED false, DEFAULT PSDEFAULT (NExprConstFetch (NName (BYTES "bnVsbA==") eps) eps) "null" }]), RETURNS eps, BYREF false }
  -- if text_kind <- ["Exception", "Error"] /\ $ptlc(ptbytes) = $ptascii("__construct")
def $pil_concrete_signature(text_kind, ptbytes) = $pil_internal_signature(ptbytes) -- otherwise

def $pil_concrete_owner(text_kind, ptbytes) = $ptascii("ErrorException")
  -- if text_kind = "ErrorException" /\ $ptlc(ptbytes) <- [$ptascii("getseverity"), $ptascii("__construct")]
def $pil_concrete_owner(text_kind, ptbytes) = $ptascii($throwable_base(text_kind)) -- otherwise

def $pil_internal_name(ptbytes) = $ptascii("getMessage") -- if $ptlc(ptbytes) = $ptascii("getmessage")
def $pil_internal_name(ptbytes) = $ptascii("getCode") -- if $ptlc(ptbytes) = $ptascii("getcode")
def $pil_internal_name(ptbytes) = $ptascii("getFile") -- if $ptlc(ptbytes) = $ptascii("getfile")
def $pil_internal_name(ptbytes) = $ptascii("getLine") -- if $ptlc(ptbytes) = $ptascii("getline")
def $pil_internal_name(ptbytes) = $ptascii("getTrace") -- if $ptlc(ptbytes) = $ptascii("gettrace")
def $pil_internal_name(ptbytes) = $ptascii("getPrevious") -- if $ptlc(ptbytes) = $ptascii("getprevious")
def $pil_internal_name(ptbytes) = $ptascii("getTraceAsString") -- if $ptlc(ptbytes) = $ptascii("gettraceasstring")
def $pil_internal_name(ptbytes) = $ptascii("__toString") -- if $ptlc(ptbytes) = $ptascii("__tostring")
def $pil_internal_name(ptbytes) = $ptascii("getSeverity") -- if $ptlc(ptbytes) = $ptascii("getseverity")
def $pil_internal_name(ptbytes) = $ptascii("__construct") -- if $ptlc(ptbytes) = $ptascii("__construct")
def $pil_internal_name(ptbytes) = $ptascii("__wakeup") -- if $ptlc(ptbytes) = $ptascii("__wakeup")
def $pil_internal_name(ptbytes) = ptbytes -- otherwise

def $pil_internal_method(ptbytes_owner, ptbytes_name, ptbytes_file) = { OWNER ptbytes_owner, NAME $pil_internal_name(ptbytes_name), SIGNATURE pssignature, CONTEXT { NAMESPACE eps, IMPORTS eps, SCOPE PTKNOWN ptbytes_owner eps, POSITION PTRETURN, OWNER ptbytes_owner, MEMBER $pil_internal_name(ptbytes_name), FILE ptbytes_file, LINE 1 } }
  -- if $pil_internal_signature(ptbytes_name) = (pssignature)
def $pil_internal_method(ptbytes_owner, ptbytes_name, ptbytes_file) = eps -- otherwise

def $pil_signature_method(ptbytes_owner, ptbytes_name, ptbytes_file, pssignature) = { OWNER ptbytes_owner, NAME ptbytes_name, SIGNATURE pssignature, CONTEXT { NAMESPACE eps, IMPORTS eps, SCOPE PTKNOWN ptbytes_owner eps, POSITION PTRETURN, OWNER ptbytes_owner, MEMBER ptbytes_name, FILE ptbytes_file, LINE 1 } }

def $pil_internal_scope(ptbytes) = { NAME ptbytes, PARENT eps, ANCESTORS eps, FINAL false }
  -- if $ptlc(ptbytes) = $ptascii("stringable")
def $pil_internal_scope(ptbytes) = { NAME ptbytes, PARENT eps, ANCESTORS ($ptascii("Stringable") :: eps), FINAL false }
  -- if $ptlc(ptbytes) = $ptascii("throwable")
def $pil_internal_scope(ptbytes) = { NAME ptbytes, PARENT eps, ANCESTORS ([$ptascii("Throwable"), $ptascii("Stringable")]), FINAL false }
  -- if $ptlc(ptbytes) <- [$ptascii("exception"), $ptascii("error")]
def $pil_internal_scope(ptbytes) = { NAME ptbytes, PARENT $ptascii("Exception"), ANCESTORS ([$ptascii("Exception"), $ptascii("Throwable"), $ptascii("Stringable")]), FINAL false }
  -- if $ptlc(ptbytes) = $ptascii("errorexception")

def $pil_internal_compare(S, pmmethod_selected, pvclass_selected, pmmethod_proto, pvclass_proto) = $pil_internal_compared(S, pmmethod_selected, pvclass_selected, pmmethod_proto, pvclass_proto, $pmcompare(PMUSER pmmethod_selected, pvclass_selected, PMUSER pmmethod_proto, pvclass_proto, $method_active_registry(S, S.CLASSNAMES)))
def $pil_internal_compared(S, pmmethod_selected, pvclass_selected, pmmethod_proto, pvclass_proto, PMCHECK PVYES ptbytes*) = eps
def $pil_internal_compared(S, pmmethod_selected, pvclass_selected, pmmethod_proto, pvclass_proto, PMCHECK PVNO ptbytes*) = $pmmismatch(pmmethod_selected, pvclass_selected, pmmethod_proto, pvclass_proto, 14)
def $pil_internal_compared(S, pmmethod_selected, pvclass_selected, pmmethod_proto, pvclass_proto, PMCHECK PVUNRESOLVED ptbytes_missing*) = $pmunavailable(pmmethod_selected, pvclass_selected, pmmethod_proto, pvclass_proto, ptbytes_missing*, 14)
def $pil_internal_compared(S, pmmethod_selected, pvclass_selected, pmmethod_proto, pvclass_proto, PMUNSUPPORTED text) = PMDIAGUNSUPPORTED text

def $pil_internal_proto_owner(ptbytes) = $ptascii("Stringable")
  -- if $ptlc(ptbytes) = $ptascii("__tostring")
def $pil_internal_proto_owner(ptbytes) = $ptascii("Throwable") -- otherwise

def $pil_internal_source_one(S, pclassdesc, pmethoddesc) = METHOD_OK
  -- if $pil_internal_signature(pmethoddesc.NAME) = eps
def $pil_internal_source_one(S, pclassdesc, pmethoddesc) = METHOD_FILEISSUE ($ptascii("Cannot make non static method ") ++ ptbytes_owner ++ $ptascii("::") ++ $pil_internal_name(pmethoddesc.NAME) ++ $ptascii("() static in class ") ++ pclassdesc.NAME) pmethoddesc.FUNCTION.LINE pmethoddesc.OWNER
  -- if $pil_internal_signature(pmethoddesc.NAME) = (pssignature)
  -- if pmethoddesc.STATIC
  -- if $pil_internal_proto_owner(pmethoddesc.NAME) = (ptbytes_owner)
def $pil_internal_source_one(S, pclassdesc, pmethoddesc) = METHOD_FILEISSUE ($ptascii("Access level to ") ++ pclassdesc.NAME ++ $ptascii("::") ++ pmethoddesc.NAME ++ $ptascii("() must be public (as in class ") ++ ptbytes_owner ++ [41]) pmethoddesc.FUNCTION.LINE pmethoddesc.OWNER
  -- if $pil_internal_signature(pmethoddesc.NAME) = (pssignature)
  -- if ~pmethoddesc.STATIC
  -- if pmethoddesc.VISIBILITY =/= PROPERTY_PUBLIC
  -- if $pil_internal_proto_owner(pmethoddesc.NAME) = (ptbytes_owner)
def $pil_internal_source_one(S, pclassdesc, pmethoddesc) = $pil_internal_source_result(pmethoddesc, $pil_internal_compare(S, $pmethod_user(pmethoddesc, pclassdesc, ptbytes_file), $pil_scope(S, pclassdesc), pmmethod_proto, $pil_internal_scope(ptbytes_owner)))
  -- if $pil_internal_signature(pmethoddesc.NAME) = (pssignature)
  -- if ~pmethoddesc.STATIC
  -- if pmethoddesc.VISIBILITY = PROPERTY_PUBLIC
  -- if $pil_internal_proto_owner(pmethoddesc.NAME) = (ptbytes_owner)
  -- if $call_sourcefile(S.FILES, pclassdesc.ORIGIN) = (ptbytes_file)
  -- if $pil_internal_method(ptbytes_owner, pmethoddesc.NAME, ptbytes_file) = (pmmethod_proto)
def $pil_internal_source_result(pmethoddesc, eps) = METHOD_OK
def $pil_internal_source_result(pmethoddesc, PMDIAGNOSTIC pmdiagnostic) = METHOD_FILEISSUE pmdiagnostic.MESSAGE pmethoddesc.FUNCTION.LINE pmethoddesc.OWNER
def $pil_internal_source_result(pmethoddesc, PMDIAGUNSUPPORTED text) = METHOD_UNSUPPORTED text
def $pil_internal_source_infos(S, eps) = METHOD_OK
def $pil_internal_source_infos(S, (PPMINHERITED pmethoddesc pclassdesc) :: ppmethodinherited_tail*) = $pil_internal_source_infos(S, ppmethodinherited_tail*)
  -- if $pil_internal_source_one(S, pclassdesc, pmethoddesc) = METHOD_OK
def $pil_internal_source_infos(S, (PPMINHERITED pmethoddesc pclassdesc) :: ppmethodinherited_tail*) = pmethodissue
  -- if $pil_internal_source_one(S, pclassdesc, pmethoddesc) = pmethodissue
  -- if pmethodissue =/= METHOD_OK

def $pil_internal_selected(S, pclassdesc_child, pclassdesc_proto, pmethoddesc_proto, text_kind) = METHOD_OK
  -- if $pil_concrete_signature(text_kind, pmethoddesc_proto.NAME) = eps
def $pil_internal_selected(S, pclassdesc_child, pclassdesc_proto, pmethoddesc_proto, text_kind) = $pil_internal_selected_owner(S, pclassdesc_child, pclassdesc_proto, pmethoddesc_proto, ptbytes_owner, pssignature)
  -- if $pil_concrete_signature(text_kind, pmethoddesc_proto.NAME) = (pssignature)
  -- if $pil_concrete_owner(text_kind, pmethoddesc_proto.NAME) = (ptbytes_owner)
def $pil_internal_selected_owner(S, pclassdesc_child, pclassdesc_proto, pmethoddesc_proto, ptbytes_owner, pssignature) = METHOD_ISSUE ($ptascii("Cannot make static method ") ++ pclassdesc_proto.NAME ++ $ptascii("::") ++ pmethoddesc_proto.NAME ++ $ptascii("() non static in class ") ++ ptbytes_owner) 0
  -- if pmethoddesc_proto.STATIC
def $pil_internal_selected_owner(S, pclassdesc_child, pclassdesc_proto, pmethoddesc_proto, ptbytes_owner, pssignature) = $pil_internal_selected_result($pil_internal_compare(S, pmmethod_selected, $pil_internal_scope(ptbytes_owner), $pmethod_user(pmethoddesc_proto, pclassdesc_proto, ptbytes_file), $pil_scope(S, pclassdesc_proto)))
  -- if ~pmethoddesc_proto.STATIC
  -- if $call_sourcefile(S.FILES, pclassdesc_child.ORIGIN) = (ptbytes_file)
  -- if $pil_signature_method(ptbytes_owner, $pil_internal_name(pmethoddesc_proto.NAME), ptbytes_file, pssignature) = pmmethod_selected
def $pil_internal_selected_result(eps) = METHOD_OK
def $pil_internal_selected_result(PMDIAGNOSTIC pmdiagnostic) = METHOD_ISSUE pmdiagnostic.MESSAGE 0
def $pil_internal_selected_result(PMDIAGUNSUPPORTED text) = METHOD_UNSUPPORTED text

def $pil_internal_later_one(S, pclassdesc_child, PPMINHERITED pmethoddesc_proto pclassdesc_proto, ppmethodinherited_prior*) = METHOD_OK
  -- if $pil_internal_signature(pmethoddesc_proto.NAME) = eps \/ $pil_info_named(ppmethodinherited_prior*, pmethoddesc_proto.NAME)
def $pil_internal_later_one(S, pclassdesc_child, PPMINHERITED pmethoddesc_proto pclassdesc_proto, ppmethodinherited_prior*) = $pil_internal_selected_owner(S, pclassdesc_child, pclassdesc_proto, pmethoddesc_proto, $pil_internal_proto_owner(pmethoddesc_proto.NAME), pssignature)
  -- if $pil_internal_signature(pmethoddesc_proto.NAME) = (pssignature)
  -- if ~$pil_info_named(ppmethodinherited_prior*, pmethoddesc_proto.NAME)
def $pil_internal_later_infos(S, pclassdesc_child, eps, ppmethodinherited_prior*) = METHOD_OK
def $pil_internal_later_infos(S, pclassdesc_child, ppmethodinherited :: ppmethodinherited_tail*, ppmethodinherited_prior*) = $pil_internal_later_infos(S, pclassdesc_child, ppmethodinherited_tail*, ppmethodinherited_prior*)
  -- if $pil_internal_later_one(S, pclassdesc_child, ppmethodinherited, ppmethodinherited_prior*) = METHOD_OK
def $pil_internal_later_infos(S, pclassdesc_child, ppmethodinherited :: ppmethodinherited_tail*, ppmethodinherited_prior*) = pmethodissue
  -- if $pil_internal_later_one(S, pclassdesc_child, ppmethodinherited, ppmethodinherited_prior*) = pmethodissue
  -- if pmethodissue =/= METHOD_OK

;; __wakeup is concrete in each admitted built-in parent, with tentative void.
;; Source ancestors replace that selected contract with their ordinary method.
dec $pil_root_wakeup_issue(text, pclassdesc) : pmethodissue
def $pil_root_wakeup_issue(text_kind, pclassdesc) = METHOD_OK
  -- if $method_named(pclassdesc.METHODS, $ptascii("__wakeup")) = eps
def $pil_root_wakeup_issue(text_kind, pclassdesc) = METHOD_ISSUE ($ptascii("Cannot make non static method ") ++ $pil_concrete_owner(text_kind, pmethoddesc.NAME) ++ $ptascii("::") ++ pmethoddesc.NAME ++ $ptascii("() static in class ") ++ pclassdesc.NAME) pmethoddesc.FUNCTION.LINE
  -- if $method_named(pclassdesc.METHODS, $ptascii("__wakeup")) = (pmethoddesc)
  -- if pmethoddesc.STATIC
def $pil_root_wakeup_issue(text_kind, pclassdesc) = METHOD_ISSUE ($ptascii("Cannot make non abstract method ") ++ $pil_concrete_owner(text_kind, pmethoddesc.NAME) ++ $ptascii("::") ++ pmethoddesc.NAME ++ $ptascii("() abstract in class ") ++ pclassdesc.NAME) pmethoddesc.FUNCTION.LINE
  -- if $method_named(pclassdesc.METHODS, $ptascii("__wakeup")) = (pmethoddesc)
  -- if ~pmethoddesc.STATIC /\ pmethoddesc.ABSTRACT
def $pil_root_wakeup_issue(text_kind, pclassdesc) = METHOD_ISSUE ($ptascii("Access level to ") ++ pclassdesc.NAME ++ $ptascii("::") ++ pmethoddesc.NAME ++ $ptascii("() must be public (as in class ") ++ $pil_concrete_owner(text_kind, pmethoddesc.NAME) ++ [41]) pmethoddesc.FUNCTION.LINE
  -- if $method_named(pclassdesc.METHODS, $ptascii("__wakeup")) = (pmethoddesc)
  -- if ~pmethoddesc.STATIC /\ ~pmethoddesc.ABSTRACT
  -- if pmethoddesc.VISIBILITY =/= PROPERTY_PUBLIC
def $pil_root_wakeup_issue(text_kind, pclassdesc) = METHOD_OK
  -- if $method_named(pclassdesc.METHODS, $ptascii("__wakeup")) = (pmethoddesc)
  -- if ~pmethoddesc.STATIC /\ ~pmethoddesc.ABSTRACT
  -- if pmethoddesc.VISIBILITY = PROPERTY_PUBLIC
  -- if $ppmethod_wakeup_args_valid(pmethoddesc.FUNCTION.SIGNATURE.PARAMETERS)
  -- if $ppmethod_wakeup_return_valid(pmethoddesc.FUNCTION.SIGNATURE.RETURNS)
def $pil_root_wakeup_issue(text_kind, pclassdesc) = METHOD_UNSUPPORTED "invalid compiled __wakeup signature" -- otherwise

;; ErrorException inserts its own final getter before Exception's method table.
dec $pil_root_priority_issue(text, pclassdesc) : pmethodissue
def $pil_root_priority_issue(text_kind, pclassdesc) = METHOD_ISSUE ($ptascii("Cannot override final method ErrorException::") ++ pmethoddesc.NAME ++ $ptascii("()")) pmethoddesc.FUNCTION.LINE
  -- if text_kind = "ErrorException"
  -- if $method_named(pclassdesc.METHODS, $ptascii("__wakeup")) = (pmethoddesc_wakeup)
  -- if $method_named(pclassdesc.METHODS, $ptascii("getseverity")) = (pmethoddesc)
def $pil_root_priority_issue(text_kind, pclassdesc) = METHOD_OK -- otherwise
dec $pil_root_before_wakeup_issue(text, pclassdesc) : pmethodissue
def $pil_root_before_wakeup_issue(text_kind, pclassdesc) = pmethodissue
  -- if $pil_root_priority_issue(text_kind, pclassdesc) = pmethodissue
  -- if pmethodissue =/= METHOD_OK
def $pil_root_before_wakeup_issue(text_kind, pclassdesc) = $pil_root_wakeup_issue(text_kind, pclassdesc)
  -- if $pil_root_priority_issue(text_kind, pclassdesc) = METHOD_OK
def $pil_root_method_issue(text_kind, pclassdesc) = pmethodissue
  -- if $pil_root_before_wakeup_issue(text_kind, pclassdesc) = pmethodissue
  -- if pmethodissue =/= METHOD_OK
def $pil_root_method_issue(text_kind, pclassdesc) = $throwable_final_issue(text_kind, pclassdesc.METHODS)
  -- if $pil_root_before_wakeup_issue(text_kind, pclassdesc) = METHOD_OK

dec $pil_class_infos(ppmethodinherited*) : ppmethodinherited*
def $pil_class_infos(eps) = eps
def $pil_class_infos((PPMINHERITED pmethoddesc pclassdesc) :: ppmethodinherited_tail*) = (PPMINHERITED pmethoddesc pclassdesc) :: $pil_class_infos(ppmethodinherited_tail*)
  -- if pclassdesc.KIND = "class"
def $pil_class_infos((PPMINHERITED pmethoddesc pclassdesc) :: ppmethodinherited_tail*) = $pil_class_infos(ppmethodinherited_tail*)
  -- if pclassdesc.KIND =/= "class"
dec $pil_without_wakeup(ppmethodinherited*) : ppmethodinherited*
def $pil_without_wakeup(eps) = eps
def $pil_without_wakeup((PPMINHERITED pmethoddesc pclassdesc) :: ppmethodinherited_tail*) = $pil_without_wakeup(ppmethodinherited_tail*)
  -- if $ptlc(pmethoddesc.NAME) = $ptascii("__wakeup")
def $pil_without_wakeup((PPMINHERITED pmethoddesc pclassdesc) :: ppmethodinherited_tail*) = (PPMINHERITED pmethoddesc pclassdesc) :: $pil_without_wakeup(ppmethodinherited_tail*)
  -- if $ptlc(pmethoddesc.NAME) =/= $ptascii("__wakeup")
def $pil_layout_extra(S, porigin, ppmethodinherited*, n) = $pil_without_wakeup($pil_info_extra(S, porigin, ppmethodinherited*, n))
  -- if $class_throwable_kind(S, porigin, n) = (text_kind)
  -- if ~$pil_info_named($pil_class_infos(ppmethodinherited*), $ptascii("__wakeup"))
def $pil_layout_extra(S, porigin, ppmethodinherited*, n) = $pil_info_extra(S, porigin, ppmethodinherited*, n) -- otherwise
dec $pil_parent_root_wakeup_issue(pstate, pclassdesc, porigin, text) : pmethodissue
def $pil_parent_root_wakeup_issue(S, pclassdesc, porigin_parent, text_kind) = METHOD_OK
  -- if $pil_info_named($pil_class_infos($method_info_layout(S, porigin_parent, |S.CLASSES|)), $ptascii("__wakeup"))
def $pil_parent_root_wakeup_issue(S, pclassdesc, porigin_parent, text_kind) = $pil_root_before_wakeup_issue(text_kind, pclassdesc)
  -- if ~$pil_info_named($pil_class_infos($method_info_layout(S, porigin_parent, |S.CLASSES|)), $ptascii("__wakeup"))

dec $pil_rooted_after_source(pstate, pclassdesc, porigin, text, pmethodissue) : pmethodissue
dec $pil_rooted_after_wakeup(pstate, pclassdesc, porigin, text, pmethodissue) : pmethodissue
dec $pil_rooted_after_final(pstate, pclassdesc, porigin, pmethodissue) : pmethodissue
def $pil_rooted_method_issue(S, pclassdesc, porigin_parent, text_kind) = $pil_rooted_after_source(S, pclassdesc, porigin_parent, text_kind, $method_override_items(S, pclassdesc, $pil_class_infos($method_info_layout(S, porigin_parent, |S.CLASSES|))))
  -- if $method_named(pclassdesc.METHODS, $ptascii("__wakeup")) = (pmethoddesc)
def $pil_rooted_method_issue(S, pclassdesc, porigin_parent, text_kind) = $pil_rooted_after_final(S, pclassdesc, porigin_parent, $throwable_final_issue(text_kind, pclassdesc.METHODS))
  -- if $method_named(pclassdesc.METHODS, $ptascii("__wakeup")) = eps
def $pil_rooted_after_source(S, pclassdesc, porigin_parent, text_kind, METHOD_OK) = $pil_rooted_after_wakeup(S, pclassdesc, porigin_parent, text_kind, $pil_parent_root_wakeup_issue(S, pclassdesc, porigin_parent, text_kind))
def $pil_rooted_after_source(S, pclassdesc, porigin_parent, text_kind, pmethodissue) = pmethodissue -- otherwise
def $pil_rooted_after_wakeup(S, pclassdesc, porigin_parent, text_kind, METHOD_OK) = $pil_rooted_after_final(S, pclassdesc, porigin_parent, $throwable_final_issue(text_kind, pclassdesc.METHODS))
def $pil_rooted_after_wakeup(S, pclassdesc, porigin_parent, text_kind, pmethodissue) = pmethodissue -- otherwise
def $pil_rooted_after_final(S, pclassdesc, porigin_parent, METHOD_OK) = $method_link_issue(S, pclassdesc, porigin_parent)
def $pil_rooted_after_final(S, pclassdesc, porigin_parent, pmethodissue) = pmethodissue -- otherwise

def $pil_root_wakeup_notice(S, pclassdesc, text_kind) = S_notice[.ORIGIN = S.ORIGIN]
  -- if $pil_root_before_wakeup_issue(text_kind, pclassdesc) = METHOD_OK
  -- if $method_named(pclassdesc.METHODS, $ptascii("__wakeup")) = (pmethoddesc)
  -- if pmethoddesc.FUNCTION.SIGNATURE.RETURNS = eps
  -- if $pmcdisplay($pmdeclaration($pmethod_user(pmethoddesc, pclassdesc, $call_sourcefile(S.FILES, pclassdesc.ORIGIN)), $pil_scope(S, pclassdesc), 14)) = PMTEXT ptbytes_decl
  -- if S_notice = $report_event(S[.ORIGIN = (pmethoddesc.OWNER)], DIAGNOSTIC "Deprecated" ($ptascii("Return type of ") ++ ptbytes_decl ++ $ptascii(" should either be compatible with ") ++ $pil_concrete_owner(text_kind, pmethoddesc.NAME) ++ $ptascii("::__wakeup(): void, or the #[") ++ [92] ++ $ptascii("ReturnTypeWillChange] attribute should be used to temporarily suppress the notice")) pmethoddesc.FUNCTION.LINE, 8192)
