dec $compiled_argument(ppstate, pcpath) : pcodeexpr*
;; Ordered compilation is completed before any recorded work executes. Only
;; compact operand metadata is retained: compiler MEMORY is not runtime state.
dec $code_at(pcode*, nat) : pcode?
def $code_at(eps, n) = eps
def $code_at(pcode :: pcode_tail*, n) = (pcode)
  -- if pcode.UNIT = n
def $code_at(pcode :: pcode_tail*, n) = $code_at(pcode_tail*, n)
  -- if pcode.UNIT =/= n
dec $code_expression(pcodeexpr*, pcpath) : (int, bool)?
def $code_expression((CODEARG pcpath_arg) :: pcodeexpr*, pcpath) = $code_expression(pcodeexpr*, pcpath)
def $code_expression((CODEEFFECT pcpath_effect) :: pcodeexpr*, pcpath) = $code_expression(pcodeexpr*, pcpath)
def $code_expression((CODEWRITE pcpath_write z) :: pcodeexpr*, pcpath) = $code_expression(pcodeexpr*, pcpath)
def $code_expression(eps, pcpath) = eps
def $code_expression((CODEEXPR pcpath z b) :: pcodeexpr*, pcpath) = ((z, b))
def $code_expression((CODEEXPR pcpath_other z b) :: pcodeexpr*, pcpath) = $code_expression(pcodeexpr*, pcpath)
  -- if pcpath_other =/= pcpath

dec $constant_runtime_line(pstate, int) : int
def $runtime_line(S, pcpath, expression) = $constant_runtime_line(S, z)
  -- if S.ORIGIN = (PORIGIN n pcpath_parent)
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_expression(pcode.EXPRESSIONS, pcpath_parent ++ pcpath) = ((z, b))
def $runtime_line(S, pcpath, expression) = $constant_runtime_line(S, 0)
  -- if S.ORIGIN = (PORIGIN n pcpath_parent)
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_expression(pcode.EXPRESSIONS, pcpath_parent ++ pcpath) = eps
;; Uncompiled internal task fixtures carry direct source locations only.
def $runtime_line(S, pcpath, expression) = $constant_runtime_line(S, $expression_line(expression))
  -- otherwise

dec $compiled_read(pstate, porigin) : pvalue?
def $compiled_read(S, PORIGIN n pcpath) = $pool_value(S.POOLS, PORIGIN n pcpath)
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_expression(pcode.EXPRESSIONS, pcpath) = ((z, true))
def $compiled_read(S, porigin) = eps
  -- otherwise



dec $compiled_writes((pcpath, nat)*) : pcodeexpr*
def $compiled_writes(eps) = eps
def $compiled_writes((pcpath, n) :: (pcpath_tail, n_tail)*) = (CODEWRITE pcpath n) :: $compiled_writes((pcpath_tail, n_tail)*)
dec $code_write(pcodeexpr*, pcpath) : int?
def $code_write(eps, pcpath) = eps
def $code_write((CODEWRITE pcpath z) :: pcodeexpr*, pcpath) = (z)
def $code_write((CODEWRITE pcpath_other z) :: pcodeexpr*, pcpath) = $code_write(pcodeexpr*, pcpath)
  -- if pcpath_other =/= pcpath
def $code_write((CODEEXPR pcpath_other z b) :: pcodeexpr*, pcpath) = $code_write(pcodeexpr*, pcpath)
def $code_write((CODEARG pcpath_arg) :: pcodeexpr*, pcpath) = $code_write(pcodeexpr*, pcpath)
def $code_write((CODEEFFECT pcpath_other) :: pcodeexpr*, pcpath) = $code_write(pcodeexpr*, pcpath)
dec $runtime_write_line(pstate, pcpath) : int
def $runtime_write_line(S, pcpath) = z
  -- if S.ORIGIN = (PORIGIN n pcpath_parent)
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_write(pcode.EXPRESSIONS, pcpath_parent ++ pcpath) = (z)
def $runtime_write_line(S, pcpath) = 0 -- otherwise


;; Constant variable names are converted while compiling. Preserve the original
;; pool operand; normalize only a captured name at that compiled occurrence.
dec $compiled_name_bytes(pvalue) : nat*
dec $compiled_name_bytes_at(pvalue, int) : nat*
def $compiled_name_bytes(pvalue) = $compiled_name_bytes_at(pvalue, 14)
def $compiled_name_bytes_at(PARRAY n, z_precision) = [65,114,114,97,121]
def $compiled_name_bytes_at(PFLOAT n_bits, z_precision) = n_text*
  -- if (n_text*, b_warning) = $number_text(NFLOAT n_bits, z_precision)
def $compiled_name_bytes_at(pvalue, z_precision) = $echo_value(pvalue)
  -- if ~$is_array_value(pvalue)
  -- if $type_bytes(pvalue) =/= $ptascii("float")
dec $captured_name(pstate, pcpath, poperand) : poperand
def $captured_name(S, pcpath, KNOWN pvalue) = KNOWN (PSTRING $compiled_name_bytes_at(pvalue, z_precision))
  -- if $origin_child(S.ORIGIN, pcpath) = (porigin)
  -- if $compiled_read(S, porigin) = (pvalue_original)
  -- if $source_precision(S, (porigin)) = (z_precision)
def $captured_name(S, pcpath, poperand) = poperand
  -- otherwise

;; Known operand kind does not erase earlier emitted assignments. Effects name
;; original occurrences; replay excludes a nested root already covered by an
;; ancestor, while preserving the compiler's ordering of independent roots.
dec $effect_below(pcpath, pcpath) : bool
def $effect_below(pcpath_parent, pcpath_child) = (pcpath_child[0:|pcpath_parent|] = pcpath_parent)
  -- if $(|pcpath_parent| <= |pcpath_child|)
def $effect_below(pcpath_parent, pcpath_child) = false
  -- if $(|pcpath_parent| > |pcpath_child|)
dec $effect_ancestor(pcodeexpr*, pcpath, pcpath) : bool
def $effect_ancestor(eps, pcpath_parent, pcpath_child) = false
def $effect_ancestor((CODEEFFECT pcpath) :: pcodeexpr*, pcpath_parent, pcpath_child) = true
  -- if $effect_below(pcpath_parent, pcpath)
  -- if $effect_below(pcpath, pcpath_child)
  -- if pcpath =/= pcpath_child
def $effect_ancestor((CODEEXPR pcpath z b) :: pcodeexpr*, pcpath_parent, pcpath_child) = $effect_ancestor(pcodeexpr*, pcpath_parent, pcpath_child)
def $effect_ancestor((CODEARG pcpath) :: pcodeexpr*, pcpath_parent, pcpath_child) = $effect_ancestor(pcodeexpr*, pcpath_parent, pcpath_child)
def $effect_ancestor((CODEWRITE pcpath z) :: pcodeexpr*, pcpath_parent, pcpath_child) = $effect_ancestor(pcodeexpr*, pcpath_parent, pcpath_child)
def $effect_ancestor((CODEEFFECT pcpath) :: pcodeexpr*, pcpath_parent, pcpath_child) = $effect_ancestor(pcodeexpr*, pcpath_parent, pcpath_child)
  -- if ~($effect_below(pcpath_parent, pcpath) /\ $effect_below(pcpath, pcpath_child) /\ pcpath =/= pcpath_child)
dec $effect_select(pcodeexpr*, pcodeexpr*, pcpath) : pcodeexpr*
def $effect_select(eps, pcodeexpr_all*, pcpath_parent) = eps
def $effect_select((CODEEFFECT pcpath) :: pcodeexpr*, pcodeexpr_all*, pcpath_parent) = (CODEEFFECT pcpath) :: $effect_select(pcodeexpr*, pcodeexpr_all*, pcpath_parent)
  -- if $effect_below(pcpath_parent, pcpath)
  -- if ~$effect_ancestor(pcodeexpr_all*, pcpath_parent, pcpath)
def $effect_select((CODEEXPR pcpath z b) :: pcodeexpr*, pcodeexpr_all*, pcpath_parent) = $effect_select(pcodeexpr*, pcodeexpr_all*, pcpath_parent)
def $effect_select((CODEARG pcpath) :: pcodeexpr*, pcodeexpr_all*, pcpath_parent) = $effect_select(pcodeexpr*, pcodeexpr_all*, pcpath_parent)
def $effect_select((CODEWRITE pcpath z) :: pcodeexpr*, pcodeexpr_all*, pcpath_parent) = $effect_select(pcodeexpr*, pcodeexpr_all*, pcpath_parent)
def $effect_select((CODEEFFECT pcpath) :: pcodeexpr*, pcodeexpr_all*, pcpath_parent) = $effect_select(pcodeexpr*, pcodeexpr_all*, pcpath_parent)
  -- if ~($effect_below(pcpath_parent, pcpath) /\ ~$effect_ancestor(pcodeexpr_all*, pcpath_parent, pcpath))
dec $effect_unique(pcodeexpr*, pcodeexpr*) : pcodeexpr*
def $effect_unique(eps, pcodeexpr_seen*) = eps
def $effect_unique(pcodeexpr :: pcodeexpr_tail*, pcodeexpr_seen*) = pcodeexpr :: $effect_unique(pcodeexpr_tail*, pcodeexpr :: pcodeexpr_seen*)
  -- if ~(pcodeexpr <- pcodeexpr_seen*)
def $effect_unique(pcodeexpr :: pcodeexpr_tail*, pcodeexpr_seen*) = $effect_unique(pcodeexpr_tail*, pcodeexpr_seen*)
  -- if pcodeexpr <- pcodeexpr_seen*
dec $compiled_effects(pstate, porigin) : pcodeexpr*
def $compiled_effects(S, PORIGIN n pcpath) = $effect_unique($effect_select(pcode.EXPRESSIONS, pcode.EXPRESSIONS, pcpath), eps)
  -- if $code_at(S.CODE, n) = (pcode)
def $compiled_effects(S, porigin) = eps -- otherwise
dec $effect_tasks(pstate, nat, pcodeexpr*) : ptask*
def $effect_tasks(S, n, eps) = eps
def $effect_tasks(S, n, (CODEEFFECT pcpath) :: pcodeexpr*) = [AT (PORIGIN n pcpath) EVAL_EFFECT, DISCARD] ++ $effect_tasks(S, n, pcodeexpr*)

dec $effect_expression(pstate, porigin) : expression?
def $effect_expression(S, porigin) = (expression)
  -- if $origin_node(S.SOURCES, porigin) = (expression)
def $effect_expression(S, porigin) = eps -- otherwise
dec $effect_outside(pcodeexpr*, pcpath) : pcodeexpr*
def $effect_outside(eps, pcpath_target) = eps
def $effect_outside((CODEEFFECT pcpath) :: pcodeexpr*, pcpath_target) = $effect_outside(pcodeexpr*, pcpath_target)
  -- if $effect_below(pcpath_target, pcpath)
def $effect_outside((CODEEFFECT pcpath) :: pcodeexpr*, pcpath_target) = (CODEEFFECT pcpath) :: $effect_outside(pcodeexpr*, pcpath_target)
  -- if ~$effect_below(pcpath_target, pcpath)
dec $redirect_effect_tasks(pstate, porigin, porigin) : ptask*
def $redirect_effect_tasks(S, PORIGIN n pcpath, PORIGIN n pcpath_target) = $effect_tasks(S, n, $effect_outside($compiled_effects(S, PORIGIN n pcpath), pcpath_target))

dec $code_name(pcodename*, pcpath) : (nat*, (nat*)?)?
def $code_name(eps, pcpath) = eps
def $code_name((CODENAME pcpath n_name* n_fallback*?) :: pcodename*, pcpath) = ((n_name*, n_fallback*?))
def $code_name((CODENAME pcpath_other n_name* n_fallback*?) :: pcodename*, pcpath) = $code_name(pcodename*, pcpath)
  -- if pcpath_other =/= pcpath

dec $source_constant_fetch(pstate, nat*, (nat*)?, int) : peval
dec $deprecated_constant_selected(pstate, porigin) : bool
dec $deprecated_constant_start(pstate, porigin, ptask*) : pstate
dec $compiled_name(pstate, porigin) : peval?
def $compiled_name(S, PORIGIN n pcpath) = ($source_constant_fetch(S, n_name*, n_fallback*?, $constant_runtime_line(S, z)))
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (NExprConstFetch name metadata)
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_name(pcode.NAMES, pcpath) = ((n_name*, n_fallback*?))
  -- if $code_expression(pcode.EXPRESSIONS, pcpath) = ((z, b))
def $compiled_name(S, porigin) = eps
  -- otherwise

dec $code_redirect(pcoderedirect*, pcpath) : (pcpath, bool)?
def $code_redirect(eps, pcpath) = eps
def $code_redirect((CODEREDIRECT pcpath pcpath_target b) :: pcoderedirect*, pcpath) = ((pcpath_target, b))
def $code_redirect((CODEREDIRECT pcpath_other pcpath_target b) :: pcoderedirect*, pcpath) = $code_redirect(pcoderedirect*, pcpath)
  -- if pcpath_other =/= pcpath
dec $compiled_redirect(pstate, porigin) : (porigin, expression, bool, int)?
def $compiled_redirect(S, PORIGIN n pcpath) = ((PORIGIN n pcpath_target, expression, b, z))
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_redirect(pcode.REDIRECTS, pcpath) = ((pcpath_target, b))
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath_target) = (expression)
  -- if $code_expression(pcode.EXPRESSIONS, pcpath) = ((z, b_constant))
def $compiled_redirect(S, porigin) = eps
  -- otherwise
dec $copy_redirect_child(pstate, porigin, porigin) : bool
def $copy_redirect_child(S, PORIGIN n pcpath, PORIGIN n pcpath_target) = true
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (NExprTernary expression_cond phpType5 expression_false metadata)
  -- if pcpath_target = pcpath ++ [PCFIELD 1] \/ pcpath_target = pcpath ++ [PCFIELD 2]
def $copy_redirect_child(S, PORIGIN n pcpath, PORIGIN n pcpath_target) = true
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (NExprBinaryOpCoalesce expression_left expression_right metadata)
  -- if pcpath_target = pcpath ++ [PCFIELD 1]
def $copy_redirect_child(S, porigin, porigin_target) = false -- otherwise
dec $compiled_copy_redirect(pstate, porigin) : int?
def $compiled_copy_redirect(S, porigin) = ($runtime_line(S[.ORIGIN = (porigin_target)], eps, expression_target))
  -- if $compiled_redirect(S, porigin) = ((porigin_target, expression_target, false, z))
  -- if $copy_redirect_child(S, porigin, porigin_target)
def $compiled_copy_redirect(S, porigin) = eps -- otherwise
dec $redirect_tasks(porigin, expression, bool, bool, int) : ptask*
def $redirect_tasks(porigin, expression, false, false, z) = [AT porigin (EVAL expression)]
def $redirect_tasks(porigin, expression, false, true, z) = [AT porigin (DIM_PREP expression)]
def $redirect_tasks(porigin, expression, true, false, z) = [AT porigin (EVAL expression), TRUTH_RESULT false z]
def $redirect_tasks(porigin, expression, true, true, z) = [AT porigin (EVAL expression), TRUTH_RESULT false z, DIM_CAPTURE]

;; A folded BOOL still consumes its operand at the original expression. Retain
;; that origin through conversion, then restore the enclosing consumer.
def $enter_compiled_task(S, porigin, EVAL expression, ptask*) = S[.TODO = $redirect_effect_tasks(S, porigin, porigin_target) ++ $redirect_tasks(porigin_target, expression_target, true, false, z) ++ [ORIGIN_RETURN S.ORIGIN] ++ ptask*][.ORIGIN = (porigin)]
  -- if $compiled_read(S, porigin) = eps
  -- if $compiled_redirect(S, porigin) = ((porigin_target, expression_target, true, z))
def $enter_compiled_task(S, porigin, DIM_PREP expression, ptask*) = S[.TODO = $redirect_effect_tasks(S, porigin, porigin_target) ++ $redirect_tasks(porigin_target, expression_target, true, true, z) ++ [ORIGIN_RETURN S.ORIGIN] ++ ptask*][.ORIGIN = (porigin)]
  -- if $compiled_read(S, porigin) = eps
  -- if $compiled_redirect(S, porigin) = ((porigin_target, expression_target, true, z))
;; A selected conditional/coalesce arm still has Zend's QM_ASSIGN boundary.
def $enter_compiled_task(S, porigin, EVAL expression, ptask*) = S[.TODO = $redirect_effect_tasks(S, porigin, porigin_target) ++ [AT porigin_target (EVAL expression_target), VALUE_COPY z_copy, ORIGIN_RETURN S.ORIGIN] ++ ptask*][.ORIGIN = (porigin)]
  -- if $compiled_read(S, porigin) = eps
  -- if $compiled_redirect(S, porigin) = ((porigin_target, expression_target, false, z))
  -- if $compiled_copy_redirect(S, porigin) = (z_copy)
def $enter_compiled_task(S, porigin, EVAL expression, ptask*) = S[.TODO = $redirect_effect_tasks(S, porigin, porigin_target) ++ $redirect_tasks(porigin_target, expression_target, false, false, z) ++ ptask*]
  -- if $compiled_read(S, porigin) = eps
  -- if $compiled_redirect(S, porigin) = ((porigin_target, expression_target, false, z))
  -- if $compiled_copy_redirect(S, porigin) = eps
def $enter_compiled_task(S, porigin, DIM_PREP expression, ptask*) = S[.TODO = $redirect_effect_tasks(S, porigin, porigin_target) ++ $redirect_tasks(porigin_target, expression_target, false, true, z) ++ ptask*]
  -- if $compiled_read(S, porigin) = eps
  -- if $compiled_redirect(S, porigin) = ((porigin_target, expression_target, false, z))

def $enter_compiled_task(S, porigin, EVAL expression, ptask*) = S[.TODO = ptask*][.RESULT = KNOWN pvalue]
  -- if $compiled_read(S, porigin) = (pvalue)
  -- if $compiled_effects(S, porigin) = eps
def $enter_compiled_task(S, porigin, DIM_PREP expression, ptask*) = S[.TODO = ptask*][.BASE = BASE_VALUE (KNOWN pvalue)][.RESULT = KNOWN PNULL]
  -- if $compiled_read(S, porigin) = (pvalue)
  -- if $compiled_effects(S, porigin) = eps
def $enter_compiled_task(S, porigin, EVAL (NExprConstFetch name metadata), ptask*) = S[.TODO = ptask*][.RESULT = KNOWN pvalue]
  -- if $compiled_read(S, porigin) = eps
  -- if $compiled_name(S, porigin) = (VALUE pvalue)
def $enter_compiled_task(S, porigin, EVAL (NExprConstFetch name metadata), ptask*) = S[.TODO = eps][.COMPLETION = pcompletion]
  -- if $compiled_read(S, porigin) = eps
  -- if ~$deprecated_constant_selected(S, porigin)
  -- if $compiled_name(S, porigin) = (ABRUPT pcompletion)
def $enter_compiled_task(S, porigin, EVAL (NExprConstFetch name metadata), ptask*) = $deprecated_constant_start(S, porigin, ptask*)
  -- if $compiled_read(S, porigin) = eps
  -- if $deprecated_constant_selected(S, porigin)
def $enter_compiled_task(S, PORIGIN n pcpath, EVAL expression, ptask*) = S[.TODO = $effect_tasks(S, n, pcodeexpr*) ++ [AT (PORIGIN n pcpath) (COMPILED_RESULT false)] ++ ptask*]
  -- if $compiled_read(S, PORIGIN n pcpath) = (pvalue)
  -- if pcodeexpr* = $compiled_effects(S, PORIGIN n pcpath)
  -- if pcodeexpr* =/= eps
def $enter_compiled_task(S, PORIGIN n pcpath, DIM_PREP expression, ptask*) = S[.TODO = $effect_tasks(S, n, pcodeexpr*) ++ [AT (PORIGIN n pcpath) (COMPILED_RESULT true)] ++ ptask*]
  -- if $compiled_read(S, PORIGIN n pcpath) = (pvalue)
  -- if pcodeexpr* = $compiled_effects(S, PORIGIN n pcpath)
  -- if pcodeexpr* =/= eps
;; This one occurrence bypasses the constant shortcut. Its original children
;; retain their ordinary occurrence-bound descriptors and pooled reads.
def $enter_compiled_task(S, porigin, EVAL_EFFECT, ptask*) = S[.TODO = [EVAL expression, ORIGIN_RETURN S.ORIGIN] ++ ptask*][.ORIGIN = (porigin)]
  -- if $effect_expression(S, porigin) = (expression)
def $enter_compiled_task(S, porigin, EVAL_EFFECT, ptask*) = S[.TODO = eps][.COMPLETION = UNSUPPORTED "invalid compiled effect occurrence"]
  -- if $effect_expression(S, porigin) = eps
def $enter_compiled_task(S, porigin, COMPILED_RESULT b, ptask*) = S[.TODO = eps][.COMPLETION = UNSUPPORTED "invalid compiled result"]
  -- if $compiled_read(S, porigin) = eps
def $enter_compiled_task(S, porigin, COMPILED_RESULT false, ptask*) = S[.TODO = ptask*][.RESULT = KNOWN pvalue]
  -- if $compiled_read(S, porigin) = (pvalue)
def $enter_compiled_task(S, porigin, COMPILED_RESULT true, ptask*) = S[.TODO = ptask*][.BASE = BASE_VALUE (KNOWN pvalue)][.RESULT = KNOWN PNULL]
  -- if $compiled_read(S, porigin) = (pvalue)

def $enter_compiled_task(S, porigin, ptask, ptask_tail*) = S[.TODO = [ptask, ORIGIN_RETURN S.ORIGIN] ++ ptask_tail*][.ORIGIN = (porigin)]
  -- otherwise

dec $compiled_operands(ppstate, ppexprdone*) : pcodeexpr*
dec $compiled_gotos(ppgotoref*, ppgotolabel*) : pcodeexpr*
def $compiled_operands(P, eps) = eps
def $compiled_operands(P, (PPCEFFECT pcpath) :: ppexprdone*) = (CODEEFFECT pcpath) :: $compiled_operands(P, ppexprdone*)
def $compiled_operands(P, (PPCEXPR pcpath n pvalue?) :: ppexprdone*) = $compiled_argument(P, pcpath) ++ [(CODEEXPR pcpath n ($ppaccess(P, pcpath) = (PPR) /\ pvalue? =/= eps))] ++ $compiled_operands(P, ppexprdone*)
dec $compiled_names((pcpath, pnreference)*) : pcodename*
def $compiled_names(eps) = eps
def $compiled_names((pcpath, pnreference) :: (pcpath_tail, pnreference_tail)*) = (CODENAME pcpath pnreference.RESOLVED pnreference.FALLBACK) :: $compiled_names((pcpath_tail, pnreference_tail)*)
dec $compiled_redirects((pcpath, pcpath, bool)*) : pcoderedirect*
def $compiled_redirects(eps) = eps
def $compiled_redirects((pcpath_parent, pcpath_target, b) :: (pcpath_parent_tail, pcpath_target_tail, b_tail)*) = (CODEREDIRECT pcpath_parent pcpath_target b) :: $compiled_redirects((pcpath_parent_tail, pcpath_target_tail, b_tail)*)
dec $compiled_work(nat, ppwork*) : ptask*
def $compiled_work(n, eps) = eps
def $compiled_work(n, (PPCWORK pcpath statement plenv n_line) :: ppwork*) = (AT (PORIGIN n pcpath) (STMT statement)) :: $compiled_work(n, ppwork*)
dec $export_constants((pcpath, pvalue)*) : pconstant*
def $export_constants(eps) = eps
def $export_constants((pcpath, pvalue) :: (pcpath_tail, pvalue_tail)*) = (PCONSTANT pcpath pvalue) :: $export_constants((pcpath_tail, pvalue_tail)*)

dec $export_classes((pcpath, pvalueclass)*) : pconstant*
def $export_classes(eps) = eps
def $export_classes((pcpath, pvalueclass) :: (pcpath_tail, pvalueclass_tail)*) = (PCCLASS pcpath pvalueclass) :: $export_classes((pcpath_tail, pvalueclass_tail)*)

dec $compiler_diagnostics(pstate, pldiagnostic*) : pstate
dec $compiled_error_origin(porigin?, pcompletion, nat) : porigin?
def $compiled_error_origin(porigin?, STATICBYTES n_message* z, n) = (PORIGIN n eps)
  -- if $(n > 0)
def $compiled_error_origin(porigin?, COMPILETHROWN n_message* z, n) = (PORIGIN n eps)
  -- if $(n > 0)
def $compiled_error_origin(porigin?, STATICERROR text z, n) = (PORIGIN n eps)
  -- if $(n > 0)
def $compiled_error_origin(porigin?, FATAL n_message* z, n) = (PORIGIN n eps)
  -- if $(n > 0)
def $compiled_error_origin(porigin?, pcompletion, n) = porigin? -- otherwise
dec $compiler_event(text, nat*, pllocation) : pevent
def $compiler_event(text, n_message*, pllocation) = DIAGNOSTIC_SOURCE pllocation.UNIT text n_message* pllocation.LINE
  -- if $(pllocation.UNIT > 0)
def $compiler_event(text, n_message*, pllocation) = DIAGNOSTIC text n_message* pllocation.LINE
  -- if pllocation.UNIT = 0
def $compiler_diagnostics(S, pldiagnostic*) = S
  -- if S.COMPLETION =/= NORMAL
def $compiler_diagnostics(S, eps) = S
  -- if S.COMPLETION = NORMAL
def $compiler_diagnostics(S, (PLDIAGNOSTIC "warning" text ptbytes* pllocation) :: pldiagnostic*) = $compiler_diagnostics($report_event(S, $compiler_event("Warning", $plmessage(PLDIAGNOSTIC "warning" text ptbytes* pllocation), pllocation), 2), pldiagnostic*)
  -- if S.COMPLETION = NORMAL
def $compiler_diagnostics(S, (PLDIAGNOSTIC "deprecated" text ptbytes* pllocation) :: pldiagnostic*) = $compiler_diagnostics($report_event(S, $compiler_event("Deprecated", $plmessage(PLDIAGNOSTIC "deprecated" text ptbytes* pllocation), pllocation), 8192), pldiagnostic*)
  -- if S.COMPLETION = NORMAL
def $compiler_diagnostics(S, (PLDIAGNOSTIC "fatal" text ptbytes* pllocation) :: pldiagnostic*) = S[.COMPLETION = STATICBYTES $plmessage(PLDIAGNOSTIC "fatal" text ptbytes* pllocation) pllocation.LINE][.ERRORORIGIN = $compiled_error_origin(S.ERRORORIGIN, STATICBYTES eps pllocation.LINE, pllocation.UNIT)]
  -- if S.COMPLETION = NORMAL

dec $request_compile(pstate, ppstate) : pstate
dec $compile_source_ready(pstate, ppstate) : pstate
dec $declaration_compile(pstate, ppstate) : pstate
dec $declaration_enter(pstate, nat, porigin?) : pstate
dec $declaration_exit(pstate, nat, pcompilestop) : pstate
dec $declaration_preflight(pcoccurrence*) : pcompletion?
dec $declaration_parser_rejects(pcompletion?) : bool
dec $declaration_compile_preflight(pstate, ppstate, pcompletion?) : pstate
dec $compile_source(pstate, ppstate) : pstate
dec $compile_source_begin(pstate, ppstate) : pstate
dec $compile_source_precision(pstate, ppstate) : ppstate
def $compile_source(S, P) = $scope_check($compile_source_begin($request_compile(S, P_source), P_source))
  -- if P_source = $compile_source_precision(S, P)
def $compile_source_begin(S, P) = $compile_source_ready($declaration_enter(S, P.FOLD.SOURCE.ID, eps), P)
  -- if S.COMPLETION = NORMAL
def $compile_source_begin(S, P) = S -- if S.COMPLETION =/= NORMAL
def $compile_source_ready(S, P) = $declaration_compile_preflight(S, P, $declaration_preflight(P.FOLD.SOURCE.OCCURRENCES))

;; Deferred fetch descriptors follow actual ordinary compiler access, including
;; variable/dimension ancestors. Name and key expressions retain read access.
def $compiled_argument(P, pcpath) = [CODEARG pcpath]
  -- if $ppaccess(P, pcpath) = (PPF)
def $compiled_argument(P, pcpath) = eps -- otherwise
