;; Fake static Fiber closures have no bound receiver. INPUT records only the
;; original object-style capture; NAME freezes a dynamic method selection.
dec $fiber_capture_source_valid(pstate, pfibercapture) : bool
dec $fiber_capture_live(pstate, nat) : bool
dec $fiber_capture_new(pstate, pintrinsic, ptbytes, nat?) : pstate
def $fiber_static_name(ptbytes) = $fiber_static(pintrinsic)
  -- if $fiber_method(ptbytes) = (pintrinsic)
def $fiber_static_name(ptbytes) = false -- otherwise
dec $fiber_capture_input_before(nat?, nat) : bool
def $fiber_capture_input_before(eps, n) = true
def $fiber_capture_input_before((n_input), n) = $(n_input < n)
def $fiber_capture_source_valid(S, pfibercapture) = true
  -- if $fiber_static(pfibercapture.KIND)
  -- if $fiber_method(pfibercapture.NAME) = (pfibercapture.KIND)
  -- if pfibercapture.INPUT = eps
  -- if $origin_node(S.SOURCES, pfibercapture.SITE) = (NExprStaticCall phpType19 phpType20 (SEQUENCE phpType7*) metadata)
  -- if $fiber_static_class(S, pfibercapture.SITE, phpType19)
  -- if $method_source_name(phpType20, $ptlc(pfibercapture.NAME))
  -- if $ppfirstclass(phpType7*)
def $fiber_capture_source_valid(S, pfibercapture) = true
  -- if $fiber_static(pfibercapture.KIND)
  -- if $fiber_method(pfibercapture.NAME) = (pfibercapture.KIND)
  -- if pfibercapture.INPUT = (n)
  -- if $(n < |S.OBJECTS|)
  -- if S.OBJECTS[n] = FIBER pfiber
  -- if $origin_node(S.SOURCES, pfibercapture.SITE) = (NExprMethodCall expression phpType20 (SEQUENCE phpType7*) metadata)
  -- if $method_source_name(phpType20, $ptlc(pfibercapture.NAME))
  -- if $ppfirstclass(phpType7*)
def $fiber_capture_source_valid(S, pfibercapture) = false -- otherwise
def $fiber_capture_live(S, n) = true
  -- if $(n < |S.OBJECTS|)
  -- if (HOBJECT n) <- S.ALLOCATIONS
  -- if S.OBJECTS[n] = FIBERAPICLOSURE pfibercapture
  -- if $fiber_capture_source_valid(S, pfibercapture)
  -- if $fiber_capture_input_before(pfibercapture.INPUT, n)
  -- if $closure_scope_at(S.CLOSURESCOPES, n) = eps
  -- if $closure_binding_at(S.CLOSUREBINDINGS, n) = eps
def $fiber_capture_live(S, n) = false -- otherwise
def $fiber_capture_new(S, pintrinsic, ptbytes, n_input?) = S[.OBJECTS = S.OBJECTS ++ [FIBERAPICLOSURE pfibercapture]][.ALLOCATIONS = S.ALLOCATIONS ++ [HOBJECT n]][.TODO = ptask_tail*][.RESULT = KNOWN (POBJECT n)][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.ORIGIN = (porigin)
  -- if S.TODO = ptask :: ptask_tail*
  -- if n = |S.OBJECTS|
  -- if pfibercapture = {SITE porigin, KIND pintrinsic, NAME ptbytes, INPUT n_input?}
  -- if $fiber_capture_source_valid(S, pfibercapture)
def $method_select(S, poperand, ptbytes, phpType7*, z) = $fiber_capture_new(S_read, pintrinsic, ptbytes, (n))
  -- if S_read = $resolve_at(S, poperand, z)
  -- if S_read.COMPLETION = NORMAL
  -- if S_read.RESULT = KNOWN (POBJECT n)
  -- if $fiber_at(S_read, n) =/= eps
  -- if $fiber_method(ptbytes) = (pintrinsic)
  -- if $fiber_static(pintrinsic) /\ $ppfirstclass(phpType7*)
def $scoped_select(S, phpType19, KNOWN (PSTRING ptbytes_class), ptbytes, phpType7*, z) = $fiber_capture_new(S, pintrinsic, ptbytes, eps)
  -- if $ptlc($typed_callable_name(ptbytes_class)) = $ptascii("fiber")
  -- if $fiber_method(ptbytes) = (pintrinsic)
  -- if $fiber_static(pintrinsic) /\ $ppfirstclass(phpType7*)

def $node_children(S, HOBJECT n) = eps -- if S.OBJECTS[n] = FIBERAPICLOSURE pfibercapture
def $closure_callable(S, n) = $fiber_capture_live(S, n) -- if S.OBJECTS[n] = FIBERAPICLOSURE pfibercapture
def $closure_live_object_valid(S, n) = $fiber_capture_live(S, n) -- if S.OBJECTS[n] = FIBERAPICLOSURE pfibercapture
def $closure_scope_complete(S, (HOBJECT n) :: pnode_tail*) = $closure_scope_complete(S, pnode_tail*)
  -- if S.OBJECTS[n] = FIBERAPICLOSURE pfibercapture
  -- if $fiber_capture_live(S, n)
def $property_live_complete(S, (HOBJECT n) :: pnode_tail*) = $property_live_complete(S, pnode_tail*)
  -- if S.OBJECTS[n] = FIBERAPICLOSURE pfibercapture
def $getclass_live_object(S, n) = $fiber_capture_live(S, n) -- if S.OBJECTS[n] = FIBERAPICLOSURE pfibercapture
def $class_instanceof(S, POBJECT n, preqbytes) = true
  -- if S.OBJECTS[n] = FIBERAPICLOSURE pfibercapture
  -- if $ptlc(preqbytes) = $ptascii("closure")
def $named_closure_same(S, n_left, n_right) = true
  -- if S.OBJECTS[n_left] = FIBERAPICLOSURE pfibercapture_left
  -- if S.OBJECTS[n_right] = FIBERAPICLOSURE pfibercapture_right
  -- if pfibercapture_left.KIND = pfibercapture_right.KIND
def $cast_value(S, CASTARRAY, POBJECT n, z) = $allocate_array(S, {ITEMS ([ENTRY (KINT 0) (DIRECT (POBJECT n))]), NEXT 1, POSITIONS ([POSITION (KINT 0) 0]), SERIAL 1})
  -- if S.OBJECTS[n] = FIBERAPICLOSURE pfibercapture
def $clone_object(S, n_source) = S[.OBJECTS = S.OBJECTS ++ [FIBERAPICLOSURE pfibercapture]][.ALLOCATIONS = S.ALLOCATIONS ++ [HOBJECT n]][.RESULT = KNOWN (POBJECT n)]
  -- if S.OBJECTS[n_source] = FIBERAPICLOSURE pfibercapture
  -- if $fiber_capture_live(S, n_source)
  -- if n = |S.OBJECTS|
def $clone_same_kind(FIBERAPICLOSURE pfibercapture, FIBERAPICLOSURE pfibercapture) = true

;; The ordinary CONFIG buffer owns arguments. Its OWNER=SELECTION capture
;; pair is borrowed from the separate Closure call owner, not a lookup nonce.
def $fiber_capture_config_tag(pconfigcall) = ($fiber_static(pconfigcall.KIND) /\ pconfigcall.OWNER =/= eps /\ pconfigcall.OWNER = pconfigcall.SELECTION)
dec $fiber_capture_call_site(pstate, porigin) : bool
dec $fiber_capture_count(ptask*, nat, porigin) : nat
dec $fiber_capture_result_site(ptask, nat, porigin) : bool
dec $fiber_capture_config_task(ptask, pconfigcall) : bool
dec $fiber_capture_config_pair(pstate, ptask*, nat, pconfigcall) : bool
dec $fiber_capture_config_selected(pstate, pconfigcall) : bool
dec $fiber_capture_prepare(pstate, nat, porigin, int, bool) : pstate
dec $fiber_capture_invoke(pstate, pconfigcall) : pstate
dec $fiber_capture_release_valid(pstate, nat, porigin) : bool
dec $fiber_capture_result_valid(pstate, nat, pconfigcall, bool) : bool
def $fiber_capture_call_site(S, porigin) = true
  -- if $origin_node(S.SOURCES, porigin) = (NExprFuncCall expression (SEQUENCE phpType7*) metadata)
  -- if ~$ppfirstclass(phpType7*)
def $fiber_capture_call_site(S, porigin) = true
  -- if $origin_node(S.SOURCES, porigin) = (NExprMethodCall expression phpType20 (SEQUENCE phpType7*) metadata)
  -- if $method_source_name(phpType20, $ptascii("__invoke"))
  -- if ~$ppfirstclass(phpType7*)
def $fiber_capture_call_site(S, porigin) = false -- otherwise
def $fiber_capture_count(eps, n, porigin) = 0
def $fiber_capture_count((FIBER_CAPTURE_RELEASE n porigin) :: ptask*, n, porigin) = $(1 + $fiber_capture_count(ptask*, n, porigin))
def $fiber_capture_count((FIBER_CAPTURE_RESULT n pconfigcall b) :: ptask*, n, porigin) = $(1 + $fiber_capture_count(ptask*, n, porigin))
  -- if pconfigcall.SITE = porigin
def $fiber_capture_count(ptask :: ptask_tail*, n, porigin) = $fiber_capture_count(ptask_tail*, n, porigin)
  -- if ptask =/= FIBER_CAPTURE_RELEASE n porigin
  -- if ~$fiber_capture_result_site(ptask, n, porigin)
def $fiber_capture_result_site(FIBER_CAPTURE_RESULT n pconfigcall b, n, porigin) = (pconfigcall.SITE = porigin)
def $fiber_capture_result_site(ptask, n, porigin) = false -- otherwise
def $fiber_capture_config_task(CONFIG_ARGS pconfigcall, pconfigcall) = true
def $fiber_capture_config_task(CONFIG_SEND pconfigcall, pconfigcall) = true
def $fiber_capture_config_task(CONFIG_UNPACK_PREP pconfigcall, pconfigcall) = true
def $fiber_capture_config_task(CONFIG_UNPACK_NEXT pconfigcall poperand n, pconfigcall) = true
def $fiber_capture_config_task(CONFIG_INVOKE pconfigcall, pconfigcall) = true
def $fiber_capture_config_task(ptask, pconfigcall) = false -- otherwise
def $fiber_capture_config_pair(S, ptask :: (FIBER_CAPTURE_RELEASE n porigin) :: ptask_tail*, n, pconfigcall) = true
  -- if $fiber_capture_config_task(ptask, pconfigcall)
  -- if porigin = pconfigcall.SITE
def $fiber_capture_config_pair(S, ptask :: (FIBER_CAPTURE_RESULT n pconfigcall b) :: ptask_tail*, n, pconfigcall) = true
  -- if $fiber_capture_config_task(ptask, pconfigcall)
  -- if b = $exit_method_site(S, pconfigcall.SITE)
def $fiber_capture_config_pair(S, ptask :: ptask_tail*, n, pconfigcall) = $fiber_capture_config_pair(S, ptask_tail*, n, pconfigcall)
  -- if ~$fiber_capture_config_task(ptask, pconfigcall)
def $fiber_capture_config_pair(S, ptask*, n, pconfigcall) = false -- otherwise
def $fiber_capture_config_selected(S, pconfigcall) = true
