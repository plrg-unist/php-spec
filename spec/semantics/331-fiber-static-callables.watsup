def $call_task_valid(S, FIBER_API_CORE_RESULT n n_capture pconfigcall) = $fiber_api_core_result_valid(S, n, n_capture, pconfigcall)
def $fiber_api_valid(S, pfiberapi) = true
  -- if $(pfiberapi.SEQUENCE > 0) /\ $(pfiberapi.SEQUENCE < S.FIBERSEQ)
  -- if pfiberapi.KIND = (INTRINSIC_FIBER_SUSPEND) /\ pfiberapi.START = eps
