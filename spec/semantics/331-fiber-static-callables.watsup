  -- if $call_task_valid(S, FIBER_API_CORE_RESULT n n_capture pconfigcall)
  -- if $throwable_live(S, n_throwable)
def $call_after_origin(S, FIBER_API_CORE_RESULT n n_capture pconfigcall) = S[.ORIGIN = eps]

def $config_trace_frames(S, pconfigcall, pvalue*) = [ptraceframe]
  -- if $fiber_capture_config_tag(pconfigcall)
  -- if ~$exit_method_site(S, pconfigcall.SITE)
  -- if ptraceframe = {FILE $call_sourcefile(S.FILES, pconfigcall.SITE), LINE pconfigcall.LINE, FUNCTION $fiber_method_name(pconfigcall.KIND), CLASS ($ptascii("Fiber")), TYPE ($ptascii("::")), ARGS $trace_indexed_args(pvalue*, 0), HASARGS true}
def $config_trace_frames(S, pconfigcall, pvalue*) = [ptraceframe, ptraceframe_invoke]
  -- if $fiber_capture_config_tag(pconfigcall)
  -- if $exit_method_site(S, pconfigcall.SITE)
  -- if ptraceframe = {FILE eps, LINE $(-1), FUNCTION $fiber_method_name(pconfigcall.KIND), CLASS ($ptascii("Fiber")), TYPE ($ptascii("::")), ARGS $trace_indexed_args(pvalue*, 0), HASARGS true}
  -- if ptraceframe_invoke = {FILE $call_sourcefile(S.FILES, pconfigcall.SITE), LINE pconfigcall.LINE, FUNCTION $ptascii("__invoke"), CLASS ($ptascii("Closure")), TYPE ($ptascii("->")), ARGS $trace_indexed_args(pvalue*, 0), HASARGS true}
def $config_trace_frames(S, pconfigcall, pvalue*) = [{FILE eps, LINE $(-1), FUNCTION $fiber_method_name(pconfigcall.KIND), CLASS ($ptascii("Fiber")), TYPE ($ptascii("::")), ARGS $trace_indexed_args(pvalue*, 0), HASARGS true}]
