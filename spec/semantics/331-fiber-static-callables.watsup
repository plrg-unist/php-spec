  -- if $fiber_capture_live(S, n)
  -- if pconfigcall = {SITE porigin, KIND pfibercapture.KIND, INDEX 0, SENT eps, NAMED false, OWNER (n), SELECTION (n), LINE z, PACKS eps}
def $fiber_capture_prepare(S, n, porigin, z, false) = S[.TODO = [CONFIG_ARGS pconfigcall, FIBER_CAPTURE_RELEASE n porigin] ++ S.TODO][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.OBJECTS[n] = FIBERAPICLOSURE pfibercapture
  -- if $fiber_capture_live(S, n)
  -- if pconfigcall = {SITE porigin, KIND pfibercapture.KIND, INDEX 0, SENT eps, NAMED false, OWNER (n), SELECTION (n), LINE z, PACKS eps}
def $dynamic_value(S, porigin, z_init, z_call) = $fiber_capture_prepare(S, n, porigin, z_call, false)
  -- if S.COMPLETION = NORMAL
  -- if S.RESULT = KNOWN (POBJECT n)
  -- if S.OBJECTS[n] = FIBERAPICLOSURE pfibercapture
def $method_select(S, poperand, ptbytes, phpType7*, z) = $fiber_capture_prepare(S_read, n, porigin, z, true)
  -- if S.ORIGIN = (porigin)
  -- if S_read = $resolve_at(S, poperand, z)
  -- if S_read.COMPLETION = NORMAL
  -- if S_read.RESULT = KNOWN (POBJECT n)
  -- if S_read.OBJECTS[n] = FIBERAPICLOSURE pfibercapture
