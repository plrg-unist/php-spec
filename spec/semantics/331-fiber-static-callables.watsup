def $fiber_core_result_kind(FIBER_API_CORE_RESULT n n_capture pconfigcall) = true
def $fiber_core_tail([FIBER_API_CORE_RESULT n n_capture pconfigcall, FIBER_FINISH n]) = ((n, pconfigcall))
def $fiber_core_count((FIBER_API_CORE_RESULT n n_capture pconfigcall) :: ptask*) = $(1 + $fiber_core_count(ptask*))
def $fiber_core_task_at([FIBER_CORE_RESULT n pconfigcall, FIBER_FINISH n]) = (FIBER_CORE_RESULT n pconfigcall)
def $fiber_core_task_at([FIBER_API_CORE_RESULT n n_capture pconfigcall, FIBER_FINISH n]) = (FIBER_API_CORE_RESULT n n_capture pconfigcall)
def $fiber_core_task_at(ptask :: ptask_tail*) = $fiber_core_task_at(ptask_tail*)
  -- if ~$fiber_core_result_kind(ptask)
def $fiber_core_task_at(ptask*) = eps -- otherwise
def $fiber_core_task_frames(eps) = eps
def $fiber_core_task_frames(pframe :: pframe_tail*) = (ptask)
  -- if $fiber_core_task_at(pframe.TODO) = (ptask)
def $fiber_core_task_frames(pframe :: pframe_tail*) = $fiber_core_task_frames(pframe_tail*)
