rule PhpStep/fiber-api-core-result: S ~> S[.TODO = ptask_tail*][.ORIGIN = eps]
  -- if S.TODO = (FIBER_API_CORE_RESULT n n_capture pconfigcall) :: ptask_tail*
  -- if S.CURRENT = eps /\ S.FRAMES = eps
  -- if $call_task_valid(S, FIBER_API_CORE_RESULT n n_capture pconfigcall)
def $fiber_marker(FIBER_API_CORE_RESULT n n_capture pconfigcall) = true
rule PhpStep/fiber-api-core-result-throw: S ~> S[.TODO = (THROW_SEARCH n_throwable) :: ptask_tail*][.ORIGIN = eps]
  -- if S.TODO = (THROW_SEARCH n_throwable) :: (FIBER_API_CORE_RESULT n n_capture pconfigcall) :: ptask_tail*
