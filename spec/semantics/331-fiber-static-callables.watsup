def $fiber_capture_prepare(S, n, porigin, z, b_pop) = S[.TODO = [CONFIG_ARGS pconfigcall, FIBER_CAPTURE_RELEASE n porigin, METHOD_RESULT] ++ ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if b_pop
  -- if S.TODO = ptask :: ptask_tail*
