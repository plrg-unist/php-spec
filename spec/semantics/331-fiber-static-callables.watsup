;; __invoke copies its wrapper buffer and adds a second Closure call owner.
;; These owners appear only after SEND has finished and the C handler enters.
def $fiber_capture_invoke(S, pconfigcall) = $fiber_receive(S[.TODO = (CONFIG_INVOKE pconfigcall) :: (FIBER_CAPTURE_RESULT n pconfigcall b_invoke) :: ptask_tail*], pconfigcall)
  -- if S.TODO = (CONFIG_INVOKE pconfigcall) :: (FIBER_CAPTURE_RELEASE n pconfigcall.SITE) :: ptask_tail*
  -- if pconfigcall.OWNER = (n)
  -- if $fiber_capture_config_selected(S, pconfigcall)
  -- if b_invoke = $exit_method_site(S, pconfigcall.SITE)
def $config_receive(S, pconfigcall) = $fiber_capture_invoke(S, pconfigcall)
  -- if $fiber_capture_config_tag(pconfigcall)
def $task_nodes(FIBER_CAPTURE_RELEASE n porigin) = [HOBJECT n]
def $task_nodes(FIBER_CAPTURE_RESULT n pconfigcall false) = [HOBJECT n]
def $task_nodes(FIBER_CAPTURE_RESULT n pconfigcall true) = [HOBJECT n, HOBJECT n] ++ $named_slots_roots(pconfigcall.SENT)
def $fiber_capture_release_valid(S, n, porigin) = ($fiber_capture_live(S, n) /\ S.ORIGIN = (porigin) /\ $fiber_capture_call_site(S, porigin) /\ $fiber_capture_count(S.TODO, n, porigin) = 1 /\ $generator_flat_tasks(S.TODO))
def $fiber_capture_result_valid(S, n, pconfigcall, b) = true
