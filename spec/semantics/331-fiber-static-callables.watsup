  -- if b = $exit_method_site(S, pconfigcall.SITE)
  -- if ~b \/ $config_slots_valid(S, pconfigcall.SENT)
def $fiber_capture_result_valid(S, n, pconfigcall, b) = false -- otherwise
def $call_task_valid(S, FIBER_CAPTURE_RELEASE n porigin) = $fiber_capture_release_valid(S, n, porigin)
def $call_task_valid(S, FIBER_CAPTURE_RESULT n pconfigcall b) = $fiber_capture_result_valid(S, n, pconfigcall, b)
rule PhpStep/fiber-capture-result: S ~> S[.TODO = ptask_tail*]
  -- if S.TODO = (FIBER_CAPTURE_RESULT n pconfigcall false) :: ptask_tail*
  -- if $fiber_capture_result_valid(S, n, pconfigcall, false)
rule PhpStep/fiber-capture-invoke-result: S ~> S[.TODO = (FIBER_CAPTURE_RELEASE n pconfigcall.SITE) :: ptask_tail*]
  -- if S.TODO = (FIBER_CAPTURE_RESULT n pconfigcall true) :: ptask_tail*
  -- if $fiber_capture_result_valid(S, n, pconfigcall, true)
rule PhpStep/fiber-capture-release: S ~> S[.TODO = ptask_tail*]
  -- if S.TODO = (FIBER_CAPTURE_RELEASE n porigin) :: ptask_tail*
  -- if $fiber_capture_release_valid(S, n, porigin)
def $fiber_marker(FIBER_CAPTURE_RELEASE n porigin) = true
def $fiber_marker(FIBER_CAPTURE_RESULT n pconfigcall b) = true
;; Reuse the existing nested-control walk: these runtime owners cannot be
;; manufactured inside an AT wrapper or either unexecuted CHOOSE branch.
def $generator_internal_task(FIBER_CAPTURE_RELEASE n porigin) = true
def $generator_internal_task(FIBER_CAPTURE_RESULT n pconfigcall b) = true
def $generator_internal_task(FIBER_API_CORE_RESULT n n_capture pconfigcall) = true
rule PhpStep/fiber-capture-throw-result: S ~> S[.TODO = (THROW_SEARCH n_throwable) :: ptask_tail*]
  -- if S.TODO = (THROW_SEARCH n_throwable) :: (FIBER_CAPTURE_RESULT n pconfigcall false) :: ptask_tail*
