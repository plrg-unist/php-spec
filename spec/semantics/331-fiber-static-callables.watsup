  -- if $fiber_capture_count(S.TODO, n, pconfigcall.SITE) = 1
def $fiber_capture_config_selected(S, pconfigcall) = false -- otherwise
def $config_selected_valid(S, pconfigcall) = $fiber_capture_config_selected(S, pconfigcall)
