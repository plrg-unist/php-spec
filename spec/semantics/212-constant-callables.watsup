;; Constant-created Closures use their initializer owner, never the fetch caller.
;; Creation records borrow immutable object slots; only cached values own roots.
dec $constant_callable_form(pcnode) : bool
dec $constant_callable_static(phpType19) : bool
dec $constant_callable_function_form(phpType19) : bool
dec $constant_callable_nonstring(pcnode) : bool
dec $constant_callable_class_form(phpType19) : bool
dec $constant_callable_literal_class(phpType19) : ptbytes?
dec $constant_callable_invalid_class(phpType19) : ptbytes?
dec $constant_callable_method_name(phpType20) : ptbytes?
dec $constant_callable_path(pstate, porigin, porigin) : bool
dec $constant_callable_context(pstate, porigin) : (porigin, porigin)?
dec $constant_callable_record(pconstantclosure*, nat) : pconstantclosure?
dec $constant_callable_first(pconstantclosure*, porigin) : pconstantclosure?
dec $constant_callable_stamp(pstate, nat, porigin, nat) : pstate
dec $constant_callable_record_valid(pstate, pconstantclosure) : bool
dec $constant_callable_identity_valid(pstate, nat, porigin) : bool
dec $constant_callable_birth_valid(pstate, pconstantclosure, porigin) : bool
dec $constant_callable_wrappers_valid(pstate, pobject*, nat) : bool
dec $constant_callable_wrapper(pobject) : bool
dec $constant_callable_live_scope(pstate, pconstantclosure, porigin, porigin) : bool
dec $constant_callable_class_event(pdeclaration) : porigin?
dec $constant_callable_function_event(pdeclaration) : porigin?
dec $constant_callable_published(pdeclaration*, porigin) : bool
dec $constant_callable_source(pstate, pclassdesc*, porigin) : pclassconstantdesc?
dec $constant_callable_source_constants(pstate, pclassconstantdesc*, porigin) : pclassconstantdesc?
dec $constant_callable_record_prefix(pstate, pconstantclosure) : bool
dec $constant_callable_method_site(pstate, porigin) : bool
dec $constant_callable_functions(pstate, pdeclaration*) : (preqbytes, porigin)*
dec $constant_callable_function_fresh(pstate, porigin, nat) : pfunction?
dec $constant_callable_function(pstate, porigin, nat) : pfunction?
dec $constant_callable_prefix(pstate, porigin) : nat
dec $constant_callable_creation_prefix(pstate, porigin) : nat
dec $property_callable_initializer(pstate, porigin) : bool
dec $property_callable_record(pstate, pconstantclosure) : bool
dec $property_callable_cached_method(pstate, porigin) : pmethoddesc?
dec $property_callable_cached_function(pstate, porigin) : pfunction?
dec $constant_callable_imported_context(pstate, porigin) : bool
dec $constant_callable_imported_record(pstate, pconstantclosure) : bool
dec $constant_callable_cached_method(pstate, porigin) : pmethoddesc?
dec $constant_callable_cached_function(pstate, porigin) : pfunction?
dec $constant_callable_record_owner(pstate, pconstantclosure) : porigin?
dec $constant_callable_class_name(pstate, porigin, porigin, phpType19) : ptbytes?
dec $constant_callable_method_class(pstate, porigin, porigin, nat) : porigin?
dec $constant_callable_method_fresh(pstate, porigin, porigin, nat) : (pmethoddesc, porigin)?
dec $constant_callable_method(pstate, porigin, porigin, nat) : (pmethoddesc, porigin)?
dec $constant_callable_method_access(pstate, porigin, porigin, pmethoddesc) : bool
dec $constant_callable_named_create(pstate, porigin) : pstate
dec $constant_callable_named_allocate(pstate, porigin, pfunction, nat) : pstate
dec $constant_callable_method_create(pstate, porigin) : pstate
dec $constant_callable_method_allocate(pstate, porigin, pmethoddesc, porigin, nat) : pstate
dec $constant_callable_classes_foldable((pkey, pvalueclass)*) : bool
dec $ppconstant_callable_initializer(ppstate) : bool

def $ppconstant_closure(P, false, phpType21, metadata) = $ppconstant_error(P, $ptascii("Closures in constant expressions must be static"), $psline(metadata))
def $ppconstant_closure(P, true, SEQUENCE phpType22*, metadata) = $ppconstant_error(P, $ptascii("Cannot use(...) variables in constant expression"), $psline(metadata))
  -- if phpType22* =/= eps
def $ppconstant_closure(P, true, SEQUENCE eps, metadata) = P
  -- if $ppconstant_callable_initializer(P)
def $ppconstant_closure(P, true, SEQUENCE eps, metadata) = $ppunsupported(P, "closure constant initializer outside class constants")
  -- if ~$ppconstant_callable_initializer(P)

def $constant_callable_static(NName (BYTES text) metadata) = ($ptlc($base64(text)) = $ptascii("static"))
def $constant_callable_static(phpType19) = false -- otherwise
def $constant_callable_function_form(name) = true
def $constant_callable_function_form(expression) = ($ppcall_literal(expression) =/= eps)
def $constant_callable_nonstring(NScalarInt phpType24 metadata) = true
def $constant_callable_nonstring(NScalarFloat phpType41 metadata) = true
def $constant_callable_nonstring(pcnode) = false -- otherwise
def $ppconstant_function_callable(P, phpType19, metadata) = $ppconstant_error(P, $ptascii("Illegal function name"), $psline(metadata))
  -- if $constant_callable_nonstring(phpType19)
def $ppconstant_function_callable(P, phpType19, metadata) = $ppconstant_error(P, $ptascii("Cannot use dynamic function name in constant expression"), $psline(metadata))
  -- if ~$constant_callable_function_form(phpType19)
  -- if ~$constant_callable_nonstring(phpType19)
def $ppconstant_function_callable(P, phpType19, metadata) = P
  -- if $constant_callable_function_form(phpType19) /\ $ppconstant_callable_initializer(P)
def $ppconstant_function_callable(P, phpType19, metadata) = $ppunsupported(P, "first-class callable constant initializer outside class constants")
  -- if $constant_callable_function_form(phpType19) /\ ~$ppconstant_callable_initializer(P)

def $constant_callable_method_name(NIdentifier (BYTES text) metadata) = ($base64(text))
def $constant_callable_method_name(NScalarString (BYTES text) metadata) = ($base64(text))
def $constant_callable_method_name(phpType20) = eps -- otherwise
def $constant_callable_literal_class(NScalarString (BYTES text) metadata) = ($ppcall_literal_name($base64(text)))
def $constant_callable_literal_class(phpType19) = eps -- otherwise
def $constant_callable_class_form(phpType19) = ($ppscoped_named(phpType19) \/ $constant_callable_literal_class(phpType19) =/= eps)
def $constant_callable_invalid_class(phpType19) = (ptbytes)
  -- if $constant_callable_literal_class(phpType19) = (ptbytes)
  -- if $ptlc(ptbytes) <- [$ptascii("self"), $ptascii("parent"), $ptascii("static")]
def $constant_callable_invalid_class(phpType19) = eps -- otherwise
def $ppconstant_method_callable(P, phpType19, phpType20, metadata) = $ppconstant_error(P, $ptascii("Illegal class name"), $psline(metadata))
  -- if $constant_callable_nonstring(phpType19)
def $ppconstant_method_callable(P, phpType19, phpType20, metadata) = $ppconstant_error(P, $ptascii("Cannot use dynamic class name in constant expression"), $psline(metadata))
  -- if ~$constant_callable_class_form(phpType19)
  -- if ~$constant_callable_nonstring(phpType19)
def $ppconstant_method_callable(P, phpType19, phpType20, metadata) = $ppconstant_error(P, $ptascii("'\\") ++ ptbytes ++ $ptascii("' is an invalid class name"), $psline(metadata))
  -- if $constant_callable_invalid_class(phpType19) = (ptbytes)
def $ppconstant_method_callable(P, phpType19, phpType20, metadata) = $ppconstant_error(P, $ptascii("\"static\" is not allowed in compile-time constants"), $psline(metadata))
  -- if $constant_callable_static(phpType19)
def $ppconstant_method_callable(P, phpType19, phpType20, metadata) = $ppconstant_error(P, $ptascii("Illegal method name"), $psline(metadata))
  -- if $constant_callable_class_form(phpType19)
  -- if $constant_callable_invalid_class(phpType19) = eps
  -- if ~$constant_callable_static(phpType19)
  -- if $constant_callable_nonstring(phpType20)
def $ppconstant_method_callable(P, phpType19, phpType20, metadata) = $ppconstant_error(P, $ptascii("Cannot use dynamic method name in constant expression"), $psline(metadata))
  -- if $constant_callable_class_form(phpType19)
  -- if $constant_callable_invalid_class(phpType19) = eps
  -- if ~$constant_callable_static(phpType19)
  -- if $constant_callable_method_name(phpType20) = eps
  -- if ~$constant_callable_nonstring(phpType20)
def $ppconstant_method_callable(P, phpType19, phpType20, metadata) = P
  -- if $constant_callable_class_form(phpType19)
  -- if $constant_callable_invalid_class(phpType19) = eps
  -- if ~$constant_callable_static(phpType19)
  -- if $constant_callable_method_name(phpType20) =/= eps
  -- if $ppconstant_callable_initializer(P)
def $ppconstant_method_callable(P, phpType19, phpType20, metadata) = $ppunsupported(P, "first-class callable constant initializer outside class constants")
  -- otherwise

def $constant_callable_form(NExprClosure (SEQUENCE eps) (BOOLEAN true) phpType4_ref phpType16 (SEQUENCE eps) phpType18 phpType23 metadata) = true
def $constant_callable_form(NExprFuncCall phpType19 (SEQUENCE ([(NVariadicPlaceholder metadata_placeholder)])) metadata) = $constant_callable_function_form(phpType19)
def $constant_callable_form(NExprStaticCall phpType19 phpType20 (SEQUENCE ([(NVariadicPlaceholder metadata_placeholder)])) metadata) = ($constant_callable_class_form(phpType19) /\ $constant_callable_invalid_class(phpType19) = eps /\ $constant_callable_method_name(phpType20) =/= eps)
def $constant_callable_form(pcnode) = false -- otherwise

;; Stop at an enclosing closure body: its ordinary runtime expressions are not
;; part of the outer constant's expression evaluation.
def $constant_callable_path(S, porigin, porigin) = true
def $constant_callable_path(S, PORIGIN n pcpath, PORIGIN n pcpath_root) = $constant_callable_path(S, porigin_parent, PORIGIN n pcpath_root)
  -- if $effect_below(pcpath_root, pcpath) /\ pcpath =/= pcpath_root
  -- if porigin_parent = PORIGIN n pcpath[0:$nabs($(|pcpath| - 1))]
  -- if $function_at(S.CLOSURETEMPLATES, porigin_parent) = eps
def $constant_callable_path(S, porigin, porigin_root) = false -- otherwise
def $constant_callable_context(S, porigin) = ((pclassconstantdesc.ORIGIN, pclassconstantdesc.OWNER))
  -- if S.CONSTCONTEXT = (pconstantcontext)
  -- if S.CLASSCONSTANTINIT = pclassconstantcontext :: pclassconstantcontext_tail*
  -- if pconstantcontext.ORIGIN = pclassconstantcontext.DECL
  -- if $class_constant_origin(S.CLASSES, pconstantcontext.ORIGIN) = (pclassconstantdesc)
  -- if $constant_callable_path(S, porigin, pclassconstantdesc.INITIALIZER)
  -- if $origin_node(S.SOURCES, porigin) = (pcnode)
  -- if $constant_callable_form(pcnode)
def $constant_callable_context(S, porigin) = eps -- otherwise
def $constant_callable_active(S, porigin) = ($constant_callable_context(S, porigin) =/= eps)

def $constant_callable_record(eps, n) = eps
def $constant_callable_record(pconstantclosure :: pconstantclosure_tail*, n) = (pconstantclosure)
  -- if pconstantclosure.OBJECT = n
def $constant_callable_record(pconstantclosure :: pconstantclosure_tail*, n) = $constant_callable_record(pconstantclosure_tail*, n)
  -- if pconstantclosure.OBJECT =/= n
def $constant_callable_first(eps, porigin) = eps
def $constant_callable_first(pconstantclosure :: pconstantclosure_tail*, porigin) = (pconstantclosure)
  -- if pconstantclosure.SITE = porigin
def $constant_callable_first(pconstantclosure :: pconstantclosure_tail*, porigin) = $constant_callable_first(pconstantclosure_tail*, porigin)
  -- if pconstantclosure.SITE =/= porigin
def $constant_callable_prefix(S, porigin) = pconstantclosure.PREFIX
  -- if $constant_callable_first(S.CONSTANTCLOSURES, porigin) = (pconstantclosure)
def $constant_callable_prefix(S, porigin) = |S.DECLARATIONS|
  -- if $constant_callable_first(S.CONSTANTCLOSURES, porigin) = eps
def $constant_callable_creation_prefix(S, porigin) = |S.DECLARATIONS|
  -- if $property_callable_initializer(S, porigin) \/ $constant_callable_imported_context(S, porigin)
def $constant_callable_creation_prefix(S, porigin) = $constant_callable_prefix(S, porigin)
  -- if ~$property_callable_initializer(S, porigin) /\ ~$constant_callable_imported_context(S, porigin)
def $constant_callable_stamp(S, n, porigin, n_prefix) = S[.OBJECTS = $object_set(S.OBJECTS, n, CONSTANTCLOSURE porigin S.OBJECTS[n])][.CONSTANTCLOSURES = S.CONSTANTCLOSURES ++ [{OBJECT n, SITE porigin, DECL porigin_decl, PREFIX n_prefix}]]
  -- if $constant_callable_context(S, porigin) = ((porigin_decl, porigin_owner))

def $constant_callable_class_event(PDECLASS n porigin) = (porigin)
def $constant_callable_class_event(PDRCLASS porigin pdeclcause) = (porigin)
def $constant_callable_class_event(pdeclaration) = eps -- otherwise
def $constant_callable_function_event(PDEFUNCTION n porigin) = (porigin)
def $constant_callable_function_event(PDRFUNCTION porigin pdeclcause) = (porigin)
def $constant_callable_function_event(pdeclaration) = eps -- otherwise
def $constant_callable_published(eps, porigin) = false
def $constant_callable_published(pdeclaration :: pdeclaration_tail*, porigin) = true
  -- if $constant_callable_class_event(pdeclaration) = (porigin)
def $constant_callable_published(pdeclaration :: pdeclaration_tail*, porigin) = $constant_callable_published(pdeclaration_tail*, porigin)
  -- if $constant_callable_class_event(pdeclaration) =/= (porigin)
def $constant_callable_functions(S, eps) = eps
def $constant_callable_functions(S, pdeclaration :: pdeclaration_tail*) = [($ptlc(pfunction.NAME), porigin)] ++ $constant_callable_functions(S, pdeclaration_tail*)
  -- if $constant_callable_function_event(pdeclaration) = (porigin)
  -- if $function_at(S.FUNCTIONS, porigin) = (pfunction)
def $constant_callable_functions(S, pdeclaration :: pdeclaration_tail*) = $constant_callable_functions(S, pdeclaration_tail*)
  -- if $constant_callable_function_event(pdeclaration) = eps
def $constant_callable_function_fresh(S, PORIGIN n pcpath, n_prefix) = $call_target(S[.CALLABLES = $constant_callable_functions(S, S.DECLARATIONS[0:n_prefix])], ptbytes, ptbytes_fallback?)
  -- if $(n_prefix <= |S.DECLARATIONS|)
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_name(pcode.NAMES, pcpath) = ((ptbytes, ptbytes_fallback?))
def $constant_callable_function_fresh(S, porigin, n) = eps -- otherwise
def $constant_callable_function(S, porigin, n_prefix) = $constant_callable_function_fresh(S, porigin, n_prefix)
  -- if $constant_callable_cached_function(S, porigin) = eps
def $constant_callable_function(S, porigin, n_prefix) = (pfunction)
  -- if $(n_prefix <= |S.DECLARATIONS|)
  -- if $constant_callable_cached_function(S, porigin) = (pfunction)
  -- if $constant_callable_first(S.CONSTANTCLOSURES, porigin) = (pconstantclosure_first)
  -- if $(pconstantclosure_first.PREFIX <= n_prefix)
def $constant_callable_function(S, porigin, n_prefix) = eps -- otherwise

def $constant_closure_create(S, pfunction) = $constant_callable_stamp(S_scoped, n, pfunction.ORIGIN, |S.DECLARATIONS|)
  -- if $constant_callable_context(S, pfunction.ORIGIN) = ((porigin_decl, porigin_owner))
  -- if $closure_lexicals(pfunction.CODE.EXPRESSIONS) = eps
  -- if n = |S.OBJECTS|
  -- if S_scoped = S[.OBJECTS = S.OBJECTS ++ [REALCLOSURE pfunction.ORIGIN eps eps]][.ALLOCATIONS = S.ALLOCATIONS ++ [HOBJECT n]][.CLOSURESCOPES = S.CLOSURESCOPES ++ [{OBJECT n, LEXICAL porigin_owner, CALLED porigin_owner, RECEIVER eps, CREATION eps}]][.RESULT = KNOWN (POBJECT n)][.BASE = BASE_VALUE (KNOWN PNULL)]

def $constant_callable_named_allocate(S, porigin, pfunction, n_prefix) = $constant_callable_stamp($firstclass_allocate(S, pfunction), n, porigin, n_prefix)
  -- if n = |S.OBJECTS|
def $constant_callable_named_create(S, porigin) = $constant_callable_named_allocate(S, porigin, pfunction, n_prefix)
  -- if n_prefix = $constant_callable_creation_prefix(S, porigin)
  -- if $constant_callable_function(S, porigin, n_prefix) = (pfunction)
def $constant_callable_named_create(S, PORIGIN n pcpath) = S[.COMPLETION = UNSUPPORTED "builtin constant first-class callable"]
  -- if $constant_callable_function(S, PORIGIN n pcpath, $constant_callable_prefix(S, PORIGIN n pcpath)) = eps
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_name(pcode.NAMES, pcpath) = ((ptbytes, ptbytes_fallback?))
  -- if $call_builtin(ptbytes, ptbytes_fallback?)
def $constant_callable_named_create(S, PORIGIN n pcpath) = $throw_scalar(S, "Error", $ptascii("Call to undefined function ") ++ ptbytes ++ $ptascii("()"), $runtime_line(S, eps, expression))
  -- if $constant_callable_function(S, PORIGIN n pcpath, $constant_callable_prefix(S, PORIGIN n pcpath)) = eps
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_name(pcode.NAMES, pcpath) = ((ptbytes, ptbytes_fallback?))
  -- if ~$call_builtin(ptbytes, ptbytes_fallback?)
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (expression)
rule PhpStep/constant-function-callable: S ~> $constant_callable_named_create(S[.TODO = ptask_tail*], porigin)
  -- if S.TODO = (EVAL (NExprFuncCall phpType19 (SEQUENCE ([(NVariadicPlaceholder metadata_placeholder)])) metadata)) :: ptask_tail*
  -- if S.ORIGIN = (porigin)
  -- if $constant_callable_active(S, porigin)

def $constant_callable_class_name(S, porigin, porigin_owner, NName (BYTES text) metadata) = (pclassdesc.NAME)
  -- if $ptlc($base64(text)) = $ptascii("self")
  -- if $class_at(S.CLASSES, porigin_owner) = (pclassdesc)
def $constant_callable_class_name(S, porigin, porigin_owner, NName (BYTES text) metadata) = (pclassdesc.NAME)
  -- if $ptlc($base64(text)) = $ptascii("parent")
  -- if $class_link_at(S.LINKEDPARENTS, porigin_owner) = (SOURCE_PARENT porigin_parent)
  -- if $class_at(S.CLASSES, porigin_parent) = (pclassdesc)
def $constant_callable_class_name(S, PORIGIN n pcpath, porigin_owner, phpType19) = (ptbytes)
  -- if $ppscoped_named(phpType19) /\ ~$ppscoped_keyword(phpType19)
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_name(pcode.NAMES, pcpath) = ((ptbytes, eps))
def $constant_callable_class_name(S, porigin, porigin_owner, NScalarString (BYTES text) metadata) = ($ppcall_literal_name($base64(text)))
  -- if $constant_callable_invalid_class(NScalarString (BYTES text) metadata) = eps
def $constant_callable_class_name(S, porigin, porigin_owner, phpType19) = eps -- otherwise
def $constant_callable_method_class(S, porigin, porigin_owner, n_prefix) = (porigin_called)
  -- if $(n_prefix <= |S.DECLARATIONS|)
  -- if $origin_node(S.SOURCES, porigin) = (NExprStaticCall phpType19 phpType20 phpType6 metadata)
  -- if $constant_callable_class_name(S, porigin, porigin_owner, phpType19) = (ptbytes_class)
  -- if $class_named(S.CLASSNAMES, $ptlc(ptbytes_class)) = (porigin_called)
  -- if $constant_callable_published(S.DECLARATIONS[0:n_prefix], porigin_called)
def $constant_callable_method_class(S, porigin, porigin_owner, n_prefix) = eps -- otherwise
def $constant_callable_method_fresh(S, porigin, porigin_owner, n_prefix) = ((pmethoddesc, porigin_called))
  -- if $constant_callable_method_class(S, porigin, porigin_owner, n_prefix) = (porigin_called)
  -- if $origin_node(S.SOURCES, porigin) = (NExprStaticCall phpType19 phpType20 phpType6 metadata)
  -- if $constant_callable_method_name(phpType20) = (ptbytes_method)
  -- if $effective_method(S, porigin_called, $ptlc(ptbytes_method), |S.CLASSES|) = (pmethoddesc)
def $constant_callable_method_fresh(S, porigin, porigin_owner, n_prefix) = eps -- otherwise
def $constant_callable_method(S, porigin, porigin_owner, n_prefix) = $constant_callable_method_fresh(S, porigin, porigin_owner, n_prefix)
  -- if $constant_callable_cached_method(S, porigin) = eps
def $constant_callable_method(S, porigin, porigin_owner, n_prefix) = ((pmethoddesc, porigin_called))
  -- if $constant_callable_cached_method(S, porigin) = (pmethoddesc)
  -- if $constant_callable_first(S.CONSTANTCLOSURES, porigin) = (pconstantclosure_first)
  -- if $(pconstantclosure_first.PREFIX <= n_prefix)
  -- if $constant_callable_method_class(S, porigin, porigin_owner, n_prefix) = (porigin_called)
def $constant_callable_method(S, porigin, porigin_owner, n_prefix) = eps -- otherwise
def $constant_callable_method_access(S, porigin, porigin_owner, pmethoddesc) = $method_accessible(S, pmethoddesc, (porigin_owner))
  -- if $constant_callable_cached_method(S, porigin) = eps
def $constant_callable_method_access(S, porigin, porigin_owner, pmethoddesc) = true
  -- if $constant_callable_cached_method(S, porigin) = (pmethoddesc)
def $constant_callable_method_access(S, porigin, porigin_owner, pmethoddesc) = false -- otherwise

def $constant_callable_method_allocate(S, porigin, pmethoddesc, porigin_called, n_prefix) = $constant_callable_stamp(S_scoped, n, porigin, n_prefix)
  -- if n = |S.OBJECTS|
  -- if S_scoped = S[.OBJECTS = S.OBJECTS ++ [METHODCLOSURE pmethoddesc.FUNCTION.ORIGIN porigin porigin_called eps]][.ALLOCATIONS = S.ALLOCATIONS ++ [HOBJECT n]][.CLOSURESCOPES = S.CLOSURESCOPES ++ [{OBJECT n, LEXICAL pmethoddesc.OWNER, CALLED porigin_called, RECEIVER eps, CREATION eps}]][.RESULT = KNOWN (POBJECT n)][.BASE = BASE_VALUE (KNOWN PNULL)]
def $constant_callable_method_create(S, porigin) = $constant_callable_method_allocate(S, porigin, pmethoddesc, porigin_called, n_prefix)
  -- if $constant_callable_context(S, porigin) = ((porigin_decl, porigin_owner))
  -- if n_prefix = $constant_callable_creation_prefix(S, porigin)
  -- if $constant_callable_method(S, porigin, porigin_owner, n_prefix) = ((pmethoddesc, porigin_called))
  -- if $constant_callable_method_access(S, porigin, porigin_owner, pmethoddesc) /\ pmethoddesc.STATIC /\ ~pmethoddesc.ABSTRACT
def $constant_callable_method_create(S, porigin) = $method_denied(S, pmethoddesc, pmethoddesc.NAME, (porigin_owner), false, $runtime_line(S, eps, expression))
  -- if $constant_callable_context(S, porigin) = ((porigin_decl, porigin_owner))
  -- if $constant_callable_method(S, porigin, porigin_owner, $constant_callable_creation_prefix(S, porigin)) = ((pmethoddesc, porigin_called))
  -- if ~$constant_callable_method_access(S, porigin, porigin_owner, pmethoddesc)
  -- if $origin_node(S.SOURCES, porigin) = (expression)
def $constant_callable_method_create(S, porigin) = $throw_scalar(S, "Error", $ptascii("Non-static method ") ++ pclassdesc_owner.NAME ++ $ptascii("::") ++ pmethoddesc.NAME ++ $ptascii("() cannot be called statically"), $runtime_line(S, eps, expression))
  -- if $constant_callable_context(S, porigin) = ((porigin_decl, porigin_owner))
  -- if $constant_callable_method(S, porigin, porigin_owner, $constant_callable_creation_prefix(S, porigin)) = ((pmethoddesc, porigin_called))
  -- if $constant_callable_method_access(S, porigin, porigin_owner, pmethoddesc) /\ ~pmethoddesc.STATIC
  -- if $class_at(S.CLASSES, pmethoddesc.OWNER) = (pclassdesc_owner)
  -- if $origin_node(S.SOURCES, porigin) = (expression)
def $constant_callable_method_create(S, porigin) = $throw_scalar(S, "Error", $ptascii("Cannot call abstract method ") ++ pclassdesc_owner.NAME ++ $ptascii("::") ++ pmethoddesc.NAME ++ $ptascii("()"), $runtime_line(S, eps, expression))
