  -- if ~$shutdown_render_ready(S[.COMPLETION = UNCAUGHT n])
def $executor_renderable(S, n) = false -- otherwise
def $executor_caught_finish(S, pexecutorqueue, UNCAUGHT n) = S_report[.TODO = [EXECUTOR_RELEASE pexecutorqueue_new (EXECUTOR_PENDING n)]][.COMPLETION = NORMAL][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)][.ORIGIN = eps][.RETIREDOWNERS = eps][.TRACE = eps][.ERRORORIGIN = eps]
  -- if S_cached = $throwable_string_cache(S, n, $throwable_chain_string(S, n, [n]))
  -- if S_report = $shutdown_freeze_marked(S_cached)
  -- if $shutdown_frozen(S_report.COMPLETION)
  -- if pexecutorqueue_new = pexecutorqueue[.COMPLETION = S_report.COMPLETION][.VALUE = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)][.ORIGIN = eps]
def $output_drive_finalize(S, n) = $drive_steps($executor_caught_finish(S, pexecutorqueue, pcompletion), n)
  -- if $executor_caught(S) = ((pexecutorqueue, pcompletion))
def $executor_pending_cause(S, pexecutorqueue, n) = true
  -- if $throwable_live(S, n)
