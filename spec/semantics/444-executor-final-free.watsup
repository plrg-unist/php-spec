;; After output deactivation, executor shutdown disables PHP entry. Nonfast
;; shutdown first releases executor tables and handler registries. Both modes
;; sweep real handles backwards; nonfast also runs standard free_obj hooks.
;; A local graph computes these terminal effects; the final machine keeps its
;; last ownership-valid snapshot, not a claim about process-freed memory.
syntax pexecutorfree = {HEAP hgraph, MARKED pnode*, FAILED nat?, UNKNOWN bool}
dec $executor_free_weak(pstate, nat) : bool
dec $executor_free_standard(pobject) : bool
dec $executor_free_kind(pstate, nat) : nat
dec $executor_free_edges(hedge*, pnode) : hedge*
dec $executor_free_mark(pnode, pnode*) : pnode*
dec $executor_free_body(pstate, pexecutorfree, pnode) : pexecutorfree
dec $executor_free_release(pstate, pexecutorfree, pnode*) : pexecutorfree
dec $executor_free_zero(pstate, pexecutorfree, pnode) : pexecutorfree
dec $executor_free_force(pstate, pexecutorfree, nat) : pexecutorfree
dec $executor_free_walk(pstate, pexecutorfree, nat) : pexecutorfree
dec $executor_free_result(pstate, pexecutorfree) : pstate
dec $executor_allocator_fast(prequest?) : bool
dec $executor_free_endpoint(pstate) : bool
dec $executor_free_tables(pstate, pexecutorfree) : pexecutorfree
dec $executor_table_nodes(pstate) : pnode*
dec $executor_table_roots(pstate) : pnode*
dec $executor_symbol_nodes(pbinding*, preqbytes*) : pnode*
dec $executor_reverse_nodes(pnode*) : pnode*
dec $executor_constant_nodes(puserconstant*) : pnode*
dec $executor_function_nodes(pstaticcell*, pfunction) : pnode*
dec $executor_static_nodes(pstaticcell*, nat, pcodeexpr*) : pnode*
dec $executor_function_tables(pstate, (preqbytes, porigin)*) : pnode*
dec $executor_class_tables(pstate, (preqbytes, porigin)*, pnode*) : (pnode*, pnode*)
dec $executor_property_nodes(pstate, ppropertydesc*) : pnode*
dec $executor_class_constants(pstate, pclassconstantdesc*, porigin) : pnode*
dec $executor_class_defaults(pinstancetemplate*, porigin) : pnode*
dec $executor_method_tables(pstate, ppmethodinherited*) : pnode*
dec $executor_static_fresh(pnode*, pnode*) : pnode*
dec $executor_free_finish(pstate) : pstate

;; getenv takes its first duplicate; ZEND_ATOL reads a signed decimal prefix.
;; Nonfast shutdown has earlier table/registry releases before the store sweep.
def $executor_allocator_fast(eps) = true
def $executor_allocator_fast((Q)) = true
  -- if $request_env_first(Q.ENV, $ptascii("USE_ZEND_ALLOC")) = eps
def $executor_allocator_fast((Q)) = (n_value =/= 0)
  -- if $request_env_first(Q.ENV, $ptascii("USE_ZEND_ALLOC")) = (ptbytes)
  -- if (n_sign, n_digits*) = $ntsign($nttrim($c_string(ptbytes)))
  -- if DIGITS n_value n_count n_tail* = $ntdigits(n_digits*, 0, 0)

def $executor_free_weak(S, n) = ($weakref_find(S, S.ALLOCATIONS, n) =/= eps \/ $weakmap_key_maps(S, S.ALLOCATIONS, n) =/= eps)
def $executor_free_standard(INSTANCE porigin) = true
def $executor_free_standard(STDINSTANCE) = true
def $executor_free_standard(THROWABLE pthrowable) = true
def $executor_free_standard(pobject) = false -- otherwise
def $executor_free_kind(S, n) = 0
  -- if $executor_free_standard(S.OBJECTS[n]) /\ ~$executor_free_weak(S, n)
def $executor_free_kind(S, n) = 1
  -- if $closure_callable(S, n) /\ ~$executor_free_weak(S, n)
def $executor_free_kind(S, n) = 2 -- otherwise

def $executor_free_edges(eps, pnode) = eps
def $executor_free_edges((HEDGE pnode pnode_child) :: hedge_tail*, pnode) = $executor_free_edges(hedge_tail*, pnode)
def $executor_free_edges((HEDGE pnode_other pnode_child) :: hedge_tail*, pnode) = (HEDGE pnode_other pnode_child) :: $executor_free_edges(hedge_tail*, pnode)
  -- if pnode_other =/= pnode
def $executor_free_mark(HOBJECT n, pnode_marked*) = (HOBJECT n) :: pnode_marked*
def $executor_free_mark(pnode, pnode_marked*) = pnode_marked* -- otherwise

;; All remaining fields stay owned while earlier fields decrement. Marked std
;; headers retain their skipped fields even if a later decrement frees a header.
def $executor_free_body(S, pexecutorfree, pnode) = $executor_free_release(S, pexecutorfree[.HEAP = H[.EDGES = $executor_free_edges(H.EDGES, pnode)][.ROOTS = H.ROOTS ++ pnode_child*]][.MARKED = $executor_free_mark(pnode, pexecutorfree.MARKED)], pnode_child*)
  -- if H = pexecutorfree.HEAP
  -- if pnode_child* = $heap_children(pnode, H.EDGES)
def $executor_free_release(S, pexecutorfree, pnode*) = pexecutorfree
  -- if pexecutorfree.FAILED =/= eps \/ pexecutorfree.UNKNOWN
def $executor_free_release(S, pexecutorfree, eps) = pexecutorfree
  -- if pexecutorfree.FAILED = eps /\ ~pexecutorfree.UNKNOWN
def $executor_free_release(S, pexecutorfree, pnode :: pnode_tail*) = $executor_free_release(S, pexecutorfree_next, pnode_tail*)
  -- if pexecutorfree.FAILED = eps /\ ~pexecutorfree.UNKNOWN
  -- if H = pexecutorfree.HEAP[.ROOTS = $destruction_node_delete(pexecutorfree.HEAP.ROOTS, pnode)]
  -- if pexecutorfree_next = $executor_free_zero(S, pexecutorfree[.HEAP = H], pnode)
  -- if $heap_owners(H, pnode) = 0
def $executor_free_release(S, pexecutorfree, pnode :: pnode_tail*) = $executor_free_release(S, pexecutorfree[.HEAP = H], pnode_tail*)
  -- if pexecutorfree.FAILED = eps /\ ~pexecutorfree.UNKNOWN
  -- if H = pexecutorfree.HEAP[.ROOTS = $destruction_node_delete(pexecutorfree.HEAP.ROOTS, pnode)]
  -- if $($heap_owners(H, pnode) > 0)

;; Visibility precedes zend_call_known_function's inactive-executor failure.
;; The distinct late visibility-warning and other internal hooks remain open.
def $executor_free_zero(S, pexecutorfree, HOBJECT n) = pexecutorfree[.FAILED = (n)]
  -- if ~(n <- S.DESTRUCTION.CALLED)
  -- if $destructor_method(S, n) = (pmethoddesc)
  -- if pmethoddesc.VISIBILITY = PROPERTY_PUBLIC
def $executor_free_zero(S, pexecutorfree, HOBJECT n) = pexecutorfree[.UNKNOWN = true]
  -- if ~(n <- S.DESTRUCTION.CALLED)
  -- if $destructor_method(S, n) = (pmethoddesc)
  -- if pmethoddesc.VISIBILITY =/= PROPERTY_PUBLIC
def $executor_free_zero(S, pexecutorfree, HOBJECT n) = pexecutorfree
  -- if n <- S.DESTRUCTION.CALLED \/ $destructor_method(S, n) = eps
  -- if (HOBJECT n) <- pexecutorfree.MARKED
def $executor_free_zero(S, pexecutorfree, HOBJECT n) = $executor_free_body(S, pexecutorfree, HOBJECT n)
  -- if n <- S.DESTRUCTION.CALLED \/ $destructor_method(S, n) = eps
  -- if ~((HOBJECT n) <- pexecutorfree.MARKED)
  -- if $executor_free_kind(S, n) =/= 2
def $executor_free_zero(S, pexecutorfree, HOBJECT n) = pexecutorfree[.UNKNOWN = true]
  -- if n <- S.DESTRUCTION.CALLED \/ $destructor_method(S, n) = eps
  -- if ~((HOBJECT n) <- pexecutorfree.MARKED)
  -- if $executor_free_kind(S, n) = 2
def $executor_free_zero(S, pexecutorfree, HCELL n) = $executor_free_body(S, pexecutorfree, HCELL n)
def $executor_free_zero(S, pexecutorfree, HARRAY n) = $executor_free_body(S, pexecutorfree, HARRAY n)

def $executor_free_force(S, pexecutorfree, n) = pexecutorfree
  -- if (HOBJECT n) <- pexecutorfree.MARKED
def $executor_free_force(S, pexecutorfree, n) = pexecutorfree[.MARKED = (HOBJECT n) :: pexecutorfree.MARKED]
  -- if ~((HOBJECT n) <- pexecutorfree.MARKED)
  -- if $executor_free_kind(S, n) = 0 /\ $executor_allocator_fast(S.REQUEST)
def $executor_free_force(S, pexecutorfree, n) = $executor_free_body(S, pexecutorfree[.HEAP.ROOTS = pexecutorfree.HEAP.ROOTS ++ [HOBJECT n]], HOBJECT n)
  -- if ~((HOBJECT n) <- pexecutorfree.MARKED)
  -- if $executor_free_kind(S, n) = 1 \/ ($executor_free_kind(S, n) = 0 /\ ~$executor_allocator_fast(S.REQUEST))
def $executor_free_force(S, pexecutorfree, n) = pexecutorfree[.UNKNOWN = true]
  -- if ~((HOBJECT n) <- pexecutorfree.MARKED)
  -- if $executor_free_kind(S, n) = 2
def $executor_free_walk(S, pexecutorfree, n) = pexecutorfree
  -- if pexecutorfree.FAILED =/= eps \/ pexecutorfree.UNKNOWN \/ n = 0
def $executor_free_walk(S, pexecutorfree, n) = $executor_free_walk(S, $executor_free_force(S, pexecutorfree, n_object), n_index)
  -- if pexecutorfree.FAILED = eps /\ ~pexecutorfree.UNKNOWN /\ $(n > 0)
  -- if n_index = $(n - 1)
  -- if $destructor_handle(S, n_index, 0) = (n_object)
  -- if (HOBJECT n_object) <- pexecutorfree.HEAP.NODES
def $executor_free_walk(S, pexecutorfree, n) = $executor_free_walk(S, pexecutorfree, n_index)
  -- if pexecutorfree.FAILED = eps /\ ~pexecutorfree.UNKNOWN /\ $(n > 0)
  -- if n_index = $(n - 1)
  -- if $destructor_handle(S, n_index, 0) = eps

;; E_CORE_ERROR escapes do_cli's request shutdown before main assigns its return;
;; main's outer zend_first_try therefore retains its initial SUCCESS exit0.
def $executor_free_result(S, pexecutorfree) = S_report[.EXITSTATUS = 0][.DESTRUCTION.CALLED = $destructor_all(0, |S.OBJECTS|)]
  -- if pexecutorfree.FAILED = (n)
  -- if $destructor_method(S, n) = (pmethoddesc)
  -- if $class_at(S.CLASSES, pmethoddesc.OWNER) = (pclassdesc)
  -- if ptbytes_message = $ptascii("Couldn't execute method ") ++ $c_string(pclassdesc.NAME) ++ $ptascii("::") ++ pmethoddesc.NAME
  -- if S_report = $shutdown_reported(S, $ptascii("Error"), ptbytes_message, 0, $ptascii("Fatal error: ") ++ ptbytes_message ++ $ptascii(" in Unknown on line 0") ++ $shutdown_fatal_suffix(S[.TRACE = eps], true), true)
def $executor_free_result(S, pexecutorfree) = S[.COMPLETION = UNSUPPORTED "inactive executor storage hook or destructor visibility"]
  -- if pexecutorfree.FAILED = eps /\ pexecutorfree.UNKNOWN
def $executor_free_result(S, pexecutorfree) = S
  -- if pexecutorfree.FAILED = eps /\ ~pexecutorfree.UNKNOWN
def $executor_free_endpoint(S) = true
  -- if S.TODO = eps /\ S.CURRENT = eps /\ S.FRAMES = eps /\ S.OUTPUTBUFFERS = eps
  -- if S.SHUTDOWN.PHASE = SHUTDOWN_DONE /\ S.DESTRUCTION.PHASE = DESTRUCTION_DONE
  -- if S.DESTRUCTION.CALLS = eps /\ S.DESTRUCTION.RELEASES = eps /\ S.DESTRUCTION.FRAMES = eps /\ S.DESTRUCTION.OPERATIONS = eps /\ S.DESTRUCTION.CLEANUPS = eps
  -- if $shutdown_frozen(S.COMPLETION) \/ $output_drain_completion(S.COMPLETION)
def $executor_free_endpoint(S) = false -- otherwise

def $executor_reverse_nodes(eps) = eps
def $executor_reverse_nodes(pnode :: pnode_tail*) = $executor_reverse_nodes(pnode_tail*) ++ [pnode]
def $executor_symbol_nodes(pbinding*, eps) = eps
def $executor_symbol_nodes(pbinding*, preqbytes :: preqbytes_tail*) = $executor_symbol_nodes(pbinding*, preqbytes_tail*) ++ [HCELL n]
  -- if $lookup(pbinding*, preqbytes) = (n)
def $executor_symbol_nodes(pbinding*, preqbytes :: preqbytes_tail*) = $executor_symbol_nodes(pbinding*, preqbytes_tail*)
  -- if $lookup(pbinding*, preqbytes) = eps
def $executor_constant_nodes(eps) = eps
def $executor_constant_nodes(puserconstant :: puserconstant_tail*) = $executor_constant_nodes(puserconstant_tail*) ++ $value_nodes(puserconstant.VALUE)
def $executor_function_nodes(pstaticcell*, pfunction) = $executor_static_nodes(pstaticcell*, pfunction.CODE.UNIT, $static_code_entries(pfunction.CODE.EXPRESSIONS))
def $executor_static_nodes(pstaticcell*, n, eps) = eps
def $executor_static_nodes(pstaticcell*, n, (CODESTATIC pcpath ptbytes z_begin z_bind b) :: pcodeexpr_tail*) = [HCELL n_cell] ++ $executor_static_nodes(pstaticcell*, n, pcodeexpr_tail*)
  -- if $static_at(pstaticcell*, PORIGIN n pcpath) = (n_cell)
def $executor_static_nodes(pstaticcell*, n, (CODESTATIC pcpath ptbytes z_begin z_bind b) :: pcodeexpr_tail*) = $executor_static_nodes(pstaticcell*, n, pcodeexpr_tail*)
  -- if $static_at(pstaticcell*, PORIGIN n pcpath) = eps
def $executor_function_tables(S, eps) = eps
def $executor_function_tables(S, (preqbytes, porigin) :: (preqbytes_tail, porigin_tail)*) = $executor_function_tables(S, (preqbytes_tail, porigin_tail)*) ++ $executor_function_nodes(S.STATICS, pfunction)
  -- if $function_at(S.FUNCTIONS, porigin) = (pfunction)
def $executor_property_nodes(S, eps) = eps
def $executor_property_nodes(S, ppropertydesc :: ppropertydesc_tail*) = $class_static_roots([pclassstatic]) ++ $executor_property_nodes(S, ppropertydesc_tail*)
  -- if ppropertydesc.STATIC
  -- if $class_static_at(S.CLASSSTATICS, ppropertydesc.ORIGIN) = (pclassstatic)
def $executor_property_nodes(S, ppropertydesc :: ppropertydesc_tail*) = $executor_property_nodes(S, ppropertydesc_tail*)
  -- if ~ppropertydesc.STATIC \/ $class_static_at(S.CLASSSTATICS, ppropertydesc.ORIGIN) = eps
def $executor_class_constants(S, eps, porigin) = eps
def $executor_class_constants(S, pclassconstantdesc :: pclassconstantdesc_tail*, porigin) = $value_nodes(pdefaultcache.VALUE) ++ $executor_class_constants(S, pclassconstantdesc_tail*, porigin)
  -- if pclassconstantdesc.OWNER = porigin
  -- if $default_cache_at(S.CLASSCONSTANTCACHE, pclassconstantdesc.ORIGIN) = (pdefaultcache)
def $executor_class_constants(S, pclassconstantdesc :: pclassconstantdesc_tail*, porigin) = $executor_class_constants(S, pclassconstantdesc_tail*, porigin)
  -- if pclassconstantdesc.OWNER =/= porigin \/ $default_cache_at(S.CLASSCONSTANTCACHE, pclassconstantdesc.ORIGIN) = eps
def $executor_class_defaults(eps, porigin) = eps
def $executor_class_defaults(pinstancetemplate :: pinstancetemplate_tail*, porigin) = $instance_default_roots([pinstancetemplate]) ++ $executor_class_defaults(pinstancetemplate_tail*, porigin)
  -- if pinstancetemplate.CLASS = porigin
def $executor_class_defaults(pinstancetemplate :: pinstancetemplate_tail*, porigin) = $executor_class_defaults(pinstancetemplate_tail*, porigin)
  -- if pinstancetemplate.CLASS =/= porigin
def $executor_method_tables(S, eps) = eps
def $executor_method_tables(S, (PPMINHERITED pmethoddesc pclassdesc) :: ppmethodinherited_tail*) = $executor_function_nodes(S.STATICS, pmethoddesc.FUNCTION) ++ $executor_method_tables(S, ppmethodinherited_tail*)
def $executor_static_fresh(eps, pnode_seen*) = eps
def $executor_static_fresh(pnode :: pnode_tail*, pnode_seen*) = $executor_static_fresh(pnode_tail*, pnode_seen*)
  -- if pnode <- pnode_seen*
def $executor_static_fresh(pnode :: pnode_tail*, pnode_seen*) = pnode :: $executor_static_fresh(pnode_tail*, pnode_seen* ++ [pnode])
  -- if ~(pnode <- pnode_seen*)
;; An inherited method shares its static_variables_ptr with its parent. The
;; first reverse class-table visit clears it; fields keep every owning zval.
def $executor_class_tables(S, eps, pnode_seen*) = (eps, pnode_seen*)
def $executor_class_tables(S, (preqbytes, porigin) :: (preqbytes_tail, porigin_tail)*, pnode_seen*) = (pnode_class_tail* ++ $executor_property_nodes(S, pclassdesc.PROPERTIES) ++ $executor_class_constants(S, pclassdesc.CONSTANTS, porigin) ++ $executor_class_defaults(S.INSTANCEDEFAULTS, porigin) ++ pnode_static*, pnode_class_seen* ++ pnode_static*)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if (pnode_class_tail*, pnode_class_seen*) = $executor_class_tables(S, (preqbytes_tail, porigin_tail)*, pnode_seen*)
  -- if pnode_static* = $executor_static_fresh($executor_method_tables(S, $method_info_layout(S, porigin, |S.CLASSES|)), pnode_class_seen*)

;; Binding tables record insertion order separately from their lookup maps.
;; Saved handler stacks are newest-first; zend_stack_clean walks oldest-first.
def $executor_table_nodes(S) = $executor_symbol_nodes(psymboltable.ENV, $symbols_add(psymboltable.SYMBOLS, psymboltable.CVS)) ++ $executor_constant_nodes(S.USERCONSTANTS) ++ $trace_roots(S.ERRORFATALTRACE) ++ pnode_functions* ++ pnode_classes* ++ $error_handler_roots(S.ERRORHANDLER) ++ $exception_handler_roots(S.EXCEPTIONHANDLER) ++ $executor_reverse_nodes($error_handler_stack_roots(S.ERRORHANDLERS)) ++ $executor_reverse_nodes($exception_handler_stack_roots(S.EXCEPTIONHANDLERS))
  -- if psymboltable = $eager_fatal_global(S)
  -- if pnode_functions* = $executor_static_fresh($executor_function_tables(S, S.CALLABLES), eps)
  -- if (pnode_classes*, pnode_visited*) = $executor_class_tables(S, S.CLASSNAMES, pnode_functions*)
def $executor_table_roots(S) = $table_roots(($eager_fatal_global(S))) ++ $user_constant_roots(S.USERCONSTANTS) ++ $trace_roots(S.ERRORFATALTRACE) ++ $static_roots(S.STATICS) ++ $class_static_roots(S.CLASSSTATICS) ++ $instance_default_roots(S.INSTANCEDEFAULTS) ++ $class_constant_roots(S.CLASSCONSTANTCACHE) ++ $error_handler_roots(S.ERRORHANDLER) ++ $exception_handler_roots(S.EXCEPTIONHANDLER) ++ $error_handler_stack_roots(S.ERRORHANDLERS) ++ $exception_handler_stack_roots(S.EXCEPTIONHANDLERS)
def $executor_free_tables(S, pexecutorfree) = pexecutorfree -- if $executor_allocator_fast(S.REQUEST)
def $executor_free_tables(S, pexecutorfree) = $executor_free_release(S, pexecutorfree, pnode_plan*)
  -- if ~$executor_allocator_fast(S.REQUEST)
  -- if pnode_plan* = $executor_table_nodes(S)
  -- if pnode_root* = $executor_table_roots(S)
  -- if $eager_removed(pnode_plan*, pnode_root*) = eps /\ $eager_removed(pnode_root*, pnode_plan*) = eps
def $executor_free_tables(S, pexecutorfree) = pexecutorfree[.UNKNOWN = true] -- otherwise
def $executor_free_finish(S) = $executor_free_result(S, $executor_free_walk(S, $executor_free_tables(S, {HEAP $heap_graph(S), MARKED eps, FAILED eps, UNKNOWN false}), S.DESTRUCTION.NEXT))
  -- if $executor_free_endpoint(S)
  -- if $autoload_roots(S.AUTOLOAD.ENTRIES) = eps
def $executor_free_finish(S) = S[.COMPLETION = UNSUPPORTED "post-output autoload registry release"]
  -- if $executor_free_endpoint(S)
  -- if $autoload_roots(S.AUTOLOAD.ENTRIES) =/= eps

;; php_free_shutdown_functions runs after output deactivation but before
;; EG(active)=0. Transfer each real params/FCC zval once into ordinary eager
;; release, preserving the unfinished C tail if its null-C destructor bails.
dec $executor_queue_targets(pstate, pshutdownentry*) : pshutdownproducer*
dec $executor_queue_receivers(pstate, pshutdownentry*) : nat?*
dec $executor_fcc_nodes(pshutdownproducer, nat?) : pnode*
dec $executor_fcc_extra(pcalltarget, nat?) : pnode*
dec $executor_queue_nodes(pshutdownentry*, pshutdownproducer*, nat?*) : pnode*
dec $executor_targets_valid(pstate, pshutdownentry*, pshutdownproducer*, nat?*) : bool
dec $executor_target_valid(pstate, pshutdownproducer) : bool
dec $executor_queue_valid(pstate, pexecutorqueue) : bool
dec $executor_queue_tasks(ptask*, pexecutorqueue) : bool
dec $executor_queue_frames(pframe*, pexecutorqueue) : bool
dec $executor_queue_active(pstate, pexecutorqueue) : bool
dec $executor_release_source(pstate, pexecutorqueue, pexecutorstage) : bool
dec $executor_queue_begin(pstate) : pstate
dec $executor_queue_release(pstate, pexecutorqueue, pexecutorstage, pnode*) : pstate
dec $executor_abandoned(pstate, pdestructioncleanup) : pexecutorqueue?
dec $executor_caught_finish(pstate, pexecutorqueue, pcompletion) : pstate
dec $executor_pending_cause(pstate, pexecutorqueue, nat) : bool
dec $executor_scope_tasks(pstate, ptask*) : bool
dec $executor_scope_frames(pstate, pframe*) : bool
dec $executor_scope(pstate) : bool
dec $executor_module_owners(pstate) : bool
dec $executor_operation_abandoned(pdestructioncleanup*, pdestructionoperation) : bool
dec $executor_operation_row(pdestructioncleanup, pdestructionoperation) : bool
dec $executor_handler_task(ptask) : bool
dec $executor_handler_tasks(ptask*) : bool
dec $executor_exception_callback(papicallback) : bool
dec $executor_task_queue(ptask) : pexecutorqueue?
dec $executor_scope_task(pstate, ptask) : bool
dec $executor_renderable(pstate, nat) : bool
dec $executor_fatal_boundary(pstate, pdestructioncleanup) : bool

def $executor_queue_targets(S, eps) = eps
def $executor_queue_targets(S, pshutdownentry :: pshutdownentry_tail*) = $eager_cleanup_target(S, pshutdownentry.TARGET) :: $executor_queue_targets(S, pshutdownentry_tail*)
def $executor_queue_receivers(S, eps) = eps
def $executor_queue_receivers(S, pshutdownentry :: pshutdownentry_tail*) = $target_receiver(S, pshutdownentry.TARGET) :: $executor_queue_receivers(S, pshutdownentry_tail*)
def $executor_fcc_extra(CLOSURE_TARGET n, n_receiver?) = $instance_roots(n_receiver?)
def $executor_fcc_extra(pcalltarget, n_receiver?) = eps -- otherwise
def $executor_fcc_nodes(pshutdownproducer, n_receiver?) = $executor_fcc_extra(pshutdownproducer.TARGET, n_receiver?) ++ $target_nodes(pshutdownproducer.TARGET)
def $executor_queue_nodes(eps, eps, eps) = eps
def $executor_queue_nodes(pshutdownentry :: pshutdownentry_tail*, pshutdownproducer :: pshutdownproducer_tail*, n_receiver? :: (n_receiver_tail?)*) = $operands_roots($shutdown_known(pshutdownentry.ARGS)) ++ $executor_fcc_nodes(pshutdownproducer, n_receiver?) ++ $executor_queue_nodes(pshutdownentry_tail*, pshutdownproducer_tail*, (n_receiver_tail?)*)
def $executor_targets_valid(S, eps, eps, eps) = true
def $executor_targets_valid(S, pshutdownentry :: pshutdownentry_tail*, pshutdownproducer :: pshutdownproducer_tail*, n_receiver? :: (n_receiver_tail?)*) = true
  -- if pshutdownproducer.TARGET = pshutdownentry.TARGET
  -- if pshutdownproducer.SITE = eps /\ pshutdownproducer.INTERNAL /\ pshutdownproducer.CLONE = eps
  -- if $consumer_producer_snapshot(pshutdownproducer)
  -- if $executor_target_valid(S, pshutdownproducer)
  -- if S_history = $consumer_producer_history(S, pshutdownproducer)[.ALLOCATIONS = S.ALLOCATIONS ++ $consumer_producer_nodes(pshutdownproducer) ++ $instance_roots(n_receiver?) ++ $operands_roots($shutdown_known(pshutdownentry.ARGS))]
  -- if n_receiver? = $target_receiver(S_history, pshutdownproducer.TARGET)
  -- if $shutdown_entry_valid(S_history, pshutdownentry)
  -- if $executor_targets_valid(S, pshutdownentry_tail*, pshutdownproducer_tail*, (n_receiver_tail?)*)
def $executor_targets_valid(S, pshutdownentry*, pshutdownproducer*, (n_receiver?)*) = false -- otherwise
def $executor_target_valid(S, pshutdownproducer) = (pshutdownproducer = $eager_cleanup_target(S, pshutdownproducer.TARGET))
  -- if $heap_subset($target_nodes(pshutdownproducer.TARGET), S.ALLOCATIONS)
def $executor_target_valid(S, pshutdownproducer) = true
  -- if ~$heap_subset($target_nodes(pshutdownproducer.TARGET), S.ALLOCATIONS)
  -- if S_history = $consumer_producer_history(S, pshutdownproducer)
  -- if $closure_scope_rows_valid(S_history, $consumer_producer_scopes(pshutdownproducer.SCOPE))
  -- if $closure_bindings_valid(S_history, $consumer_producer_bindings(pshutdownproducer.BINDING))
def $executor_target_valid(S, pshutdownproducer) = false -- otherwise
def $executor_queue_valid(S, pexecutorqueue) = true
  -- if S.SHUTDOWN.PHASE = SHUTDOWN_DONE /\ S.DESTRUCTION.PHASE = DESTRUCTION_DONE
  -- if S.OUTPUTBUFFERS = eps /\ S.SHUTDOWN.ENTRIES = eps
  -- if pexecutorqueue.ENTRIES =/= eps
  -- if |pexecutorqueue.ENTRIES| = |pexecutorqueue.TARGETS|
  -- if |pexecutorqueue.ENTRIES| = |pexecutorqueue.RECEIVERS|
  -- if $shutdown_frozen(pexecutorqueue.COMPLETION) \/ $output_drain_completion(pexecutorqueue.COMPLETION)
  -- if $executor_targets_valid(S[.SHUTDOWN.ENTRIES = pexecutorqueue.ENTRIES], pexecutorqueue.ENTRIES, pexecutorqueue.TARGETS, pexecutorqueue.RECEIVERS)
def $executor_queue_valid(S, pexecutorqueue) = false -- otherwise
def $executor_queue_tasks(eps, pexecutorqueue) = false
def $executor_task_queue(EXECUTOR_RELEASE pexecutorqueue pexecutorstage) = (pexecutorqueue)
def $executor_task_queue(ptask) = eps -- otherwise
def $executor_queue_tasks(ptask :: ptask_tail*, pexecutorqueue) = (($executor_task_queue(ptask) = (pexecutorqueue) /\ ptask_tail* = eps) \/ $executor_queue_tasks(ptask_tail*, pexecutorqueue))
def $executor_queue_frames(eps, pexecutorqueue) = false
def $executor_queue_frames(pframe :: pframe_tail*, pexecutorqueue) = ((pframe.CONTEXT = eps /\ $executor_queue_tasks(pframe.TODO, pexecutorqueue)) \/ $executor_queue_frames(pframe_tail*, pexecutorqueue))
def $executor_queue_active(S, pexecutorqueue) = ($executor_queue_valid(S, pexecutorqueue) /\ ((S.CURRENT = eps /\ $executor_queue_tasks(S.TODO, pexecutorqueue)) \/ $executor_queue_frames(S.FRAMES, pexecutorqueue)))
def $output_drain_task(S, EXECUTOR_RELEASE pexecutorqueue pexecutorstage) = $executor_queue_active(S, pexecutorqueue)
def $task_nodes(EXECUTOR_RELEASE pexecutorqueue EXECUTOR_QUEUE) = $executor_queue_nodes(pexecutorqueue.ENTRIES, pexecutorqueue.TARGETS, pexecutorqueue.RECEIVERS)
def $task_nodes(EXECUTOR_RELEASE pexecutorqueue (EXECUTOR_PENDING n)) = [HOBJECT n]
def $task_nodes(EXECUTOR_RELEASE pexecutorqueue EXECUTOR_DONE) = eps
def $call_task_valid(S, EXECUTOR_RELEASE pexecutorqueue EXECUTOR_QUEUE) = ($executor_queue_valid(S, pexecutorqueue) /\ S.CURRENT = eps /\ S.ORIGIN = eps /\ $source_operand_suffix(S.TODO, EXECUTOR_RELEASE pexecutorqueue EXECUTOR_QUEUE, eps) /\ $heap_subset($executor_queue_nodes(pexecutorqueue.ENTRIES, pexecutorqueue.TARGETS, pexecutorqueue.RECEIVERS), S.ALLOCATIONS))
def $call_task_valid(S, EXECUTOR_RELEASE pexecutorqueue (EXECUTOR_PENDING n)) = ($executor_queue_valid(S, pexecutorqueue) /\ S.CURRENT = eps /\ S.ORIGIN = eps /\ $source_operand_suffix(S.TODO, EXECUTOR_RELEASE pexecutorqueue (EXECUTOR_PENDING n), eps) /\ $executor_pending_cause(S, pexecutorqueue, n))
def $call_task_valid(S, EXECUTOR_RELEASE pexecutorqueue EXECUTOR_DONE) = ($executor_queue_valid(S, pexecutorqueue) /\ S.CURRENT = eps /\ S.ORIGIN = eps /\ $source_operand_suffix(S.TODO, EXECUTOR_RELEASE pexecutorqueue EXECUTOR_DONE, eps))
def $executor_queue_begin(S) = S[.TODO = [EXECUTOR_RELEASE pexecutorqueue EXECUTOR_QUEUE]][.SHUTDOWN.ENTRIES = eps][.SHUTDOWN.INDEX = 0][.COMPLETION = NORMAL][.ORIGIN = eps]
  -- if pexecutorqueue = {COMPLETION S.COMPLETION, VALUE S.RESULT, BASE S.BASE, ORIGIN S.ORIGIN, ENTRIES S.SHUTDOWN.ENTRIES, TARGETS $executor_queue_targets(S, S.SHUTDOWN.ENTRIES), RECEIVERS $executor_queue_receivers(S, S.SHUTDOWN.ENTRIES)}
def $output_executor_finish(S) = $executor_queue_begin(S)
  -- if $executor_free_endpoint(S) /\ S.SHUTDOWN.ENTRIES =/= eps /\ ~$executor_module_owners(S)
def $output_executor_finish(S) = $executor_free_finish(S)
  -- if $executor_free_endpoint(S) /\ S.SHUTDOWN.ENTRIES = eps /\ ~$executor_module_owners(S)
def $output_executor_finish(S) = S[.COMPLETION = UNSUPPORTED "post-output module callback-owner release"]
  -- if $executor_free_endpoint(S) /\ $executor_module_owners(S)
def $executor_queue_release(S, pexecutorqueue, pexecutorstage, pnode*) = $eager_operation_begin(S[.TODO = [EXECUTOR_RELEASE pexecutorqueue EXECUTOR_DONE]], S, EXECUTOR_RELEASE pexecutorqueue pexecutorstage, pnode*)
rule PhpStep/executor-queue-release: S ~> $executor_queue_release(S, pexecutorqueue, EXECUTOR_QUEUE, $executor_queue_nodes(pexecutorqueue.ENTRIES, pexecutorqueue.TARGETS, pexecutorqueue.RECEIVERS))
  -- if S.TODO = (EXECUTOR_RELEASE pexecutorqueue EXECUTOR_QUEUE) :: ptask_tail*
  -- if ptask_tail* = eps
  -- if $call_task_valid(S, EXECUTOR_RELEASE pexecutorqueue EXECUTOR_QUEUE)
rule PhpStep/executor-pending-release: S ~> $executor_queue_release(S, pexecutorqueue, EXECUTOR_PENDING n, [HOBJECT n])
  -- if S.TODO = (EXECUTOR_RELEASE pexecutorqueue (EXECUTOR_PENDING n)) :: ptask_tail*
  -- if ptask_tail* = eps
  -- if $call_task_valid(S, EXECUTOR_RELEASE pexecutorqueue (EXECUTOR_PENDING n))
rule PhpStep/executor-release-done: S ~> $executor_free_finish(S[.TODO = eps][.COMPLETION = pexecutorqueue.COMPLETION][.ORIGIN = pexecutorqueue.ORIGIN])
  -- if S.TODO = (EXECUTOR_RELEASE pexecutorqueue EXECUTOR_DONE) :: ptask_tail*
  -- if ptask_tail* = eps
  -- if $call_task_valid(S, EXECUTOR_RELEASE pexecutorqueue EXECUTOR_DONE)
  -- if S.DESTRUCTION.CALLS = eps /\ S.DESTRUCTION.RELEASES = eps /\ S.DESTRUCTION.FRAMES = eps /\ S.DESTRUCTION.OPERATIONS = eps /\ S.DESTRUCTION.CLEANUPS = eps

;; The source snapshot is documentary once the actual release jobs own its
;; zvals. A caught bailout preserves their unfinished tail in ABANDONED.
def $executor_release_source(S, pexecutorqueue, EXECUTOR_QUEUE) = $executor_queue_valid(S, pexecutorqueue)
def $executor_release_source(S, pexecutorqueue, EXECUTOR_PENDING n) = ($executor_queue_valid(S, pexecutorqueue) /\ $shutdown_frozen(pexecutorqueue.COMPLETION) /\ $(n < |S.OBJECTS|))
def $executor_release_source(S, pexecutorqueue, EXECUTOR_DONE) = false
def $eager_operation_source_guard(S, pdestructionoperation) = true
  -- if pdestructionoperation.SOURCE = EXECUTOR_RELEASE pexecutorqueue pexecutorstage
  -- if ($executor_queue_active(S, pexecutorqueue) /\ $executor_release_source(S, pexecutorqueue, pexecutorstage)) \/ ($executor_operation_abandoned(S.DESTRUCTION.ABANDONED, pdestructionoperation) /\ $executor_release_source(S[.DESTRUCTION.PHASE = DESTRUCTION_DONE], pexecutorqueue, pexecutorstage))
  -- if pdestructionoperation.CALLER = eps /\ pdestructionoperation.ORIGIN = eps /\ pdestructionoperation.CONSTCONTEXT = eps
  -- if pdestructionoperation.COMPLETION = NORMAL /\ pdestructionoperation.PENDING = eps
  -- if pdestructionoperation.VALUE = pexecutorqueue.VALUE /\ pdestructionoperation.BASE = pexecutorqueue.BASE
def $executor_operation_abandoned(eps, pdestructionoperation) = false
def $executor_operation_abandoned(pdestructioncleanup :: pdestructioncleanup_tail*, pdestructionoperation) = ($executor_operation_row(pdestructioncleanup, pdestructionoperation) \/ $executor_operation_abandoned(pdestructioncleanup_tail*, pdestructionoperation))
def $executor_operation_row(pdestructioncleanup, pdestructionoperation) = true
  -- if ~pdestructioncleanup.RELEASED
  -- if $eager_bailout_call(pdestructioncleanup.SOURCE) = (pdestructorcall)
  -- if pdestructorcall.OPERATION = (pdestructionoperation)
  -- if ~pdestructorcall.USER /\ pdestructorcall.CALLER = eps /\ pdestructorcall.ORIGIN = eps /\ pdestructorcall.CONSTCONTEXT = eps
def $executor_operation_row(pdestructioncleanup, pdestructionoperation) = false -- otherwise
def $executor_abandoned(S, pdestructioncleanup) = (pexecutorqueue)
  -- if ~pdestructioncleanup.RELEASED
  -- if pdestructioncleanup.SOURCE = DESTRUCTOR_RESULT pdestructorcall
  -- if ~pdestructorcall.USER /\ pdestructorcall.CALLER = eps
  -- if pdestructorcall.OPERATION = (pdestructionoperation)
  -- if pdestructionoperation.SOURCE = EXECUTOR_RELEASE pexecutorqueue pexecutorstage
  -- if $executor_release_source(S, pexecutorqueue, pexecutorstage)
  -- if $eager_cleanup_valid(S, pdestructioncleanup)
def $executor_abandoned(S, pdestructioncleanup) = eps -- otherwise
def $executor_caught(S) = ((pexecutorqueue, S.COMPLETION))
  -- if S.TODO = eps /\ S.CURRENT = eps /\ S.FRAMES = eps /\ S.OUTPUTBUFFERS = eps
  -- if $(|S.DESTRUCTION.ABANDONED| > 0)
  -- if n_last = $nabs($(|S.DESTRUCTION.ABANDONED| - 1))
  -- if $executor_abandoned(S, S.DESTRUCTION.ABANDONED[n_last]) = (pexecutorqueue)
  -- if S.COMPLETION = UNCAUGHT n
  -- if S.EXCEPTIONHANDLER = eps
  -- if $executor_renderable(S, n)
def $executor_renderable(S, n) = true
  -- if $throwable_live(S, n) /\ $throwable_field(S, n, "previous") = PNULL
  -- if $object_name(S, n) =/= $ptascii("ParseError") /\ $object_name(S, n) =/= $ptascii("CompileError")
