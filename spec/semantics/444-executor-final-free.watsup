  -- if $throwable_field(S, n, "string") = PSTRING $throwable_chain_string(S, n, [n])
def $executor_pending_cause(S, pexecutorqueue, n) = false -- otherwise

;; These are earlier, distinct C phases. Never reinterpret a module callback
;; list as an inactive storage hook, or mutate the table being destroyed.
def $executor_scope_tasks(S, eps) = false
def $executor_scope_tasks(S, ptask :: ptask_tail*) = ($executor_scope_task(S, ptask) \/ $executor_scope_tasks(S, ptask_tail*))
def $executor_scope_task(S, EXECUTOR_RELEASE pexecutorqueue pexecutorstage) = $executor_queue_active(S, pexecutorqueue)
def $executor_scope_task(S, ptask) = false -- otherwise
def $executor_scope_frames(S, eps) = false
def $executor_scope_frames(S, pframe :: pframe_tail*) = ($executor_scope_tasks(S, pframe.TODO) \/ $executor_scope_frames(S, pframe_tail*))
def $executor_scope(S) = ($executor_scope_tasks(S, S.TODO) \/ $executor_scope_frames(S, S.FRAMES))
def $executor_module_owners(S) = ($tick_roots(S.TICKENTRIES) ++ $assertion_callback_roots(S.ASSERTCALLBACK) =/= eps)
def $executor_handler_task(EXCEPTION_HANDLER_RESULT pexceptioncall) = true
def $executor_handler_task(EXCEPTION_HANDLER_CLEAN pexceptioncall b) = true
def $executor_exception_callback(API_EXCEPTION pexceptioncall) = true
def $executor_exception_callback(papicallback) = false -- otherwise
def $executor_handler_task(API_CALLBACK_SEND papiargcursor) = $executor_exception_callback(papiargcursor.CALL)
def $executor_handler_task(API_CALLBACK_REF papiargcursor) = $executor_exception_callback(papiargcursor.CALL)
def $executor_handler_task(ERROR_HANDLER_RESULT perrorcall) = $executor_handler_task(perrorcall.RESUME)
def $executor_handler_task(DESTRUCTOR_RESULT pdestructorcall) = $executor_handler_task(pdestructionoperation.SOURCE)
  -- if pdestructorcall.OPERATION = (pdestructionoperation)
def $executor_handler_task(ptask) = false -- otherwise
def $executor_handler_tasks(eps) = false
def $executor_handler_tasks(ptask :: ptask_tail*) = ($executor_handler_task(ptask) \/ $executor_handler_tasks(ptask_tail*))
def $executor_boundary(S) = ("post-output module callback-owner release")
