  -- if pobdeactivate.INDEX = 0 /\ $executor_module_owners(S)
  -- if $call_task_valid(S, OUTPUT_FINAL_DEACTIVATE pobdeactivate)
  -- if S.COMPLETION = NORMAL
def $executor_boundary(S) = ("shutdown-list registration during table destruction")
