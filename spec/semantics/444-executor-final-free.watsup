def $executor_queue_targets(S, eps) = eps
def $executor_queue_targets(S, pshutdownentry :: pshutdownentry_tail*) = $eager_cleanup_target(S, pshutdownentry.TARGET) :: $executor_queue_targets(S, pshutdownentry_tail*)
def $executor_queue_receivers(S, eps) = eps
def $executor_queue_receivers(S, pshutdownentry :: pshutdownentry_tail*) = $target_receiver(S, pshutdownentry.TARGET) :: $executor_queue_receivers(S, pshutdownentry_tail*)
def $executor_queue_nodes(eps) = eps
def $executor_queue_nodes(pshutdownentry :: pshutdownentry_tail*) = $operands_roots($shutdown_known(pshutdownentry.ARGS)) ++ $callback_cache_nodes(pshutdownentry) ++ $executor_queue_nodes(pshutdownentry_tail*)
def $executor_targets_valid(S, eps, eps, eps) = true
def $executor_targets_valid(S, pshutdownentry :: pshutdownentry_tail*, pshutdownproducer :: pshutdownproducer_tail*, n_receiver? :: (n_receiver_tail?)*) = true
  -- if pshutdownproducer.TARGET = pshutdownentry.TARGET
  -- if pshutdownproducer.SITE = eps /\ pshutdownproducer.INTERNAL /\ pshutdownproducer.CLONE = eps
  -- if $consumer_producer_snapshot(pshutdownproducer)
  -- if $executor_target_valid(S, pshutdownproducer)
  -- if S_history = $consumer_producer_history(S, pshutdownproducer)[.ALLOCATIONS = S.ALLOCATIONS ++ $consumer_producer_nodes(pshutdownproducer) ++ $instance_roots(n_receiver?) ++ $operands_roots($shutdown_known(pshutdownentry.ARGS))]
  -- if n_receiver? = $target_receiver(S_history, pshutdownproducer.TARGET)
  -- if $shutdown_entry_valid(S_history, pshutdownentry)
  -- if $executor_targets_valid(S, pshutdownentry_tail*, pshutdownproducer_tail*, (n_receiver_tail?)*)
def $executor_targets_valid(S, pshutdownentry*, pshutdownproducer*, (n_receiver?)*) = false -- otherwise
def $executor_target_valid(S, pshutdownproducer) = (pshutdownproducer = $eager_cleanup_target(S, pshutdownproducer.TARGET))
  -- if $heap_subset($target_nodes(pshutdownproducer.TARGET), S.ALLOCATIONS)
def $executor_target_valid(S, pshutdownproducer) = true
  -- if ~$heap_subset($target_nodes(pshutdownproducer.TARGET), S.ALLOCATIONS)
  -- if S_history = $consumer_producer_history(S, pshutdownproducer)
  -- if $closure_scope_rows_valid(S_history, $consumer_producer_scopes(pshutdownproducer.SCOPE))
  -- if $closure_bindings_valid(S_history, $consumer_producer_bindings(pshutdownproducer.BINDING))
def $executor_target_valid(S, pshutdownproducer) = false -- otherwise
def $executor_queue_valid(S, pexecutorqueue) = true
  -- if S.SHUTDOWN.PHASE = SHUTDOWN_DONE /\ S.DESTRUCTION.PHASE = DESTRUCTION_DONE
  -- if S.OUTPUTBUFFERS = eps /\ S.SHUTDOWN.ENTRIES = eps
  -- if pexecutorqueue.ENTRIES =/= eps
  -- if |pexecutorqueue.ENTRIES| = |pexecutorqueue.TARGETS|
  -- if |pexecutorqueue.ENTRIES| = |pexecutorqueue.RECEIVERS|
  -- if $shutdown_frozen(pexecutorqueue.COMPLETION) \/ $output_drain_completion(pexecutorqueue.COMPLETION)
  -- if $executor_targets_valid(S[.SHUTDOWN.ENTRIES = pexecutorqueue.ENTRIES], pexecutorqueue.ENTRIES, pexecutorqueue.TARGETS, pexecutorqueue.RECEIVERS)
def $executor_queue_valid(S, pexecutorqueue) = false -- otherwise
def $executor_queue_tasks(eps, pexecutorqueue) = false
def $executor_task_queue(EXECUTOR_RELEASE pexecutorqueue pexecutorstage) = (pexecutorqueue)
def $executor_task_queue(ptask) = eps -- otherwise
def $executor_queue_tasks(ptask :: ptask_tail*, pexecutorqueue) = (($executor_task_queue(ptask) = (pexecutorqueue) /\ ptask_tail* = eps) \/ $executor_queue_tasks(ptask_tail*, pexecutorqueue))
def $executor_queue_frames(eps, pexecutorqueue) = false
def $executor_queue_frames(pframe :: pframe_tail*, pexecutorqueue) = ((pframe.CONTEXT = eps /\ $executor_queue_tasks(pframe.TODO, pexecutorqueue)) \/ $executor_queue_frames(pframe_tail*, pexecutorqueue))
def $executor_queue_active(S, pexecutorqueue) = ($executor_queue_valid(S, pexecutorqueue) /\ ((S.CURRENT = eps /\ $executor_queue_tasks(S.TODO, pexecutorqueue)) \/ $executor_queue_frames(S.FRAMES, pexecutorqueue)))
def $output_drain_task(S, EXECUTOR_RELEASE pexecutorqueue pexecutorstage) = $executor_queue_active(S, pexecutorqueue)
def $task_nodes(EXECUTOR_RELEASE pexecutorqueue EXECUTOR_QUEUE) = $executor_queue_nodes(pexecutorqueue.ENTRIES)
def $task_nodes(EXECUTOR_RELEASE pexecutorqueue (EXECUTOR_PENDING n)) = [HOBJECT n]
def $task_nodes(EXECUTOR_RELEASE pexecutorqueue EXECUTOR_DONE) = eps
def $call_task_valid(S, EXECUTOR_RELEASE pexecutorqueue EXECUTOR_QUEUE) = ($executor_queue_valid(S, pexecutorqueue) /\ S.CURRENT = eps /\ S.ORIGIN = eps /\ $source_operand_suffix(S.TODO, EXECUTOR_RELEASE pexecutorqueue EXECUTOR_QUEUE, eps) /\ $heap_subset($executor_queue_nodes(pexecutorqueue.ENTRIES), S.ALLOCATIONS))
def $call_task_valid(S, EXECUTOR_RELEASE pexecutorqueue (EXECUTOR_PENDING n)) = ($executor_queue_valid(S, pexecutorqueue) /\ S.CURRENT = eps /\ S.ORIGIN = eps /\ $source_operand_suffix(S.TODO, EXECUTOR_RELEASE pexecutorqueue (EXECUTOR_PENDING n), eps) /\ $executor_pending_cause(S, pexecutorqueue, n))
def $call_task_valid(S, EXECUTOR_RELEASE pexecutorqueue EXECUTOR_DONE) = ($executor_queue_valid(S, pexecutorqueue) /\ S.CURRENT = eps /\ S.ORIGIN = eps /\ $source_operand_suffix(S.TODO, EXECUTOR_RELEASE pexecutorqueue EXECUTOR_DONE, eps))
def $executor_queue_begin(S) = S[.TODO = [EXECUTOR_RELEASE pexecutorqueue EXECUTOR_QUEUE]][.SHUTDOWN.ENTRIES = eps][.SHUTDOWN.INDEX = 0][.COMPLETION = NORMAL][.ORIGIN = eps]
  -- if pexecutorqueue = {COMPLETION S.COMPLETION, VALUE S.RESULT, BASE S.BASE, ORIGIN S.ORIGIN, ENTRIES S.SHUTDOWN.ENTRIES, TARGETS $executor_queue_targets(S, S.SHUTDOWN.ENTRIES), RECEIVERS $executor_queue_receivers(S, S.SHUTDOWN.ENTRIES)}
;; basic RSHUTDOWN frees copied tick arguments before any independent FCC.object
;; and FCC.closure slots. Keep the registered source as a nonowning snapshot
;; after transferring its roots into the task.
def $executor_tick_nodes(ptickentry) = $operands_roots($shutdown_known(ptickentry.ENTRY.ARGS)) ++ $callback_cache_nodes(ptickentry.ENTRY)
def $executor_tick_completion(S, NORMAL) = (S.SHUTDOWN.COMPLETION = NORMAL /\ S.DESTRUCTION.COMPLETION = NORMAL)
def $executor_tick_completion(S, EXITED z) = (S.SHUTDOWN.COMPLETION = EXITED z /\ S.DESTRUCTION.COMPLETION = EXITED z /\ S.EXITSTATUS = z)
def $executor_tick_completion(S, pcompletion) = false -- otherwise
;; Reporting replaces the actual exit status. A documentary source lookup may
;; restore its saved code; both real phase completions still authenticate it.
def $executor_tick_history(S, EXITED z) = S[.EXITSTATUS = z]
def $executor_tick_history(S, pcompletion) = S -- otherwise
def $executor_tick_ready(S) = true
  -- if S.TICKENTRIES = ptickentry :: ptickentry_tail*
  -- if $executor_tick_completion(S, S.COMPLETION) /\ S.ASSERTCALLBACK = eps
  -- if $tick_entries_valid(S, S.TICKENTRIES, 0)
def $executor_tick_ready(S) = false -- otherwise
def $executor_tick_valid(S, pexecutortick) = true
  -- if S.TICKENTRIES = pexecutortick.TAIL /\ S.ASSERTCALLBACK = eps
  -- if S.SHUTDOWN.PHASE = SHUTDOWN_DONE /\ S.DESTRUCTION.PHASE = DESTRUCTION_DONE
  -- if S.OUTPUTBUFFERS = eps /\ $executor_tick_completion(S, pexecutortick.COMPLETION)
  -- if pexecutortick.ENTRY = ptickentry
  -- if pexecutortick.TARGET = pshutdownproducer
  -- if pshutdownproducer.TARGET = ptickentry.ENTRY.TARGET
  -- if pshutdownproducer.SITE = eps /\ pshutdownproducer.INTERNAL /\ pshutdownproducer.CLONE = eps
  -- if $consumer_producer_snapshot(pshutdownproducer) /\ $executor_target_valid(S, pshutdownproducer)
  -- if S_history = $consumer_producer_history(S, pshutdownproducer)[.ALLOCATIONS = S.ALLOCATIONS ++ $consumer_producer_nodes(pshutdownproducer) ++ $instance_roots(pexecutortick.RECEIVER) ++ $executor_tick_nodes(ptickentry)]
  -- if pexecutortick.RECEIVER = $target_receiver(S_history, pshutdownproducer.TARGET)
  -- if $executor_tick_ready(S_history[.TICKENTRIES = [ptickentry] ++ pexecutortick.TAIL][.COMPLETION = pexecutortick.COMPLETION])
def $executor_tick_valid(S, pexecutortick) = false -- otherwise
def $executor_tick_task(EXECUTOR_TICK_RELEASE pexecutortick b) = (pexecutortick)
def $executor_tick_task(EXECUTOR_TICK_FATAL pexecutortickfatal b) = (pexecutortickfatal.TICK)
def $executor_tick_task(ptask) = eps -- otherwise
def $executor_tick_tasks(eps, pexecutortick) = false
def $executor_tick_tasks(ptask :: ptask_tail*, pexecutortick) = (($executor_tick_task(ptask) = (pexecutortick) /\ ptask_tail* = eps) \/ $executor_tick_tasks(ptask_tail*, pexecutortick))
def $executor_tick_frames(eps, pexecutortick) = false
def $executor_tick_frames(pframe :: pframe_tail*, pexecutortick) = ((pframe.CONTEXT = eps /\ $executor_tick_tasks(pframe.TODO, pexecutortick)) \/ $executor_tick_frames(pframe_tail*, pexecutortick))
def $executor_tick_active(S, pexecutortick) = ($executor_tick_valid(S, pexecutortick) /\ ((S.CURRENT = eps /\ $executor_tick_tasks(S.TODO, pexecutortick)) \/ $executor_tick_frames(S.FRAMES, pexecutortick)))
def $executor_tick_scope_tasks(S, eps) = false
def $executor_tick_scope_tasks(S, ptask :: ptask_tail*) = ($output_drain_task(S, ptask) \/ $executor_tick_scope_tasks(S, ptask_tail*))
  -- if $executor_tick_task(ptask) =/= eps
def $executor_tick_scope_tasks(S, ptask :: ptask_tail*) = $executor_tick_scope_tasks(S, ptask_tail*)
  -- if $executor_tick_task(ptask) = eps
def $executor_tick_scope_frames(S, eps) = false
def $executor_tick_scope_frames(S, pframe :: pframe_tail*) = ($executor_tick_scope_tasks(S, pframe.TODO) \/ $executor_tick_scope_frames(S, pframe_tail*))
def $executor_tick_scope(S) = ($executor_tick_scope_tasks(S, S.TODO) \/ $executor_tick_scope_frames(S, S.FRAMES))
def $output_drain_task(S, EXECUTOR_TICK_RELEASE pexecutortick b) = $executor_tick_active(S, pexecutortick)
def $task_nodes(EXECUTOR_TICK_RELEASE pexecutortick true) = $executor_tick_nodes(pexecutortick.ENTRY)
def $task_nodes(EXECUTOR_TICK_RELEASE pexecutortick false) = eps
def $call_task_valid(S, EXECUTOR_TICK_RELEASE pexecutortick true) = ($executor_tick_valid(S, pexecutortick) /\ S.CURRENT = eps /\ S.ORIGIN = eps /\ $source_operand_suffix(S.TODO, EXECUTOR_TICK_RELEASE pexecutortick true, eps) /\ $heap_subset($executor_tick_nodes(pexecutortick.ENTRY), S.ALLOCATIONS))
def $call_task_valid(S, EXECUTOR_TICK_RELEASE pexecutortick false) = ($executor_tick_valid(S, pexecutortick) /\ S.CURRENT = eps /\ S.ORIGIN = eps /\ $source_operand_suffix(S.TODO, EXECUTOR_TICK_RELEASE pexecutortick false, eps))
def $executor_tick_begin(S) = S[.TODO = [EXECUTOR_TICK_RELEASE pexecutortick true]][.TICKENTRIES = ptickentry_tail*][.COMPLETION = NORMAL][.ORIGIN = eps]
  -- if S.TICKENTRIES = ptickentry :: ptickentry_tail*
  -- if pexecutortick = {COMPLETION S.COMPLETION, VALUE S.RESULT, BASE S.BASE, ORIGIN S.ORIGIN, ENTRY ptickentry, TAIL ptickentry_tail*, TARGET $eager_cleanup_target(S, ptickentry.ENTRY.TARGET), RECEIVER $target_receiver(S, ptickentry.ENTRY.TARGET)}
  -- if $executor_tick_ready(S)
def $output_executor_finish(S) = $executor_tick_begin(S)
  -- if $executor_free_endpoint(S) /\ $executor_tick_ready(S)
def $output_executor_finish(S) = $executor_queue_begin(S)
