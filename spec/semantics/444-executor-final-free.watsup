;; After output deactivation, the pinned fast executor shutdown disables PHP
;; entry and sweeps real object-store handles backwards. It marks every header
;; FREE_CALLED, but only internal free hooks gain a protective count and run.
;; A local graph computes these terminal effects; the final machine keeps its
;; last ownership-valid snapshot, not a claim about process-freed memory.
syntax pexecutorfree = {HEAP hgraph, MARKED pnode*, FAILED nat?, UNKNOWN bool}
dec $executor_free_weak(pstate, nat) : bool
dec $executor_free_standard(pobject) : bool
dec $executor_free_kind(pstate, nat) : nat
dec $executor_free_edges(hedge*, pnode) : hedge*
dec $executor_free_mark(pnode, pnode*) : pnode*
dec $executor_free_body(pstate, pexecutorfree, pnode) : pexecutorfree
dec $executor_free_release(pstate, pexecutorfree, pnode*) : pexecutorfree
dec $executor_free_zero(pstate, pexecutorfree, pnode) : pexecutorfree
dec $executor_free_force(pstate, pexecutorfree, nat) : pexecutorfree
dec $executor_free_walk(pstate, pexecutorfree, nat) : pexecutorfree
dec $executor_free_result(pstate, pexecutorfree) : pstate
dec $executor_allocator_fast(prequest?) : bool
dec $executor_free_endpoint(pstate) : bool

;; getenv takes its first duplicate; ZEND_ATOL reads a signed decimal prefix.
;; Nonfast shutdown has earlier table/registry releases before the store sweep.
def $executor_allocator_fast(eps) = true
def $executor_allocator_fast((Q)) = true
  -- if $request_env_first(Q.ENV, $ptascii("USE_ZEND_ALLOC")) = eps
def $executor_allocator_fast((Q)) = (n_value =/= 0)
  -- if $request_env_first(Q.ENV, $ptascii("USE_ZEND_ALLOC")) = (ptbytes)
  -- if (n_sign, n_digits*) = $ntsign($nttrim($c_string(ptbytes)))
  -- if DIGITS n_value n_count n_tail* = $ntdigits(n_digits*, 0, 0)

def $executor_free_weak(S, n) = ($weakref_find(S, S.ALLOCATIONS, n) =/= eps \/ $weakmap_key_maps(S, S.ALLOCATIONS, n) =/= eps)
def $executor_free_standard(INSTANCE porigin) = true
def $executor_free_standard(STDINSTANCE) = true
def $executor_free_standard(THROWABLE pthrowable) = true
def $executor_free_standard(pobject) = false -- otherwise
def $executor_free_kind(S, n) = 0
  -- if $executor_free_standard(S.OBJECTS[n]) /\ ~$executor_free_weak(S, n)
def $executor_free_kind(S, n) = 1
  -- if $closure_callable(S, n) /\ ~$executor_free_weak(S, n)
def $executor_free_kind(S, n) = 2 -- otherwise

def $executor_free_edges(eps, pnode) = eps
def $executor_free_edges((HEDGE pnode pnode_child) :: hedge_tail*, pnode) = $executor_free_edges(hedge_tail*, pnode)
def $executor_free_edges((HEDGE pnode_other pnode_child) :: hedge_tail*, pnode) = (HEDGE pnode_other pnode_child) :: $executor_free_edges(hedge_tail*, pnode)
  -- if pnode_other =/= pnode
def $executor_free_mark(HOBJECT n, pnode_marked*) = (HOBJECT n) :: pnode_marked*
def $executor_free_mark(pnode, pnode_marked*) = pnode_marked* -- otherwise

;; All remaining fields stay owned while earlier fields decrement. Marked std
;; headers retain their skipped fields even if a later decrement frees a header.
def $executor_free_body(S, pexecutorfree, pnode) = $executor_free_release(S, pexecutorfree[.HEAP = H[.EDGES = $executor_free_edges(H.EDGES, pnode)][.ROOTS = H.ROOTS ++ pnode_child*]][.MARKED = $executor_free_mark(pnode, pexecutorfree.MARKED)], pnode_child*)
  -- if H = pexecutorfree.HEAP
  -- if pnode_child* = $heap_children(pnode, H.EDGES)
def $executor_free_release(S, pexecutorfree, pnode*) = pexecutorfree
  -- if pexecutorfree.FAILED =/= eps \/ pexecutorfree.UNKNOWN
def $executor_free_release(S, pexecutorfree, eps) = pexecutorfree
  -- if pexecutorfree.FAILED = eps /\ ~pexecutorfree.UNKNOWN
def $executor_free_release(S, pexecutorfree, pnode :: pnode_tail*) = $executor_free_release(S, pexecutorfree_next, pnode_tail*)
  -- if pexecutorfree.FAILED = eps /\ ~pexecutorfree.UNKNOWN
  -- if H = pexecutorfree.HEAP[.ROOTS = $destruction_node_delete(pexecutorfree.HEAP.ROOTS, pnode)]
  -- if pexecutorfree_next = $executor_free_zero(S, pexecutorfree[.HEAP = H], pnode)
  -- if $heap_owners(H, pnode) = 0
def $executor_free_release(S, pexecutorfree, pnode :: pnode_tail*) = $executor_free_release(S, pexecutorfree[.HEAP = H], pnode_tail*)
  -- if pexecutorfree.FAILED = eps /\ ~pexecutorfree.UNKNOWN
  -- if H = pexecutorfree.HEAP[.ROOTS = $destruction_node_delete(pexecutorfree.HEAP.ROOTS, pnode)]
  -- if $($heap_owners(H, pnode) > 0)

;; Visibility precedes zend_call_known_function's inactive-executor failure.
;; The distinct late visibility-warning and other internal hooks remain open.
def $executor_free_zero(S, pexecutorfree, HOBJECT n) = pexecutorfree[.FAILED = (n)]
  -- if ~(n <- S.DESTRUCTION.CALLED)
  -- if $destructor_method(S, n) = (pmethoddesc)
  -- if pmethoddesc.VISIBILITY = PROPERTY_PUBLIC
def $executor_free_zero(S, pexecutorfree, HOBJECT n) = pexecutorfree[.UNKNOWN = true]
  -- if ~(n <- S.DESTRUCTION.CALLED)
  -- if $destructor_method(S, n) = (pmethoddesc)
  -- if pmethoddesc.VISIBILITY =/= PROPERTY_PUBLIC
def $executor_free_zero(S, pexecutorfree, HOBJECT n) = pexecutorfree
  -- if n <- S.DESTRUCTION.CALLED \/ $destructor_method(S, n) = eps
  -- if (HOBJECT n) <- pexecutorfree.MARKED
def $executor_free_zero(S, pexecutorfree, HOBJECT n) = $executor_free_body(S, pexecutorfree, HOBJECT n)
  -- if n <- S.DESTRUCTION.CALLED \/ $destructor_method(S, n) = eps
  -- if ~((HOBJECT n) <- pexecutorfree.MARKED)
  -- if $executor_free_kind(S, n) =/= 2
def $executor_free_zero(S, pexecutorfree, HOBJECT n) = pexecutorfree[.UNKNOWN = true]
  -- if n <- S.DESTRUCTION.CALLED \/ $destructor_method(S, n) = eps
  -- if ~((HOBJECT n) <- pexecutorfree.MARKED)
  -- if $executor_free_kind(S, n) = 2
def $executor_free_zero(S, pexecutorfree, HCELL n) = $executor_free_body(S, pexecutorfree, HCELL n)
def $executor_free_zero(S, pexecutorfree, HARRAY n) = $executor_free_body(S, pexecutorfree, HARRAY n)

def $executor_free_force(S, pexecutorfree, n) = pexecutorfree
  -- if (HOBJECT n) <- pexecutorfree.MARKED
def $executor_free_force(S, pexecutorfree, n) = pexecutorfree[.MARKED = (HOBJECT n) :: pexecutorfree.MARKED]
  -- if ~((HOBJECT n) <- pexecutorfree.MARKED)
  -- if $executor_free_kind(S, n) = 0
def $executor_free_force(S, pexecutorfree, n) = $executor_free_body(S, pexecutorfree[.HEAP.ROOTS = pexecutorfree.HEAP.ROOTS ++ [HOBJECT n]], HOBJECT n)
  -- if ~((HOBJECT n) <- pexecutorfree.MARKED)
  -- if $executor_free_kind(S, n) = 1
def $executor_free_force(S, pexecutorfree, n) = pexecutorfree[.UNKNOWN = true]
  -- if ~((HOBJECT n) <- pexecutorfree.MARKED)
  -- if $executor_free_kind(S, n) = 2
def $executor_free_walk(S, pexecutorfree, n) = pexecutorfree
  -- if pexecutorfree.FAILED =/= eps \/ pexecutorfree.UNKNOWN \/ n = 0
def $executor_free_walk(S, pexecutorfree, n) = $executor_free_walk(S, $executor_free_force(S, pexecutorfree, n_object), n_index)
  -- if pexecutorfree.FAILED = eps /\ ~pexecutorfree.UNKNOWN /\ $(n > 0)
  -- if n_index = $(n - 1)
  -- if $destructor_handle(S, n_index, 0) = (n_object)
  -- if (HOBJECT n_object) <- pexecutorfree.HEAP.NODES
def $executor_free_walk(S, pexecutorfree, n) = $executor_free_walk(S, pexecutorfree, n_index)
  -- if pexecutorfree.FAILED = eps /\ ~pexecutorfree.UNKNOWN /\ $(n > 0)
  -- if n_index = $(n - 1)
  -- if $destructor_handle(S, n_index, 0) = eps

;; E_CORE_ERROR escapes do_cli's request shutdown before main assigns its return;
;; main's outer zend_first_try therefore retains its initial SUCCESS exit0.
def $executor_free_result(S, pexecutorfree) = S_report[.EXITSTATUS = 0][.DESTRUCTION.CALLED = $destructor_all(0, |S.OBJECTS|)]
  -- if pexecutorfree.FAILED = (n)
  -- if $destructor_method(S, n) = (pmethoddesc)
  -- if $class_at(S.CLASSES, pmethoddesc.OWNER) = (pclassdesc)
  -- if ptbytes_message = $ptascii("Couldn't execute method ") ++ $c_string(pclassdesc.NAME) ++ $ptascii("::") ++ pmethoddesc.NAME
  -- if S_report = $shutdown_reported(S, $ptascii("Error"), ptbytes_message, 0, $ptascii("Fatal error: ") ++ ptbytes_message ++ $ptascii(" in Unknown on line 0") ++ $shutdown_fatal_suffix(S[.TRACE = eps], true), true)
def $executor_free_result(S, pexecutorfree) = S[.COMPLETION = UNSUPPORTED "inactive executor storage hook or destructor visibility"]
  -- if pexecutorfree.FAILED = eps /\ pexecutorfree.UNKNOWN
def $executor_free_result(S, pexecutorfree) = S
  -- if pexecutorfree.FAILED = eps /\ ~pexecutorfree.UNKNOWN
def $executor_free_endpoint(S) = true
  -- if S.TODO = eps /\ S.CURRENT = eps /\ S.FRAMES = eps /\ S.OUTPUTBUFFERS = eps
  -- if S.SHUTDOWN.PHASE = SHUTDOWN_DONE /\ S.DESTRUCTION.PHASE = DESTRUCTION_DONE
  -- if S.DESTRUCTION.CALLS = eps /\ S.DESTRUCTION.RELEASES = eps /\ S.DESTRUCTION.FRAMES = eps /\ S.DESTRUCTION.OPERATIONS = eps /\ S.DESTRUCTION.CLEANUPS = eps
  -- if $shutdown_frozen(S.COMPLETION) \/ $output_drain_completion(S.COMPLETION)
def $executor_free_endpoint(S) = false -- otherwise
def $output_executor_finish(S) = $executor_free_result(S, $executor_free_walk(S, {HEAP $heap_graph(S), MARKED eps, FAILED eps, UNKNOWN false}, S.DESTRUCTION.NEXT))
  -- if $executor_free_endpoint(S) /\ $executor_allocator_fast(S.REQUEST)
def $output_executor_finish(S) = S[.COMPLETION = UNSUPPORTED "nonfast executor table and storage release"]
  -- if $executor_free_endpoint(S) /\ ~$executor_allocator_fast(S.REQUEST)
