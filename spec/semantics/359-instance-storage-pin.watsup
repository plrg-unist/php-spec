def $property_unset_key(S, POBJECT n, ptbytes, z) = S[.COMPLETION = UNSUPPORTED "freeing instance property access"] -- if $instance_storage_freeing(S, n)
def $property_unset_key_unshared(S, POBJECT n, ptbytes, z) = S[.COMPLETION = UNSUPPORTED "freeing instance property access"] -- if $instance_storage_freeing(S, n)
def $base_acquire(S, BASE_PROPERTY (POBJECT n) ptbytes, z) = S[.COMPLETION = UNSUPPORTED "freeing instance property access"] -- if $instance_storage_freeing(S, n)
def $base_find(S, BASE_PROPERTY (POBJECT n) ptbytes, z) = S[.COMPLETION = UNSUPPORTED "freeing instance property access"] -- if $instance_storage_freeing(S, n)
def $location_write(S, PROPERTY n ptbytes, pvalue) = S[.COMPLETION = UNSUPPORTED "freeing instance property access"] -- if $instance_storage_freeing(S, n)
def $property_bind_prepare(S, n_object, ptbytes, n_cell, z) = S[.COMPLETION = UNSUPPORTED "freeing instance property access"] -- if $instance_storage_freeing(S, n_object)
def $property_bind_commit(S, n_object, ptbytes, n_cell) = S[.COMPLETION = UNSUPPORTED "freeing instance property access"] -- if $instance_storage_freeing(S, n_object)
def $property_reference_fetch(S, n_object, ptbytes, z) = S[.COMPLETION = UNSUPPORTED "freeing instance property access"] -- if $instance_storage_freeing(S, n_object)
def $property_reference_fetch_unshared(S, n_object, ptbytes, z) = S[.COMPLETION = UNSUPPORTED "freeing instance property access"] -- if $instance_storage_freeing(S, n_object)
def $clone_object(S, n_source) = S[.COMPLETION = UNSUPPORTED "freeing instance clone"] -- if $instance_storage_freeing(S, n_source)
def $clone_value(S, POBJECT n, z) = S[.COMPLETION = UNSUPPORTED "freeing instance clone"] -- if $instance_storage_freeing(S, n)
def $clone_receive(S, pclonecall) = S[.COMPLETION = UNSUPPORTED "freeing instance clone"]
  -- if pclonecall.SENT = [NAMED_SENT (KNOWN (POBJECT n)), NAMED_SENT (KNOWN (PARRAY n_array))]
  -- if $instance_storage_freeing(S, n)
  -- if $clone_method(S, n) = eps
def $clone_lifecycle_start(S, n_source, porigin_site, z, pclonecall?) = S[.COMPLETION = UNSUPPORTED "freeing instance clone"] -- if $instance_storage_freeing(S, n_source)
def $cast_value(S, CASTARRAY, POBJECT n, z) = S[.COMPLETION = UNSUPPORTED "freeing instance array cast"] -- if $instance_storage_freeing(S, n)
def $object_foreach_reset(S, n) = S[.COMPLETION = UNSUPPORTED "freeing instance foreach"] -- if $instance_storage_freeing(S, n)
def $object_foreach_select(S, n) = S[.COMPLETION = UNSUPPORTED "freeing instance foreach"] -- if $instance_storage_freeing(S, n)
def $weakref_create(S, n_target) = S[.COMPLETION = UNSUPPORTED "freeing instance new weak reference"] -- if $instance_storage_freeing(S, n_target)
def $value_order(S, POBJECT n_left, POBJECT n_right, pnode_seen*) = ORDERUNSUPPORTED "freeing instance structural comparison"
  -- if n_left =/= n_right
  -- if $instance_storage_freeing(S, n_left) \/ $instance_storage_freeing(S, n_right)
def $value_order_effect(S, POBJECT n_left, POBJECT n_right, pnode_seen*, z) = (S, ORDERUNSUPPORTED "freeing instance structural comparison")
  -- if n_left =/= n_right
  -- if $instance_storage_freeing(S, n_left) \/ $instance_storage_freeing(S, n_right)
def $comparison_result(S, pbin, ORDERUNSUPPORTED text, z) = S[.COMPLETION = UNSUPPORTED text]
