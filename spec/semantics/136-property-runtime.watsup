def $call_task_valid(S, EVAL (NExprPropertyFetch expression phpType20 metadata)) = $property_source_task(S, NExprPropertyFetch expression phpType20 metadata)
def $call_task_valid(S, DIM_PREP (NExprPropertyFetch expression phpType20 metadata)) = $property_source_task(S, NExprPropertyFetch expression phpType20 metadata)
def $call_task_valid(S, UNSET (NExprPropertyFetch expression phpType20 metadata)) = $property_source_task(S, NExprPropertyFetch expression phpType20 metadata)
def $call_task_valid(S, EVAL (NExprAssign (NExprPropertyFetch expression phpType20 metadata_property) expression_value metadata)) = $property_source_task(S, NExprAssign (NExprPropertyFetch expression phpType20 metadata_property) expression_value metadata)
def $call_task_valid(S, ASSIGN_PREP (NExprPropertyFetch expression phpType20 metadata_property) expression_value) = $property_assign_task(S, NExprPropertyFetch expression phpType20 metadata_property, expression_value)
def $call_task_valid(S, PROPERTY_PREP phpType20 z) = $property_prep_task(S, phpType20, z)
def $call_task_valid(S, PROPERTY_NAME pvalue z) = $property_name_task(S, z)
