;; Class descriptors are source facts; each owned object has mutable slots.
dec $property_replace(ppropertydesc*, ppropertydesc) : ppropertydesc*
def $property_replace(eps, ppropertydesc) = [ppropertydesc]
def $property_replace(ppropertydesc_old :: ppropertydesc_tail*, ppropertydesc) = ppropertydesc :: ppropertydesc_tail*
  -- if ppropertydesc_old.NAME = ppropertydesc.NAME
def $property_replace(ppropertydesc_old :: ppropertydesc_tail*, ppropertydesc) = ppropertydesc_old :: $property_replace(ppropertydesc_tail*, ppropertydesc)
  -- if ppropertydesc_old.NAME =/= ppropertydesc.NAME
dec $property_merge(ppropertydesc*, ppropertydesc*) : ppropertydesc*
def $property_merge(ppropertydesc_base*, eps) = ppropertydesc_base*
def $property_merge(ppropertydesc_base*, ppropertydesc :: ppropertydesc_tail*) = $property_merge($property_replace(ppropertydesc_base*, ppropertydesc), ppropertydesc_tail*)

def $property_layout(S, porigin, 0) = eps
def $property_layout(S, porigin, n) = $property_merge(eps, pclassdesc.PROPERTIES)
  -- if $(n > 0)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if $class_link_at(S.LINKEDPARENTS, porigin) = eps
def $property_layout(S, porigin, n) = $property_merge(eps, pclassdesc.PROPERTIES)
  -- if $(n > 0)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if $class_link_at(S.LINKEDPARENTS, porigin) = (STDCLASS_PARENT)
def $property_layout(S, porigin, n) = $property_merge($property_layout(S, porigin_parent, $nabs($(n - 1))), pclassdesc.PROPERTIES)
  -- if $(n > 0)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if $class_link_at(S.LINKEDPARENTS, porigin) = (SOURCE_PARENT porigin_parent)
def $property_layout(S, porigin, n) = eps -- otherwise

dec $property_default_value(ptbranch*, pvalue) : pvalue
def $property_default_value(ptbranch*, PINT i) = PFLOAT $float_of_int(i)
  -- if "float" <- $ptmasks(ptbranch*)
  -- if ~("int" <- $ptmasks(ptbranch*))
def $property_default_value(ptbranch*, pvalue) = pvalue -- otherwise
dec $property_default_state(pstate, ppropertydesc) : ppropstate?
def $property_default_state(S, ppropertydesc) = (PROP_INITIAL)
  -- if ppropertydesc.DEFAULT = PROP_UNINITIALIZED
def $property_default_state(S, ppropertydesc) = (PROP_VALUE (DIRECT PNULL))
  -- if ppropertydesc.DEFAULT = PROP_NULL
def $property_default_state(S, ppropertydesc) = (PROP_VALUE (DIRECT $property_default_value(ppropertydesc.TYPE, pvalue)))
  -- if ppropertydesc.DEFAULT = PROP_STORED porigin
  -- if $pool_value(S.POOLS, porigin) = (pvalue)
def $property_default_state(S, ppropertydesc) = eps
  -- if ppropertydesc.DEFAULT = PROP_STORED porigin
  -- if $pool_value(S.POOLS, porigin) = eps
def $property_initial_slots(S, eps) = (eps)
def $property_initial_slots(S, ppropertydesc :: ppropertydesc_tail*) = ({ DECL (ppropertydesc.ORIGIN), NAME ppropertydesc.NAME, STATE ppropstate } :: ppropertyslot_tail*)
  -- if $property_default_state(S, ppropertydesc) = (ppropstate)
  -- if $property_initial_slots(S, ppropertydesc_tail*) = (ppropertyslot_tail*)
def $property_initial_slots(S, ppropertydesc*) = eps -- otherwise

def $objectprops_at(eps, n) = eps
def $objectprops_at(pobjectprops :: pobjectprops_tail*, n) = (pobjectprops.SLOTS)
  -- if pobjectprops.OBJECT = n
def $objectprops_at(pobjectprops :: pobjectprops_tail*, n) = $objectprops_at(pobjectprops_tail*, n)
  -- if pobjectprops.OBJECT =/= n
def $objectprops_record_at(eps, n) = eps
def $objectprops_record_at(pobjectprops :: pobjectprops_tail*, n) = (pobjectprops)
  -- if pobjectprops.OBJECT = n
def $objectprops_record_at(pobjectprops :: pobjectprops_tail*, n) = $objectprops_record_at(pobjectprops_tail*, n)
  -- if pobjectprops.OBJECT =/= n
def $objectprops_materialized(eps, n) = false
def $objectprops_materialized(pobjectprops :: pobjectprops_tail*, n) = pobjectprops.MATERIALIZED
  -- if pobjectprops.OBJECT = n
def $objectprops_materialized(pobjectprops :: pobjectprops_tail*, n) = $objectprops_materialized(pobjectprops_tail*, n)
  -- if pobjectprops.OBJECT =/= n
dec $objectprops_mark_list(pobjectprops*, nat) : pobjectprops*
def $objectprops_mark_list(eps, n) = eps
def $objectprops_mark_list(pobjectprops :: pobjectprops_tail*, n) = pobjectprops[.MATERIALIZED = true] :: pobjectprops_tail*
  -- if pobjectprops.OBJECT = n
def $objectprops_mark_list(pobjectprops :: pobjectprops_tail*, n) = pobjectprops :: $objectprops_mark_list(pobjectprops_tail*, n)
  -- if pobjectprops.OBJECT =/= n
def $objectprops_mark(S, n) = S[.OBJECTPROPS = $objectprops_mark_list(S.OBJECTPROPS, n)]

def $property_slot_at(eps, ptbytes) = eps
def $property_slot_at(ppropertyslot :: ppropertyslot_tail*, ptbytes) = $property_slot_at(ppropertyslot_tail*, ptbytes)
  -- if ppropertyslot.DECL = eps
  -- if ppropertyslot.STATE = PROP_UNSET
  -- if ppropertyslot.NAME = ptbytes
def $property_slot_at(ppropertyslot :: ppropertyslot_tail*, ptbytes) = (ppropertyslot)
  -- if ppropertyslot.NAME = ptbytes
  -- if ppropertyslot.DECL = (porigin)
def $property_slot_at(ppropertyslot :: ppropertyslot_tail*, ptbytes) = (ppropertyslot)
  -- if ppropertyslot.NAME = ptbytes
  -- if ppropertyslot.DECL = eps
  -- if ppropertyslot.STATE = PROP_VALUE pitem
def $property_slot_at(ppropertyslot :: ppropertyslot_tail*, ptbytes) = $property_slot_at(ppropertyslot_tail*, ptbytes)
  -- if ppropertyslot.NAME =/= ptbytes
def $property_desc_at(eps, ptbytes) = eps
def $property_desc_at(ppropertydesc :: ppropertydesc_tail*, ptbytes) = (ppropertydesc)
  -- if ppropertydesc.NAME = ptbytes
def $property_desc_at(ppropertydesc :: ppropertydesc_tail*, ptbytes) = $property_desc_at(ppropertydesc_tail*, ptbytes)
  -- if ppropertydesc.NAME =/= ptbytes
dec $property_declared_at(ppropertydesc*, porigin) : bool
def $property_declared_at(eps, porigin) = false
def $property_declared_at(ppropertydesc :: ppropertydesc_tail*, porigin) = true
  -- if ppropertydesc.ORIGIN = porigin
def $property_declared_at(ppropertydesc :: ppropertydesc_tail*, porigin) = $property_declared_at(ppropertydesc_tail*, porigin)
  -- if ppropertydesc.ORIGIN =/= porigin
def $property_declaring_name(pclassdesc :: pclassdesc_tail*, porigin) = pclassdesc.NAME
  -- if $property_declared_at(pclassdesc.PROPERTIES, porigin)
def $property_declaring_name(pclassdesc :: pclassdesc_tail*, porigin) = $property_declaring_name(pclassdesc_tail*, porigin)
  -- if ~$property_declared_at(pclassdesc.PROPERTIES, porigin)
def $property_declaring_name(eps, porigin) = eps
dec $property_slot_set(ppropertyslot*, ptbytes, ppropstate) : ppropertyslot*
def $property_slot_set(eps, ptbytes, ppropstate) = eps
def $property_slot_set(ppropertyslot :: ppropertyslot_tail*, ptbytes, ppropstate) = ppropertyslot :: $property_slot_set(ppropertyslot_tail*, ptbytes, ppropstate)
  -- if ppropertyslot.DECL = eps
  -- if ppropertyslot.STATE = PROP_UNSET
  -- if ppropertyslot.NAME = ptbytes
def $property_slot_set(ppropertyslot :: ppropertyslot_tail*, ptbytes, ppropstate) = ppropertyslot[.STATE = ppropstate] :: ppropertyslot_tail*
  -- if ppropertyslot.NAME = ptbytes
  -- if ppropertyslot.DECL = (porigin)
def $property_slot_set(ppropertyslot :: ppropertyslot_tail*, ptbytes, ppropstate) = ppropertyslot[.STATE = ppropstate] :: ppropertyslot_tail*
  -- if ppropertyslot.NAME = ptbytes
  -- if ppropertyslot.DECL = eps
  -- if ppropertyslot.STATE = PROP_VALUE pitem
def $property_slot_set(ppropertyslot :: ppropertyslot_tail*, ptbytes, ppropstate) = ppropertyslot :: $property_slot_set(ppropertyslot_tail*, ptbytes, ppropstate)
  -- if ppropertyslot.NAME =/= ptbytes
dec $objectprops_set(pobjectprops*, nat, ppropertyslot*) : pobjectprops*
def $objectprops_set(eps, n, ppropertyslot*) = eps
def $objectprops_set(pobjectprops :: pobjectprops_tail*, n, ppropertyslot*) = pobjectprops[.SLOTS = ppropertyslot*] :: pobjectprops_tail*
  -- if pobjectprops.OBJECT = n
def $objectprops_set(pobjectprops :: pobjectprops_tail*, n, ppropertyslot*) = pobjectprops :: $objectprops_set(pobjectprops_tail*, n, ppropertyslot*)
  -- if pobjectprops.OBJECT =/= n

def $property_slot_nodes(eps) = eps
def $property_slot_nodes(ppropertyslot :: ppropertyslot_tail*) = $item_nodes(pitem) ++ $property_slot_nodes(ppropertyslot_tail*)
  -- if ppropertyslot.STATE = PROP_VALUE pitem
def $property_slot_nodes(ppropertyslot :: ppropertyslot_tail*) = $property_slot_nodes(ppropertyslot_tail*)
  -- if ppropertyslot.STATE = PROP_INITIAL \/ ppropertyslot.STATE = PROP_UNSET

def $property_entries(eps) = eps
def $property_entries(ppropertyslot :: ppropertyslot_tail*) = (ENTRY (KSTRING ppropertyslot.NAME) pitem) :: $property_entries(ppropertyslot_tail*)
  -- if ppropertyslot.STATE = PROP_VALUE pitem
def $property_entries(ppropertyslot :: ppropertyslot_tail*) = $property_entries(ppropertyslot_tail*)
  -- if ppropertyslot.STATE = PROP_INITIAL \/ ppropertyslot.STATE = PROP_UNSET
def $property_hash_count(eps) = 0
def $property_hash_count(ppropertyslot :: ppropertyslot_tail*) = $property_hash_count(ppropertyslot_tail*)
  -- if ppropertyslot.DECL = eps
  -- if ppropertyslot.STATE = PROP_UNSET
def $property_hash_count(ppropertyslot :: ppropertyslot_tail*) = $(1 + $property_hash_count(ppropertyslot_tail*))
  -- if ppropertyslot.DECL = (porigin)
def $property_hash_count(ppropertyslot :: ppropertyslot_tail*) = $(1 + $property_hash_count(ppropertyslot_tail*))
  -- if ppropertyslot.DECL = eps
  -- if ppropertyslot.STATE = PROP_VALUE pitem
dec $property_positions(ppropertyslot*, nat) : pposition*
def $property_positions(eps, n) = eps
def $property_positions(ppropertyslot :: ppropertyslot_tail*, n) = (POSITION (KSTRING ppropertyslot.NAME) n) :: $property_positions(ppropertyslot_tail*, $(n + 1))
  -- if ppropertyslot.STATE = PROP_VALUE pitem
def $property_positions(ppropertyslot :: ppropertyslot_tail*, n) = $property_positions(ppropertyslot_tail*, n)
  -- if ppropertyslot.STATE = PROP_INITIAL \/ ppropertyslot.STATE = PROP_UNSET
def $property_cast_array(ppropertyslot*) = {ITEMS pentry*, NEXT $(-9223372036854775808), POSITIONS $property_positions(ppropertyslot*, 0), SERIAL n_serial}
  -- if pentry* = $property_entries(ppropertyslot*)
  -- if n_serial = |pentry*|

;; The cursor addresses the live table, so later writes become visible.
def $property_next(eps, n, n_absolute) = eps
def $property_next(ppropertyslot :: ppropertyslot_tail*, 0, n_absolute) = (ppropertyslot.NAME, pitem, $(n_absolute + 1))
  -- if ppropertyslot.STATE = PROP_VALUE pitem
def $property_next(ppropertyslot :: ppropertyslot_tail*, 0, n_absolute) = $property_next(ppropertyslot_tail*, 0, $(n_absolute + 1))
  -- if ppropertyslot.STATE = PROP_INITIAL \/ ppropertyslot.STATE = PROP_UNSET
def $property_next(ppropertyslot :: ppropertyslot_tail*, n, n_absolute) = $property_next(ppropertyslot_tail*, $nabs($(n - 1)), $(n_absolute + 1))
  -- if $(n > 0)

dec $property_slot_valid(pstate, ppropertydesc, ppropertyslot) : bool
def $property_slot_valid(S, ppropertydesc, ppropertyslot) = true
  -- if ppropertyslot.DECL = (ppropertydesc.ORIGIN)
  -- if ppropertyslot.NAME = ppropertydesc.NAME
  -- if ppropertyslot.STATE = PROP_INITIAL
  -- if ppropertydesc.DEFAULT = PROP_UNINITIALIZED
def $property_slot_valid(S, ppropertydesc, ppropertyslot) = true
  -- if ppropertyslot.DECL = (ppropertydesc.ORIGIN)
  -- if ppropertyslot.NAME = ppropertydesc.NAME
  -- if ppropertyslot.STATE = PROP_UNSET
def $property_slot_valid(S, ppropertydesc, ppropertyslot) = true
  -- if ppropertyslot.DECL = (ppropertydesc.ORIGIN)
  -- if ppropertyslot.NAME = ppropertydesc.NAME
  -- if ppropertyslot.STATE = PROP_VALUE (DIRECT pvalue)
  -- if ppropertydesc.TYPE = eps \/ $typed_exact(ppropertydesc.TYPE, pvalue) \/ $typed_object_exact(S, ppropertydesc.TYPE, pvalue)
def $property_slot_valid(S, ppropertydesc, ppropertyslot) = true
  -- if ppropertyslot.DECL = (ppropertydesc.ORIGIN)
  -- if ppropertyslot.NAME = ppropertydesc.NAME
  -- if ppropertyslot.STATE = PROP_VALUE (ALIAS n_cell)
  -- if S.STORE[n_cell] = DEFINED pvalue
  -- if n_cell <- S.REFCELLS
  -- if (HCELL n_cell) <- S.ALLOCATIONS
  -- if ppropertydesc.TYPE = eps \/ $typed_exact(ppropertydesc.TYPE, pvalue) \/ $typed_object_exact(S, ppropertydesc.TYPE, pvalue)
def $property_slot_valid(S, ppropertydesc, ppropertyslot) = false -- otherwise
dec $property_bad_name(ptbytes) : bool
def $property_bad_name(0 :: nat_tail*) = true
def $property_bad_name(ptbytes) = false -- otherwise
def $property_slots_valid(S, eps, eps) = true
def $property_slots_valid(S, eps, ppropertyslot :: ppropertyslot_tail*) = $property_slots_valid(S, eps, ppropertyslot_tail*)
  -- if ppropertyslot.DECL = eps
  -- if ppropertyslot.STATE = PROP_VALUE (DIRECT pvalue)
  -- if ~$property_bad_name(ppropertyslot.NAME)
def $property_slots_valid(S, eps, ppropertyslot :: ppropertyslot_tail*) = $property_slots_valid(S, eps, ppropertyslot_tail*)
  -- if ppropertyslot.DECL = eps
  -- if ppropertyslot.STATE = PROP_VALUE (ALIAS n_cell)
  -- if S.STORE[n_cell] = DEFINED pvalue
  -- if n_cell <- S.REFCELLS
  -- if (HCELL n_cell) <- S.ALLOCATIONS
  -- if ~$property_bad_name(ppropertyslot.NAME)
def $property_slots_valid(S, eps, ppropertyslot :: ppropertyslot_tail*) = $property_slots_valid(S, eps, ppropertyslot_tail*)
  -- if ppropertyslot.DECL = eps
  -- if ppropertyslot.STATE = PROP_UNSET
  -- if ~$property_bad_name(ppropertyslot.NAME)
def $property_slots_valid(S, ppropertydesc :: ppropertydesc_tail*, ppropertyslot :: ppropertyslot_tail*) = ($property_slot_valid(S, ppropertydesc, ppropertyslot) /\ $property_slots_valid(S, ppropertydesc_tail*, ppropertyslot_tail*))
def $property_slots_valid(S, ppropertydesc*, ppropertyslot*) = false -- otherwise
dec $property_slot_named(ppropertyslot*, ptbytes) : bool
def $property_slot_named(eps, ptbytes) = false
def $property_slot_named(ppropertyslot :: ppropertyslot_tail*, ptbytes) = $property_slot_named(ppropertyslot_tail*, ptbytes)
  -- if ppropertyslot.DECL = eps
  -- if ppropertyslot.STATE = PROP_UNSET
  -- if ppropertyslot.NAME = ptbytes
def $property_slot_named(ppropertyslot :: ppropertyslot_tail*, ptbytes) = true
  -- if ppropertyslot.NAME = ptbytes
  -- if ppropertyslot.DECL = (porigin)
def $property_slot_named(ppropertyslot :: ppropertyslot_tail*, ptbytes) = true
  -- if ppropertyslot.NAME = ptbytes
  -- if ppropertyslot.DECL = eps
  -- if ppropertyslot.STATE = PROP_VALUE pitem
def $property_slot_named(ppropertyslot :: ppropertyslot_tail*, ptbytes) = $property_slot_named(ppropertyslot_tail*, ptbytes)
  -- if ppropertyslot.NAME =/= ptbytes
dec $property_unique_names(ppropertyslot*) : bool
def $property_unique_names(eps) = true
def $property_unique_names(ppropertyslot :: ppropertyslot_tail*) = $property_unique_names(ppropertyslot_tail*)
  -- if ppropertyslot.DECL = eps
  -- if ppropertyslot.STATE = PROP_UNSET
def $property_unique_names(ppropertyslot :: ppropertyslot_tail*) = (~$property_slot_named(ppropertyslot_tail*, ppropertyslot.NAME) /\ $property_unique_names(ppropertyslot_tail*))
dec $property_dynamic_no_shadow(ppropertydesc*, ppropertyslot*) : bool
def $property_dynamic_no_shadow(ppropertydesc*, eps) = true
def $property_dynamic_no_shadow(ppropertydesc*, ppropertyslot :: ppropertyslot_tail*) = $property_dynamic_no_shadow(ppropertydesc*, ppropertyslot_tail*)
  -- if ppropertyslot.DECL = (porigin)
def $property_dynamic_no_shadow(ppropertydesc*, ppropertyslot :: ppropertyslot_tail*) = ($property_desc_at(ppropertydesc*, ppropertyslot.NAME) = eps /\ $property_dynamic_no_shadow(ppropertydesc*, ppropertyslot_tail*))
  -- if ppropertyslot.DECL = eps
dec $property_has_dynamic(ppropertyslot*) : bool
def $property_has_dynamic(eps) = false
def $property_has_dynamic(ppropertyslot :: ppropertyslot_tail*) = true
  -- if ppropertyslot.DECL = eps
def $property_has_dynamic(ppropertyslot :: ppropertyslot_tail*) = $property_has_dynamic(ppropertyslot_tail*)
  -- if ppropertyslot.DECL = (porigin)
dec $objectprops_valid(pstate, pobjectprops*) : bool
def $objectprops_valid(S, eps) = true
def $objectprops_valid(S, pobjectprops :: pobjectprops_tail*) = ($property_slots_valid(S, $property_layout(S, porigin, |S.CLASSES|), pobjectprops.SLOTS) /\ $property_unique_names(pobjectprops.SLOTS) /\ $property_dynamic_no_shadow($property_layout(S, porigin, |S.CLASSES|), pobjectprops.SLOTS) /\ (~$property_has_dynamic(pobjectprops.SLOTS) \/ (pobjectprops.MATERIALIZED /\ ~pclassdesc.READONLY)) /\ $objectprops_valid(S, pobjectprops_tail*))
  -- if $(pobjectprops.OBJECT < |S.OBJECTS|)
  -- if $objectprops_at(pobjectprops_tail*, pobjectprops.OBJECT) = eps
  -- if S.OBJECTS[pobjectprops.OBJECT] = INSTANCE porigin
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
def $objectprops_valid(S, pobjectprops :: pobjectprops_tail*) = ($property_slots_valid(S, eps, pobjectprops.SLOTS) /\ $property_unique_names(pobjectprops.SLOTS) /\ (~$property_has_dynamic(pobjectprops.SLOTS) \/ pobjectprops.MATERIALIZED) /\ $objectprops_valid(S, pobjectprops_tail*))
  -- if $(pobjectprops.OBJECT < |S.OBJECTS|)
  -- if $objectprops_at(pobjectprops_tail*, pobjectprops.OBJECT) = eps
  -- if S.OBJECTS[pobjectprops.OBJECT] = STDINSTANCE
def $objectprops_valid(S, pobjectprops*) = false -- otherwise
dec $property_live_complete(pstate, pnode*) : bool
def $property_live_complete(S, eps) = true
def $property_live_complete(S, (HOBJECT n) :: pnode_tail*) = $property_live_complete(S, pnode_tail*)
  -- if $(n < |S.OBJECTS|)
  -- if S.OBJECTS[n] = REALCLOSURE porigin pitem* pstaticcell*
def $property_live_complete(S, (HOBJECT n) :: pnode_tail*) = $property_live_complete(S, pnode_tail*)
  -- if $(n < |S.OBJECTS|)
  -- if S.OBJECTS[n] = NAMEDCLOSURE porigin
def $property_live_complete(S, (HOBJECT n) :: pnode_tail*) = $property_live_complete(S, pnode_tail*)
  -- if $(n < |S.OBJECTS|)
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $objectprops_at(S.OBJECTPROPS, n) = (ppropertyslot*)
def $property_live_complete(S, (HOBJECT n) :: pnode_tail*) = $property_live_complete(S, pnode_tail*)
  -- if $(n < |S.OBJECTS|)
  -- if S.OBJECTS[n] = STDINSTANCE
  -- if $objectprops_at(S.OBJECTPROPS, n) = (ppropertyslot*)
def $property_live_complete(S, (HCELL n) :: pnode_tail*) = $property_live_complete(S, pnode_tail*)
def $property_live_complete(S, (HARRAY n) :: pnode_tail*) = $property_live_complete(S, pnode_tail*)
def $property_live_complete(S, pnode*) = false -- otherwise
def $property_state_valid(S) = ($objectprops_valid(S, S.OBJECTPROPS) /\ $property_live_complete(S, S.ALLOCATIONS) /\ $proprefs_valid(S) /\ $propref_slots_covered(S, S.OBJECTPROPS))

dec $property_strict(pstate) : bool
def $property_strict(S) = pcode.STRICT
  -- if S.ORIGIN = (PORIGIN n pcpath)
  -- if $code_at(S.CODE, n) = (pcode)
def $property_strict(S) = false -- otherwise
dec $property_read(pstate, pvalue, ptbytes, int) : pstate
def $property_read(S, POBJECT n, ptbytes, z) = $throw_scalar(S, "Error", $ptascii("Cannot access property starting with \"\\0\""), z)
  -- if $class_plain_instance(S, n)
  -- if $property_bad_name(ptbytes)
def $property_read(S, POBJECT n, ptbytes, z) = S[.RESULT = KNOWN $entry_value(S, pitem)]
  -- if ~$property_bad_name(ptbytes)
  -- if $objectprops_record_at(S.OBJECTPROPS, n) = (pobjectprops)
  -- if $property_slot_at(pobjectprops.SLOTS, ptbytes) = (ppropertyslot)
  -- if ppropertyslot.STATE = PROP_VALUE pitem
def $property_read(S, POBJECT n, ptbytes, z) = $throw_scalar(S, "Error", $ptascii("Typed property ") ++ $property_declaring_name(S.CLASSES, ppropertydesc.ORIGIN) ++ $ptascii("::$") ++ ptbytes ++ $ptascii(" must not be accessed before initialization"), z)
  -- if ~$property_bad_name(ptbytes)
  -- if $objectprops_record_at(S.OBJECTPROPS, n) = (pobjectprops)
  -- if $property_slot_at(pobjectprops.SLOTS, ptbytes) = (ppropertyslot)
  -- if ppropertyslot.STATE = PROP_INITIAL \/ ppropertyslot.STATE = PROP_UNSET
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $property_desc_at($property_layout(S, porigin, |S.CLASSES|), ptbytes) = (ppropertydesc)
  -- if ppropertydesc.TYPE =/= eps
def $property_read(S, POBJECT n, ptbytes, z) = $diagnostic(S, "Warning", $ptascii("Undefined property: ") ++ $object_name(S, n) ++ $ptascii("::$") ++ ptbytes, z)[.RESULT = KNOWN PNULL]
  -- if ~$property_bad_name(ptbytes)
  -- if $objectprops_record_at(S.OBJECTPROPS, n) = (pobjectprops)
  -- if $property_slot_at(pobjectprops.SLOTS, ptbytes) = eps
def $property_read(S, POBJECT n, ptbytes, z) = $diagnostic(S, "Warning", $ptascii("Undefined property: ") ++ $object_name(S, n) ++ $ptascii("::$") ++ ptbytes, z)[.RESULT = KNOWN PNULL]
  -- if ~$property_bad_name(ptbytes)
  -- if $objectprops_record_at(S.OBJECTPROPS, n) = (pobjectprops)
  -- if $property_slot_at(pobjectprops.SLOTS, ptbytes) = (ppropertyslot)
  -- if ppropertyslot.STATE = PROP_UNSET
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $property_desc_at($property_layout(S, porigin, |S.CLASSES|), ptbytes) = (ppropertydesc)
  -- if ppropertydesc.TYPE = eps
def $property_read(S, POBJECT n, ptbytes, z) = S[.COMPLETION = UNSUPPORTED "Closure property read"]
  -- if ~$property_bad_name(ptbytes)
  -- if ~$class_plain_instance(S, n)
def $property_read(S, pvalue, ptbytes, z) = $diagnostic(S, "Warning", $ptascii("Attempt to read property \"") ++ ptbytes ++ $ptascii("\" on ") ++ $unpack_type_bytes(pvalue), z)[.RESULT = KNOWN PNULL]
  -- if $type_bytes(pvalue) =/= $ptascii("object")

dec $property_quiet(pstate, pvalue, ptbytes, int) : pstate
def $property_quiet(S, POBJECT n, ptbytes, z) = S[.RESULT = KNOWN $entry_value(S, pitem)]
  -- if $objectprops_record_at(S.OBJECTPROPS, n) = (pobjectprops)
  -- if $property_slot_at(pobjectprops.SLOTS, ptbytes) = (ppropertyslot)
  -- if ppropertyslot.STATE = PROP_VALUE pitem
def $property_quiet(S, pvalue, ptbytes, z) = S[.RESULT = KNOWN PNULL] -- otherwise

dec $property_store_value(pstate, nat, ptbytes, pvalue, int) : pstate
dec $property_alias(ppropstate) : bool
def $property_alias(PROP_VALUE (ALIAS n)) = true
def $property_alias(ppropstate) = false -- otherwise
def $property_store_value(S, n, ptbytes, pvalue, z) = $throw_scalar(S, "Error", $ptascii("Cannot access property starting with \"\\0\""), z)
  -- if $property_bad_name(ptbytes)
def $property_store_value(S, n, ptbytes, pvalue, z) = $write_cell_checked(S, n_cell, pvalue, z)
  -- if ~$property_bad_name(ptbytes)
  -- if $objectprops_record_at(S.OBJECTPROPS, n) = (pobjectprops)
