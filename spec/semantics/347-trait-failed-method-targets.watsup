  -- if pclosurescope.CREATION = eps
  -- if $(pclosurescope.OBJECT < |S.OBJECTS|)
  -- if $object_body(S.OBJECTS[pclosurescope.OBJECT]) = METHODCLOSURE porigin_method porigin_site porigin_requested eps
  -- if $class_static_selection_scope_method(S, $dynamic_new_scope_source(S, pdynamicnew), pclosurescope.LEXICAL) = eps
  -- if $trait_fcc_failed_header(S, porigin_site) = ((pconstantclosure_first, pclosurescope.LEXICAL, pmethoddesc_first))
  -- if $closure_method_origin(S, porigin_method) = (pmethoddesc)
  -- if $trait_fcc_scope_owner(S, pmethoddesc, porigin_site, porigin_requested, pclosurescope) = (porigin_requested)
  -- if $dynamic_new_scope_source(S, pdynamicnew) = PORIGIN n_unit pcpath
  -- if $goto_source_owner($all_functions(S), n_unit, pcpath) = (pfunction_source)
