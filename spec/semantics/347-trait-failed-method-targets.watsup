;; A failed link retires its Closure objects, while the source AST keeps the
;; first method pointer. Reconstruct metadata without restoring class publication.
dec $trait_fcc_failed_target(pstate, pconstantclosure) : (porigin, pmethoddesc, pmethoddesc)?
dec $trait_fcc_failed_header(pstate, porigin) : (pconstantclosure, porigin, pmethoddesc)?
dec $trait_fcc_failed_methods(pstate, pconstantclosure*) : pmethoddesc*
dec $trait_fcc_failed_method_select(pstate, pconstantclosure*, (porigin, pmethoddesc, pmethoddesc)?) : pmethoddesc*
dec $trait_fcc_retained_method_functions(pstate, pmethoddesc*) : pfunction*
dec $trait_fcc_retained_function_add(pstate, pmethoddesc, pfunction*) : pfunction*
dec $trait_fcc_failed_data_phase(pcompletion, porigin, pmethoddesc, pmethoddesc) : (porigin, pmethoddesc)?
dec $trait_fcc_failed_data_at(pstate, pconstantclosure, nat) : (pcompletion, porigin, pmethoddesc, pmethoddesc)?
dec $trait_fcc_failed_phase_cache(pstate, pconstantclosure, ptraitcachecause, pdefaultcache*) : pdefaultcache*

def $trait_fcc_failed_target(S, pconstantclosure) = ((ptraitcachecause.CLASS, pmethoddesc_copy, pmethoddesc))
  -- if $(pconstantclosure.OBJECT < |S.OBJECTS|)
  -- if S.OBJECTS[pconstantclosure.OBJECT] = CONSTANTCLOSURE pconstantclosure.SITE (METHODCLOSURE porigin_method pconstantclosure.SITE porigin_owner eps)
  -- if $constant_callable_first(S.CONSTANTCLOSURES, pconstantclosure.SITE) = (pconstantclosure)
  -- if $trait_fcc_retired_receipt(S, pconstantclosure) = (pclassconstantdesc)
  -- if $trait_real_birth_at(S.CLASSCONSTANTHISTORY, pconstantclosure.OBJECT) = ((pconstantclosure.SITE, ptraitcachecause))
  -- if $origin_node(S.SOURCES, pconstantclosure.SITE) = (NExprStaticCall phpType19 phpType20 phpType6 metadata)
  -- if $constant_callable_method_name(phpType20) = (ptbytes_method)
  -- if $trait_fcc_receipt_methods(S, ptraitcachecause) = ((S_copy, ptraitmethod*))
  -- if $class_at(S_copy.CLASSES, ptraitcachecause.CLASS) = (pclassdesc_copy)
  -- if $method_named(pclassdesc_copy.METHODS, $ptlc(ptbytes_method)) = (pmethoddesc_copy)
  -- if $trait_fcc_receipt_target(pmethoddesc_copy, ptraitmethod*) = (pmethoddesc)
  -- if pmethoddesc_copy.FUNCTION.ORIGIN = porigin_method
def $trait_fcc_failed_target(S, pconstantclosure) = eps -- otherwise
def $trait_fcc_failed_header(S, porigin_site) = ((pconstantclosure, porigin_owner, pmethoddesc))
  -- if $constant_callable_first(S.CONSTANTCLOSURES, porigin_site) = (pconstantclosure)
  -- if $trait_fcc_failed_target(S, pconstantclosure) = ((porigin_owner, pmethoddesc_copy, pmethoddesc))
def $trait_fcc_failed_header(S, porigin_site) = eps -- otherwise

;; Trait method scopes are fixed after data binding, before abstract/interface
;; verification. The authenticated first birth has no preceding constant context;
;; replay its data prefix without the later import's active initializer.
def $trait_fcc_failed_fixup_at(S, pconstantclosure, n_prefix) = $trait_fcc_failed_data_phase(pcompletion, porigin_owner, pmethoddesc_copy, pmethoddesc)
  -- if $(pconstantclosure.OBJECT < |S.OBJECTS|)
  -- if $object_body(S.OBJECTS[pconstantclosure.OBJECT]) = METHODCLOSURE porigin_method porigin_site porigin_requested eps
  -- if $trait_imported_origin(porigin_method)
  -- if $trait_fcc_failed_data_at(S, pconstantclosure, n_prefix) = ((pcompletion, porigin_owner, pmethoddesc_copy, pmethoddesc))
  -- if pmethoddesc.OWNER =/= porigin_owner
;; Own methods keep the same scope on both sides of data binding, so their
;; abstract-class proof must use the explicit data completion.
def $trait_fcc_failed_data_at(S, pconstantclosure, n_prefix) = ((S_data.COMPLETION, porigin_owner, pmethoddesc_copy, pmethoddesc))
  -- if $(n_prefix <= |S.DECLARATIONS|)
  -- if $trait_real_birth_at(S.CLASSCONSTANTHISTORY, pconstantclosure.OBJECT) = ((pconstantclosure.SITE, ptraitcachecause))
  -- if porigin_owner = ptraitcachecause.CLASS
  -- if $trait_failed_cache_index(S.DECLARATIONS, porigin_owner, 0) = (n_failed)
  -- if $(n_failed < n_prefix)
  -- if pconstantclosure.PREFIX = n_failed
  -- if $trait_fcc_failed_target(S, pconstantclosure) = ((porigin_owner, pmethoddesc_copy, pmethoddesc))
  -- if $trait_fcc_receipt_methods(S, ptraitcachecause) = ((S_methods, ptraitmethod*))
  -- if pdefaultcache_prefix* = $trait_cache_notice_prefix(S, S.CLASSCONSTANTHISTORY, porigin_owner, n_failed)
  -- if S_before = S_methods[.CLASSCONSTANTCACHE = $trait_fcc_failed_phase_cache(S, pconstantclosure, ptraitcachecause, pdefaultcache_prefix*)][.CLASSCONSTANTINIT = eps][.CONSTCONTEXT = eps][.TODO = [TRAIT_NOTICE_REPLAY porigin_owner n_failed ptraitcachecause.USERPREFIX]]
  -- if $class_at(S_before.CLASSES, porigin_owner) = (pclassdesc_methods)
  -- if $trait_fetch(S_before, $trait_plan(S_before, pclassdesc_methods).TRAITS, eps) = TRAITFETCHED pclassdesc_traits*
  -- if S_constants = $trait_data_constants(S_before, pclassdesc_methods, pclassdesc_traits*, eps)
  -- if $class_at(S_constants.CLASSES, porigin_owner) = (pclassdesc_constants)
  -- if S_data = $trait_data_properties(S_constants, pclassdesc_constants, pclassdesc_traits*, eps)
def $trait_fcc_failed_data_at(S, pconstantclosure, n_prefix) = eps -- otherwise
;; The authenticated direct FCC has no effect beyond its allocation/diagnostic.
;; Its exact first value suffices for scratch data comparisons; no live cache or
;; allocation is restored, and wider initializers keep the complete replay.
def $trait_fcc_failed_phase_cache(S, pconstantclosure, ptraitcachecause, pdefaultcache*) = pdefaultcache* ++ [{ORIGIN pconstantclosure.DECL, VALUE POBJECT pconstantclosure.OBJECT, CLASS PVCLOSURE pconstantclosure.OBJECT pconstantclosure.SITE}]
  -- if $default_cache_at(pdefaultcache*, pconstantclosure.DECL) = eps
  -- if $trait_cache_cause_selected(S, ptraitcachecause) = (pclassconstantdesc)
  -- if pclassconstantdesc.ORIGIN = pconstantclosure.DECL /\ pclassconstantdesc.INITIALIZER = pconstantclosure.SITE
  -- if $class_constant_runtime_type(S, pclassconstantdesc.TYPE, POBJECT pconstantclosure.OBJECT)
def $trait_fcc_failed_phase_cache(S, pconstantclosure, ptraitcachecause, pdefaultcache*) = pdefaultcache* -- otherwise
def $trait_fcc_failed_data_phase(NORMAL, porigin_owner, pmethoddesc_copy, pmethoddesc) = ((porigin_owner, pmethoddesc_copy))
def $trait_fcc_failed_data_phase(pcompletion, porigin_owner, pmethoddesc_copy, pmethoddesc) = ((porigin_owner, pmethoddesc))
  -- if $iterator_notice_link_fatal(pcompletion)
def $trait_fcc_failed_data_phase(REQUESTFATAL ptbytes_class ptbytes_message z, porigin_owner, pmethoddesc_copy, pmethoddesc) = ((porigin_owner, pmethoddesc))
def $trait_fcc_failed_data_phase(pcompletion, porigin_owner, pmethoddesc_copy, pmethoddesc) = eps -- otherwise

def $trait_fcc_fixed_at_known(S, pconstantclosure_first, porigin_first_owner, pmethoddesc_first, n_prefix) = (pmethoddesc)
  -- if $(pconstantclosure_first.PREFIX <= n_prefix /\ n_prefix <= |S.DECLARATIONS|)
  -- if ~$constant_callable_published(S.DECLARATIONS[0:n_prefix], porigin_first_owner)
  -- if pmethoddesc_first.OWNER =/= porigin_first_owner
  -- if $trait_fcc_failed_fixup_at(S, pconstantclosure_first, n_prefix) = ((porigin_first_owner, pmethoddesc))
  -- if pmethoddesc = pmethoddesc_first \/ pmethoddesc = pmethoddesc_first[.OWNER = porigin_first_owner]

;; Ordinary descriptors win. Only missing imported origins are enumerated;
;; an existing own method keeps its canonical descriptor and source identity.
def $trait_fcc_failed_methods(S, eps) = eps
def $trait_fcc_failed_methods(S, pconstantclosure :: pconstantclosure_tail*) = $trait_fcc_failed_method_select(S, pconstantclosure_tail*, $trait_fcc_failed_target(S, pconstantclosure))
def $trait_fcc_failed_method_select(S, pconstantclosure*, ((porigin_owner, pmethoddesc_copy, pmethoddesc))) = pmethoddesc_copy :: $trait_fcc_failed_methods(S, pconstantclosure*)
def $trait_fcc_failed_method_select(S, pconstantclosure*, eps) = $trait_fcc_failed_methods(S, pconstantclosure*)
def $trait_fcc_retained_method_functions(S, eps) = eps
def $trait_fcc_retained_method_functions(S, pmethoddesc :: pmethoddesc_tail*) = $trait_fcc_retained_function_add(S, pmethoddesc, $trait_fcc_retained_method_functions(S, pmethoddesc_tail*))
def $trait_fcc_retained_function_add(S, pmethoddesc, pfunction*) = pmethoddesc.FUNCTION :: pfunction*
  -- if $trait_imported_origin(pmethoddesc.FUNCTION.ORIGIN)
  -- if $class_method_origin(S.CLASSES, pmethoddesc.FUNCTION.ORIGIN) = eps
  -- if $function_at(pfunction*, pmethoddesc.FUNCTION.ORIGIN) = eps
def $trait_fcc_retained_function_add(S, pmethoddesc, pfunction*) = pfunction* -- otherwise
def $trait_fcc_retained_functions(S) = $trait_fcc_retained_method_functions(S, $trait_fcc_failed_methods(S, S.CONSTANTCLOSURES))
def $closure_method_origin(S, porigin) = (pmethoddesc)
  -- if $class_method_origin(S.CLASSES, porigin) = eps
  -- if $method_origin($trait_fcc_failed_methods(S, S.CONSTANTCLOSURES), porigin) = (pmethoddesc)

;; The latent cache becomes usable after the authenticated failure row. It
;; never grants a value or a live scope to the retired first Closure itself.
def $constant_callable_method_cached_at(S, porigin_site, n_prefix) = true
  -- if $(n_prefix <= |S.DECLARATIONS|)
  -- if $constant_callable_first(S.CONSTANTCLOSURES, porigin_site) = (pconstantclosure)
  -- if $trait_real_birth_at(S.CLASSCONSTANTHISTORY, pconstantclosure.OBJECT) = ((porigin_site, ptraitcachecause))
  -- if $trait_failed_cache_index(S.DECLARATIONS, ptraitcachecause.CLASS, 0) = (n_failed)
  -- if $(n_failed < n_prefix)
  -- if $trait_fcc_failed_header(S, porigin_site) = ((pconstantclosure, ptraitcachecause.CLASS, pmethoddesc))
def $constant_callable_cached_method_at(S, porigin_site, n_prefix) = $trait_fcc_fixed_at_known(S, pconstantclosure, porigin_owner, pmethoddesc, n_prefix)
  -- if $trait_fcc_cached_header(S, porigin_site) = eps
  -- if $trait_fcc_failed_header(S, porigin_site) = ((pconstantclosure, porigin_owner, pmethoddesc))
  -- if $(n_prefix <= |S.DECLARATIONS|)
  -- if $trait_failed_cache_index(S.DECLARATIONS, porigin_owner, 0) = (n_failed)
  -- if $(n_failed < n_prefix)
def $constant_callable_cached_method_access(S, porigin_site, porigin_owner, pmethoddesc) = ($trait_fcc_fixed_at_known(S, pconstantclosure, porigin_first_owner, pmethoddesc_first, |S.DECLARATIONS|) = (pmethoddesc))
  -- if $trait_fcc_cached_header(S, porigin_site) = eps
  -- if $trait_fcc_failed_header(S, porigin_site) = ((pconstantclosure, porigin_first_owner, pmethoddesc_first))
  -- if $trait_failed_cache_index(S.DECLARATIONS, porigin_first_owner, 0) = (n_failed)
  -- if $(n_failed < |S.DECLARATIONS|)

def $trait_fcc_source_header_at(S, porigin_site, n_prefix) = ((pconstantclosure, porigin_owner, pmethoddesc))
  -- if $(n_prefix <= |S.DECLARATIONS|)
  -- if $trait_fcc_cached_header(S, porigin_site) = eps
  -- if $trait_fcc_failed_header(S, porigin_site) = ((pconstantclosure, porigin_owner, pmethoddesc))
  -- if $trait_failed_cache_index(S.DECLARATIONS, porigin_owner, 0) = (n_failed)
  -- if $(n_failed < n_prefix)

;; A later published import can fill its constant outside a collision frame.
def $trait_fcc_snapshot_ordinary(S, pconstantclosure) = (pmethoddesc)
  -- if $trait_real_birth_at(S.CLASSCONSTANTHISTORY, pconstantclosure.OBJECT) = eps
  -- if $trait_fcc_failed_header(S, pconstantclosure.SITE) = ((pconstantclosure_first, porigin_first_owner, pmethoddesc_first))
