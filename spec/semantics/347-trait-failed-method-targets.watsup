  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.TARGET = CLOSURE_TARGET n
  -- if pcallcontext.LEXICAL_CLASS = (pclassdesc.ORIGIN)
  -- if $(n < |S.OBJECTS|)
  -- if $object_body(S.OBJECTS[n]) = METHODCLOSURE porigin_method porigin_site porigin_requested eps
  -- if $trait_fcc_failed_header(S, porigin_site) = ((pconstantclosure_first, pclassdesc.ORIGIN, pmethoddesc_first))
  -- if $closure_scope_at(S.CLOSURESCOPES, n) = (pclosurescope)
  -- if pclosurescope.LEXICAL = pclassdesc.ORIGIN
