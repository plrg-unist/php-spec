def $parameter_receive_parent_edge(S, eps) = eps
def $parameter_receive_parent_edge(S, pframe :: pframe_tail*) = ({FRONTIER preceivefrontier, HANDLER pfunction.ORIGIN})
  -- if $parameter_receive_owner(pframe.CONTEXT) =/= eps
