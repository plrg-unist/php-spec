def $parameter_receive_order_at(S, preceivebirth, porigin_site, porigin_scope?, porigin_seen*) = ({LEAVES ([porigin_site]), EFFECTS ([porigin_site])})
  -- if $compiled_redirect(S, porigin_site) = eps
  -- if $parameter_receive_raw_trait(S, preceivebirth, porigin_site, porigin_scope?) \/ $deprecated_constant_source(S, porigin_site, 0) =/= eps
def $parameter_receive_order_at(S, preceivebirth, porigin_site, porigin_scope?, porigin_seen*) = ({LEAVES ([porigin_site]), EFFECTS eps})
  -- if $compiled_redirect(S, porigin_site) = eps
  -- if $deprecated_constant_source(S, porigin_site, 0) = eps
  -- if $origin_node(S.SOURCES, porigin_site) = (pcnode)
