def $parameter_receive_order_at(S, preceivebirth, porigin_site, porigin_scope?, porigin_seen*) = $parameter_receive_order_items(S, preceivebirth, porigin_site, porigin_scope?, 0, phpType13*, porigin_seen*)
  -- if $compiled_redirect(S, porigin_site) = eps
  -- if $origin_node(S.SOURCES, porigin_site) = (NExprArray (SEQUENCE phpType13*) metadata)
