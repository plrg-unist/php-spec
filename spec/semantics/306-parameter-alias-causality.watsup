  -- if $global_constant_method_trait(S, pmethoddesc)
  -- if $method_accessible(S, pmethoddesc, porigin_scope?) /\ pmethoddesc.STATIC /\ ~pmethoddesc.ABSTRACT
def $parameter_receive_raw_trait(S, preceivebirth, porigin_site, porigin_scope?) = false -- otherwise
def $parameter_receive_order(S, preceivebirth, porigin_site, porigin_scope?, porigin_seen*) = $parameter_receive_order_at(S, preceivebirth, porigin_site, porigin_scope?, porigin_seen* ++ [porigin_site])
  -- if ~(porigin_site <- porigin_seen*)
  -- if $compiled_effects(S, porigin_site) = eps
def $parameter_receive_order(S, preceivebirth, porigin_site, porigin_scope?, porigin_seen*) = eps -- otherwise
def $parameter_receive_order_at(S, preceivebirth, porigin_site, porigin_scope?, porigin_seen*) = $parameter_receive_order(S, preceivebirth, porigin_target, porigin_scope?, porigin_seen*)
  -- if $compiled_redirect(S, porigin_site) = ((porigin_target, expression, false, z))
