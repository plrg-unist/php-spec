  -- if $parameter_receive_order_items(S, preceivebirth, porigin_array, porigin_scope?, $(n_index + 1), phpType13*, porigin_seen*) = (preceiveorder_tail)
def $parameter_receive_order_items(S, preceivebirth, porigin_array, porigin_scope?, n_index, phpType13*, porigin_seen*) = eps -- otherwise

def $parameter_receive_frontier(PARAMETER_CONSTANT_METHOD_RESUME porigin_site porigin_function porigin_called n_prefix) = (RECEIVE_METHOD porigin_site porigin_function porigin_called n_prefix)
def $parameter_receive_frontier(DEPRECATED_CONSTANT_RESULT pdeprecatedconstant) = (RECEIVE_DEPRECATED pdeprecatedconstant)
