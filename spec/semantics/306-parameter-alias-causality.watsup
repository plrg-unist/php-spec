;; A receive id belongs to the actual callee until binding or frame departure.
;; Births and registration progress are nonowning; old callable receipts retain
;; their existing authority independently of this active receive lifetime.
syntax preceiveorder = { LEAVES porigin*, EFFECTS porigin* }
dec $parameter_receive_order(pstate, preceivebirth, porigin, porigin?, porigin*) : preceiveorder?
