  -- if $parameter_receive_owner(pframe.CONTEXT) = eps
def $parameter_receive_parent_edge(S, pframe*) = eps -- otherwise
def $parameter_receive_birth(S, n) = (S.PARAMETERRECEIVES[$nabs($(n - 1))])
  -- if $(n > 0) /\ $(n <= |S.PARAMETERRECEIVES|)
def $parameter_receive_birth(S, n) = eps -- otherwise
def $parameter_receive_latest(eps, n_parent?, n, n_latest?) = n_latest?
def $parameter_receive_latest(preceivebirth :: preceivebirth_tail*, n_parent?, n, n_latest?) = $parameter_receive_latest(preceivebirth_tail*, n_parent?, $(n + 1), (n))
  -- if preceivebirth.PARENT = n_parent?
