  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.DEFAULTRECEIVE = eps
  -- if $call_current_valid(S)
def $parameter_receive_entry_valid(S) = false -- otherwise

def $parameter_receive_begin(S, porigin) = S[.PARAMETERSEQ = n][.PARAMETERRECEIVES = S.PARAMETERRECEIVES ++ [{ORIGIN porigin, FUNCTION pcallcontext.FUNCTION, CALLSITE pcallcontext.CALLSITE, PARENT $parameter_receive_parent(S.FRAMES), PARENTINDEX $parameter_receive_parent_index(S, S.FRAMES, |$declaration_context(S, S.CURRENT)|), PARENTEDGE $parameter_receive_parent_edge(S, S.FRAMES), CAUSE $declaration_cause(S), PREFIX (|S.USERCONSTANTS|), PUBLICATION (|S.DECLARATIONS|), ACTIVE true}]][.CURRENT = (pcallcontext[.DEFAULTRECEIVE = ({ID n, PREFIX (|S.USERCONSTANTS|), PUBLICATION (|S.DECLARATIONS|)})])]
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.DEFAULTRECEIVE = eps
  -- if n = $(S.PARAMETERSEQ + 1)
def $parameter_receive_begin(S, porigin) = S -- otherwise
def $parameter_receive_close(S, n) = S[.PARAMETERRECEIVES = S.PARAMETERRECEIVES[0:$nabs($(n - 1))] ++ [preceivebirth[.ACTIVE = false]] ++ S.PARAMETERRECEIVES[n:$nabs($(|S.PARAMETERRECEIVES| - n))]]
  -- if $parameter_receive_birth(S, n) = (preceivebirth)
def $parameter_receive_close(S, n) = S -- otherwise
def $parameter_receive_end(S) = $parameter_receive_close(S[.CURRENT = (pcallcontext[.DEFAULTRECEIVE = eps])], n)
  -- if S.CURRENT = (pcallcontext)
  -- if $parameter_receive_owner((pcallcontext)) = (n)
def $parameter_receive_end(S) = S -- otherwise
;; This is applied only to the raw restored branch. Deferred releases which
;; return the old callee state keep its receive alive until actual restoration.
def $parameter_receive_restored(S_before, S_after) = $parameter_receive_close(S_after, n)
  -- if $parameter_receive_owner(S_before.CURRENT) = (n)
  -- if $parameter_receive_owner(S_after.CURRENT) =/= (n)
def $parameter_receive_restored(S_before, S_after) = S_after -- otherwise

