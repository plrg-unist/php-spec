  -- if $method_accessible(S, pmethoddesc, porigin_scope?) /\ pmethoddesc.STATIC /\ ~pmethoddesc.ABSTRACT
  -- if $global_constant_method_trait(S, pmethoddesc)
def $parameter_receive_frontier_valid(S, preceivebirth, porigin_scope?, RECEIVE_DEPRECATED pdeprecatedconstant) = true
  -- if $(preceivebirth.PREFIX <= pdeprecatedconstant.PREFIX) /\ $(pdeprecatedconstant.PREFIX <= |S.USERCONSTANTS|)
  -- if $constant_expression_root(S, preceivebirth.ORIGIN) = (porigin_initializer)
  -- if $function_at($all_functions(S), preceivebirth.FUNCTION) = (pfunction)
  -- if $default_origin_at(pfunction.DEFAULTS, porigin_initializer) = (pdefault)
  -- if pconstantcontext = {ORIGIN preceivebirth.ORIGIN, LINE $default_parameter_line(S, pfunction.ORIGIN, pdefault.INDEX), FACTS eps}
  -- if $deprecated_constant_source(S[.CONSTCONTEXT = (pconstantcontext)], pdeprecatedconstant.SITE, pdeprecatedconstant.PREFIX) = (pdeprecatedconstant.LINE)
def $parameter_receive_frontier_valid(S, preceivebirth, porigin_scope?, preceivefrontier) = false -- otherwise

;; Each successful append captures the real suspended callback frontier once.
;; These source/id records contain no retained PHP values or heap owners.
dec $parameter_receive_capture(pstate, pframe, pframe*, pdeclcause, nat) : preceivecut*
