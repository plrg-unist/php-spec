;; Literal array projection follows immutable source keys after its temporary
;; array and initializer facts have retired. Duplicate keys select the last item.
dec $property_callable_projection(pstate, porigin) : porigin?
dec $property_callable_projection_items(pstate, porigin, nat, phpType13*, pkey, int, porigin?) : porigin?
dec $property_callable_projection_select(porigin?, porigin, pkey, pkey) : porigin?
def $property_callable_projection_select(porigin_selected?, porigin_value, pkey_item, pkey_target) = (porigin_value)
  -- if pkey_item = pkey_target
def $property_callable_projection_select(porigin_selected?, porigin_value, pkey_item, pkey_target) = porigin_selected?
  -- if pkey_item =/= pkey_target
def $property_callable_projection_items(S, porigin_array, n, eps, pkey, i, porigin_selected?) = porigin_selected?
def $property_callable_projection_items(S, porigin_array, n, (NArrayItem phpType5 expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType13*, pkey, i, porigin_selected?) = $property_callable_projection_items(S, porigin_array, $(n + 1), phpType13*, pkey, $next_history(i, pkey_item), $property_callable_projection_select(porigin_selected?, porigin_value, pkey_item, pkey))
  -- if porigin_item = $constant_child(porigin_array, [PCFIELD 0, PCINDEX n])
  -- if $constant_callable_flow_key(S, porigin_item, phpType5, i) = (pkey_item)
  -- if porigin_value = $constant_child(porigin_item, [PCFIELD 1])
def $property_callable_projection_items(S, porigin_array, n, phpType13*, pkey, i, porigin_selected?) = eps -- otherwise
def $property_callable_projection(S, porigin) = $property_callable_projection_items(S, $constant_child(porigin, [PCFIELD 0]), 0, phpType13*, S_key.KEY, $(-9223372036854775808), eps)
  -- if $origin_node(S.SOURCES, porigin) = (NExprArrayDimFetch (NExprArray (SEQUENCE phpType13*) metadata_array) expression_key metadata)
  -- if $compiled_read(S, $constant_child(porigin, [PCFIELD 1])) = (pvalue_key)
  -- if S_key = $key_value($initial_state(NORMAL), pvalue_key, true, 1)
  -- if S_key.COMPLETION = NORMAL
def $property_callable_projection(S, porigin) = eps -- otherwise
def $constant_callable_flow_at(S, porigin, porigin_owner, pvalueclass, n_prefix, porigin_seen*) = $constant_callable_flow(S, porigin_target, porigin_owner, pvalueclass, n_prefix, porigin_seen*)
  -- if $compiled_redirect(S, porigin) = eps
  -- if ~$constant_callable_foldable(pvalueclass)
  -- if ~$trait_cache_dim_active(S, porigin, porigin_owner, pvalueclass, n_prefix)
  -- if $property_callable_projection(S, porigin) = (porigin_target)

