;; Binding certificates contain only value-class/object identities. A copied
;; certificate freezes the successful parent binding seen at the child's link.
def $instance_default_value(INSTANCE_VALUE pvalue pvalueclass) = ((pvalue, pvalueclass))
def $instance_default_value(INSTANCE_OBJECT_VALUE pvalue pvalueclass pinstanceobjectcertificate) = ((pvalue, pvalueclass))
def $instance_default_value(pinstancetemplatestate) = eps -- otherwise
