  -- if n_prefix = |S.DECLARATIONS|
def $instance_default_copy_state(S, porigin_class, pinstancetemplatestate) = pinstancetemplatestate -- otherwise
def $instance_default_bound_state(S, porigin_class, pstaticdefaultcontext, ppropertydesc, pvalue, pvalueclass) = INSTANCE_VALUE $property_default_value(ppropertydesc.TYPE, pvalue) pvalueclass
  -- if $constant_callable_foldable(pvalueclass)
def $instance_default_bound_state(S, porigin_class, pstaticdefaultcontext, ppropertydesc, pvalue, pvalueclass) = INSTANCE_OBJECT_VALUE $property_default_value(ppropertydesc.TYPE, pvalue) pvalueclass (INSTANCE_OBJECT_BIND porigin_class pstaticdefaultcontext.DECL pstaticdefaultcontext.ROOT porigin_trigger $class_static_selection_at(S.TODO) pvalueclass n_prefix n_history)
  -- if ~$constant_callable_foldable(pvalueclass)
  -- if pstaticdefaultcontext.ORIGIN = (porigin_trigger)
  -- if n_prefix = |S.DECLARATIONS|
  -- if n_history = |S.CLASSCONSTANTHISTORY ++ $instance_default_record(S, porigin_class, pstaticdefaultcontext)|

