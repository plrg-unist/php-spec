;; Ordinary CV reads at CAST, QM_ASSIGN and by-value SEND boundaries.
;; Callback mutation cannot turn the interrupted uninitialized value into a read
;; of the newly defined CV. Targets and already supplied arguments stay captured.
dec $error_cast_source(pcnode) : pcast?
def $error_cast_source(NExprCastBool expression metadata) = (CASTBOOL)
def $error_cast_source(NExprCastInt expression metadata) = (CASTINT)
def $error_cast_source(NExprCastDouble expression metadata) = (CASTFLOAT)
def $error_cast_source(NExprCastString expression metadata) = (CASTSTRING)
def $error_cast_source(NExprCastArray expression metadata) = (CASTARRAY)
def $error_cast_source(NExprCastObject expression metadata) = (CASTOBJECT)
def $error_cast_source(pcnode) = eps -- otherwise
def $error_simple_read(CAST_RESULT pcast z) = true
def $error_simple_read(VALUE_COPY z) = true
def $error_simple_read(CALL_SEND pcalltarget phpType7* n poperand* porigin? z) = true
def $error_simple_read(NAMED_SEND pcalltarget phpType7* n pnamedargs porigin? z) = true
def $error_simple_read(UNPACK_SEND punpackcall) = true
def $error_read_line(CAST_RESULT pcast z, z_origin) = z
def $error_read_line(VALUE_COPY z, z_origin) = z
def $error_read_line(CALL_SEND pcalltarget phpType7* n poperand* porigin? z, z_origin) = z_origin
def $error_read_line(NAMED_SEND pcalltarget phpType7* n pnamedargs porigin? z, z_origin) = z_origin
def $error_read_line(UNPACK_SEND punpackcall, z_origin) = z_origin

def $error_read_source(S, perrorread) = true
  -- if S.ORIGIN = (porigin)
  -- if perrorread.ORIGINAL = CAST_RESULT pcast z
  -- if $origin_node(S.SOURCES, porigin) = (pcnode)
  -- if $error_cast_source(pcnode) = (pcast)
  -- if $error_variable_source(S, S.ORIGIN, [PCFIELD 0], perrorread.NAME)
  -- if $code_expression_at_source(S, porigin, [PCFIELD 0]) = (z)
  -- if perrorread.LINE = z

dec $error_copy_arm(pstate, porigin, pcpath, preqbytes, int) : bool
dec $error_copy_condition(pstate, porigin) : bool?
def $error_copy_condition(S, porigin) = ($truth(S, pvalue))
  -- if $origin_node(S.SOURCES, porigin) = (NExprTernary expression_cond phpType5 expression_false metadata)
  -- if $origin_child((porigin), [PCFIELD 0]) = (porigin_cond)
  -- if $compiled_read(S, porigin_cond) = (pvalue)
def $error_copy_condition(S, porigin) = eps -- otherwise
dec $error_copy_selected(pstate, porigin, pcpath) : bool
def $error_copy_selected(S, porigin, pcpath) = true
  -- if $compiled_redirect(S, porigin) = eps
  -- if $error_copy_condition(S, porigin) = eps
def $error_copy_selected(S, porigin, [PCFIELD 1]) = true
  -- if $compiled_redirect(S, porigin) = eps
  -- if $error_copy_condition(S, porigin) = (true)
def $error_copy_selected(S, porigin, [PCFIELD 2]) = true
  -- if $compiled_redirect(S, porigin) = eps
  -- if $error_copy_condition(S, porigin) = (false)
def $error_copy_selected(S, porigin, pcpath) = true
  -- if $compiled_redirect(S, porigin) = ((porigin_target, expression, false, z))
  -- if $origin_child((porigin), pcpath) = (porigin_target)
def $error_copy_selected(S, porigin, pcpath) = false -- otherwise
def $error_copy_arm(S, porigin, pcpath, n*, z) = ($error_copy_selected(S, porigin, pcpath) /\ $error_variable_source(S, (porigin), pcpath, n*) /\ $code_expression_at_source(S, porigin, pcpath) = (z))
def $error_read_source(S, perrorread) = true
  -- if S.ORIGIN = (porigin)
  -- if perrorread.ORIGINAL = VALUE_COPY z
  -- if $origin_node(S.SOURCES, porigin) = (NExprTernary expression_cond phpType5 expression_false metadata)
  -- if $error_copy_arm(S, porigin, [PCFIELD 1], perrorread.NAME, z) \/ $error_copy_arm(S, porigin, [PCFIELD 2], perrorread.NAME, z)
  -- if perrorread.LINE = z
def $error_read_source(S, perrorread) = true
  -- if S.ORIGIN = (porigin)
  -- if perrorread.ORIGINAL = VALUE_COPY z
  -- if $origin_node(S.SOURCES, porigin) = (NExprBinaryOpCoalesce expression_left expression_right metadata)
  -- if $error_copy_arm(S, porigin, [PCFIELD 1], perrorread.NAME, z)
