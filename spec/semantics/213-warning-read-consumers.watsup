;; The selected target and source-order argument are certified before dispatch.
;; Named-slot errors precede the CV read, as in zend_handle_named_arg.
def $error_read_source(S, perrorread) = true
  -- if perrorread.ORIGINAL = CALL_SEND pcalltarget phpType7_tail* n poperand* (porigin) z
  -- if S.ORIGIN = (porigin)
  -- if $call_task_valid(S, perrorread.ORIGINAL)
  -- if $call_argument_source(S, porigin) = PCALLARGUMENTS phpType7* n_field
  -- if phpType7*[n] = NArg ABSENT expression (BOOLEAN false) (BOOLEAN false) metadata
  -- if ~$call_parameter_reference(S, pcalltarget, n)
  -- if $error_variable_source(S, (porigin), [PCFIELD n_field, PCINDEX n, PCFIELD 1], perrorread.NAME)
  -- if perrorread.LINE = $call_send_line(S, (porigin), n)
dec $error_named_send_source(pstate, perrorread, pcalltarget, pnamedargs, porigin?, nat) : bool
def $error_named_send_source(S, perrorread, pcalltarget, pnamedargs, (porigin), n) = true
  -- if S.ORIGIN = (porigin)
  -- if $call_task_valid(S, perrorread.ORIGINAL)
  -- if $target_function(S, pcalltarget) = (pfunction)
  -- if $call_argument_source(S, porigin) = PCALLARGUMENTS phpType7* n_field
  -- if phpType7*[n] = NArg phpType3 expression (BOOLEAN false) (BOOLEAN false) metadata
  -- if pnamedtarget = $named_arg_target(pfunction, phpType7*[n], |pnamedargs.SLOTS|)
  -- if ~$named_reference(pfunction, pnamedtarget)
  -- if $named_check(S[.COMPLETION = NORMAL], pnamedargs, pnamedtarget, phpType7*[n], $named_line(S, (porigin), n)).COMPLETION = NORMAL
  -- if $error_variable_source(S, (porigin), [PCFIELD n_field, PCINDEX n, PCFIELD 1], perrorread.NAME)
  -- if perrorread.LINE = $named_line(S, (porigin), n)
def $error_named_send_source(S, perrorread, pcalltarget, pnamedargs, porigin?, n) = false -- otherwise
def $error_read_source(S, perrorread) = $error_named_send_source(S, perrorread, pcalltarget, pnamedargs, porigin?, n)
  -- if perrorread.ORIGINAL = NAMED_SEND pcalltarget phpType7_tail* n pnamedargs porigin? z
def $error_read_source(S, perrorread) = $error_named_send_source(S, perrorread, punpackcall.FUNCTION, punpackcall.SENT, punpackcall.CALLSITE, punpackcall.INDEX)
  -- if perrorread.ORIGINAL = UNPACK_SEND punpackcall

;; ASSIGN writes through its destination before checking the pending exception.
;; CAST/QM_ASSIGN/SEND only write their null temporary/argument; later consumers
;; are retired. Rejected constrained writes replace and chain the pending error.
dec $error_assign_throw(pstate, preqbytes) : pstate
dec $error_assign_rejected(pstate, pstate) : pstate
def $error_assign_throw(S, n*) = S_written
  -- if S_written = $scope_write_name(S, [PCFIELD 0], n*, PNULL)
  -- if S_written.COMPLETION = NORMAL
def $error_assign_throw(S, n*) = $error_assign_rejected(S, S_written)
  -- if S_written = $scope_write_name(S, [PCFIELD 0], n*, PNULL)
  -- if S_written.COMPLETION =/= NORMAL
def $error_read_discard(S, ERROR_READ_RESULT perrorread) = $error_assign_throw(S, n*)
  -- if S.TODO = (THROW_SEARCH n_throwable) :: ptask_tail*
  -- if S.COMPLETION = NORMAL
  -- if perrorread.ORIGINAL = WRITE_NAME n* z
  -- if $error_read_valid(S, perrorread)
