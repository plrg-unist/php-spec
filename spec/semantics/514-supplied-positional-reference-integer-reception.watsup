;; Each RECV snapshots its current referent after earlier receive callbacks.
;; Caller/formal aliases own the marked cell; this snapshot adds no owner.
dec $lossy_positional_reference_parameters(psparam*) : bool
def $lossy_positional_reference_parameters(eps) = true
def $lossy_positional_reference_parameters(psparam :: psparam_tail*) = (psparam.REQUIRED /\ psparam.DEFAULT = PSNONE /\ psparam.BYREF /\ ~psparam.VARIADIC /\ $ptmasks(psparam.TYPE) = ["int"] /\ $lossy_positional_reference_parameters(psparam_tail*))

dec $lossy_positional_arguments(phpType7*) : bool
def $lossy_positional_arguments(eps) = true
def $lossy_positional_arguments((NArg ABSENT (NExprVariable (BYTES text) metadata_variable) (BOOLEAN false) (BOOLEAN false) metadata_argument) :: phpType7*) = true
  -- if $cv_name(BYTES text) = (preqbytes)
  -- if preqbytes =/= $ptascii("this") /\ preqbytes =/= $ptascii("http_response_header")
  -- if ~$psautoglobal(preqbytes)
  -- if $lossy_positional_arguments(phpType7*)
def $lossy_positional_arguments(phpType7*) = false -- otherwise

dec $lossy_positional_reference_parameter_metadata(pstate, porigin, nat, int) : bool
def $lossy_positional_reference_parameter_metadata(S, porigin_function, n, z) = true
