  -- if $(pcallcontext.ARGC > 0) /\ $(n < pcallcontext.ARGC)
  -- if pcallcontext.HOLES = eps /\ pcallcontext.EXTRA = eps /\ pcallcontext.NAMED = eps
  -- if pcallcontext.CALLSITE = (porigin_call)
  -- if $origin_node(S.SOURCES, porigin_call) = (NExprFuncCall phpType19 (SEQUENCE phpType7*) metadata_call)
  -- if |phpType7*| = pcallcontext.ARGC /\ $lossy_positional_arguments(phpType7*)
  -- if $call_selected_valid(S, porigin_function, (porigin_call))
  -- if $function_at(S.FUNCTIONS, porigin_function) = (pfunction)
  -- if ~pfunction.SIGNATURE.BYREF /\ ~$function_generator(S, pfunction) /\ ~$generator_active(S)
  -- if S.ACTIVEFIBER = eps /\ S.CONSTCONTEXT = eps
  -- if $(2 <= |pfunction.SIGNATURE.PARAMETERS|) /\ $(pcallcontext.ARGC <= |pfunction.SIGNATURE.PARAMETERS|)
  -- if $lossy_positional_reference_parameters(pfunction.SIGNATURE.PARAMETERS)
  -- if ~$typed_caller_strict(S)
