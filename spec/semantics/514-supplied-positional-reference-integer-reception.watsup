  -- if $parameter_string_site_valid(S, $default_parameter_origin(S, porigin_function, n), z)
  -- if $typed_receive_valid(S[.TODO = [TYPE_RECEIVE porigin_function n]][.ORIGIN = (porigin_function)], porigin_function, n)
def $lossy_positional_reference_parameter_metadata(S, porigin_function, n, z) = false -- otherwise

dec $lossy_positional_reference_parameter_source_valid(pstate, ptask) : bool
def $lossy_positional_reference_parameter_source_valid(S, LOSSY_POSITIONAL_REFERENCE_PARAMETER_RECEIVE porigin_function n n_cell n_bits i z) = true
  -- if $lossy_positional_reference_parameter_metadata(S, porigin_function, n, z)
  -- if S.ORIGIN = ($default_parameter_origin(S, porigin_function, n))
  -- if $function_at(S.FUNCTIONS, porigin_function) = (pfunction)
  -- if $lookup(S.ENV, pfunction.SIGNATURE.PARAMETERS[n].NAME) = (n_cell)
  -- if $(n_cell < |S.STORE|) /\ (HCELL n_cell) <- S.ALLOCATIONS
  -- if $lossy_parameter_snapshot(n_bits) = ((i, ptbytes))
def $lossy_positional_reference_parameter_source_valid(S, ptask) = false -- otherwise
def $call_task_valid(S, LOSSY_POSITIONAL_REFERENCE_PARAMETER_RECEIVE porigin_function n n_cell n_bits i z) = (S.TODO = [LOSSY_POSITIONAL_REFERENCE_PARAMETER_RECEIVE porigin_function n n_cell n_bits i z] /\ $lossy_positional_reference_parameter_source_valid(S, LOSSY_POSITIONAL_REFERENCE_PARAMETER_RECEIVE porigin_function n n_cell n_bits i z))
def $task_nodes(LOSSY_POSITIONAL_REFERENCE_PARAMETER_RECEIVE porigin_function n n_cell n_bits i z) = eps

