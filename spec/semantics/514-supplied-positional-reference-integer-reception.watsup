dec $lossy_positional_reference_parameter_capture(pstate) : ptask?
def $lossy_positional_reference_parameter_capture(S) = (LOSSY_POSITIONAL_REFERENCE_PARAMETER_RECEIVE porigin_function n n_cell n_bits i z)
  -- if S.TODO = [TYPE_RECEIVE porigin_function n]
  -- if S.COMPLETION = NORMAL
  -- if $function_at(S.FUNCTIONS, porigin_function) = (pfunction)
  -- if z = $default_parameter_line(S, porigin_function, n)
  -- if $lossy_positional_reference_parameter_metadata(S, porigin_function, n, z)
  -- if $lookup(S.ENV, pfunction.SIGNATURE.PARAMETERS[n].NAME) = (n_cell)
  -- if $(n_cell < |S.STORE|) /\ (HCELL n_cell) <- S.ALLOCATIONS
  -- if S.STORE[n_cell] = DEFINED (PFLOAT n_bits)
  -- if $typed_parameter_conversion(S, pfunction.SIGNATURE.PARAMETERS[n], PFLOAT n_bits) = TYPEINTEGER (PFLOAT n_bits)
  -- if $lossy_parameter_snapshot(n_bits) = ((i, ptbytes))
def $lossy_positional_reference_parameter_capture(S) = eps -- otherwise
def $lossy_positional_reference_parameter_candidate(S) = ($lossy_positional_reference_parameter_capture(S) =/= eps)

rule PhpStep/lossy-positional-parameter-begin: S ~> $error_dispatch(S[.TODO = [ptask_source]][.ORIGIN = (porigin_site)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], 8192, ptbytes, z, DIAGNOSTIC "Deprecated" ptbytes z, ptask_source)
  -- if $lossy_positional_reference_parameter_capture(S) = (ptask_source)
  -- if ptask_source = LOSSY_POSITIONAL_REFERENCE_PARAMETER_RECEIVE porigin_function n n_cell n_bits i z
  -- if $lossy_positional_reference_parameter_ready(S, n, n_cell)
  -- if $lossy_parameter_snapshot(n_bits) = ((i, ptbytes))
  -- if porigin_site = $default_parameter_origin(S, porigin_function, n)
rule PhpStep/lossy-positional-parameter-entry-refused: S ~> S[.COMPLETION = UNSUPPORTED "lossy positional reference parameter receive context"]
  -- if $lossy_positional_reference_parameter_capture(S) = (LOSSY_POSITIONAL_REFERENCE_PARAMETER_RECEIVE porigin_function n n_cell n_bits i z)
  -- if ~$lossy_positional_reference_parameter_ready(S, n, n_cell)

