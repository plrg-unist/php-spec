;; _convert_to_string warns with the real array RV alive, destroys it even
;; with EG(exception), then installs the fixed string "Array". A reference is
;; unwrapped before that warning; later alias writes cannot replace this RV.
dec $ob_array_current(pstate, pobarrayreturn) : bool
dec $ob_array_metadata(pstate, ptask, pobarrayreturn) : bool
dec $ob_array_live(pstate, ptask, pobarrayreturn) : bool
dec $ob_array_nodes(pobarrayreturn) : pnode*
dec $ob_array_from_ref(pobrefreturn, nat) : pobarrayreturn
dec $ob_array_capture(pstate, pobinvoke, nat, nat?) : pstate
dec $ob_array_begin(pstate, pobarrayreturn) : pstate
dec $ob_array_report(pstate, pobarrayreturn) : pstate
dec $ob_array_deprecation_discard(pstate, pobarrayreturn) : pstate
dec $ob_array_warning_discard(pstate, pobarrayreturn) : pstate
