def $ob_array_pending(S, pobarrayreturn) = $eager_operation_pending(S) -- if $eager_operation_pending(S) =/= eps
def $ob_array_pending(S, pobarrayreturn) = n? -- if $eager_operation_pending(S) = eps -- if n? = $ob_array_pending_operations(S, S.DESTRUCTION.OPERATIONS, pobarrayreturn) -- if n? =/= eps
def $ob_array_pending(S, pobarrayreturn) = $ob_array_pending_tasks(S.TODO, pobarrayreturn) -- if $eager_operation_pending(S) = eps -- if $ob_array_pending_operations(S, S.DESTRUCTION.OPERATIONS, pobarrayreturn) = eps
def $ob_array_pending_operations(S, pdestructionoperation :: pdestructionoperation_tail*, pobarrayreturn) = pdestructionoperation.PENDING
  -- if pdestructionoperation.SOURCE = OB_USER_ARRAY_RESULT pobarrayreturn
  -- if $ob_array_release_scope(S, pdestructionoperation, pobarrayreturn)
def $ob_array_pending_operations(S, pdestructionoperation :: pdestructionoperation_tail*, pobarrayreturn) = $ob_array_pending_operations(S, pdestructionoperation_tail*, pobarrayreturn)
  -- if pdestructionoperation.SOURCE =/= OB_USER_ARRAY_RESULT pobarrayreturn \/ ~$ob_array_release_scope(S, pdestructionoperation, pobarrayreturn)
def $ob_array_pending_operations(S, eps, pobarrayreturn) = eps
;; Descriptor projection can remove the operation registry before checking its
;; queued DONE. The unchanged real EXIT still supplies the resumed pending RV.
def $ob_array_pending_tasks((DESTRUCTOR_OPERATION_EXIT pdestructionoperation) :: (OB_USER_ARRAY_DONE pobarrayreturn) :: ptask_tail*, pobarrayreturn) = pdestructionoperation.PENDING
  -- if pdestructionoperation.SOURCE = OB_USER_ARRAY_RESULT pobarrayreturn
  -- if ptask_tail* = pobarrayreturn.TAIL
def $ob_array_pending_boundary(DESTRUCTOR_OPERATION_EXIT pdestructionoperation) = true
def $ob_array_pending_boundary(ptask) = false -- otherwise
def $ob_array_pending_tasks((DESTRUCTOR_OPERATION_EXIT pdestructionoperation) :: ptask_tail*, pobarrayreturn) = $ob_array_pending_tasks(ptask_tail*, pobarrayreturn) -- if pdestructionoperation.SOURCE =/= OB_USER_ARRAY_RESULT pobarrayreturn
def $ob_array_pending_tasks(ptask :: ptask_tail*, pobarrayreturn) = $ob_array_pending_tasks(ptask_tail*, pobarrayreturn) -- if ~$ob_array_pending_boundary(ptask)
def $ob_array_pending_tasks(ptask*, pobarrayreturn) = eps -- otherwise

def $ob_array_release_completion(pdestructionoperation, eps) = (pdestructionoperation.COMPLETION = NORMAL)
def $ob_array_release_completion(pdestructionoperation, (n)) = (pdestructionoperation.COMPLETION = THROWING n)
def $ob_array_release_successor((DESTRUCTOR_RELEASE pdestructionrelease) :: ptask_tail*, pdestructionoperation, pobarrayreturn) = $ob_array_release_successor(ptask_tail*, pdestructionoperation, pobarrayreturn)
def $ob_array_release_successor((DESTRUCTOR_ENTER pdestructorcall) :: ptask_tail*, pdestructionoperation, pobarrayreturn) = $ob_array_release_successor(ptask_tail*, pdestructionoperation, pobarrayreturn) -- if pdestructorcall.OPERATION = (pdestructionoperation)
def $ob_array_release_successor((DESTRUCTOR_RESULT pdestructorcall) :: ptask_tail*, pdestructionoperation, pobarrayreturn) = $ob_array_release_successor(ptask_tail*, pdestructionoperation, pobarrayreturn) -- if pdestructorcall.OPERATION = (pdestructionoperation)
def $ob_array_release_successor((DESTRUCTOR_WARNING pdestructorcall) :: ptask_tail*, pdestructionoperation, pobarrayreturn) = $ob_array_release_successor(ptask_tail*, pdestructionoperation, pobarrayreturn) -- if pdestructorcall.OPERATION = (pdestructionoperation)
def $ob_array_release_successor((DESTRUCTOR_OPERATION_EXIT pdestructionoperation_actual) :: (OB_USER_ARRAY_DONE pobarrayreturn_actual) :: ptask_tail*, pdestructionoperation, pobarrayreturn) = (pdestructionoperation_actual = pdestructionoperation /\ pobarrayreturn_actual = pobarrayreturn /\ ptask_tail* = pobarrayreturn.TAIL)
def $ob_array_release_successor(ptask*, pdestructionoperation, pobarrayreturn) = false -- otherwise
def $ob_array_release_frames(eps, pdestructionoperation, pobarrayreturn) = false
