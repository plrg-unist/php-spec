;; This source is distinct from scalar UNWRAP, whose successor stays the real
;; string COMMIT. Here the ARRAY owner exists before the old CELL decrement.
def $ob_array_ref_successor(S, (DESTRUCTOR_RELEASE pdestructionrelease) :: ptask_tail*, pdestructionoperation, pobrefreturn, n) = $ob_array_ref_successor(S, ptask_tail*, pdestructionoperation, pobrefreturn, n)
