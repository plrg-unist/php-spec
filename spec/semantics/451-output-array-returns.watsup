;; Freeing a unique modeled wrapper exposes its one payload edge as a VALUE
;; job. That edge is the transfer already owned by WARN, not another native
;; Array decrement. The later ARRAY_RESULT source cannot match this clause.
def $gc_consumed_handoff(S, S_next, pnode_decrements*) = $destruction_node_delete(pnode_decrements*, HARRAY n)
  -- if S.TODO = (DESTRUCTOR_RELEASE pdestructionrelease) :: ptask_tail*
