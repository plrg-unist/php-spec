def $ob_array_report(S, pobarrayreturn) = $error_default(S[.ERRORFATALTRACE = eps], $ob_call_event(pobarrayreturn.INVOKE.CALL, "Warning", $ptascii("Array to string conversion"), $ob_call_line(pobarrayreturn.INVOKE.CALL)), 2) -- if ~$eval_compile_recorded_error(S, 2) /\ ~$error_handler_eligible(S, 2)
