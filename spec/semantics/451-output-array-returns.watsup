dec $ob_array_ref_successor(pstate, ptask*, pdestructionoperation, pobrefreturn, nat) : bool
dec $ob_array_ref_transferred(pstate, pobrefreturn, nat) : bool
dec $ob_array_diagnostic(ptask) : pobarrayreturn?

def $ob_normal_value(S, PARRAY n) = $config_slots_valid(S, [NAMED_SENT (KNOWN (PARRAY n))])
def $ob_array_current(S, pobarrayreturn) = (S.CURRENT = pobarrayreturn.CALLER /\ S.ORIGIN = ($ob_call_site(pobarrayreturn.INVOKE.CALL)))
def $ob_array_metadata(S, ptask, pobarrayreturn) = true
  -- if $ob_return_context(S, ptask, pobarrayreturn.CALLER, $ob_call_site(pobarrayreturn.INVOKE.CALL), pobarrayreturn.TAIL)
  -- if S_scope = S[.CURRENT = pobarrayreturn.CALLER][.ORIGIN = ($ob_call_site(pobarrayreturn.INVOKE.CALL))][.TODO = (OB_USER_RESULT pobarrayreturn.INVOKE) :: pobarrayreturn.TAIL]
  -- if $call_task_valid(S_scope, OB_USER_RESULT pobarrayreturn.INVOKE)
def $ob_array_metadata(S, ptask, pobarrayreturn) = false -- otherwise
def $ob_array_live(S, ptask, pobarrayreturn) = ($ob_array_metadata(S, ptask, pobarrayreturn) /\ $config_slots_valid(S, [NAMED_SENT (KNOWN (PARRAY pobarrayreturn.ARRAY))]) /\ $destructor_pending_valid(S, pobarrayreturn.PENDING))
def $ob_array_nodes(pobarrayreturn) = $ob_user_nodes(pobarrayreturn.INVOKE) ++ [HARRAY pobarrayreturn.ARRAY] ++ $instance_roots(pobarrayreturn.PENDING)
def $ob_array_from_ref(pobrefreturn, n) = {INVOKE pobrefreturn.INVOKE, ARRAY n, CELL (pobrefreturn.CELL), PENDING pobrefreturn.PENDING, CALLER pobrefreturn.CALLER, TAIL pobrefreturn.TAIL}

def $task_nodes(OB_USER_REF_ARRAY pobrefreturn n) = $ob_ref_nodes(pobrefreturn)
def $task_nodes(OB_USER_ARRAY_DEPRECATED pobarrayreturn) = $ob_array_nodes(pobarrayreturn)
def $task_nodes(OB_USER_ARRAY_WARN pobarrayreturn) = $ob_array_nodes(pobarrayreturn)
def $task_nodes(OB_USER_ARRAY_RESULT pobarrayreturn) = $ob_array_nodes(pobarrayreturn)
;; DONE borrows the consumed ARRAY and old exception. Actual release/THROW
;; carries the pending exception until COMMIT receives its resumed identity.
def $task_nodes(OB_USER_ARRAY_DONE pobarrayreturn) = $ob_user_nodes(pobarrayreturn.INVOKE)
def $task_nodes(OB_USER_ARRAY_COMMIT pobarrayreturn poboutput) = $ob_user_nodes(pobarrayreturn.INVOKE) ++ $value_nodes(poboutput.VALUE) ++ $instance_roots(pobarrayreturn.PENDING)
def $ob_user_active_task(OB_USER_REF_ARRAY pobrefreturn n) = (pobrefreturn.INVOKE.BUFFER.ID)
def $ob_user_active_task(OB_USER_ARRAY_DEPRECATED pobarrayreturn) = (pobarrayreturn.INVOKE.BUFFER.ID)
def $ob_user_active_task(OB_USER_ARRAY_WARN pobarrayreturn) = (pobarrayreturn.INVOKE.BUFFER.ID)
def $ob_user_active_task(OB_USER_ARRAY_RESULT pobarrayreturn) = (pobarrayreturn.INVOKE.BUFFER.ID)
def $ob_user_active_task(OB_USER_ARRAY_DONE pobarrayreturn) = (pobarrayreturn.INVOKE.BUFFER.ID)
def $ob_user_active_task(OB_USER_ARRAY_COMMIT pobarrayreturn poboutput) = (pobarrayreturn.INVOKE.BUFFER.ID)
def $ob_user_disabled_task(OB_USER_ARRAY_DEPRECATED pobarrayreturn, n) = (pobarrayreturn.INVOKE.BUFFER.ID = n)
def $output_task_write(OB_USER_REF_ARRAY pobrefreturn n) = $output_call_write(pobrefreturn.INVOKE.CALL)
def $output_task_write(OB_USER_ARRAY_DEPRECATED pobarrayreturn) = $output_call_write(pobarrayreturn.INVOKE.CALL)
def $output_task_write(OB_USER_ARRAY_WARN pobarrayreturn) = $output_call_write(pobarrayreturn.INVOKE.CALL)
def $output_task_write(OB_USER_ARRAY_RESULT pobarrayreturn) = $output_call_write(pobarrayreturn.INVOKE.CALL)
def $output_task_write(OB_USER_ARRAY_DONE pobarrayreturn) = $output_call_write(pobarrayreturn.INVOKE.CALL)
def $output_task_write(OB_USER_ARRAY_COMMIT pobarrayreturn poboutput) = $output_call_write(pobarrayreturn.INVOKE.CALL)
def $ob_user_resume_api(OB_USER_ARRAY_DEPRECATED pobarrayreturn) = $ob_call_api(pobarrayreturn.INVOKE.CALL)
def $ob_user_resume_api(OB_USER_ARRAY_RESULT pobarrayreturn) = $ob_call_api(pobarrayreturn.INVOKE.CALL)

def $call_task_valid(S, OB_USER_REF_ARRAY pobrefreturn n) = ($ob_ref_valid(S, OB_USER_REF_ARRAY pobrefreturn n, pobrefreturn, true) /\ S.STORE[pobrefreturn.CELL] = DEFINED (PARRAY n) /\ $config_slots_valid(S, [NAMED_SENT (KNOWN (PARRAY n))]) /\ $long_and(poutputbuffer.FLAGS, 40960) = 0)
  -- if $output_selected(S, pobrefreturn.INVOKE) = (poutputbuffer)
def $call_task_valid(S, OB_USER_ARRAY_DEPRECATED pobarrayreturn) = ($ob_array_live(S, OB_USER_ARRAY_DEPRECATED pobarrayreturn, pobarrayreturn) /\ pobarrayreturn.PENDING = eps /\ $ob_user_temporary(S, poutputbuffer.ID) /\ $long_and(poutputbuffer.FLAGS, 40960) = 8192)
  -- if $output_selected(S, pobarrayreturn.INVOKE) = (poutputbuffer)
def $call_task_valid(S, OB_USER_ARRAY_WARN pobarrayreturn) = ($ob_array_live(S, OB_USER_ARRAY_WARN pobarrayreturn, pobarrayreturn) /\ $long_and(poutputbuffer.FLAGS, 40960) = 0)
  -- if $output_selected(S, pobarrayreturn.INVOKE) = (poutputbuffer)
def $call_task_valid(S, OB_USER_ARRAY_RESULT pobarrayreturn) = ($ob_array_live(S, OB_USER_ARRAY_RESULT pobarrayreturn, pobarrayreturn) /\ ~$ob_user_disabled(poutputbuffer))
  -- if $output_selected(S, pobarrayreturn.INVOKE) = (poutputbuffer)
def $call_task_valid(S, OB_USER_ARRAY_DONE pobarrayreturn) = ($ob_array_metadata(S, OB_USER_ARRAY_DONE pobarrayreturn, pobarrayreturn) /\ (pobarrayreturn.PENDING = eps \/ $ob_array_pending(S, pobarrayreturn) =/= eps) /\ ~$ob_user_disabled(poutputbuffer))
  -- if $output_selected(S, pobarrayreturn.INVOKE) = (poutputbuffer)
def $call_task_valid(S, OB_USER_ARRAY_COMMIT pobarrayreturn poboutput) = ($ob_array_metadata(S, OB_USER_ARRAY_COMMIT pobarrayreturn poboutput, pobarrayreturn) /\ $destructor_pending_valid(S, pobarrayreturn.PENDING) /\ $ob_user_output_valid(S, poboutput) /\ poboutput.VALUE = PSTRING $ptascii("Array") /\ ~$ob_user_disabled(poutputbuffer))
  -- if $output_selected(S, pobarrayreturn.INVOKE) = (poutputbuffer)

