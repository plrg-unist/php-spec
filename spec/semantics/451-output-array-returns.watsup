def $ob_array_release_scope(S, pdestructionoperation, pobarrayreturn) = (($ob_array_current(S, pobarrayreturn) /\ S.CONSTCONTEXT = pdestructionoperation.CONSTCONTEXT /\ $ob_array_release_successor(S.TODO, pdestructionoperation, pobarrayreturn)) \/ $ob_array_release_frames(S.FRAMES, pdestructionoperation, pobarrayreturn))
