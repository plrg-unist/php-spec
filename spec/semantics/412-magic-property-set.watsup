  -- if $property_magic_set_entered(S, S.CURRENT, S.FRAMES, ppropertymagicset)
def $property_magic_set_context(S, pcallcontext) = false -- otherwise
def $call_arity_valid(S, pcallcontext) = $property_magic_set_context(S, pcallcontext)
