;; A private magic write borrows its receiver from RESULT. DELIVERY is nonowning:
;; ZEND_ASSIGN_OBJ copies its scalar RHS only after std_write_property releases it.
dec $property_magic_set_method(pstate, nat) : pmethoddesc?
def $property_magic_set_method(S, n) = $effective_method(S, porigin, $ptascii("__set"), |S.CLASSES|)
  -- if $(n < |S.OBJECTS|)
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $class_throwable_kind(S, porigin, |S.CLASSES|) = eps
def $property_magic_set_method(S, n) = eps -- otherwise

def $property_magic_set_needed(S, n, ptbytes) = true
  -- if $property_magic_set_method(S, n) =/= eps
  -- if ~$property_hook_declared(S, n, ptbytes)
  -- if $property_resolve(S, n, ptbytes) = PROPERTY_DENIED ppropertydesc
def $property_magic_set_needed(S, n, ptbytes) = true
  -- if $property_magic_set_method(S, n) =/= eps
  -- if ~$property_hook_declared(S, n, ptbytes)
  -- if $property_resolve(S, n, ptbytes) = PROPERTY_ACCESS ptbytes_key
  -- if $objectprops_at(S.OBJECTPROPS, n) = (ppropertyslot_all*)
  -- if $property_slot_at(ppropertyslot_all*, ptbytes_key) = eps
def $property_magic_set_needed(S, n, ptbytes) = true
  -- if $property_magic_set_method(S, n) =/= eps
  -- if ~$property_hook_declared(S, n, ptbytes)
  -- if $property_resolve(S, n, ptbytes) = PROPERTY_ACCESS ptbytes_key
  -- if $objectprops_at(S.OBJECTPROPS, n) = (ppropertyslot_all*)
  -- if $property_slot_at(ppropertyslot_all*, ptbytes_key) = (ppropertyslot)
  -- if ppropertyslot.STATE = PROP_UNSET
def $property_magic_set_needed(S, n, ptbytes) = false -- otherwise

;; Other consumers of a newly admitted declaration must not silently store or
;; turn a native magic call into an ordinary visibility Error.
def $property_store_value(S, n, ptbytes, pvalue, z) = S[.COMPLETION = UNSUPPORTED "magic setter write mode"]
  -- if ~$instance_storage_freeing(S, n)
  -- if $property_magic_set_needed(S, n, ptbytes)

def $property_magic_set_pending(S) = true
  -- if S.TODO = (ASSIGN_ARRAY (BASE_PROPERTY_PENDING pbase poperand z_receiver) z b) :: ptask_tail*
