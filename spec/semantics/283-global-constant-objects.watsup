def $global_new_complete_phase(S, pdefaultnew) = false -- otherwise
def $global_new_complete(S, S_done, pdefaultnew) = S_done[.CONSTANTOBJECTS = $global_new_record_put(S.CONSTANTOBJECTS, pconstantobject[.COMPLETE = true])]
  -- if $global_new_active(S, pdefaultnew.SITE)
  -- if S.COMPLETION = NORMAL
  -- if $global_new_complete_phase(S, pdefaultnew)
  -- if S.TODO = ptask :: ptask_tail*
  -- if S_done = S[.TODO = ptask_tail*][.RESULT = KNOWN (POBJECT pdefaultnew.OBJECT)][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if $global_new_record(S.CONSTANTOBJECTS, pdefaultnew.OBJECT) = (pconstantobject)
  -- if $global_new_pending(S, pdefaultnew)
def $global_new_complete(S, S_done, pdefaultnew) = S_done -- if ~$global_new_active(S, pdefaultnew.SITE)
rule PhpStep/global-new-noctor-complete: S ~> $global_new_complete(S, S[.TODO = ptask_tail*][.RESULT = KNOWN (POBJECT pdefaultnew.OBJECT)][.BASE = BASE_VALUE (KNOWN PNULL)], pdefaultnew)
