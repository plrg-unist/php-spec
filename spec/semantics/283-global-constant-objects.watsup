  -- if $global_constant_class_name(S, pconstantobject.SITE, porigin_scope?, name) = (ptbytes)
  -- if $class_named(S.CLASSNAMES, $ptlc(ptbytes)) = (pconstantobject.CLASS)
  -- if $class_at(S.CLASSES, pconstantobject.CLASS) = (pclassdesc)
  -- if pclassdesc.KIND = "class" /\ ~pclassdesc.ABSTRACT
  -- if $constant_callable_published(S.DECLARATIONS[0:pconstantobject.PREFIX], pconstantobject.CLASS)
def $global_new_header(S, pconstantobject) = false -- otherwise

;; A completed receipt cannot replace the still-owned NEW phase for that object.
dec $global_new_task_busy(ptask, nat) : bool
def $global_new_task_busy(DEFAULT_NEW_ARGS pdefaultnew, n_object) = (pdefaultnew.OBJECT = n_object)
def $global_new_task_busy(DEFAULT_NEW_SEND pdefaultnew, n_object) = (pdefaultnew.OBJECT = n_object)
def $global_new_task_busy(DEFAULT_CTOR_ARGS pdefaultctor, n_object) = (pdefaultctor.NEW.OBJECT = n_object)
def $global_new_task_busy(DEFAULT_CTOR_REF_RESULT pdefaultctor, n_object) = (pdefaultctor.NEW.OBJECT = n_object)
def $global_new_task_busy(DEFAULT_CTOR_RESULT pdefaultctor, n_object) = (pdefaultctor.NEW.OBJECT = n_object)
def $global_new_task_busy(AT porigin ptask, n_object) = $global_new_task_busy(ptask, n_object)
def $global_new_task_busy(ERROR_HANDLER_INVOKE perrorcall, n_object) = $global_new_task_busy(perrorcall.RESUME, n_object)
def $global_new_task_busy(ERROR_HANDLER_RESULT perrorcall, n_object) = $global_new_task_busy(perrorcall.RESUME, n_object)
def $global_new_task_busy(ptask, n_object) = false -- otherwise
dec $global_new_tasks_busy(ptask*, nat) : bool
def $global_new_tasks_busy(eps, n_object) = false
def $global_new_tasks_busy(ptask :: ptask_tail*, n_object) = ($global_new_task_busy(ptask, n_object) \/ $global_new_tasks_busy(ptask_tail*, n_object))
dec $global_new_frames_busy(pframe*, nat) : bool
def $global_new_frames_busy(eps, n_object) = false
def $global_new_frames_busy(pframe :: pframe_tail*, n_object) = ($global_new_tasks_busy(pframe.TODO, n_object) \/ $global_new_frames_busy(pframe_tail*, n_object))
def $global_new_records_valid(S, eps) = true
def $global_new_records_valid(S, pconstantobject :: pconstantobject_tail*) = ($global_new_header(S, pconstantobject) /\ $global_new_record(pconstantobject_tail*, pconstantobject.OBJECT) = eps /\ (~pconstantobject.COMPLETE \/ (~$global_new_tasks_busy(S.TODO, pconstantobject.OBJECT) /\ ~$global_new_frames_busy(S.FRAMES, pconstantobject.OBJECT))) /\ $global_new_records_valid(S, pconstantobject_tail*))

def $global_new_birth(S, S_new, ptbytes, n_object) = S_new[.CONSTANTOBJECTS = S.CONSTANTOBJECTS ++ [{OBJECT n_object, SITE porigin_site, DECL porigin_decl, CLASS porigin_class, PREFIX n_prefix, COMPLETE false}]]
  -- if S.ORIGIN = (porigin_site)
  -- if $global_new_context(S, porigin_site) = ((porigin_decl, porigin_scope?))
  -- if $new_source_name(S, porigin_site) = (ptbytes)
  -- if $class_named(S.CLASSNAMES, $ptlc(ptbytes)) = (porigin_class)
  -- if n_object = |S.OBJECTS|
  -- if S_new.OBJECTS = S.OBJECTS ++ [INSTANCE porigin_class]
  -- if S_new.ALLOCATIONS = S.ALLOCATIONS ++ [HOBJECT n_object]
  -- if S_new.RESULT = KNOWN (POBJECT n_object) /\ S_new.COMPLETION = NORMAL
  -- if S_new.CONSTCONTEXT = S.CONSTCONTEXT /\ S_new.CONSTANTOBJECTS = S.CONSTANTOBJECTS
  -- if $global_new_record(S.CONSTANTOBJECTS, n_object) = eps
  -- if n_prefix = |S.DECLARATIONS|
  -- if $global_new_header(S_new, {OBJECT n_object, SITE porigin_site, DECL porigin_decl, CLASS porigin_class, PREFIX n_prefix, COMPLETE false})
def $global_new_birth(S, S_new, ptbytes, n_object) = S_new -- if ~$global_new_current(S)
