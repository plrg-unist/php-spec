def $global_new_pending(S, pdefaultnew) = true -- if ~$global_new_active(S, pdefaultnew.SITE)
def $global_new_pending(S, pdefaultnew) = false -- otherwise
dec $global_new_complete_phase(pstate, pdefaultnew) : bool
