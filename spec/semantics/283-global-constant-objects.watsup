;; Global constant AST NEW retains allocation identity independently of mutable
;; instance fields. These receipts own no object; ordinary phases and installed
;; USERCONSTANTS retain the actual values.
def $global_new_site(S, PORIGIN n_unit pcpath) = true
  -- if $source_unit(S.SOURCES, n_unit) = (pcunit)
  -- if $global_constant_initializer_root(pcunit, pcpath) =/= eps
  -- if $origin_node(S.SOURCES, PORIGIN n_unit pcpath) = (NExprNew name (SEQUENCE phpType7*) metadata)
  -- if $parameter_new_prefix(phpType7*)
def $global_new_site(S, porigin_site) = false -- otherwise
dec $global_new_context(pstate, porigin) : (porigin, porigin?)?
def $global_new_context(S, porigin_site) = ((porigin_decl, porigin_scope?))
  -- if S.CONSTCONTEXT = (pconstantcontext)
  -- if porigin_decl = pconstantcontext.ORIGIN
  -- if porigin_decl = PORIGIN n_unit pcpath_decl
  -- if $global_constant_declaration_source(S.SOURCES, porigin_decl)
  -- if $constant_declaration(S, porigin_decl) = ((preqbytes, pconstantcontext.LINE))
  -- if $declaration_entered(S.DECLARATIONS, n_unit)
  -- if $constant_bindings(S, S.TODO) = [porigin_decl]
  -- if $global_constant_scope(S, n_unit) = (true, porigin_scope?)
  -- if $global_constant_scope_published(S.DECLARATIONS, porigin_scope?)
  -- if $constant_callable_path(S, porigin_site, $constant_child(porigin_decl, [PCFIELD 1]))
  -- if $origin_node(S.SOURCES, porigin_site) = (NExprNew name (SEQUENCE phpType7*) metadata)
  -- if ~$ppfirstclass(phpType7*)
def $global_new_context(S, porigin_site) = eps -- otherwise
def $global_new_active(S, porigin_site) = ($global_new_context(S, porigin_site) =/= eps)
def $global_new_current(S) = $global_new_active(S, porigin_site)
  -- if S.ORIGIN = (porigin_site)
def $global_new_current(S) = false -- if S.ORIGIN = eps
def $constant_ast_constructor_context(S, pconstantcontext) = true
  -- if $parameter_string_site_valid(S, pconstantcontext.ORIGIN, pconstantcontext.LINE)
  -- if $default_context_valid(S, pconstantcontext)
def $constant_ast_constructor_context(S, pconstantcontext) = true
  -- if $global_constant_declaration_source(S.SOURCES, pconstantcontext.ORIGIN)
  -- if S.CONSTCONTEXT = (pconstantcontext)
  -- if S.ORIGIN = (porigin_site)
  -- if $global_new_active(S, porigin_site)
def $constant_ast_constructor_context(S, pconstantcontext) = false -- otherwise

;; Only keyword selectors are deferred. Named classes retain the existing
;; resolved compiler name; no ordinary runtime CALL_INIT authority is fabricated.
def $ppglobal_new_deferred(P, pcpath, NName (BYTES text) metadata) = true
  -- if $ppglobal_constant_initializer(P[.LOCATION.PATH = pcpath])
  -- if $ptlc($base64(text)) <- [$ptascii("self"), $ptascii("parent")]
def $ppglobal_new_deferred(P, pcpath, name) = false -- otherwise
def $ppnew_class_name(P, pcpath, NName (BYTES text) metadata) = $ppclass_name(P, pcpath, PNRESOLVED {ORIGINAL NName (BYTES text) metadata, KIND PLCLASS, RESOLVED $ptlc($base64(text)), FULL true, FALLBACK eps})
  -- if $ppglobal_new_deferred(P, pcpath, NName (BYTES text) metadata)
def $new_source_name(S, PORIGIN n_unit pcpath) = $global_constant_class_name(S, PORIGIN n_unit pcpath, porigin_scope?, name)
  -- if $global_new_site(S, PORIGIN n_unit pcpath)
  -- if $global_constant_scope(S, n_unit) = (true, porigin_scope?)
  -- if $origin_node(S.SOURCES, PORIGIN n_unit pcpath) = (NExprNew name phpType6 metadata)
def $default_new_scope(S) = porigin_scope?
  -- if S.ORIGIN = (porigin_site)
  -- if $global_new_context(S, porigin_site) = ((porigin_decl, porigin_scope?))
def $default_new_scope(S) = $method_current_scope(S) -- if ~$global_new_current(S)
def $global_new_unsupported_target(S, ptbytes) = true
  -- if $global_new_current(S) /\ $class_internal(ptbytes)
def $global_new_unsupported_target(S, ptbytes) = true
  -- if $global_new_current(S) /\ ~$class_internal(ptbytes)
  -- if $class_named(S.CLASSNAMES, $ptlc(ptbytes)) = (porigin_class)
  -- if $class_at(S.CLASSES, porigin_class) = (pclassdesc)
  -- if ~pclassdesc.ABSTRACT
  -- if $class_throwable_kind(S, porigin_class, |S.CLASSES|) =/= eps
def $global_new_unsupported_target(S, ptbytes) = false -- otherwise

dec $global_new_scope_error(pstate, porigin) : ptbytes?
def $global_new_scope_error(S, porigin_site) = ($ptascii("Cannot access \"") ++ $ptlc($base64(text)) ++ $ptascii("\" when no class scope is active"))
  -- if $global_new_context(S, porigin_site) = ((porigin_decl, eps))
  -- if $origin_node(S.SOURCES, porigin_site) = (NExprNew (NName (BYTES text) metadata_name) phpType6 metadata)
  -- if $ptlc($base64(text)) <- [$ptascii("self"), $ptascii("parent")]
def $global_new_scope_error(S, porigin_site) = ($ptascii("Cannot access \"parent\" when current class scope has no parent"))
  -- if $global_new_context(S, porigin_site) = ((porigin_decl, (porigin_scope)))
  -- if $origin_node(S.SOURCES, porigin_site) = (NExprNew (NName (BYTES text) metadata_name) phpType6 metadata)
  -- if $ptlc($base64(text)) = $ptascii("parent")
  -- if $global_constant_class_name(S, porigin_site, (porigin_scope), NName (BYTES text) metadata_name) = eps
def $global_new_scope_error(S, porigin_site) = eps -- otherwise
rule PhpStep/global-new-scope-error: S ~> $throw_scalar(S[.TODO = ptask_tail*], "Error", ptbytes_message, pconstantcontext.LINE)
  -- if S.TODO = (EVAL (NExprNew name (SEQUENCE phpType7*) metadata)) :: ptask_tail*
  -- if S.ORIGIN = (porigin_site)
  -- if S.CONSTCONTEXT = (pconstantcontext)
  -- if $global_new_scope_error(S, porigin_site) = (ptbytes_message)

dec $global_new_record(pconstantobject*, nat) : pconstantobject?
def $global_new_record(eps, n_object) = eps
def $global_new_record(pconstantobject :: pconstantobject_tail*, n_object) = (pconstantobject)
  -- if pconstantobject.OBJECT = n_object
def $global_new_record(pconstantobject :: pconstantobject_tail*, n_object) = $global_new_record(pconstantobject_tail*, n_object)
  -- if pconstantobject.OBJECT =/= n_object
dec $global_new_record_put(pconstantobject*, pconstantobject) : pconstantobject*
def $global_new_record_put(eps, pconstantobject_new) = [pconstantobject_new]
def $global_new_record_put(pconstantobject :: pconstantobject_tail*, pconstantobject_new) = pconstantobject_new :: pconstantobject_tail*
  -- if pconstantobject.OBJECT = pconstantobject_new.OBJECT
def $global_new_record_put(pconstantobject :: pconstantobject_tail*, pconstantobject_new) = pconstantobject :: $global_new_record_put(pconstantobject_tail*, pconstantobject_new)
  -- if pconstantobject.OBJECT =/= pconstantobject_new.OBJECT
dec $global_new_header(pstate, pconstantobject) : bool
def $global_new_header(S, pconstantobject) = true
  -- if $(pconstantobject.OBJECT < |S.OBJECTS|) /\ $(pconstantobject.PREFIX <= |S.DECLARATIONS|)
  -- if S.OBJECTS[pconstantobject.OBJECT] = INSTANCE pconstantobject.CLASS
  -- if pconstantobject.DECL = PORIGIN n_unit pcpath_decl
  -- if $global_constant_declaration_source(S.SOURCES, pconstantobject.DECL)
  -- if $constant_declaration(S, pconstantobject.DECL) = ((preqbytes, z))
  -- if $declaration_entered(S.DECLARATIONS[0:pconstantobject.PREFIX], n_unit)
  -- if $global_constant_scope(S, n_unit) = (true, porigin_scope?)
  -- if $global_constant_scope_published(S.DECLARATIONS[0:pconstantobject.PREFIX], porigin_scope?)
  -- if $constant_callable_path(S, pconstantobject.SITE, $constant_child(pconstantobject.DECL, [PCFIELD 1]))
  -- if $origin_node(S.SOURCES, pconstantobject.SITE) = (NExprNew name (SEQUENCE phpType7*) metadata)
