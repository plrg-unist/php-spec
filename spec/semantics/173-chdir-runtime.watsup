;; A directory change pauses for an authenticated OS fact. The machine owns
;; argument evaluation, diagnostics, state mutation, and later file lookup.
dec $dir_await_valid(pstate, pconfigcall, nat) : bool
dec $dir_requested_valid(pstate, pdircontext) : bool
dec $dir_conversion_log_valid(pstate, pdirconversion*, nat) : bool
def $dir_conversion_log_valid(S, eps, n) = (n = S.DIRCONVSEQ)
def $dir_conversion_log_valid(S, pdirconversion :: pdirconversion_tail*, n) = true
  -- if pdirconversion.NONCE = n
  -- if $call_line_valid(S, (pdirconversion.CALLSITE), pdirconversion.CALLLINE)
  -- if ~(0 <- pdirconversion.RESULT)
  -- if $dir_conversion_log_valid(S, pdirconversion_tail*, $(n + 1))
def $dir_conversion_log_valid(S, pdirconversion*, n) = false -- otherwise
def $task_nodes(CHDIR_AWAIT pconfigcall n) = $config_nodes(pconfigcall)
def $eval_wrapped_marker(CHDIR_AWAIT pconfigcall n) = true
def $eval_marker_valid(S, CHDIR_AWAIT pconfigcall n) = $dir_await_valid(S, pconfigcall, n)
def $call_task_valid(S, CHDIR_AWAIT pconfigcall n) = $dir_await_valid(S, pconfigcall, n)

dec $dir_canonical(nat*) : bool
def $dir_canonical(47 :: n_tail*) = true -- if $source_filename(47 :: n_tail*)
def $dir_canonical(nat*) = false -- otherwise
dec $dir_await_task(ptask) : bool
dec $dir_marker_count(ptask*) : nat
def $dir_marker_count(eps) = 0
def $dir_marker_count((CHDIR_AWAIT pconfigcall n) :: ptask_tail*) = $(1 + $dir_marker_count(ptask_tail*))
def $dir_marker_count(ptask :: ptask_tail*) = $dir_marker_count(ptask_tail*)
  -- if ~$dir_await_task(ptask)
def $dir_await_task(CHDIR_AWAIT pconfigcall n) = true
def $dir_await_task(ptask) = false -- otherwise
dec $dir_frame_marker_count(pframe*) : nat
def $dir_frame_marker_count(eps) = 0
def $dir_frame_marker_count(pframe :: pframe_tail*) = $($dir_marker_count(pframe.TODO) + $dir_frame_marker_count(pframe_tail*))
def $dir_await_valid(S, pconfigcall, n) = true
  -- if S.DIRCONTEXT = (pdircontext)
  -- if pdircontext.NONCE = n
  -- if pdircontext.CALL = pconfigcall
  -- if $dir_pending_state_valid(S)
def $dir_await_valid(S, pconfigcall, n) = false -- otherwise
def $dir_requested_valid(S, pdircontext) = (pdircontext.REQUESTED = eps)
  -- if pdircontext.CALL.SENT = [NAMED_SENT (KNOWN PNULL)]
  -- if pdircontext.CONVERSION = eps
  -- if ~$config_strict(S, pdircontext.CALL)
def $dir_requested_valid(S, pdircontext) = (pdircontext.REQUESTED = n_requested*)
  -- if pdircontext.CALL.SENT = [NAMED_SENT (KNOWN pvalue)]
  -- if pdircontext.CONVERSION = eps
  -- if $config_conversion(S, pdircontext.CALL, pvalue) = ptypeconversion
  -- if ptypeconversion =/= TYPEREJECT
  -- if S_converted = $typed_apply(S, ptypeconversion, pdircontext.CALL.LINE)
  -- if S_converted.RESULT = KNOWN (PSTRING n_requested*)
def $dir_requested_valid(S, pdircontext) = true
  -- if pdircontext.CALL.SENT = [NAMED_SENT (KNOWN (POBJECT n_object))]
  -- if $config_string_source(S, pdircontext.CALL) = ((porigin_child, z_child))
  -- if $config_string_site_valid(S, pdircontext.CALL, n_object, porigin_child, z_child, pdircontext.CALL.LINE)
  -- if pdircontext.CONVERSION = (n_conversion)
  -- if S.DIRCONVSEQ = $(n_conversion + 1)
  -- if S.DIRCONVERSIONS[n_conversion] = pdirconversion
  -- if pdirconversion.NONCE = n_conversion
  -- if pdirconversion.CALLSITE = pdircontext.CALL.SITE
  -- if pdirconversion.CALLLINE = pdircontext.CALL.LINE
  -- if pdirconversion.OBJECT = n_object
  -- if pdirconversion.SELECTION = pdircontext.CALL.SELECTION
  -- if pdirconversion.OWNERDEPTH = pdircontext.FRAMEOWNER
  -- if pdirconversion.RESULT = pdircontext.REQUESTED
def $dir_requested_valid(S, pdircontext) = false -- otherwise
def $dir_pending_state_valid(S) = (S.DIRSEQ = $(pdircontext.NONCE + 1) /\ pdircontext.FRAMEOWNER = |S.FRAMES| /\ S.ORIGIN = (pdircontext.CALL.SITE) /\ S.FILECWD = (pdircontext.CWD) /\ S.FILEINCLUDEPATH =/= eps /\ $dir_canonical(pdircontext.CWD) /\ ~(0 <- pdircontext.REQUESTED) /\ $config_invoke_valid(S, pdircontext.CALL) /\ $dir_requested_valid(S, pdircontext) /\ pdircontext.CALL.KIND = INTRINSIC_CHDIR /\ S.TODO = (CHDIR_AWAIT pdircontext.CALL pdircontext.NONCE) :: pdircontext.TAIL /\ $($dir_marker_count(S.TODO) + $dir_frame_marker_count(S.FRAMES)) = 1)
  -- if S.COMPLETION = SOURCE_PENDING
  -- if S.DIRCONTEXT = (pdircontext)
def $dir_pending_state_valid(S) = false -- otherwise
def $dir_state_valid(S) = ($dir_conversion_log_valid(S, S.DIRCONVERSIONS, 0) /\ $($dir_marker_count(S.TODO) + $dir_frame_marker_count(S.FRAMES)) = 0)
  -- if S.DIRCONTEXT = eps
def $dir_state_valid(S) = ($dir_conversion_log_valid(S, S.DIRCONVERSIONS, 0) /\ $dir_pending_state_valid(S))
  -- if S.DIRCONTEXT = (pdircontext)

def $dir_request_start(S, pconfigcall, n_requested*) = $dir_request_start_with_conversion(S, pconfigcall, n_requested*, eps)
def $dir_request_start_with_conversion(S, pconfigcall, n_requested*, n_conversion?) = S[.DIRSEQ = $(n_nonce + 1)][.DIRCONTEXT = (pdircontext)][.TODO = (CHDIR_AWAIT pconfigcall n_nonce) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)][.COMPLETION = SOURCE_PENDING]
  -- if S.DIRCONTEXT = eps
  -- if S.FILECWD = (n_cwd*)
  -- if S.FILEINCLUDEPATH =/= eps
  -- if n_nonce = S.DIRSEQ
  -- if n_owner = |S.FRAMES|
  -- if S.TODO = (CONFIG_INVOKE pconfigcall) :: ptask_tail*
  -- if pdircontext = {NONCE n_nonce, CALL pconfigcall, CWD n_cwd*, REQUESTED n_requested*, CONVERSION n_conversion?, FRAMEOWNER n_owner, TAIL ptask_tail*}
def $dir_request_start_with_conversion(S, pconfigcall, n_requested*, n_conversion?) = S[.COMPLETION = UNSUPPORTED "chdir requires a finite directory snapshot"]
  -- if S.FILECWD = eps \/ S.FILEINCLUDEPATH = eps

dec $dir_response_valid(pstate, pdirresponse) : bool
def $dir_response_valid(S, DIR_CHANGED n_nonce n_cwd* n_requested* n_next*) = ($dir_pending_state_valid(S) /\ $call_descriptors_valid(S) /\ S.SERVICELEFT =/= eps /\ pdircontext.NONCE = n_nonce /\ pdircontext.CWD = n_cwd* /\ pdircontext.REQUESTED = n_requested* /\ $dir_canonical(n_next*))
  -- if S.DIRCONTEXT = (pdircontext)
def $dir_response_valid(S, DIR_FAILED n_nonce n_cwd* n_requested* n_error* n_errno) = ($dir_pending_state_valid(S) /\ $call_descriptors_valid(S) /\ S.SERVICELEFT =/= eps /\ pdircontext.NONCE = n_nonce /\ pdircontext.CWD = n_cwd* /\ pdircontext.REQUESTED = n_requested* /\ n_error* =/= eps /\ $(n_errno > 0))
  -- if S.DIRCONTEXT = (pdircontext)
def $dir_response_valid(S, pdirresponse) = false -- otherwise
dec $dir_warning_requested_valid(pstate, pdircontext) : bool
def $dir_warning_requested_valid(S, pdircontext) = $dir_requested_valid(S, pdircontext)
  -- if pdircontext.CONVERSION = eps
def $dir_warning_requested_valid(S, pdircontext) = true
  -- if pdircontext.CALL.SENT = [NAMED_SENT (KNOWN (POBJECT n_object))]
  -- if $config_string_source(S, pdircontext.CALL) = ((porigin_child, z_child))
  -- if $config_string_site_valid(S, pdircontext.CALL, n_object, porigin_child, z_child, pdircontext.CALL.LINE)
  -- if pdircontext.CONVERSION = (n_conversion)
  -- if $(n_conversion < |S.DIRCONVERSIONS|)
  -- if S.DIRCONVERSIONS[n_conversion] = pdirconversion
  -- if pdirconversion.NONCE = n_conversion
  -- if pdirconversion.CALLSITE = pdircontext.CALL.SITE
  -- if pdirconversion.CALLLINE = pdircontext.CALL.LINE
  -- if pdirconversion.OBJECT = n_object
  -- if pdirconversion.SELECTION = pdircontext.CALL.SELECTION
  -- if pdirconversion.OWNERDEPTH = pdircontext.FRAMEOWNER
  -- if pdirconversion.RESULT = pdircontext.REQUESTED
def $dir_warning_requested_valid(S, pdircontext) = false -- otherwise
dec $dir_warning_valid(pstate, pdircontext, preqbytes, nat) : bool
def $dir_warning_valid(S, pdircontext, n_error*, n_errno) = true
  -- if $config_invoke_valid(S, pdircontext.CALL)
  -- if pdircontext.CALL.KIND = INTRINSIC_CHDIR
  -- if S.ORIGIN = (pdircontext.CALL.SITE)
  -- if pdircontext.FRAMEOWNER = |S.FRAMES|
  -- if $(pdircontext.NONCE < S.DIRSEQ)
  -- if $dir_canonical(pdircontext.CWD)
  -- if ~(0 <- pdircontext.REQUESTED)
  -- if $dir_warning_requested_valid(S, pdircontext)
  -- if n_error* =/= eps
  -- if $(n_errno > 0)
  -- if S.FILECWD =/= eps
  -- if S.FILEINCLUDEPATH =/= eps
  -- if S.TODO = ptask :: pdircontext.TAIL
def $dir_warning_valid(S, pdircontext, n_error*, n_errno) = false -- otherwise
dec $dir_warning_message(preqbytes, nat) : preqbytes
def $dir_warning_message(n_error*, n_errno) = $ptascii("chdir(): ") ++ n_error* ++ $ptascii(" (errno ") ++ $ntunsigned(n_errno) ++ $ptascii(")")
def $task_nodes(CHDIR_WARNING_RESULT pdircontext n_error* n_errno) = $config_nodes(pdircontext.CALL)
def $selected_task_nonce(CHDIR_WARNING_RESULT pdircontext n_error* n_errno) = pdircontext.CALL.SELECTION
def $call_task_valid(S, CHDIR_WARNING_RESULT pdircontext n_error* n_errno) = $dir_warning_valid(S, pdircontext, n_error*, n_errno)
rule PhpStep/chdir-warning-result: S ~> S[.TODO = pdircontext.TAIL][.RESULT = KNOWN (PBOOL false)][.BASE = BASE_VALUE (KNOWN PNULL)][.ORIGIN = (pdircontext.CALL.SITE)]
  -- if S.TODO = (CHDIR_WARNING_RESULT pdircontext n_error* n_errno) :: ptask_tail*
  -- if $dir_warning_valid(S, pdircontext, n_error*, n_errno)
def $error_call_valid(S, perrorcall) = true
  -- if S.ORIGIN = (perrorcall.SITE)
  -- if perrorcall.RESUME = CHDIR_WARNING_RESULT pdircontext n_error* n_errno
  -- if $dir_warning_valid(S, pdircontext, n_error*, n_errno)
  -- if perrorcall.SITE = pdircontext.CALL.SITE
  -- if perrorcall.LEVEL = 2
  -- if perrorcall.LINE = pdircontext.CALL.LINE
  -- if perrorcall.MESSAGE = $dir_warning_message(n_error*, n_errno)
  -- if perrorcall.EVENT = DIAGNOSTIC "Warning" perrorcall.MESSAGE perrorcall.LINE
def $error_context_trigger(S, pcallcontext) = (pdircontext.CALL)
  -- if $error_context_call(S, pcallcontext) = (perrorcall)
  -- if perrorcall.RESUME = CHDIR_WARNING_RESULT pdircontext n_error* n_errno
;; The internal chdir argument has been converted; an explicit __invoke wrapper
;; still owns its original SENT operand. Use this handler's exact saved request.
dec $error_handler_trace_values(pstate, pcallcontext, pconfigcall) : pvalue*
def $error_handler_trace_values(S, pcallcontext, pconfigcall) = [PSTRING pdircontext.REQUESTED]
  -- if $error_context_call(S, pcallcontext) = (perrorcall)
  -- if perrorcall.RESUME = CHDIR_WARNING_RESULT pdircontext n_error* n_errno
  -- if pdircontext.CALL = pconfigcall

dec $dir_resume(pstate, pdirresponse) : pstate
def $dir_resume(S, DIR_CHANGED n_nonce n_cwd* n_requested* n_next*) = S[.DIRCONTEXT = eps][.FILECWD = (n_next*)][.TODO = pdircontext.TAIL][.COMPLETION = NORMAL][.SERVICELEFT = eps][.RESULT = KNOWN (PBOOL true)][.BASE = BASE_VALUE (KNOWN PNULL)][.ORIGIN = (pdircontext.CALL.SITE)]
  -- if $dir_response_valid(S, DIR_CHANGED n_nonce n_cwd* n_requested* n_next*)
  -- if S.DIRCONTEXT = (pdircontext)
def $dir_resume(S, DIR_FAILED n_nonce n_cwd* n_requested* n_error* n_errno) = $diagnostic(S_ready, "Warning", $ptascii("chdir(): ") ++ n_error* ++ $ptascii(" (errno ") ++ $decimal_integer(n_errno) ++ $ptascii(")"), pdircontext.CALL.LINE)[.RESULT = KNOWN (PBOOL false)][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if $dir_response_valid(S, DIR_FAILED n_nonce n_cwd* n_requested* n_error* n_errno)
  -- if S.DIRCONTEXT = (pdircontext)
  -- if ~$error_handler_eligible(S, 2)
  -- if S_ready = S[.DIRCONTEXT = eps][.TODO = pdircontext.TAIL][.COMPLETION = NORMAL][.SERVICELEFT = eps][.ORIGIN = (pdircontext.CALL.SITE)]
def $dir_resume(S, DIR_FAILED n_nonce n_cwd* n_requested* n_error* n_errno) = $error_dispatch(S_ready, 2, $dir_warning_message(n_error*, n_errno), pdircontext.CALL.LINE, DIAGNOSTIC "Warning" $dir_warning_message(n_error*, n_errno) pdircontext.CALL.LINE, CHDIR_WARNING_RESULT pdircontext n_error* n_errno)
  -- if $dir_response_valid(S, DIR_FAILED n_nonce n_cwd* n_requested* n_error* n_errno)
  -- if S.DIRCONTEXT = (pdircontext)
  -- if $error_handler_eligible(S, 2)
  -- if S_ready = S[.DIRCONTEXT = eps][.COMPLETION = NORMAL][.SERVICELEFT = eps][.ORIGIN = (pdircontext.CALL.SITE)]
def $dir_resume(S, pdirresponse) = S[.COMPLETION = UNSUPPORTED "invalid chdir provider response"]
  -- if ~$dir_response_valid(S, pdirresponse)
dec $dir_continue(pstate, pdirresponse) : pstate
def $dir_continue(S, pdirresponse) = $drive_steps(S_next, n)
  -- if S.SERVICELEFT = (n)
  -- if S_next = $dir_resume(S, pdirresponse)
  -- if S_next.COMPLETION = NORMAL
def $dir_continue(S, pdirresponse) = S_next
  -- if S_next = $dir_resume(S, pdirresponse)
  -- if S_next.COMPLETION =/= NORMAL
