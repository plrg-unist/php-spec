def $task_nodes(CLASS_CONST_OBJECT_FETCH porigin ptbytes_class ptbytes_member z) = eps
def $call_task_valid(S, CLASS_CONST_OBJECT_FETCH porigin ptbytes_class ptbytes_member z) = $class_constant_object_fetch_valid(S, porigin, ptbytes_class, ptbytes_member, z)

