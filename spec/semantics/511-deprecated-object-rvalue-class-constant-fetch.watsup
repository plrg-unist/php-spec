def $class_constant_class_forward(S, poperand_original, expression_class, NIdentifier (BYTES text_member) metadata_member, z, ptask_tail*) = S[.TODO = (CLASS_CONST_OBJECT_FETCH porigin_site ptbytes_class $base64(text_member) z) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
