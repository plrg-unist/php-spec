  -- if ~$property_magic_set_guard(S, S.CURRENT, S.FRAMES, n, ptbytes_name)
def $property_magic_update_plan(S) = eps -- otherwise
def $property_magic_update_pending(S) = ($property_magic_update_plan(S) =/= eps)

rule PhpStep/property-magic-update-get: S ~> S[.TODO = [(CALL_ARGS (PROPERTY_GET_TARGET ppropertymagicupdate.GET.OBJECT ppropertymagicupdate.GET.METHOD) eps 1 ([KNOWN (PSTRING ppropertymagicupdate.GET.NAME)]) (ppropertymagicupdate.GET.SITE) ppropertymagicupdate.GET.LINE), PROPERTY_GET_RESULT ppropertymagicupdate.GET, ORIGIN_RETURN (ppropertymagicupdate.SITE), PROPERTY_MAGIC_UPDATE_VALUE ppropertymagicupdate] ++ ppropertymagicupdate.TAIL][.ORIGIN = (ppropertymagicupdate.GET.SITE)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if ~$key_write_pending(S)
  -- if $property_magic_update_plan(S) = (ppropertymagicupdate)

dec $property_magic_update_next(pupdate, int) : int
def $property_magic_update_next(INCREMENT, i) = $(i + 1)
def $property_magic_update_next(DECREMENT, i) = $(i - 1)
dec $property_magic_update_values(ppropertymagicupdate, int, int) : bool
def $property_magic_update_values(ppropertymagicupdate, i_old, i_new) = ($long_range(i_old) /\ $long_range(i_new) /\ i_new = $property_magic_update_next(ppropertymagicupdate.OP, i_old))
dec $property_magic_update_result(ppropertymagicupdate, int, int) : int
def $property_magic_update_result(ppropertymagicupdate, i_old, i_new) = i_old -- if ppropertymagicupdate.POST
def $property_magic_update_result(ppropertymagicupdate, i_old, i_new) = i_new -- if ~ppropertymagicupdate.POST

;; OLD and NEW are immutable before Set. Its receipt selects the same object
;; even when Get has nulled or rebound the receiver CV.
dec $property_magic_update_set(pstate, ppropertymagicset) : bool
def $property_magic_update_set(S, ppropertymagicset) = true
  -- if ppropertymagicset.TAIL = (PROPERTY_MAGIC_UPDATE_FINISH ppropertymagicupdate i_old i_new) :: ptask_tail*
  -- if ptask_tail* = ppropertymagicupdate.TAIL
  -- if $property_magic_update_history(S, ppropertymagicupdate)
  -- if $property_magic_update_values(ppropertymagicupdate, i_old, i_new)
  -- if ppropertymagicset = {SITE ppropertymagicupdate.SITE, NAME ppropertymagicupdate.GET.NAME, LINE ppropertymagicupdate.LINE, OBJECT ppropertymagicupdate.GET.OBJECT, CLASS ppropertymagicupdate.GET.CLASS, METHOD ppropertymagicupdate.SET, PROPERTY ppropertymagicupdate.PROPERTY, RHS KNOWN (PINT i_new), CELL eps, INPUT i_new, OWNER ppropertymagicupdate.OWNER, CALLER ppropertymagicupdate.CALLER, TAIL ((PROPERTY_MAGIC_UPDATE_FINISH ppropertymagicupdate i_old i_new) :: ppropertymagicupdate.TAIL)}
def $property_magic_update_set(S, ppropertymagicset) = false -- otherwise
def $property_magic_set_source(S, ppropertymagicset) = true
  -- if $property_magic_update_set(S, ppropertymagicset)
def $property_magic_set_capture(S, ppropertymagicset) = true
  -- if $property_magic_update_set(S, ppropertymagicset)
  -- if $property_magic_set_valid(S, ppropertymagicset)

dec $property_magic_update_set_plan(pstate) : ppropertymagicset?
def $property_magic_update_set_plan(S) = (ppropertymagicset)
  -- if S.TODO = (PROPERTY_MAGIC_UPDATE_VALUE ppropertymagicupdate) :: ptask_tail*
  -- if S.COMPLETION = NORMAL
  -- if $property_magic_update_valid(S, ppropertymagicupdate, PROPERTY_MAGIC_UPDATE_VALUE ppropertymagicupdate)
  -- if S.RESULT = KNOWN (PINT i_old)
  -- if i_new = $property_magic_update_next(ppropertymagicupdate.OP, i_old)
  -- if $property_magic_update_values(ppropertymagicupdate, i_old, i_new)
  -- if ppropertymagicset = {SITE ppropertymagicupdate.SITE, NAME ppropertymagicupdate.GET.NAME, LINE ppropertymagicupdate.LINE, OBJECT ppropertymagicupdate.GET.OBJECT, CLASS ppropertymagicupdate.GET.CLASS, METHOD ppropertymagicupdate.SET, PROPERTY ppropertymagicupdate.PROPERTY, RHS KNOWN (PINT i_new), CELL eps, INPUT i_new, OWNER ppropertymagicupdate.OWNER, CALLER ppropertymagicupdate.CALLER, TAIL ((PROPERTY_MAGIC_UPDATE_FINISH ppropertymagicupdate i_old i_new) :: ppropertymagicupdate.TAIL)}
  -- if ~$property_magic_set_guard(S, S.CURRENT, S.FRAMES, ppropertymagicupdate.GET.OBJECT, ppropertymagicupdate.GET.NAME)
  -- if $property_magic_update_set(S, ppropertymagicset)
def $property_magic_update_set_plan(S) = eps -- otherwise
rule PhpStep/property-magic-update-set: S ~> S[.TODO = [(CALL_ARGS (PROPERTY_MAGIC_SET_TARGET ppropertymagicset) eps 2 ([KNOWN (PSTRING ppropertymagicset.NAME), KNOWN (PINT ppropertymagicset.INPUT)]) (ppropertymagicset.SITE) ppropertymagicset.LINE), PROPERTY_MAGIC_SET_RESULT ppropertymagicset] ++ ppropertymagicset.TAIL][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if $property_magic_update_set_plan(S) = (ppropertymagicset)
rule PhpStep/property-magic-update-value-invalid: S ~> S[.COMPLETION = UNSUPPORTED "magic update getter result or integer range"]
  -- if S.TODO = (PROPERTY_MAGIC_UPDATE_VALUE ppropertymagicupdate) :: ptask_tail*
  -- if S.COMPLETION = NORMAL
  -- if $property_magic_update_set_plan(S) = eps

rule PhpStep/property-magic-update-finish: S ~> S[.TODO = ppropertymagicupdate.TAIL][.RESULT = KNOWN (PINT $property_magic_update_result(ppropertymagicupdate, i_old, i_new))]
  -- if S.TODO = (PROPERTY_MAGIC_UPDATE_FINISH ppropertymagicupdate i_old i_new) :: ptask_tail*
  -- if S.COMPLETION = NORMAL /\ S.RESULT = KNOWN (PINT i_new)
  -- if $property_magic_update_valid(S, ppropertymagicupdate, PROPERTY_MAGIC_UPDATE_FINISH ppropertymagicupdate i_old i_new)
  -- if $property_magic_update_values(ppropertymagicupdate, i_old, i_new)
rule PhpStep/property-magic-update-finish-invalid: S ~> S[.COMPLETION = UNSUPPORTED "magic update result continuation"]
  -- if S.TODO = (PROPERTY_MAGIC_UPDATE_FINISH ppropertymagicupdate i_old i_new) :: ptask_tail*
  -- if S.COMPLETION = NORMAL
  -- if ~$property_magic_update_valid(S, ppropertymagicupdate, PROPERTY_MAGIC_UPDATE_FINISH ppropertymagicupdate i_old i_new) \/ ~$property_magic_update_values(ppropertymagicupdate, i_old, i_new) \/ S.RESULT =/= KNOWN (PINT i_new)

def $task_nodes(PROPERTY_MAGIC_UPDATE_VALUE ppropertymagicupdate) = [HOBJECT ppropertymagicupdate.GET.OBJECT]
def $task_nodes(PROPERTY_MAGIC_UPDATE_FINISH ppropertymagicupdate i_old i_new) = [HOBJECT ppropertymagicupdate.GET.OBJECT]
def $call_task_valid(S, PROPERTY_MAGIC_UPDATE_VALUE ppropertymagicupdate) = $property_magic_update_valid(S, ppropertymagicupdate, PROPERTY_MAGIC_UPDATE_VALUE ppropertymagicupdate)
def $call_task_valid(S, PROPERTY_MAGIC_UPDATE_FINISH ppropertymagicupdate i_old i_new) = ($property_magic_update_valid(S, ppropertymagicupdate, PROPERTY_MAGIC_UPDATE_FINISH ppropertymagicupdate i_old i_new) /\ $property_magic_update_values(ppropertymagicupdate, i_old, i_new))
def $return_discard(S, PROPERTY_MAGIC_UPDATE_VALUE ppropertymagicupdate) = S[.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
def $return_discard(S, PROPERTY_MAGIC_UPDATE_FINISH ppropertymagicupdate i_old i_new) = S[.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
def $error_read_discard(S, PROPERTY_MAGIC_UPDATE_VALUE ppropertymagicupdate) = S[.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
def $error_read_discard(S, PROPERTY_MAGIC_UPDATE_FINISH ppropertymagicupdate i_old i_new) = S[.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
def $eager_operation_source_guard(S, pdestructionoperation) = ($property_magic_update_history(S, ppropertymagicupdate) /\ $property_magic_update_values(ppropertymagicupdate, i_old, i_new))
  -- if pdestructionoperation.SOURCE = PROPERTY_MAGIC_UPDATE_FINISH ppropertymagicupdate i_old i_new
