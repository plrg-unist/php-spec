  -- if $origin_node(S.SOURCES, porigin_site) = (NExprConstFetch name metadata)
  -- if $global_constant_alias(S, S.USERCONSTANTS, porigin_site) = (puserconstant)
def $parameter_callable_quiet_source_at(S, porigin_site, porigin_seen*) = $parameter_callable_quiet_items(S, porigin_site, 0, phpType13*, porigin_seen*)
  -- if $compiled_redirect(S, porigin_site) = eps
  -- if $origin_node(S.SOURCES, porigin_site) = (NExprArray (SEQUENCE phpType13*) metadata)
def $parameter_callable_quiet_source_at(S, porigin_site, porigin_seen*) = false -- otherwise
def $parameter_callable_quiet_leaf(NScalarInt phpType24 metadata) = true
def $parameter_callable_quiet_leaf(NScalarFloat phpType41 metadata) = true
def $parameter_callable_quiet_leaf(NScalarString phpType33 metadata) = true
def $parameter_callable_quiet_leaf(NExprConstFetch (NName (BYTES text) metadata_name) metadata) = ($ptlc($base64(text)) <- [$ptascii("true"), $ptascii("false"), $ptascii("null")])
def $parameter_callable_quiet_leaf(NExprClosure phpType14 phpType4_static phpType4_ref phpType16 phpType21 phpType18 phpType23 metadata) = $constant_callable_form(NExprClosure phpType14 phpType4_static phpType4_ref phpType16 phpType21 phpType18 phpType23 metadata)
def $parameter_callable_quiet_leaf(NExprFuncCall phpType19 phpType6 metadata) = $constant_callable_form(NExprFuncCall phpType19 phpType6 metadata)
def $parameter_callable_quiet_leaf(pcnode) = false -- otherwise
def $parameter_callable_quiet_key(S, porigin_item, ABSENT) = true
def $parameter_callable_quiet_key(S, porigin_item, expression) = $parameter_callable_quiet_key_value($compiled_read(S, porigin_key))
