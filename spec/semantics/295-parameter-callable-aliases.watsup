def $parameter_callable_quiet_source_at(S, porigin_site, porigin_seen*) = $parameter_callable_quiet_source(S, porigin_target, porigin_seen*)
  -- if $compiled_redirect(S, porigin_site) = ((porigin_target, expression, false, z))
  -- if $redirect_effect_tasks(S, porigin_site, porigin_target) = eps
def $parameter_callable_quiet_source_at(S, porigin_site, porigin_seen*) = true
  -- if $compiled_redirect(S, porigin_site) = eps
  -- if $origin_node(S.SOURCES, porigin_site) = (pcnode)
