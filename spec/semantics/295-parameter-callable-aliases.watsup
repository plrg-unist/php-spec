;; Borrowed parameter callable values keep the donor's identity and permission.
;; Global aliases currently require a callback-free initializer and the current
;; registry at transfer. Effectful historical reads await a genuine causal cut.
dec $parameter_callable_quiet_class(pvalueclass) : bool
dec $parameter_callable_quiet_entries((pkey, pvalueclass)*) : bool
dec $parameter_callable_quiet_facts(pconstantfact*) : bool
def $parameter_callable_quiet_class(PVSCALAR) = true
def $parameter_callable_quiet_class(PVSTRING b) = true
def $parameter_callable_quiet_class(PVCLOSURE n_object porigin_site) = true
def $parameter_callable_quiet_class(PVARRAY b (pkey, pvalueclass)*) = $parameter_callable_quiet_entries((pkey, pvalueclass)*)
def $parameter_callable_quiet_class(pvalueclass) = false -- otherwise
def $parameter_callable_quiet_entries(eps) = true
def $parameter_callable_quiet_entries((pkey, pvalueclass) :: (pkey_tail, pvalueclass_tail)*) = ($parameter_callable_quiet_class(pvalueclass) /\ $parameter_callable_quiet_entries((pkey_tail, pvalueclass_tail)*))
def $parameter_callable_quiet_facts(eps) = true
def $parameter_callable_quiet_facts(pconstantfact :: pconstantfact_tail*) = ($parameter_callable_quiet_class(pconstantfact.CLASS) /\ $parameter_callable_quiet_facts(pconstantfact_tail*))

