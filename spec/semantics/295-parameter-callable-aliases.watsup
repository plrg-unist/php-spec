def $parameter_callable_quiet_key(S, porigin_item, phpType5) = false -- otherwise
def $parameter_callable_quiet_key_value((PINT i)) = true
def $parameter_callable_quiet_key_value((PSTRING n*)) = true
def $parameter_callable_quiet_key_value((PBOOL b)) = true
def $parameter_callable_quiet_key_value(pvalue?) = false -- otherwise
def $parameter_callable_quiet_items(S, porigin_array, n_index, eps, porigin_seen*) = true
def $parameter_callable_quiet_items(S, porigin_array, n_index, (NArrayItem phpType5 expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType13*, porigin_seen*) = ($parameter_callable_quiet_key(S, porigin_item, phpType5) /\ $parameter_callable_quiet_source(S, $constant_child(porigin_item, [PCFIELD 1]), porigin_seen*) /\ $parameter_callable_quiet_items(S, porigin_array, $(n_index + 1), phpType13*, porigin_seen*))
  -- if porigin_item = $constant_child(porigin_array, [PCFIELD 0, PCINDEX n_index])
def $parameter_callable_quiet_items(S, porigin_array, n_index, phpType13*, porigin_seen*) = false -- otherwise

