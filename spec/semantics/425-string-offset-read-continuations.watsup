  -- if $startup_bytes(n_key*) /\ $c_string(n_key*) = n_key*
;; A REQUEST key is consumed immediately from its exact current ordinary CV;
;; immutable registry bytes alone do not establish a live selected owner.
def $string_read_current_offset(S, pstringread, PSTRING_CARRIER (REQUEST_STRING n_identity) n_text*) = ($string_cast_integer(n_text*))
  -- if $string_read_cv_key(S, pstringread.READ) = (PSTRING_CARRIER (REQUEST_STRING n_identity) n_text*)
;; Existing pool/CV sharing is harmless for this immediate, read-only count.
;; The exact current array supplies liveness; retained ARRAY metadata does not.
def $string_read_current_offset(S, pstringread, PARRAY n) = ($cast_truth_int(S, PARRAY n))
  -- if $string_read_cv_key(S, pstringread.READ) = (PARRAY n)
def $string_read_current_offset(S, pstringread, pvalue) = $string_read_offset(pvalue) -- otherwise
