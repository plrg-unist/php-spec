;; Existing class-value evaluation normalizes a string or ordinary object CV
;; to its selected class before arguments. The source CV is not read again.
dec $parameter_class_value_site(pstate, porigin) : bool
def $parameter_class_value_site(S, porigin) = true
  -- if $origin_node(S.SOURCES, porigin) = (NExprStaticCall (NExprVariable phpType32 metadata_class) (NIdentifier (BYTES text) metadata_name) (SEQUENCE phpType7*) metadata)
  -- if $cv_name(phpType32) = (ptbytes)
  -- if ~$direct_this(phpType32) /\ ~$ppfirstclass(phpType7*)
def $parameter_class_value_site(S, porigin) = false -- otherwise

dec $parameter_class_value_current(pstate, pfunction) : bool
def $parameter_class_value_current(S, pfunction) = true
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.FUNCTION = pfunction.ORIGIN /\ pcallcontext.NAME = pfunction.NAME
  -- if pcallcontext.CALLSITE = (porigin_site)
  -- if $parameter_class_value_site(S, porigin_site)
  -- if pcallcontext.TARGET = SCOPED_TARGET porigin_called pfunction.ORIGIN porigin_called eps (KNOWN pvalue_selector)
  -- if $string_bytes(pvalue_selector) = (ptbytes)
  -- if $parameter_raw_named_class(S, porigin_called)
  -- if $parameter_method_source(S, pfunction) = (pmethoddesc)
  -- if pmethoddesc.VISIBILITY = PROPERTY_PUBLIC /\ pmethoddesc.STATIC
  -- if pcallcontext.LEXICAL_CLASS = (pmethoddesc.OWNER)
  -- if pcallcontext.CALLED_CLASS = (porigin_called) /\ pcallcontext.RECEIVER = eps
  -- if pcallcontext.INSTANCE = eps /\ pcallcontext.WRAPPER = eps /\ pcallcontext.CACHE = eps
  -- if $target_function(S, pcallcontext.TARGET) = (pfunction)
  -- if $scoped_call_selected(S, pcallcontext.TARGET, porigin_site)
  -- if $default_cache_owner(S) = (CACHE_SHARED)
def $parameter_class_value_current(S, pfunction) = false -- otherwise

def $parameter_method_current_valid(S, pfunction) = $parameter_class_value_current(S, pfunction)
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.CALLSITE = (porigin_site)
  -- if $parameter_class_value_site(S, porigin_site)

;; Historical function/scopes identify the effective public static descriptor.
;; The current class CV and its former object/string storage add no authority.
dec $parameter_class_value_invocation(pstate, pfunction, pdeclcalls, nat) : bool
def $parameter_class_value_invocation(S, pfunction, (porigin_function, porigin_site_option?, porigin_owner_option?, porigin_called_option?) :: pdeclcalls, n_prefix) = true
  -- if porigin_function = pfunction.ORIGIN
  -- if porigin_site_option? = (porigin_site)
  -- if porigin_owner_option? = (porigin_owner)
  -- if porigin_called_option? = (porigin_called)
  -- if $parameter_class_value_site(S, porigin_site)
  -- if $parameter_method_source(S, pfunction) = (pmethoddesc)
  -- if pmethoddesc.VISIBILITY = PROPERTY_PUBLIC /\ pmethoddesc.STATIC
  -- if pmethoddesc.OWNER = porigin_owner
  -- if $parameter_raw_named_class(S, porigin_called)
  -- if $effective_method(S, porigin_called, pmethoddesc.NAME, |S.CLASSES|) = (pmethoddesc)
  -- if $(n_prefix <= |S.DECLARATIONS|)
  -- if $parameter_callable_function_published(S, pfunction, n_prefix)
  -- if $constant_callable_published(S.DECLARATIONS[0:n_prefix], porigin_called)
  -- if $declaration_method_call_selection(S, pmethoddesc, porigin_called, porigin_site, pdeclcalls, false)
def $parameter_class_value_invocation(S, pfunction, pdeclcalls, n_prefix) = false -- otherwise

def $parameter_method_invocation(S, pfunction, pdeclcalls, n_prefix) = true
  -- if $parameter_class_value_invocation(S, pfunction, pdeclcalls, n_prefix)

;; Actual normal static selection gates owning-source hits, including scalars.
def $default_nonclosure_recipient(S, pfunction, pdefault) = $parameter_class_value_current(S, pfunction)
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.TARGET = SCOPED_TARGET porigin_requested porigin_function porigin_called n_receiver? poperand
