;; output.c tests raw FALSE/TRUE before convert_to_string unwraps a reference.
;; Keep the real returned cell through CV cleanup and produced-output warnings;
;; only scalar conversion reads its current payload and drops the retval owner.
dec $ob_return_marker(ptask) : ptask
dec $ob_return_tasks(ptask*, ptask, ptask*) : bool
dec $ob_return_frames(pframe*, ptask, pcallcontext?, porigin, ptask*) : bool
dec $ob_return_context(pstate, ptask, pcallcontext?, porigin, ptask*) : bool
dec $ob_ref_current(pstate, pobrefreturn) : bool
dec $ob_ref_valid(pstate, ptask, pobrefreturn, bool) : bool
dec $ob_ref_nodes(pobrefreturn) : pnode*
dec $ob_ref_begin(pstate, pobrefreturn) : pstate
dec $ob_ref_discard(pstate, pobrefreturn) : pstate
dec $ob_ref_commit(pstate, pobrefreturn, poboutput) : pstate
dec $ob_ref_pending(pstate, pobinvoke, nat, nat) : pstate
dec $ob_ref_bytes(pvalue, int) : preqbytes
dec $ob_ref_notice_restore(pstate, pstate, pobinvoke, nat, nat, ptask*) : pstate
dec $ob_ref_unwrap_successor(pstate, ptask*, pdestructionoperation, pobrefreturn) : bool
dec $ob_ref_nonscalar_return(pstate, pobrefreturn, pvalue) : pstate

;; Zend always requests the callback retval, even when the source print's own
;; result is discarded by its surrounding statement or for clause.
def $reference_callback_used(S, pcallcontext) = (true) -- if $ob_user_context_valid(S, pcallcontext)

def $ob_return_marker(ERROR_HANDLER_INVOKE perrorcall) = $ob_return_marker(perrorcall.RESUME)
def $ob_return_marker(ERROR_HANDLER_RESULT perrorcall) = $ob_return_marker(perrorcall.RESUME)
def $ob_return_marker(ERROR_HANDLER_CLEAN perrorcall) = $ob_return_marker(perrorcall.RESUME)
def $ob_return_marker(API_CALLBACK_SEND papiargcursor) = $ob_return_marker(perrorcall.RESUME) -- if papiargcursor.CALL = API_ERROR perrorcall
def $ob_return_marker(API_CALLBACK_REF papiargcursor) = $ob_return_marker(perrorcall.RESUME) -- if papiargcursor.CALL = API_ERROR perrorcall
def $ob_return_marker(ptask) = ptask -- otherwise
def $ob_return_tasks(ptask :: ptask_tail*, ptask_expected, ptask_native*) = (ptask_tail* = ptask_native*) -- if $ob_return_marker(ptask) = ptask_expected
def $ob_return_tasks(ptask :: ptask_tail*, ptask_expected, ptask_native*) = $ob_return_tasks(ptask_tail*, ptask_expected, ptask_native*) -- if $ob_return_marker(ptask) =/= ptask_expected
def $ob_return_tasks(eps, ptask, ptask_native*) = false
def $ob_return_frames(eps, ptask, pcallcontext?, porigin, ptask_native*) = false
def $ob_return_frames(pframe :: pframe_tail*, ptask, pcallcontext?, porigin, ptask_native*) = ((pframe.CONTEXT = pcallcontext? /\ pframe.ORIGIN = (porigin) /\ $ob_return_tasks(pframe.TODO, ptask, ptask_native*)) \/ $ob_return_frames(pframe_tail*, ptask, pcallcontext?, porigin, ptask_native*))
def $ob_ref_current(S, pobrefreturn) = (S.CURRENT = pobrefreturn.CALLER /\ S.ORIGIN = ($ob_call_site(pobrefreturn.INVOKE.CALL)))
def $ob_return_context(S, ptask, pcallcontext?, porigin, ptask_native*) = ((S.CURRENT = pcallcontext? /\ S.ORIGIN = (porigin) /\ $ob_return_tasks(S.TODO, ptask, ptask_native*)) \/ $ob_return_frames(S.FRAMES, ptask, pcallcontext?, porigin, ptask_native*))
def $ob_ref_valid(S, ptask, pobrefreturn, b_cell) = true
  -- if $ob_return_context(S, ptask, pobrefreturn.CALLER, $ob_call_site(pobrefreturn.INVOKE.CALL), pobrefreturn.TAIL)
  -- if pobinvoke = pobrefreturn.INVOKE
  -- if S_scope = S[.CURRENT = pobrefreturn.CALLER][.ORIGIN = ($ob_call_site(pobinvoke.CALL))][.TODO = (OB_USER_RESULT pobinvoke) :: pobrefreturn.TAIL]
  -- if $call_task_valid(S_scope, OB_USER_RESULT pobinvoke)
  -- if ~b_cell \/ $call_reference_operand_valid(S, REFERENCE pobrefreturn.CELL)
  -- if $destructor_pending_valid(S, pobrefreturn.PENDING)
def $ob_ref_valid(S, ptask, pobrefreturn, b_cell) = false -- otherwise
def $ob_ref_nodes(pobrefreturn) = $ob_user_nodes(pobrefreturn.INVOKE) ++ [HCELL pobrefreturn.CELL] ++ $instance_roots(pobrefreturn.PENDING)
def $task_nodes(OB_USER_REF_DEPRECATED pobrefreturn) = $ob_ref_nodes(pobrefreturn)
def $task_nodes(OB_USER_REF_UNWRAP pobrefreturn) = $ob_ref_nodes(pobrefreturn)
def $task_nodes(OB_USER_REF_NOTICE pobrefreturn n) = $ob_ref_nodes(pobrefreturn)
;; CELL/CALLER/TAIL now witness the consumed retval; they add no roots.
def $task_nodes(OB_USER_REF_COMMIT pobrefreturn poboutput) = $ob_user_nodes(pobrefreturn.INVOKE) ++ $value_nodes(poboutput.VALUE) ++ $instance_roots(pobrefreturn.PENDING)
def $ob_user_active_task(OB_USER_REF_DEPRECATED pobrefreturn) = (pobrefreturn.INVOKE.BUFFER.ID)
def $ob_user_active_task(OB_USER_REF_UNWRAP pobrefreturn) = (pobrefreturn.INVOKE.BUFFER.ID)
def $ob_user_active_task(OB_USER_REF_COMMIT pobrefreturn poboutput) = (pobrefreturn.INVOKE.BUFFER.ID)
def $ob_user_active_task(OB_USER_REF_NOTICE pobrefreturn n) = (pobrefreturn.INVOKE.BUFFER.ID)
def $ob_user_disabled_task(OB_USER_REF_DEPRECATED pobrefreturn, n) = (pobrefreturn.INVOKE.BUFFER.ID = n)
def $output_task_write(OB_USER_REF_DEPRECATED pobrefreturn) = $output_call_write(pobrefreturn.INVOKE.CALL)
def $output_task_write(OB_USER_REF_UNWRAP pobrefreturn) = $output_call_write(pobrefreturn.INVOKE.CALL)
def $output_task_write(OB_USER_REF_COMMIT pobrefreturn poboutput) = $output_call_write(pobrefreturn.INVOKE.CALL)
def $output_task_write(OB_USER_REF_NOTICE pobrefreturn n) = $output_call_write(pobrefreturn.INVOKE.CALL)
def $ob_user_resume_api(OB_USER_REF_DEPRECATED pobrefreturn) = $ob_call_api(pobrefreturn.INVOKE.CALL)
def $output_drain_warning_resume(OB_USER_REF_DEPRECATED pobrefreturn) = $output_drain_final_call(pobrefreturn.INVOKE.CALL)
def $output_drain_task(S, OB_USER_REF_DEPRECATED pobrefreturn) = $output_drain_active(S, pobdrain) -- if pobrefreturn.INVOKE.CALL = OB_FINAL pobdrain
def $output_drain_task(S, OB_USER_REF_UNWRAP pobrefreturn) = $output_drain_active(S, pobdrain) -- if pobrefreturn.INVOKE.CALL = OB_FINAL pobdrain
def $output_drain_task(S, OB_USER_REF_COMMIT pobrefreturn poboutput) = $output_drain_active(S, pobdrain) -- if pobrefreturn.INVOKE.CALL = OB_FINAL pobdrain

def $call_task_valid(S, OB_USER_REF_DEPRECATED pobrefreturn) = ($ob_ref_valid(S, OB_USER_REF_DEPRECATED pobrefreturn, pobrefreturn, true) /\ pobrefreturn.PENDING = eps /\ $ob_user_temporary(S, pobrefreturn.INVOKE.BUFFER.ID) /\ $long_and(poutputbuffer.FLAGS, 40960) = 8192)
  -- if $output_selected(S, pobrefreturn.INVOKE) = (poutputbuffer)
def $call_task_valid(S, OB_USER_REF_UNWRAP pobrefreturn) = ($ob_ref_valid(S, OB_USER_REF_UNWRAP pobrefreturn, pobrefreturn, true) /\ $long_and(poutputbuffer.FLAGS, 40960) = 0)
  -- if $output_selected(S, pobrefreturn.INVOKE) = (poutputbuffer)
def $call_task_valid(S, OB_USER_REF_COMMIT pobrefreturn poboutput) = ($ob_ref_valid(S, OB_USER_REF_COMMIT pobrefreturn poboutput, pobrefreturn, false) /\ $ob_user_output_valid(S, poboutput) /\ $string_bytes(poboutput.VALUE) = (poboutput.BYTES) /\ ~poboutput.FAILED /\ $long_and(poutputbuffer.FLAGS, 40960) = 0)
  -- if $output_selected(S, pobrefreturn.INVOKE) = (poutputbuffer)
def $call_task_valid(S, OB_USER_REF_NOTICE pobrefreturn n) = ($ob_ref_valid(S, OB_USER_REF_NOTICE pobrefreturn n, pobrefreturn, true) /\ pobrefreturn.PENDING = eps /\ $throwable_live(S, n))

def $ob_user_reference_return(S, pobinvoke, n) = $ob_ref_begin(S[.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], {INVOKE pobinvoke, CELL n, PENDING eps, CALLER S.CURRENT, TAIL ptask_tail*})
  -- if S.TODO = (OB_USER_RESULT pobinvoke) :: ptask_tail*
  -- if S.RESULT = REFERENCE n
  -- if $call_reference_operand_valid(S, REFERENCE n)
def $ob_ref_begin(S, pobrefreturn) = S[.TODO = (OB_USER_REF_UNWRAP pobrefreturn) :: pobrefreturn.TAIL]
  -- if $output_selected(S, pobrefreturn.INVOKE) = (poutputbuffer)
  -- if $long_and(poutputbuffer.FLAGS, 32768) = 0
def $ob_ref_begin(S, pobrefreturn) = $error_dispatch(S[.TODO = (OB_USER_REF_DEPRECATED pobrefreturn) :: pobrefreturn.TAIL][.OUTPUTBUFFERS = $output_set(S.OUTPUTBUFFERS, poutputbuffer.ID, poutputbuffer[.FLAGS = $long_or($long_and(poutputbuffer.FLAGS, $(-32769)), 8192)])], 8192, $ob_user_deprecation(pobrefreturn.INVOKE), $ob_call_line(pobrefreturn.INVOKE.CALL), $ob_call_event(pobrefreturn.INVOKE.CALL, "Deprecated", $ob_user_deprecation(pobrefreturn.INVOKE), $ob_call_line(pobrefreturn.INVOKE.CALL)), OB_USER_REF_DEPRECATED pobrefreturn)
  -- if pobrefreturn.PENDING = eps
  -- if $output_selected(S, pobrefreturn.INVOKE) = (poutputbuffer)
  -- if $long_and(poutputbuffer.FLAGS, 32768) =/= 0
def $ob_ref_begin(S, pobrefreturn) = $ob_normal_deprecation(S[.TODO = (OB_USER_REF_UNWRAP pobrefreturn) :: pobrefreturn.TAIL], pobrefreturn.INVOKE)
  -- if pobrefreturn.PENDING =/= eps
  -- if $output_selected(S, pobrefreturn.INVOKE) = (poutputbuffer)
  -- if $long_and(poutputbuffer.FLAGS, 32768) =/= 0
def $error_call_valid(S, perrorcall) = true
  -- if perrorcall.RESUME = OB_USER_REF_DEPRECATED pobrefreturn
  -- if $call_task_valid(S, OB_USER_REF_DEPRECATED pobrefreturn)
  -- if perrorcall.SITE = $ob_call_site(pobrefreturn.INVOKE.CALL) /\ perrorcall.LINE = $ob_call_line(pobrefreturn.INVOKE.CALL)
  -- if perrorcall.LEVEL = 8192 /\ perrorcall.MESSAGE = $ob_user_deprecation(pobrefreturn.INVOKE)
  -- if perrorcall.EVENT = $ob_call_event(pobrefreturn.INVOKE.CALL, "Deprecated", perrorcall.MESSAGE, perrorcall.LINE)
rule PhpStep/ob-reference-deprecated: S ~> S[.TODO = (OB_USER_REF_UNWRAP pobrefreturn) :: ptask_tail*][.OUTPUTBUFFERS = $output_set(S.OUTPUTBUFFERS, poutputbuffer.ID, poutputbuffer[.FLAGS = $long_and(poutputbuffer.FLAGS, $(-8193))])]
  -- if S.TODO = (OB_USER_REF_DEPRECATED pobrefreturn) :: ptask_tail*
  -- if $call_task_valid(S, OB_USER_REF_DEPRECATED pobrefreturn) /\ $ob_ref_current(S, pobrefreturn)
  -- if $output_selected(S, pobrefreturn.INVOKE) = (poutputbuffer)

def $ob_ref_bytes(PBOOL true, z) = [49]
def $ob_ref_bytes(pvalue, z) = $ob_user_bytes(pvalue, z) -- if pvalue =/= PBOOL true
rule PhpStep/ob-reference-unwrap: S ~> S[.TODO = (OB_USER_REF_COMMIT pobrefreturn $ob_user_output(S, PSTRING $ob_ref_bytes(pvalue, $precision_value(S)))) :: ptask_tail*]
  -- if S.TODO = (OB_USER_REF_UNWRAP pobrefreturn) :: ptask_tail*
  -- if $call_task_valid(S, OB_USER_REF_UNWRAP pobrefreturn) /\ $ob_ref_current(S, pobrefreturn)
  -- if S.STORE[pobrefreturn.CELL] = DEFINED pvalue
  -- if $ob_user_scalar(pvalue)
rule PhpStep/ob-reference-nonscalar: S ~> $ob_ref_nonscalar_return(S, pobrefreturn, pvalue)
  -- if S.TODO = (OB_USER_REF_UNWRAP pobrefreturn) :: ptask_tail*
  -- if $call_task_valid(S, OB_USER_REF_UNWRAP pobrefreturn) /\ $ob_ref_current(S, pobrefreturn)
  -- if S.STORE[pobrefreturn.CELL] = DEFINED pvalue
  -- if ~$ob_user_scalar(pvalue)
def $ob_ref_nonscalar_return(S, pobrefreturn, pvalue) = S[.COMPLETION = UNSUPPORTED "non-scalar reference user output-handler return conversion"] -- otherwise
rule PhpStep/ob-reference-commit: S ~> $ob_ref_commit(S, pobrefreturn, poboutput)
  -- if S.TODO = (OB_USER_REF_COMMIT pobrefreturn poboutput) :: ptask_tail*
  -- if $call_task_valid(S, OB_USER_REF_COMMIT pobrefreturn poboutput) /\ $ob_ref_current(S, pobrefreturn)
def $ob_ref_commit(S, pobrefreturn, poboutput) = $ob_user_commit(S, pobrefreturn.INVOKE[.SENT = eps], poboutput) -- if pobrefreturn.PENDING = eps
def $ob_ref_commit(S, pobrefreturn, poboutput) = $ob_deprecation_commit(S, pobrefreturn.INVOKE[.SENT = eps], poboutput, n) -- if pobrefreturn.PENDING = (n)

;; A destructor-capable request can stage even a scalar cell's decrement. The
;; real COMMIT keeps F, while this release operation owns only its actual jobs.
;; CELL is historical after that decrement and must not be revived to check it.
def $ob_ref_unwrap_successor(S, (DESTRUCTOR_RELEASE pdestructionrelease) :: ptask_tail*, pdestructionoperation, pobrefreturn) = $ob_ref_unwrap_successor(S, ptask_tail*, pdestructionoperation, pobrefreturn)
def $ob_ref_unwrap_successor(S, (DESTRUCTOR_OPERATION_EXIT pdestructionoperation_actual) :: (OB_USER_REF_COMMIT pobrefreturn_actual poboutput) :: ptask_tail*, pdestructionoperation, pobrefreturn) = (pdestructionoperation_actual = pdestructionoperation /\ pobrefreturn_actual = pobrefreturn /\ ptask_tail* = pobrefreturn.TAIL /\ $call_task_valid(S, OB_USER_REF_COMMIT pobrefreturn poboutput))
def $ob_ref_unwrap_successor(S, ptask*, pdestructionoperation, pobrefreturn) = false -- otherwise
def $eager_operation_source_guard(S, pdestructionoperation) = ($ob_ref_current(S, pobrefreturn) /\ pdestructionoperation.CALLER = pobrefreturn.CALLER /\ pdestructionoperation.ORIGIN = ($ob_call_site(pobrefreturn.INVOKE.CALL)) /\ pdestructionoperation.CONSTCONTEXT = S.CONSTCONTEXT /\ pdestructionoperation.COMPLETION = NORMAL /\ pdestructionoperation.PENDING = eps /\ pdestructionoperation.VALUE = KNOWN PNULL /\ pdestructionoperation.BASE = BASE_VALUE (KNOWN PNULL) /\ pdestructionoperation.CLEANUP = eps /\ $ob_ref_unwrap_successor(S, S.TODO, pdestructionoperation, pobrefreturn))
  -- if pdestructionoperation.SOURCE = OB_USER_REF_UNWRAP pobrefreturn

def $error_read_discard(S, OB_USER_REF_DEPRECATED pobrefreturn) = $ob_ref_discard(S, pobrefreturn)
def $return_discard(S, OB_USER_REF_DEPRECATED pobrefreturn) = $ob_ref_discard(S, pobrefreturn)
def $ob_ref_discard(S, pobrefreturn) = S[.TODO = (OB_USER_REF_UNWRAP pobrefreturn[.PENDING = (n)]) :: pobrefreturn.TAIL][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)][.OUTPUTBUFFERS = $output_set(S.OUTPUTBUFFERS, poutputbuffer.ID, poutputbuffer[.FLAGS = $long_and(poutputbuffer.FLAGS, $(-8193))])]
