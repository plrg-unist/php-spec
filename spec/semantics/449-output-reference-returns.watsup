def $ob_ref_discard(S, pobrefreturn) = S[.TODO = (OB_USER_REF_DEPRECATED pobrefreturn) :: S.TODO][.COMPLETION = UNSUPPORTED "abrupt FINAL reference output-handler deprecation cleanup"] -- otherwise
def $return_discard(S, OB_USER_REF_UNWRAP pobrefreturn) = S[.TODO = (OB_USER_REF_UNWRAP pobrefreturn) :: S.TODO][.COMPLETION = UNSUPPORTED "abrupt reference output-handler return cleanup"]
def $return_discard(S, OB_USER_REF_COMMIT pobrefreturn poboutput) = S[.TODO = (OB_USER_REF_COMMIT pobrefreturn poboutput) :: S.TODO][.COMPLETION = UNSUPPORTED "abrupt reference output-handler return cleanup"]

;; A defined reference survives a destructor exception after RETURN_BY_REF.
rule PhpStep/ob-reference-normal-pending: S ~> $ob_ref_pending(S, pobinvoke, n_cell, n)
  -- if S.TODO = (OB_USER_NORMAL_PENDING pobinvoke pdestructionframe) :: ptask_tail*
  -- if $call_task_valid(S, OB_USER_NORMAL_PENDING pobinvoke pdestructionframe)
  -- if pdestructionframe.VALUE = REFERENCE n_cell
  -- if pdestructionframe.PENDING = (n)
def $ob_ref_pending(S, pobinvoke, n_cell, n) = $ob_ref_begin(S[.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], {INVOKE pobinvoke, CELL n_cell, PENDING (n), CALLER S.CURRENT, TAIL ptask_tail*})
  -- if S.TODO = ptask :: ptask_tail*
  -- if ~$output_drain_final_call(pobinvoke.CALL)
def $ob_ref_pending(S, pobinvoke, n_cell, n) = S[.COMPLETION = UNSUPPORTED "pending FINAL reference output-handler return cleanup"] -- if $output_drain_final_call(pobinvoke.CALL)

;; RETURN_BY_REF still materializes its RV when its Only-variable Notice
;; throws. Intercept the genuine callable exit before throw_frame_resume clears
;; RESULT; a body throw has no such defined reference and cannot use this route.
def $generator_frame_release(S_before, S_after) = $ob_ref_notice_restore(S_before, S_after, pobinvoke, n_cell, n, ptask_native*)
  -- if S_before.COMPLETION = NORMAL
  -- if S_before.TODO = [THROW_SEARCH n]
  -- if S_before.RESULT = REFERENCE n_cell
  -- if $call_reference_operand_valid(S_before, REFERENCE n_cell) /\ $throwable_live(S_before, n)
  -- if S_before.CURRENT = (pcallcontext)
  -- if $ob_user_context_valid(S_before, pcallcontext)
  -- if S_before.ORIGIN = (pcallcontext.FUNCTION)
  -- if S_before.FRAMES = pframe :: pframe_tail*
  -- if pframe.TODO = (OB_USER_RESULT pobinvoke) :: ptask_native*
  -- if S_after.CURRENT = pframe.CONTEXT /\ S_after.ORIGIN = pframe.ORIGIN
def $ob_ref_notice_restore(S_before, S_after, pobinvoke, n_cell, n, ptask_native*) = S_after[.TODO = $ob_normal_seal(S_after.TODO, pdestructionframe, pobinvoke, ptask_native*)]
  -- if S_before.CURRENT = (pcallcontext)
  -- if S_after.DESTRUCTION.FRAMES = pdestructionframe :: pdestructionframe_tail*
  -- if pdestructionframe.VALUE = REFERENCE n_cell /\ pdestructionframe.PENDING = (n)
  -- if pdestructionframe.FUNCTION = pcallcontext.FUNCTION
  -- if pdestructionframe.CALLER = S_after.CURRENT /\ pdestructionframe.ORIGIN = S_after.ORIGIN /\ pdestructionframe.CONSTCONTEXT = S_after.CONSTCONTEXT
  -- if $ob_normal_prefix(S_after.TODO, pdestructionframe, pobinvoke, ptask_native*)
def $ob_ref_notice_restore(S_before, S_after, pobinvoke, n_cell, n, ptask_native*) = S_after[.TODO = (OB_USER_REF_NOTICE {INVOKE pobinvoke, CELL n_cell, PENDING eps, CALLER S_after.CURRENT, TAIL ptask_native*} n) :: ptask_native*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S_after.TODO = (OB_USER_RESULT pobinvoke) :: ptask_native*
  -- if S_after.RESULT = REFERENCE n_cell
def $return_discard(S, OB_USER_REF_NOTICE pobrefreturn n) = $ob_ref_pending(S, pobrefreturn.INVOKE, pobrefreturn.CELL, n)
  -- if S.TODO = (THROW_SEARCH n) :: pobrefreturn.TAIL
  -- if ~$output_drain_final_call(pobrefreturn.INVOKE.CALL)
  -- if S_proof = S[.TODO = (OB_USER_REF_NOTICE pobrefreturn n) :: pobrefreturn.TAIL]
  -- if $call_task_valid(S_proof, OB_USER_REF_NOTICE pobrefreturn n) /\ $ob_ref_current(S, pobrefreturn)
