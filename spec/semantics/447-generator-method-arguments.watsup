  -- if $destructor_return_operand_valid(S, KNOWN pvalue)
def $generator_api_result_valid(S, pgeneratorop, pvalue) = false -- otherwise
def $call_task_valid(S, GENERATOR_API_RESULT pgeneratorop pvalue) = $generator_api_result_valid(S, pgeneratorop, pvalue)
def $call_task_valid(S, GENERATOR_API_RETURN pgeneratorop pvalue) = (S.ORIGIN = (pgeneratorop.SITE) /\ $generator_api_result_saved(S, pgeneratorop) /\ $destructor_return_operand_valid(S, KNOWN pvalue))
def $generator_internal_task(GENERATOR_API_RESULT pgeneratorop pvalue) = true
def $generator_internal_task(GENERATOR_API_RETURN pgeneratorop pvalue) = true
def $fiber_marker(GENERATOR_API_RESULT pgeneratorop pvalue) = true
def $fiber_marker(GENERATOR_API_RETURN pgeneratorop pvalue) = true

dec $generator_api_discard_result(pstate, pgeneratorop, pvalue) : bool
def $generator_api_discard_result(S, pgeneratorop, pvalue) = (~$reference_call_used(S, pgeneratorop.SITE) /\ $value_nodes(pvalue) =/= eps)
