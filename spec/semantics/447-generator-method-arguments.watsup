  -- if ~$generator_capture_operation(pgeneratorop)
  -- if ~$generator_from_site(S, pgeneratorop.SITE)
  -- if $generator_object(S, pgeneratorop.OBJECT)
  -- if $generator_operation_site(S, pgeneratorop)
def $generator_api_result_saved(S, pgeneratorop) = false -- otherwise

def $generator_api_finish_needed(S, pgeneratorop) = true
