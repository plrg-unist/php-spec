  -- if S.RESULT = KNOWN pvalue
  -- if $generator_arguments_nodes(pgeneratorop.ARGUMENTS) =/= eps \/ $value_nodes(pvalue) =/= eps
def $generator_api_finish_needed(S, pgeneratorop) = false -- otherwise

def $generator_complete(S, pgeneratorop) = $destructor_release_begin(S[.TODO = (GENERATOR_API_RESULT pgeneratorop pvalue) :: S.TODO][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], $destruction_values($generator_arguments_nodes(pgeneratorop.ARGUMENTS)))
  -- if $generator_api_finish_needed(S, pgeneratorop)
  -- if S.RESULT = KNOWN pvalue

def $task_nodes(GENERATOR_API_RESULT pgeneratorop pvalue) = [HOBJECT pgeneratorop.OBJECT] ++ $value_nodes(pvalue)
def $task_nodes(GENERATOR_API_RETURN pgeneratorop pvalue) = $value_nodes(pvalue)
dec $generator_api_result_valid(pstate, pgeneratorop, pvalue) : bool
def $generator_api_result_valid(S, pgeneratorop, pvalue) = true
  -- if S.ORIGIN = (pgeneratorop.SITE)
  -- if $generator_api_result_saved(S, pgeneratorop)
