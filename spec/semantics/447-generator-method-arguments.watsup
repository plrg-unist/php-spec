;; A genuine direct SEND frees argv before its receiver. Keep the returned
;; snapshot independently while an argv destructor can reenter that Generator.
dec $generator_api_result_saved(pstate, pgeneratorop) : bool
def $generator_api_result_saved(S, pgeneratorop) = true
  -- if pgeneratorop.NAME = "send"
  -- if pgeneratorop.ARGUMENTS = [pvalue]
