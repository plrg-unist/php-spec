;; A single initialized Iterator CV feeds an ordinary literal native API.
;; Captures, computed/nullsafe sources, other packs and Aggregate/Gen producers
;; keep their independent protocols and cannot enter through KIND alone.
def $generator_iterator_site(S, pconfigcall) = true
  -- if pconfigcall.KIND = INTRINSIC_GENERATOR_METHOD text_method eps
