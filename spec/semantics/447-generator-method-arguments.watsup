;; Native Generator methods collect names and ARRAY packs before ZPP/body entry.
;; The existing CONFIG cursor owns the selected receiver and frozen sent values.
def $generator_api_kind(INTRINSIC_GENERATOR_METHOD text pgeneratormethodselection?) = (text <- ["rewind", "valid", "current", "key", "next", "getreturn", "send", "throw"])
def $generator_api_kind(pintrinsic) = false -- otherwise
def $config_kind(INTRINSIC_GENERATOR_METHOD text pgeneratormethodselection?) = $generator_api_kind(INTRINSIC_GENERATOR_METHOD text pgeneratormethodselection?)
def $intrinsic_name(INTRINSIC_GENERATOR_METHOD text pgeneratormethodselection?) = $ptascii("Generator::") ++ $generator_method_display(text)
def $config_required(INTRINSIC_GENERATOR_METHOD text pgeneratormethodselection?) = $generator_argument_count(text)
dec $generator_api_parameter(text) : ptbytes
def $generator_api_parameter("send") = $ptascii("value")
def $generator_api_parameter("throw") = $ptascii("exception")
def $generator_api_parameter(text) = eps -- otherwise
def $config_parameter(INTRINSIC_GENERATOR_METHOD text pgeneratormethodselection?, ptbytes) = (0)
  -- if $generator_argument_count(text) = 1
  -- if ptbytes = $generator_api_parameter(text)
def $config_parameter_name(INTRINSIC_GENERATOR_METHOD text pgeneratormethodselection?, 0) = $generator_api_parameter(text)

dec $generator_api_argument_list(phpType7*, bool, bool) : bool
def $generator_api_argument_list(eps, b_pack, b_named) = true
def $generator_api_argument_list((NArg ABSENT expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType7*, false, false) = $generator_api_argument_list(phpType7*, false, false)
def $generator_api_argument_list((NArg ABSENT expression (BOOLEAN false) (BOOLEAN true) metadata) :: phpType7*, b_pack, false) = $generator_api_argument_list(phpType7*, true, false)
def $generator_api_argument_list((NArg (NIdentifier (BYTES text) metadata_name) expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType7*, b_pack, b_named) = $generator_api_argument_list(phpType7*, b_pack, true)
def $generator_api_argument_list(phpType7*, b_pack, b_named) = false -- otherwise
def $generator_api_arguments(phpType7*) = (($named_present(phpType7*) \/ $call_unpack_present(phpType7*)) /\ $generator_api_argument_list(phpType7*, false, false))
def $generator_api_site(S, porigin) = true
  -- if $getter_arguments(S, porigin) = PCALLARGUMENTS phpType7* 2
  -- if $generator_api_arguments(phpType7*)
def $generator_api_site(S, porigin) = false -- otherwise
def $exit_callable_arguments(S, porigin) = PCALLARGUMENTS phpType7* 2
  -- if $origin_node(S.SOURCES, porigin) = (NExprMethodCall expression (NIdentifier (BYTES text) metadata_name) (SEQUENCE phpType7*) metadata)
  -- if $generator_method($base64(text)) =/= ""
  -- if $generator_api_arguments(phpType7*)
  -- if ~$fiber_any_method_site(S, porigin)
  -- if ~$weakref_any_method_site(S, porigin)
def $exit_callable_arguments(S, porigin) = PCALLARGUMENTS phpType7* 2
  -- if $origin_node(S.SOURCES, porigin) = (NExprNullsafeMethodCall expression (NIdentifier (BYTES text) metadata_name) (SEQUENCE phpType7*) metadata)
  -- if $generator_method($base64(text)) =/= ""
  -- if $generator_api_arguments(phpType7*)
  -- if ~$fiber_any_method_site(S, porigin)
  -- if ~$weakref_any_method_site(S, porigin)

def $method_select(S, poperand, ptbytes, phpType7*, z) = S_read[.TODO = (CONFIG_ARGS {SITE porigin, KIND INTRINSIC_GENERATOR_METHOD text_method pgeneratormethodselection?, INDEX 0, SENT eps, NAMED false, OWNER (n), SELECTION eps, LINE z, PACKS eps}) :: $generator_method_return_tasks(S, porigin, ptask_tail*)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = ptask :: ptask_tail*
  -- if S.ORIGIN = (porigin)
  -- if S_read = $resolve_at(S, poperand, z)
  -- if S_read.COMPLETION = NORMAL
  -- if S_read.RESULT = KNOWN (POBJECT n)
  -- if $generator_object(S_read, n)
  -- if text_method = $generator_method(ptbytes)
  -- if text_method =/= ""
  -- if pgeneratormethodselection? = $generator_method_selection(S, poperand, ptbytes, phpType7*, z)
  -- if $generator_selected_method(S, porigin, n, ptbytes, z, pgeneratormethodselection?)
  -- if $generator_api_arguments(phpType7*)
def $config_selected_valid(S, pconfigcall) = true
  -- if pconfigcall.KIND = INTRINSIC_GENERATOR_METHOD text_method pgeneratormethodselection?
  -- if $generator_api_kind(pconfigcall.KIND)
  -- if pconfigcall.OWNER = (n)
  -- if pconfigcall.SELECTION = eps
  -- if $generator_object(S, n) /\ (HOBJECT n) <- S.ALLOCATIONS
  -- if $generator_selected_method(S, pconfigcall.SITE, n, $generator_method_display(text_method), pconfigcall.LINE, pgeneratormethodselection?)
  -- if $generator_api_site(S, pconfigcall.SITE)
def $config_trace_frames(S, pconfigcall, pvalue*) = [{FILE $call_sourcefile(S.FILES, pconfigcall.SITE), LINE pconfigcall.LINE, FUNCTION $generator_method_display(text_method), CLASS ($ptascii("Generator")), TYPE ($ptascii("->")), ARGS $trace_indexed_args(pvalue*, 0), HASARGS true}]
  -- if pconfigcall.KIND = INTRINSIC_GENERATOR_METHOD text_method pgeneratormethodselection?
  -- if $generator_api_kind(pconfigcall.KIND)

;; This transfer changes no roots: CONFIG's receiver/slots become the ordinary
;; Generator argument cursor. Type/count checks and pending-throw copies follow.
rule PhpStep/generator-api-collected: S ~> S[.TODO = (GENERATOR_ARGS pgeneratorop eps $getclass_trace_operands(pconfigcall.SENT)) :: ptask_tail*][.ORIGIN = (pconfigcall.SITE)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (CONFIG_INVOKE pconfigcall) :: ptask_tail*
  -- if $config_invoke_valid(S, pconfigcall)
  -- if pconfigcall.KIND = INTRINSIC_GENERATOR_METHOD text_method pgeneratormethodselection?
  -- if $generator_api_kind(pconfigcall.KIND)
  -- if pconfigcall.OWNER = (n)
  -- if $config_missing(pconfigcall.SENT, 0) = eps
  -- if pgeneratorop = {OBJECT n, NAME text_method, SITE pconfigcall.SITE, LINE pconfigcall.LINE, LOOP eps, ADVANCE false, ARGUMENTS eps, STARTPACK false, BORROWED false, SELECTION pgeneratormethodselection?}
dec $generator_api_operands(poperand*) : bool
def $generator_api_operands(eps) = true
def $generator_api_operands((KNOWN pvalue) :: poperand*) = $generator_api_operands(poperand*)
def $generator_api_operands(poperand*) = false -- otherwise
;; Dynamic packs determine their extent at collection time. A static named list
;; must still have its source-derived labels and exact normalized extent.
dec $generator_api_extent(text, phpType7*, nat) : bool
def $generator_api_extent(text_method, phpType7*, n) = true
  -- if $call_unpack_present(phpType7*)
def $generator_api_extent(text_method, phpType7*, n) = true
  -- if ~$call_unpack_present(phpType7*)
  -- if $config_source_prefix(INTRINSIC_GENERATOR_METHOD text_method eps, phpType7*, eps, false) = ((pnamedslot*, b_named))
  -- if $config_missing(pnamedslot*, 0) = eps
  -- if |pnamedslot*| = n
def $generator_api_extent(text_method, phpType7*, n) = false -- otherwise
def $generator_collected_arguments_valid(S, pgeneratorop, eps, poperand*, 0) = true
