  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_expression(pcode.EXPRESSIONS, pcpath ++ [PCFIELD 1]) = ((z_key, b_constant))
def $nullsafe_index_task(S, expression, z, b) = false -- otherwise

dec $nullsafe_property_task(pstate, phpType20, int, bool, bool) : bool
def $nullsafe_property_task(S, phpType20, z, b, false) = true
  -- if S.ORIGIN = (PORIGIN n pcpath)
