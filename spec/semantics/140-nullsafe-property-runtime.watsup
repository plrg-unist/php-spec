def $nullsafe_dim_path_task(S, ptbytes, z_access, z_key) = false -- otherwise
def $call_task_valid(S, DIM_PATH (BASE_CHAIN_PROPERTY pvalue ptbytes z_access) z_key) = $nullsafe_dim_path_task(S, ptbytes, z_access, z_key)

;; A taken short circuit is valid only while its checked chain still has a
