  -- if z = $nullsafe_access_line(S[.ORIGIN = (porigin)], NExprPropertyFetch expression expression_name metadata)
  -- if $nullsafe_chain_origin(S, porigin)
def $nullsafe_base_source(S, porigin, ptbytes, z) = true
