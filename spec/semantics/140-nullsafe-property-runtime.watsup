def $nullsafe_base_source(S, porigin, ptbytes, z) = false -- otherwise

dec $nullsafe_dim_path_task(pstate, ptbytes, int, int) : bool
def $nullsafe_dim_path_task(S, ptbytes, z_access, z_key) = true
  -- if S.ORIGIN = (porigin)
