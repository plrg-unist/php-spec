  -- if z = $nullsafe_access_line(S, NExprNullsafePropertyFetch expression phpType20 metadata)
def $nullsafe_property_task(S, phpType20, z, b, bshort) = false -- otherwise

dec $nullsafe_name_task(pstate, int) : bool
def $nullsafe_name_task(S, z) = true
  -- if S.ORIGIN = (PORIGIN n pcpath)
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (NExprPropertyFetch expression_receiver expression_name metadata)
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_expression(pcode.EXPRESSIONS, pcpath ++ [PCFIELD 1]) = ((z_name, b_constant))
  -- if $nullsafe_chain_origin(S, PORIGIN n pcpath)
  -- if z = $nullsafe_access_line(S, NExprPropertyFetch expression_receiver expression_name metadata)
  -- if $property_computed_name(expression_name)
def $nullsafe_name_task(S, z) = true
  -- if S.ORIGIN = (PORIGIN n pcpath)
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (NExprNullsafePropertyFetch expression_receiver expression_name metadata)
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_expression(pcode.EXPRESSIONS, pcpath ++ [PCFIELD 1]) = ((z_name, b_constant))
  -- if z = $nullsafe_access_line(S, NExprNullsafePropertyFetch expression_receiver expression_name metadata)
  -- if $property_computed_name(expression_name)
def $nullsafe_name_task(S, z) = false -- otherwise

def $call_task_valid(S, NULLSAFE_DIM_PREP expression b) = $nullsafe_task_source(S, expression, b)
def $call_task_valid(S, NULLSAFE_DIM_INDEX expression z b) = $nullsafe_index_task(S, expression, z, b)
def $call_task_valid(S, NULLSAFE_PROP_PREP phpType20 z b) = $nullsafe_property_task(S, phpType20, z, b, false)
def $call_task_valid(S, NULLSAFE_CHECK phpType20 z b) = $nullsafe_property_task(S, phpType20, z, b, true)
def $call_task_valid(S, NULLSAFE_PROPERTY_NAME pvalue z) = $nullsafe_name_task(S, z)
def $call_task_valid(S, EVAL (NExprNullsafePropertyFetch expression phpType20 metadata)) = $property_source_task(S, NExprNullsafePropertyFetch expression phpType20 metadata)
def $call_task_valid(S, DIM_PREP (NExprNullsafePropertyFetch expression phpType20 metadata)) = $property_source_task(S, NExprNullsafePropertyFetch expression phpType20 metadata)
def $call_task_valid(S, EVAL (NExprArrayDimFetch expression phpType5 metadata)) = $property_source_task(S, NExprArrayDimFetch expression phpType5 metadata)
  -- if $ppnullsafe(NExprArrayDimFetch expression phpType5 metadata)
def $call_task_valid(S, DIM_PREP (NExprArrayDimFetch expression phpType5 metadata)) = $property_source_task(S, NExprArrayDimFetch expression phpType5 metadata)
  -- if $ppnullsafe(NExprArrayDimFetch expression phpType5 metadata)

