;; zend_std_compare_objects dereferences before the cast, then rereads the
;; opposing zval. Pointer images are documentary; only INPUTS/BASE own values.
syntax pcomparepointer = COMPARE_COPY pvalue | COMPARE_CV ptbytes | COMPARE_CELL nat
syntax pstringcompare = { SITE porigin, CASTSITE porigin, OP pbin, LINE int, LEFT poperand, RIGHT poperand, LEFTVALUE pvalue, RIGHTVALUE pvalue, INPUTBASE pbase, RECEIVER nat, OBJECTLEFT bool, POINTER pcomparepointer, ENV pbinding*, REFS nat*, CALLER pcallcontext?, OWNER nat, CONSUMER ptask, TAIL ptask* }

dec $string_compare_operator(pcnode) : pbin?
def $string_compare_operator(NExprBinaryOpEqual expression_left expression_right metadata) = (EQUAL)
def $string_compare_operator(NExprBinaryOpNotEqual expression_left expression_right metadata) = (NOTEQUAL)
def $string_compare_operator(NExprBinaryOpSmaller expression_left expression_right metadata) = (LESS)
def $string_compare_operator(NExprBinaryOpSmallerOrEqual expression_left expression_right metadata) = (LESSEQUAL)
def $string_compare_operator(NExprBinaryOpGreater expression_left expression_right metadata) = (GREATER)
def $string_compare_operator(NExprBinaryOpGreaterOrEqual expression_left expression_right metadata) = (GREATEREQUAL)
def $string_compare_operator(NExprBinaryOpSpaceship expression_left expression_right metadata) = (SPACESHIP)
def $string_compare_operator(pcnode) = eps -- otherwise

dec $string_compare_values(pstate, poperand, poperand, int) : (pstate, pvalue, pvalue)?
def $string_compare_values(S, poperand_left, poperand_right, z) = ((S_right, pvalue_left, pvalue_right))
  -- if S_left = $resolve_at($hold_task_inputs(S), poperand_left, z)
  -- if S_left.COMPLETION = NORMAL
  -- if S_left.RESULT = KNOWN pvalue_left
  -- if S_right = $resolve_at(S_left, poperand_right, z)
  -- if S_right.COMPLETION = NORMAL
  -- if S_right.RESULT = KNOWN pvalue_right
def $string_compare_values(S, poperand_left, poperand_right, z) = eps -- otherwise

def $string_compare_selection(S, POBJECT n, pvalue) = ((n, true))
  -- if $stringable_instance(S, n)
  -- if $string_bytes(pvalue) =/= eps
def $string_compare_selection(S, pvalue, POBJECT n) = ((n, false))
  -- if $stringable_instance(S, n)
  -- if $string_bytes(pvalue) =/= eps
def $string_compare_selection(S, pvalue_left, pvalue_right) = eps -- otherwise

def $string_compare_pending(S) = true
  -- if S.TODO = (BINARY_RIGHT pbin poperand_left z) :: ptask_tail*
  -- if S.ORIGIN = (porigin)
  -- if ~$gc_retired_binary(S, pbin, poperand_left)
  -- if $comparison_operator(pbin)
  -- if $string_compare_values(S, poperand_left, S.RESULT, z) = ((S_read, pvalue_left, pvalue_right))
  -- if $string_compare_selection(S_read, pvalue_left, pvalue_right) =/= eps
def $string_compare_pending(S) = true
  -- if S.TODO = (SWITCH_COMPARE statement porigin poperand_left n z) :: ptask_tail*
  -- if S.ORIGIN = (porigin)
  -- if $switch_compare_valid(S, statement, porigin, n, z)
  -- if $switch_bool_mode(S, porigin) = eps
  -- if $string_compare_values(S, poperand_left, S.RESULT, z) = ((S_read, pvalue_left, pvalue_right))
  -- if $string_compare_selection(S_read, pvalue_left, pvalue_right) =/= eps
def $string_compare_pending(S) = false -- otherwise

dec $string_compare_opposing(bool, poperand, poperand) : poperand
def $string_compare_opposing(true, poperand_left, poperand_right) = poperand_right
def $string_compare_opposing(false, poperand_left, poperand_right) = poperand_left
dec $string_compare_other(pstringcompare) : poperand
def $string_compare_other(pstringcompare) = $string_compare_opposing(pstringcompare.OBJECTLEFT, pstringcompare.LEFT, pstringcompare.RIGHT)
dec $string_compare_pointer(pbinding*, nat*, poperand) : pcomparepointer?
def $string_compare_pointer(pbinding*, nat*, KNOWN pvalue) = (COMPARE_COPY pvalue)
  -- if $string_bytes(pvalue) =/= eps
def $string_compare_pointer(pbinding*, nat*, REFERENCE n) = (COMPARE_CELL n)
def $string_compare_pointer(pbinding*, nat_reference*, VARIABLE ptbytes z) = (COMPARE_CELL n)
  -- if $lookup(pbinding*, ptbytes) = (n)
  -- if n <- nat_reference*
def $string_compare_pointer(pbinding*, nat_reference*, VARIABLE ptbytes z) = (COMPARE_CV ptbytes)
  -- if $lookup(pbinding*, ptbytes) = (n)
  -- if ~(n <- nat_reference*)
def $string_compare_pointer(pbinding*, nat*, poperand) = eps -- otherwise

dec $string_compare_pointer_value(pstate, pcomparepointer) : pvalue?
def $string_compare_pointer_value(S, COMPARE_COPY pvalue) = (pvalue)
def $string_compare_pointer_value(S, COMPARE_CV ptbytes) = (pvalue)
  -- if ~$environment_blocked(S, ptbytes)
  -- if $lookup(S.ENV, ptbytes) = (n)
  -- if $(n < |S.STORE|)
  -- if S.STORE[n] = DEFINED pvalue
  -- if (HCELL n) <- S.ALLOCATIONS
def $string_compare_pointer_value(S, COMPARE_CELL n) = (pvalue)
  -- if $(n < |S.STORE|)
  -- if S.STORE[n] = DEFINED pvalue
  -- if (HCELL n) <- S.ALLOCATIONS
  -- if $($heap_owners($heap_prune($heap_graph(S)), HCELL n) > 0)
def $string_compare_pointer_value(S, pcomparepointer) = eps -- otherwise

;; The source determines each operand's location class. An evaluated temporary
;; remains its own value; this check does not reconstruct its mutable history.
dec $string_compare_operand(pstate, porigin, poperand) : bool
def $string_compare_operand(S, porigin, VARIABLE ptbytes z) = true
  -- if $origin_node(S.SOURCES, porigin) = (NExprVariable phpType32 metadata)
  -- if $cv_name(phpType32) = (ptbytes)
  -- if ~$direct_this(phpType32)
  -- if ~$ppglobals_base(NExprVariable phpType32 metadata)
  -- if z = $variable_line(phpType32, metadata)
def $string_compare_operand(S, porigin, KNOWN pvalue) = true
  -- if $origin_node(S.SOURCES, porigin) = (expression)
  -- if $reference_cv(expression) = eps
  -- if $compiled_read(S, porigin) = eps
def $string_compare_operand(S, porigin, KNOWN pvalue) = true
  -- if $compiled_read(S, porigin) = (pvalue_compiled)
  -- if pvalue = $compiled_string_value(S, porigin, pvalue_compiled)
def $string_compare_operand(S, porigin, REFERENCE n) = true
  -- if $origin_node(S.SOURCES, porigin) = (expression)
  -- if $reference_cv(expression) = eps
  -- if $compiled_read(S, porigin) = eps
  -- if $call_reference_operand_valid(S, REFERENCE n)
def $string_compare_operand(S, porigin, poperand) = false -- otherwise

dec $string_compare_source(pstate, pstringcompare) : bool
def $string_compare_source(S, pstringcompare) = true
  -- if pstringcompare.CONSUMER = BINARY_RIGHT pstringcompare.OP pstringcompare.LEFT pstringcompare.LINE
  -- if $origin_node(S.SOURCES, pstringcompare.SITE) = (pcnode)
  -- if $string_compare_operator(pcnode) = (pstringcompare.OP)
  -- if $origin_child((pstringcompare.SITE), [PCFIELD 1]) = (porigin_right)
  -- if $origin_node(S.SOURCES, porigin_right) = (expression_right)
  -- if pstringcompare.LINE = $runtime_line(S[.ORIGIN = (pstringcompare.SITE)], [PCFIELD 1], expression_right)
  -- if pstringcompare.CASTSITE = pstringcompare.SITE
  -- if $origin_child((pstringcompare.SITE), [PCFIELD 0]) = (porigin_left)
  -- if $string_compare_operand(S, porigin_left, pstringcompare.LEFT)
  -- if $string_compare_operand(S, porigin_right, pstringcompare.RIGHT)
def $string_compare_source(S, pstringcompare) = true
  -- if pstringcompare.OP = EQUAL
  -- if pstringcompare.CONSUMER = SWITCH_COMPARE statement pstringcompare.SITE pstringcompare.LEFT n pstringcompare.LINE
  -- if $switch_compare_valid(S, statement, pstringcompare.SITE, n, pstringcompare.LINE)
  -- if $switch_bool_mode(S, pstringcompare.SITE) = eps
  -- if $origin_child((pstringcompare.SITE), [PCFIELD 1, PCINDEX n, PCFIELD 0]) = (pstringcompare.CASTSITE)
  -- if $origin_child((pstringcompare.SITE), [PCFIELD 0]) = (porigin_left)
  -- if $string_compare_operand(S, porigin_left, pstringcompare.LEFT)
  -- if $string_compare_operand(S, pstringcompare.CASTSITE, pstringcompare.RIGHT)
def $string_compare_source(S, pstringcompare) = false -- otherwise

dec $string_compare_image(pstringcompare) : bool
dec $string_compare_valid(pstate, pstringcompare) : bool
def $string_compare_valid(S, pstringcompare) = true
  -- if $string_compare_source(S, pstringcompare)
  -- if S.CURRENT = pstringcompare.CALLER
  -- if |S.FRAMES| = pstringcompare.OWNER
  -- if $string_compare_image(pstringcompare)
  -- if $string_compare_pointer(pstringcompare.ENV, pstringcompare.REFS, $string_compare_other(pstringcompare)) = (pstringcompare.POINTER)
