  -- if $heap_subset($operand_nodes(pstringcompare.LEFT) ++ $operand_nodes(pstringcompare.RIGHT) ++ $base_nodes(pstringcompare.INPUTBASE), S.ALLOCATIONS)
def $string_compare_valid(S, pstringcompare) = false -- otherwise

def $string_compare_image(pstringcompare) = true
  -- if pstringcompare.OBJECTLEFT
  -- if pstringcompare.LEFTVALUE = POBJECT pstringcompare.RECEIVER
  -- if $string_bytes(pstringcompare.RIGHTVALUE) =/= eps
def $string_compare_image(pstringcompare) = true
  -- if ~pstringcompare.OBJECTLEFT
  -- if pstringcompare.RIGHTVALUE = POBJECT pstringcompare.RECEIVER
  -- if $string_bytes(pstringcompare.LEFTVALUE) =/= eps
def $string_compare_image(pstringcompare) = false -- otherwise

;; A redispatched cast compares against the private first-cast string, never
;; against the original live operand again. String identity has no heap edges.
dec $string_compare_text_valid(pstate, pvalue) : bool
def $string_compare_text_valid(S, PSTRING n*) = $startup_bytes(n*)
def $string_compare_text_valid(S, pvalue) = $string_carrier_valid(S, pvalue)
  -- if $string_plain(pvalue) =/= pvalue
def $string_compare_text_valid(S, pvalue) = false -- otherwise

;; The finite internal handler is atomic here. Source overrides retain the
;; ordinary callback route; previous nodes are rendered from their fields.
def $throwable_compare_receiver(S, POBJECT n) = (n)
  -- if $(n < |S.OBJECTS|)
  -- if (HOBJECT n) <- S.ALLOCATIONS
  -- if S.OBJECTS[n] = THROWABLE pthrowable
  -- if $throwable_kind(pthrowable.KIND)
def $throwable_compare_receiver(S, POBJECT n) = (n)
  -- if $(n < |S.OBJECTS|)
  -- if (HOBJECT n) <- S.ALLOCATIONS
  -- if $throwable_inherited_string(S, n)
def $throwable_compare_receiver(S, pvalue) = eps -- otherwise
def $throwable_compare_selection(S, pvalue_left, pvalue_right) = ((n, true))
  -- if $throwable_compare_receiver(S, pvalue_left) = (n)
  -- if $string_bytes(pvalue_right) =/= eps
def $throwable_compare_selection(S, pvalue_left, pvalue_right) = ((n, false))
  -- if $throwable_compare_receiver(S, pvalue_right) = (n)
  -- if $string_bytes(pvalue_left) =/= eps
def $throwable_compare_selection(S, pvalue_left, pvalue_right) = eps -- otherwise
dec $throwable_compare_fields(pstate, nat) : bool
def $throwable_compare_fields(S, n) = true
  -- if $(n < |S.OBJECTS|)
  -- if (HOBJECT n) <- S.ALLOCATIONS
  -- if $throwable_member(S, n)
  -- if $string_compare_text_valid(S, $throwable_field(S, n, "message"))
  -- if $string_compare_text_valid(S, $throwable_field(S, n, "file"))
  -- if $string_compare_text_valid(S, $throwable_field(S, n, "string"))
  -- if $throwable_field(S, n, "line") = PINT z
  -- if $throwable_field(S, n, "trace") = PARRAY n_trace
  -- if $trace_graph_valid(S, n_trace)
  -- if $throwable_field(S, n, "previous") = PNULL \/ $type_bytes($throwable_field(S, n, "previous")) = $ptascii("object")
def $throwable_compare_fields(S, n) = false -- otherwise
dec $throwable_compare_chain(pstate, nat, nat*, pcompareguard*) : bool
def $throwable_compare_chain(S, n, nat_seen*, pcompareguard_seen*) = true
  -- if ~(n <- nat_seen*)
  -- if ~((HOBJECT n) <- pcompareguard_seen*)
  -- if $throwable_compare_fields(S, n)
  -- if $throwable_previous_id(S, n) = eps
def $throwable_compare_chain(S, n, nat_seen*, pcompareguard_seen*) = $throwable_compare_chain(S, n_previous, n :: nat_seen*, pcompareguard_seen*)
  -- if ~(n <- nat_seen*)
  -- if ~((HOBJECT n) <- pcompareguard_seen*)
  -- if $throwable_compare_fields(S, n)
  -- if $throwable_previous_id(S, n) = (n_previous)
def $throwable_compare_chain(S, n, nat_seen*, pcompareguard_seen*) = false -- otherwise
def $throwable_compare_order(S, POBJECT n, pvalue_other, pcompareguard_seen*) = (S_text, ORDER $scalar_order(S_text, pvalue_text, pvalue_other))
  -- if $throwable_compare_selection(S, POBJECT n, pvalue_other) = ((n, true))
  -- if $string_compare_text_valid(S, pvalue_other)
  -- if $throwable_compare_chain(S, n, eps, pcompareguard_seen* ++ $aggregate_compare_seen(S))
  -- if S_text = $throwable_stringify(S, n)
  -- if S_text.RESULT = KNOWN pvalue_text
def $throwable_compare_order(S, pvalue_other, POBJECT n, pcompareguard_seen*) = (S_text, ORDER $scalar_order(S_text, pvalue_other, pvalue_text))
  -- if $throwable_compare_selection(S, pvalue_other, POBJECT n) = ((n, false))
  -- if $string_compare_text_valid(S, pvalue_other)
  -- if $throwable_compare_chain(S, n, eps, pcompareguard_seen* ++ $aggregate_compare_seen(S))
  -- if S_text = $throwable_stringify(S, n)
  -- if S_text.RESULT = KNOWN pvalue_text
def $throwable_compare_order(S, pvalue_left, pvalue_right, pcompareguard_seen*) = (S, ORDERUNSUPPORTED "finite Throwable comparison formatting") -- otherwise

dec $string_compare_redispatch_valid(pstate, pstringcompare, nat, pvalue) : bool
def $string_compare_redispatch_valid(S, pstringcompare, n, pvalue) = ($string_compare_valid(S, pstringcompare) /\ $(n < |S.OBJECTS|) /\ $string_compare_text_valid(S, pvalue))
dec $string_compare_redispatch_suffix(ptask*, pstringcompare, nat, pvalue) : bool
def $string_compare_redispatch_suffix((STRING_COMPARE_REDISPATCH_RESULT pstringcompare n pvalue) :: ptask_tail*, pstringcompare, n, pvalue) = (ptask_tail* = pstringcompare.TAIL)
def $string_compare_redispatch_suffix(ptask :: ptask_tail*, pstringcompare, n, pvalue) = $string_compare_redispatch_suffix(ptask_tail*, pstringcompare, n, pvalue)
  -- if ptask =/= STRING_COMPARE_REDISPATCH_RESULT pstringcompare n pvalue
def $string_compare_redispatch_suffix(eps, pstringcompare, n, pvalue) = false
def $task_nodes(STRING_COMPARE_REDISPATCH_RESULT pstringcompare n pvalue) = $task_nodes(STRING_COMPARE_RESULT pstringcompare)
def $call_task_valid(S, STRING_COMPARE_REDISPATCH_RESULT pstringcompare n pvalue) = ($string_compare_redispatch_valid(S, pstringcompare, n, pvalue) /\ S.ORIGIN = (pstringcompare.CASTSITE) /\ $string_compare_redispatch_suffix(S.TODO, pstringcompare, n, pvalue))
def $stringify_source(S, porigin, z, STRING_COMPARE_REDISPATCH_RESULT pstringcompare n pvalue) = ($string_compare_redispatch_valid(S, pstringcompare, n, pvalue) /\ porigin = pstringcompare.CASTSITE /\ z = pstringcompare.LINE)
def $stringify_source_consumer(STRING_COMPARE_REDISPATCH_RESULT pstringcompare n pvalue) = true
def $stringify_consumer_tail_valid(S, porigin, z, STRING_COMPARE_REDISPATCH_RESULT pstringcompare n pvalue, ptask_tail*) = ($stringify_source(S, porigin, z, STRING_COMPARE_REDISPATCH_RESULT pstringcompare n pvalue) /\ ptask_tail* = pstringcompare.TAIL)
def $stringify_consumer_receiver_valid(S, n, STRING_COMPARE_REDISPATCH_RESULT pstringcompare n_second pvalue) = (n = n_second)

dec $string_compare_suffix(ptask*, pstringcompare) : bool
def $string_compare_suffix((STRING_COMPARE_RESULT pstringcompare) :: ptask_tail*, pstringcompare) = (ptask_tail* = pstringcompare.TAIL)
def $string_compare_suffix(ptask :: ptask_tail*, pstringcompare) = $string_compare_suffix(ptask_tail*, pstringcompare)
  -- if ptask =/= STRING_COMPARE_RESULT pstringcompare
def $string_compare_suffix(eps, pstringcompare) = false
def $task_nodes(STRING_COMPARE_RESULT pstringcompare) = $operand_nodes(pstringcompare.LEFT) ++ $operand_nodes(pstringcompare.RIGHT) ++ $base_nodes(pstringcompare.INPUTBASE)
def $call_task_valid(S, STRING_COMPARE_RESULT pstringcompare) = ($string_compare_valid(S, pstringcompare) /\ S.ORIGIN = (pstringcompare.CASTSITE) /\ $string_compare_suffix(S.TODO, pstringcompare))

def $stringify_source(S, porigin, z, STRING_COMPARE_RESULT pstringcompare) = ($string_compare_valid(S, pstringcompare) /\ porigin = pstringcompare.CASTSITE /\ z = pstringcompare.LINE)
def $stringify_source_consumer(STRING_COMPARE_RESULT pstringcompare) = true
def $stringify_consumer_tail_valid(S, porigin, z, STRING_COMPARE_RESULT pstringcompare, ptask_tail*) = ($stringify_source(S, porigin, z, STRING_COMPARE_RESULT pstringcompare) /\ ptask_tail* = pstringcompare.TAIL)
def $stringify_consumer_receiver_valid(S, n, STRING_COMPARE_RESULT pstringcompare) = (n = pstringcompare.RECEIVER)

dec $string_compare_frame(ptask*) : bool
def $string_compare_frame((STRINGIFY_RESULT n porigin z) :: (STRING_COMPARE_RESULT pstringcompare) :: ptask_tail*) = (n = pstringcompare.RECEIVER /\ porigin = pstringcompare.CASTSITE /\ z = pstringcompare.LINE /\ ptask_tail* = pstringcompare.TAIL)
def $string_compare_frame((STRINGIFY_RESULT n porigin z) :: (STRING_COMPARE_REDISPATCH_RESULT pstringcompare n_second pvalue) :: ptask_tail*) = (n = n_second /\ porigin = pstringcompare.CASTSITE /\ z = pstringcompare.LINE /\ ptask_tail* = pstringcompare.TAIL)
def $string_compare_frame(ptask*) = false -- otherwise
def $parameter_string_frame_scope(S, pframe, pframe_tail*) = $constant_frame_scope(S, pframe, pframe_tail*)
  -- if $string_compare_frame(pframe.TODO)

;; This source-only predicate is used to classify active implicit call contexts.
def $comparison_string_site(S, porigin, z) = true
  -- if $origin_node(S.SOURCES, porigin) = (pcnode)
  -- if $string_compare_operator(pcnode) =/= eps
  -- if $origin_child((porigin), [PCFIELD 1]) = (porigin_right)
  -- if $origin_node(S.SOURCES, porigin_right) = (expression_right)
  -- if z = $runtime_line(S[.ORIGIN = (porigin)], [PCFIELD 1], expression_right)
def $comparison_string_site(S, PORIGIN n_unit pcpath, z) = true
  -- if $(|pcpath| >= 3)
  -- if n_parent = $nabs($(|pcpath| - 3))
  -- if pcpath[n_parent:3] = [PCFIELD 1, PCINDEX n_case, PCFIELD 0]
  -- if porigin_switch = PORIGIN n_unit pcpath[0:n_parent]
  -- if $origin_node(S.SOURCES, porigin_switch) = (statement)
  -- if $switch_compare_valid(S, statement, porigin_switch, n_case, z)
  -- if $switch_bool_mode(S, porigin_switch) = eps
def $comparison_string_site(S, porigin, z) = false -- otherwise

dec $string_compare_begin(pstate, pstate, ptask, porigin, porigin, pbin, poperand, poperand, pvalue, pvalue, nat, bool, int, ptask*) : pstate
def $string_compare_begin(S_before, S, ptask_consumer, porigin, porigin_cast, pbin, poperand_left, poperand_right, pvalue_left, pvalue_right, n, b_left, z, ptask_tail*) = $user_string_begin(S[.HELD = S_before.HELD][.ORIGIN = (porigin_cast)], n, porigin_cast, z, STRING_COMPARE_RESULT pstringcompare, ptask_tail*)
  -- if poperand_other = $string_compare_opposing(b_left, poperand_left, poperand_right)
  -- if $string_compare_pointer(S_before.ENV, S_before.REFCELLS, poperand_other) = (pcomparepointer)
  -- if n_owner = |S_before.FRAMES|
  -- if pstringcompare = {SITE porigin, CASTSITE porigin_cast, OP pbin, LINE z, LEFT poperand_left, RIGHT poperand_right, LEFTVALUE pvalue_left, RIGHTVALUE pvalue_right, INPUTBASE S_before.BASE, RECEIVER n, OBJECTLEFT b_left, POINTER pcomparepointer, ENV S_before.ENV, REFS S_before.REFCELLS, CALLER S_before.CURRENT, OWNER n_owner, CONSUMER ptask_consumer, TAIL ptask_tail*}
  -- if $string_compare_valid(S, pstringcompare)
def $string_compare_begin(S_before, S, ptask, porigin, porigin_cast, pbin, poperand_left, poperand_right, pvalue_left, pvalue_right, n, b_left, z, ptask_tail*) = S[.HELD = S_before.HELD][.TODO = eps][.COMPLETION = UNSUPPORTED "Stringable comparison operand or source"] -- otherwise

rule PhpStep/string-compare-binary: S ~> $string_compare_begin(S, S_read, BINARY_RIGHT pbin poperand_left z, porigin, porigin, pbin, poperand_left, S.RESULT, pvalue_left, pvalue_right, n, b_left, z, ptask_tail*)
  -- if S.TODO = (BINARY_RIGHT pbin poperand_left z) :: ptask_tail*
  -- if S.ORIGIN = (porigin)
  -- if ~$gc_retired_binary(S, pbin, poperand_left)
  -- if $comparison_operator(pbin)
  -- if $string_compare_values(S, poperand_left, S.RESULT, z) = ((S_read, pvalue_left, pvalue_right))
  -- if $string_compare_selection(S_read, pvalue_left, pvalue_right) = ((n, b_left))
rule PhpStep/string-compare-switch: S ~> $string_compare_begin(S, S_read, SWITCH_COMPARE statement porigin poperand_left n_case z, porigin, porigin_cast, EQUAL, poperand_left, S.RESULT, pvalue_left, pvalue_right, n, b_left, z, ptask_tail*)
  -- if S.TODO = (SWITCH_COMPARE statement porigin poperand_left n_case z) :: ptask_tail*
  -- if S.ORIGIN = (porigin)
  -- if $switch_compare_valid(S, statement, porigin, n_case, z)
  -- if $switch_bool_mode(S, porigin) = eps
  -- if $origin_child((porigin), [PCFIELD 1, PCINDEX n_case, PCFIELD 0]) = (porigin_cast)
  -- if $string_compare_values(S, poperand_left, S.RESULT, z) = ((S_read, pvalue_left, pvalue_right))
  -- if $string_compare_selection(S_read, pvalue_left, pvalue_right) = ((n, b_left))

dec $string_compare_finish(pstate, pstringcompare, pvalue, pvalue) : pstate
def $string_compare_finish(S, pstringcompare, pvalue_left, pvalue_right) = $binary_apply(S[.TODO = pstringcompare.TAIL][.ORIGIN = (pstringcompare.SITE)][.BASE = BASE_VALUE (KNOWN PNULL)], pstringcompare.OP, pvalue_left, pvalue_right, pstringcompare.LINE)
  -- if pstringcompare.CONSUMER = BINARY_RIGHT pstringcompare.OP pstringcompare.LEFT pstringcompare.LINE
def $string_compare_finish(S, pstringcompare, pvalue_left, pvalue_right) = $switch_compare_result(S, S[.TODO = pstringcompare.TAIL][.ORIGIN = (pstringcompare.SITE)][.BASE = BASE_VALUE (KNOWN PNULL)], statement, pstringcompare.SITE, pstringcompare.LEFT, n, pstringcompare.LINE, pvalue_left, pvalue_right)
  -- if pstringcompare.CONSUMER = SWITCH_COMPARE statement pstringcompare.SITE pstringcompare.LEFT n pstringcompare.LINE

dec $string_compare_return(pstate, pstringcompare, pvalue, pvalue) : pstate
def $string_compare_return(S, pstringcompare, pvalue_text, pvalue_other) = $string_compare_finish(S, pstringcompare, pvalue_text, pvalue_other)
  -- if pstringcompare.OBJECTLEFT
  -- if $type_bytes(pvalue_other) =/= $ptascii("object") \/ $throwable_compare_receiver(S, pvalue_other) =/= eps
def $string_compare_return(S, pstringcompare, pvalue_text, pvalue_other) = $string_compare_finish(S, pstringcompare, pvalue_other, pvalue_text)
  -- if ~pstringcompare.OBJECTLEFT
  -- if $type_bytes(pvalue_other) =/= $ptascii("object") \/ $throwable_compare_receiver(S, pvalue_other) =/= eps
