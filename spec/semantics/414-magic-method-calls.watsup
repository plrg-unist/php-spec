  -- if $class_origin_matches(S, porigin_receiver, pclassdesc.NAME, |S.CLASSES|)
  -- if $effective_method(S, porigin_receiver, $ptascii("__call"), |S.CLASSES|) =/= eps
def $magic_method_scoped(S, porigin) = false -- otherwise

dec $magic_method_source(pstate, pmethoddesc) : bool
def $magic_method_source(S, pmethoddesc) = true
