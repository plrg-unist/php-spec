def $task_nodes(MAGIC_METHOD_NAMED_SEND pmagicmethodcall n poperand*) = $operands_roots(poperand*) ++ [HOBJECT pmagicmethodcall.OBJECT]
def $task_nodes(MAGIC_METHOD_NAMED_RESULT pmagicmethodcall n_arguments n_named pvalue*) = [HARRAY n_named, HOBJECT pmagicmethodcall.OBJECT]
def $call_task_valid(S, MAGIC_METHOD_NAMED_ARGS pmagicmethodcall n poperand*) = $magic_named_raw_valid(S, pmagicmethodcall, n, poperand*, false)
def $call_task_valid(S, MAGIC_METHOD_NAMED_SEND pmagicmethodcall n poperand*) = $magic_named_raw_valid(S, pmagicmethodcall, n, poperand*, true)
def $call_task_valid(S, MAGIC_METHOD_NAMED_RESULT pmagicmethodcall n_arguments n_named pvalue*) = $magic_named_result_valid(S, pmagicmethodcall, n_arguments, n_named, pvalue*)
def $destructor_return_discarded((MAGIC_METHOD_NAMED_RESULT pmagicmethodcall n_arguments n_named pvalue*) :: ptask_tail*) = $destructor_return_discarded(ptask_tail*)
