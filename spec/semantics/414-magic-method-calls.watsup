def $magic_method_array(eps, n) = $array_empty()
def $magic_method_array(pvalue :: pvalue_tail*, n) = $magic_method_array_insert($array_insert($array_empty(), KINT n, DIRECT pvalue), pvalue_tail*, $(n + 1))
def $magic_method_array_insert(parray, eps, n) = parray
def $magic_method_array_insert(parray, pvalue :: pvalue_tail*, n) = $magic_method_array_insert($array_insert(parray, KINT n, DIRECT pvalue), pvalue_tail*, $(n + 1))

dec $magic_method_pack(pstate, pmagicmethodcall, nat, poperand*, porigin?, int, ptask*) : pstate
def $magic_method_pack(S, pmagicmethodcall, n, poperand*, porigin?, z, ptask_tail*) = S_array[.TODO = (CALL_ARGS (MAGIC_METHOD_TARGET pmagicmethodcall n_array pvalue*) eps 2 ([KNOWN (PSTRING pmagicmethodcall.NAME), KNOWN (PARRAY n_array)]) porigin? z) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
