def $magic_method_frame(S, pcallcontext, pframe, pframe_tail*, pmagicmethodcall, n, pvalue*) = false -- otherwise
dec $magic_method_entered(pstate, pcallcontext?, pframe*, pmagicmethodcall, nat, pvalue*) : bool
def $magic_method_entered(S, (pcallcontext), pframe :: pframe_tail*, pmagicmethodcall, n, pvalue*) = $magic_method_frame(S, pcallcontext, pframe, pframe_tail*, pmagicmethodcall, n, pvalue*)
  -- if pcallcontext.TARGET = MAGIC_METHOD_TARGET pmagicmethodcall n pvalue*
def $magic_method_entered(S, (pcallcontext), pframe :: pframe_tail*, pmagicmethodcall, n, pvalue*) = $magic_method_entered(S, pframe.CONTEXT, pframe_tail*, pmagicmethodcall, n, pvalue*)
  -- if pcallcontext.TARGET =/= MAGIC_METHOD_TARGET pmagicmethodcall n pvalue*
def $magic_method_entered(S, eps, pframe :: pframe_tail*, pmagicmethodcall, n, pvalue*) = $magic_method_entered(S, pframe.CONTEXT, pframe_tail*, pmagicmethodcall, n, pvalue*)
def $magic_method_entered(S, pcallcontext?, eps, pmagicmethodcall, n, pvalue*) = false
def $target_function(S, MAGIC_METHOD_TARGET pmagicmethodcall n pvalue*) = (pfunction)
  -- if $magic_method_pending(S, pmagicmethodcall, n, pvalue*) \/ $magic_method_entered(S, S.CURRENT, S.FRAMES, pmagicmethodcall, n, pvalue*)
