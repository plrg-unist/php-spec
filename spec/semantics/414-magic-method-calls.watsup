;; Once entered, array/sent identities are history: compiled-variable cleanup
;; may already have retired the array before a payload destructor runs.
dec $magic_method_frame(pstate, pcallcontext, pframe, pframe*, pmagicmethodcall, nat, pvalue*) : bool
def $magic_method_frame(S, pcallcontext, pframe, pframe_tail*, pmagicmethodcall, n, pvalue*) = true
  -- if pcallcontext.TARGET = MAGIC_METHOD_TARGET pmagicmethodcall n pvalue*
  -- if pcallcontext.FUNCTION = pmagicmethodcall.METHOD /\ pcallcontext.INSTANCE = eps
  -- if pcallcontext.RECEIVER = (pmagicmethodcall.OBJECT) /\ pcallcontext.CALLED_CLASS = (pmagicmethodcall.CLASS)
  -- if pcallcontext.LEXICAL_CLASS = $target_lexical_class(S, METHOD_TARGET pmagicmethodcall.OBJECT pmagicmethodcall.METHOD)
  -- if pcallcontext.CALLSITE = (pmagicmethodcall.SITE) /\ pcallcontext.LINE = pmagicmethodcall.LINE
  -- if pcallcontext.ARGC = 2 /\ pcallcontext.EXTRA = eps /\ pcallcontext.NAMED = eps /\ pcallcontext.WRAPPER = eps /\ pcallcontext.HOLES = eps
