def $magic_method_pack(S, pmagicmethodcall, n, poperand*, porigin?, z, ptask_tail*) = S[.COMPLETION = UNSUPPORTED "magic method send continuation"] -- otherwise
rule PhpStep/magic-method-pack: S ~> $magic_method_pack(S, pmagicmethodcall, n, poperand*, porigin?, z, ptask_tail*)
  -- if S.TODO = (CALL_ARGS (MAGIC_METHOD_SEND_TARGET pmagicmethodcall) eps n poperand* porigin? z) :: ptask_tail*

;; Raw/final target metadata is nonowning except for the selected receiver.
;; The packed argument operand and then the parameter CV own its real array.
def $target_nodes(MAGIC_METHOD_SEND_TARGET pmagicmethodcall) = [HOBJECT pmagicmethodcall.OBJECT]
def $target_nodes(MAGIC_METHOD_TARGET pmagicmethodcall n pvalue*) = [HOBJECT pmagicmethodcall.OBJECT]
def $target_instance(MAGIC_METHOD_SEND_TARGET pmagicmethodcall) = eps
def $target_instance(MAGIC_METHOD_TARGET pmagicmethodcall n pvalue*) = eps
def $target_receiver(S, MAGIC_METHOD_TARGET pmagicmethodcall n pvalue*) = (pmagicmethodcall.OBJECT)
def $target_lexical_class(S, MAGIC_METHOD_TARGET pmagicmethodcall n pvalue*) = $target_lexical_class(S, METHOD_TARGET pmagicmethodcall.OBJECT pmagicmethodcall.METHOD)
def $target_called_class(S, MAGIC_METHOD_TARGET pmagicmethodcall n pvalue*) = (pmagicmethodcall.CLASS)

