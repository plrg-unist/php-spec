;; This history proves the selected source without rereading the receiver CV
;; or later argument values. Arguments may legitimately mutate either one.
dec $magic_method_descriptor(pstate, pmagicmethodcall) : bool
def $magic_method_descriptor(S, pmagicmethodcall) = true
  -- if pmagicmethodcall.SITE = PORIGIN n_unit pcpath
  -- if $origin_node(S.SOURCES, pmagicmethodcall.SITE) = (NExprMethodCall (NExprVariable (BYTES text_receiver) metadata_receiver) (NIdentifier (BYTES text_name) metadata_name) (SEQUENCE phpType7*) metadata)
  -- if pmagicmethodcall.NAME = $base64(text_name) /\ pmagicmethodcall.ARGUMENTS = phpType7*
  -- if |phpType7*| <- [1,2] /\ $base64(text_receiver) =/= $ptascii("this")
  -- if $source_emission_cv(S, n_unit, pcpath ++ [PCFIELD 0], NExprVariable (BYTES text_receiver) metadata_receiver)
  -- if ~$scope_global(S[.ORIGIN = (pmagicmethodcall.SITE)], [PCFIELD 0])
  -- if pmagicmethodcall.LINE = $runtime_line(S[.ORIGIN = (pmagicmethodcall.SITE)], eps, NExprMethodCall (NExprVariable (BYTES text_receiver) metadata_receiver) (NIdentifier (BYTES text_name) metadata_name) (SEQUENCE phpType7*) metadata)
  -- if $magic_method_arguments_source(S, pmagicmethodcall.SITE, phpType7*, 0)
  -- if $(pmagicmethodcall.OBJECT < |S.OBJECTS|)
  -- if S.OBJECTS[pmagicmethodcall.OBJECT] = INSTANCE pmagicmethodcall.CLASS
  -- if $class_at(S.CLASSES, pmagicmethodcall.CLASS) = (pclassdesc)
  -- if $class_named(S.CLASSNAMES, $ptlc(pclassdesc.NAME)) = (pmagicmethodcall.CLASS)
  -- if $effective_method(S, pmagicmethodcall.CLASS, pmagicmethodcall.NAME, |S.CLASSES|) = eps
  -- if $effective_method(S, pmagicmethodcall.CLASS, $ptascii("__call"), |S.CLASSES|) = (pmethoddesc)
  -- if pmethoddesc.FUNCTION.ORIGIN = pmagicmethodcall.METHOD
  -- if $magic_method_source(S, pmethoddesc)
  -- if $method_context_scope(pmagicmethodcall.CALLER) = $closure_source_class(S, pmagicmethodcall.SITE)
def $magic_method_descriptor(S, pmagicmethodcall) = false -- otherwise
dec $magic_method_caller(pstate, pmagicmethodcall) : bool
def $magic_method_caller(S, pmagicmethodcall) = true
