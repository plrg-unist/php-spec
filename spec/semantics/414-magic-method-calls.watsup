  -- if $(n < |S.OBJECTS|)
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $effective_method(S, porigin, $ptascii("__call"), |S.CLASSES|) =/= eps
  -- if $method_selected_scope(S, n, ptbytes, $method_current_scope(S)) = (pmethoddesc)
  -- if ~$method_accessible(S, pmethoddesc, $method_current_scope(S))
def $magic_method_needed(S, n, ptbytes) = false -- otherwise

;; Scoped magic fallback is deliberately outside this direct-call slice.
;; Constructor-special selection precedes that fallback in the engine.
def $magic_method_scoped(S, porigin) = true
