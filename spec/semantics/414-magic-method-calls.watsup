def $call_selected_valid(S, MAGIC_METHOD_SEND_TARGET pmagicmethodcall, (porigin)) = (porigin = pmagicmethodcall.SITE /\ $magic_method_raw_valid(S, pmagicmethodcall))
def $call_selected_valid(S, MAGIC_METHOD_TARGET pmagicmethodcall n pvalue*, (porigin)) = (porigin = pmagicmethodcall.SITE /\ ($magic_method_pending(S, pmagicmethodcall, n, pvalue*) \/ $magic_method_entered(S, S.CURRENT, S.FRAMES, pmagicmethodcall, n, pvalue*)))
