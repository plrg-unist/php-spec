dec $magic_method_raw_task(ptask, pmagicmethodcall) : bool
def $magic_method_raw_task(CALL_ARGS (MAGIC_METHOD_SEND_TARGET pmagicmethodcall) phpType7* n poperand* (porigin) z, pmagicmethodcall) = (porigin = pmagicmethodcall.SITE /\ z = pmagicmethodcall.LINE)
def $magic_method_raw_task(CALL_SEND (MAGIC_METHOD_SEND_TARGET pmagicmethodcall) phpType7* n poperand* (porigin) z, pmagicmethodcall) = (porigin = pmagicmethodcall.SITE /\ z = pmagicmethodcall.LINE)
def $magic_method_raw_task(ptask, pmagicmethodcall) = false -- otherwise
dec $magic_method_raw_suffix(ptask*, pmagicmethodcall) : bool
