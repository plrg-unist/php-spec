def $magic_method_raw_suffix(ptask :: ptask_tail*, pmagicmethodcall) = $magic_method_raw_suffix(ptask_tail*, pmagicmethodcall)
  -- if ~$magic_method_raw_task(ptask, pmagicmethodcall)
