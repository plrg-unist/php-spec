  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if $effective_method(S, porigin, $ptascii("__call"), |S.CLASSES|) =/= eps
  -- if $scoped_current_receiver(S) = (n)
  -- if $(n < |S.OBJECTS|) /\ (HOBJECT n) <- S.ALLOCATIONS
