def $named_call_shape(S, MAGIC_METHOD_TARGET pmagicmethodcall n pvalue*, (porigin)) = {SLOTS [NAMED_SENT (KNOWN PNULL), NAMED_SENT (KNOWN PNULL)], NAMED eps}
