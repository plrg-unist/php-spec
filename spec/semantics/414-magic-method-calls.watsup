;; Missing instance calls first collect the original positional sends. Only
;; then does the trampoline form __call's real (name, packed arguments) pair.
def $magic_method_needed(S, n, ptbytes) = true
  -- if $(n < |S.OBJECTS|)
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $effective_method(S, porigin, $ptascii("__call"), |S.CLASSES|) =/= eps
  -- if $method_selected_scope(S, n, ptbytes, $method_current_scope(S)) = eps
