def $magic_method_raw_task(MAGIC_METHOD_NAMED_ARGS pmagicmethodcall n poperand*, pmagicmethodcall) = true
def $magic_method_raw_task(MAGIC_METHOD_NAMED_SEND pmagicmethodcall n poperand*, pmagicmethodcall) = true
