def $named_call_shape(S, MAGIC_METHOD_NAMED_TARGET pmagicmethodcall n_arguments n_named pvalue*, (porigin)) = {SLOTS ([NAMED_SENT (KNOWN PNULL), NAMED_SENT (KNOWN PNULL)]), NAMED eps}
  -- if porigin = pmagicmethodcall.SITE
  -- if $magic_named_pending(S, pmagicmethodcall, n_arguments, n_named, pvalue*) \/ $magic_named_entered(S, S.CURRENT, S.FRAMES, pmagicmethodcall, n_arguments, n_named, pvalue*)

dec $magic_named_result_valid(pstate, pmagicmethodcall, nat, nat, pvalue*) : bool
def $magic_named_result_valid(S, pmagicmethodcall, n_arguments, n_named, pvalue*) = ($magic_method_caller(S, pmagicmethodcall) /\ $magic_named_buffer(S, pmagicmethodcall, n_arguments, n_named, pvalue*) /\ $source_operand_suffix(S.TODO, MAGIC_METHOD_NAMED_RESULT pmagicmethodcall n_arguments n_named pvalue*, METHOD_RESULT :: pmagicmethodcall.TAIL))
rule PhpStep/magic-named-result: S ~> S[.TODO = ptask_tail*]
  -- if S.TODO = (MAGIC_METHOD_NAMED_RESULT pmagicmethodcall n_arguments n_named pvalue*) :: ptask_tail*
  -- if $magic_named_result_valid(S, pmagicmethodcall, n_arguments, n_named, pvalue*)
def $task_nodes(MAGIC_METHOD_NAMED_ARGS pmagicmethodcall n poperand*) = $operands_roots(poperand*) ++ [HOBJECT pmagicmethodcall.OBJECT]
def $task_nodes(MAGIC_METHOD_NAMED_SEND pmagicmethodcall n poperand*) = $operands_roots(poperand*) ++ [HOBJECT pmagicmethodcall.OBJECT]
def $task_nodes(MAGIC_METHOD_NAMED_RESULT pmagicmethodcall n_arguments n_named pvalue*) = [HARRAY n_named, HOBJECT pmagicmethodcall.OBJECT]
def $call_task_valid(S, MAGIC_METHOD_NAMED_ARGS pmagicmethodcall n poperand*) = $magic_named_raw_valid(S, pmagicmethodcall, n, poperand*, false)
def $call_task_valid(S, MAGIC_METHOD_NAMED_SEND pmagicmethodcall n poperand*) = $magic_named_raw_valid(S, pmagicmethodcall, n, poperand*, true)
def $call_task_valid(S, MAGIC_METHOD_NAMED_RESULT pmagicmethodcall n_arguments n_named pvalue*) = $magic_named_result_valid(S, pmagicmethodcall, n_arguments, n_named, pvalue*)
def $destructor_return_discarded((MAGIC_METHOD_NAMED_RESULT pmagicmethodcall n_arguments n_named pvalue*) :: ptask_tail*) = $destructor_return_discarded(ptask_tail*)
