dec $concat_constant(pstate, porigin?) : bool
dec $concat_operand(pstate, poperand, bool, int) : (pstate, poperand)
def $concat_constant(S, porigin) = true
  -- if $compiled_read(S, porigin) = (pvalue)
def $concat_constant(S, porigin?) = false
  -- otherwise
def $concat_operand(S, KNOWN (PARRAY n), true, z) = (S_out, S_out.RESULT)
  -- if S_out = $stringify(S, PARRAY n, z)
def $concat_operand(S, KNOWN (PFLOAT n), true, z) = (S, KNOWN (PSTRING n_text*))
  -- if $source_precision(S, S.ORIGIN) = (z_precision)
  -- if (n_text*, b_warning) = $number_text(NFLOAT n, z_precision)
def $concat_operand(S, KNOWN pvalue, true, z) = (S, KNOWN (PSTRING $echo_value(pvalue)))
  -- if ~$is_array_value(pvalue)
  -- if $type_bytes(pvalue) =/= $ptascii("float")
def $concat_operand(S, poperand, b, z) = (S, poperand)
  -- otherwise

rule PhpStep/ordinary-concat: S ~> S[.TODO = [$at_task($origin_child(S.ORIGIN, [PCFIELD 0]), EVAL expression_1), CONCAT_LEFT expression_2 b_left b_right $runtime_line(S, [PCFIELD 1], expression_2)] ++ ptask_tail*]
  -- if S.TODO = (EVAL (NExprBinaryOpConcat expression_1 expression_2 metadata)) :: ptask_tail*
  -- if b_left = $concat_constant(S, $origin_child(S.ORIGIN, [PCFIELD 0]))
  -- if b_right = $concat_constant(S, $origin_child(S.ORIGIN, [PCFIELD 1]))
rule PhpStep/ordinary-concat-left: S ~> S[.TODO = [$at_task($origin_child(S.ORIGIN, [PCFIELD 1]), EVAL expression), CONCAT_RIGHT S.RESULT b_left b_right z] ++ ptask_tail*][.RESULT = KNOWN PNULL]
  -- if S.TODO = (CONCAT_LEFT expression b_left b_right z) :: ptask_tail*
rule PhpStep/ordinary-concat-right: S ~> S[.TODO = (CONCAT_PREP poperand S.RESULT b_left b_right z) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (CONCAT_RIGHT poperand b_left b_right z) :: ptask_tail*
