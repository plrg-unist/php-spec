  -- if $trait_aliases(S_prefix, pclassdesc_raw, pclassdesc_traits*, ptraitplan.ALIASES, eps) = TRAITALIASES ptraitalias*
  -- if $trait_copy_traits(pclassdesc_raw, pclassdesc_traits*, ptraitalias*, (ptbytes_trait, ptbytes_method)*, TRAITCOMPOSE S_prefix eps eps) = TRAITCOMPOSE S_methods ptraitmethod* ptraitmethod_required*
  -- if S_methods.COMPLETION = NORMAL
