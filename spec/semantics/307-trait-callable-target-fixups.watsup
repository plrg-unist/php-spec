def $trait_fcc_unfixed(S, porigin_owner, ptbytes_method, n_prefix) = eps -- otherwise
def $constant_callable_method_selected(S, porigin_site, porigin_owner, porigin_owner, n_prefix, ptbytes_method) = $trait_fcc_unfixed(S, porigin_owner, ptbytes_method, n_prefix)
