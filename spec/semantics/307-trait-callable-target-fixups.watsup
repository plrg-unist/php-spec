def $trait_fcc_import_source(S, pclassdesc, pmethoddesc, pclassdesc_trait :: pclassdesc_trait_tail*, n_prefix) = $trait_fcc_import_source(S, pclassdesc, pmethoddesc, pclassdesc_trait_tail*, n_prefix)
