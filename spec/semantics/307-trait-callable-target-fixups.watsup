;; An unresolved parent remains a runtime lookup, rather than a class name.
;; Admission checks the same supported shape with only that parameter atom
;; neutralized; exact source and receipt selection still determine the view.
dec $trait_fcc_parameter_supported(pstate, pclosurescope*, pfunction) : bool
dec $trait_fcc_parameter_support_one(pstate, pclosurescope, pfunction) : bool
def $trait_fcc_parameter_supported(S, eps, pfunction) = false
def $trait_fcc_parameter_supported(S, pclosurescope :: pclosurescope_tail*, pfunction) = ($trait_fcc_parameter_support_one(S, pclosurescope, pfunction) \/ $trait_fcc_parameter_supported(S, pclosurescope_tail*, pfunction))
def $trait_fcc_parameter_support_one(S, pclosurescope, pfunction) = true
  -- if $(pclosurescope.OBJECT < |S.OBJECTS|)
  -- if $object_body(S.OBJECTS[pclosurescope.OBJECT]) = METHODCLOSURE porigin_method porigin_site porigin_requested eps
  -- if $class_method_origin(S.CLASSES, porigin_method) = (pmethoddesc)
  -- if $trait_fcc_parameter_function(S, pclosurescope.OBJECT, pmethoddesc) = (pfunction)
def $trait_fcc_parameter_support_one(S, pclosurescope, pfunction) = false -- otherwise
def $call_supported_signature(S, pfunction) = true
  -- if ~$ppsupported_signature(pfunction.SIGNATURE)
  -- if $ppsupported_signature(pfunction.SIGNATURE[.PARAMETERS = $trait_type_parameters(pfunction.SIGNATURE.PARAMETERS, eps, (eps))])
  -- if $trait_fcc_parameter_supported(S, S.CLOSURESCOPES, pfunction)

;; Scalar masks return before complex lookup. Object branches and intersection
;; atoms retain source order, including an earlier matching class alternative.
dec $trait_fcc_parameter_atoms(pstate, ptatom*, pvalue) : bool?
dec $trait_fcc_parameter_branches(pstate, ptbranch*, pvalue) : bool?
dec $trait_fcc_parameter_parent_fatal(pstate, ptbranch*, pvalue) : bool
def $trait_fcc_parameter_atoms(S, eps, pvalue) = (true)
def $trait_fcc_parameter_atoms(S, PTPARENT :: ptatom*, pvalue) = eps
def $trait_fcc_parameter_atoms(S, (PTCLASS ptbytes) :: ptatom*, pvalue) = $trait_fcc_parameter_atoms(S, ptatom*, pvalue)
  -- if $typed_object_exact(S, [PTBRANCH ([PTCLASS ptbytes])], pvalue)
def $trait_fcc_parameter_atoms(S, ptatom*, pvalue) = (false) -- otherwise
def $trait_fcc_parameter_branches(S, eps, pvalue) = (false)
def $trait_fcc_parameter_branches(S, (PTBRANCH ptatom*) :: ptbranch*, pvalue) = (true)
  -- if $trait_fcc_parameter_atoms(S, ptatom*, pvalue) = (true)
def $trait_fcc_parameter_branches(S, (PTBRANCH ptatom*) :: ptbranch*, pvalue) = eps
  -- if $trait_fcc_parameter_atoms(S, ptatom*, pvalue) = eps
def $trait_fcc_parameter_branches(S, (PTBRANCH ptatom*) :: ptbranch*, pvalue) = $trait_fcc_parameter_branches(S, ptbranch*, pvalue)
  -- if $trait_fcc_parameter_atoms(S, ptatom*, pvalue) = (false)
def $trait_fcc_parameter_parent_fatal(S, ptbranch*, POBJECT n) = true
  -- if ~$typed_exact(ptbranch*, POBJECT n)
  -- if $trait_fcc_parameter_branches(S, ptbranch*, POBJECT n) = eps
def $trait_fcc_parameter_parent_fatal(S, ptbranch*, pvalue) = false -- otherwise
def $typed_parameter_conversion_at(S, ptbranch*, pvalue, b) = TYPEDEPENDENT "parameter parent scope has no parent"
  -- if $trait_fcc_parameter_parent_fatal(S, ptbranch*, pvalue)
def $typed_parameter_reference_conversion(S, ptbranch*, pvalue, b_strict, b_source) = TYPEDEPENDENT "parameter parent scope has no parent"
  -- if $trait_fcc_parameter_parent_fatal(S, ptbranch*, pvalue)
def $typed_parameter_apply(S, TYPEDEPENDENT "parameter parent scope has no parent", z) = S[.COMPLETION = FATAL ($ptascii("Cannot access \"parent\" when current class scope has no parent")) z][.ERRORORIGIN = ($origin_source(pcallcontext.FUNCTION))][.TRACE = $eval_exception_trace(S)]
  -- if S.CURRENT = (pcallcontext)

;; Parameter diagnostics name the copied scope, while the immutable function
;; descriptor and its shared static storage retain their class identity.
def $trait_fcc_target_name(S, CLOSURE_TARGET n) = (pclassdesc.NAME ++ $ptascii("::") ++ pmethoddesc.NAME)
  -- if $(n < |S.OBJECTS|)
  -- if HOBJECT n <- S.ALLOCATIONS
