;; The scratch initializer records the uncached trait warning. The ordinary
;; comparison queue delivers it only after the class and its cache publish.
def $trait_fcc_deprecation(S, pmethoddesc) = ($ptascii("Calling static trait method ") ++ pclassdesc.NAME ++ $ptascii("::") ++ pmethoddesc.NAME ++ $ptascii(" is deprecated, it should only be called on a class using the trait"))
