def $constant_callable_cached_method_access(S, porigin_site, porigin_owner, pmethoddesc) = (pmethoddesc = pmethoddesc_first \/ $trait_fcc_fixed_at_known(S, pconstantclosure_first, porigin_first_owner, pmethoddesc_first, |S.DECLARATIONS|) = (pmethoddesc))
