;; Aliases and visibility changes are copied before function-scope fixup.
;; Recover their exact selected copy, preserving the ordinary lookup path.
def $trait_fcc_adapted(S, pclassdesc, pmethoddesc, n_prefix) = (pmethoddesc_unfixed)
  -- if $(n_prefix <= |S.DECLARATIONS|)
  -- if pclassdesc_raw = pclassdesc[.METHODS = $trait_notice_own_methods(pclassdesc.METHODS, pclassdesc.ORIGIN)]
  -- if S_prefix = S[.CLASSNAMES = $trait_notice_names(S, S.DECLARATIONS[0:n_prefix])][.DECLARATIONS = S.DECLARATIONS[0:n_prefix]][.TODO = eps][.COMPLETION = NORMAL]
  -- if ptraitplan = $trait_plan(S_prefix, pclassdesc_raw)
  -- if ptraitplan.ALIASES =/= eps
  -- if $trait_fetch(S_prefix, ptraitplan.TRAITS, eps) = TRAITFETCHED pclassdesc_traits*
  -- if $trait_exclusions(S_prefix, pclassdesc_raw, pclassdesc_traits*, ptraitplan.PRECEDENCES, eps) = TRAITEXCLUSIONS (ptbytes_trait, ptbytes_method)*
  -- if $trait_aliases(S_prefix, pclassdesc_raw, pclassdesc_traits*, ptraitplan.ALIASES, eps) = TRAITALIASES ptraitalias*
  -- if $trait_copy_traits(pclassdesc_raw, pclassdesc_traits*, ptraitalias*, (ptbytes_trait, ptbytes_method)*, TRAITCOMPOSE S_prefix eps eps) = TRAITCOMPOSE S_methods ptraitmethod* ptraitmethod_required*
  -- if S_methods.COMPLETION = NORMAL
  -- if $trait_fcc_receipt_target(pmethoddesc, ptraitmethod*) = (pmethoddesc_unfixed)
def $trait_fcc_adapted(S, pclassdesc, pmethoddesc, n_prefix) = eps -- otherwise
def $trait_fcc_import_selected(S, pclassdesc, pmethoddesc, n_prefix, (pmethoddesc_unfixed)) = (pmethoddesc_unfixed)
