;; Writable object-property chains retain the static address until the delayed
;; fetch. In particular, a non-CV RHS can wrap the live slot in a reference.
dec $property_static_chain(expression) : bool
def $property_static_chain(NExprStaticPropertyFetch phpType19 phpType31 metadata) = true
def $property_static_chain(NExprPropertyFetch expression phpType20 metadata) = $property_static_chain(expression)
def $property_static_chain(expression) = false -- otherwise
dec $property_writer_tail(ptask*) : bool
def $property_writer_tail((ORIGIN_RETURN porigin?) :: ptask_tail*) = $property_writer_tail(ptask_tail*)
def $property_writer_tail((DIM_INDEX expression z) :: ptask_tail*) = $property_writer_tail(ptask_tail*)
def $property_writer_tail((DIM_APPEND z) :: ptask_tail*) = $property_writer_tail(ptask_tail*)
def $property_writer_tail((PROPERTY_BASE_PREP phpType20 z) :: ptask_tail*) = true
def $property_writer_tail((ASSIGN_PREP expression_target expression) :: ptask_tail*) = true
def $property_writer_tail((COMPOUND_PREP pbin expression_target expression z) :: ptask_tail*) = true
def $property_writer_tail((UPDATE_PREP pupdate b z) :: ptask_tail*) = true
def $property_writer_tail((COALESCE_ASSIGN_PREP expression_target expression z) :: ptask_tail*) = true
def $property_writer_tail((PROPERTY_REF_PREP expression z) :: ptask_tail*) = true
def $property_writer_tail((PROPERTY_REF_FETCH z) :: ptask_tail*) = true
def $property_writer_tail((ACQUIRE_ARRAY z) :: ptask_tail*) = true
def $property_writer_tail((REF_ARRAY_PREP expression z) :: ptask_tail*) = true
def $property_writer_tail((CALL_REF_FETCH pcalltarget n porigin?) :: ptask_tail*) = true
def $property_writer_tail((RETURN_REF_FETCH z) :: ptask_tail*) = true
def $property_writer_tail((FOREACH_DIM (NStmtForeach expression phpType5 (BOOLEAN b_ref) expression_value phpType23 (BOOLEAN false) metadata) z) :: ptask_tail*) = $ppforeach_references(expression_value, b_ref)
def $property_writer_tail(UNSET_ARRAY :: ptask_tail*) = true
def $property_writer_tail(ptask*) = false -- otherwise
dec $property_instance_chain(expression) : bool
def $property_instance_chain(expression) = false -- otherwise
dec $property_hook_ref_receiver(pstate, expression) : bool
def $property_hook_ref_receiver(S, expression) = false -- otherwise
def $property_pending_receiver(S, expression) = (($property_static_chain(expression) \/ $property_instance_chain(NExprPropertyFetch expression phpType20 metadata)) /\ $property_writer_tail(ptask_tail*) /\ ~$property_hook_ref_receiver(S, expression))
