  -- if ~pmethoddesc.STATIC /\ ~pmethoddesc.ABSTRACT /\ pmethoddesc.VISIBILITY = PROPERTY_PUBLIC
  -- if $node_children(S, HOBJECT pconfigiterator.OBJECT) = eps
def $config_iterator_finalizable_aggregate_data(S, pconfigiterator) = false -- otherwise
def $config_iterator_aggregate_data(S, pconfigiterator) = ($config_iterator_quiet_aggregate_data(S, pconfigiterator) \/ $config_iterator_finalizable_aggregate_data(S, pconfigiterator))

def $config_iterator_string(S, PSTRING n*) = $startup_bytes(n*)
def $config_iterator_string(S, PSTRING_CARRIER pstringidentity n*) = $string_carrier_valid(S, PSTRING_CARRIER pstringidentity n*)
def $config_iterator_string(S, pvalue) = false -- otherwise
def $config_iterator_string_operand(S, KNOWN pvalue) = $config_iterator_string(S, pvalue)
def $config_iterator_string_operand(S, poperand) = false -- otherwise
;; SEND_UNPACK normalizes the argument key; the Iterator's key() result stays raw.
def $config_iterator_key(S, PINT z) = (KINT z)
def $config_iterator_key(S, PSTRING n*) = (KINT z)
  -- if $startup_bytes(n*)
  -- if $string_key(n*) = INTEGERKEY z
def $config_iterator_key(S, PSTRING n*) = (KSTRING n*)
  -- if $startup_bytes(n*)
  -- if $string_key(n*) = STRINGKEY
def $config_iterator_key(S, PSTRING_CARRIER pstringidentity n*) = $config_iterator_key(S, PSTRING n*)
  -- if $string_carrier_valid(S, PSTRING_CARRIER pstringidentity n*)
def $config_iterator_key(S, pvalue) = eps -- otherwise
def $config_iterator_key_input(pconfigiterator, PINT z) = true
def $config_iterator_key_input(pconfigiterator, PSTRING n*) = true
  -- if pconfigiterator.INPUT = VARIABLE ptbytes z
def $config_iterator_key_input(pconfigiterator, PSTRING_CARRIER pstringidentity n*) = true
  -- if pconfigiterator.INPUT = VARIABLE ptbytes z
def $config_iterator_key_input(pconfigiterator, pvalue) = false -- otherwise
def $config_iterator_send_key(S, pconfigiterator, pvalue) = $config_iterator_key(S, pvalue)
  -- if $config_iterator_key_input(pconfigiterator, pvalue)
def $config_iterator_send_key(S, pconfigiterator, pvalue) = eps
  -- if ~$config_iterator_key_input(pconfigiterator, pvalue)
def $config_iterator_key_operand(S, pconfigiterator, KNOWN pvalue) = ($config_iterator_send_key(S, pconfigiterator, pvalue) =/= eps)
def $config_iterator_key_operand(S, pconfigiterator, poperand) = false -- otherwise
def $config_iterator_invalid_primitive_key(KNOWN PNULL) = true
def $config_iterator_invalid_primitive_key(KNOWN (PBOOL b)) = true
def $config_iterator_invalid_primitive_key(KNOWN (PFLOAT n)) = true
def $config_iterator_invalid_primitive_key(poperand) = false -- otherwise
def $config_iterator_live_cv_primitive_key(S, pconfigiterator, poperand) = true
  -- if pconfigiterator.INPUT = VARIABLE ptbytes z
  -- if $lookup(S.ENV, ptbytes) = (n_cell)
  -- if S.STORE[n_cell] = DEFINED (POBJECT pconfigiterator.OBJECT)
  -- if $config_iterator_invalid_primitive_key(poperand)
def $config_iterator_live_cv_primitive_key(S, pconfigiterator, poperand) = false -- otherwise
def $config_iterator_temp_primitive_key(S, pconfigiterator, poperand) = true
  -- if $config_iterator_owning_input(pconfigiterator)
  -- if $config_iterator_invalid_primitive_key(poperand)
  -- if $destructor_method(S, pconfigiterator.OBJECT) = eps
  -- if $node_children(S, HOBJECT pconfigiterator.OBJECT) = eps
def $config_iterator_temp_primitive_key(S, pconfigiterator, poperand) = false -- otherwise
def $config_iterator_fresh_aggregate_primitive_key(S, pconfigiterator, poperand) = true
  -- if pconfigiterator.PRODUCER = (n_aggregate)
  -- if ~$config_iterator_owning_input(pconfigiterator)
  -- if $config_iterator_aggregate_data(S, pconfigiterator)
  -- if $heap_owners($heap_graph(S), HOBJECT pconfigiterator.OBJECT) = 1
  -- if $config_iterator_invalid_primitive_key(poperand)
def $config_iterator_fresh_aggregate_primitive_key(S, pconfigiterator, poperand) = false -- otherwise
def $config_iterator_items(S, pconfigiterator, eps) = true
def $config_iterator_items(S, pconfigiterator, (ENTRY (KINT z) (DIRECT pvalue)) :: pentry_tail*) = ($config_iterator_string(S, pvalue) /\ $config_iterator_items(S, pconfigiterator, pentry_tail*))
def $config_iterator_items(S, pconfigiterator, (ENTRY (KSTRING n*) (DIRECT pvalue)) :: pentry_tail*) = ($config_iterator_key_input(pconfigiterator, PSTRING n*) /\ $startup_bytes(n*) /\ $string_key(n*) = STRINGKEY /\ $config_iterator_string(S, pvalue) /\ $config_iterator_items(S, pconfigiterator, pentry_tail*))
def $config_iterator_items(S, pconfigiterator, pentry*) = false -- otherwise

def $config_iterator_history(S, pconfigiterator) = true
  -- if pconfigiterator.CALL.KIND = INTRINSIC_INI_SET
  -- if pconfigiterator.CALL.INDEX = 0 /\ pconfigiterator.CALL.SENT = eps
  -- if ~pconfigiterator.CALL.NAMED /\ pconfigiterator.CALL.PACKS = eps
