def $config_iterator_valid(S, pconfigiterator, text) = false -- otherwise

def $config_iterator_target(S, pconfigiterator, UNPACK_ITERATOR_TARGET n porigin_method, text) = $useriter_method_selected(S, n, porigin_method, text)
  -- if n = pconfigiterator.OBJECT
  -- if text <- ["rewind", "valid", "current", "key", "next"]
def $config_iterator_target(S, pconfigiterator, pcalltarget, text) = false -- otherwise
def $useriter_pending(S, UNPACK_ITERATOR_TARGET n porigin_method, porigin) = true
