  -- if $destructor_method(S, pconfigiterator.OBJECT) = eps
  -- if $node_children(S, HOBJECT pconfigiterator.OBJECT) = eps
def $config_iterator_quiet_input(S, pconfigiterator) = false -- otherwise

;; PRODUCER is an identity receipt from the actual Aggregate return. It owns
;; neither the Aggregate nor its Iterator and survives INPUT CV rebinding.
def $config_iterator_producer_valid(S, pconfigiterator) = true
  -- if pconfigiterator.PRODUCER = eps
def $config_iterator_producer_valid(S, pconfigiterator) = true
  -- if pconfigiterator.PRODUCER = (n_aggregate)
