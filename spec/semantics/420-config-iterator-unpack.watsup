def $config_iterator_nodes(pconfigiterator, "ready") = $config_iterator_call_nodes(pconfigiterator)
def $config_iterator_nodes(pconfigiterator, "input-release") = $config_iterator_input_nodes(pconfigiterator) ++ $config_iterator_call_nodes(pconfigiterator)
