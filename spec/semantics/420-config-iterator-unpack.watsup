  -- if $config_aggregate_scope(S, pconfigaggregate)
  -- if $config_aggregate_owners(S, pconfigaggregate, 0)
;; Receiver retirement removes its allocation, but not its class/source record.
def $config_iterator_producer_valid(S, pconfigiterator) = true
  -- if pconfigiterator.PRODUCER = (n_aggregate)
  -- if n_aggregate =/= pconfigiterator.OBJECT
  -- if pconfigaggregate = {CALL pconfigiterator.CALL, OBJECT n_aggregate, INPUT pconfigiterator.INPUT}
