;; DATA/cursor retire before API reception. The historical object and entries in
;; ready are nonowning; an external Iterator owner remains after DATA retirement.
def $config_iterator_finish(S, pconfigiterator, ptask_tail*) = $fiber_start_unpack_release(S[.ITERATORS = $iterator_remove(S.ITERATORS, pconfigiterator.ITERATOR)][.ORIGIN = (pconfigiterator.CALL.SITE)][.TODO = (CONFIG_ITERATOR pconfigiterator "ready") :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], [HOBJECT pconfigiterator.OBJECT])
  -- if $($heap_owners($heap_graph(S), HOBJECT pconfigiterator.OBJECT) > 1)
def $config_iterator_finish(S, pconfigiterator, ptask_tail*) = S[.COMPLETION = UNSUPPORTED "CONFIG Iterator unpack last DATA owner"]
  -- if $($heap_owners($heap_graph(S), HOBJECT pconfigiterator.OBJECT) <= 1)
rule PhpStep/config-iterator-finish: S ~> $config_iterator_finish(S, pconfigiterator, ptask_tail*)
  -- if S.TODO = (CONFIG_ITERATOR pconfigiterator "finish") :: ptask_tail*
  -- if $config_iterator_valid(S, pconfigiterator, "finish")
rule PhpStep/config-iterator-ready: S ~> $config_receive(S, pconfigcall[.INDEX = 1])
  -- if S.TODO = (CONFIG_ITERATOR pconfigiterator "ready") :: ptask_tail*
  -- if $config_iterator_valid(S, pconfigiterator, "ready")
  -- if $config_pack_prefix(pconfigiterator.CALL, pconfigiterator.ITEMS, false) = (pconfigcall)

;; Callback failure tears down cache/DATA before caller catch search resumes.
def $config_iterator_discard_allowed(S, pconfigiterator) = true
  -- if $($heap_owners($heap_graph(S), HOBJECT pconfigiterator.OBJECT) > 0)
  -- if pconfigiterator.CALL.OWNER = eps
def $config_iterator_discard_allowed(S, pconfigiterator) = true
  -- if $($heap_owners($heap_graph(S), HOBJECT pconfigiterator.OBJECT) > 0)
  -- if pconfigiterator.CALL.OWNER = (n_owner)
  -- if $($heap_owners($heap_graph(S), HOBJECT n_owner) > 0)
def $config_iterator_discard_allowed(S, pconfigiterator) = false -- otherwise
;; Generic throw search has removed the task. Restore its owners at the boundary.
def $config_iterator_discard(S, pconfigiterator, text) = S[.TODO = (THROW_SEARCH n) :: (CONFIG_ITERATOR pconfigiterator text) :: ptask_tail*][.COMPLETION = UNSUPPORTED "CONFIG Iterator unpack last cleanup owner"]
  -- if ~$config_iterator_discard_allowed(S, pconfigiterator)
