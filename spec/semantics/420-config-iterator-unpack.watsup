  -- if $origin_node(S.SOURCES, pfunction_call.ORIGIN) = (NStmtFunction phpType14 phpType4 phpType11 phpType16 phpType18 phpType23 metadata_call)
  -- if pfunction_call.SIGNATURE.PARAMETERS = eps /\ ~pfunction_call.SIGNATURE.BYREF
def $config_iterator_input(S, pconfigiterator) = false -- otherwise
def $config_iterator_owning_input(pconfigiterator) = true
  -- if pconfigiterator.INPUT = KNOWN (POBJECT pconfigiterator.OBJECT)
def $config_iterator_owning_input(pconfigiterator) = false -- otherwise
def $config_iterator_input_nodes(pconfigiterator) = [HOBJECT pconfigiterator.OBJECT]
  -- if $config_iterator_owning_input(pconfigiterator)
def $config_iterator_input_nodes(pconfigiterator) = eps
  -- if ~$config_iterator_owning_input(pconfigiterator)
def $config_iterator_quiet_input(S, pconfigiterator) = true
  -- if ~$config_iterator_owning_input(pconfigiterator)
def $config_iterator_quiet_input(S, pconfigiterator) = true
  -- if $config_iterator_owning_input(pconfigiterator)
  -- if $($heap_owners($heap_graph(S), HOBJECT pconfigiterator.OBJECT) > 1)
def $config_iterator_quiet_input(S, pconfigiterator) = true
