  -- if $config_iterator_input(S, pconfigiterator)
  -- if $config_iterator_producer_valid(S, pconfigiterator)
  -- if $config_iterator_items(S, pconfigiterator, pconfigiterator.ITEMS)
  -- if $config_pack_prefix(pconfigiterator.CALL, pconfigiterator.ITEMS, false) = (pconfigcall_prefix)
def $config_iterator_history(S, pconfigiterator) = false -- otherwise
def $config_iterator_scope(S, pconfigiterator) = true
  -- if $config_iterator_history(S, pconfigiterator)
