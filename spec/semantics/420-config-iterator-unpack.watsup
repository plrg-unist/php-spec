;; A user Iterator's DATA owns the selected object once. INPUT is a borrowed CV;
;; ITEMS is streaming history, not a PHP ARRAY or an additional owner.
dec $config_iterator_scope(pstate, pconfigiterator) : bool
dec $config_iterator_start(pstate, pconfigcall, poperand, nat) : bool
dec $config_iterator_string(pstate, pvalue) : bool
dec $config_iterator_string_operand(pstate, poperand) : bool
dec $config_iterator_integer_operand(poperand) : bool
dec $config_iterator_items(pstate, pentry*) : bool
dec $config_iterator_stage(pstate, pconfigiterator, text) : bool
dec $config_iterator_valid(pstate, pconfigiterator, text) : bool
dec $config_iterator_methods(pstate, nat, text*) : bool
dec $config_iterator_target(pstate, pconfigiterator, pcalltarget, text) : bool
dec $config_iterator_frame(pstate, pcallcontext, pframe) : bool
dec $config_iterator_nodes(pconfigiterator, text) : pnode*
dec $config_iterator_call(pstate, pconfigiterator, text, ptask*) : pstate
dec $config_iterator_clear(pstate, pconfigiterator, text, ptask*) : pstate
dec $config_iterator_finish(pstate, pconfigiterator, ptask*) : pstate
dec $config_iterator_discard(pstate, pconfigiterator, text) : pstate
dec $config_iterator_discard_allowed(pstate, pconfigiterator) : bool

def $config_traversable_value(S, POBJECT n) = ($useriter_instance(S, n) \/ $generator_object(S, n) \/ $generator_from_aggregate(S, POBJECT n) \/ $weakmap_at(S, n) \/ $weakmap_iterator_at(S, n))
  -- if $(n < |S.OBJECTS|)
  -- if HOBJECT n <- S.ALLOCATIONS
def $config_traversable_value(S, pvalue) = false -- otherwise

def $config_iterator_methods(S, n, eps) = true
def $config_iterator_methods(S, n, text :: text_tail*) = $config_iterator_methods(S, n, text_tail*)
  -- if S.OBJECTS[n] = INSTANCE porigin_class
  -- if $effective_method(S, porigin_class, $ptascii(text), |S.CLASSES|) = (pmethoddesc)
  -- if $useriter_method_selected(S, n, pmethoddesc.FUNCTION.ORIGIN, text)
  -- if ~pmethoddesc.FUNCTION.SIGNATURE.BYREF
  -- if pmethoddesc.FUNCTION.SIGNATURE.RETURNS = $useriter_signature($ptascii(text)).RETURNS
  -- if ~$function_generator(S, pmethoddesc.FUNCTION)
def $config_iterator_methods(S, n, text*) = false -- otherwise

def $config_iterator_string(S, PSTRING n*) = $startup_bytes(n*)
def $config_iterator_string(S, PSTRING_CARRIER pstringidentity n*) = $string_carrier_valid(S, PSTRING_CARRIER pstringidentity n*)
def $config_iterator_string(S, pvalue) = false -- otherwise
def $config_iterator_string_operand(S, KNOWN pvalue) = $config_iterator_string(S, pvalue)
def $config_iterator_string_operand(S, poperand) = false -- otherwise
def $config_iterator_integer_operand(KNOWN (PINT z)) = true
def $config_iterator_integer_operand(poperand) = false -- otherwise
def $config_iterator_items(S, eps) = true
def $config_iterator_items(S, (ENTRY (KINT z) (DIRECT pvalue)) :: pentry_tail*) = ($config_iterator_string(S, pvalue) /\ $config_iterator_items(S, pentry_tail*))
def $config_iterator_items(S, pentry*) = false -- otherwise

def $config_iterator_scope(S, pconfigiterator) = true
  -- if pconfigiterator.CALL.KIND = INTRINSIC_INI_SET
  -- if pconfigiterator.CALL.INDEX = 0 /\ pconfigiterator.CALL.SENT = eps
  -- if ~pconfigiterator.CALL.NAMED /\ pconfigiterator.CALL.PACKS = eps
  -- if ~$pipe_site(S, pconfigiterator.CALL.SITE)
  -- if $intrinsic_count(S, pconfigiterator.CALL.SITE) = (1)
  -- if $config_pending_valid(S[.ORIGIN = (pconfigiterator.CALL.SITE)], pconfigiterator.CALL, true)
  -- if $intrinsic_argument(S, pconfigiterator.CALL.SITE, 0) = ((expression, true, eps, PORIGIN n pcpath, z))
  -- if pconfigiterator.INPUT = VARIABLE ptbytes z
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $source_unit(S.SOURCES, n) = (pcunit)
  -- if $unpack_cv_at(pcode, pcunit, pcpath) = (ptbytes)
  -- if $useriter_instance(S, pconfigiterator.OBJECT)
  -- if $config_iterator_methods(S, pconfigiterator.OBJECT, ["rewind", "valid", "current", "key", "next"])
  -- if $config_iterator_items(S, pconfigiterator.ITEMS)
def $config_iterator_scope(S, pconfigiterator) = false -- otherwise
def $config_iterator_start(S, pconfigcall, poperand, n) = $config_iterator_scope(S, {CALL pconfigcall, ITERATOR S.NEXTITER, OBJECT n, INPUT poperand, ITEMS eps, CURRENT (KNOWN PNULL), KEY (KNOWN PNULL)})

rule PhpStep/config-iterator-start: S ~> S_value[.ITERATORS = S_value.ITERATORS ++ [OBJECTITER n_iterator n_object 0 false]][.NEXTITER = $(n_iterator + 1)][.ORIGIN = (porigin)][.TODO = (CONFIG_ITERATOR {CALL pconfigcall, ITERATOR n_iterator, OBJECT n_object, INPUT S.RESULT, ITEMS eps, CURRENT (KNOWN PNULL), KEY (KNOWN PNULL)} "rewind-start") :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (CONFIG_UNPACK_PREP pconfigcall) :: ptask_tail*
  -- if $intrinsic_argument(S, pconfigcall.SITE, pconfigcall.INDEX) = ((expression, true, eps, porigin, z))
  -- if S_value = $resolve_at(S, S.RESULT, z)
  -- if S_value.COMPLETION = NORMAL
  -- if S_value.RESULT = KNOWN (POBJECT n_object)
  -- if $config_iterator_start(S_value, pconfigcall, S.RESULT, n_object)
  -- if n_iterator = S_value.NEXTITER
rule PhpStep/config-traversable-unsupported: S ~> S_value[.COMPLETION = UNSUPPORTED "CONFIG Traversable unpack outside initialized Iterator domain"]
  -- if S.TODO = (CONFIG_UNPACK_PREP pconfigcall) :: ptask_tail*
  -- if $intrinsic_argument(S, pconfigcall.SITE, pconfigcall.INDEX) = ((expression, true, preqbytes?, porigin, z))
  -- if S_value = $resolve_at(S, S.RESULT, z)
  -- if S_value.COMPLETION = NORMAL
  -- if S_value.RESULT = KNOWN (POBJECT n_object)
  -- if $config_traversable_value(S_value, POBJECT n_object)
  -- if ~$weakmap_at(S_value, n_object)
  -- if ~$config_iterator_start(S_value, pconfigcall, S.RESULT, n_object)
  -- if ~$config_aggregate_start(S, pconfigcall, S.RESULT, n_object)

;; With external map/key owners and a quiet current, WeakMap's DATA/key pins
;; retire silently. The current table pointer is borrowed, never copied/sent.
dec $config_weakmap_value(pstate, pvalue) : bool
dec $config_weakmap_contents(pstate, nat) : bool
dec $config_weakmap_owner(pstate, nat?) : bool
dec $config_weakmap_scope(pstate, pconfigcall, poperand, nat) : bool
dec $config_weakmap_finish(pstate, pconfigcall, nat, int) : pstate
def $config_weakmap_value(S, pvalue) = true -- if $weakmap_scalar_value(S, pvalue)
def $config_weakmap_value(S, POBJECT n) = true
  -- if $(n < |S.OBJECTS|) /\ (HOBJECT n) <- S.ALLOCATIONS
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if ~$instance_storage_freeing(S, n)
  -- if $node_children(S, HOBJECT n) = eps
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if pclassdesc.PARENT = eps /\ pclassdesc.METHODS = eps
def $config_weakmap_value(S, pvalue) = false -- otherwise
def $config_weakmap_contents(S, n) = true -- if S.OBJECTS[n] = WEAKMAP eps
def $config_weakmap_contents(S, n) = true
  -- if S.OBJECTS[n] = WEAKMAP (pweakmapentry)
  -- if $(pweakmapentry.KEY < |S.OBJECTS|) /\ (HOBJECT pweakmapentry.KEY) <- S.ALLOCATIONS
  -- if S.OBJECTS[pweakmapentry.KEY] = STDINSTANCE
  -- if ~$instance_storage_freeing(S, pweakmapentry.KEY)
