  -- if n_iterator = S_value.NEXTITER
rule PhpStep/config-traversable-unsupported: S ~> S_value[.COMPLETION = UNSUPPORTED "CONFIG Traversable unpack outside initialized Iterator domain"]
  -- if S.TODO = (CONFIG_UNPACK_PREP pconfigcall) :: ptask_tail*
