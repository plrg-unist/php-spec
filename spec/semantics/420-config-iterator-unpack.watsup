;; A user Iterator's DATA owns the selected object once. A temporary call result
;; keeps a separate opcode INPUT until after DATA; ITEMS owns no PHP ARRAY.
dec $config_aggregate_scope(pstate, pconfigaggregate) : bool
dec $config_aggregate_owners(pstate, pconfigaggregate, nat) : bool
dec $config_aggregate_source(pstate, pconfigaggregate) : bool
