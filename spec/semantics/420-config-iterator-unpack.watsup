def $config_iterator_frame(S, pcallcontext, pframe) = false -- otherwise
def $useriter_frame(S, pcallcontext, pframe) = true -- if $config_iterator_frame(S, pcallcontext, pframe)
def $useriter_marker(pframe) = true -- if pframe.TODO = (CONFIG_ITERATOR pconfigiterator text) :: ptask_tail*

def $config_iterator_nodes(pconfigiterator, "ready") = $config_nodes(pconfigiterator.CALL)
def $config_iterator_nodes(pconfigiterator, text) = $operand_nodes(pconfigiterator.KEY) ++ $operand_nodes(pconfigiterator.CURRENT) ++ [HOBJECT pconfigiterator.OBJECT] ++ $config_nodes(pconfigiterator.CALL)
  -- if text =/= "ready"
def $task_nodes(CONFIG_ITERATOR pconfigiterator text) = $config_iterator_nodes(pconfigiterator, text)
def $call_task_valid(S, CONFIG_ITERATOR pconfigiterator text) = $config_iterator_valid(S, pconfigiterator, text)
def $useriter_task_ids(CONFIG_ITERATOR pconfigiterator text) = [pconfigiterator.ITERATOR] -- if text =/= "ready"
def $useriter_task_ids(CONFIG_ITERATOR pconfigiterator "ready") = eps
def $error_task_iterator(CONFIG_ITERATOR pconfigiterator text) = $useriter_task_ids(CONFIG_ITERATOR pconfigiterator text)
def $selected_task_nonce(CONFIG_ITERATOR pconfigiterator text) = pconfigiterator.CALL.SELECTION
def $generator_internal_task(CONFIG_ITERATOR pconfigiterator text) = true
def $eager_explicit_task(CONFIG_ITERATOR pconfigiterator text) = true

def $config_iterator_call(S, pconfigiterator, text, ptask_tail*) = S[.TODO = [(CALL_ARGS (UNPACK_ITERATOR_TARGET pconfigiterator.OBJECT pmethoddesc.FUNCTION.ORIGIN) eps 0 eps (porigin) z), CONFIG_ITERATOR pconfigiterator text] ++ ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
