  -- if $config_iterator_retired_methods(S, pconfigiterator.OBJECT, ["rewind", "valid", "current", "key", "next"])
def $config_iterator_retired_scope(S, pconfigiterator) = false -- otherwise
def $config_iterator_start(S, pconfigcall, poperand, n) = $config_iterator_scope(S, {CALL pconfigcall, ITERATOR S.NEXTITER, OBJECT n, INPUT poperand, PRODUCER eps, ITEMS eps, CURRENT (KNOWN PNULL), KEY (KNOWN PNULL)})

rule PhpStep/config-iterator-start: S ~> S_value[.ITERATORS = S_value.ITERATORS ++ [OBJECTITER n_iterator n_object 0 false]][.NEXTITER = $(n_iterator + 1)][.ORIGIN = (porigin)][.TODO = (CONFIG_ITERATOR {CALL pconfigcall, ITERATOR n_iterator, OBJECT n_object, INPUT S.RESULT, PRODUCER eps, ITEMS eps, CURRENT (KNOWN PNULL), KEY (KNOWN PNULL)} "rewind-start") :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
