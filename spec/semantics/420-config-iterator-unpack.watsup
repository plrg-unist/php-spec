  -- if $destructor_method(S, pconfigiterator.OBJECT) = eps
  -- if $node_children(S, HOBJECT pconfigiterator.OBJECT) = eps
def $config_iterator_quiet_aggregate_data(S, pconfigiterator) = false -- otherwise
def $config_iterator_finalizable_aggregate_data(S, pconfigiterator) = true
  -- if pconfigiterator.PRODUCER = (n_aggregate)
  -- if ~$config_iterator_owning_input(pconfigiterator)
  -- if $config_iterator_producer_valid(S, pconfigiterator)
