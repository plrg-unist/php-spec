  -- if $origin_node(S.SOURCES, pmethoddesc.FUNCTION.ORIGIN) = (NStmtClassMethod phpType14 phpType24 phpType4 phpType11 phpType16 phpType18 phpType47 metadata)
  -- if ~$function_generator(S, pmethoddesc.FUNCTION)
def $config_iterator_producer_valid(S, pconfigiterator) = false -- otherwise
def $config_iterator_quiet_aggregate_data(S, pconfigiterator) = true
  -- if pconfigiterator.PRODUCER = (n_aggregate)
