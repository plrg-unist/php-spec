  -- if $weakmap_before_valid(S, pweakmapentry)
  -- if pvalue = pweakmapentry.VALUE
  -- if $config_weakmap_value(S, pvalue)
def $config_weakmap_contents(S, n) = false -- otherwise
def $config_weakmap_owner(S, eps) = true
def $config_weakmap_owner(S, (n)) = $($heap_owners($heap_graph(S), HOBJECT n) > 1)
def $config_weakmap_scope(S, pconfigcall, poperand, n) = true
  -- if S.COMPLETION = NORMAL
  -- if S.TODO = (CONFIG_UNPACK_PREP pconfigcall) :: ptask_tail*
  -- if pconfigcall.KIND = INTRINSIC_INI_SET
  -- if pconfigcall.INDEX = 0 /\ pconfigcall.SENT = eps
  -- if ~pconfigcall.NAMED /\ pconfigcall.PACKS = eps
  -- if ~$pipe_site(S, pconfigcall.SITE)
  -- if $intrinsic_count(S, pconfigcall.SITE) = (1)
  -- if $config_pending_valid(S, pconfigcall, true)
  -- if $intrinsic_argument(S, pconfigcall.SITE, 0) = ((expression, true, eps, PORIGIN n_source pcpath, z))
  -- if poperand = VARIABLE ptbytes z
  -- if $code_at(S.CODE, n_source) = (pcode)
  -- if $source_unit(S.SOURCES, n_source) = (pcunit)
  -- if $unpack_cv_at(pcode, pcunit, pcpath) = (ptbytes)
  -- if S_input = $quiet_operand(S, poperand)
  -- if S_input.COMPLETION = NORMAL /\ S_input.RESULT = KNOWN (POBJECT n)
  -- if $weakmap_at(S, n) /\ ~$instance_storage_freeing(S, n)
  -- if $($heap_owners($heap_graph(S), HOBJECT n) > 0)
  -- if $config_weakmap_owner(S, pconfigcall.OWNER)
  -- if $config_weakmap_contents(S, n)
def $config_weakmap_scope(S, pconfigcall, poperand, n) = false -- otherwise
def $config_weakmap_finish(S, pconfigcall, n, z) = $config_receive(S[.ORIGIN = (pconfigcall.SITE)], pconfigcall[.INDEX = 1])
  -- if S.OBJECTS[n] = WEAKMAP eps
def $config_weakmap_finish(S, pconfigcall, n, z) = $throw_scalar(S, "Error", $ptascii("Keys must be of type int|string during argument unpacking"), z)
  -- if S.OBJECTS[n] = WEAKMAP (pweakmapentry)
rule PhpStep/config-weakmap-unpack: S ~> $config_weakmap_finish(S, pconfigcall, n, z)
  -- if S.TODO = (CONFIG_UNPACK_PREP pconfigcall) :: ptask_tail*
  -- if $intrinsic_argument(S, pconfigcall.SITE, 0) = ((expression, true, eps, porigin, z))
  -- if S_value = $resolve_at(S, S.RESULT, z)
  -- if S_value.COMPLETION = NORMAL
  -- if S_value.RESULT = KNOWN (POBJECT n)
  -- if $config_weakmap_scope(S, pconfigcall, S.RESULT, n)
rule PhpStep/config-weakmap-unsupported: S ~> S[.COMPLETION = UNSUPPORTED "CONFIG WeakMap unpack outside borrowed quiet domain"]
  -- if S.TODO = (CONFIG_UNPACK_PREP pconfigcall) :: ptask_tail*
  -- if $intrinsic_argument(S, pconfigcall.SITE, pconfigcall.INDEX) = ((expression, true, preqbytes?, porigin, z))
