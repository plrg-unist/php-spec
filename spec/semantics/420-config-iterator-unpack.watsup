  -- if pconfigiterator.CURRENT = KNOWN pvalue
  -- if $config_iterator_string(S, pvalue)
  -- if pconfigiterator.KEY = KNOWN (PINT z)
def $config_iterator_stage(S, pconfigiterator, text) = false -- otherwise

