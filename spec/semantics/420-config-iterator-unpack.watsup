def $config_iterator_scope(S, pconfigiterator) = false -- otherwise
def $config_iterator_retired_scope(S, pconfigiterator) = true
  -- if $config_iterator_history(S, pconfigiterator)
  -- if $config_iterator_owning_input(pconfigiterator) \/ $config_iterator_aggregate_data(S, pconfigiterator)
