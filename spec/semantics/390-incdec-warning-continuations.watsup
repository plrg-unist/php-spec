;; increment_function/decrement_function borrow the selected zval. Bool/null
;; restoration precedes the exception check; strings restore only on success.
;; A handler-created CV reference is destroyed, not followed for restoration.
syntax pupdatepointer = UPDATE_CV ptbytes | UPDATE_CELL nat
syntax pupdatewarning = { SITE porigin, OP pupdate, POST bool, NAME ptbytes, LINE int, POINTER pupdatepointer, INPUT pvalue, PENDING nat? }
syntax pupdaterestore = { WARNING pupdatewarning, CELL nat, WRAPPER nat?, VALUE pvalue, CALLER pcallcontext?, CONSTCONTEXT pconstantcontext? }

dec $update_warning_kind(pcnode) : (pupdate, bool)?
def $update_warning_kind(NExprPreInc expression metadata) = ((INCREMENT, false))
def $update_warning_kind(NExprPostInc expression metadata) = ((INCREMENT, true))
def $update_warning_kind(NExprPreDec expression metadata) = ((DECREMENT, false))
def $update_warning_kind(NExprPostDec expression metadata) = ((DECREMENT, true))
def $update_warning_kind(pcnode) = eps -- otherwise

dec $update_warning_notice(pupdate, pvalue) : (int, ptbytes)?
def $update_warning_notice(pupdate, PBOOL b) = ((2, $update_verb(pupdate) ++ $ptascii(" on type bool has no effect, this will change in the next major version of PHP")))
def $update_warning_notice(DECREMENT, PNULL) = ((2, $update_verb(DECREMENT) ++ $ptascii(" on type null has no effect, this will change in the next major version of PHP")))
def $update_warning_notice(pupdate, PSTRING_CARRIER pstringidentity n*) = $update_warning_notice(pupdate, PSTRING n*)
def $update_warning_notice(pupdate, PSTRING n*) = ((8192, $update_notice(stringupdatenotice)))
  -- if $update_string(pupdate, n*) = (stringupdate, [stringupdatenotice])
def $update_warning_notice(pupdate, pvalue) = eps -- otherwise
dec $update_warning_after(pupdate, pvalue) : pvalue?
def $update_warning_after(pupdate, PBOOL b) = (PBOOL b)
def $update_warning_after(DECREMENT, PNULL) = (PNULL)
def $update_warning_after(pupdate, PSTRING_CARRIER pstringidentity n*) = $update_warning_after(pupdate, PSTRING n*)
def $update_warning_after(pupdate, PSTRING n*) = ($update_string_value(stringupdate))
  -- if $update_string(pupdate, n*) = (stringupdate, [stringupdatenotice])
def $update_warning_after(pupdate, pvalue) = eps -- otherwise
dec $update_warning_restores_throw(pvalue) : bool
def $update_warning_restores_throw(PBOOL b) = true
def $update_warning_restores_throw(PNULL) = true
def $update_warning_restores_throw(pvalue) = false -- otherwise

dec $update_warning_source(pstate, pupdatewarning) : bool
def $update_warning_source(S, pupdatewarning) = true
  -- if S.ORIGIN = (pupdatewarning.SITE)
  -- if $origin_node(S.SOURCES, pupdatewarning.SITE) = (pcnode)
  -- if $update_warning_kind(pcnode) = ((pupdatewarning.OP, pupdatewarning.POST))
  -- if $error_variable_source(S, (pupdatewarning.SITE), [PCFIELD 0], pupdatewarning.NAME)
  -- if $code_expression_at_source(S, pupdatewarning.SITE, eps) = (pupdatewarning.LINE)
def $update_warning_source(S, pupdatewarning) = false -- otherwise
dec $update_warning_pointer_source(pstate, pupdatewarning) : bool
def $update_warning_pointer_source(S, pupdatewarning) = true
  -- if pupdatewarning.POINTER = UPDATE_CV pupdatewarning.NAME
def $update_warning_pointer_source(S, pupdatewarning) = true
  -- if pupdatewarning.POINTER = UPDATE_CELL n
  -- if $(n < |S.STORE|)
def $update_warning_pointer_source(S, pupdatewarning) = false -- otherwise
dec $update_warning_valid(pstate, pupdatewarning) : bool
def $update_warning_valid(S, pupdatewarning) = ($update_warning_source(S, pupdatewarning) /\ $update_warning_pointer_source(S, pupdatewarning) /\ $update_warning_notice(pupdatewarning.OP, pupdatewarning.INPUT) =/= eps /\ $update_warning_after(pupdatewarning.OP, pupdatewarning.INPUT) =/= eps /\ $destructor_pending_valid(S, pupdatewarning.PENDING))

dec $update_warning_select(pstate, ptbytes) : pupdatepointer?
def $update_warning_select(S, ptbytes) = (UPDATE_CELL n)
  -- if $lookup(S.ENV, ptbytes) = (n)
  -- if $(n < |S.STORE|)
  -- if S.STORE[n] = DEFINED pvalue
  -- if n <- S.REFCELLS
  -- if $propref_at(S.PROPREFS, n) = eps
def $update_warning_select(S, ptbytes) = (UPDATE_CV ptbytes)
  -- if $lookup(S.ENV, ptbytes) = (n)
  -- if $(n < |S.STORE|)
  -- if S.STORE[n] = DEFINED pvalue
  -- if ~(n <- S.REFCELLS)
def $update_warning_select(S, ptbytes) = eps -- otherwise
dec $update_warning_pointer_value(pstate, pupdatepointer) : pslot?
def $update_warning_pointer_value(S, UPDATE_CV ptbytes) = (S.STORE[n])
  -- if ~$environment_blocked(S, ptbytes)
  -- if $lookup(S.ENV, ptbytes) = (n)
  -- if $(n < |S.STORE|)
def $update_warning_pointer_value(S, UPDATE_CV ptbytes) = (UNDEFINED)
  -- if ~$environment_blocked(S, ptbytes)
  -- if $lookup(S.ENV, ptbytes) = eps
def $update_warning_pointer_value(S, UPDATE_CELL n) = (S.STORE[n])
  -- if $(n < |S.STORE|)
  -- if n <- S.REFCELLS
  -- if $propref_at(S.PROPREFS, n) = eps
  -- if $($heap_owners($heap_prune($heap_graph(S)), HCELL n) > 0)
def $update_warning_pointer_value(S, pupdatepointer) = eps -- otherwise
dec $update_warning_plan(pstate) : pupdatewarning?
def $update_warning_plan(S) = (pupdatewarning)
  -- if S.TODO = (UPDATE_PREP pupdate b_post z) :: ptask_tail*
  -- if ~$key_write_pending(S)
  -- if S.BASE = BASE_VALUE (VARIABLE ptbytes z_name)
  -- if S.ORIGIN = (porigin)
  -- if $update_warning_select(S, ptbytes) = (pupdatepointer)
  -- if $update_warning_pointer_value(S, pupdatepointer) = (DEFINED pvalue)
  -- if $update_warning_notice(pupdate, pvalue) = ((i, ptbytes_message))
  -- if $error_handler_eligible(S, i)
  -- if pupdatewarning = {SITE porigin, OP pupdate, POST b_post, NAME ptbytes, LINE z, POINTER pupdatepointer, INPUT pvalue, PENDING eps}
  -- if $update_warning_valid(S, pupdatewarning)
def $update_warning_plan(S) = eps -- otherwise
def $update_warning_pending(S) = ($update_warning_plan(S) =/= eps)

;; Releasing a callback-owned object, including an array child, precedes the
;; captured scalar store. The old raw slot remains visible during its destructor.
dec $update_warning_no_objects(pnode*) : bool
def $update_warning_no_objects(eps) = true
def $update_warning_no_objects((HOBJECT n) :: pnode*) = false
def $update_warning_no_objects((HCELL n) :: pnode*) = $update_warning_no_objects(pnode*)
def $update_warning_no_objects((HARRAY n) :: pnode*) = $update_warning_no_objects(pnode*)
dec $update_warning_release_safe(pstate, pslot) : bool
def $update_warning_release_safe(S, UNDEFINED) = true
def $update_warning_release_safe(S, DEFINED pvalue) = $update_warning_no_objects($heap_reach($value_nodes(pvalue), eps, $allocation_edges(S, S.ALLOCATIONS)))
def $update_warning_release_safe(S, pslot) = false -- otherwise
dec $update_warning_store(pstate, pupdatepointer, pvalue) : pstate
dec $update_restore_capture(pstate, pupdatewarning) : pupdaterestore?
def $update_warning_store(S, UPDATE_CELL n, pvalue) = $reference_coercion_store(S, n, DEFINED pvalue)
def $update_warning_store(S, UPDATE_CV ptbytes, pvalue) = $reference_coercion_store(S, n, DEFINED pvalue)
  -- if $lookup(S.ENV, ptbytes) = (n)
  -- if ~(n <- S.REFCELLS)
def $update_warning_store(S, UPDATE_CV ptbytes, pvalue) = $reference_coercion_store(S_new, S_new.CELL, DEFINED pvalue)
  -- if $lookup(S.ENV, ptbytes) = (n)
  -- if n <- S.REFCELLS
  -- if S_new = $ensure($unset_name(S, ptbytes), ptbytes)
def $update_warning_store(S, UPDATE_CV ptbytes, pvalue) = $reference_coercion_store(S_new, S_new.CELL, DEFINED pvalue)
  -- if $lookup(S.ENV, ptbytes) = eps
  -- if S_new = $ensure(S, ptbytes)

rule PhpStep/update-warning-begin: S ~> S[.TODO = (UPDATE_WARNING_NOTICE pupdatewarning) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (UPDATE_PREP pupdate b_post z) :: ptask_tail*
  -- if $update_warning_plan(S) = (pupdatewarning)
rule PhpStep/update-warning-notice: S ~> $error_dispatch(S, i, ptbytes_message, pupdatewarning.LINE, DIAGNOSTIC $integer_notice_name(i) ptbytes_message pupdatewarning.LINE, UPDATE_WARNING_RESTORE pupdatewarning)
  -- if S.TODO = (UPDATE_WARNING_NOTICE pupdatewarning) :: ptask_tail*
  -- if $call_task_valid(S, UPDATE_WARNING_NOTICE pupdatewarning)
  -- if $update_warning_notice(pupdatewarning.OP, pupdatewarning.INPUT) = ((i, ptbytes_message))
rule PhpStep/update-warning-expired: S ~> S[.COMPLETION = UNSUPPORTED "increment/decrement restoration target is expired or constrained"]
  -- if S.TODO = (UPDATE_WARNING_RESTORE pupdatewarning) :: ptask_tail*
  -- if $update_warning_valid(S, pupdatewarning)
  -- if $update_warning_pointer_value(S, pupdatewarning.POINTER) = eps
rule PhpStep/update-warning-release-prepare: S ~> S[.TODO = (UPDATE_WARNING_RELEASE pupdaterestore) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (UPDATE_WARNING_RESTORE pupdatewarning) :: ptask_tail*
  -- if $update_restore_capture(S, pupdatewarning) = (pupdaterestore)
rule PhpStep/update-warning-restore: S ~> S_written[.TODO = (UPDATE_WARNING_DONE pupdatewarning) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (UPDATE_WARNING_RESTORE pupdatewarning) :: ptask_tail*
  -- if $update_warning_valid(S, pupdatewarning)
  -- if $update_warning_pointer_value(S, pupdatewarning.POINTER) = (pslot)
  -- if $update_warning_release_safe(S, pslot)
  -- if $update_warning_after(pupdatewarning.OP, pupdatewarning.INPUT) = (pvalue)
  -- if S_written = $update_warning_store(S, pupdatewarning.POINTER, pvalue)
rule PhpStep/update-warning-post-result: S ~> S[.TODO = ptask_tail*][.RESULT = KNOWN pupdatewarning.INPUT]
  -- if S.TODO = (UPDATE_WARNING_DONE pupdatewarning) :: ptask_tail*
  -- if $update_warning_valid(S, pupdatewarning)
  -- if pupdatewarning.PENDING = eps
  -- if pupdatewarning.POST
rule PhpStep/update-warning-pre-result: S ~> S[.TODO = ptask_tail*][.RESULT = KNOWN pvalue]
  -- if S.TODO = (UPDATE_WARNING_DONE pupdatewarning) :: ptask_tail*
  -- if $update_warning_valid(S, pupdatewarning)
  -- if pupdatewarning.PENDING = eps
  -- if ~pupdatewarning.POST
  -- if $update_warning_after(pupdatewarning.OP, pupdatewarning.INPUT) = (pvalue)
rule PhpStep/update-warning-resume-throw: S ~> S[.TODO = (THROW_SEARCH n) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (UPDATE_WARNING_DONE pupdatewarning) :: ptask_tail*
  -- if $update_warning_valid(S, pupdatewarning)
  -- if pupdatewarning.PENDING = (n)

;; Bool/null restoration runs after handler unwinding, retaining the supplied
;; Throwable once. Borrowed CV/cell pointers and captured scalars add no owner.
def $error_read_discard(S, UPDATE_WARNING_RESTORE pupdatewarning) = S[.TODO = (UPDATE_WARNING_RESTORE pupdatewarning[.PENDING = (n)]) :: ptask_tail*]
  -- if S.COMPLETION = NORMAL
  -- if S.TODO = (THROW_SEARCH n) :: ptask_tail*
  -- if $update_warning_valid(S, pupdatewarning)
  -- if pupdatewarning.PENDING = eps
  -- if $update_warning_restores_throw(pupdatewarning.INPUT)

;; Exit returns through the warning helper after the real handler frame and its
;; locals have unwound. Keep that boundary before caller cleanup and shutdown.
dec $update_warning_exit_marker(ptask) : bool
def $update_warning_exit_marker(UPDATE_WARNING_NOTICE pupdatewarning) = true
def $update_warning_exit_marker(UPDATE_WARNING_RESTORE pupdatewarning) = true
def $update_warning_exit_marker(UPDATE_WARNING_DONE pupdatewarning) = true
def $update_warning_exit_marker(UPDATE_WARNING_RELEASE pupdaterestore) = true
def $update_warning_exit_marker(UPDATE_WARNING_COMMIT pupdaterestore) = true
def $update_warning_exit_marker(UPDATE_WARNING_EXIT perrorcall z) = true
def $update_warning_exit_marker(ERROR_HANDLER_INVOKE perrorcall) = $update_warning_exit_marker(perrorcall.RESUME)
def $update_warning_exit_marker(ERROR_HANDLER_RESULT perrorcall) = $update_warning_exit_marker(perrorcall.RESUME)
def $update_warning_exit_marker(ERROR_HANDLER_CLEAN perrorcall) = $update_warning_exit_marker(perrorcall.RESUME)
def $update_warning_exit_marker(ptask) = false -- otherwise
dec $update_warning_exit_tasks(pstate, ptask*) : bool
def $update_warning_exit_tasks(S, eps) = false
def $update_warning_exit_tasks(S, ptask :: ptask_tail*) = true
  -- if $update_warning_exit_marker(ptask)
  -- if $call_task_valid(S, ptask)
def $update_warning_exit_tasks(S, ptask :: ptask_tail*) = $update_warning_exit_tasks($call_after_origin(S, ptask), ptask_tail*)
  -- if ~($update_warning_exit_marker(ptask) /\ $call_task_valid(S, ptask))
dec $update_warning_exit_frames(pstate, pframe*) : bool
def $update_warning_exit_frames(S, eps) = false
def $update_warning_exit_frames(S, pframe :: pframe_tail*) = ($update_warning_exit_tasks($constant_frame_scope(S, pframe, pframe_tail*), pframe.TODO) \/ $update_warning_exit_frames(S, pframe_tail*))
def $update_warning_exit_pending(S) = ($update_warning_exit_tasks(S, S.TODO) \/ $update_warning_exit_frames(S, S.FRAMES))
dec $update_warning_exit_named(pstate, perrorcall) : bool
dec $update_warning_exit_owning(pstate, perrorcall) : bool
dec $update_warning_exit_admitted(pstate, perrorcall) : bool
def $update_warning_exit_named(S, perrorcall) = true
  -- if perrorcall.RESUME = UPDATE_WARNING_RESTORE pupdatewarning
  -- if pupdatewarning.PENDING = eps
  -- if perrorcall.TARGET = (PORIGIN n pcpath)
  -- if $value_nodes(perrorcall.CALLBACK) = eps
  -- if $error_entered_call_valid(S, perrorcall)
def $update_warning_exit_named(S, perrorcall) = false -- otherwise
def $update_warning_exit_owning(S, perrorcall) = true
  -- if perrorcall.RESUME = UPDATE_WARNING_RESTORE pupdatewarning
  -- if pupdatewarning.PENDING = eps
  -- if perrorcall.CALLBACK = POBJECT n
  -- if $(n < |S.OBJECTS|)
  -- if S.OBJECTS[n] = INSTANCE porigin_class
  -- if perrorcall.TARGET = (METHOD_TARGET n porigin_method)
  -- if $error_entered_call_valid(S, perrorcall)
def $update_warning_exit_owning(S, perrorcall) = false -- otherwise
def $update_warning_exit_admitted(S, perrorcall) = ($update_warning_exit_named(S, perrorcall) \/ $update_warning_exit_owning(S, perrorcall))
dec $update_warning_exit_call(pstate) : perrorcall?
def $update_warning_exit_call(S) = (perrorcall)
  -- if S.TODO = (ERROR_HANDLER_RESULT perrorcall) :: ptask_tail*
  -- if $update_warning_exit_admitted(S, perrorcall)
def $update_warning_exit_call(S) = eps -- otherwise
dec $update_warning_exit_handler_head(pstate, pcallcontext?, pframe, pframe*) : bool
def $update_warning_exit_handler_head(S, (pcallcontext), pframe, pframe_tail*) = true
  -- if pframe.TODO = (ERROR_HANDLER_RESULT perrorcall) :: ptask_tail*
  -- if perrorcall.TARGET = (pcallcontext.TARGET)
  -- if $update_warning_exit_admitted($constant_frame_scope(S, pframe, pframe_tail*), perrorcall)
  -- if $error_context_valid(S, pcallcontext)
def $update_warning_exit_handler_head(S, pcallcontext?, pframe, pframe_tail*) = false -- otherwise
dec $update_warning_exit_handler(pstate, pcallcontext?, pframe*) : bool
def $update_warning_exit_handler(S, pcallcontext?, pframe :: pframe_tail*) = ($update_warning_exit_handler_head(S, pcallcontext?, pframe, pframe_tail*) \/ $update_warning_exit_handler(S, pframe.CONTEXT, pframe_tail*))
def $update_warning_exit_handler(S, pcallcontext?, eps) = false
def $update_warning_exit_unwind(S) = ($update_warning_exit_call(S) = eps /\ $update_warning_exit_handler(S, S.CURRENT, S.FRAMES))
;; Caller operands and protected-region markers remain pending until the
;; warning helper returns. Its final exit step drops them without executing them.
def $exit_start_unwind(S, z) = S[.TODO = (UPDATE_WARNING_EXIT perrorcall z) :: ptask_tail*][.COMPLETION = NORMAL][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if ~$fiber_closing(S, S.ACTIVEFIBER)
  -- if ~$property_dynamic_exit_pending(S)
  -- if ~$foreach_bind_exit_pending(S)
  -- if $update_warning_exit_call(S) = (perrorcall)
  -- if S.TODO = (ERROR_HANDLER_RESULT perrorcall) :: ptask_tail*
def $exit_start_unwind(S, z) = S[.COMPLETION = UNSUPPORTED "increment/decrement warning exit continuation"]
  -- if ~$fiber_closing(S, S.ACTIVEFIBER)
  -- if ~$property_dynamic_exit_pending(S)
  -- if ~$foreach_bind_exit_pending(S)
  -- if $update_warning_exit_pending(S)
  -- if ~$update_warning_exit_unwind(S)
  -- if $update_warning_exit_call(S) = eps

def $task_nodes(UPDATE_WARNING_EXIT perrorcall z) = $value_nodes(perrorcall.CALLBACK) ++ $error_selected_roots(perrorcall.TARGET)
def $call_task_valid(S, UPDATE_WARNING_EXIT perrorcall z) = ($update_warning_exit_admitted(S, perrorcall) /\ z = $ntprecision32(z))
def $source_operand_marker(UPDATE_WARNING_EXIT perrorcall z) = $source_operand_marker(perrorcall.RESUME)
def $throwable_marker(UPDATE_WARNING_EXIT perrorcall z) = true
dec $update_exit_order_supported(pstate) : bool
rule PhpStep/update-warning-exit-string: S ~> $exit_start_unwind($error_handler_restore(S[.TODO = ptask_tail*], perrorcall.CALLBACK), z)
  -- if S.TODO = (UPDATE_WARNING_EXIT perrorcall z) :: ptask_tail*
  -- if $call_task_valid(S, UPDATE_WARNING_EXIT perrorcall z)
  -- if $update_warning_exit_named(S, perrorcall)
  -- if perrorcall.RESUME = UPDATE_WARNING_RESTORE pupdatewarning
  -- if ~$update_warning_restores_throw(pupdatewarning.INPUT)
  -- if $update_exit_order_supported(S)
rule PhpStep/update-warning-exit-expired: S ~> S[.COMPLETION = UNSUPPORTED "increment/decrement restoration target is expired or constrained"]
  -- if S.TODO = (UPDATE_WARNING_EXIT perrorcall z) :: ptask_tail*
  -- if $call_task_valid(S, UPDATE_WARNING_EXIT perrorcall z)
  -- if $update_warning_exit_named(S, perrorcall)
  -- if perrorcall.RESUME = UPDATE_WARNING_RESTORE pupdatewarning
  -- if $update_warning_restores_throw(pupdatewarning.INPUT)
  -- if $update_warning_pointer_value(S, pupdatewarning.POINTER) = eps
rule PhpStep/update-warning-exit-owned: S ~> S[.COMPLETION = UNSUPPORTED "increment/decrement warning exit continuation"]
  -- if S.TODO = (UPDATE_WARNING_EXIT perrorcall z) :: ptask_tail*
  -- if $call_task_valid(S, UPDATE_WARNING_EXIT perrorcall z)
  -- if $update_warning_exit_named(S, perrorcall)
  -- if perrorcall.RESUME = UPDATE_WARNING_RESTORE pupdatewarning
  -- if $update_warning_restores_throw(pupdatewarning.INPUT)
  -- if $update_warning_pointer_value(S, pupdatewarning.POINTER) = (pslot)
  -- if ~$update_warning_release_safe(S, pslot)
rule PhpStep/update-warning-exit-restore: S ~> $exit_start_unwind($update_warning_store($error_handler_restore(S[.TODO = ptask_tail*], perrorcall.CALLBACK), pupdatewarning.POINTER, pvalue), z)
  -- if S.TODO = (UPDATE_WARNING_EXIT perrorcall z) :: ptask_tail*
  -- if $call_task_valid(S, UPDATE_WARNING_EXIT perrorcall z)
  -- if $update_warning_exit_named(S, perrorcall)
  -- if perrorcall.RESUME = UPDATE_WARNING_RESTORE pupdatewarning
  -- if $update_warning_restores_throw(pupdatewarning.INPUT)
  -- if $update_warning_pointer_value(S, pupdatewarning.POINTER) = (pslot)
  -- if $update_warning_release_safe(S, pslot)
  -- if $update_warning_after(pupdatewarning.OP, pupdatewarning.INPUT) = (pvalue)
  -- if $update_exit_order_supported(S)
;; A real handler-local Throwable replaces UnwindExit. Restore the helper,
;; then continue through the retained caller tail without resetting EXITSTATUS.
dec $update_warning_exit_cancel_safe(pstate, perrorcall) : bool
def $update_warning_exit_cancel_safe(S, perrorcall) = true
  -- if perrorcall.RESUME = UPDATE_WARNING_RESTORE pupdatewarning
  -- if ~$update_warning_restores_throw(pupdatewarning.INPUT)
def $update_warning_exit_cancel_safe(S, perrorcall) = true
  -- if perrorcall.RESUME = UPDATE_WARNING_RESTORE pupdatewarning
  -- if $update_warning_restores_throw(pupdatewarning.INPUT)
  -- if $update_warning_pointer_value(S, pupdatewarning.POINTER) = (pslot)
  -- if $update_warning_release_safe(S, pslot)
def $update_warning_exit_cancel_safe(S, perrorcall) = false -- otherwise
rule PhpStep/update-warning-exit-cleanup-order: S ~> S[.COMPLETION = UNSUPPORTED "increment/decrement warning exit temporary cleanup order"]
  -- if S.TODO = (UPDATE_WARNING_EXIT perrorcall z) :: ptask_tail*
  -- if $call_task_valid(S, UPDATE_WARNING_EXIT perrorcall z)
  -- if $update_warning_exit_named(S, perrorcall)
  -- if $update_warning_exit_cancel_safe(S, perrorcall)
  -- if ~$update_exit_order_supported(S)
rule PhpStep/update-warning-exit-cleanup-throw-string: S ~> $error_handler_restore(S[.TODO = (UPDATE_WARNING_DONE pupdatewarning[.PENDING = (n)]) :: ptask_tail*], perrorcall.CALLBACK)
  -- if S.TODO = (THROW_SEARCH n) :: (UPDATE_WARNING_EXIT perrorcall z) :: ptask_tail*
  -- if $call_task_valid(S, UPDATE_WARNING_EXIT perrorcall z)
  -- if $update_warning_exit_named(S, perrorcall)
  -- if $throwable_live(S, n)
  -- if perrorcall.RESUME = UPDATE_WARNING_RESTORE pupdatewarning
  -- if ~$update_warning_restores_throw(pupdatewarning.INPUT)
rule PhpStep/update-warning-exit-cleanup-throw-restore: S ~> $update_warning_store($error_handler_restore(S[.TODO = (UPDATE_WARNING_DONE pupdatewarning[.PENDING = (n)]) :: ptask_tail*], perrorcall.CALLBACK), pupdatewarning.POINTER, pvalue)
  -- if S.TODO = (THROW_SEARCH n) :: (UPDATE_WARNING_EXIT perrorcall z) :: ptask_tail*
  -- if $call_task_valid(S, UPDATE_WARNING_EXIT perrorcall z)
  -- if $update_warning_exit_named(S, perrorcall)
  -- if $throwable_live(S, n)
  -- if perrorcall.RESUME = UPDATE_WARNING_RESTORE pupdatewarning
  -- if $update_warning_restores_throw(pupdatewarning.INPUT)
  -- if $update_warning_pointer_value(S, pupdatewarning.POINTER) = (pslot)
  -- if $update_warning_release_safe(S, pslot)
  -- if $update_warning_after(pupdatewarning.OP, pupdatewarning.INPUT) = (pvalue)
rule PhpStep/update-warning-exit-cleanup-throw: S ~> S[.COMPLETION = UNSUPPORTED "increment/decrement warning exit cleanup throw"]
  -- if S.TODO = (THROW_SEARCH n) :: (UPDATE_WARNING_EXIT perrorcall z) :: ptask_tail*
  -- if $call_task_valid(S, UPDATE_WARNING_EXIT perrorcall z)
  -- if $update_warning_exit_named(S, perrorcall)
  -- if ~$update_warning_exit_cancel_safe(S, perrorcall)

;; zend_error releases the selected receiver before deciding whether to restore
;; or drop its old raw callback. Its destructor precedes the captured store.
;; The final phase borrows the existing cleanup certificate, never the object.
dec $update_callback_exit_source_valid(pstate, pdestructioncleanup) : bool
dec $update_callback_exit_valid(pstate, pdestructioncleanup, int, nat) : bool
dec $update_callback_selected_release(pstate, pdestructioncleanup, int, ptask*) : pstate
dec $update_callback_raw_release(pstate, pdestructioncleanup, int, ptask*) : pstate
dec $update_callback_selected_pending(pstate, pdestructioncleanup, int, nat, ptask*) : pstate
dec $update_callback_raw_pending(pstate, pdestructioncleanup, int, nat, ptask*) : pstate
dec $update_exit_control_call(pstate) : (perrorcall, int, ptask*)?
def $update_callback_exit_source_valid(S, pdestructioncleanup) = true
  -- if pdestructioncleanup.SOURCE = ERROR_HANDLER_RESULT perrorcall
  -- if $eager_cleanup_valid(S, pdestructioncleanup)
  -- if $update_warning_exit_owning($eager_cleanup_history(S, pdestructioncleanup), perrorcall)
def $update_callback_exit_source_valid(S, pdestructioncleanup) = false -- otherwise
def $update_callback_exit_valid(S, pdestructioncleanup, z, n_phase) = true
  -- if $(n_phase <= 2) /\ z = $ntprecision32(z)
  -- if $update_callback_exit_source_valid(S, pdestructioncleanup)
  -- if S.CURRENT = pdestructioncleanup.CALLER /\ S.ORIGIN = pdestructioncleanup.ORIGIN /\ S.CONSTCONTEXT = pdestructioncleanup.CONSTCONTEXT
  -- if pdestructioncleanup.RELEASED = $(n_phase = 2)
  -- if n_phase = 0 \/ n_phase = 2
  -- if $eager_cleanup_find(S.DESTRUCTION.CLEANUPS, pdestructioncleanup.SOURCE) = eps
  -- if $heap_subset($task_nodes(UPDATE_WARNING_CALLBACK_EXIT pdestructioncleanup z n_phase), S.ALLOCATIONS)
def $update_callback_exit_valid(S, pdestructioncleanup, z, 1) = true
  -- if z = $ntprecision32(z)
  -- if $update_callback_exit_source_valid(S, pdestructioncleanup)
  -- if S.CURRENT = pdestructioncleanup.CALLER /\ S.ORIGIN = pdestructioncleanup.ORIGIN /\ S.CONSTCONTEXT = pdestructioncleanup.CONSTCONTEXT
  -- if ~pdestructioncleanup.RELEASED
  -- if S.DESTRUCTION.CLEANUPS = pdestructioncleanup :: pdestructioncleanup_tail*
  -- if $heap_subset($task_nodes(UPDATE_WARNING_CALLBACK_EXIT pdestructioncleanup z 1), S.ALLOCATIONS)
def $update_callback_exit_valid(S, pdestructioncleanup, z, n_phase) = false -- otherwise
def $task_nodes(UPDATE_WARNING_CALLBACK_EXIT pdestructioncleanup z 0) = $value_nodes(perrorcall.CALLBACK) ++ $error_selected_roots(perrorcall.TARGET)
  -- if pdestructioncleanup.SOURCE = ERROR_HANDLER_RESULT perrorcall
def $task_nodes(UPDATE_WARNING_CALLBACK_EXIT pdestructioncleanup z 1) = $value_nodes(perrorcall.CALLBACK)
  -- if pdestructioncleanup.SOURCE = ERROR_HANDLER_RESULT perrorcall
def $task_nodes(UPDATE_WARNING_CALLBACK_EXIT pdestructioncleanup z n_phase) = eps -- if $(n_phase >= 2)
def $call_task_valid(S, UPDATE_WARNING_CALLBACK_EXIT pdestructioncleanup z n_phase) = $update_callback_exit_valid(S, pdestructioncleanup, z, n_phase)
def $source_operand_marker(UPDATE_WARNING_CALLBACK_EXIT pdestructioncleanup z n_phase) = $source_operand_marker(perrorcall.RESUME)
  -- if pdestructioncleanup.SOURCE = ERROR_HANDLER_RESULT perrorcall
def $throwable_marker(UPDATE_WARNING_CALLBACK_EXIT pdestructioncleanup z n_phase) = true
def $update_warning_exit_marker(UPDATE_WARNING_CALLBACK_EXIT pdestructioncleanup z n_phase) = true
def $eager_explicit_task(UPDATE_WARNING_CALLBACK_EXIT pdestructioncleanup z n_phase) = $(n_phase < 2)
def $eager_cleanup_source(UPDATE_WARNING_CALLBACK_EXIT pdestructioncleanup z n_phase) = pdestructioncleanup.SOURCE
rule PhpStep/update-warning-exit-owning: S ~> S[.TODO = (UPDATE_WARNING_CALLBACK_EXIT pdestructioncleanup z 0) :: ptask_tail*]
  -- if S.TODO = (UPDATE_WARNING_EXIT perrorcall z) :: ptask_tail*
  -- if $call_task_valid(S, UPDATE_WARNING_EXIT perrorcall z)
  -- if $update_warning_exit_owning(S, perrorcall)
  -- if pdestructioncleanup = $eager_cleanup_record(S, ERROR_HANDLER_RESULT perrorcall)
rule PhpStep/update-warning-exit-owning-local-throw: S ~> S[.TODO = (THROW_SEARCH n) :: (UPDATE_WARNING_CALLBACK_EXIT pdestructioncleanup z 0) :: ptask_tail*]
  -- if S.TODO = (THROW_SEARCH n) :: (UPDATE_WARNING_EXIT perrorcall z) :: ptask_tail*
  -- if $call_task_valid(S, UPDATE_WARNING_EXIT perrorcall z)
  -- if $update_warning_exit_owning(S, perrorcall) /\ $throwable_live(S, n)
  -- if pdestructioncleanup = $eager_cleanup_record(S, ERROR_HANDLER_RESULT perrorcall)
def $update_callback_selected_release(S, pdestructioncleanup, z, ptask_tail*) = $eager_operation_begin(S_next, S_next, ERROR_HANDLER_RESULT perrorcall, $error_selected_roots(perrorcall.TARGET))
  -- if pdestructioncleanup.SOURCE = ERROR_HANDLER_RESULT perrorcall
  -- if S_next = S[.TODO = (UPDATE_WARNING_CALLBACK_EXIT pdestructioncleanup z 1) :: ptask_tail*][.DESTRUCTION.CLEANUPS = pdestructioncleanup :: S.DESTRUCTION.CLEANUPS][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
rule PhpStep/update-callback-exit-selected: S ~> $update_callback_selected_release(S, pdestructioncleanup, z, ptask_tail*)
  -- if S.TODO = (UPDATE_WARNING_CALLBACK_EXIT pdestructioncleanup z 0) :: ptask_tail*
  -- if $update_callback_exit_valid(S, pdestructioncleanup, z, 0)
;; Existing eager operations move the genuine search into PENDING, then return
;; it ahead of the next phase. The callback certificate owns no Throwable.
def $update_callback_selected_pending(S, pdestructioncleanup, z, n, ptask_tail*) = $eager_operation_begin(S_next, S_next, ERROR_HANDLER_RESULT perrorcall, $error_selected_roots(perrorcall.TARGET))
  -- if pdestructioncleanup.SOURCE = ERROR_HANDLER_RESULT perrorcall
  -- if S_next = S[.TODO = (THROW_SEARCH n) :: (UPDATE_WARNING_CALLBACK_EXIT pdestructioncleanup z 1) :: ptask_tail*][.DESTRUCTION.CLEANUPS = pdestructioncleanup :: S.DESTRUCTION.CLEANUPS][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
rule PhpStep/update-callback-exit-selected-pending: S ~> $update_callback_selected_pending(S, pdestructioncleanup, z, n, ptask_tail*)
  -- if S.TODO = (THROW_SEARCH n) :: (UPDATE_WARNING_CALLBACK_EXIT pdestructioncleanup z 0) :: ptask_tail*
  -- if $update_callback_exit_valid(S, pdestructioncleanup, z, 0) /\ $throwable_live(S, n)
def $update_callback_raw_release(S, pdestructioncleanup, z, ptask_tail*) = $eager_operation_begin(S_next, S_next, ERROR_HANDLER_CLEAN perrorcall, $value_nodes(perrorcall.CALLBACK))
  -- if pdestructioncleanup.SOURCE = ERROR_HANDLER_RESULT perrorcall
  -- if S.DESTRUCTION.CLEANUPS = pdestructioncleanup :: pdestructioncleanup_tail*
  -- if pdestructioncleanup_done = pdestructioncleanup[.RELEASED = true]
  -- if S_next = $error_handler_restore(S[.TODO = (UPDATE_WARNING_CALLBACK_EXIT pdestructioncleanup_done z 2) :: ptask_tail*][.DESTRUCTION.CLEANUPS = pdestructioncleanup_done :: pdestructioncleanup_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], perrorcall.CALLBACK)
rule PhpStep/update-callback-exit-raw: S ~> $update_callback_raw_release(S, pdestructioncleanup, z, ptask_tail*)
  -- if S.TODO = (UPDATE_WARNING_CALLBACK_EXIT pdestructioncleanup z 1) :: ptask_tail*
  -- if $update_callback_exit_valid(S, pdestructioncleanup, z, 1)
def $update_callback_raw_pending(S, pdestructioncleanup, z, n, ptask_tail*) = $eager_operation_begin(S_next, S_next, ERROR_HANDLER_CLEAN perrorcall, $value_nodes(perrorcall.CALLBACK))
  -- if pdestructioncleanup.SOURCE = ERROR_HANDLER_RESULT perrorcall
  -- if S.DESTRUCTION.CLEANUPS = pdestructioncleanup :: pdestructioncleanup_tail*
  -- if pdestructioncleanup_done = pdestructioncleanup[.RELEASED = true]
  -- if S_next = $error_handler_restore(S[.TODO = (THROW_SEARCH n) :: (UPDATE_WARNING_CALLBACK_EXIT pdestructioncleanup_done z 2) :: ptask_tail*][.DESTRUCTION.CLEANUPS = pdestructioncleanup_done :: pdestructioncleanup_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], perrorcall.CALLBACK)
rule PhpStep/update-callback-exit-raw-pending: S ~> $update_callback_raw_pending(S, pdestructioncleanup, z, n, ptask_tail*)
  -- if S.TODO = (THROW_SEARCH n) :: (UPDATE_WARNING_CALLBACK_EXIT pdestructioncleanup z 1) :: ptask_tail*
  -- if $update_callback_exit_valid(S, pdestructioncleanup, z, 1) /\ $throwable_live(S, n)
rule PhpStep/update-callback-exit-finish-string: S ~> $exit_start_unwind(S[.TODO = ptask_tail*], z)
  -- if S.TODO = (UPDATE_WARNING_CALLBACK_EXIT pdestructioncleanup z 2) :: ptask_tail*
  -- if $update_callback_exit_valid(S, pdestructioncleanup, z, 2)
  -- if pdestructioncleanup.SOURCE = ERROR_HANDLER_RESULT perrorcall
  -- if perrorcall.RESUME = UPDATE_WARNING_RESTORE pupdatewarning
  -- if ~$update_warning_restores_throw(pupdatewarning.INPUT) /\ $update_exit_order_supported(S)
rule PhpStep/update-callback-exit-finish-restore: S ~> $exit_start_unwind($update_warning_store(S[.TODO = ptask_tail*], pupdatewarning.POINTER, pvalue), z)
  -- if S.TODO = (UPDATE_WARNING_CALLBACK_EXIT pdestructioncleanup z 2) :: ptask_tail*
  -- if $update_callback_exit_valid(S, pdestructioncleanup, z, 2)
  -- if pdestructioncleanup.SOURCE = ERROR_HANDLER_RESULT perrorcall
  -- if perrorcall.RESUME = UPDATE_WARNING_RESTORE pupdatewarning
  -- if $update_warning_restores_throw(pupdatewarning.INPUT)
  -- if $update_warning_pointer_value(S, pupdatewarning.POINTER) = (pslot)
  -- if $update_warning_release_safe(S, pslot) /\ $update_exit_order_supported(S)
  -- if $update_warning_after(pupdatewarning.OP, pupdatewarning.INPUT) = (pvalue)
rule PhpStep/update-callback-exit-finish-unsafe: S ~> S[.COMPLETION = UNSUPPORTED "increment/decrement warning exit continuation"]
  -- if S.TODO = (UPDATE_WARNING_CALLBACK_EXIT pdestructioncleanup z 2) :: ptask_tail*
  -- if $update_callback_exit_valid(S, pdestructioncleanup, z, 2)
  -- if pdestructioncleanup.SOURCE = ERROR_HANDLER_RESULT perrorcall
  -- if ~$update_warning_exit_cancel_safe(S, perrorcall)
rule PhpStep/update-callback-exit-cleanup-order: S ~> S[.COMPLETION = UNSUPPORTED "increment/decrement warning exit temporary cleanup order"]
  -- if S.TODO = (UPDATE_WARNING_CALLBACK_EXIT pdestructioncleanup z 2) :: ptask_tail*
  -- if $update_callback_exit_valid(S, pdestructioncleanup, z, 2)
  -- if pdestructioncleanup.SOURCE = ERROR_HANDLER_RESULT perrorcall
  -- if $update_warning_exit_cancel_safe(S, perrorcall) /\ ~$update_exit_order_supported(S)
rule PhpStep/update-callback-exit-throw-string: S ~> S[.TODO = (UPDATE_WARNING_DONE pupdatewarning[.PENDING = (n)]) :: ptask_tail*]
  -- if S.TODO = (THROW_SEARCH n) :: (UPDATE_WARNING_CALLBACK_EXIT pdestructioncleanup z 2) :: ptask_tail*
  -- if $update_callback_exit_valid(S, pdestructioncleanup, z, 2) /\ $throwable_live(S, n)
  -- if pdestructioncleanup.SOURCE = ERROR_HANDLER_RESULT perrorcall
  -- if perrorcall.RESUME = UPDATE_WARNING_RESTORE pupdatewarning
  -- if ~$update_warning_restores_throw(pupdatewarning.INPUT)
rule PhpStep/update-callback-exit-throw-restore: S ~> $update_warning_store(S[.TODO = (UPDATE_WARNING_DONE pupdatewarning[.PENDING = (n)]) :: ptask_tail*], pupdatewarning.POINTER, pvalue)
  -- if S.TODO = (THROW_SEARCH n) :: (UPDATE_WARNING_CALLBACK_EXIT pdestructioncleanup z 2) :: ptask_tail*
  -- if $update_callback_exit_valid(S, pdestructioncleanup, z, 2) /\ $throwable_live(S, n)
  -- if pdestructioncleanup.SOURCE = ERROR_HANDLER_RESULT perrorcall
  -- if perrorcall.RESUME = UPDATE_WARNING_RESTORE pupdatewarning
  -- if $update_warning_restores_throw(pupdatewarning.INPUT)
  -- if $update_warning_pointer_value(S, pupdatewarning.POINTER) = (pslot)
  -- if $update_warning_release_safe(S, pslot)
  -- if $update_warning_after(pupdatewarning.OP, pupdatewarning.INPUT) = (pvalue)
rule PhpStep/update-callback-exit-throw-unsafe: S ~> S[.COMPLETION = UNSUPPORTED "increment/decrement warning exit cleanup throw"]
  -- if S.TODO = (THROW_SEARCH n) :: (UPDATE_WARNING_CALLBACK_EXIT pdestructioncleanup z 2) :: ptask_tail*
  -- if $update_callback_exit_valid(S, pdestructioncleanup, z, 2) /\ $throwable_live(S, n)
  -- if pdestructioncleanup.SOURCE = ERROR_HANDLER_RESULT perrorcall
  -- if ~$update_warning_exit_cancel_safe(S, perrorcall)
def $update_exit_control_call(S) = ((perrorcall, z, ptask_tail*))
  -- if S.TODO = (UPDATE_WARNING_EXIT perrorcall z) :: ptask_tail*
  -- if $call_task_valid(S, UPDATE_WARNING_EXIT perrorcall z)
def $update_exit_control_call(S) = ((perrorcall, z, ptask_tail*))
  -- if S.TODO = (UPDATE_WARNING_CALLBACK_EXIT pdestructioncleanup z 2) :: ptask_tail*
  -- if $update_callback_exit_valid(S, pdestructioncleanup, z, 2)
  -- if pdestructioncleanup.SOURCE = ERROR_HANDLER_RESULT perrorcall
def $update_exit_control_call(S) = eps -- otherwise

;; Exit retires operands and pending finally outcomes before parent cleanup.
;; Recover only the ordered caller control from source; no released value is
;; retained by this history or restored when a destructor cancels exit.
dec $update_exit_history_find(pstate, porigin, ptask*, porigin?) : pgototasks
dec $update_exit_history_open(pstate, porigin, statement, porigin, ptask*, porigin?) : pgototasks
dec $update_exit_history_catch(pstate, porigin, phpType66*, porigin, ptask*, porigin?, nat) : pgototasks
dec $update_exit_history(pstate, porigin) : pgototasks
def $update_exit_history(S, porigin) = $update_exit_history_find(S, porigin, ptask_base*, $goto_callable_origin(S))
  -- if $goto_base(S, porigin) = GOTOTASKS ptask_base*
def $update_exit_history(S, porigin) = GOTOMISSING -- otherwise
def $update_exit_history_find(S, porigin, eps, porigin_outer?) = GOTOMISSING
def $update_exit_history_find(S, PORIGIN n pcpath_site, (AT (PORIGIN n pcpath) (STMT statement)) :: ptask_tail*, porigin_outer?) = $update_exit_history_open(S, PORIGIN n pcpath_site, statement, PORIGIN n pcpath, ptask_tail*, porigin_outer?)
  -- if $effect_below(pcpath, pcpath_site)
def $update_exit_history_find(S, porigin, ptask :: ptask_tail*, porigin_outer?) = $update_exit_history_find(S, porigin, ptask_tail*, porigin_outer?)
  -- if ~$goto_task_contains(ptask, porigin)
def $update_exit_history_open(S, porigin_site, NStmtExpression expression metadata, porigin, ptask_tail*, porigin_outer?) = GOTOTASKS ((ORIGIN_RETURN porigin_outer?) :: ptask_tail*)
def $update_exit_history_open(S, porigin_site, NStmtBlock (SEQUENCE statement*) metadata, porigin, ptask_tail*, porigin_outer?) = $update_exit_history_find(S, porigin_site, $statement_tasks(statement*, $origin_child((porigin), [PCFIELD 0]), 0) ++ [ORIGIN_RETURN porigin_outer?] ++ ptask_tail*, (porigin))
def $update_exit_history_open(S, PORIGIN n pcpath_site, NStmtTryCatch (SEQUENCE statement*) phpType65 phpType67 metadata, PORIGIN n pcpath, ptask_tail*, porigin_outer?) = $update_exit_history_find(S, PORIGIN n pcpath_site, $statement_tasks(statement*, (PORIGIN n (pcpath ++ [PCFIELD 0])), 0) ++ [TRY_END (PORIGIN n pcpath), ORIGIN_RETURN porigin_outer?] ++ ptask_tail*, (PORIGIN n pcpath))
  -- if $effect_below(pcpath ++ [PCFIELD 0], pcpath_site)
def $update_exit_history_open(S, PORIGIN n pcpath_site, NStmtTryCatch phpType23 (SEQUENCE phpType66*) phpType67 metadata, PORIGIN n pcpath, ptask_tail*, porigin_outer?) = $update_exit_history_catch(S, PORIGIN n pcpath_site, phpType66*, PORIGIN n pcpath, ptask_tail*, porigin_outer?, 0)
  -- if $effect_below(pcpath ++ [PCFIELD 1], pcpath_site)
def $update_exit_history_open(S, PORIGIN n pcpath_site, NStmtTryCatch phpType23 phpType65 (NStmtFinally (SEQUENCE statement*) metadata_final) metadata, PORIGIN n pcpath, ptask_tail*, porigin_outer?) = $update_exit_history_find(S, PORIGIN n pcpath_site, $statement_tasks(statement*, (PORIGIN n (pcpath ++ [PCFIELD 2, PCFIELD 0])), 0) ++ [FINALLY_RESUME (PORIGIN n pcpath) eps, FINALLY_PHASE (PORIGIN n pcpath) 0, ORIGIN_RETURN porigin_outer?] ++ ptask_tail*, (PORIGIN n (pcpath ++ [PCFIELD 2])))
  -- if $effect_below(pcpath ++ [PCFIELD 2], pcpath_site)
def $update_exit_history_open(S, porigin_site, statement, porigin, ptask_tail*, porigin_outer?) = GOTOMISSING -- otherwise
def $update_exit_history_catch(S, porigin_site, eps, porigin, ptask_tail*, porigin_outer?, n_index) = GOTOMISSING
def $update_exit_history_catch(S, PORIGIN n pcpath_site, (NStmtCatch phpType42 phpType43 (SEQUENCE statement*) metadata) :: phpType66_tail*, PORIGIN n pcpath, ptask_tail*, porigin_outer?, n_index) = $update_exit_history_find(S, PORIGIN n pcpath_site, $statement_tasks(statement*, (PORIGIN n (pcpath ++ [PCFIELD 1, PCINDEX n_index, PCFIELD 2])), 0) ++ $finally_catch_tail(S, PORIGIN n pcpath, (ORIGIN_RETURN porigin_outer?) :: ptask_tail*), (PORIGIN n (pcpath ++ [PCFIELD 1, PCINDEX n_index])))
  -- if $effect_below(pcpath ++ [PCFIELD 1, PCINDEX n_index, PCFIELD 2], pcpath_site)
def $update_exit_history_catch(S, PORIGIN n pcpath_site, phpType66 :: phpType66_tail*, PORIGIN n pcpath, ptask_tail*, porigin_outer?, n_index) = $update_exit_history_catch(S, PORIGIN n pcpath_site, phpType66_tail*, PORIGIN n pcpath, ptask_tail*, porigin_outer?, $(n_index + 1))
  -- if ~$effect_below(pcpath ++ [PCFIELD 1, PCINDEX n_index, PCFIELD 2], pcpath_site)

;; Zend cleanup_live_vars visits increasing live-range starts. The pending
;; fast_call outcome retires first; outer binary holders precede inner ones.
;; Each operand's own node group and container child order stay unchanged.
syntax pupdateexitorder = UPDATE_EXIT_ORDER pnode* | UPDATE_EXIT_UNORDERED
dec $update_exit_finally_pair(ptask*) : bool
def $update_exit_finally_pair((FINALLY_RESUME porigin n?) :: (FINALLY_PHASE porigin n_phase) :: ptask*) = true
def $update_exit_finally_pair(ptask*) = false -- otherwise
dec $update_exit_control(pstate, ptask*, ptask*) : bool
def $update_exit_control(S, eps, eps) = true
def $update_exit_control(S, (FINALLY_RESUME porigin n?) :: (FINALLY_PHASE porigin n_phase) :: ptask_old*, (FINALLY_RESUME porigin eps) :: (FINALLY_PHASE porigin 0) :: ptask_history*) = ($destructor_pending_valid(S, n?) /\ n_phase = $finally_outcome_phase(n?) /\ $update_exit_control(S, ptask_old*, ptask_history*))
def $update_exit_control(S, ptask :: ptask_old*, ptask :: ptask_history*) = $update_exit_control(S, ptask_old*, ptask_history*)
  -- if ~$update_exit_finally_pair(ptask :: ptask_old*)
def $update_exit_control(S, ptask_old*, ptask_history*) = false -- otherwise
dec $update_exit_inputs(pstate, porigin, ptask*, ptask*) : pupdateexitorder
def $update_exit_inputs(S, porigin_child, (ORIGIN_RETURN (porigin)) :: (BINARY_RIGHT pbin poperand z) :: ptask_tail*, ptask_history*) = UPDATE_EXIT_ORDER (pnode_outer* ++ $operand_nodes(poperand))
  -- if $origin_child((porigin), [PCFIELD 1]) = (porigin_child)
  -- if $origin_node(S.SOURCES, porigin) = (expression)
  -- if $error_binary_source(expression) = (pbin)
  -- if $code_expression_at_source(S, porigin, [PCFIELD 1]) = (z)
  -- if $integer_operand_source(S, porigin, [PCFIELD 0], poperand)
  -- if $update_exit_inputs(S, porigin, ptask_tail*, ptask_history*) = UPDATE_EXIT_ORDER pnode_outer*
def $update_exit_inputs(S, porigin_child, (ORIGIN_RETURN (porigin)) :: (WRITE_NAME n_name* z) :: ptask_tail*, ptask_history*) = $update_exit_inputs(S, porigin, ptask_tail*, ptask_history*)
  -- if $origin_child((porigin), [PCFIELD 1]) = (porigin_child)
  -- if $origin_node(S.SOURCES, porigin) = (NExprAssign (NExprVariable phpType32 metadata_cv) expression metadata)
  -- if $cv_source_name(S, phpType32) = (n_name*)
  -- if $variable_line(phpType32, metadata_cv) = z
def $update_exit_inputs(S, porigin_child, (ORIGIN_RETURN (porigin)) :: DISCARD :: ptask_tail*, ptask_history*) = UPDATE_EXIT_ORDER $tasks_nodes(ptask_tail*)
  -- if $origin_child((porigin), [PCFIELD 0]) = (porigin_child)
  -- if $origin_node(S.SOURCES, porigin) = (NStmtExpression expression metadata)
  -- if $update_exit_control(S, ptask_tail*, ptask_history*)
def $update_exit_inputs(S, porigin, ptask_tail*, ptask_history*) = UPDATE_EXIT_UNORDERED -- otherwise
dec $update_exit_order(pstate) : pupdateexitorder
def $update_exit_order(S) = UPDATE_EXIT_ORDER eps
  -- if $update_exit_control_call(S) = ((perrorcall, z, ptask_tail*))
  -- if S.HELD = eps /\ $tasks_nodes(ptask_tail*) = eps
def $update_exit_order(S) = $update_exit_inputs(S, perrorcall.SITE, ptask_tail*, ptask_history*)
  -- if $update_exit_control_call(S) = ((perrorcall, z, ptask_tail*))
  -- if S.HELD = eps /\ $tasks_nodes(ptask_tail*) =/= eps
  -- if S.ORIGIN = (perrorcall.SITE)
  -- if $update_exit_history(S, perrorcall.SITE) = GOTOTASKS ptask_history*
  -- if $tasks_nodes(ptask_history*) = eps
def $update_exit_order(S) = UPDATE_EXIT_UNORDERED -- otherwise
def $update_exit_order_supported(S) = ($update_exit_order(S) =/= UPDATE_EXIT_UNORDERED)
def $update_exit_owner_reordered(S) = true
  -- if $update_exit_control_call(S) = ((perrorcall, z, ptask_tail*))
  -- if $update_exit_order(S) = UPDATE_EXIT_ORDER pnode*
  -- if pnode* =/= $tasks_nodes(ptask_tail*)
def $eager_owner_order(S) = $eager_edge_nodes($heap_graph(S).EDGES) ++ $eager_task_inputs(S, ptask) ++ $operand_nodes(S.RESULT) ++ $eager_base_inputs(S, ptask) ++ $machine_roots(S[.TODO = eps][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)][.HELD = pnode* ++ S.HELD])
  -- if S.TODO = ptask :: ptask_tail*
  -- if $update_exit_owner_reordered(S)
  -- if $update_exit_order(S) = UPDATE_EXIT_ORDER pnode*
def $eager_operation_source(S, UPDATE_WARNING_EXIT perrorcall z) = UPDATE_WARNING_EXIT_HISTORY perrorcall z ptask_history*
  -- if $call_task_valid(S, UPDATE_WARNING_EXIT perrorcall z)
  -- if $update_exit_history(S, perrorcall.SITE) = GOTOTASKS ptask_history*
  -- if $tasks_nodes(ptask_history*) = eps
def $task_nodes(UPDATE_WARNING_EXIT_HISTORY perrorcall z ptask_history*) = eps
def $eager_operation_source(S, UPDATE_WARNING_CALLBACK_EXIT pdestructioncleanup z 2) = UPDATE_WARNING_CALLBACK_HISTORY pdestructioncleanup z ptask_history*
  -- if $update_callback_exit_valid(S, pdestructioncleanup, z, 2)
  -- if pdestructioncleanup.SOURCE = ERROR_HANDLER_RESULT perrorcall
  -- if $update_exit_history(S, perrorcall.SITE) = GOTOTASKS ptask_history*
  -- if $tasks_nodes(ptask_history*) = eps
def $task_nodes(UPDATE_WARNING_CALLBACK_HISTORY pdestructioncleanup z ptask_history*) = eps
dec $update_exit_history_source_valid(pstate, pdestructionoperation) : bool
def $update_exit_history_source_valid(S, pdestructionoperation) = true
  -- if pdestructionoperation.SOURCE = UPDATE_WARNING_EXIT_HISTORY perrorcall z ptask_history*
  -- if S_caller = S[.CURRENT = pdestructionoperation.CALLER][.ORIGIN = (perrorcall.SITE)][.CONSTCONTEXT = pdestructionoperation.CONSTCONTEXT]
  -- if $update_warning_exit_named(S_caller, perrorcall) /\ z = $ntprecision32(z)
