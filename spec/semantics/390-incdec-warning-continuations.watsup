def $update_released_isset(S, BASE_VALUE (VARIABLE ptbytes z_name), false, z) = $update_released_array_name(S, ptbytes)
def $update_released_isset(S, pbase, b, z) = false -- otherwise
def $isset_simple(S, BASE_GLOBAL poperand z_name, false, z) = S_name[.RESULT = KNOWN (PBOOL true)]
  -- if S_name = $resolve_name(S, poperand, z_name)
  -- if S_name.COMPLETION = NORMAL
  -- if S_name.RESULT = KNOWN (PSTRING ptbytes)
  -- if $update_released_array_name($global_table_view(S_name), ptbytes)
def $isset_simple(S, BASE_VALUE (VARIABLE ptbytes z_name), false, z) = S[.RESULT = KNOWN (PBOOL true)]
  -- if $update_released_array_name(S, ptbytes)
def $update_released_key_isset(S, KNOWN (PSTRING ptbytes), ptbytes, z, KEY_TEST false) = true
