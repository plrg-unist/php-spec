  -- if pdestructionoperation.SOURCE = UPDATE_WARNING_CALLBACK_HISTORY pdestructioncleanup z ptask_history*
def $update_warning_exit_parent_call(pdestructorcall) = false -- otherwise
def $eager_operation_source_guard(S, pdestructionoperation) = ($update_warning_exit_named(S[.CURRENT = pdestructionoperation.CALLER][.ORIGIN = (perrorcall.SITE)][.CONSTCONTEXT = pdestructionoperation.CONSTCONTEXT], perrorcall) /\ z = $ntprecision32(z))
  -- if pdestructionoperation.SOURCE = UPDATE_WARNING_EXIT perrorcall z
;; Tail validation has already consumed the borrowed destructor registries.
;; Authenticate their copied exit metadata without requiring those roots again.
dec $update_warning_exit_parent_operation(pstate, pdestructionoperation?, int) : bool
def $update_warning_exit_parent_operation(S, (pdestructionoperation), z) = true
  -- if pdestructionoperation.SOURCE = UPDATE_WARNING_EXIT perrorcall z
