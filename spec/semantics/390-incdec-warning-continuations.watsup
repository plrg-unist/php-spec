;; Unsupported control forms retain the earlier explicit boundary. Both tags
;; still describe USER cleanup; neither turns exit into a Throwable.
def $update_warning_exit_parent_call(pdestructorcall) = true
  -- if pdestructorcall.OPERATION = (pdestructionoperation)
  -- if pdestructionoperation.SOURCE = UPDATE_WARNING_EXIT perrorcall z
def $update_warning_exit_parent_call(pdestructorcall) = true
  -- if pdestructorcall.OPERATION = (pdestructionoperation)
  -- if pdestructionoperation.SOURCE = UPDATE_WARNING_EXIT_HISTORY perrorcall z ptask_history*
def $update_warning_exit_parent_call(pdestructorcall) = true
