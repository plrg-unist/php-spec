  -- if ~((HARRAY n_array) <- S.ALLOCATIONS)
  -- if $update_released_cell(S, n)
def $update_released_array_cell(S, n) = false -- otherwise
def $update_released_array_name(S, ptbytes) = $update_released_array_cell(S, n) -- if $lookup(S.ENV, ptbytes) = (n)
def $update_released_array_name(S, ptbytes) = false -- otherwise
def $read_name(S, ptbytes, z) = S[.COMPLETION = UNSUPPORTED "increment/decrement released array payload read"]
  -- if ~$environment_blocked(S, ptbytes)
  -- if $update_released_array_name(S, ptbytes)
def $global_read_local(S, ptbytes, z) = S[.COMPLETION = UNSUPPORTED "increment/decrement released array payload read"]
  -- if ~$environment_blocked(S, ptbytes) /\ ~$this_name(ptbytes)
