def $update_raw_array_source(S, porigin) = false -- otherwise
def $update_raw_scalar(NScalarInt phpType24 metadata) = true
def $update_raw_scalar(NScalarFloat phpType41 metadata) = true
def $update_raw_scalar(NScalarString phpType33 metadata) = true
def $update_raw_scalar(NExprConstFetch (NName (BYTES text) metadata_name) metadata) = ($special_constant($base64(text)) =/= eps)
