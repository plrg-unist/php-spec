def $update_released_isset(S, BASE_VALUE (VARIABLE ptbytes z_name), false, z) = $update_released_array_name(S, ptbytes)
def $update_released_isset(S, pbase, b, z) = false -- otherwise
def $isset_simple(S, BASE_GLOBAL poperand z_name, false, z) = S_name[.RESULT = KNOWN (PBOOL true)]
