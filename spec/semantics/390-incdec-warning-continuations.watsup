def $update_released_key_isset(S, poperand, ptbytes, z, pkeymode) = false -- otherwise
def $key_global_lookup(S, poperand, ptbytes, z, KEY_TEST false) = $key_read_done(S, PBOOL true)
  -- if $update_released_key_isset(S, poperand, ptbytes, z, KEY_TEST false)
def $update_raw_array_source(S, porigin) = true
  -- if $origin_node(S.SOURCES, porigin) = (NExprVariable (BYTES text) metadata)
