def $task_nodes(PROPERTY_PUBLIC_NAN ppropertypublicnan) = eps
def $call_task_valid(S, PROPERTY_PUBLIC_NAN ppropertypublicnan) = $property_public_nan_valid(S, ppropertypublicnan)
