rule PhpStep/property-public-nan-warning: S ~> $error_dispatch(S[.TODO = (PROPERTY_PUBLIC_NAN ppropertypublicnan) :: ppropertypublicnan.TAIL][.RESULT = KNOWN PNULL], 2, $ptascii("unexpected NAN value was coerced to bool"), ppropertypublicnan.READ.LINE, DIAGNOSTIC "Warning" ($ptascii("unexpected NAN value was coerced to bool")) ppropertypublicnan.READ.LINE, PROPERTY_PUBLIC_NAN ppropertypublicnan)
  -- if $property_public_nan_plan(S) = (ppropertypublicnan)
rule PhpStep/property-public-nan-result: S ~> S[.TODO = ppropertypublicnan.TAIL][.RESULT = KNOWN (PBOOL (~b))]
