def $static_compound_write_seen(pclassconstantevent :: pclassconstantevent_tail*, prefcoercion) = ($static_compound_write_event(pclassconstantevent, prefcoercion) \/ $static_compound_write_seen(pclassconstantevent_tail*, prefcoercion))
