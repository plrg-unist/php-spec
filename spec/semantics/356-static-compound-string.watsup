def $static_compound_unchecked(S, pstaticcompound, porigin, z, ptbytes) = S_written[.CLASSCONSTANTHISTORY = S_written.CLASSCONSTANTHISTORY ++ [CCCOMPOUNDWRITE pstaticcompound porigin z ptbytes (|S.DECLARATIONS|)]]
