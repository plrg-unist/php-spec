def $propref_descriptor(S, COMPOUND_CLASS_PROP_SOURCE ppropertyid n_event) = $class_static_active_desc(S, S.CLASSNAMES, ppropertyid)
def $propref_source_same(COMPOUND_CLASS_PROP_SOURCE ppropertyid n_event, CLASS_PROP_SOURCE ppropertyid_target) = (ppropertyid = ppropertyid_target)
def $propref_removal_finish(pproptypesource*, CLASS_PROP_SOURCE ppropertyid, COMPOUND_CLASS_PROP_SOURCE ppropertyid n_event) = $propref_replace(pproptypesource*, CLASS_PROP_SOURCE ppropertyid, COMPOUND_CLASS_PROP_SOURCE ppropertyid n_event)

