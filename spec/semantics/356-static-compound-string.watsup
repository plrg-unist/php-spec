;; A plain slot releases a reference installed during conversion without the
;; ordinary type-source removal. Bind its retained constraint to that event.
def $static_compound_retire_sources(eps, n, ppropertyid, n_event) = eps
def $static_compound_retire_sources(ppropref :: ppropref_tail*, n, ppropertyid, n_event) = ppropref[.SOURCES = $propref_replace(ppropref.SOURCES, CLASS_PROP_SOURCE ppropertyid, COMPOUND_CLASS_PROP_SOURCE ppropertyid n_event)] :: ppropref_tail*
  -- if ppropref.CELL = n
def $static_compound_retire_sources(ppropref :: ppropref_tail*, n, ppropertyid, n_event) = ppropref :: $static_compound_retire_sources(ppropref_tail*, n, ppropertyid, n_event)
  -- if ppropref.CELL =/= n
def $static_compound_retire(S, pstaticcompound, porigin, z) = S[.PROPREFS = $static_compound_retire_sources(S.PROPREFS, n, pstaticcompound.DECL, |S.CLASSCONSTANTHISTORY|)][.CLASSCONSTANTHISTORY = S.CLASSCONSTANTHISTORY ++ [CCCOMPOUNDRETIRE pstaticcompound n porigin z (|S.DECLARATIONS|)]]
  -- if pstaticcompound.CELL = eps
  -- if $static_compound_writer(S, pstaticcompound, porigin) = (pcompoundstring)
  -- if pcompoundstring.LINE = z
  -- if $class_static_at(S.CLASSSTATICS, pstaticcompound.DECL) = (pclassstatic)
  -- if pclassstatic.STATE = PROP_VALUE (ALIAS n)
  -- if $propref_source_present(S.PROPREFS, n, CLASS_PROP_SOURCE pstaticcompound.DECL)
  -- if $propref_source_valid(S, n, CLASS_PROP_SOURCE pstaticcompound.DECL)
def $static_compound_retire(S, pstaticcompound, porigin, z) = S -- otherwise
def $static_compound_retirement_event(CCCOMPOUNDRETIRE pstaticcompound n porigin z n_prefix, ppropertyid, n) = (pstaticcompound.DECL = ppropertyid)
def $static_compound_retirement_event(pclassconstantevent, ppropertyid, n) = false -- otherwise
