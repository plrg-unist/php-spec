def $static_compound_write_event(CCCOMPOUNDWRITE pstaticcompound porigin z ptbytes n_prefix, prefcoercion) = (pstaticcompound.CELL = (prefcoercion.CELL) /\ porigin = prefcoercion.SITE /\ z = prefcoercion.LINE /\ ptbytes = prefcoercion.VALUE /\ ~pstaticcompound.VERIFY)
