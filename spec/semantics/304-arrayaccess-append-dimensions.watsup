;; [] is an append operation on a returned array, but a null offset for an
;; ArrayAccess callback. Keep that distinction through delayed W/RW fetches.
dec $key_write_append_source(pstate, porigin, int) : bool
dec $key_write_append_task_valid(pstate, int, bool) : bool
dec $key_write_append_place_valid(pstate, plocation) : bool
dec $access_append_record(pstate, int, bool) : paccess
dec $key_write_append_dimension(pstate, int, bool) : pstate
dec $key_append_pending_view(pstate) : pstate
dec $key_append_pending_conversion(pstate, pbin, pvalue, int) : pstate?
dec $key_append_pending_binary(pstate, pbin, pvalue, int) : pstate
dec $key_append_pending_finish(pstate, pstate, pbin, pvalue) : pstate

;; Appending never quietly selects an existing row during ingress probing.
def $access_has_append(BASE_APPEND pbase z) = true
def $access_has_append(BASE_DIM pbase poperand z) = $access_has_append(pbase)
def $access_has_append(pbase) = false -- otherwise

def $key_write_target_base(BASE_APPEND pbase z) = true
def $key_write_captured_base(BASE_APPEND pbase z) = $key_write_captured_base(pbase)
def $key_write_global_root(BASE_APPEND pbase z) = $key_write_global_root(pbase)
def $key_write_root(S, BASE_APPEND pbase z) = $key_write_root(S, pbase)
def $container_write_root(S, BASE_APPEND pbase z) = $container_write_root(S, pbase)
def $key_tail_chain(BASE_APPEND pbase z) = $key_tail_chain(pbase)
def $key_write_aborted_base(BASE_APPEND pbase z, porigin) = $key_write_aborted_base(pbase, porigin)
def $key_write_has_aborted_base(BASE_APPEND pbase z) = $key_write_has_aborted_base(pbase)
def $key_write_append_source(S, porigin, z) = true
  -- if $origin_node(S.SOURCES, porigin) = (NExprArrayDimFetch expression ABSENT metadata)
  -- if ~$ppglobals_base(expression)
  -- if $code_expression_at_source(S, porigin, [PCFIELD 0]) = (z)
def $key_write_append_source(S, porigin, z) = false -- otherwise
def $key_write_base_source(S, porigin, BASE_APPEND pbase z) = true
  -- if $key_write_append_source(S, porigin, z)
  -- if $origin_child((porigin), [PCFIELD 0]) = (porigin_base)
  -- if $key_write_base_source(S, porigin_base, pbase)

def $access_cut_base(BASE_APPEND pbase z, porigin_root, porigin, pbase_new) = BASE_APPEND $access_cut_base(pbase, porigin_child, porigin, pbase_new) z
  -- if porigin_root =/= porigin
  -- if $origin_child((porigin_root), [PCFIELD 0]) = (porigin_child)
def $access_parent_cell(BASE_APPEND pbase z, porigin_root, porigin) = $access_parent_cell(pbase, porigin_child, porigin)
  -- if porigin_root =/= porigin
  -- if $origin_child((porigin_root), [PCFIELD 0]) = (porigin_child)
def $key_append_cut(S, porigin_root, BASE_APPEND pbase z, porigin) = BASE_APPEND $key_append_cut(S, porigin_child, pbase, porigin) z
  -- if porigin_root =/= porigin
  -- if $origin_child((porigin_root), [PCFIELD 0]) = (porigin_child)

def $task_nodes(KEY_WRITE_APPEND z b) = eps
def $key_write_append_task_valid(S, z, b) = true
  -- if S.ORIGIN = (porigin)
  -- if $key_write_append_source(S, porigin, z)
  -- if $key_write_context(S, S.TODO, porigin, b)
def $key_write_append_task_valid(S, z, b) = false -- otherwise
def $call_task_valid(S, KEY_WRITE_APPEND z b) = $key_write_append_task_valid(S, z, b)
rule PhpStep/key-write-append-base: S ~> S[.TODO = [$at_task($origin_child(S.ORIGIN, [PCFIELD 0]), KEY_WRITE_BASE pbase b), KEY_WRITE_APPEND z b] ++ ptask_tail*]
  -- if S.TODO = (KEY_WRITE_BASE (BASE_APPEND pbase z) b) :: ptask_tail*

;; The final writer still owns RHS/base operands once; append tasks borrow it.
def $access_write_task(KEY_WRITE_APPEND z b) = true
def $access_append_record(S, z, b) = paccess
  -- if S.ORIGIN = (porigin_target)
  -- if S.TODO = (KEY_WRITE_APPEND z b) :: ptask_tail*
  -- if $container_writer(ptask_tail*) = (pkeywriter)
  -- if $location_slot(S, S.LOCATION) = DEFINED (POBJECT n)
  -- if paccessmode = $access_write_mode(pkeywriter, ptask_tail*, b)
  -- if porigin = $access_write_site(pkeywriter, paccessmode, porigin_target)
  -- if paccess = $access_record(S[.ORIGIN = (porigin)], porigin_target, z, paccessmode, BASE_VALUE (KNOWN PNULL), KNOWN PNULL, pkeywriter.RHS, KEY_WRITE_APPEND z b, (n), true)
rule PhpStep/access-write-append: S ~> $access_key(S, $access_append_record(S, z, b))
  -- if S.TODO = (KEY_WRITE_APPEND z b) :: ptask_tail*
