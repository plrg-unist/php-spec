def $eager_fatal_begin(S, S_next) = S_clean[.DESTRUCTION.PHASE = DESTRUCTION_DONE][.DESTRUCTION.CALLED = $destructor_all(0, |S_clean.OBJECTS|)]
  -- if S_report = $shutdown_freeze(S_next)
