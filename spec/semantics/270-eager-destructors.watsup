  -- if pdestructionfatal = {FRAME $eager_fatal_frame(S), FRAMES S.FRAMES, GLOBAL $eager_fatal_global(S), VALUE S.RESULT, BASE S.BASE, DESTRUCTION S.DESTRUCTION, SHUTDOWN S.SHUTDOWN, ERRORHANDLER S.ERRORHANDLER, ERRORHANDLERS S.ERRORHANDLERS, EXCEPTIONHANDLER S.EXCEPTIONHANDLER, EXCEPTIONHANDLERS S.EXCEPTIONHANDLERS, HANDLERS $eager_fatal_handler_frames(S, $eager_fatal_frame(S) :: S.FRAMES), EVALCONTEXTS S.EVALCONTEXTS, FILECONTEXTS S.FILECONTEXTS, DECLARATIONS S_report.DECLARATIONS, COMPLETION pcompletion, FROZEN S_report.COMPLETION, ERRORORIGIN S_report.ERRORORIGIN, TRACE S_report.TRACE, ERRORTRACE S_report.ERRORFATALTRACE, COMPILESTOP S_report.COMPILESTOP, REPORTING S.REPORTING}
  -- if pdestructioncleanup = {SOURCE DESTRUCTOR_FATAL pdestructionfatal, TARGET $eager_cleanup_target(S, pcalltarget), CALLER S.CURRENT, ORIGIN S.ORIGIN, CONSTCONTEXT S.CONSTCONTEXT, RELEASED false}
  -- if S_clean = $shutdown_clean_frames(S_report[.DESTRUCTION.CALLED = $destructor_all(0, |S_report.OBJECTS|)][.DESTRUCTION.ABANDONED = S_report.DESTRUCTION.ABANDONED ++ [pdestructioncleanup]])
def $shutdown_terminal_clean(S, S_report) = $eager_fatal_clean(S, S_report, S.COMPLETION)
  -- if $eager_fatal_ready(S, S.COMPLETION)
def $eager_fatal_begin(S, S_next) = $shutdown_queue_begin(S_clean, S_report.COMPLETION)
  -- if S_report = $shutdown_freeze(S_next)
  -- if S_clean = $eager_fatal_clean(S, S_report, S_next.COMPLETION)
