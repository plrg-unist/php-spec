def $eager_bailout_error_scope(S) = S -- otherwise
def $eager_bailout_transfer(S, S_next, ptask) = S_clean[.DESTRUCTION.ABANDONED = S_clean.DESTRUCTION.ABANDONED ++ [$eager_cleanup_record(S, ptask)] ++ [$eager_cleanup_record($eager_bailout_error_scope(S), ERROR_HANDLER_RESULT perrorcall)]]
