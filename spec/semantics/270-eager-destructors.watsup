def $eager_fatal_frame(S) = {SILENCES S.SILENCES, LOCALS ($active_table(S)), TODO S.TODO, ORIGIN S.ORIGIN, HELD S.HELD, CONTEXT S.CURRENT, BORROWEDREAD S.BORROWEDREAD, OBJECTCAST S.OBJECTCAST, CONSTCONTEXT S.CONSTCONTEXT}
  -- if S.CURRENT =/= eps
def $eager_fatal_frame(S) = {SILENCES S.SILENCES, LOCALS eps, TODO S.TODO, ORIGIN S.ORIGIN, HELD S.HELD, CONTEXT eps, BORROWEDREAD S.BORROWEDREAD, OBJECTCAST S.OBJECTCAST, CONSTCONTEXT S.CONSTCONTEXT}
