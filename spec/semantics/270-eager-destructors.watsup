rule PhpStep/exception-handler-restore-after-release: S ~> $exception_handler_restore(S[.TODO = ptask*][.DESTRUCTION.CLEANUPS = pdestructioncleanup_tail*][.ORIGIN = pexceptioncall.ORIGIN])
  -- if S.TODO = (EXCEPTION_HANDLER_CLEAN pexceptioncall true) :: ptask*
  -- if $exception_cleanup_valid(S, pexceptioncall, true)
  -- if S.DESTRUCTION.CLEANUPS = pdestructioncleanup :: pdestructioncleanup_tail*
def $call_after_origin(S, EXCEPTION_HANDLER_CLEAN pexceptioncall b) = S[.DESTRUCTION.CLEANUPS = pdestructioncleanup_tail*][.ORIGIN = pexceptioncall.ORIGIN]
  -- if S.DESTRUCTION.CLEANUPS = pdestructioncleanup :: pdestructioncleanup_tail*
  -- if pdestructioncleanup.SOURCE = EXCEPTION_HANDLER_RESULT pexceptioncall

;; zend_error likewise drops its retval while the old raw handler is disabled.
;; Unlike the terminal exception handler, a genuine MAIN caller can catch a throw.
def $error_handler_finish(S, perrorcall) = $eager_operation_begin(S_clean, S_clean, ERROR_HANDLER_RESULT perrorcall, $error_selected_roots(perrorcall.TARGET) ++ $operand_nodes(S.RESULT))
  -- if S.TODO = (ERROR_HANDLER_RESULT perrorcall) :: ptask*
  -- if $destructor_operational(S)
  -- if pdestructioncleanup = $eager_cleanup_record(S, ERROR_HANDLER_RESULT perrorcall)
  -- if S_clean = S[.TODO = (ERROR_HANDLER_CLEAN perrorcall) :: ptask*][.DESTRUCTION.CLEANUPS = pdestructioncleanup :: S.DESTRUCTION.CLEANUPS][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
