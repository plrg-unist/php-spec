def $property_release_partition(ppropertyslot :: ppropertyslot_tail*, b) = $property_slot_nodes([ppropertyslot]) ++ $property_release_partition(ppropertyslot_tail*, b)
  -- if (ppropertyslot.DECL = eps) = b
def $property_release_partition(ppropertyslot :: ppropertyslot_tail*, b) = $property_release_partition(ppropertyslot_tail*, b)
  -- if (ppropertyslot.DECL = eps) =/= b
