def $eager_fatal_reported(S, pcompletion) = false -- otherwise
def $eager_fatal_ready(S, pcompletion) = (($destructor_bailout(pcompletion) \/ $eager_fatal_reported(S, pcompletion)) /\ $eager_fatal_target(S) =/= eps /\ ($frames_roots($eager_fatal_frame(S) :: S.FRAMES) ++ $operand_nodes(S.RESULT) ++ $base_nodes(S.BASE)) =/= eps)
