;; their continuations or creating owners beyond the actual abandoned zvals.
def $eager_bailout_history(S, pdestructorcall) = S[.CURRENT = pdestructorcall.CALLER][.ORIGIN = pdestructorcall.ORIGIN][.CONSTCONTEXT = pdestructorcall.CONSTCONTEXT][.TODO = [DESTRUCTOR_RESULT pdestructorcall]][.DESTRUCTION.PHASE = DESTRUCTION_STORE][.DESTRUCTION.INDEX = $(S.DESTRUCTION.HANDLES[pdestructorcall.OBJECT] + 1)][.DESTRUCTION.CALLS = pdestructorcall :: S.DESTRUCTION.CALLS][.DESTRUCTION.RELEASES = $eager_bailout_release(pdestructorcall.RELEASE) ++ S.DESTRUCTION.RELEASES][.DESTRUCTION.FRAMES = $eager_bailout_frame(pdestructorcall.FRAME) ++ S.DESTRUCTION.FRAMES][.DESTRUCTION.OPERATIONS = $eager_bailout_operation(pdestructorcall.OPERATION) ++ S.DESTRUCTION.OPERATIONS][.DESTRUCTION.CLEANUPS = $eager_bailout_cleanup(pdestructorcall.OPERATION) ++ S.DESTRUCTION.CLEANUPS]
