def $eager_fatal_handler_task(S, ptask) = eps -- otherwise
def $eager_fatal_handler_tasks(S, eps) = eps
def $eager_fatal_handler_tasks(S, ptask :: ptask_tail*) = $eager_fatal_handler_task(S, ptask) ++ $eager_fatal_handler_tasks(S, ptask_tail*)
