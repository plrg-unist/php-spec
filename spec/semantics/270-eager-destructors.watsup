def $eager_bailout_release_nodes(eps) = eps
def $eager_bailout_frame_nodes((pdestructionframe)) = $operand_nodes(pdestructionframe.VALUE)
def $eager_bailout_frame_nodes(eps) = eps
def $eager_bailout_operation_nodes((pdestructionoperation)) = $operand_nodes(pdestructionoperation.VALUE) ++ $base_nodes(pdestructionoperation.BASE)
def $eager_bailout_operation_nodes(eps) = eps

