def $eager_fatal_handler_history(S, pdestructionhandler :: pdestructionhandler_tail*) = $eager_fatal_handler_history($eager_fatal_handler_row(S, pdestructionhandler), pdestructionhandler_tail*)
def $eager_fatal_handler_row(S, pdestructionhandler) = $eager_fatal_cell_history(S[.ARRAYS = $array_replace(S.ARRAYS, n, parray)], pdestructionhandler.CELLS)
