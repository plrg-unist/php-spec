def $eager_fatal_handler_cells(S, (ENTRY pkey UNINITIALIZED) :: pentry_tail*) = $eager_fatal_handler_cells(S, pentry_tail*)
def $eager_fatal_handler_task(S, EXCEPTION_HANDLER_INVOKE pexceptioncall) = [$eager_fatal_handler(S, pexceptioncall.CALLBACK)]
def $eager_fatal_handler_task(S, EXCEPTION_HANDLER_RESULT pexceptioncall) = [$eager_fatal_handler(S, pexceptioncall.CALLBACK)]
