def $destructor_operational(S) = (S.DESTRUCTION.PHASE =/= DESTRUCTION_DONE /\ ($destructor_classes(S.CLASSES) \/ $(S.FIBERSEQ > 1)))
;; A source MAIN expression is a real USER execution boundary despite having no
;; model pcallcontext. Synthetic C sites name methods, not compiled expressions.
def $eager_source_origin(S, (porigin)) = true
  -- if $origin_source(porigin) = PORIGIN n pcpath
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_expression(pcode.EXPRESSIONS, pcpath) =/= eps
def $eager_source_origin(S, porigin?) = false -- otherwise
;; A running Fiber also has an internal execute boundary after its user callback
;; has returned; it grants no lexical class scope or source callsite.
def $destructor_user_source(S) = (S.CURRENT =/= eps \/ S.ACTIVEFIBER =/= eps \/ $eager_source_origin(S, S.ORIGIN))

def $eager_explicit_task(AT porigin ptask) = $eager_explicit_task(ptask)
def $eager_explicit_task(DESTRUCTOR_RELEASE pdestructionrelease) = true
def $eager_explicit_task(DESTRUCTOR_ENTER pdestructorcall) = true
def $eager_explicit_task(DESTRUCTOR_RESULT pdestructorcall) = true
def $eager_explicit_task(DESTRUCTOR_WARNING pdestructorcall) = true
def $eager_explicit_task(DESTRUCTOR_FRAME_EXIT pdestructionframe) = true
def $eager_explicit_task(DESTRUCTOR_OPERATION_EXIT pdestructionoperation) = true
def $eager_explicit_task(DESTRUCTOR_GLOBALS) = true
def $eager_explicit_task(DESTRUCTOR_STORE) = true
def $eager_explicit_task(ptask) = false -- otherwise

def $eager_edge_nodes(eps) = eps
def $eager_edge_nodes((HEDGE pnode_from pnode_to) :: hedge*) = pnode_to :: $eager_edge_nodes(hedge*)
;; Changed cells/slots are decremented before consumed operand temporaries.
;; In particular BINARY_RIGHT owns OP1 in its task and OP2 in RESULT.
def $eager_owner_order(S) = $eager_edge_nodes($heap_graph(S).EDGES) ++ $eager_task_inputs(S, ptask) ++ $operand_nodes(S.RESULT) ++ $eager_base_inputs(S, ptask) ++ $machine_roots(S[.TODO = ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)])
  -- if S.TODO = ptask :: ptask_tail*
;; ASSIGN_OBJ keeps OP_DATA's RHS but the plain CV receiver is borrowed.
;; Its completed BASE cache must not become an extra owner across GC(old slot).
def $eager_cv_property(S) = true
  -- if S.ORIGIN = (porigin)
  -- if $origin_node(S.SOURCES, porigin) = (NExprPropertyFetch (NExprVariable (BYTES text) metadata_cv) phpType20 metadata_property)
def $eager_cv_property(S) = true
  -- if S.ORIGIN = (porigin)
  -- if $origin_node(S.SOURCES, porigin) = (pcnode)
  -- if $eager_assignment_source(pcnode)
  -- if $origin_child((porigin), [PCFIELD 0]) = (porigin_target)
  -- if $origin_node(S.SOURCES, porigin_target) = (NExprPropertyFetch (NExprVariable (BYTES text) metadata_cv) phpType20 metadata_property)
def $eager_cv_property(S) = false -- otherwise
def $eager_assignment_source(NExprAssign expression_target expression_rhs metadata) = true
def $eager_assignment_source(pcnode) = ($key_write_op(pcnode) =/= eps) -- otherwise
def $eager_property_finish_task(ASSIGN_ARRAY pbase z b) = true
def $eager_property_finish_task(UNSET_ARRAY) = true
def $eager_property_finish_task(COMPOUND_APPLY pbin pbase b z) = true
def $eager_property_finish_task(ptask) = false -- otherwise
def $eager_task_inputs(S, ptask) = eps
  -- if $eager_property_finish_task(ptask) /\ $eager_cv_property(S)
def $eager_task_inputs(S, ptask) = $task_nodes(ptask) -- otherwise
def $eager_base_inputs(S, ptask) = eps
  -- if $eager_property_finish_task(ptask) /\ $eager_cv_property(S)
def $eager_base_inputs(S, ptask) = $base_nodes(S.BASE) -- otherwise
;; ASSIGN_OBJ's cache is per opcode and holds only its most recent class.
;; Cold standard writes retain OP_DATA while freeing the old slot; warmed fast
;; TMP writes transfer it into the property before that decrement.
def $eager_property_class(INSTANCE porigin) = true
def $eager_property_class(STDINSTANCE) = true
def $eager_property_class(pobject) = false -- otherwise
def $eager_property_class_valid(S, INSTANCE porigin) = ($class_at(S.CLASSES, porigin) =/= eps)
def $eager_property_class_valid(S, STDINSTANCE) = true
def $eager_property_class_valid(S, pobject) = false -- otherwise
def $eager_property_write(S) = ((porigin, S.OBJECTS[n]))
  -- if S.TODO = (ASSIGN_ARRAY (BASE_PROPERTY (POBJECT n) ptbytes) z b) :: ptask*
  -- if $(n < |S.OBJECTS|)
  -- if $eager_property_class(S.OBJECTS[n])
  -- if S.ORIGIN = (porigin)
  -- if $origin_node(S.SOURCES, porigin) = (NExprAssign (NExprPropertyFetch expression_receiver (NIdentifier (BYTES text) metadata_name) metadata_property) expression_rhs metadata)
def $eager_property_write(S) = eps -- otherwise
def $eager_property_cache_at(eps, porigin) = eps
def $eager_property_cache_at((porigin, pobject) :: (porigin_tail, pobject_tail)*, porigin) = (pobject)
def $eager_property_cache_at((porigin_other, pobject) :: (porigin_tail, pobject_tail)*, porigin) = $eager_property_cache_at((porigin_tail, pobject_tail)*, porigin)
  -- if porigin_other =/= porigin
def $eager_property_cache_set(eps, porigin, pobject) = [(porigin, pobject)]
def $eager_property_cache_set((porigin, pobject_old) :: (porigin_tail, pobject_tail)*, porigin, pobject) = (porigin, pobject) :: (porigin_tail, pobject_tail)*
def $eager_property_cache_set((porigin_other, pobject_old) :: (porigin_tail, pobject_tail)*, porigin, pobject) = (porigin_other, pobject_old) :: $eager_property_cache_set((porigin_tail, pobject_tail)*, porigin, pobject)
  -- if porigin_other =/= porigin
def $eager_property_cache_store(S, S_next) = S_next[.DESTRUCTION.PROPCACHE = $eager_property_cache_set(S_next.DESTRUCTION.PROPCACHE, porigin, pobject)]
  -- if $eager_property_write(S) = ((porigin, pobject))
  -- if ~$destructor_unsupported(S_next.COMPLETION)
def $eager_property_cache_store(S, S_next) = S_next -- otherwise
def $eager_property_warm(S) = true
  -- if $eager_property_write(S) = ((porigin, pobject))
  -- if $eager_property_cache_at(S.DESTRUCTION.PROPCACHE, porigin) = (pobject)
def $eager_property_warm(S) = false -- otherwise
def $eager_property_rhs_cv(S) = true
  -- if S.ORIGIN = (porigin)
  -- if $origin_node(S.SOURCES, porigin) = (NExprAssign expression_target (NExprVariable (BYTES text) metadata_rhs) metadata)
def $eager_property_rhs_cv(S) = false -- otherwise
def $eager_property_unused(S, S_next) = true
  -- if $eager_property_write(S) =/= eps
  -- if S_next.COMPLETION = NORMAL
  -- if $destructor_return_discarded(S_next.TODO)
def $eager_property_unused(S, S_next) = false -- otherwise
def $eager_property_pending_nodes(S, S_next) = $operand_nodes(S.RESULT)
  -- if $eager_property_write(S) =/= eps
  -- if S.TODO = ptask :: ptask_tail*
  -- if S_next.TODO = ptask_tail* /\ S_next.COMPLETION = NORMAL
  -- if ~$eager_property_warm(S) /\ ~$eager_property_rhs_cv(S)
  -- if ~$destructor_return_discarded(S_next.TODO)
  -- if $operand_nodes(S_next.RESULT) = $operand_nodes(S.RESULT)
def $eager_property_pending_nodes(S, S_next) = eps -- otherwise
def $eager_property_caches_valid(S, eps) = true
def $eager_property_caches_valid(S, (porigin, pobject) :: (porigin_tail, pobject_tail)*) = true
  -- if $eager_property_cache_at((porigin_tail, pobject_tail)*, porigin) = eps
  -- if $eager_property_class_valid(S, pobject)
  -- if $origin_node(S.SOURCES, porigin) = (NExprAssign (NExprPropertyFetch expression_receiver (NIdentifier (BYTES text) metadata_name) metadata_property) expression_rhs metadata)
  -- if $eager_source_origin(S, (porigin))
  -- if $eager_property_caches_valid(S, (porigin_tail, pobject_tail)*)
def $eager_property_caches_valid(S, (porigin, pobject)*) = false -- otherwise

def $eager_removed(eps, pnode*) = eps
def $eager_removed(pnode :: pnode_old*, pnode_new*) = $eager_removed(pnode_old*, $destruction_node_delete(pnode_new*, pnode))
  -- if pnode <- pnode_new*
def $eager_removed(pnode :: pnode_old*, pnode_new*) = pnode :: $eager_removed(pnode_old*, pnode_new*)
  -- if ~(pnode <- pnode_new*)
def $eager_slots(S, S_next) = $eager_live_slots(S_next, $eager_removed($eager_owner_order(S), $machine_roots(S_next) ++ $eager_edge_nodes($heap_graph(S_next).EDGES))) ++ $eager_property_pending_nodes(S, S_next)
def $eager_live_slots(S, eps) = eps
def $eager_live_slots(S, pnode :: pnode_tail*) = pnode :: $eager_live_slots(S, pnode_tail*) -- if pnode <- S.ALLOCATIONS
def $eager_live_slots(S, pnode :: pnode_tail*) = $eager_live_slots(S, pnode_tail*) -- if ~(pnode <- S.ALLOCATIONS)

def $eager_written_task(WRITE_NAME n* z) = true
def $eager_written_task(ACCESS_RESULT paccess) = true
  -- if paccess.MODE = ACCESS_SET
def $eager_written_task(ptask) = false -- otherwise
;; Unused assignments have no copied opcode result. Other live owners determine
;; whether the RHS survives destruction of a replaced value or receiver.
def $eager_unused_assignment(S, S_next) = true
  -- if S.TODO = ptask :: ptask_tail*
  -- if $eager_written_task(ptask)
  -- if S_next.COMPLETION = NORMAL
  -- if $destructor_return_discarded(S_next.TODO)
def $eager_unused_assignment(S, S_next) = false -- otherwise

def $destruction_transition(S, S_next) = $eager_fatal_begin(S, S_next)
  -- if $eager_fatal_ready(S, S_next.COMPLETION)
def $destruction_transition(S, S_next) = $eager_bailout_transfer(S, S_next, ptask)
  -- if ~$eager_fatal_ready(S, S_next.COMPLETION)
  -- if $eager_bailout_source(S) = (ptask)
def $destruction_transition(S, S_next) = $eager_operation_begin(S_out, S, ptask, pnode*)
  -- if ~$eager_fatal_ready(S, S_next.COMPLETION)
  -- if $eager_bailout_source(S) = eps
  -- if $destructor_operational(S_next)
  -- if S.TODO = ptask :: ptask_tail*
  -- if ~$eager_explicit_task(ptask)
  -- if S_next.COMPLETION =/= BUDGET /\ S_next.COMPLETION =/= SOURCE_PENDING /\ ~$destructor_unsupported(S_next.COMPLETION)
  -- if S_out = $eager_operation_destination(S, S_next)
  -- if pnode* = $eager_slots(S, S_out)
  -- if pnode* =/= eps
def $destruction_transition(S, S_next) = $eager_operation_destination(S, S_next)
  -- otherwise
def $eager_destination_value(S, S_next) = S_next[.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if $eager_unused_assignment(S, S_next)
def $eager_destination_value(S, S_next) = S_next[.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if $eager_property_unused(S, S_next)
  -- if $eager_property_warm(S) \/ $eager_property_rhs_cv(S)
def $eager_destination_value(S, S_next) = S_next[.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = ptask :: ptask_tail*
  -- if $eager_property_finish_task(ptask) /\ $eager_cv_property(S)
  -- if ~$eager_property_unused(S, S_next) \/ (~$eager_property_warm(S) /\ ~$eager_property_rhs_cv(S))
def $eager_destination_value(S, S_next) = S_next -- otherwise
def $eager_operation_destination(S, S_next) = $eager_property_cache_store(S, $eager_destination_value(S, S_next))

def $eager_operation_pending(S) = (n) -- if S.COMPLETION = THROWING n
def $eager_operation_pending(S) = (n)
  -- if S.TODO = (THROW_SEARCH n) :: ptask*
  -- if S.COMPLETION = NORMAL
def $eager_operation_pending(S) = eps -- otherwise
def $eager_operation_tail(S) = ptask*
  -- if S.TODO = (THROW_SEARCH n) :: ptask*
  -- if S.COMPLETION = NORMAL
def $eager_operation_tail(S) = S.TODO -- otherwise
def $eager_operation_value(S) = KNOWN PNULL -- if $eager_operation_pending(S) =/= eps
def $eager_operation_value(S) = S.RESULT -- otherwise
def $eager_operation_begin(S, S_source, ptask, pnode*) = $destructor_release_begin(S_marked[.COMPLETION = NORMAL][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)][.DESTRUCTION.OPERATIONS = pdestructionoperation :: S_marked.DESTRUCTION.OPERATIONS][.TODO = (DESTRUCTOR_OPERATION_EXIT pdestructionoperation) :: $eager_operation_tail(S)], $destruction_values(pnode*))
  -- if S_marked = $eager_cleanup_hold($request_fatal_state($destruction_store_new(S)), $eager_cleanup_for(S_source, ptask))
  -- if pdestructionoperation = {VALUE $eager_operation_value(S), BASE S.BASE, CELL S.CELL, KEY S.KEY, LOCATION S.LOCATION, COMPLETION S.COMPLETION, PENDING $eager_operation_pending(S), CALLER S.CURRENT, ORIGIN S.ORIGIN, CONSTCONTEXT S.CONSTCONTEXT, SOURCE ptask, CLEANUP $eager_cleanup_for(S_source, ptask)}

def $destructor_operation_at(pcallcontext?, porigin?, eps) = eps
def $destructor_operation_at(pcallcontext?, porigin?, pdestructionoperation :: pdestructionoperation_tail*) = (pdestructionoperation)
  -- if pdestructionoperation.CALLER = pcallcontext? /\ pdestructionoperation.ORIGIN = porigin?
def $destructor_operation_at(pcallcontext?, porigin?, pdestructionoperation :: pdestructionoperation_tail*) = $destructor_operation_at(pcallcontext?, porigin?, pdestructionoperation_tail*)
  -- if pdestructionoperation.CALLER =/= pcallcontext? \/ pdestructionoperation.ORIGIN =/= porigin?
def $destructor_operation_for(S) = $destructor_operation_at(S.CURRENT, S.ORIGIN, S.DESTRUCTION.OPERATIONS)
def $destructor_selected_frame(S) = eps -- if $destructor_operation_for(S) =/= eps
def $destructor_selected_frame(S) = $destructor_frame_for(S.CURRENT, S.DESTRUCTION.FRAMES) -- if $destructor_operation_for(S) = eps
def $destructor_selected_pending(S, pdestructionframe?) = pdestructionoperation.PENDING
  -- if $destructor_operation_for(S) = (pdestructionoperation)
def $destructor_selected_pending(S, pdestructionframe?) = $destructor_frame_pending(S, pdestructionframe?)
  -- if $destructor_operation_for(S) = eps

def $destructor_operation_live(S, pdestructionoperation) = ($destructor_operational(S) /\ pdestructionoperation <- S.DESTRUCTION.OPERATIONS /\ $destructor_pending_valid(S, pdestructionoperation.PENDING) /\ $destructor_return_operand_valid(S, pdestructionoperation.VALUE) /\ $heap_subset($base_nodes(pdestructionoperation.BASE) ++ $eager_operation_completion_roots(pdestructionoperation), S.ALLOCATIONS) /\ $eager_operation_source_valid(S, pdestructionoperation))
def $destructor_operation_valid(S, pdestructionoperation) = ($destructor_operation_live(S, pdestructionoperation) /\ S.CURRENT = pdestructionoperation.CALLER /\ S.ORIGIN = pdestructionoperation.ORIGIN /\ S.CONSTCONTEXT = pdestructionoperation.CONSTCONTEXT)
def $destructor_operations_valid(S, eps) = true
def $destructor_operations_valid(S, pdestructionoperation :: pdestructionoperation_tail*) = ($destructor_operation_live(S, pdestructionoperation) /\ $destructor_operations_valid(S, pdestructionoperation_tail*))
def $call_task_valid(S, DESTRUCTOR_OPERATION_EXIT pdestructionoperation) = $destructor_operation_valid(S, pdestructionoperation)
def $eager_operation_completion_roots(pdestructionoperation) = $completion_roots(pdestructionoperation.COMPLETION)
  -- if pdestructionoperation.PENDING = eps
def $eager_operation_completion_roots(pdestructionoperation) = $instance_roots(pdestructionoperation.PENDING)
  -- if pdestructionoperation.PENDING =/= eps
def $task_nodes(DESTRUCTOR_OPERATION_EXIT pdestructionoperation) = $operand_nodes(pdestructionoperation.VALUE) ++ $base_nodes(pdestructionoperation.BASE) ++ $eager_operation_completion_roots(pdestructionoperation)
rule PhpStep/destructor-operation-finish: S ~> $destructor_operation_finish(S, pdestructionoperation)
  -- if S.TODO = (DESTRUCTOR_OPERATION_EXIT pdestructionoperation) :: ptask_tail*
  -- if $destructor_operation_valid(S, pdestructionoperation)
  -- if S.DESTRUCTION.OPERATIONS = pdestructionoperation :: pdestructionoperation_tail*
def $destructor_operation_finish(S, pdestructionoperation) = S_done
