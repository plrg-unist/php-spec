;; Handler registries and callback array/reference rows are borrowed lookup
;; evidence. Later queue writes cannot alter the interrupted selection input.
def $eager_fatal_handler(S, PARRAY n) = {VALUE PARRAY n, ARRAY (S.ARRAYS[n]), CELLS $eager_fatal_handler_cells(S, S.ARRAYS[n].ITEMS)}
  -- if $(n < |S.ARRAYS|)
