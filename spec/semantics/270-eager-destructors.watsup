def $eager_fatal_cell_history(S, eps) = S
def $eager_fatal_cell_history(S, (n, pslot) :: (n_tail, pslot_tail)*) = $eager_fatal_cell_history(S[.STORE[n] = pslot], (n_tail, pslot_tail)*)
def $eager_fatal_cell_bounds(S, eps) = true
def $eager_fatal_cell_bounds(S, (n, pslot) :: (n_tail, pslot_tail)*) = ($(n < |S.STORE|) /\ $eager_fatal_cell_bounds(S, (n_tail, pslot_tail)*))
