  -- if $eager_fatal_handler_bounds(S, pdestructionhandler_tail*)
def $eager_fatal_handler_bounds(S, pdestructionhandler*) = false -- otherwise
;; The fatal record retains the interrupted source lookup rows. With all VM
;; continuations gone, those eval/file rows are no longer active runtime owners.
def $eager_fatal_clean(S, S_report, pcompletion) = S_clean[.EVALCONTEXTS = eps][.FILECONTEXTS = eps][.DESTRUCTION.CLEANUPS = eps][.DESTRUCTION.CALLS = eps][.DESTRUCTION.RELEASES = eps][.DESTRUCTION.FRAMES = eps][.DESTRUCTION.OPERATIONS = eps]
