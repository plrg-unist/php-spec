;; zend_object_std_dtor releases the dynamic hash before declared property slots.
;; Reading/casting still uses the original slot layout; only decrement order changes.
dec $property_release_partition(ppropertyslot*, bool) : pnode*
def $property_release_nodes(ppropertyslot*) = $property_release_partition(ppropertyslot*, true) ++ $property_release_partition(ppropertyslot*, false)
