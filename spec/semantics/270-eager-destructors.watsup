  -- if S.TODO = (ERROR_HANDLER_RESULT perrorcall) :: ptask*
  -- if ~$destructor_operational(S)
def $task_nodes(ERROR_HANDLER_CLEAN perrorcall) = $value_nodes(perrorcall.CALLBACK) ++ $task_nodes(perrorcall.RESUME)
def $error_cleanup_valid(S, perrorcall) = true
  -- if S.DESTRUCTION.CLEANUPS = pdestructioncleanup :: pdestructioncleanup_tail*
  -- if pdestructioncleanup.SOURCE = ERROR_HANDLER_RESULT perrorcall
  -- if ~pdestructioncleanup.RELEASED
  -- if $eager_cleanup_valid(S, pdestructioncleanup)
  -- if S.CURRENT = pdestructioncleanup.CALLER /\ S.ORIGIN = pdestructioncleanup.ORIGIN /\ S.CONSTCONTEXT = pdestructioncleanup.CONSTCONTEXT
  -- if $error_call_valid(S, perrorcall)
def $error_cleanup_valid(S, perrorcall) = false -- otherwise
def $call_task_valid(S, ERROR_HANDLER_CLEAN perrorcall) = $error_cleanup_valid(S, perrorcall)
rule PhpStep/error-handler-restore-after-retval: S ~> $error_handler_restore(S[.TODO = perrorcall.RESUME :: ptask*][.DESTRUCTION.CLEANUPS = pdestructioncleanup_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], perrorcall.CALLBACK)
  -- if S.TODO = (ERROR_HANDLER_CLEAN perrorcall) :: ptask*
  -- if $error_cleanup_valid(S, perrorcall)
  -- if S.DESTRUCTION.CLEANUPS = pdestructioncleanup :: pdestructioncleanup_tail*
def $call_after_origin(S, ERROR_HANDLER_CLEAN perrorcall) = S[.DESTRUCTION.CLEANUPS = pdestructioncleanup_tail*]
  -- if S.DESTRUCTION.CLEANUPS = pdestructioncleanup :: pdestructioncleanup_tail*
  -- if pdestructioncleanup.SOURCE = ERROR_HANDLER_RESULT perrorcall
def $return_discard(S, ERROR_HANDLER_CLEAN perrorcall) = $error_read_discard($error_handler_restore($identity_read_discard(S[.DESTRUCTION.CLEANUPS = pdestructioncleanup_tail*], perrorcall.RESUME), perrorcall.CALLBACK), perrorcall.RESUME)
  -- if S.DESTRUCTION.CLEANUPS = pdestructioncleanup :: pdestructioncleanup_tail*
  -- if pdestructioncleanup.SOURCE = ERROR_HANDLER_RESULT perrorcall

;; A bailout retains the unreleased C zval count, not an extra selected receiver.
;; Keep its authenticated cleanup record until the later store/free stages.
dec $eager_abandoned_entries(pdestructioncleanup*) : pdestructioncleanup*
def $eager_abandoned_entries(eps) = eps
def $eager_abandoned_entries(pdestructioncleanup :: pdestructioncleanup_tail*) = pdestructioncleanup :: $eager_abandoned_entries(pdestructioncleanup_tail*)
  -- if ~pdestructioncleanup.RELEASED
def $eager_abandoned_entries(pdestructioncleanup :: pdestructioncleanup_tail*) = $eager_abandoned_entries(pdestructioncleanup_tail*)
  -- if pdestructioncleanup.RELEASED
def $eager_abandoned_roots(eps) = eps
def $eager_abandoned_roots(pdestructioncleanup :: pdestructioncleanup_tail*) = $eager_abandoned_owner(pdestructioncleanup.SOURCE) ++ $eager_abandoned_roots(pdestructioncleanup_tail*)
def $eager_abandoned_owner(EXCEPTION_HANDLER_RESULT pexceptioncall) = [HOBJECT pexceptioncall.OBJECT]
def $eager_abandoned_owner(ERROR_HANDLER_RESULT perrorcall) = $value_nodes(perrorcall.CALLBACK)
def $eager_abandoned_owner(DESTRUCTOR_RESULT pdestructorcall) = [HOBJECT pdestructorcall.OBJECT, HOBJECT pdestructorcall.OBJECT] ++ $eager_bailout_extra(pdestructorcall)
def $eager_abandoned_owner(DESTRUCTOR_WARNING pdestructorcall) = [HOBJECT pdestructorcall.OBJECT] ++ $eager_bailout_extra(pdestructorcall)
def $eager_abandoned_owner(DESTRUCTOR_FATAL pdestructionfatal) = $eager_fatal_nodes(pdestructionfatal)
def $eager_abandoned_owner(ptask) = eps -- otherwise
def $eager_abandoned_valid(S, eps) = true
def $eager_abandoned_valid(S, pdestructioncleanup :: pdestructioncleanup_tail*) = (~pdestructioncleanup.RELEASED /\ $eager_cleanup_valid(S, pdestructioncleanup) /\ $heap_subset($eager_abandoned_owner(pdestructioncleanup.SOURCE), S.ALLOCATIONS) /\ $eager_abandoned_valid(S, pdestructioncleanup_tail*))
def $destruction_abort(S, S_clean) = S_clean[.DESTRUCTION.ABANDONED = S_clean.DESTRUCTION.ABANDONED ++ $eager_abandoned_entries(S.DESTRUCTION.CLEANUPS)][.DESTRUCTION.CLEANUPS = eps][.DESTRUCTION.CALLS = eps][.DESTRUCTION.RELEASES = eps][.DESTRUCTION.FRAMES = eps][.DESTRUCTION.OPERATIONS = eps]

;; A null-C throw or exit cannot return through objects_destroy_object/store_del.
