;; METHOD becomes a direct immutable value only after the live reference was
;; reread. These snapshots are certificates and contribute no heap roots.
def $consumer_query_selected(S, papiquery) = papiquery[.METHOD = DIRECT ($entry_value(S, papiquery.METHOD))]
def $consumer_snapshot(S, papiquery) = (S.ARRAYS[n][.ITEMS = [ENTRY (KINT 0) (DIRECT papiquery.INPUT), ENTRY (KINT 1) papiquery.METHOD]])
  -- if papiquery.VALUE = PARRAY n
  -- if $(n < |S.ARRAYS|)
def $consumer_snapshot(S, papiquery) = eps -- otherwise
def $consumer_snapshot_valid(papiquery, (parray)) = true
  -- if papiquery.VALUE = PARRAY n
  -- if papiquery.METHOD = DIRECT (PSTRING ptbytes)
  -- if parray.ITEMS = [ENTRY (KINT 0) (DIRECT papiquery.INPUT), ENTRY (KINT 1) papiquery.METHOD]
def $consumer_snapshot_valid(papiquery, eps) = true
  -- if papiquery.VALUE = PSTRING ptbytes
  -- if papiquery.METHOD = DIRECT (PSTRING ptbytes)
  -- if papiquery.ORIGINAL = ptbytes
def $consumer_snapshot_valid(papiquery, parray?) = false -- otherwise

;; Retired selector records authenticate class identities without retaining an
;; object. A nonstatic selected target owns its actual receiver independently.
def $consumer_history_nodes(papiquery) = $value_nodes(papiquery.INPUT) ++ $scoped_receiver_nodes(papiquery.THIS) ++ $scoped_receiver_nodes(papiquery.CLASS.RECEIVER)
def $consumer_history(S, papiquery) = S[.ALLOCATIONS = S.ALLOCATIONS ++ $consumer_history_nodes(papiquery)]
def $consumer_class_valid(S, papiquery) = true
  -- if papiquery.OUTER = eps
