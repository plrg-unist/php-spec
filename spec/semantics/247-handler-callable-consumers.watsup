  -- if papiquery.VALUE = PARRAY n
  -- if $method_string_parts(papiquery.ORIGINAL) = eps
  -- if papiquery.PREFIX = 0 /\ papiquery.WIDTH = 0
def $consumer_class_valid(S, papiquery) = true
