  -- if $class_origin_matches(S, porigin_called, pclassdesc.NAME, |S.CLASSES|)
  -- if pmethodcapture.CALLSITE = (porigin_call)
  -- if $trait_capture_invocation(S, pfunction, pmethodcapture, porigin_call)
def $consumer_capture_valid(S, porigin, eps) = true
  -- if $consumer_capture_function(S, porigin, eps) = (porigin_function)
  -- if $class_method_origin(S.CLASSES, porigin_function) = eps
def $consumer_capture_valid(S, porigin, eps) = true
  -- if $consumer_capture_function(S, porigin, eps) = eps
def $consumer_capture_valid(S, porigin, pmethodcapture?) = false -- otherwise
def $consumer_capture_function(S, porigin, (pmethodcapture)) = (pmethodcapture.FUNCTION)
def $consumer_capture_function(S, porigin, eps) = $closure_nearest_owner(S, $closure_creation_owners($all_functions(S), porigin), eps)
def $consumer_capture_valid(S, porigin, (pmethodcapture)) = true
  -- if $closure_nearest_owner(S, $closure_creation_owners($all_functions(S), porigin), eps) = (pmethodcapture.FUNCTION)
  -- if $method_capture_template(S, pmethodcapture.FUNCTION)
