dec $consumer_exception_original(pstate, papiquery) : bool
dec $consumer_query_selected(pstate, papiquery) : papiquery
dec $consumer_snapshot(pstate, papiquery) : parray?
dec $consumer_snapshot_valid(papiquery, parray?) : bool
dec $consumer_history(pstate, papiquery) : pstate
dec $consumer_history_nodes(papiquery) : pnode*
dec $consumer_class_valid(pstate, papiquery) : bool
dec $consumer_method_valid(pstate, papiquery, porigin, ptbytes) : bool
dec $consumer_receiver_live(pstate, nat?) : bool
