def $consumer_class_valid(S, papiquery) = true
  -- if papiquery.VALUE = PARRAY n
  -- if papiquery.OUTER = (papiclass)
  -- if $api_class($consumer_history(S, papiquery), papiquery.INPUT, papiquery.SCOPE, papiquery.SCOPE, papiquery.CALLED, papiquery.THIS, eps) = API_CLASS papiclass
  -- if $method_string_parts(papiquery.ORIGINAL) = ((ptbytes_class, ptbytes_method))
  -- if ptbytes_class =/= eps
  -- if papiquery.PREFIX = $(|ptbytes_class| + 2) /\ papiquery.WIDTH = |ptbytes_method|
  -- if $api_class($consumer_history(S, papiquery), PSTRING ptbytes_class, (papiclass.REQUESTED), papiquery.SCOPE, papiquery.CALLED, papiquery.THIS, papiclass.RECEIVER) = API_CLASS papiquery.CLASS
  -- if $api_subclass(S, papiclass.REQUESTED, papiquery.CLASS.REQUESTED)
def $consumer_class_valid(S, papiquery) = false -- otherwise
def $consumer_receiver_live(S, (n)) = ((HOBJECT n) <- S.ALLOCATIONS)
def $consumer_receiver_live(S, eps) = false
