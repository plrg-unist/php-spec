def $api_target_valid(S, papiquery, porigin, ptbytes) = $consumer_exception_target(S, papiquery, porigin, ptbytes)
  -- if $consumer_exception_source(papiquery.SOURCE)
def $exception_raw_selected(S, pvalue, parray?, API_METHOD_TARGET papiquery porigin ptbytes b_static) = (pvalue = papiquery.VALUE /\ $consumer_snapshot_valid(papiquery, parray?) /\ $api_carrier_valid(S, papiquery, porigin, ptbytes, b_static))
def $handler_emitter_valid(S, API_METHOD_TARGET papiquery porigin ptbytes b_static) = $api_carrier_valid(S, papiquery, porigin, ptbytes, b_static)
  -- if $consumer_exception_source(papiquery.SOURCE)
def $consumer_exception_object(API_METHOD_TARGET papiquery porigin ptbytes b_static, n) = (pexceptioncall.OBJECT = n)
  -- if papiquery.SOURCE = EXCEPTION_HANDLER_INVOKE pexceptioncall
def $consumer_exception_object(pcalltarget, n) = true -- otherwise
def $consumer_api_target(API_METHOD_TARGET papiquery porigin ptbytes b_static) = true
def $consumer_api_target(pcalltarget) = false -- otherwise

