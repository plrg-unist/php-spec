;; A C-selected maker may retire its old registry and Closure before the new
;; queue entry runs. Keep only its immutable target and scope/binding records.
;; Reconstruction below is for pure lookups and creates no heap owners.
def $consumer_producer_current(S) = ({TARGET pcallcontext.TARGET, SITE pcallcontext.CALLSITE, SCOPE $consumer_producer_scope(S, pcallcontext.TARGET), BINDING $consumer_producer_binding(S, pcallcontext.TARGET), INTERNAL ($error_context_kind(S, pcallcontext) \/ $exception_context_kind(S, pcallcontext) \/ $shutdown_context_kind(S, pcallcontext) \/ $stringify_context_kind(S, pcallcontext) \/ $fiber_context_kind(S, pcallcontext) \/ $consumer_clone_context(S, pcallcontext))})
  -- if S.CURRENT = (pcallcontext)
def $consumer_producer_current(S) = eps -- if S.CURRENT = eps
def $consumer_producer_scope(S, pcalltarget) = $closure_scope_at(S.CLOSURESCOPES, n)
  -- if $target_instance(pcalltarget) = (n)
def $consumer_producer_scope(S, pcalltarget) = eps -- if $target_instance(pcalltarget) = eps
def $consumer_producer_binding(S, pcalltarget) = $closure_binding_at(S.CLOSUREBINDINGS, n)
  -- if $target_instance(pcalltarget) = (n)
def $consumer_producer_binding(S, pcalltarget) = eps -- if $target_instance(pcalltarget) = eps
def $consumer_producer_nodes(pshutdownproducer) = $target_nodes(pshutdownproducer.TARGET) ++ $scoped_receiver_nodes($consumer_producer_receiver(pshutdownproducer.SCOPE)) ++ $scoped_receiver_nodes($consumer_producer_bound_receiver(pshutdownproducer.BINDING))
def $consumer_producer_receiver(eps) = eps
def $consumer_producer_receiver((pclosurescope)) = pclosurescope.RECEIVER
def $consumer_producer_bound_receiver(eps) = eps
def $consumer_producer_bound_receiver((pclosurebinding)) = pclosurebinding.RECEIVER
def $consumer_producer_tables(S, pshutdownproducer) = S[.CLOSURESCOPES =  $consumer_producer_scopes(pshutdownproducer.SCOPE) ++ S.CLOSURESCOPES][.CLOSUREBINDINGS = $consumer_producer_bindings(pshutdownproducer.BINDING) ++ S.CLOSUREBINDINGS]
def $consumer_producer_history(S, pshutdownproducer) = S_tables[.ALLOCATIONS = S_tables.ALLOCATIONS ++ $consumer_producer_nodes(pshutdownproducer)]
  -- if S_tables = $consumer_producer_tables(S, pshutdownproducer)
def $consumer_producer_capture(S, pshutdownentry) = $consumer_capture_valid(S, pshutdownentry.CALL.SITE, pshutdownentry.CAPTURE)
  -- if pshutdownentry.PRODUCER = eps
  -- if pshutdownentry.CAPTURE = eps
  -- if $consumer_capture_function(S, pshutdownentry.CALL.SITE, eps) = eps
def $consumer_producer_capture(S, pshutdownentry) = true
  -- if pshutdownentry.PRODUCER = (pshutdownproducer)
  -- if $consumer_producer_snapshot(pshutdownproducer)
  -- if $consumer_producer_site(pshutdownentry.CAPTURE, pshutdownproducer.SITE)
  -- if S_history = $consumer_producer_history(S, pshutdownproducer)
  -- if $target_function(S_history, pshutdownproducer.TARGET) = (pfunction)
  -- if pshutdownentry.CALL.SITE = PORIGIN n pcpath
  -- if $goto_source_owner($all_functions(S), n, pcpath) = (pfunction_source)
  -- if $trait_source_same(pfunction_source, pfunction)
  -- if $shutdown_capture_scope(S, pshutdownentry.CALL.SITE, pshutdownentry.CAPTURE) = $target_lexical_class(S_history, pshutdownproducer.TARGET)
  -- if $consumer_capture_called(S, pshutdownentry.CALL.SITE, pshutdownentry.CAPTURE) = $target_called_class(S_history, pshutdownproducer.TARGET)
  -- if (~pshutdownproducer.INTERNAL /\ $consumer_capture_valid(S, pshutdownentry.CALL.SITE, pshutdownentry.CAPTURE)) \/ (pshutdownproducer.INTERNAL /\ $consumer_producer_internal_at(S_history, pshutdownproducer))
  -- if pshutdownentry.TARGET = API_METHOD_TARGET papiquery porigin ptbytes b_static
  -- if papiquery.THIS = $target_receiver(S_history, pshutdownproducer.TARGET)
  -- if pshutdownentry.CAPTURE = eps \/ $consumer_producer_function(pshutdownentry.CAPTURE, pfunction.ORIGIN)
def $consumer_producer_capture(S, pshutdownentry) = false -- otherwise
def $consumer_producer_function((pmethodcapture), porigin) = (pmethodcapture.FUNCTION = porigin)
def $consumer_producer_function(eps, porigin) = false
def $consumer_producer_site((pmethodcapture), porigin?) = (pmethodcapture.CALLSITE = porigin?)
def $consumer_producer_site(eps, porigin?) = true
dec $consumer_destructor_target(pstate, pcalltarget) : bool
def $consumer_producer_internal(S, pcalltarget) = ($handler_method_tag(pcalltarget) \/ $consumer_producer_named(pcalltarget) \/ $consumer_string_target(S, pcalltarget) \/ $consumer_destructor_target(S, pcalltarget))
  -- if $target_instance(pcalltarget) = eps
def $consumer_producer_internal(S, pcalltarget) = true -- if $target_instance(pcalltarget) =/= eps
def $consumer_producer_internal_at(S, pshutdownproducer) = ($consumer_producer_internal(S, pshutdownproducer.TARGET) \/ $consumer_clone_producer_valid(S, pshutdownproducer))
def $consumer_string_target(S, METHOD_TARGET n porigin) = true
  -- if $class_method_origin(S.CLASSES, porigin) = (pmethoddesc)
  -- if $ptlc(pmethoddesc.NAME) = $ptascii("__tostring")
  -- if pmethoddesc.VISIBILITY = PROPERTY_PUBLIC
def $consumer_string_target(S, pcalltarget) = false -- otherwise
