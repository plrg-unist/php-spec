dec $consumer_shutdown_target(pstate, papiquery, porigin, ptbytes, pshutdownentry*) : bool
dec $consumer_shutdown_scope(pstate, papiquery, pshutdownentry) : bool
dec $consumer_capture_current(pstate, porigin) : pmethodcapture?
dec $consumer_capture_valid(pstate, porigin, pmethodcapture?) : bool
dec $consumer_capture_function(pstate, porigin, pmethodcapture?) : porigin?
dec $consumer_producer_current(pstate) : pshutdownproducer?
dec $consumer_producer_scope(pstate, pcalltarget) : pclosurescope?
dec $consumer_producer_binding(pstate, pcalltarget) : pclosurebinding?
dec $consumer_producer_history(pstate, pshutdownproducer) : pstate
dec $consumer_producer_tables(pstate, pshutdownproducer) : pstate
dec $consumer_producer_nodes(pshutdownproducer) : pnode*
dec $consumer_producer_capture(pstate, pshutdownentry) : bool
dec $consumer_producer_internal(pstate, pcalltarget) : bool
dec $consumer_producer_internal_at(pstate, pshutdownproducer) : bool
dec $consumer_clone_context(pstate, pcallcontext) : bool
def $consumer_clone_context(S, pcallcontext) = false -- otherwise
dec $consumer_clone_producer_valid(pstate, pshutdownproducer) : bool
def $consumer_clone_producer_valid(S, pshutdownproducer) = false -- otherwise
dec $consumer_string_target(pstate, pcalltarget) : bool
dec $consumer_producer_receiver(pclosurescope?) : nat?
dec $consumer_producer_bound_receiver(pclosurebinding?) : nat?
dec $consumer_producer_function(pmethodcapture?, porigin) : bool
dec $consumer_producer_site(pmethodcapture?, porigin?) : bool
