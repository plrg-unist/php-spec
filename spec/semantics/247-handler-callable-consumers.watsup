def $consumer_shutdown_scope(S, papiquery, pshutdownentry) = false -- otherwise
;; API registration runs in the ordinary method maker, unlike FCC production.
;; Its called class must survive even when it equals the lexical source scope.
def $consumer_capture_current(S, porigin) = ({FUNCTION pcallcontext.FUNCTION, CALLSITE pcallcontext.CALLSITE, LEXICAL_CLASS pcallcontext.LEXICAL_CLASS, CALLED_CLASS pcallcontext.CALLED_CLASS})
  -- if S.CURRENT = (pcallcontext)
  -- if $class_method_origin(S.CLASSES, pcallcontext.FUNCTION) =/= eps \/ $method_capture_template(S, pcallcontext.FUNCTION)
def $consumer_capture_current(S, porigin) = $method_capture_current(S, porigin) -- otherwise
def $consumer_capture_valid(S, PORIGIN n pcpath, (pmethodcapture)) = true
  -- if $goto_source_owner($all_functions(S), n, pcpath) = (pfunction_source)
  -- if $function_at($all_functions(S), pmethodcapture.FUNCTION) = (pfunction)
  -- if $trait_source_same(pfunction_source, pfunction)
