def $api_finish(S, EXCEPTION_HANDLER_INVOKE pexceptioncall, pvalue, HANDLERRESOLVED (API_METHOD_TARGET papiquery porigin ptbytes b_static)) = $consumer_exception_enter(S[.TODO = (EXCEPTION_HANDLER_INVOKE pexceptioncall_selected) :: ptask_tail*], pexceptioncall_selected, API_METHOD_TARGET papiquery_selected porigin ptbytes b_static)
