dec $consumer_capture_this(pstate, porigin, pmethodcapture?, nat?) : bool
dec $consumer_target_same(pcalltarget, papiquery, porigin, ptbytes) : bool
dec $consumer_shutdown_register(pstate, pconfigcall, papiquery, porigin, ptbytes, bool) : pstate
dec $consumer_exception_enter(pstate, pexceptioncall, pcalltarget) : pstate
dec $consumer_exception_invalid(pstate, pexceptioncall, ptbytes) : pstate

def $api_registration_candidate(S, pconfigcall) = ($error_api_arity(S, pconfigcall).COMPLETION = NORMAL /\ $api_special(S, $error_api_value(pconfigcall, 0, PNULL)))
  -- if pconfigcall.KIND <- [INTRINSIC_SET_EXCEPTION_HANDLER, INTRINSIC_REGISTER_SHUTDOWN_FUNCTION]
def $api_source_valid(S, papiquery) = true
  -- if papiquery.SOURCE = CONFIG_INVOKE pconfigcall
  -- if pconfigcall.KIND <- [INTRINSIC_SET_EXCEPTION_HANDLER, INTRINSIC_REGISTER_SHUTDOWN_FUNCTION]
  -- if $config_invoke_valid(S, pconfigcall)
  -- if $error_api_arity(S, pconfigcall).COMPLETION = NORMAL
  -- if papiquery.VALUE = $error_api_value(pconfigcall, 0, PNULL)
def $api_finish(S, CONFIG_INVOKE pconfigcall, pvalue, HANDLERRESOLVED pcalltarget) = S[.TODO = ptask_tail*][.EXCEPTIONHANDLER = (pvalue)][.EXCEPTIONHANDLERS = S.EXCEPTIONHANDLER :: S.EXCEPTIONHANDLERS][.RESULT = KNOWN $exception_handler_value(S.EXCEPTIONHANDLER)][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if pconfigcall.KIND = INTRINSIC_SET_EXCEPTION_HANDLER
  -- if S.TODO = ptask :: ptask_tail*
def $api_finish(S, CONFIG_INVOKE pconfigcall, pvalue, HANDLERINVALID ptbytes) = $config_error(S, pconfigcall, "TypeError", $intrinsic_name(pconfigcall.KIND) ++ $ptascii("(): Argument #1 ($callback) must be a valid callback or null, ") ++ ptbytes)
  -- if pconfigcall.KIND = INTRINSIC_SET_EXCEPTION_HANDLER
def $api_finish(S, CONFIG_INVOKE pconfigcall, pvalue, HANDLERINVALID ptbytes) = $config_error(S, pconfigcall, "TypeError", $ptascii("register_shutdown_function(): Argument #1 ($callback) must be a valid callback, ") ++ ptbytes)
  -- if pconfigcall.KIND = INTRINSIC_REGISTER_SHUTDOWN_FUNCTION
def $api_finish(S, CONFIG_INVOKE pconfigcall, pvalue, HANDLERRESOLVED (API_METHOD_TARGET papiquery porigin ptbytes b_static)) = $consumer_shutdown_register(S, pconfigcall, papiquery, porigin, ptbytes, b_static)
  -- if pconfigcall.KIND = INTRINSIC_REGISTER_SHUTDOWN_FUNCTION
def $api_throw(S, papiquery, ptbytes_method, ptbytes) = $config_error(S, pconfigcall, "Error", ptbytes)
  -- if papiquery.SOURCE = CONFIG_INVOKE pconfigcall
  -- if pconfigcall.KIND <- [INTRINSIC_SET_EXCEPTION_HANDLER, INTRINSIC_REGISTER_SHUTDOWN_FUNCTION]

