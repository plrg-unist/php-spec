def $consumer_method_valid(S, papiquery, porigin, ptbytes) = false -- otherwise

def $consumer_exception_target(S, papiquery, porigin, ptbytes) = true
  -- if papiquery.SOURCE = EXCEPTION_HANDLER_INVOKE pexceptioncall
