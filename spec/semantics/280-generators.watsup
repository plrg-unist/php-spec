;; Generator detection is lexical: yields in nested declarations belong to
;; those declarations. Receives still run before the generator is created.
def $generator_syntax_walk(eps) = false
def $generator_syntax_walk((PCOCCURRENCE pcpath pcnode) :: pcoccurrence*) = ($generator_syntax(pcnode) \/ $generator_syntax_walk(pcoccurrence*))
def $generator_syntax(NExprYield phpType5_key phpType5_value metadata) = true
def $generator_syntax(NExprYieldFrom expression metadata) = true
def $generator_syntax(NStmtFunction phpType14 phpType4 phpType11 phpType16 phpType18 phpType23 metadata) = false
def $generator_syntax(NStmtClassMethod phpType14 phpType24 phpType4 phpType11 phpType16 phpType18 phpType47 metadata) = false
def $generator_syntax(NExprClosure phpType14 phpType4_static phpType4_ref phpType16 phpType21 phpType18 phpType23 metadata) = false
def $generator_syntax(NExprArrowFunction phpType14 phpType4_static phpType4_ref phpType16 phpType18 expression metadata) = false
def $generator_syntax(pcnode) = $generator_syntax_walk($pcchildren(pcnode, eps)) -- otherwise
def $generator_statements(eps) = false
def $generator_statements(statement :: statement_tail*) = ($generator_syntax(statement) \/ $generator_statements(statement_tail*))

def $generator_return_supertype([PTBRANCH ptatom*]) = $generator_return_atoms(ptatom*)
def $generator_return_supertype(ptbranch*) = $generator_return_union(ptbranch*) -- if |ptbranch*| =/= 1
def $generator_return_atoms(eps) = false
def $generator_return_atoms(ptatom :: ptatom_tail*) = ($generator_return_branch(PTBRANCH ([ptatom])) \/ $generator_return_atoms(ptatom_tail*))
def $generator_return_union(eps) = false
def $generator_return_union(ptbranch :: ptbranch_tail*) = ($generator_return_branch(ptbranch) \/ $generator_return_union(ptbranch_tail*))
def $generator_return_branch(PTBRANCH ([PTBUILTIN text])) = (text <- ["mixed", "object", "iterable"])
def $generator_return_branch(PTBRANCH ([PTCLASS ptbytes])) = ($ptlc(ptbytes) <- [$ptascii("generator"), $ptascii("iterator"), $ptascii("traversable")])
def $generator_return_branch(ptbranch) = false -- otherwise
def $ppgenerator_body(P, pcpath, statement*) = $ppstatements(P, pcpath, 0, statement*)
  -- if ~$generator_statements(statement*)
def $ppgenerator_body(P, pcpath, statement*) = $ppconstant_error(P, $ptascii("Generator return type must be a supertype of Generator, ") ++ $pttypename(P.RETURNS) ++ $ptascii(" given"), P.LOCATION.LINE)
  -- if $generator_statements(statement*)
  -- if P.RETURNS =/= eps /\ ~$generator_return_supertype(P.RETURNS)
def $ppgenerator_body(P, pcpath, statement*) = $ppstatements(P[.RETURNS = eps][.RETURNREF = false], pcpath, 0, statement*)
  -- if $generator_statements(statement*)
  -- if P.RETURNS = eps \/ $generator_return_supertype(P.RETURNS)
  -- if P.RETURNREF
  -- if ~$generator_from_statements(statement*)
def $ppgenerator_body(P, pcpath, statement*) = $ppstatements(P[.RETURNS = eps], pcpath, 0, statement*)
  -- if $generator_statements(statement*)
  -- if P.RETURNS = eps \/ $generator_return_supertype(P.RETURNS)
  -- if P.RETURNREF /\ $generator_from_statements(statement*)
def $ppgenerator_body(P, pcpath, statement*) = $ppstatements(P[.RETURNS = eps][.RETURNREF = false], pcpath, 0, statement*)
  -- if $generator_statements(statement*)
  -- if P.RETURNS = eps \/ $generator_return_supertype(P.RETURNS)
  -- if ~P.RETURNREF
def $ppyield_optional(P, pcpath, ABSENT) = $ppclearvalue(P)
def $ppyield_optional(P, pcpath, expression) = $ppexpr(P, pcpath, expression, PPR)
def $ppdispatch(P, pcpath, NExprYield phpType5_key phpType5_value metadata, PPR) = $ppconstant_error(P, $ptascii("The \"yield\" expression can only be used inside a function"), $nabs($source_line(metadata)))
  -- if P.FOLD.FUNCTION = eps
def $ppdispatch(P, pcpath, NExprYield phpType5_key phpType5_value metadata, PPR) = $ppclearvalue($ppyield_optional($ppyield_optional(P, pcpath ++ [PCFIELD 0], phpType5_key), pcpath ++ [PCFIELD 1], phpType5_value))
  -- if P.FOLD.FUNCTION =/= eps
  -- if ~$ppgenerator_reference_scope(P, pcpath)
def $ppdispatch(P, pcpath, NExprYieldFrom expression metadata, PPR) = $ppconstant_error(P, $ptascii("The \"yield\" expression can only be used inside a function"), $nabs($source_line(metadata)))
  -- if P.FOLD.FUNCTION = eps
def $ppdispatch(P, pcpath, NExprYieldFrom expression metadata, PPR) = $ppclearvalue($ppexpr(P, pcpath ++ [PCFIELD 0], expression, PPR))
  -- if P.FOLD.FUNCTION =/= eps
  -- if ~P.RETURNREF
def $ppdispatch(P, pcpath, NExprYieldFrom expression metadata, PPR) = $ppconstant_error(P, $ptascii("Cannot use \"yield from\" inside a by-reference generator"), $nabs($expression_line(expression)))
  -- if P.FOLD.FUNCTION =/= eps
  -- if P.RETURNREF

def $generator_function_body(S, pfunction) = $generator_statements(statement*)
  -- if $origin_node(S.SOURCES, pfunction.ORIGIN) = (NStmtFunction phpType14 phpType4 phpType11 phpType16 phpType18 (SEQUENCE statement*) metadata)
def $generator_function_body(S, pfunction) = $generator_statements(statement*)
  -- if $origin_node(S.SOURCES, pfunction.ORIGIN) = (NStmtClassMethod phpType14 phpType24 phpType4 phpType11 phpType16 phpType18 (SEQUENCE statement*) metadata)
def $generator_function_body(S, pfunction) = $generator_statements(statement*)
  -- if $origin_node(S.SOURCES, pfunction.ORIGIN) = (NExprClosure phpType14 phpType4_static phpType4_ref phpType16 phpType21 phpType18 (SEQUENCE statement*) metadata)
def $generator_function_body(S, pfunction) = $generator_syntax(expression)
  -- if $origin_node(S.SOURCES, pfunction.ORIGIN) = (NExprArrowFunction phpType14 phpType4_static phpType4_ref phpType16 phpType18 expression metadata)
def $generator_function_body(S, pfunction) = false -- otherwise
def $function_generator(S, pfunction) = $generator_function_body(S, pfunction)
def $function_tasks(S, pfunction) = [GENERATOR_CREATE pfunction.ORIGIN] -- if $function_generator(S, pfunction)
def $function_tasks(S, pfunction) = $function_body_tasks(S, pfunction) -- if ~$function_generator(S, pfunction)
def $function_fallthrough(S, pfunction) = RETURN_NULL -- if $function_generator(S, pfunction)
def $function_fallthrough(S, pfunction) = $typed_fallthrough(pfunction) -- if ~$function_generator(S, pfunction)

;; The suspended frame is an edge of the Generator object. Resume moves it
;; into the machine; the current resumer supplies the saved caller frame.
def $generator_object(S, n) = true -- if $(n < |S.OBJECTS|) -- if S.OBJECTS[n] = GENERATOR pgenerator
def $generator_object(S, n) = false -- otherwise
def $generator_set(S, n, pgenerator) = S[.OBJECTS = $object_set(S.OBJECTS, n, GENERATOR pgenerator)]
def $generator_frame(S, ptask*) = {SILENCES S.SILENCES, LOCALS ($active_table(S)), TODO ptask*, ORIGIN S.ORIGIN, HELD S.HELD, CONTEXT S.CURRENT, BORROWEDREAD S.BORROWEDREAD, OBJECTCAST S.OBJECTCAST, CONSTCONTEXT S.CONSTCONTEXT}
def $generator_install(S, pframe) = $set_active_table(S[.SILENCES = pframe.SILENCES][.TODO = pframe.TODO][.ORIGIN = pframe.ORIGIN][.HELD = pframe.HELD][.CURRENT = pframe.CONTEXT][.BORROWEDREAD = pframe.BORROWEDREAD][.OBJECTCAST = pframe.OBJECTCAST][.CONSTCONTEXT = pframe.CONSTCONTEXT][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], psymboltable)
  -- if pframe.LOCALS = (psymboltable)
def $generator_create(S, pfunction) = $restore_frame(S[.OBJECTS = S.OBJECTS ++ [GENERATOR {FUNCTION pfunction.ORIGIN, FRAME ($generator_frame(S, $function_body_tasks(S, pfunction))), PHASE GENERATOR_FRESH, FIRST false, INDEX $(-1), VALUE eps, REFCELL eps, KEY eps, BORROWED eps, RETURN eps, CLOSURE pcallcontext.INSTANCE, DELEGATE eps, ACCESS $access_generator_capture(S, pcallcontext)}]][.ALLOCATIONS = S.ALLOCATIONS ++ [HOBJECT n]][.RESULT = KNOWN (POBJECT n)][.BASE = BASE_VALUE (KNOWN PNULL)][.TODO = eps][.HELD = eps])
  -- if n = |S.OBJECTS|
  -- if S.CURRENT = (pcallcontext)
rule PhpStep/generator-create: S ~> $generator_create(S, pfunction)
  -- if S.TODO = (GENERATOR_CREATE porigin) :: ptask_tail*
  -- if $function_at($all_functions(S), porigin) = (pfunction)
  -- if $function_generator(S, pfunction)
  -- if S.CURRENT = (pcallcontext)
  -- if $generator_creation_supported(S, pcallcontext)
rule PhpStep/generator-create-scope-unsupported: S ~> S[.TODO = eps][.COMPLETION = UNSUPPORTED "generator creation through deferred call scope"]
  -- if S.TODO = (GENERATOR_CREATE porigin) :: ptask_tail*
  -- if S.CURRENT = (pcallcontext)
  -- if ~$generator_creation_supported(S, pcallcontext)

;; Ordinary creation permission follows its original source caller. Changed
;; Closure scopes and implicit protocol calls need their own retained proof.
def $generator_creation_supported(S, pcallcontext) = (~$autoload_context_kind(S, pcallcontext) /\ ($generator_creation_target(S, pcallcontext.TARGET, pcallcontext.CALLSITE) \/ $access_generator_creation(S, pcallcontext)))
def $generator_creation_target(S, porigin, porigin_site?) = $call_selected_valid(S, porigin, porigin_site?)
def $generator_creation_target(S, CLOSURE_TARGET n, porigin_site?) = $call_selected_valid(S, CLOSURE_TARGET n, porigin_site?)
def $generator_creation_target(S, METHOD_TARGET n porigin, porigin_site?) = $generator_creation_method(S, porigin, porigin_site?)
def $generator_creation_target(S, STATIC_METHOD_TARGET porigin_class porigin, porigin_site?) = $generator_creation_method(S, porigin, porigin_site?)
def $generator_creation_target(S, pcalltarget, porigin_site?) = false -- otherwise
def $generator_creation_method(S, porigin, (porigin_site)) = ($generator_creation_method_site($origin_node(S.SOURCES, porigin_site)) /\ $method_target_caller(S.CURRENT, S.FRAMES, porigin, porigin_site) = $closure_source_class(S, porigin_site))
def $generator_creation_method(S, porigin, eps) = false
def $generator_creation_method_site((NExprMethodCall expression phpType20 (SEQUENCE phpType7*) metadata)) = true
def $generator_creation_method_site((NExprNullsafeMethodCall expression phpType20 (SEQUENCE phpType7*) metadata)) = true
def $generator_creation_method_site(pcnode?) = false -- otherwise

def $generator_active(S) = true
  -- if S.FRAMES = pframe :: pframe_tail*
  -- if pframe.TODO = (GENERATOR_RESUME pgeneratorop) :: ptask_tail*
  -- if ~$eval_top_level(S)
  -- if $generator_object(S, pgeneratorop.OBJECT)
  -- if S.OBJECTS[pgeneratorop.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.PHASE = GENERATOR_RUNNING
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.FUNCTION = pgenerator.FUNCTION
def $generator_active(S) = false -- otherwise
def $generator_resume(S, pgeneratorop) = $generator_install($generator_set($save_frame(S[.TODO = (GENERATOR_RESUME pgeneratorop) :: S.TODO]), pgeneratorop.OBJECT, pgenerator[.FRAME = eps][.PHASE = GENERATOR_RUNNING][.FIRST = (pgenerator.PHASE = GENERATOR_FRESH)]), pframe)
  -- if S.OBJECTS[pgeneratorop.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.FRAME = (pframe)
def $generator_return(S, KNOWN pvalue) = $restore_frame($generator_set(S, pgeneratorop.OBJECT, pgenerator[.FRAME = eps][.PHASE = GENERATOR_CLOSED][.RETURN = (pvalue)])[.RESULT = KNOWN PNULL][.TODO = eps][.HELD = eps])
  -- if S.FRAMES = pframe :: pframe_tail*
  -- if pframe.TODO = (GENERATOR_RESUME pgeneratorop) :: ptask_tail*
  -- if S.OBJECTS[pgeneratorop.OBJECT] = GENERATOR pgenerator

def $generator_cache_value(eps) = PNULL
def $generator_cache_value((pvalue)) = pvalue
def $generator_result(S, pgeneratorop) = S[.RESULT = KNOWN PNULL] -- if pgeneratorop.NAME <- ["next", "rewind"]
def $generator_result(S, pgeneratorop) = S[.RESULT = KNOWN (PBOOL (pgenerator.PHASE =/= GENERATOR_CLOSED))]
  -- if pgeneratorop.NAME = "valid"
  -- if S.OBJECTS[pgeneratorop.OBJECT] = GENERATOR pgenerator
def $generator_result(S, pgeneratorop) = S[.RESULT = KNOWN PNULL]
  -- if pgeneratorop.NAME <- ["current", "key", "send", "throw"]
  -- if S.OBJECTS[pgeneratorop.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.PHASE = GENERATOR_CLOSED
def $generator_result(S, pgeneratorop) = S[.RESULT = KNOWN $generator_cached_value(S, pgeneratorop.OBJECT, false)]
  -- if pgeneratorop.NAME <- ["current", "send", "throw"]
  -- if S.OBJECTS[pgeneratorop.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.PHASE =/= GENERATOR_CLOSED
def $generator_result(S, pgeneratorop) = S[.RESULT = KNOWN $generator_cached_value(S, pgeneratorop.OBJECT, true)]
  -- if pgeneratorop.NAME = "key"
  -- if S.OBJECTS[pgeneratorop.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.PHASE =/= GENERATOR_CLOSED
def $generator_result(S, pgeneratorop) = S[.RESULT = KNOWN pvalue]
  -- if pgeneratorop.NAME = "getreturn"
  -- if S.OBJECTS[pgeneratorop.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.RETURN = (pvalue)
def $generator_result(S, pgeneratorop) = $generator_error(S, pgeneratorop, "Exception", $ptascii("Cannot get return value of a generator that hasn't returned"))
  -- if pgeneratorop.NAME = "getreturn"
  -- if S.OBJECTS[pgeneratorop.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.RETURN = eps
def $generator_operate_plain(S, pgeneratorop) = $generator_error(S, pgeneratorop, "Error", $ptascii("Cannot resume an already running generator"))
  -- if S.OBJECTS[pgeneratorop.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.PHASE = GENERATOR_RUNNING
  -- if ~$generator_cache_present(S, pgeneratorop.OBJECT) \/ pgeneratorop.NAME <- ["next", "send", "throw"]
def $generator_operate_plain(S, pgeneratorop) = $generator_resume(S, pgeneratorop[.ADVANCE = (pgeneratorop.NAME <- ["next", "send", "throw"])])
  -- if S.OBJECTS[pgeneratorop.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.PHASE = GENERATOR_FRESH
def $generator_operate_plain(S, pgeneratorop) = $generator_resume(S, pgeneratorop[.ADVANCE = false])
  -- if S.OBJECTS[pgeneratorop.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.PHASE = GENERATOR_PAUSED /\ pgeneratorop.NAME = "next"
def $generator_operate_plain(S, pgeneratorop) = $generator_error(S, pgeneratorop, "Exception", $ptascii("Cannot rewind a generator that was already run"))
  -- if S.OBJECTS[pgeneratorop.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.PHASE =/= GENERATOR_FRESH
  -- if $generator_cache_present(S, pgeneratorop.OBJECT) \/ pgenerator.PHASE =/= GENERATOR_RUNNING
  -- if pgeneratorop.NAME = "rewind" /\ ~pgenerator.FIRST
def $generator_operate_plain(S, pgeneratorop) = $generator_effect(S, pgeneratorop)
  -- if S.OBJECTS[pgeneratorop.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.PHASE <- [GENERATOR_PAUSED, GENERATOR_CLOSED]
  -- if pgeneratorop.NAME <- ["send", "throw"]
def $generator_operate_plain(S, pgeneratorop) = $generator_complete($generator_result(S, pgeneratorop), pgeneratorop)
  -- if S.OBJECTS[pgeneratorop.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.PHASE =/= GENERATOR_FRESH
  -- if $generator_cache_present(S, pgeneratorop.OBJECT) \/ pgenerator.PHASE =/= GENERATOR_RUNNING
  -- if pgeneratorop.NAME =/= "next" \/ pgenerator.PHASE = GENERATOR_CLOSED
  -- if ~(pgeneratorop.NAME <- ["send", "throw"])
  -- if pgeneratorop.NAME =/= "rewind" \/ pgenerator.FIRST
  -- if ~(pgeneratorop.NAME <- ["current", "key"]) \/ $generator_borrowed_readable(S, pgeneratorop.OBJECT, pgeneratorop.NAME = "key")
def $generator_complete(S, pgeneratorop) = S -- if pgeneratorop.LOOP = eps
def $generator_complete(S, pgeneratorop) = $generator_loop_body(S, pgeneratorop)
  -- if pgeneratorop.LOOP =/= eps
  -- if S.COMPLETION = NORMAL
def $generator_complete(S, pgeneratorop) = S -- if pgeneratorop.LOOP =/= eps /\ S.COMPLETION =/= NORMAL
rule PhpStep/generator-resume-result: S ~> $generator_operate(S[.TODO = ptask_tail*], pgeneratorop[.ADVANCE = false])
  -- if S.TODO = (GENERATOR_RESUME pgeneratorop) :: ptask_tail*
  -- if pgeneratorop.ADVANCE
rule PhpStep/generator-resume-complete: S ~> $generator_complete($generator_result(S[.TODO = ptask_tail*], pgeneratorop), pgeneratorop)
  -- if S.TODO = (GENERATOR_RESUME pgeneratorop) :: ptask_tail*
  -- if ~pgeneratorop.ADVANCE
def $throwable_marker(GENERATOR_RESUME pgeneratorop) = (pgeneratorop.NAME = "throw" /\ pgeneratorop.ADVANCE)
rule PhpStep/generator-initialization-throw: S ~> S_chained[.TODO = (THROW_SEARCH n_input) :: ptask_tail*]
  -- if S.TODO = (THROW_SEARCH n_initial) :: (GENERATOR_RESUME pgeneratorop) :: ptask_tail*
  -- if pgeneratorop.NAME = "throw" /\ pgeneratorop.ADVANCE
  -- if pgeneratorop.ARGUMENTS = [POBJECT n_input]
  -- if S.OBJECTS[pgeneratorop.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.PHASE = GENERATOR_CLOSED
