def $generator_nested_task(AT porigin ptask) = ($generator_internal_task(ptask) \/ $generator_nested_task(ptask))
def $generator_nested_task(CHOOSE ptask_true* ptask_false* z) = (~$generator_flat_branch(ptask_true*) \/ ~$generator_flat_branch(ptask_false*))
def $generator_nested_task(ptask) = false -- otherwise
def $generator_flat_branch(eps) = true
def $generator_flat_branch(ptask :: ptask_tail*) = (~$generator_internal_task(ptask) /\ ~$generator_nested_task(ptask) /\ $generator_flat_branch(ptask_tail*))
def $generator_flat_walk(eps) = true
def $generator_flat_walk(ptask :: ptask_tail*) = (~$generator_nested_task(ptask) /\ $generator_flat_walk(ptask_tail*))
def $generator_resume_position((GENERATOR_RESUME pgeneratorop) :: ptask*) = ($generator_resume_ids(ptask*) = eps)
def $generator_resume_position((THROW_SEARCH n) :: (GENERATOR_RESUME pgeneratorop) :: ptask*) = ($generator_resume_ids(ptask*) = eps)
def $generator_resume_position(ptask*) = ($generator_resume_ids(ptask*) = eps) -- otherwise
def $generator_search_valid(S, (THROW_SEARCH n) :: (GENERATOR_RESUME pgeneratorop) :: ptask*) = (pgenerator.PHASE = GENERATOR_CLOSED /\ pgenerator.RETURN = eps /\ $generator_input_valid(S, POBJECT n))
  -- if S.OBJECTS[pgeneratorop.OBJECT] = GENERATOR pgenerator
def $generator_search_valid(S, ptask*) = true -- otherwise
def $generator_flat_tasks(ptask*) = ($generator_flat_walk(ptask*) /\ $generator_resume_position(ptask*))
def $generator_flat_frames(eps) = true
def $generator_flat_frames(pframe :: pframe_tail*) = ($generator_flat_tasks(pframe.TODO) /\ ($generator_resume_ids(pframe.TODO) = eps \/ $generator_resume_head(pframe.TODO)) /\ $generator_flat_frames(pframe_tail*))
def $generator_resume_ids(eps) = eps
def $generator_resume_ids(ptask :: ptask_tail*) = $generator_resume_id(ptask) ++ $generator_resume_ids(ptask_tail*)
def $generator_resume_id(GENERATOR_RESUME pgeneratorop) = [pgeneratorop.OBJECT]
def $generator_resume_id(ptask) = eps -- otherwise
def $generator_saved_ids(eps) = eps
def $generator_saved_ids(pframe :: pframe_tail*) = $generator_resume_ids(pframe.TODO) ++ $generator_saved_ids(pframe_tail*)
def $generator_id_count(eps, n) = 0
def $generator_id_count(n :: nat*, n) = $(1 + $generator_id_count(nat*, n))
def $generator_id_count(n_other :: nat*, n) = $generator_id_count(nat*, n) -- if n_other =/= n
def $generator_running_owners(S, eps, nat*) = true
def $generator_running_owners(S, pnode :: pnode_tail*, nat*) = ($generator_running_owner(S, pnode, nat*) /\ $generator_running_owners(S, pnode_tail*, nat*))
def $generator_running_owner(S, HOBJECT n, nat*) = $generator_owner_object(S.OBJECTS[n], n, nat*)
def $generator_running_owner(S, HARRAY n, nat*) = true
def $generator_running_owner(S, HCELL n, nat*) = true
def $generator_owner_object(GENERATOR pgenerator, n, nat*) = (pgenerator.PHASE =/= GENERATOR_RUNNING \/ $generator_id_count(nat*, n) = 1)
def $generator_owner_object(pobject, n, nat*) = true -- otherwise
def $generator_resume_pairs(S, pcallcontext?, eps) = true
def $generator_resume_pairs(S, (pcallcontext), pframe :: pframe_tail*) = ($generator_resumption_valid(S, pgeneratorop) /\ pgenerator.PHASE = GENERATOR_RUNNING /\ pgenerator.FUNCTION = pcallcontext.FUNCTION /\ pgenerator.CLOSURE = pcallcontext.INSTANCE /\ pframe.ORIGIN = (pgeneratorop.SITE) /\ $generator_resume_pairs(S, pframe.CONTEXT, pframe_tail*))
  -- if pframe.TODO = (GENERATOR_RESUME pgeneratorop) :: ptask*
  -- if S.OBJECTS[pgeneratorop.OBJECT] = GENERATOR pgenerator
def $generator_resume_pairs(S, pcallcontext?, pframe :: pframe_tail*) = false
  -- if pframe.TODO = (GENERATOR_RESUME pgeneratorop) :: ptask*
  -- if pcallcontext? = eps
def $generator_resume_pairs(S, pcallcontext?, pframe :: pframe_tail*) = $generator_resume_pairs(S, pframe.CONTEXT, pframe_tail*)
  -- if ~$generator_resume_head(pframe.TODO)
def $generator_resume_head((GENERATOR_RESUME pgeneratorop) :: ptask*) = true
def $generator_resume_head(ptask*) = false -- otherwise
def $reference_call_frame_site(pcallcontext, pframe) = (pframe.ORIGIN = (pgeneratorop.SITE))
  -- if pframe.TODO = (GENERATOR_RESUME pgeneratorop) :: ptask*
def $useriter_task_ids(GENERATOR_NEXT pgeneratorop) = $generator_loop_ids(pgeneratorop.LOOP)
def $useriter_task_ids(GENERATOR_RESUME pgeneratorop) = $generator_loop_ids(pgeneratorop.LOOP)
def $generator_suspended_cursor_ids(S, eps) = eps
def $generator_suspended_cursor_ids(S, (HOBJECT n) :: pnode_tail*) = $generator_object_cursor_ids(S.OBJECTS[n]) ++ $generator_suspended_cursor_ids(S, pnode_tail*)
def $generator_suspended_cursor_ids(S, (HARRAY n) :: pnode_tail*) = $generator_suspended_cursor_ids(S, pnode_tail*)
def $generator_suspended_cursor_ids(S, (HCELL n) :: pnode_tail*) = $generator_suspended_cursor_ids(S, pnode_tail*)
def $generator_object_cursor_ids(GENERATOR pgenerator) = $useriter_tasks_ids(pframe.TODO)
  -- if pgenerator.FRAME = (pframe)
def $generator_object_cursor_ids(pobject) = eps -- otherwise
def $generator_cursor_owners_valid(S) = $useriter_ids_unique($useriter_tasks_ids(S.TODO) ++ $useriter_frames_ids(S.FRAMES) ++ $generator_suspended_cursor_ids(S, S.ALLOCATIONS))
def $generator_owners_valid(S) = ($heap_unique((HOBJECT n)*) /\ $generator_running_owners(S, S.ALLOCATIONS, $generator_saved_ids(S.FRAMES)) /\ $generator_resume_pairs(S, S.CURRENT, S.FRAMES))
  -- if n* = $generator_resume_ids(S.TODO) ++ $generator_saved_ids(S.FRAMES)
