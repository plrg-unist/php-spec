  -- if S_class.RESULT = KNOWN (PSTRING ptbytes_class)
def $eager_operation_source(S, CLASS_CONST_CLASS expression_class expression_member z) = CLASS_CONST_OBJECT_CAPTURE porigin_site ptbytes_class z
