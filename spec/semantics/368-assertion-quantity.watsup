;; zend_ini_parse_quantity_warn freezes its signed64 quantity before dispatch.
;; Parsing diagnostics take precedence over overflow where the C decoder does.
dec $assertion_quantity_escape_byte(nat) : preqbytes
def $assertion_quantity_escape_byte(10) = $ptascii("\\n")
def $assertion_quantity_escape_byte(13) = $ptascii("\\r")
def $assertion_quantity_escape_byte(9) = $ptascii("\\t")
def $assertion_quantity_escape_byte(12) = $ptascii("\\f")
def $assertion_quantity_escape_byte(11) = $ptascii("\\v")
def $assertion_quantity_escape_byte(27) = $ptascii("\\e")
def $assertion_quantity_escape_byte(92) = $ptascii("\\\\")
def $assertion_quantity_escape_byte(n) = $ptascii("\\x") ++ [n_hex*[n_upper], n_hex*[n_lower]]
  -- if $(n < 32) \/ $(n > 126)
  -- if ~(n <- [10,13,9,12,11,27])
  -- if n_hex* = $ptascii("0123456789ABCDEF")
  -- if n_upper = $(n / 16)
  -- if n_lower = $(n \ 16)
def $assertion_quantity_escape_byte(n) = [n]
  -- if $(n >= 32) /\ $(n <= 126) /\ n =/= 92
dec $assertion_quantity_escape(preqbytes) : preqbytes
def $assertion_quantity_escape(eps) = eps
def $assertion_quantity_escape(n_byte :: n_tail*) = $assertion_quantity_escape_byte(n_byte) ++ $assertion_quantity_escape(n_tail*)
dec $assertion_quantity_diagnostic(preqbytes) : preqbytes
def $assertion_quantity_diagnostic(n*) = $c_string($ptascii("Invalid \"zend.assertions\" setting. ") ++ n*)
dec $assertion_quantity_invalid(preqbytes, preqbytes) : preqbytes
def $assertion_quantity_invalid(n_input*, n_reason*) = $ptascii("Invalid quantity \"") ++ $assertion_quantity_escape(n_input*) ++ $ptascii("\": ") ++ n_reason* ++ $ptascii(", interpreting as \"0\" for backwards compatibility")
dec $assertion_quantity_right_trim(preqbytes) : preqbytes
def $assertion_quantity_right_trim(eps) = eps
def $assertion_quantity_right_trim(n*) = $assertion_quantity_right_trim(n*[0:n_last])
  -- if $(|n*| > 0)
  -- if n_last = $nabs($(|n*| - 1))
  -- if $ntspace(n*[n_last])
def $assertion_quantity_right_trim(n*) = n*
  -- if $(|n*| > 0)
  -- if ~$ntspace(n*[$nabs($(|n*| - 1))])
dec $assertion_quantity_leading(preqbytes) : bool
def $assertion_quantity_leading(n_byte :: n_tail*) = $ntdigit(n_byte)
def $assertion_quantity_leading(eps) = false
dec $assertion_quantity_prefixed(preqbytes) : bool
def $assertion_quantity_prefixed(48 :: n_byte :: n_tail*) = (n_byte <- [88,120,79,111,66,98])
def $assertion_quantity_prefixed(n*) = false -- otherwise
dec $assertion_quantity_bad_prefix(preqbytes, nat) : bool
def $assertion_quantity_bad_prefix(eps, n_base) = true
def $assertion_quantity_bad_prefix(n_byte :: n_tail*, n_base) = true
  -- if $ntspace(n_byte) \/ n_byte <- [43,45]
def $assertion_quantity_bad_prefix(48 :: n_byte :: n_tail*, n_base) = true
  -- if n_byte <- [88,120,79,111] \/ (n_base =/= 16 /\ n_byte <- [66,98])
def $assertion_quantity_bad_prefix(n*, n_base) = false -- otherwise
dec $assertion_quantity_integer(nat, nat) : (int, bool)
def $assertion_quantity_integer(n_sign, n) = ($(-1), true)
  -- if $(n > 18446744073709551615)
def $assertion_quantity_integer(n_sign, n) = ($long_signed(n), true)
  -- if $(n <= 18446744073709551615)
  -- if $(n >= 9223372036854775808)
  -- if ~(n_sign = 1 /\ n = 9223372036854775808)
def $assertion_quantity_integer(1, n) = ($(-n), false)
  -- if $(n <= 9223372036854775808)
def $assertion_quantity_integer(0, n) = (n, false)
  -- if $(n < 9223372036854775808)
dec $assertion_quantity_warning_option(preqbytes) : preqbytes?
def $assertion_quantity_warning_option(n*) = (n*)
dec $assertion_quantity_end(preqbytes, int, bool) : (int, preqbytes?)
def $assertion_quantity_end(n_input*, z, true) = (z, $assertion_quantity_warning_option($assertion_quantity_diagnostic($ptascii("Invalid quantity \"") ++ $assertion_quantity_escape(n_input*) ++ $ptascii("\": value is out of range, using overflow result for backwards compatibility"))))
def $assertion_quantity_end(n_input*, z, false) = (z, eps)
dec $assertion_quantity_suffix(preqbytes, preqbytes, int, bool) : (int, preqbytes?)
def $assertion_quantity_suffix(n_input*, eps, z, b_overflow) = $assertion_quantity_end(n_input*, z, b_overflow)
def $assertion_quantity_suffix(n_input*, n_tail*, z, b_overflow) = (z, $assertion_quantity_warning_option($assertion_quantity_diagnostic($ptascii("Invalid quantity \"") ++ $assertion_quantity_escape(n_input*) ++ $ptascii("\": unknown multiplier \"") ++ $assertion_quantity_escape([n_last]) ++ $ptascii("\", interpreting as \"") ++ $assertion_quantity_escape(n_interpreted*) ++ $ptascii("\" for backwards compatibility"))))
  -- if n_tail* =/= eps
  -- if n_last = n_tail*[$nabs($(|n_tail*| - 1))]
  -- if $assertion_quantity_factor([n_last]) = eps
  -- if n_interpreted* = n_input*[0:$nabs($(|$assertion_quantity_right_trim(n_input*)| - |n_tail*|))]
def $assertion_quantity_suffix(n_input*, n_tail*, z, b_overflow) = (z_result, $assertion_quantity_warning_option($assertion_quantity_diagnostic($ptascii("Invalid quantity \"") ++ $assertion_quantity_escape(n_input*) ++ $ptascii("\", interpreting as \"") ++ $assertion_quantity_escape(n_interpreted*) ++ $assertion_quantity_escape([n_last]) ++ $ptascii("\" for backwards compatibility"))))
  -- if $(|n_tail*| > 1)
  -- if n_last = n_tail*[$nabs($(|n_tail*| - 1))]
  -- if $assertion_quantity_factor([n_last]) = (n_factor)
  -- if z_result = $long_signed($($long_unsigned(z) * n_factor \ 18446744073709551616))
  -- if n_interpreted* = n_input*[0:$nabs($(|$assertion_quantity_right_trim(n_input*)| - |n_tail*|))]
def $assertion_quantity_suffix(n_input*, [n_last], z, b_overflow) = $assertion_quantity_end(n_input*, z_result, b_overflow \/ $(z * n_factor < -9223372036854775808) \/ $(z * n_factor > 9223372036854775807))
  -- if $assertion_quantity_factor([n_last]) = (n_factor)
  -- if z_result = $long_signed($($long_unsigned(z) * n_factor \ 18446744073709551616))
dec $assertion_quantity_digits_result(preqbytes, nat, preqbytes, nat) : (int, preqbytes?)
def $assertion_quantity_digits_result(n_input*, n_sign, n_digits*, n_base) = (0, $assertion_quantity_warning_option($assertion_quantity_diagnostic($assertion_quantity_invalid(n_input*, $ptascii("no digits after base prefix")))))
  -- if $assertion_quantity_prefixed(n_digits*)
  -- if $assertion_quantity_base(n_digits*) = ((n_base, n_unsigned*))
  -- if $assertion_quantity_bad_prefix(n_unsigned*, n_base)
def $assertion_quantity_digits_result(n_input*, n_sign, n_digits*, n_base) = (0, $assertion_quantity_warning_option($assertion_quantity_diagnostic($assertion_quantity_invalid(n_input*, $ptascii("no valid leading digits")))))
  -- if $assertion_quantity_base(n_digits*) = ((n_base, n_unsigned*))
  -- if ~$assertion_quantity_prefixed(n_digits*) \/ ~$assertion_quantity_bad_prefix(n_unsigned*, n_base)
  -- if DIGITS n_value 0 n_tail* = $assertion_quantity_digits(n_base, n_unsigned*, 0, 0)
def $assertion_quantity_digits_result(n_input*, n_sign, n_digits*, n_base) = $assertion_quantity_suffix(n_input*, $nttrim(n_tail*), z, b_overflow)
  -- if $assertion_quantity_base(n_digits*) = ((n_base, n_unsigned*))
  -- if ~$assertion_quantity_prefixed(n_digits*) \/ ~$assertion_quantity_bad_prefix(n_unsigned*, n_base)
  -- if DIGITS n_value n_count n_tail* = $assertion_quantity_digits(n_base, n_unsigned*, 0, 0)
  -- if $(n_count > 0)
  -- if (z, b_overflow) = $assertion_quantity_integer(n_sign, n_value)
def $assertion_quantity_decode(n_input*) = (0, eps)
  -- if $assertion_quantity_trim(n_input*) = eps
def $assertion_quantity_decode(n_input*) = (0, $assertion_quantity_warning_option($assertion_quantity_diagnostic($assertion_quantity_invalid(n_input*, $ptascii("no valid leading digits")))))
  -- if n_trimmed* = $assertion_quantity_trim(n_input*)
  -- if n_trimmed* =/= eps
  -- if (n_sign, n_digits*) = $ntsign(n_trimmed*)
  -- if ~$assertion_quantity_leading(n_digits*)
def $assertion_quantity_decode(n_input*) = (0, $assertion_quantity_warning_option($assertion_quantity_diagnostic($ptascii("Invalid prefix \"0") ++ [n_digits*[1]] ++ $ptascii("\", interpreting as \"0\" for backwards compatibility"))))
  -- if n_trimmed* = $assertion_quantity_trim(n_input*)
  -- if (n_sign, n_digits*) = $ntsign(n_trimmed*)
  -- if $assertion_quantity_leading(n_digits*)
  -- if $assertion_quantity_base(n_digits*) = eps
def $assertion_quantity_decode(n_input*) = $assertion_quantity_digits_result(n_input*, n_sign, n_digits*, n_base)
  -- if n_trimmed* = $assertion_quantity_trim(n_input*)
  -- if (n_sign, n_digits*) = $ntsign(n_trimmed*)
  -- if $assertion_quantity_leading(n_digits*)
  -- if $assertion_quantity_base(n_digits*) = ((n_base, n_unsigned*))

;; Active snapshots are non-owning certificates. Ordinary tasks keep the call's
;; argument owners; exact membership authenticates reentrant completion.
;; Z_PARAM_STR replaces the option argument before ini_set snapshots its return.
;; The original conversion task is borrowed source evidence, never an owner.
