def $assertion_ini_conversion_history(S, n) = S
  -- if (HOBJECT n) <- S.ALLOCATIONS
def $assertion_ini_conversion_history(S, n) = S[.ALLOCATIONS = S.ALLOCATIONS ++ [HOBJECT n]]
  -- if ~((HOBJECT n) <- S.ALLOCATIONS)
dec $assertion_ini_conversion_valid(pstate, passertiniconversion?, pconfigcall) : bool
