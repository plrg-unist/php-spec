  -- if ptask_source = CONFIG_STRING_RESULT pconfigcall_original n porigin_child z_child z_call
  -- if pconfigcall.SENT = [NAMED_SENT (KNOWN pvalue_option), NAMED_SENT (KNOWN pvalue)]
