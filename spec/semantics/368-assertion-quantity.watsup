def $assertion_ini_string_finish(S, pconfigcall, pvalue_option, pvalue) = $config_ini_finish(S_call, pconfigcall_converted, n_option*, pvalue)
  -- if S.TODO = (CONFIG_STRING_RESULT pconfigcall n porigin_child z_child z_call) :: ptask_tail*
