  -- if n_option* = $ptascii("zend.assertions")
  -- if pconfigcall = pconfigcall_original[.SENT = ([NAMED_SENT (KNOWN passertiniconversion.VALUE), NAMED_SENT (KNOWN pvalue)])]
  -- if $ordinary_internal_string_evidence(S, n)
  -- if S_history = $assertion_ini_conversion_history(S, n)
  -- if $config_string_site_valid(S_history, pconfigcall_original, n, porigin_child, z_child, z_call)
def $assertion_ini_conversion_valid(S, passertiniconversion?, pconfigcall) = false -- otherwise
