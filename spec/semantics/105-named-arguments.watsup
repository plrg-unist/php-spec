  -- if n_positional = |pcallcontext.EXTRA|
  -- if $lookup(S.ENV, pfunction.SIGNATURE.PARAMETERS[n_fixed].NAME) = (n_cell)
  -- if S.STORE[n_cell] = DEFINED (PARRAY n_array)
  -- if parray = S.ARRAYS[n_array]
  -- if |parray.ITEMS| = $(n_positional + n)
  -- if $variadic_keys(parray.ITEMS[0:n_positional], 0)
  -- if $named_collected_keys(parray.ITEMS[n_positional:n], pcallcontext.NAMED[0:n])
  -- if $variadic_next(parray, n_positional)
def $named_tail_valid(S, porigin, n) = false -- otherwise
def $call_task_valid(S, NAMED_VARIADIC_RECEIVE porigin n) = $named_tail_valid(S, porigin, n)

;; SEND reads the emitted operand line. Bind only actual call argument roots.
dec $named_send_root(pcoccurrence*, pcpath) : bool
def $named_send_root(pcoccurrence*, pcpath) = true
  -- if $(|pcpath| >= 3)
  -- if n_parent = $(|pcpath| - 3)
  -- if pcpath[n_parent:3] = [PCFIELD 1, PCINDEX n, PCFIELD 1]
  -- if $occurrence_node(pcoccurrence*, pcpath[0:n_parent]) = (NExprFuncCall phpType19 (SEQUENCE phpType7*) metadata)
  -- if $(n < |phpType7*|)
def $named_send_root(pcoccurrence*, pcpath) = false -- otherwise

dec $named_send_entry(pcoccurrence*, pcodeexpr) : pcodeexpr*
def $named_send_entry(pcoccurrence*, CODEEXPR pcpath z b) = [CODEEXPR pcpath z b]
  -- if $named_send_root(pcoccurrence*, pcpath)
def $named_send_entry(pcoccurrence*, CODEEXPR pcpath z b) = eps
  -- if ~$named_send_root(pcoccurrence*, pcpath)
def $named_send_entry(pcoccurrence*, CODEARG pcpath) = eps
def $named_send_entry(pcoccurrence*, CODEWRITE pcpath z) = eps
def $named_send_entry(pcoccurrence*, CODEEFFECT pcpath) = eps
dec $named_send_code(pcoccurrence*, pcodeexpr*) : pcodeexpr*
def $named_send_code(pcoccurrence*, eps) = eps
def $named_send_code(pcoccurrence*, pcodeexpr :: pcodeexpr_tail*) = $named_send_entry(pcoccurrence*, pcodeexpr) ++ $named_send_code(pcoccurrence*, pcodeexpr_tail*)
def $send_unit_code_valid(P, pcode) = ($named_send_code(P.FOLD.SOURCE.OCCURRENCES, pcode.EXPRESSIONS) = $named_send_code(P.FOLD.SOURCE.OCCURRENCES, $compiled_operands(P, P.EXPRESSIONS)))
