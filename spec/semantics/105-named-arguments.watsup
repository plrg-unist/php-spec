  -- if $named_preflight_slots(S, $call_fixed_parameters(pfunction.SIGNATURE.PARAMETERS), pnamedargs.SLOTS, n)
def $named_preflight_stage(S, porigin, n) = false -- otherwise

dec $named_preflight_valid(pstate, porigin, nat) : bool
def $named_preflight_valid(S, porigin, n) = true
