dec $named_slots_valid(pstate, pcalltarget, nat, pnamedslot*, pnamedslot*) : bool
def $named_slots_valid(S, pcalltarget, n, eps, eps) = true
def $named_slots_valid(S, pcalltarget, n, NAMED_HOLE :: pnamedslot*, NAMED_HOLE :: pnamedslot_source*) = $named_slots_valid(S, pcalltarget, $(n + 1), pnamedslot*, pnamedslot_source*)
def $named_slots_valid(S, pcalltarget, n, (NAMED_SENT poperand) :: pnamedslot*, (NAMED_SENT poperand_source) :: pnamedslot_source*) = ($call_sent_operand_valid(S, pcalltarget, n, poperand) /\ $named_slots_valid(S, pcalltarget, $(n + 1), pnamedslot*, pnamedslot_source*))
def $named_slots_valid(S, pcalltarget, n, pnamedslot*, pnamedslot_source*) = false -- otherwise

def $named_entries_valid(S, pcalltarget, n, eps, eps) = true
def $named_entries_valid(S, pcalltarget, n, (preqbytes, poperand) :: (preqbytes_tail, poperand_tail)*, (preqbytes, poperand_source) :: (preqbytes_rest, poperand_rest)*) = ($call_sent_operand_valid(S, pcalltarget, n, poperand) /\ $named_entries_valid(S, pcalltarget, n, (preqbytes_tail, poperand_tail)*, (preqbytes_rest, poperand_rest)*))
def $named_entries_valid(S, pcalltarget, n, (preqbytes, poperand)*, (preqbytes_source, poperand_source)*) = false -- otherwise

dec $named_pending_valid(pstate, pcalltarget, phpType7*, nat, pnamedargs, porigin?, int, nat) : bool
def $named_pending_valid(S, pcalltarget_function, phpType7_remaining*, n, pnamedargs, (porigin), z, n_sent) = true
  -- if ~$call_unpack_site(S, (porigin))
  -- if $call_selected_valid(S, pcalltarget_function, (porigin))
  -- if $call_line_valid(S, (porigin), z)
  -- if S.ORIGIN = (porigin)
  -- if $target_function(S, pcalltarget_function) = (pfunction)
  -- if $origin_node(S.SOURCES, porigin) = (NExprFuncCall phpType19 (SEQUENCE phpType7*) metadata)
  -- if $named_present(phpType7*)
  -- if n_offset = $(n + n_sent)
  -- if $(n_offset <= |phpType7*|)
  -- if n_remaining = $(|phpType7*| - n_offset)
  -- if phpType7_remaining* = phpType7*[n_offset:n_remaining]
  -- if phpType7_prefix* = phpType7*[0:n]
  -- if $named_source_valid(pfunction.SIGNATURE.PARAMETERS, phpType7_prefix*, 0, false, {SLOTS eps, NAMED eps})
  -- if pnamedargs_source = $named_shape(pfunction.SIGNATURE.PARAMETERS, phpType7_prefix*, 0, {SLOTS eps, NAMED eps})
  -- if $named_slots_valid(S, pcalltarget_function, 0, pnamedargs.SLOTS, pnamedargs_source.SLOTS)
  -- if $named_entries_valid(S, pcalltarget_function, |$call_fixed_parameters(pfunction.SIGNATURE.PARAMETERS)|, pnamedargs.NAMED, pnamedargs_source.NAMED)
def $named_pending_valid(S, pcalltarget_function, phpType7*, n, pnamedargs, porigin?, z, n_sent) = false -- otherwise

def $call_task_valid(S, NAMED_ARGS pcalltarget_function phpType7* n pnamedargs porigin? z) = $named_pending_valid(S, pcalltarget_function, phpType7*, n, pnamedargs, porigin?, z, 0)
def $call_task_valid(S, NAMED_SEND pcalltarget_function phpType7* n pnamedargs porigin? z) = $named_pending_valid(S, pcalltarget_function, phpType7*, n, pnamedargs, porigin?, z, 1)

dec $named_collected_keys(pentry*, (preqbytes, poperand)*) : bool
def $named_collected_keys(eps, eps) = true
def $named_collected_keys((ENTRY (KSTRING preqbytes) pitem) :: pentry*, (preqbytes, poperand) :: (preqbytes_tail, poperand_tail)*) = $named_collected_keys(pentry*, (preqbytes_tail, poperand_tail)*)
def $named_collected_keys(pentry*, (preqbytes, poperand)*) = false -- otherwise

dec $named_tail_valid(pstate, porigin, nat) : bool
def $named_tail_valid(S, porigin, n) = true
