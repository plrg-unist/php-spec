;; Literal GLOBALS emits FETCH_GLOBALS before ECHO or a later property read.
;; This selects only the certified first opcode; runtime snapshot creation and
;; the subsequent warning/coercion keep their existing source and heap rules.
dec $source_emission_globals_fetch(pstate, nat, pcpath, expression) : bool
def $source_emission_globals_fetch(S, n, pcpath, NExprVariable (BYTES text) metadata) = true
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (NExprVariable (BYTES text) metadata)
  -- if $cv_source_name(S[.ORIGIN = (PORIGIN n pcpath)], BYTES text) = (ptbytes)
  -- if ptbytes = $ptascii("GLOBALS")
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_expression(pcode.EXPRESSIONS, pcpath) = ((z, false))
  -- if $(z > 0)
  -- if z = $source_line(metadata)
  -- if $compiled_effects(S, PORIGIN n pcpath) = eps
def $source_emission_globals_fetch(S, n, pcpath, expression) = false -- otherwise

;; Ordinary CV/INIT314 and auto-global FETCH_R316 remain disjoint.
def $source_echo_emission_origin(S, n, pcpath, expression) = (PORIGIN n pcpath)
  -- if $source_emission_globals_fetch(S, n, pcpath, expression)
def $source_echo_emission_origin(S, n, pcpath, NExprPropertyFetch expression_receiver (NIdentifier (BYTES text_property) metadata_property) metadata) = (PORIGIN n (pcpath ++ [PCFIELD 0]))
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (NExprPropertyFetch expression_receiver (NIdentifier (BYTES text_property) metadata_property) metadata)
  -- if $source_emission_globals_fetch(S, n, pcpath ++ [PCFIELD 0], expression_receiver)
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_expression(pcode.EXPRESSIONS, pcpath) = ((z_property, false))
  -- if $(z_property > 0)
  -- if z_property = $source_line(metadata_property)
  -- if $compiled_effects(S, PORIGIN n pcpath) = eps
