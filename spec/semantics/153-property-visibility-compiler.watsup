;; zend_inheritance.c:do_inherit_property checks access before type invariance.
;; Private, asymmetric, readonly, static and hooked declarations remain explicit
;; compiler dependencies; this increment admits public/protected backed slots.
def $ppproperty_visibility(2) = PROPERTY_PROTECTED
def $ppproperty_visibility(flags) = PROPERTY_PUBLIC -- otherwise
def $ppproperty_key(2, ptbytes) = [0, 42, 0] ++ ptbytes
def $ppproperty_key(flags, ptbytes) = ptbytes -- otherwise

def $ppproperty_inherit_message(ptbytes_child, ptbytes_parent, ppropertydesc_parent, ppropertydesc_child) = ($ptascii("Access level to ") ++ ptbytes_child ++ $ptascii("::$") ++ ppropertydesc_child.NAME ++ $ptascii(" must be public (as in class ") ++ ptbytes_parent ++ [41])
  -- if ppropertydesc_parent.VISIBILITY = PROPERTY_PUBLIC
  -- if ppropertydesc_child.VISIBILITY = PROPERTY_PROTECTED
def $ppproperty_inherit_message(ptbytes_child, ptbytes_parent, ppropertydesc_parent, ppropertydesc_child) = $ppproperty_override_message(ptbytes_child, ppropertydesc_child.NAME, ptbytes_parent, ppropertydesc_parent.TYPE, ppropertydesc_child.TYPE) -- otherwise

dec $ppproperty_computed(phpType20) : bool
;; zend_compile_assign_coalesce memoizes receiver and computed-name operands.
;; The second writable walk reuses their descriptors without compiling effects.
def $pprefetchbody(P, pcpath, NExprPropertyFetch expression (NIdentifier (BYTES text) metadata_name) metadata) = $pplocate($ppclearvalue($ppmemo(P, pcpath ++ [PCFIELD 0], expression)), pcpath, $source_line(metadata_name))
  -- if P.COMPLETION = PPCNORMAL
def $pprefetchbody(P, pcpath, NExprPropertyFetch expression_base expression_name metadata) = $ppclearvalue($ppmemo($ppmemo(P, pcpath ++ [PCFIELD 0], expression_base), pcpath ++ [PCFIELD 1], expression_name))
  -- if P.COMPLETION = PPCNORMAL
  -- if $ppproperty_computed(expression_name)
def $ppproperty_computed(NIdentifier (BYTES text) metadata) = false
def $ppproperty_computed(phpType20) = true -- otherwise
