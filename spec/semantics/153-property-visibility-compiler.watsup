;; zend_inheritance.c:do_inherit_property checks static/instance identity and
;; access before type invariance. Private declarations keep independent slots.
def $ppproperty_visibility(flags) = PROPERTY_PRIVATE -- if $ppproperty_flag(flags, 4)
def $ppproperty_visibility(flags) = PROPERTY_PROTECTED -- if $ppproperty_flag(flags, 2)
def $ppproperty_visibility(flags) = PROPERTY_PUBLIC -- otherwise
def $ppproperty_key(flags, ptbytes, ptbytes_owner) = [0] ++ ptbytes_owner ++ [0] ++ ptbytes -- if $ppproperty_flag(flags, 4)
def $ppproperty_key(flags, ptbytes, ptbytes_owner) = [0, 42, 0] ++ ptbytes -- if $ppproperty_flag(flags, 2)
def $ppproperty_key(flags, ptbytes, ptbytes_owner) = ptbytes -- otherwise

dec $ppproperty_static_name(bool) : ptbytes
dec $ppproperty_nonfinal_inherit_message(ptbytes, ptbytes, ppropertydesc, ppropertydesc) : ptbytes?
def $ppproperty_nonfinal_inherit_message(ptbytes_child, ptbytes_parent, ppropertydesc_parent, ppropertydesc_child) = eps
  -- if ppropertydesc_parent.VISIBILITY = PROPERTY_PRIVATE
def $ppproperty_nonfinal_inherit_message(ptbytes_child, ptbytes_parent, ppropertydesc_parent, ppropertydesc_child) = ($ptascii("Cannot redeclare ") ++ $ppproperty_static_name(ppropertydesc_parent.STATIC) ++ ptbytes_parent ++ $ptascii("::$") ++ ppropertydesc_parent.NAME ++ $ptascii(" as ") ++ $ppproperty_static_name(ppropertydesc_child.STATIC) ++ ptbytes_child ++ $ptascii("::$") ++ ppropertydesc_child.NAME)
  -- if ppropertydesc_parent.VISIBILITY =/= PROPERTY_PRIVATE
  -- if ppropertydesc_parent.STATIC =/= ppropertydesc_child.STATIC
def $ppproperty_nonfinal_inherit_message(ptbytes_child, ptbytes_parent, ppropertydesc_parent, ppropertydesc_child) = ($ptascii("Cannot redeclare ") ++ $ppproperty_readonly_name(ppropertydesc_parent.READONLY) ++ $ptascii("property ") ++ ptbytes_parent ++ $ptascii("::$") ++ ppropertydesc_parent.NAME ++ $ptascii(" as ") ++ $ppproperty_readonly_name(ppropertydesc_child.READONLY) ++ ptbytes_child ++ $ptascii("::$") ++ ppropertydesc_child.NAME)
  -- if ppropertydesc_parent.VISIBILITY =/= PROPERTY_PRIVATE
  -- if ppropertydesc_parent.STATIC = ppropertydesc_child.STATIC
  -- if ppropertydesc_parent.READONLY =/= ppropertydesc_child.READONLY
def $ppproperty_nonfinal_inherit_message(ptbytes_child, ptbytes_parent, ppropertydesc_parent, ppropertydesc_child) = ($ptascii("Access level to ") ++ ptbytes_child ++ $ptascii("::$") ++ ppropertydesc_child.NAME ++ $ptascii(" must be public (as in class ") ++ ptbytes_parent ++ [41])
  -- if ppropertydesc_parent.VISIBILITY = PROPERTY_PUBLIC
  -- if ppropertydesc_parent.STATIC = ppropertydesc_child.STATIC
  -- if ppropertydesc_parent.READONLY = ppropertydesc_child.READONLY
  -- if ppropertydesc_child.VISIBILITY = PROPERTY_PROTECTED \/ ppropertydesc_child.VISIBILITY = PROPERTY_PRIVATE
def $ppproperty_nonfinal_inherit_message(ptbytes_child, ptbytes_parent, ppropertydesc_parent, ppropertydesc_child) = ($ptascii("Access level to ") ++ ptbytes_child ++ $ptascii("::$") ++ ppropertydesc_child.NAME ++ $ptascii(" must be protected (as in class ") ++ ptbytes_parent ++ $ptascii(") or weaker"))
  -- if ppropertydesc_parent.VISIBILITY = PROPERTY_PROTECTED
  -- if ppropertydesc_parent.STATIC = ppropertydesc_child.STATIC
  -- if ppropertydesc_parent.READONLY = ppropertydesc_child.READONLY
  -- if ppropertydesc_child.VISIBILITY = PROPERTY_PRIVATE
def $ppproperty_nonfinal_inherit_message(ptbytes_child, ptbytes_parent, ppropertydesc_parent, ppropertydesc_child) = $ppproperty_override_message(ptbytes_child, ppropertydesc_child.NAME, ptbytes_parent, ppropertydesc_parent.TYPE, ppropertydesc_child.TYPE) -- otherwise
def $ppproperty_static_name(true) = $ptascii("static ")
def $ppproperty_static_name(false) = $ptascii("non static ")

dec $ppproperty_computed(phpType20) : bool
;; zend_compile_assign_coalesce memoizes receiver and computed-name operands.
;; The second writable walk reuses their descriptors without compiling effects.
def $pprefetchbody(P, pcpath, NExprPropertyFetch expression (NIdentifier (BYTES text) metadata_name) metadata) = $pplocate($ppclearvalue($ppmemo(P, pcpath ++ [PCFIELD 0], expression)), pcpath, $source_line(metadata_name))
  -- if P.COMPLETION = PPCNORMAL
def $pprefetchbody(P, pcpath, NExprPropertyFetch expression_base expression_name metadata) = $ppclearvalue($ppmemo($ppmemo(P, pcpath ++ [PCFIELD 0], expression_base), pcpath ++ [PCFIELD 1], expression_name))
  -- if P.COMPLETION = PPCNORMAL
  -- if $ppproperty_computed(expression_name)
def $ppproperty_computed(NIdentifier (BYTES text) metadata) = false
def $ppproperty_computed(phpType20) = true -- otherwise
