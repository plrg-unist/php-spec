  -- if ~ppropertywarning.BORROWED
  -- if $property_undefined_reference_plan(S) = eps
rule PhpStep/property-undefined-reference-receiver: S ~> S[.COMPLETION = UNSUPPORTED "undefined property reference receiver lifetime"]
  -- if $property_undefined_reference_receiver(S)
dec $property_undefined_read_message(pstate, ppropertywarning) : preqbytes
def $property_undefined_read_message(S, ppropertywarning) = $ptascii("Undefined property: ") ++ $object_name(S, ppropertywarning.OBJECT) ++ $ptascii("::$") ++ $c_string(ppropertywarning.READ.NAME)
dec $property_undefined_read_dispatch(pstate, ppropertywarning) : pstate
def $property_undefined_read_dispatch(S, ppropertywarning) = $error_dispatch(S[.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], 2, $property_undefined_read_message(S, ppropertywarning), ppropertywarning.READ.LINE, DIAGNOSTIC "Warning" $property_undefined_read_message(S, ppropertywarning) ppropertywarning.READ.LINE, PROPERTY_UNDEFINED_RESULT ppropertywarning)
def $property_undefined_read_begin(S, ppropertywarning) = $property_undefined_read_dispatch(S, ppropertywarning)
  -- if $property_undefined_read_plan(S) = (ppropertywarning)
  -- if ppropertywarning.CELL = eps
def $property_undefined_read_begin(S, ppropertywarning) = $property_undefined_read_dispatch(S[.TODO = (DIM_FETCH z) :: ptask_tail*], ppropertywarning)
  -- if $property_undefined_reference_plan(S) = (ppropertywarning)
  -- if S.TODO = (PROPERTY_PREP phpType20 z) :: (DIM_FETCH z) :: ptask_tail*
def $call_task_valid(S, PROPERTY_UNDEFINED_RESULT ppropertywarning) = $property_undefined_read_valid(S, ppropertywarning)
def $task_nodes(PROPERTY_UNDEFINED_RESULT ppropertywarning) = eps
  -- if ppropertywarning.CELL = eps
  -- if ppropertywarning.BORROWED
def $task_nodes(PROPERTY_UNDEFINED_RESULT ppropertywarning) = [HOBJECT ppropertywarning.OBJECT]
  -- if ppropertywarning.CELL = eps
  -- if ~ppropertywarning.BORROWED
def $task_nodes(PROPERTY_UNDEFINED_RESULT ppropertywarning) = [HCELL n]
  -- if ppropertywarning.CELL = (n)
