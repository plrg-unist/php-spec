;; Literal undefined-property FETCH borrows a CV receiver and owns a temporary.
;; A returned reference keeps its actual cell; its captured target is borrowed.
;; The handler may retire a borrowed receiver or populate live storage; the
;; interrupted result remains null in either case.
dec $property_undefined_history(pstate, nat) : bool
def $property_undefined_history(S, n) = true
  -- if $(n < |S.OBJECTS|)
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if $class_throwable_kind(S, porigin, |S.CLASSES|) = eps
  -- if $effective_method(S, porigin, $ptascii("__get"), |S.CLASSES|) = eps
def $property_undefined_history(S, n) = true
  -- if $(n < |S.OBJECTS|)
  -- if S.OBJECTS[n] = STDINSTANCE
def $property_undefined_history(S, n) = false -- otherwise
dec $property_undefined_class(pstate, nat) : bool
def $property_undefined_class(S, n) = true
  -- if $instance_storage_node(S, n)
  -- if (HOBJECT n) <- S.ALLOCATIONS
  -- if $property_undefined_history(S, n)
def $property_undefined_class(S, n) = false -- otherwise

;; These source and slot predicates are heap-graph independent: ownership uses
;; them already at the pending FETCH, before dispatch can enter user code.
dec $property_undefined_borrowed_source(pstate, pnameread) : bool
def $property_undefined_borrowed_source(S, pnameread) = true
  -- if $origin_node(S.SOURCES, pnameread.SITE) = (NExprPropertyFetch expression_receiver phpType20 metadata)
  -- if $reference_cv(expression_receiver) =/= eps
  -- if ~$scope_global(S, [PCFIELD 0])
def $property_undefined_borrowed_source(S, pnameread) = true
  -- if $origin_node(S.SOURCES, pnameread.SITE) = (NExprPropertyFetch (NExprVariable phpType32 metadata_receiver) phpType20 metadata)
  -- if $direct_this(phpType32)
def $property_undefined_borrowed_source(S, pnameread) = false -- otherwise
dec $property_undefined_cv_receiver(pstate, ppropertywarning) : bool
def $property_undefined_cv_receiver(S, ppropertywarning) = true
  -- if $origin_node(S.SOURCES, ppropertywarning.READ.SITE) = (NExprPropertyFetch expression_receiver phpType20 metadata)
  -- if $reference_cv(expression_receiver) = (ptbytes)
  -- if $lookup(S.ENV, ptbytes) = (n)
  -- if $(n < |S.STORE|)
  -- if S.STORE[n] = DEFINED (POBJECT ppropertywarning.OBJECT)
def $property_undefined_cv_receiver(S, ppropertywarning) = true
  -- if $origin_node(S.SOURCES, ppropertywarning.READ.SITE) = (NExprPropertyFetch (NExprVariable phpType32 metadata_receiver) phpType20 metadata)
  -- if $direct_this(phpType32)
  -- if $this_receiver(S) = (ppropertywarning.OBJECT)
def $property_undefined_cv_receiver(S, ppropertywarning) = false -- otherwise

dec $property_undefined_reference_name(phpType19) : bool
def $property_undefined_reference_name(NName phpType33 metadata) = true
def $property_undefined_reference_name(NNameFullyQualified phpType33 metadata) = true
def $property_undefined_reference_name(NNameRelative phpType33 metadata) = true
def $property_undefined_reference_name(phpType19) = false -- otherwise
dec $property_undefined_reference_source(pstate, pnameread) : bool
def $property_undefined_reference_source(S, pnameread) = true
  -- if pnameread.SITE = PORIGIN n pcpath
  -- if $origin_node(S.SOURCES, pnameread.SITE) = (NExprPropertyFetch expression_receiver (NIdentifier (BYTES text) metadata_name) metadata)
  -- if expression_receiver = NExprFuncCall name (SEQUENCE eps) metadata_call
  -- if $property_undefined_reference_name(name)
  -- if $source_emission_noarg_call(S, n, pcpath ++ [PCFIELD 0], expression_receiver) = (z_call)
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_name(pcode.NAMES, pcpath ++ [PCFIELD 0]) = ((ptbytes_name, eps))
  -- if $call_target(S, ptbytes_name, eps) = (pfunction)
  -- if pfunction.SIGNATURE.BYREF
  -- if ~$function_generator(S, pfunction)
def $property_undefined_reference_source(S, pnameread) = false -- otherwise
dec $property_undefined_cell(pstate, nat) : bool
def $property_undefined_cell(S, n) = true
  -- if $(n < |S.STORE|)
  -- if n <- S.REFCELLS /\ (HCELL n) <- S.ALLOCATIONS
  -- if S.STORE[n] = DEFINED pvalue
def $property_undefined_cell(S, n) = false -- otherwise
;; Count owning continuations in this caller's task list, not cleanup history.
dec $property_undefined_cell_task(ptask, nat, porigin) : nat
def $property_undefined_cell_task(PROPERTY_UNDEFINED_RESULT ppropertywarning, n, porigin) = 1
  -- if ppropertywarning.CELL = (n) /\ ppropertywarning.READ.SITE = porigin
def $property_undefined_cell_task(AT porigin_at ptask, n, porigin) = $property_undefined_cell_task(ptask, n, porigin)
def $property_undefined_cell_task(ERROR_HANDLER_INVOKE perrorcall, n, porigin) = $property_undefined_cell_task(perrorcall.RESUME, n, porigin)
def $property_undefined_cell_task(ERROR_HANDLER_RESULT perrorcall, n, porigin) = $property_undefined_cell_task(perrorcall.RESUME, n, porigin)
def $property_undefined_cell_task(ERROR_HANDLER_CLEAN perrorcall, n, porigin) = $property_undefined_cell_task(perrorcall.RESUME, n, porigin)
def $property_undefined_cell_task(ptask, n, porigin) = 0 -- otherwise
dec $property_undefined_cell_tasks(ptask*, nat, porigin) : nat
def $property_undefined_cell_tasks(eps, n, porigin) = 0
def $property_undefined_cell_tasks(ptask :: ptask_tail*, n, porigin) = $($property_undefined_cell_task(ptask, n, porigin) + $property_undefined_cell_tasks(ptask_tail*, n, porigin))
dec $property_undefined_source_borrow(pstate, ppropertywarning) : bool
def $property_undefined_source_borrow(S, ppropertywarning) = (ppropertywarning.BORROWED = $property_undefined_borrowed_source(S, ppropertywarning.READ))
  -- if ppropertywarning.CELL = eps
def $property_undefined_source_borrow(S, ppropertywarning) = (ppropertywarning.BORROWED /\ ~ppropertywarning.FREEING /\ $property_undefined_reference_source(S, ppropertywarning.READ))
  -- if ppropertywarning.CELL = (n)

dec $property_undefined_slot(pstate, nat, ptbytes) : bool
def $property_undefined_slot(S, n, ptbytes) = true
  -- if $instance_storage_freeing(S, n)
  -- if $instance_storage_untyped_unset_desc(S, n, ptbytes) =/= eps
def $property_undefined_slot(S, n, ptbytes) = true
  -- if ~$instance_storage_freeing(S, n)
  -- if $objectprops_at(S.OBJECTPROPS, n) = (ppropertyslot_all*)
  -- if $property_slot_at(ppropertyslot_all*, ptbytes) = eps
def $property_undefined_slot(S, n, ptbytes) = true
  -- if ~$instance_storage_freeing(S, n)
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $objectprops_at(S.OBJECTPROPS, n) = (ppropertyslot_all*)
  -- if $property_slot_at(ppropertyslot_all*, ptbytes) = (ppropertyslot)
  -- if ppropertyslot.STATE = PROP_UNSET
  -- if $property_desc_at($property_layout(S, porigin, |S.CLASSES|), ptbytes) = (ppropertydesc)
  -- if ppropertydesc.TYPE = eps
def $property_undefined_slot(S, n, ptbytes) = false -- otherwise

;; KEY was resolved in the interrupted caller, not in the handler's scope.
;; Only the future mode rechecks its still-pending physical slot visit.
dec $property_undefined_carrier(pstate, ppropertywarning) : bool
def $property_undefined_carrier(S, ppropertywarning) = true
  -- if ppropertywarning.CELL = (n)
  -- if ~ppropertywarning.FREEING /\ ppropertywarning.BORROWED
  -- if $property_undefined_cell(S, n)
  -- if $($property_undefined_cell_tasks(S.TODO, n, ppropertywarning.READ.SITE) <= 1)
def $property_undefined_carrier(S, ppropertywarning) = true
  -- if ppropertywarning.CELL = eps
  -- if ~ppropertywarning.FREEING
  -- if ppropertywarning.BORROWED
def $property_undefined_carrier(S, ppropertywarning) = true
  -- if ppropertywarning.CELL = eps
  -- if ~ppropertywarning.FREEING
  -- if ~ppropertywarning.BORROWED
  -- if $property_undefined_class(S, ppropertywarning.OBJECT)
  -- if ~$instance_storage_freeing(S, ppropertywarning.OBJECT)
def $property_undefined_carrier(S, ppropertywarning) = true
  -- if ppropertywarning.CELL = eps
  -- if ppropertywarning.FREEING
  -- if $instance_storage_untyped_unset_desc(S, ppropertywarning.OBJECT, ppropertywarning.KEY) =/= eps
def $property_undefined_carrier(S, ppropertywarning) = false -- otherwise
