  -- if S.STORE[n] = DEFINED pvalue
def $property_undefined_cell(S, n) = false -- otherwise
;; Count owning continuations in this caller's task list, not cleanup history.
dec $property_undefined_cell_task(ptask, nat, porigin) : nat
def $property_undefined_cell_task(PROPERTY_UNDEFINED_RESULT ppropertywarning, n, porigin) = 1
  -- if ppropertywarning.CELL = (n) /\ ppropertywarning.READ.SITE = porigin
def $property_undefined_cell_task(AT porigin_at ptask, n, porigin) = $property_undefined_cell_task(ptask, n, porigin)
def $property_undefined_cell_task(ERROR_HANDLER_INVOKE perrorcall, n, porigin) = $property_undefined_cell_task(perrorcall.RESUME, n, porigin)
def $property_undefined_cell_task(ERROR_HANDLER_RESULT perrorcall, n, porigin) = $property_undefined_cell_task(perrorcall.RESUME, n, porigin)
def $property_undefined_cell_task(ERROR_HANDLER_CLEAN perrorcall, n, porigin) = $property_undefined_cell_task(perrorcall.RESUME, n, porigin)
def $property_undefined_cell_task(ptask, n, porigin) = 0 -- otherwise
dec $property_undefined_cell_tasks(ptask*, nat, porigin) : nat
def $property_undefined_cell_tasks(eps, n, porigin) = 0
def $property_undefined_cell_tasks(ptask :: ptask_tail*, n, porigin) = $($property_undefined_cell_task(ptask, n, porigin) + $property_undefined_cell_tasks(ptask_tail*, n, porigin))
dec $property_undefined_source_borrow(pstate, ppropertywarning) : bool
def $property_undefined_source_borrow(S, ppropertywarning) = (ppropertywarning.BORROWED = $property_undefined_borrowed_source(S, ppropertywarning.READ))
  -- if ppropertywarning.CELL = eps
def $property_undefined_source_borrow(S, ppropertywarning) = (ppropertywarning.BORROWED /\ ~ppropertywarning.FREEING /\ $property_undefined_reference_source(S, ppropertywarning.READ))
  -- if ppropertywarning.CELL = (n)

