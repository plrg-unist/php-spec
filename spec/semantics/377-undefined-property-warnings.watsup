  -- if $property_undefined_reference_name(name)
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (NExprFuncCall name (SEQUENCE ([(NArg ABSENT (NExprVariable (BYTES text_first) metadata_first) (BOOLEAN false) (BOOLEAN false) metadata_argument_first), (NArg ABSENT (NExprVariable (BYTES text_second) metadata_second) (BOOLEAN false) (BOOLEAN false) metadata_argument_second)])) metadata_call)
