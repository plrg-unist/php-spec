dec $property_undefined_read_message(pstate, ppropertywarning) : preqbytes
def $property_undefined_read_message(S, ppropertywarning) = $ptascii("Undefined property: ") ++ $object_name(S, ppropertywarning.OBJECT) ++ $ptascii("::$") ++ $c_string(ppropertywarning.READ.NAME)
dec $property_undefined_read_dispatch(pstate, ppropertywarning) : pstate
def $property_undefined_read_dispatch(S, ppropertywarning) = $error_dispatch(S[.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], 2, $property_undefined_read_message(S, ppropertywarning), ppropertywarning.READ.LINE, DIAGNOSTIC "Warning" $property_undefined_read_message(S, ppropertywarning) ppropertywarning.READ.LINE, PROPERTY_UNDEFINED_RESULT ppropertywarning)
