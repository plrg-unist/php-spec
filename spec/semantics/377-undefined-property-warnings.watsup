def $property_undefined_positional_read_shape(S, ptask, poperand, pbase, z_send) = eps -- otherwise
def $error_read_state_shape(S, ptask, poperand, pbase) = $property_undefined_positional_read_shape(S, ptask, poperand, pbase, z_send)
