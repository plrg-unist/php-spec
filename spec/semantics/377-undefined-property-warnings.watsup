;; A deferred named SEND retains the CV's documentary operand line while the
;; compiled SEND uses its label line. Capture that producer before resolution.
dec $property_undefined_named_send_line(pstate, ptask) : int?
def $property_undefined_named_send_line(S, NAMED_SEND pcalltarget eps 0 pnamedargs (PORIGIN n pcpath_call) z_call) = (z_send)
  -- if pnamedargs = {SLOTS eps, NAMED eps}
  -- if $(|pcpath_call| > 0)
  -- if n_parent = $(|pcpath_call| - 1)
  -- if pcpath = pcpath_call[0:n_parent]
  -- if pcpath_call = pcpath ++ [PCFIELD 0]
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (NExprPropertyFetch expression_receiver (NIdentifier (BYTES text_name) metadata_name) metadata_property)
  -- if expression_receiver = NExprFuncCall name (SEQUENCE ([(NArg (NIdentifier (BYTES text_parameter) metadata_parameter) (NExprVariable (BYTES text_argument) metadata_value) (BOOLEAN false) (BOOLEAN false) metadata_argument)])) metadata_call
  -- if $property_undefined_reference_source(S, {SITE PORIGIN n pcpath, NAME $base64(text_name), LINE $source_line(metadata_name)})
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_name(pcode.NAMES, pcpath_call) = ((ptbytes_callee, eps))
  -- if $call_target(S, ptbytes_callee, eps) = (pfunction)
  -- if pcalltarget = pfunction.ORIGIN
  -- if $call_task_valid(S, NAMED_SEND pcalltarget eps 0 pnamedargs (PORIGIN n pcpath_call) z_call)
  -- if $code_expression_at_source(S, PORIGIN n pcpath_call, eps) = (z_call)
  -- if $code_expression_at_source(S, PORIGIN n pcpath_call, [PCFIELD 1, PCINDEX 0, PCFIELD 1]) = (z_send)
  -- if z_send =/= $source_line(metadata_value)
def $property_undefined_named_send_line(S, ptask) = eps -- otherwise
def $error_read_state_shape(S, ptask, poperand, pbase) = $echo_dynamic_named_read_shape(S, ptask, poperand, pbase, z_send)
  -- if $property_undefined_named_send_line(S, ptask) = (z_send)
;; The second deferred positional SEND preserves its already-captured prefix
;; and borrowed INPUT while reporting the actual emitted argument-list line.
dec $property_undefined_positional_send_line(pstate, ptask) : int?
def $property_undefined_positional_send_line(S, CALL_SEND pcalltarget eps 1 poperand* (PORIGIN n pcpath_call) z_call) = (z_send)
  -- if |poperand*| = 1
  -- if $(|pcpath_call| > 0)
  -- if n_parent = $(|pcpath_call| - 1)
  -- if pcpath = pcpath_call[0:n_parent]
  -- if pcpath_call = pcpath ++ [PCFIELD 0]
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (NExprPropertyFetch expression_receiver (NIdentifier (BYTES text_name) metadata_name) metadata_property)
  -- if expression_receiver = NExprFuncCall name (SEQUENCE ([(NArg ABSENT (NExprVariable (BYTES text_first) metadata_first) (BOOLEAN false) (BOOLEAN false) metadata_argument_first), (NArg ABSENT (NExprVariable (BYTES text_second) metadata_second) (BOOLEAN false) (BOOLEAN false) metadata_argument_second)])) metadata_call
  -- if $property_undefined_reference_source(S, {SITE PORIGIN n pcpath, NAME $base64(text_name), LINE $source_line(metadata_name)})
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_name(pcode.NAMES, pcpath_call) = ((ptbytes_callee, eps))
  -- if $call_target(S, ptbytes_callee, eps) = (pfunction)
  -- if pcalltarget = pfunction.ORIGIN
  -- if $call_task_valid(S, CALL_SEND pcalltarget eps 1 poperand* (PORIGIN n pcpath_call) z_call)
  -- if $code_expression_at_source(S, PORIGIN n pcpath_call, eps) = (z_call)
  -- if $code_expression_at_source(S, PORIGIN n pcpath_call, [PCFIELD 1, PCINDEX 1, PCFIELD 1]) = (z_send)
  -- if z_send =/= $source_line(metadata_second)
def $property_undefined_positional_send_line(S, ptask) = eps -- otherwise
dec $property_undefined_positional_read_shape(pstate, ptask, poperand, pbase, int) : perrorread?
def $property_undefined_positional_read_shape(S, CALL_SEND pcalltarget eps 1 poperand* (porigin) z_call, poperand_input, pbase, z_send) = (perrorread[.LINE = z_send])
  -- if $call_argument_expression(S, (porigin), 1) = NExprVariable (BYTES text_second) metadata_second
