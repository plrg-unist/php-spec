;; Missing CV truth reads consume the original null, even if a handler defines
;; the same name. Each suspended consumer is reconstructed from checked source.
;; The ordinary profile emits BOOL results into distinct temporary slots.
def $error_simple_read(CHOOSE ptask_true* ptask_false* z) = true
def $error_simple_read(SHORT_RESULT b expression z_left z_right) = true
def $error_simple_read(TRUTH_RESULT b z) = true
def $error_simple_read(SELECT_VALUE phpType5 expression z_cond z_true z_false) = true
def $error_read_line(CHOOSE ptask_true* ptask_false* z, z_origin) = z
def $error_read_line(SHORT_RESULT b expression z_left z_right, z_origin) = z_left
def $error_read_line(TRUTH_RESULT b z, z_origin) = z
def $error_read_line(SELECT_VALUE phpType5 expression z_cond z_true z_false, z_origin) = z_cond

