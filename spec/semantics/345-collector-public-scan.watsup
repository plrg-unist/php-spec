;; zend_get_executed_scope stops at the internal Fiber::resume/throw frame.
;; Its builtin class has no user-class origin and grants no nonpublic access.
def $gc_worker_guard_scope(S, pgcguard) = eps -- if pgcguard.PUBLIC =/= eps
def $destructor_private_error(S, pdestructorcall, ptbytes) = $throwable_allocate_at(S, "Error", ptbytes_message, pgcpublic.API.SITE, pgcpublic.API.LINE, $fiber_caller_trace(S))
  -- if S.CURRENT = eps
  -- if $gc_worker_guard_at(S) = (pgcguard)
  -- if pgcguard.PUBLIC = (pgcpublic)
  -- if $destructor_method(S, pdestructorcall.OBJECT) = (pmethoddesc)
  -- if ptbytes_message = $ptascii("Call to ") ++ $method_visibility_name(pmethoddesc.VISIBILITY) ++ [32] ++ $object_name(S, pdestructorcall.OBJECT) ++ $ptascii("::__destruct() from scope Fiber")
def $gc_worker_guard_done(S, pgcguard) = $gc_worker_public_keep(S_scan, pgcguard.OBJECT)
  -- if pgcguard.PUBLIC = (pgcpublic)
  -- if S_dropped = $gc_worker_guard_drop(S, pgcguard)
  -- if S_scan = S_dropped[.TODO = [GC_WORKER_SCAN pgcpublic[.INDEX = $(pgcguard.INDEX + 1)][.PENDING = pgcguard.PENDING]]]
def $gc_worker_public_keep(S, n_object) = $gc_bare_record(S, n_object)
  -- if $heap_owners($heap_graph(S), HOBJECT n_object) = 0
  -- if $gc_ordinary_node(S, HOBJECT n_object)
def $gc_worker_public_keep(S, n_object) = S
  -- if $($heap_owners($heap_graph(S), HOBJECT n_object) > 0)

rule PhpStep/gc-worker-public-scan-idle: S ~> $gc_worker_scan_finish(S, pgcpublic)
  -- if S.TODO = [GC_WORKER_SCAN pgcpublic]
  -- if $gc_worker_scan_valid(S, pgcpublic)
  -- if $gc_worker_scan_target(S, pgcpublic.INDEX, pgcpublic.END) = eps
def $gc_worker_scan_finish(S, pgcpublic) = $fiber_back($gc_worker_public_suspend(S_clear, pgcpublic.API), PNULL, false)
  -- if pgcpublic.PENDING = eps
  -- if S_clear = S[.GC.BUFFER = $gc_scan_clear(S.GC.BUFFER, pgcpublic.INDEX, pgcpublic.END, 0)]
def $gc_worker_scan_finish(S, pgcpublic) = $fiber_back($gc_worker_public_suspend(S_clear, pgcpublic.API), POBJECT n_error, true)
  -- if pgcpublic.PENDING = (n_error)
  -- if S_clear = S[.GC.BUFFER = $gc_scan_clear(S.GC.BUFFER, pgcpublic.INDEX, pgcpublic.END, 0)]

;; Main -> public resume has no gc_call_destructors_in_fiber return loop.
;; Park the actual callback VM and guard without dropping the cache. Replace
;; the old public caller by the real suspend site; it owns no additional zval.
def $gc_worker_public_guard_live(S) = true
  -- if $gc_worker_guard_at(S) = (pgcguard)
  -- if pgcguard.PUBLIC =/= eps
def $gc_worker_public_guard_live(S) = false -- otherwise
def $gc_worker_public_frames(eps, pgcguard, pgcguard_new) = eps
def $gc_worker_public_frames(pframe :: pframe_tail*, pgcguard, pgcguard_new) = pframe[.TODO = $gc_worker_pending_tasks(pframe.TODO, pgcguard, pgcguard_new)] :: $gc_worker_public_frames(pframe_tail*, pgcguard, pgcguard_new)
def $fiber_suspend(S, pconfigcall, pvalue) = $fiber_suspend_save(S_parked, pconfigcall, pvalue)
  -- if $gc_worker_guard_at(S) = (pgcguard)
  -- if pgcguard.PUBLIC = (pgcpublic)
  -- if $fiber_at(S, pgcguard.WORKER) = (pfiber)
  -- if pfiberapi = {SITE pconfigcall.SITE, OBJECT pgcguard.WORKER, KIND (INTRINSIC_FIBER_SUSPEND), START eps, SENT $fiber_config_sent(pconfigcall), LINE pconfigcall.LINE, SEQUENCE pfiber.SEQUENCE}
  -- if pgcguard_new = pgcguard[.PUBLIC = (pgcpublic[.API = pfiberapi])]
  -- if S_parked = $gc_worker_put_guard(S[.TODO = $gc_worker_pending_tasks(S.TODO, pgcguard, pgcguard_new)][.FRAMES = $gc_worker_public_frames(S.FRAMES, pgcguard, pgcguard_new)], pgcguard.WORKER, (pgcguard_new))

;; A restored parked view has no public caller. Its actual stored VM, live
;; guard and matching FIBER_CONTINUE authenticate the callback instead.
