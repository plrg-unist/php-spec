;; Reentry before the collecting caller returns uses the same genuine plan
;; and physical target. Later passes may move/reuse slots and need their own
;; continuation admission; do not reuse a historical plan as live authority.
def $gc_worker_public_reentry_ready(S, pgcguard) = true
  -- if S.GC.WORKER = (pgcguard.WORKER)
  -- if $fiber_at(S, pgcguard.WORKER) = (pfiber)
  -- if pfiber.GC = (pgcworker)
  -- if pgcworker.GUARD = (pgcguard)
  -- if $gc_worker_public_parked(S, pgcguard.WORKER, pfiber)
  -- if pgcguard.PUBLIC = (pgcpublic)
  -- if S.GC.PLAN = (pgcplan)
  -- if $gc_plan_live(S, pgcplan)
  -- if pgcpublic.SOURCE = pgcplan.CALL[.PENDING = eps]
  -- if pgcpublic.END = S.GC.SCAN.END
  -- if pgcguard.INDEX = S.GC.SCAN.INDEX
  -- if (HOBJECT pgcguard.OBJECT) <- pgcplan.DTORS
  -- if $gc_slot_find(S.GC.BUFFER, HOBJECT pgcguard.OBJECT, 0) = (pgcguard.INDEX)
  -- if S.GC.BUFFER[pgcguard.INDEX] = GC_ROOT (HOBJECT pgcguard.OBJECT)
def $gc_worker_public_reentry_ready(S, pgcguard) = false -- otherwise
def $gc_worker_public_resume(S, pconfigcall, pvalue) = $gc_worker_public_reentry(S, pconfigcall, pvalue)
  -- if pconfigcall.OWNER = (n)
  -- if S.GC.WORKER = (n)
  -- if $fiber_at(S, n) = (pfiber)
  -- if pfiber.GC = (pgcworker)
  -- if pgcworker.GUARD = (pgcguard)
  -- if pgcguard.PUBLIC =/= eps
def $gc_worker_public_reentry(S, pconfigcall, pvalue) = $fiber_activate(S_bound, n, pfiber_bound, pfiberapi, false, pvalue)
  -- if pconfigcall.OWNER = (n)
  -- if $fiber_at(S, n) = (pfiber)
  -- if pfiber.GC = (pgcworker)
  -- if pgcworker.GUARD = (pgcguard)
  -- if $gc_worker_public_reentry_ready(S, pgcguard)
  -- if pgcguard.PUBLIC = (pgcpublic)
  -- if pfiber.VM = (pfibervm)
  -- if pfiberapi = {SITE pconfigcall.SITE, OBJECT n, KIND (pconfigcall.KIND), START eps, SENT $fiber_config_sent(pconfigcall), LINE pconfigcall.LINE, SEQUENCE S.FIBERSEQ}
  -- if pgcguard_new = pgcguard[.PUBLIC = (pgcpublic[.API = pfiberapi])]
  -- if pfibervm_bound = pfibervm[.TODO = $gc_worker_pending_tasks(pfibervm.TODO, pgcguard, pgcguard_new)][.FRAMES = $gc_worker_public_frames(pfibervm.FRAMES, pgcguard, pgcguard_new)]
  -- if pfiber_bound = pfiber[.GC = (pgcworker[.GUARD = (pgcguard_new)])][.VM = (pfibervm_bound)]
  -- if S_bound = $fiber_put(S, n, pfiber_bound)
def $gc_worker_public_reentry(S, pconfigcall, pvalue) = S[.COMPLETION = UNSUPPORTED "public collector callback reentry after its physical pass changed"] -- otherwise
