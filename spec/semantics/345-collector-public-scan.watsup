def $gc_worker_internal_pending(S, pgcpublic, pgcplan) = S -- if pgcpublic.PENDING = eps
def $gc_worker_internal_pending(S, pgcpublic, pgcplan) = $gc_worker_plan_set($fiber_close_chain(S, n_error, pgcplan.CALL.PENDING), pgcplan[.CALL.PENDING = (n_error)])
  -- if pgcpublic.PENDING = (n_error)
def $gc_worker_scan_finish(S, pgcpublic) = $gc_worker_internal_idle(S, pgcpublic)
  -- if $gc_worker_api(pgcpublic.API)
def $gc_worker_guard_done(S, pgcguard) = $gc_worker_internal_next($gc_worker_public_keep(S_scan, pgcguard.OBJECT), pgcpublic_next)
