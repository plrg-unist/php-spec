def $gc_worker_internal_next(S, pgcpublic) = $gc_worker_scan_enter(S, pgcpublic, n_slot, n_object)
  -- if $gc_worker_scan_target(S, pgcpublic.INDEX, pgcpublic.END) = ((n_slot, n_object))
def $gc_worker_internal_next(S, pgcpublic) = $gc_worker_internal_idle(S, pgcpublic)
  -- if $gc_worker_scan_target(S, pgcpublic.INDEX, pgcpublic.END) = eps
def $gc_worker_internal_idle(S, pgcpublic) = $gc_worker_idle($gc_worker_plan_set(S_pending, pgcplan_done), pgcpublic.API.OBJECT, pgcplan_done)
  -- if S.GC.PLAN = (pgcplan)
