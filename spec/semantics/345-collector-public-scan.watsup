;; The real local loop can finish before visiting a newly marked low slot.
;; This outcome neither calls that destructor nor adds it to the DONE prefix.
def $gc_worker_internal_progress(S, pgcplan, eps) = eps
def $gc_worker_internal_progress(S, pgcplan, pnode :: pnode_tail*) = (GC_SKIPPED pnode) :: $gc_worker_internal_progress(S, pgcplan, pnode_tail*)
