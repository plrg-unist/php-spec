;; zend_generator_resume -> zend_throw_exception_internal at a real C root.
;; Render, release the reported exception, then catch bailout and mark all
;; destructors called. SOURCE/TEXT/FROZEN borrow history; only REPORT owns ex.

syntax pgenfatal = {SOURCE ptask, OBJECT nat, HANDLERS (pvalue?)*, METHOD porigin?, TEXT preqbytes?, REPORT pobjectprops?, FROZEN pcompletion}

dec $generator_request_fatal_source(pstate, pgenfatal, ptask*) : bool
dec $generator_request_fatal_history(pstate, pgenfatal) : pstate
dec $generator_request_fatal_selected(pstate) : pgenfatal?
dec $generator_request_fatal_begin(pstate, pgenfatal) : pstate
dec $generator_request_fatal_tail(ptask*, pgenfatal) : ptask*?
dec $generator_request_report_at(ptask*) : pgenfatal?
dec $generator_request_bailout_tail(ptask*, pgenfatal) : ptask*?
dec $generator_request_bailout_at(ptask*) : pgenfatal?
dec $generator_request_fatal_method(pstate, pgenfatal) : bool
dec $generator_request_report_valid(pstate, pgenfatal) : bool
dec $generator_request_bailout_valid(pstate, pgenfatal) : bool
dec $generator_request_report_completion(pgenfatal) : pcompletion
dec $generator_request_report_state(pstate, pgenfatal) : pstate
dec $generator_request_report_text(pstate, pgenfatal) : preqbytes
dec $generator_request_report_finish(pstate, pgenfatal) : pstate
dec $generator_request_report_snapshot_valid(pstate, pgenfatal) : bool
dec $generator_request_report_kind(pstate, nat) : text
dec $generator_request_report_snapshot(pstate, nat) : pobjectprops
dec $generator_request_report_frozen(pstate, pgenfatal) : pcompletion
dec $generator_request_string_tail(pstate, nat, porigin, ptask*) : bool
dec $generator_request_report_abrupt(pstate) : bool
dec $generator_request_close_trace(pstate, pcallcontext) : bool

;; Request dtor_obj resumes the Generator from C with no execute_data caller.
;; Its saved creation context remains source authority, not a trace callsite.
def $generator_request_close_trace(S, pcallcontext) = true
  -- if S.FRAMES = pframe :: pframe_tail*
  -- if pframe.TODO = (GENERATOR_CLOSE_DONE pgenclose) :: ptask_tail*
  -- if pgenclose.CONTEXT = pcallcontext
  -- if pgenclose.CALLER = eps /\ pgenclose.CALLSITE = eps
  -- if S_root = $constant_frame_scope(S, pframe, pframe_tail*)
  -- if $generator_request_root(S_root)
  -- if $generator_close_done_valid(S_root, pgenclose)
def $generator_request_close_trace(S, pcallcontext) = false -- otherwise
def $generator_context_trace_kind(S, pcallcontext) = true
  -- if $generator_request_close_trace(S, pcallcontext)
def $trace_context(S, pbinding*, (pcallcontext)) = [{FILE eps, LINE $(-1), FUNCTION $trace_context_function(S, pcallcontext), CLASS $trace_context_class(S, pcallcontext), TYPE $trace_context_type(S, pcallcontext), ARGS ($trace_indexed_args(pvalue*, 0) ++ $trace_named_args(S, pcallcontext.NAMED)), HASARGS true}]
  -- if $generator_request_close_trace(S, pcallcontext)
  -- if ~$closure_call_target($context_target(pcallcontext))
  -- if $function_at($all_functions(S), pcallcontext.FUNCTION) = (pfunction)
  -- if psparam* = $call_fixed_parameters(pfunction.SIGNATURE.PARAMETERS)
  -- if pvalue* = $trace_parameters(S, pbinding*, (psparam.NAME)*, pcallcontext.ARGC) ++ $trace_extra(S, pcallcontext.EXTRA)

;; Preserve only the original handler lookup view. The retained actual tail
;; authenticates the transfer after the reported exception has been released.
def $generator_request_fatal_history(S, pgenfatal) = S[.ORIGIN = eps][.EXCEPTIONHANDLER = eps][.EXCEPTIONHANDLERS = pgenfatal.HANDLERS]
def $generator_request_fatal_source(S, pgenfatal, (GENERATOR_CLOSE_DONE pgenclose_done) :: ptask_tail*) = true
  -- if pgenfatal.SOURCE = GENERATOR_CLOSE_DONE pgenclose
  -- if pgenclose.PENDING = (pgenfatal.OBJECT)
  -- if pgenclose_done = pgenclose[.PENDING = eps]
  -- if S_history = $generator_request_fatal_history(S, pgenfatal)[.TODO = (GENERATOR_CLOSE_DONE pgenclose_done) :: ptask_tail*]
  -- if $generator_request_root(S_history) /\ $generator_request_tail(S_history, ptask_tail*)
  -- if $generator_close_done_valid(S_history, pgenclose_done)
def $generator_request_fatal_source(S, pgenfatal, (EXCEPTION_HANDLER_RESULT pexceptioncall) :: (GENERATOR_REQUEST_RESUME pgenclose) :: ptask_tail*) = true
  -- if pgenfatal.SOURCE = THROW_SEARCH pgenfatal.OBJECT
  -- if S_history = $generator_request_fatal_history(S, pgenfatal)[.TODO = (EXCEPTION_HANDLER_RESULT pexceptioncall) :: (GENERATOR_REQUEST_RESUME pgenclose) :: ptask_tail*]
  -- if $exception_task_scope(S_history) /\ $exception_result_valid(S_history, pexceptioncall)
  -- if S_history.EXCEPTIONHANDLERS = (pexceptioncall.CALLBACK) :: (pvalue?)*
  -- if $generator_request_resume_valid(S_history, pgenclose)
def $generator_request_fatal_source(S, pgenfatal, (GENERATOR_REQUEST_RESUME pgenclose) :: ptask_tail*) = true
  -- if pgenfatal.SOURCE = THROW_SEARCH pgenfatal.OBJECT
  -- if S_history = $generator_request_fatal_history(S, pgenfatal)[.TODO = (GENERATOR_REQUEST_RESUME pgenclose) :: ptask_tail*]
  -- if $generator_request_resume_valid(S_history, pgenclose)
def $generator_request_fatal_source(S, pgenfatal, ptask*) = false -- otherwise

def $generator_request_fatal_selected(S) = (pgenfatal)
  -- if S.COMPLETION = NORMAL
  -- if S.TODO = (GENERATOR_CLOSE_DONE pgenclose) :: ptask_tail*
  -- if $generator_request_done_pending(S, pgenclose)
  -- if $generator_close_done_valid(S, pgenclose)
  -- if S.EXCEPTIONHANDLER = eps
  -- if pgenclose.PENDING = (n)
  -- if pgenfatal = {SOURCE GENERATOR_CLOSE_DONE pgenclose, OBJECT n, HANDLERS S.EXCEPTIONHANDLERS, METHOD eps, TEXT eps, REPORT eps, FROZEN NORMAL}
def $generator_request_fatal_selected(S) = (pgenfatal)
  -- if S.COMPLETION = NORMAL
  -- if S.TODO = (THROW_SEARCH n) :: ptask_tail*
  -- if $generator_request_handler_abrupt(S)
  -- if $throwable_live(S, n)
  -- if pgenfatal = {SOURCE THROW_SEARCH n, OBJECT n, HANDLERS S.EXCEPTIONHANDLERS, METHOD eps, TEXT eps, REPORT eps, FROZEN NORMAL}
def $generator_request_fatal_selected(S) = eps -- otherwise
def $generator_request_fatal_ready(S) = ($generator_request_fatal_selected(S) =/= eps)

def $generator_request_fatal_begin(S, pgenfatal) = S[.TODO = (GENERATOR_REQUEST_REPORT pgenfatal) :: (GENERATOR_CLOSE_DONE pgenclose[.PENDING = eps]) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (GENERATOR_CLOSE_DONE pgenclose) :: ptask_tail*
  -- if pgenfatal.SOURCE = GENERATOR_CLOSE_DONE pgenclose
def $generator_request_fatal_begin(S, pgenfatal) = S[.TODO = (GENERATOR_REQUEST_REPORT pgenfatal) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = pgenfatal.SOURCE :: ptask_tail*
  -- if pgenfatal.SOURCE = THROW_SEARCH pgenfatal.OBJECT
rule PhpStep/generator-request-fatal-begin: S ~> $generator_request_fatal_begin(S, pgenfatal)
  -- if S.TODO = (THROW_SEARCH n) :: ptask_tail*
  -- if $generator_request_fatal_selected(S) = (pgenfatal)
def $generator_close_done(S, pgenclose) = $generator_request_fatal_begin(S, pgenfatal)
  -- if $generator_request_fatal_selected(S) = (pgenfatal)
  -- if pgenfatal.SOURCE = GENERATOR_CLOSE_DONE pgenclose

def $generator_request_fatal_tail((GENERATOR_REQUEST_REPORT pgenfatal) :: ptask_tail*, pgenfatal) = (ptask_tail*)
def $generator_request_fatal_tail((STRINGIFY_RESULT n porigin 0) :: (GENERATOR_REQUEST_REPORT pgenfatal) :: ptask_tail*, pgenfatal) = (ptask_tail*)
  -- if pgenfatal.OBJECT = n /\ pgenfatal.METHOD = (porigin)
def $generator_request_fatal_tail((CALL_ARGS (METHOD_TARGET n porigin) eps 0 eps (porigin) 0) :: (STRINGIFY_RESULT n porigin 0) :: (GENERATOR_REQUEST_REPORT pgenfatal) :: ptask_tail*, pgenfatal) = (ptask_tail*)
  -- if pgenfatal.OBJECT = n /\ pgenfatal.METHOD = (porigin)
def $generator_request_fatal_tail(ptask*, pgenfatal) = eps -- otherwise
def $generator_request_report_at((GENERATOR_REQUEST_REPORT pgenfatal) :: ptask_tail*) = (pgenfatal)
def $generator_request_report_at((STRINGIFY_RESULT n porigin 0) :: (GENERATOR_REQUEST_REPORT pgenfatal) :: ptask_tail*) = (pgenfatal)
def $generator_request_report_at((CALL_ARGS (METHOD_TARGET n porigin) eps 0 eps (porigin) 0) :: (STRINGIFY_RESULT n porigin 0) :: (GENERATOR_REQUEST_REPORT pgenfatal) :: ptask_tail*) = (pgenfatal)
def $generator_request_report_at(ptask*) = eps -- otherwise
def $generator_request_fatal_method(S, pgenfatal) = true
  -- if pgenfatal.METHOD = eps /\ pgenfatal.TEXT = eps
def $generator_request_fatal_method(S, pgenfatal) = true
  -- if pgenfatal.METHOD = (porigin_method)
  -- if S.OBJECTS[pgenfatal.OBJECT] = INSTANCE porigin_class
  -- if $effective_method(S, porigin_class, $ptascii("__toString"), |S.CLASSES|) = (pmethoddesc)
  -- if pmethoddesc.FUNCTION.ORIGIN = porigin_method
  -- if $origin_node(S.SOURCES, porigin_method) = (pcnode)
def $generator_request_fatal_method(S, pgenfatal) = false -- otherwise
def $generator_request_report_valid(S, pgenfatal) = true
  -- if $shutdown_task_scope(S) /\ S.ACTIVEFIBER = eps
  -- if pgenfatal.FROZEN = NORMAL /\ pgenfatal.TEXT = eps /\ pgenfatal.REPORT = eps
