;; zend_call_function drops its completed receiver frame before C-root rethrow.
;; The outer zend_exception_error still owns its actual REPORT claim.
def $generator_request_fatal_begin(S, pgenfatal) = S[.TODO = (GENERATOR_REQUEST_REPORT pgenfatal) :: (GENERATOR_REQUEST_REPORT pgenfatal_parent) :: ptask_tail*][.ORIGIN = eps][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
