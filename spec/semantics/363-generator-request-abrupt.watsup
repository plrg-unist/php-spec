  -- if S_history = $generator_request_fatal_history(S, pgenfatal)[.TODO = (EXCEPTION_HANDLER_RESULT pexceptioncall) :: (GENERATOR_REQUEST_RENDER_RETURN pgenfatal_parent n_old false) :: (GENERATOR_REQUEST_REPORT pgenfatal_parent) :: ptask_tail*]
