;; zend_generator_resume -> zend_throw_exception_internal at a real C root.
;; Render, release the reported exception, then catch bailout and mark all
;; destructors called. REPORT owns ex; a child SOURCE also pins its C receiver.
;; TEXT/FROZEN and ordinary SOURCE records borrow history.

syntax pgenfatal = {SOURCE ptask, OBJECT nat, HANDLERS (pvalue?)*, METHOD porigin?, TEXT preqbytes?, REPORT pobjectprops?, FROZEN pcompletion}

dec $generator_request_fatal_source(pstate, pgenfatal, ptask*) : bool
dec $generator_request_fatal_history(pstate, pgenfatal) : pstate
dec $generator_request_fatal_selected(pstate) : pgenfatal?
dec $generator_request_fatal_begin(pstate, pgenfatal) : pstate
dec $generator_request_fatal_parent_origin(pgenfatal) : porigin?
dec $generator_request_fatal_tail(ptask*, pgenfatal) : ptask*?
dec $generator_request_report_at(ptask*) : pgenfatal?
dec $generator_request_bailout_tail(ptask*, pgenfatal) : ptask*?
dec $generator_request_bailout_at(ptask*) : pgenfatal?
dec $generator_request_fatal_method(pstate, pgenfatal) : bool
dec $generator_request_report_valid(pstate, pgenfatal) : bool
dec $generator_request_bailout_valid(pstate, pgenfatal) : bool
dec $generator_request_report_completion(pgenfatal) : pcompletion
dec $generator_request_report_state(pstate, pgenfatal) : pstate
dec $generator_request_report_text(pstate, pgenfatal) : preqbytes
dec $generator_request_report_finish(pstate, pgenfatal) : pstate
dec $generator_request_report_snapshot_valid(pstate, pgenfatal) : bool
dec $generator_request_report_kind(pstate, nat) : text
dec $generator_request_report_snapshot(pstate, nat) : pobjectprops
dec $generator_request_report_frozen(pstate, pgenfatal) : pcompletion
dec $generator_request_string_tail(pstate, nat, porigin, ptask*) : bool
dec $generator_request_report_abrupt(pstate) : bool
dec $generator_request_close_trace(pstate, pcallcontext) : bool
dec $generator_request_render_dispatch_ready(pstate) : bool
dec $generator_request_render_source(ptask, pgenfatal, nat, bool) : bool
dec $generator_request_render_prefix(ptask, pgenfatal, nat, bool) : bool
dec $generator_request_render_resume(ptask) : ptask?
dec $generator_request_render_at(ptask*) : (pgenfatal, nat, bool, ptask*)?
dec $generator_request_render_view(pstate, pgenfatal) : pstate
dec $generator_request_render_return_valid(pstate, pgenfatal, nat, bool) : bool
dec $generator_request_render_warning(pstate, pgenfatal) : preqbytes
dec $generator_request_render_abrupt(pstate) : bool
dec $generator_request_render_handler_abrupt(pstate) : bool
dec $generator_request_release_report(ptask*, pgenfatal) : bool
dec $generator_request_fatal_receiver(ptask) : pnode*

;; Request dtor_obj resumes the Generator from C with no execute_data caller.
;; Its saved creation context remains source authority, not a trace callsite.
def $generator_request_close_trace(S, pcallcontext) = true
  -- if S.FRAMES = pframe :: pframe_tail*
  -- if pframe.TODO = (GENERATOR_CLOSE_DONE pgenclose) :: ptask_tail*
  -- if pgenclose.CONTEXT = pcallcontext
  -- if pgenclose.CALLER = eps /\ pgenclose.CALLSITE = eps
  -- if S_root = $constant_frame_scope(S, pframe, pframe_tail*)
  -- if $generator_request_root(S_root)
  -- if $generator_close_done_valid(S_root, pgenclose)
def $generator_request_close_trace(S, pcallcontext) = false -- otherwise
def $generator_context_trace_kind(S, pcallcontext) = true
  -- if $generator_request_close_trace(S, pcallcontext)
def $trace_context(S, pbinding*, (pcallcontext)) = [{FILE eps, LINE $(-1), FUNCTION $trace_context_function(S, pcallcontext), CLASS $trace_context_class(S, pcallcontext), TYPE $trace_context_type(S, pcallcontext), ARGS ($trace_indexed_args(pvalue*, 0) ++ $trace_named_args(S, pcallcontext.NAMED)), HASARGS true}]
  -- if $generator_request_close_trace(S, pcallcontext)
  -- if ~$closure_call_target($context_target(pcallcontext))
  -- if $function_at($all_functions(S), pcallcontext.FUNCTION) = (pfunction)
  -- if psparam* = $call_fixed_parameters(pfunction.SIGNATURE.PARAMETERS)
  -- if pvalue* = $trace_parameters(S, pbinding*, (psparam.NAME)*, pcallcontext.ARGC) ++ $trace_extra(S, pcallcontext.EXTRA)

;; Preserve only the original handler lookup view. The retained actual tail
;; authenticates the transfer after the reported exception has been released.
def $generator_request_fatal_history(S, pgenfatal) = S[.ORIGIN = eps][.EXCEPTIONHANDLER = eps][.EXCEPTIONHANDLERS = pgenfatal.HANDLERS]
def $generator_request_fatal_source(S, pgenfatal, (GENERATOR_CLOSE_DONE pgenclose_done) :: ptask_tail*) = true
