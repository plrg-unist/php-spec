def $generator_request_tail_task(ERROR_HANDLER_INVOKE perrorcall) = true -- if perrorcall.RESUME = GENERATOR_REQUEST_RENDER_RETURN pgenfatal n true
def $generator_request_tail_task(ERROR_HANDLER_RESULT perrorcall) = true -- if perrorcall.RESUME = GENERATOR_REQUEST_RENDER_RETURN pgenfatal n true
def $generator_request_tail_task(ERROR_HANDLER_CLEAN perrorcall) = true -- if perrorcall.RESUME = GENERATOR_REQUEST_RENDER_RETURN pgenfatal n true
def $generator_request_resume_plain((ERROR_HANDLER_INVOKE perrorcall) :: ptask_tail*, pgenclose) = $generator_request_resume_plain(ptask_tail*, pgenclose)
  -- if perrorcall.RESUME = GENERATOR_REQUEST_RENDER_RETURN pgenfatal n true
def $generator_request_resume_plain((ERROR_HANDLER_RESULT perrorcall) :: ptask_tail*, pgenclose) = $generator_request_resume_plain(ptask_tail*, pgenclose)
  -- if perrorcall.RESUME = GENERATOR_REQUEST_RENDER_RETURN pgenfatal n true
def $generator_request_resume_plain((ERROR_HANDLER_CLEAN perrorcall) :: ptask_tail*, pgenclose) = $generator_request_resume_plain(ptask_tail*, pgenclose)
  -- if perrorcall.RESUME = GENERATOR_REQUEST_RENDER_RETURN pgenfatal n true

def $generator_request_render_abrupt(S) = true
  -- if S.TODO = (THROW_SEARCH n_abrupt) :: ptask_tail*
  -- if $generator_request_report_at(ptask_tail*) = eps
  -- if $generator_request_render_at(S.TODO) = ((pgenfatal, n, b, ptask_result*))
  -- if $generator_request_render_return_valid(S, pgenfatal, n, b)
def $generator_request_render_abrupt(S) = false -- otherwise
;; A throwing renderer-installed handler rethrows at its real C root before
;; either EHR cleanup or the outer zend_exception_error can resume.
def $generator_request_render_handler_abrupt(S) = true
  -- if S.COMPLETION = NORMAL
  -- if S.TODO = (THROW_SEARCH n) :: (EXCEPTION_HANDLER_RESULT pexceptioncall) :: (GENERATOR_REQUEST_RENDER_RETURN pgenfatal n_old false) :: (GENERATOR_REQUEST_REPORT pgenfatal) :: ptask_tail*
  -- if S.EXCEPTIONHANDLER = eps
  -- if S.EXCEPTIONHANDLERS = (pexceptioncall.CALLBACK) :: (pvalue?)*
  -- if pexceptioncall.OBJECT = n_old /\ pexceptioncall.ORIGIN = pgenfatal.METHOD
  -- if $exception_task_scope(S) /\ $exception_result_valid(S, pexceptioncall)
  -- if $throwable_live(S, n)
  -- if $generator_request_render_return_valid(S, pgenfatal, n_old, false)
def $generator_request_render_handler_abrupt(S) = false -- otherwise
def $shutdown_render_throw_pending(S) = true -- if $generator_request_render_abrupt(S)
;; zend_call_function rethrows the warning callback at C root. The restored
;; exception handler consumes that new object, then returns to the real warning.
def $exception_dispatch_ready(S) = true
  -- if S.COMPLETION = NORMAL
  -- if S.TODO = (THROW_SEARCH n) :: (ERROR_HANDLER_RESULT perrorcall) :: (GENERATOR_REQUEST_REPORT pgenfatal) :: ptask_tail*
