  -- if $throwable_live(S, n)
  -- if $error_entered_call_valid(S, perrorcall)
rule PhpStep/generator-request-render-handler-abrupt-required: S ~> S[.COMPLETION = UNSUPPORTED "Generator request fatal renderer handler or warning exception"]
  -- if $generator_request_render_abrupt(S)
  -- if ~$generator_request_fatal_ready(S)
  -- if ~$exception_dispatch_ready(S)
def $generator_request_release_abrupt(S) = true
