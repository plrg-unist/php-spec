;; The existing fatal snapshot retains the surviving real close/EHR carriers.
;; A consumed rendering exception is metadata here, never an abandoned root.
def $eager_fatal_ready(S, pcompletion) = true
  -- if S.TODO = (GENERATOR_REQUEST_BAILOUT pgenfatal) :: ptask_tail*
  -- if pcompletion = pgenfatal.FROZEN
