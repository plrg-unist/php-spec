;; Do not let generic terminal unwinding discard a retained render parent.
def $shutdown_render_throw_pending(S) = true -- if $generator_request_report_abrupt(S)
def $generator_request_report_abrupt(S) = true
  -- if S.TODO = (THROW_SEARCH n) :: (STRINGIFY_RESULT n_root porigin_method 0) :: (GENERATOR_REQUEST_REPORT pgenfatal) :: ptask_tail*
  -- if $throwable_live(S, n)
  -- if pgenfatal.OBJECT = n_root /\ pgenfatal.METHOD = (porigin_method)
  -- if $generator_request_report_valid(S[.TODO = (STRINGIFY_RESULT n_root porigin_method 0) :: (GENERATOR_REQUEST_REPORT pgenfatal) :: ptask_tail*], pgenfatal)
def $generator_request_report_abrupt(S) = false -- otherwise
rule PhpStep/generator-request-render-abrupt-required: S ~> S[.COMPLETION = UNSUPPORTED "Generator request fatal rendering exception"]
  -- if $generator_request_report_abrupt(S)
def $generator_request_release_abrupt(S) = true
