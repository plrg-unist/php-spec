def $terminal_string_site(S, porigin_method, 0) = true
  -- if $shutdown_task_scope(S)
  -- if S.TODO = (CALL_ARGS (METHOD_TARGET n porigin_method) eps 0 eps (porigin_method) 0) :: (STRINGIFY_RESULT n porigin_method 0) :: ptask_tail*
