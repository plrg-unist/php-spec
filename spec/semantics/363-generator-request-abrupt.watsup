def $shutdown_render_throw_pending(S) = true -- if $generator_request_release_abrupt(S)
rule PhpStep/generator-request-exception-release-abrupt-required: S ~> S[.COMPLETION = UNSUPPORTED "Generator request fatal exception-release throw"]
