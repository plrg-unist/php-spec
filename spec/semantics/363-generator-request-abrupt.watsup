def $terminal_string_site(S, porigin_method, 0) = true
  -- if $shutdown_task_scope(S)
  -- if S.TODO = (STRINGIFY_RESULT n porigin_method 0) :: ptask_tail*
  -- if $generator_request_string_tail(S, n, porigin_method, ptask_tail*)
def $terminal_string_frame_match(S, (pcallcontext), pframe, porigin_method) = true
  -- if pcallcontext.CALLSITE = (porigin_method) /\ pcallcontext.LINE = 0
  -- if pcallcontext.TARGET = METHOD_TARGET n porigin_method
  -- if pcallcontext.RECEIVER = (n) /\ pcallcontext.FUNCTION = porigin_method
  -- if pframe.ORIGIN = (porigin_method)
  -- if pframe.TODO = (STRINGIFY_RESULT n porigin_method 0) :: ptask_tail*
  -- if S_scope = $constant_frame_scope(S, pframe, eps)
  -- if $generator_request_string_tail(S_scope, n, porigin_method, ptask_tail*)
def $stringify_source(S, porigin_method, 0, GENERATOR_REQUEST_REPORT pgenfatal) = ($generator_request_report_valid(S, pgenfatal) /\ pgenfatal.METHOD = (porigin_method))
def $stringify_result_valid(S, n, porigin_method, 0) = true
  -- if $terminal_string_site(S, porigin_method, 0)
  -- if $generator_request_report_at(S.TODO) = (pgenfatal)
  -- if $generator_request_fatal_tail(S.TODO, pgenfatal) = (ptask_tail*)
