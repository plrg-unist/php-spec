  -- if $throwable_live(S, pgenfatal.OBJECT)
  -- if $generator_request_fatal_method(S, pgenfatal)
  -- if $generator_request_fatal_tail(S.TODO, pgenfatal) = (ptask_tail*)
  -- if $generator_request_fatal_source(S, pgenfatal, ptask_tail*)
def $generator_request_report_valid(S, pgenfatal) = false -- otherwise
def $call_task_valid(S, GENERATOR_REQUEST_REPORT pgenfatal) = $generator_request_report_valid(S, pgenfatal)
def $task_nodes(GENERATOR_REQUEST_REPORT pgenfatal) = [HOBJECT pgenfatal.OBJECT]
def $task_nodes(GENERATOR_REQUEST_BAILOUT pgenfatal) = eps
def $eager_explicit_task(GENERATOR_REQUEST_REPORT pgenfatal) = true
def $eager_explicit_task(GENERATOR_REQUEST_BAILOUT pgenfatal) = true
def $generator_internal_task(GENERATOR_REQUEST_REPORT pgenfatal) = true
def $generator_internal_task(GENERATOR_REQUEST_BAILOUT pgenfatal) = true
def $call_after_origin(S, GENERATOR_REQUEST_REPORT pgenfatal) = S[.ORIGIN = eps][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
def $call_after_origin(S, GENERATOR_REQUEST_BAILOUT pgenfatal) = S[.ORIGIN = eps][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
def $generator_request_tail_task(GENERATOR_REQUEST_REPORT pgenfatal) = true
def $generator_request_tail_task(GENERATOR_REQUEST_BAILOUT pgenfatal) = true
def $generator_request_tail_task(STRINGIFY_RESULT n porigin 0) = true
def $generator_request_tail_task(CALL_ARGS (METHOD_TARGET n porigin) eps 0 eps (porigin) 0) = true
def $generator_request_resume_position(ptask*, pgenclose) = $generator_request_resume_plain(ptask_tail*, pgenclose)
  -- if $generator_request_report_at(ptask*) = (pgenfatal)
  -- if $generator_request_fatal_tail(ptask*, pgenfatal) = (ptask_tail*)
def $generator_request_resume_plain((GENERATOR_REQUEST_BAILOUT pgenfatal) :: ptask_tail*, pgenclose) = $generator_request_resume_plain(ptask_tail*, pgenclose)
def $generator_request_resume_plain((DESTRUCTOR_RESULT pdestructorcall) :: ptask_tail*, pgenclose) = $generator_request_resume_plain(ptask_tail*, pgenclose)
  -- if ~pdestructorcall.USER /\ pdestructorcall.CALLER = eps /\ pdestructorcall.ORIGIN = eps
  -- if pdestructorcall.FRAME = eps /\ pdestructorcall.OPERATION = eps

rule PhpStep/generator-request-fatal-string: S ~> $user_string_begin(S[.ORIGIN = (porigin_method)], pgenfatal.OBJECT, porigin_method, 0, GENERATOR_REQUEST_REPORT pgenfatal[.METHOD = (porigin_method)], ptask_tail*)
