def $call_task_valid(S, GENERATOR_REQUEST_BAILOUT pgenfatal) = $generator_request_bailout_valid(S, pgenfatal)
rule PhpStep/generator-request-bailout: S ~> S[.COMPLETION = pgenfatal.FROZEN]
