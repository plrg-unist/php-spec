def $generator_request_report_completion(pgenfatal) = UNCAUGHT pgenfatal.OBJECT -- if pgenfatal.TEXT = eps
def $generator_request_report_completion(pgenfatal) = UNCAUGHT_RENDERED pgenfatal.OBJECT ptbytes -- if pgenfatal.TEXT = (ptbytes)
def $generator_request_report_text(S, pgenfatal) = $throwable_chain_string(S, pgenfatal.OBJECT, eps) -- if pgenfatal.TEXT = eps
def $generator_request_report_text(S, pgenfatal) = ptbytes -- if pgenfatal.TEXT = (ptbytes)
def $generator_request_report_kind(S, n) = pthrowable.KIND
  -- if S.OBJECTS[n] = THROWABLE pthrowable
def $generator_request_report_kind(S, n) = text_kind
  -- if S.OBJECTS[n] = INSTANCE porigin_class
  -- if $class_throwable_kind(S, porigin_class, |S.CLASSES|) = (text_kind)
def $generator_request_report_snapshot(S, n) = {OBJECT n, SLOTS ppropertyslot*, MATERIALIZED false}
  -- if text_kind = $generator_request_report_kind(S, n)
  -- if ppropertyslot* = [$throwable_slot(text_kind, "message", $throwable_field(S, n, "message")), $throwable_slot(text_kind, "file", $throwable_field(S, n, "file")), $throwable_slot(text_kind, "line", $throwable_field(S, n, "line"))]
def $generator_request_report_snapshot_valid(S, pgenfatal) = true
  -- if pgenfatal.REPORT = (pobjectprops)
  -- if pobjectprops.OBJECT = pgenfatal.OBJECT /\ ~pobjectprops.MATERIALIZED
  -- if text_kind = $generator_request_report_kind(S, pgenfatal.OBJECT)
  -- if pobjectprops.SLOTS = [ppropertyslot_message, ppropertyslot_file, ppropertyslot_line]
  -- if ppropertyslot_message.STATE = PROP_VALUE (DIRECT pvalue_message)
  -- if ppropertyslot_file.STATE = PROP_VALUE (DIRECT (PSTRING ptbytes_file))
  -- if ppropertyslot_line.STATE = PROP_VALUE (DIRECT (PINT z))
  -- if ppropertyslot_message = $throwable_slot(text_kind, "message", pvalue_message)
  -- if ppropertyslot_file = $throwable_slot(text_kind, "file", PSTRING ptbytes_file)
  -- if ppropertyslot_line = $throwable_slot(text_kind, "line", PINT z)
  -- if pgenfatal.METHOD =/= eps \/ $throwable_terminal_message_supported(pvalue_message)
def $generator_request_report_snapshot_valid(S, pgenfatal) = false -- otherwise
def $generator_request_report_frozen(S, pgenfatal) = REQUESTFATAL ($object_name(S, pgenfatal.OBJECT)) ($echo_value(pvalue_message)) z
  -- if pgenfatal.TEXT = eps
  -- if pgenfatal.REPORT = (pobjectprops)
  -- if pobjectprops.SLOTS = [ppropertyslot_message, ppropertyslot_file, ppropertyslot_line]
  -- if ppropertyslot_message.STATE = PROP_VALUE (DIRECT pvalue_message)
  -- if ppropertyslot_line.STATE = PROP_VALUE (DIRECT (PINT z))
def $generator_request_report_frozen(S, pgenfatal) = REQUESTFATAL ($object_name(S, pgenfatal.OBJECT)) ptbytes z
  -- if pgenfatal.TEXT = (ptbytes)
  -- if pgenfatal.REPORT = (pobjectprops)
  -- if pobjectprops.SLOTS = [ppropertyslot_message, ppropertyslot_file, ppropertyslot_line]
  -- if ppropertyslot_line.STATE = PROP_VALUE (DIRECT (PINT z))
def $generator_request_report_state(S, pgenfatal) = $shutdown_freeze_marked(S[.COMPLETION = $generator_request_report_completion(pgenfatal)][.TRACE = eps][.ERRORORIGIN = eps])
def $generator_request_report_finish(S, pgenfatal) = $destructor_release_begin(S_report[.TODO = (GENERATOR_REQUEST_BAILOUT pgenfatal[.REPORT = ($generator_request_report_snapshot(S_cached, pgenfatal.OBJECT))][.FROZEN = S_report.COMPLETION]) :: ptask_tail*][.COMPLETION = NORMAL][.ORIGIN = eps][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], [DESTRUCTION_VALUE (HOBJECT pgenfatal.OBJECT)])
  -- if S.TODO = (GENERATOR_REQUEST_REPORT pgenfatal_original) :: ptask_tail*
  -- if pgenfatal[.TEXT = eps] = pgenfatal_original
  -- if S_cached = $throwable_string_cache(S, pgenfatal.OBJECT, $generator_request_report_text(S, pgenfatal))
  -- if S_report = $generator_request_report_state(S_cached, pgenfatal)
rule PhpStep/generator-request-fatal-report: S ~> $generator_request_report_finish(S, pgenfatal)
  -- if S.TODO = (GENERATOR_REQUEST_REPORT pgenfatal) :: ptask_tail*
  -- if $generator_request_report_valid(S, pgenfatal)
  -- if pgenfatal.METHOD = eps /\ ~$stringable_instance(S, pgenfatal.OBJECT)
  -- if $throwable_terminal_renderable(S, pgenfatal.OBJECT, eps)
  -- if ~$shutdown_render_chain_warning(S, pgenfatal.OBJECT, eps)
rule PhpStep/generator-request-fatal-report-string: S ~> $generator_request_report_finish(S, pgenfatal[.TEXT = (ptbytes)])
  -- if S.TODO = (GENERATOR_REQUEST_REPORT pgenfatal) :: ptask_tail*
  -- if $generator_request_report_valid(S, pgenfatal)
  -- if pgenfatal.METHOD =/= eps
  -- if S.RESULT = KNOWN (PSTRING ptbytes)
rule PhpStep/generator-request-fatal-message-required: S ~> S[.COMPLETION = UNSUPPORTED "Generator request fatal message rendering"]
