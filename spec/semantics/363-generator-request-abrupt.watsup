;; A child dtor rethrows at C root while the ordinary parent's free_obj is pinned.
def $generator_request_fatal_source(S, pgenfatal, (DESTRUCTOR_RESULT pdestructorcall) :: (DESTRUCTOR_RELEASE pdestructionrelease) :: (INSTANCE_STORAGE_STEP pinstancestorage) :: ptask_tail*) = true
