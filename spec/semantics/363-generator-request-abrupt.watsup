def $generator_request_fatal_begin(S, pgenfatal) = S[.TODO = (GENERATOR_REQUEST_REPORT pgenfatal) :: (GENERATOR_CLOSE_DONE pgenclose[.PENDING = eps]) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
