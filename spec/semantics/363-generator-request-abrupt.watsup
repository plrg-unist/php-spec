  -- if pgenclose.PENDING = (pgenfatal.OBJECT)
  -- if pgenclose_done = pgenclose[.PENDING = eps]
  -- if S_history = $generator_request_fatal_history(S, pgenfatal)[.TODO = (GENERATOR_CLOSE_DONE pgenclose_done) :: ptask_tail*]
  -- if $generator_request_root(S_history) /\ $generator_request_tail(S_history, ptask_tail*)
  -- if $generator_close_done_valid(S_history, pgenclose_done)
