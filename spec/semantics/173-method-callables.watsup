;; A first-class method expression captures the selected source descriptor and
;; call scope without sending arguments or entering the method body.
dec $method_capture_site(pstate, porigin, pmethoddesc) : bool
def $method_capture_site(S, porigin_site, pmethoddesc) = true
  -- if $origin_node(S.SOURCES, porigin_site) = (NExprMethodCall expression phpType20 (SEQUENCE phpType7*) metadata)
  -- if $ppfirstclass(phpType7*)
  -- if $method_source_name(phpType20, pmethoddesc.NAME)
def $method_capture_site(S, porigin_site, pmethoddesc) = true
  -- if $origin_node(S.SOURCES, porigin_site) = (NExprStaticCall phpType19 phpType20 (SEQUENCE phpType7*) metadata)
  -- if $ppfirstclass(phpType7*)
  -- if $scoped_source_method(phpType20, pmethoddesc.NAME)
def $method_capture_site(S, porigin_site, pmethoddesc) = false -- otherwise

