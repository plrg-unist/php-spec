def $class_constant_constructor_task(S, ptbytes, phpType7*, b_ctor, z) = true
  -- if S.ORIGIN = (PORIGIN n pcpath)
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (NExprNew phpType28 (SEQUENCE phpType7*) metadata)
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_name(pcode.NAMES, pcpath) = ((ptbytes, eps))
  -- if b_ctor = $new_has_ctor(S, ptbytes)
  -- if (z = $runtime_line(S, eps, NExprNew phpType28 (SEQUENCE phpType7*) metadata) /\ (~b_ctor \/ ~$parameter_default_constructor(S, phpType28, phpType7*, metadata))) \/ (b_ctor /\ $parameter_default_new_ready(S, ptbytes, phpType7*, z))
  -- if $class_constant_constructor_ready(S, ptbytes, phpType7*, b_ctor, z)
def $class_constant_constructor_task(S, ptbytes, phpType7*, b_ctor, z) = false -- otherwise
def $class_constant_constructor_ready(S, ptbytes, phpType7*, b_ctor, z) = ($class_constant_new_work(S, ptbytes, z) = eps)
  -- if S.TODO = (CLASS_CONST_CONSTRUCT ptbytes phpType7* b_ctor z) :: ptask_tail*
def $class_constant_constructor_ready(S, ptbytes, phpType7*, b_ctor, z) = true -- otherwise
def $call_task_valid(S, CLASS_CONST_CONSTRUCT ptbytes phpType7* b_ctor z) = $class_constant_constructor_task(S, ptbytes, phpType7*, b_ctor, z)

dec $class_constant_static_task(pstate, poperand, ptbytes, int) : bool
def $class_constant_static_task(S, poperand, ptbytes, z) = true
