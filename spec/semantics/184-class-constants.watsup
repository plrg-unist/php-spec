def $class_constant_static_unset_tail(ptask*) = false -- otherwise

dec $class_constant_static_work(pstate, poperand, ptbytes, int) : ptask*
def $class_constant_static_work(S, poperand, ptbytes, z) = $class_constant_table_tasks(S, porigin, z, |S.CLASSES|)
  -- if ~$class_constant_static_unset_tail(S.TODO)
  -- if $scoped_selector_class(S, poperand) = (porigin)
  -- if $class_static_select(S, porigin, ptbytes) = (ppropertydesc)
  -- if $class_static_accessible(S, ppropertydesc)
def $class_constant_static_work(S, poperand, ptbytes, z) = eps -- otherwise
;; Synchronous indirect/reference acquisition cannot suspend for a table update.
;; Retain a precise boundary until that selected operation has a continuation.
dec $class_constant_static_reference_ready(pstate, porigin, ptbytes, int) : bool
def $class_constant_static_reference_ready(S, porigin, ptbytes, z) = ($class_constant_static_work(S, KNOWN (PSTRING pclassdesc.NAME), ptbytes, z) = eps)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
def $class_constant_static_reference_ready(S, porigin, ptbytes, z) = true -- otherwise
def $class_static_prepare_base(S, poperand, ptbytes, z) = S[.TODO = ptask_work* ++ [CLASS_CONST_STATIC poperand ptbytes z] ++ S.TODO][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if ptask_work* = $class_constant_static_work(S, poperand, ptbytes, z)
  -- if ptask_work* =/= eps
  -- if S.ORIGIN = (porigin_trigger)
  -- if $scoped_selector_class(S, poperand) = (porigin_class)
  -- if $class_constant_update_site(S, porigin_trigger, porigin_class)
def $class_static_prepare_base(S, poperand, ptbytes, z) = S[.COMPLETION = UNSUPPORTED "unretained class table selector"]
  -- if $class_constant_static_work(S, poperand, ptbytes, z) =/= eps
  -- if S.ORIGIN = (porigin_trigger)
  -- if $scoped_selector_class(S, poperand) = (porigin_class)
  -- if ~$class_constant_update_site(S, porigin_trigger, porigin_class)
def $class_static_prepare_base(S, poperand, ptbytes, z) = $class_static_prepare_base_ready(S, poperand, ptbytes, z)
  -- if $class_constant_static_work(S, poperand, ptbytes, z) = eps
rule PhpStep/class-constant-static: S ~> $class_static_prepare_base_ready(S[.TODO = ptask_tail*], poperand, ptbytes, z)
  -- if S.TODO = (CLASS_CONST_STATIC poperand ptbytes z) :: ptask_tail*
def $task_nodes(CLASS_CONST_STATIC poperand ptbytes z) = $operand_nodes(poperand)

;; A resumed update cannot allocate or expose a property while deferred slots
;; remain. Future continuations are checked structurally until they reach head.
