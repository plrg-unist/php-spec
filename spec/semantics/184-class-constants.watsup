def $constructor_start(S, ptbytes, phpType7*, z) = S[.TODO = $class_constant_update_tasks(porigin*, z) ++ [CLASS_CONST_CONSTRUCT ptbytes phpType7* true z] ++ S.TODO][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if porigin* = $class_constant_new_pending(S, ptbytes)
  -- if porigin* =/= eps
def $constructor_start(S, ptbytes, phpType7*, z) = $constructor_start_ready(S, ptbytes, phpType7*, z)
  -- if $class_constant_new_pending(S, ptbytes) = eps
def $noctor_start(S, ptbytes, phpType7*, z) = S[.TODO = $class_constant_update_tasks(porigin*, z) ++ [CLASS_CONST_CONSTRUCT ptbytes phpType7* false z] ++ S.TODO][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if porigin* = $class_constant_new_pending(S, ptbytes)
  -- if porigin* =/= eps
def $noctor_start(S, ptbytes, phpType7*, z) = $noctor_start_ready(S, ptbytes, phpType7*, z)
  -- if $class_constant_new_pending(S, ptbytes) = eps
rule PhpStep/class-constant-update: S ~> $class_constant_value(S[.TODO = DISCARD :: ptask_tail*], pclassconstantdesc, CLASS_CONST_UPDATE_SELECT porigin_class, pclassconstantdesc.OWNERNAME, z)
  -- if S.TODO = (CLASS_CONST_UPDATE porigin z) :: ptask_tail*
