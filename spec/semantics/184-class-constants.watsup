dec $class_constant_update_blocks(pstate, ptask*, porigin*) : bool
dec $class_constant_update_marker(ptask) : bool
dec $class_constant_selection_valid(pstate, pclassconstantcontext) : bool
dec $class_constant_binding_head(ptask*, porigin) : bool
;; Lookup resolves the requested class, but initialization and its cache belong
;; to the declaration's owner. Visibility is checked before deferred evaluation.
dec $class_constant_origin(pclassdesc*, porigin) : pclassconstantdesc?
dec $class_constant_origin_in(pclassconstantdesc*, porigin) : pclassconstantdesc?
def $class_constant_origin_in(eps, porigin) = eps
def $class_constant_origin_in(pclassconstantdesc :: pclassconstantdesc_tail*, porigin) = (pclassconstantdesc)
  -- if pclassconstantdesc.ORIGIN = porigin
def $class_constant_origin_in(pclassconstantdesc :: pclassconstantdesc_tail*, porigin) = $class_constant_origin_in(pclassconstantdesc_tail*, porigin)
  -- if pclassconstantdesc.ORIGIN =/= porigin
def $class_constant_origin(eps, porigin) = eps
def $class_constant_origin(pclassdesc :: pclassdesc_tail*, porigin) = (pclassconstantdesc)
  -- if $class_constant_origin_in(pclassdesc.CONSTANTS, porigin) = (pclassconstantdesc)
def $class_constant_origin(pclassdesc :: pclassdesc_tail*, porigin) = $class_constant_origin(pclassdesc_tail*, porigin)
  -- if $class_constant_origin_in(pclassdesc.CONSTANTS, porigin) = eps

dec $class_constant_lookup(pstate, porigin, ptbytes, nat) : pclassconstantdesc?
dec $class_constant_inherited(pstate, porigin, ptbytes, nat) : pclassconstantdesc?
dec $class_constant_interfaces(pstate, pilref*, ptbytes, nat) : pclassconstantdesc?
def $class_constant_lookup(S, porigin, ptbytes, n) = (pclassconstantdesc)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if $class_constant_desc(pclassdesc.CONSTANTS, ptbytes) = (pclassconstantdesc)
def $class_constant_lookup(S, porigin, ptbytes, n) = $class_constant_inherited(S, porigin, ptbytes, n)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if $class_constant_desc(pclassdesc.CONSTANTS, ptbytes) = eps
def $class_constant_lookup(S, porigin, ptbytes, n) = eps -- otherwise
dec $class_constant_parent_lookup(pstate, porigin, ptbytes, nat) : pclassconstantdesc?
def $class_constant_parent_lookup(S, porigin, ptbytes, n) = (pclassconstantdesc)
  -- if $(n > 0)
  -- if $class_link_at(S.LINKEDPARENTS, porigin) = (SOURCE_PARENT porigin_parent)
  -- if $class_constant_lookup(S, porigin_parent, ptbytes, $nabs($(n - 1))) = (pclassconstantdesc)
  -- if pclassconstantdesc.VISIBILITY =/= PROPERTY_PRIVATE
def $class_constant_parent_lookup(S, porigin, ptbytes, n) = eps -- otherwise
def $class_constant_inherited(S, porigin, ptbytes, n) = (pclassconstantdesc)
  -- if $class_constant_parent_lookup(S, porigin, ptbytes, n) = (pclassconstantdesc)
def $class_constant_inherited(S, porigin, ptbytes, n) = $class_constant_interfaces(S, pilref*, ptbytes, $nabs($(n - 1)))
  -- if $(n > 0)
  -- if $class_constant_parent_lookup(S, porigin, ptbytes, n) = eps
  -- if $pil_at(S.LINKEDINTERFACES, porigin) = (PILTARGETS pilref*)
def $class_constant_inherited(S, porigin, ptbytes, n) = eps -- otherwise
def $class_constant_interfaces(S, eps, ptbytes, n) = eps
def $class_constant_interfaces(S, (PILSOURCE ptbytes_interface porigin) :: pilref*, ptbytes, n) = (pclassconstantdesc)
  -- if $class_constant_lookup(S, porigin, ptbytes, n) = (pclassconstantdesc)
def $class_constant_interfaces(S, (PILSOURCE ptbytes_interface porigin) :: pilref*, ptbytes, n) = $class_constant_interfaces(S, pilref*, ptbytes, n)
  -- if $class_constant_lookup(S, porigin, ptbytes, n) = eps
def $class_constant_interfaces(S, (PILBUILTIN ptbytes_interface) :: pilref*, ptbytes, n) = $class_constant_interfaces(S, pilref*, ptbytes, n)

dec $class_constant_visible(pstate, pclassconstantdesc) : bool
def $class_constant_visible(S, pclassconstantdesc) = true
  -- if pclassconstantdesc.VISIBILITY = PROPERTY_PUBLIC
def $class_constant_visible(S, pclassconstantdesc) = true
  -- if pclassconstantdesc.VISIBILITY =/= PROPERTY_PUBLIC
  -- if $method_current_scope(S) = (pclassconstantdesc.OWNER)
def $class_constant_visible(S, pclassconstantdesc) = true
  -- if pclassconstantdesc.VISIBILITY = PROPERTY_PROTECTED
  -- if $method_current_scope(S) = (porigin)
  -- if porigin =/= pclassconstantdesc.OWNER
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc_scope)
  -- if $class_origin_matches(S, porigin, pclassconstantdesc.OWNERNAME, |S.CLASSES|) \/ $class_origin_matches(S, pclassconstantdesc.OWNER, pclassdesc_scope.NAME, |S.CLASSES|)
def $class_constant_visible(S, pclassconstantdesc) = false -- otherwise

def $method_current_scope(S) = (pclassconstantdesc.OWNER)
  -- if S.CLASSCONSTANTINIT = pclassconstantcontext :: pclassconstantcontext_tail*
  -- if $class_constant_origin(S.CLASSES, pclassconstantcontext.DECL) = (pclassconstantdesc)

def $class_constant_roots(eps) = eps
def $class_constant_roots(pdefaultcache :: pdefaultcache_tail*) = $value_nodes(pdefaultcache.VALUE) ++ $class_constant_roots(pdefaultcache_tail*)
dec $class_constant_initializing(pclassconstantcontext*, porigin) : bool
def $class_constant_initializing(eps, porigin) = false
def $class_constant_initializing(pclassconstantcontext :: pclassconstantcontext_tail*, porigin) = (pclassconstantcontext.DECL = porigin \/ $class_constant_initializing(pclassconstantcontext_tail*, porigin))

;; Only AST lookup protects a deferred value against recursion. VM fetch and
;; the class-wide API update may enter the same value before AST lookup does.
dec $class_constant_protected(pclassconstantselection, pconstantcontext?) : bool
def $class_constant_protected(CLASS_CONST_FETCH poperand ptbytes, (pconstantcontext)) = true
def $class_constant_protected(pclassconstantselection, pconstantcontext?) = false -- otherwise
dec $class_constant_visited(pclassconstantcontext*, porigin) : bool
def $class_constant_visited(eps, porigin) = false
def $class_constant_visited(pclassconstantcontext :: pclassconstantcontext_tail*, porigin) = ((pclassconstantcontext.DECL = porigin /\ $class_constant_protected(pclassconstantcontext.SELECTION, pclassconstantcontext.PREVIOUS)) \/ $class_constant_visited(pclassconstantcontext_tail*, porigin))

dec $class_constant_result(pstate, pvalue, pvalueclass) : pstate
def $class_constant_result(S, pvalue, pvalueclass) = S[.RESULT = KNOWN pvalue][.BASE = BASE_VALUE (KNOWN PNULL)][.CONSTCONTEXT = (pconstantcontext[.FACTS = $constant_fact_put(pconstantcontext.FACTS, {ORIGIN porigin, VALUE $pvclass_operand(pvalue), CLASS pvalueclass})])]
  -- if S.CONSTCONTEXT = (pconstantcontext)
  -- if S.ORIGIN = (porigin)
def $class_constant_result(S, pvalue, pvalueclass) = S[.RESULT = KNOWN pvalue][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.CONSTCONTEXT = eps
dec $class_constant_keyword(pstate) : bool
def $class_constant_keyword(S) = true
  -- if S.ORIGIN = (porigin)
  -- if $origin_node(S.SOURCES, porigin) = (NExprClassConstFetch (NName (BYTES text) metadata_class) phpType20 metadata)
  -- if $ptlc($base64(text)) <- [$ptascii("self"), $ptascii("parent")]
def $class_constant_keyword(S) = false -- otherwise
dec $class_constant_message_class(pstate, pclassdesc, ptbytes) : ptbytes
def $class_constant_message_class(S, pclassdesc, ptbytes_requested) = $base64(text)
  -- if S.CONSTCONTEXT =/= eps
  -- if S.ORIGIN = (porigin)
  -- if $origin_node(S.SOURCES, porigin) = (NExprClassConstFetch (NName (BYTES text) metadata_class) phpType20 metadata)
  -- if $ptlc($base64(text)) <- [$ptascii("self"), $ptascii("parent")]
def $class_constant_message_class(S, pclassdesc, ptbytes_requested) = ptbytes_requested
  -- if S.CONSTCONTEXT =/= eps
  -- if ~$class_constant_keyword(S)
def $class_constant_message_class(S, pclassdesc, ptbytes_requested) = pclassdesc.NAME
  -- if S.CONSTCONTEXT = eps
dec $class_constant_ast(pstate, pclassconstantdesc) : bool
def $class_constant_ast(S, pclassconstantdesc) = false
  -- if $origin_node(S.SOURCES, pclassconstantdesc.INITIALIZER) = (NExprConstFetch name metadata)
def $class_constant_ast(S, pclassconstantdesc) = true -- otherwise
def $class_constant_ast_active(S) = $class_constant_ast(S, pclassconstantdesc)
  -- if S.CLASSCONSTANTINIT = pclassconstantcontext :: pclassconstantcontext_tail*
  -- if $class_constant_origin(S.CLASSES, pclassconstantcontext.DECL) = (pclassconstantdesc)
  -- if ~$class_constant_binding_head(S.TODO, pclassconstantcontext.DECL)
def $class_constant_ast_active(S) = false -- otherwise
def $class_constant_binding_head((CLASS_CONST_BIND porigin) :: ptask_tail*, porigin) = true
def $class_constant_binding_head(ptask*, porigin) = false -- otherwise
dec $class_constant_begin(pstate, pclassconstantdesc, pclassconstantselection, ptbytes, int) : pstate
def $class_constant_begin(S, pclassconstantdesc, pclassconstantselection, ptbytes_requested, z) = $throw_scalar(S, "Error", $ptascii("Cannot declare self-referencing constant ") ++ ptbytes_requested ++ $ptascii("::") ++ pclassconstantdesc.NAME, z)
  -- if $class_constant_protected(pclassconstantselection, S.CONSTCONTEXT) /\ $class_constant_visited(S.CLASSCONSTANTINIT, pclassconstantdesc.ORIGIN)
def $class_constant_begin(S, pclassconstantdesc, pclassconstantselection, ptbytes_requested, z) = S[.CLASSCONSTANTINIT = {DECL pclassconstantdesc.ORIGIN, SELECTION pclassconstantselection, PREVIOUS S.CONSTCONTEXT, ORIGIN S.ORIGIN, LINE z} :: S.CLASSCONSTANTINIT][.CONSTCONTEXT = ({ORIGIN pclassconstantdesc.ORIGIN, LINE z, FACTS eps})][.TODO = [AT pclassconstantdesc.INITIALIZER (EVAL expression), CLASS_CONST_BIND pclassconstantdesc.ORIGIN] ++ S.TODO][.ORIGIN = (pclassconstantdesc.ORIGIN)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if ~($class_constant_protected(pclassconstantselection, S.CONSTCONTEXT) /\ $class_constant_visited(S.CLASSCONSTANTINIT, pclassconstantdesc.ORIGIN))
  -- if $origin_node(S.SOURCES, pclassconstantdesc.INITIALIZER) = (expression)
dec $class_constant_value(pstate, pclassconstantdesc, pclassconstantselection, ptbytes, int) : pstate
def $class_constant_value(S, pclassconstantdesc, pclassconstantselection, ptbytes_requested, z) = $class_constant_result(S, pvalue, pvalueclass)
  -- if pclassconstantdesc.FOLDED
  -- if $compiled_read(S, pclassconstantdesc.INITIALIZER) = (pvalue)
  -- if $pool_class(S.POOLS, pclassconstantdesc.INITIALIZER) = (pvalueclass)
def $class_constant_value(S, pclassconstantdesc, pclassconstantselection, ptbytes_requested, z) = $class_constant_result(S, pdefaultcache.VALUE, pdefaultcache.CLASS)
  -- if ~pclassconstantdesc.FOLDED
  -- if $default_cache_at(S.CLASSCONSTANTCACHE, pclassconstantdesc.ORIGIN) = (pdefaultcache)
def $class_constant_value(S, pclassconstantdesc, pclassconstantselection, ptbytes_requested, z) = $class_constant_begin(S, pclassconstantdesc, pclassconstantselection, ptbytes_requested, z)
  -- if ~pclassconstantdesc.FOLDED
  -- if $default_cache_at(S.CLASSCONSTANTCACHE, pclassconstantdesc.ORIGIN) = eps

dec $class_constant_fetch(pstate, poperand, ptbytes, int) : pstate
dec $class_constant_fetch_class(pstate, pclassdesc, ptbytes, ptbytes, int) : pstate
def $class_constant_fetch(S, KNOWN (PSTRING ptbytes_class), ptbytes, z) = $class_constant_fetch_class(S, pclassdesc, ptbytes_class, ptbytes, z)
  -- if $class_named(S.CLASSNAMES, $ptlc(ptbytes_class)) = (porigin)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
def $class_constant_fetch(S, KNOWN (PSTRING ptbytes_class), ptbytes, z) = $throw_scalar(S, "Error", $ptascii("Class \"") ++ ptbytes_class ++ $ptascii("\" not found"), z)
  -- if $class_named(S.CLASSNAMES, $ptlc(ptbytes_class)) = eps
def $class_constant_fetch_class(S, pclassdesc, ptbytes_class, ptbytes, z) = $throw_scalar(S, "Error", $ptascii("Undefined constant ") ++ $class_constant_message_class(S, pclassdesc, ptbytes_class) ++ $ptascii("::") ++ ptbytes, z)
  -- if $class_constant_lookup(S, pclassdesc.ORIGIN, ptbytes, |S.CLASSES|) = eps
def $class_constant_fetch_class(S, pclassdesc, ptbytes_class, ptbytes, z) = $throw_scalar(S, "Error", $ptascii("Cannot access ") ++ $property_visibility_name(pclassconstantdesc.VISIBILITY) ++ $ptascii(" constant ") ++ $class_constant_message_class(S, pclassdesc, ptbytes_class) ++ $ptascii("::") ++ ptbytes, z)
  -- if $class_constant_lookup(S, pclassdesc.ORIGIN, ptbytes, |S.CLASSES|) = (pclassconstantdesc)
  -- if ~$class_constant_visible(S, pclassconstantdesc)
def $class_constant_fetch_class(S, pclassdesc, ptbytes_class, ptbytes, z) = $class_constant_value(S, pclassconstantdesc, CLASS_CONST_FETCH (KNOWN (PSTRING ptbytes_class)) ptbytes, $class_constant_message_class(S, pclassdesc, ptbytes_class), z)
  -- if $class_constant_lookup(S, pclassdesc.ORIGIN, ptbytes, |S.CLASSES|) = (pclassconstantdesc)
  -- if $class_constant_visible(S, pclassconstantdesc)

;; A literal class operand resolves after a computed member; a genuinely
;; dynamic class operand is fetched before evaluating the member expression.
dec $class_constant_literal(pstate, phpType19) : bool
dec $class_constant_selector(pstate, phpType19, int) : pstate
dec $class_constant_member_tasks(pstate, phpType19, poperand, phpType20, int) : pstate
def $class_constant_literal(S, phpType19) = true -- if $ppscoped_named(phpType19)
def $class_constant_literal(S, phpType19) = true
  -- if ~$ppscoped_named(phpType19)
  -- if $origin_child(S.ORIGIN, [PCFIELD 0]) = (porigin)
  -- if $compiled_read(S, porigin) = (PSTRING ptbytes)
def $class_constant_literal(S, phpType19) = false -- otherwise
def $class_constant_selector(S, phpType19, z) = $scoped_class_prepare(S, phpType19, z)
  -- if $ppscoped_named(phpType19)
def $class_constant_selector(S, phpType19, z) = S[.RESULT = KNOWN (PSTRING ptbytes)]
  -- if ~$ppscoped_named(phpType19)
  -- if $origin_child(S.ORIGIN, [PCFIELD 0]) = (porigin)
  -- if $compiled_read(S, porigin) = (PSTRING ptbytes)
def $class_constant_selector(S, phpType19, z) = $scoped_class_prepare(S, phpType19, z) -- otherwise
def $class_constant_member_tasks(S, phpType19, poperand, NIdentifier (BYTES text) metadata, z) = $class_constant_fetch(S, poperand, $base64(text), z)
def $class_constant_member_tasks(S, phpType19, poperand, expression, z) = S[.TODO = [$at_task($origin_child(S.ORIGIN, [PCFIELD 1]), EVAL expression), CLASS_CONST_MEMBER phpType19 poperand z, CLASS_CONST_CAPTURE porigin poperand z] ++ S.TODO][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.ORIGIN = (porigin)

rule PhpStep/class-constant-literal: S ~> S_next[.TODO = (CLASS_CONST_CLASS phpType19 phpType20 z) :: ptask_tail*]
  -- if S.TODO = (EVAL (NExprClassConstFetch phpType19 phpType20 metadata)) :: ptask_tail*
  -- if ~$pfclassname_member(phpType20)
  -- if $class_constant_literal(S, phpType19)
  -- if z = $runtime_line(S, eps, NExprClassConstFetch phpType19 phpType20 metadata)
  -- if S_next = S
rule PhpStep/class-constant-dynamic: S ~> S[.TODO = [$at_task($origin_child(S.ORIGIN, [PCFIELD 0]), EVAL expression), CLASS_CONST_CLASS expression phpType20 z] ++ ptask_tail*]
  -- if S.TODO = (EVAL (NExprClassConstFetch expression phpType20 metadata)) :: ptask_tail*
  -- if ~$pfclassname_member(phpType20)
  -- if ~$class_constant_literal(S, expression)
  -- if z = $runtime_line(S, eps, NExprClassConstFetch expression phpType20 metadata)
rule PhpStep/class-constant-class: S ~> $class_constant_member_tasks(S_class[.TODO = ptask_tail*], phpType19, S_class.RESULT, phpType20, z)
  -- if S.TODO = (CLASS_CONST_CLASS phpType19 phpType20 z) :: ptask_tail*
  -- if S_class = $class_constant_selector(S, phpType19, z)
  -- if S_class.COMPLETION = NORMAL
rule PhpStep/class-constant-class-abrupt: S ~> S_class[.TODO = ptask_tail*]
  -- if S.TODO = (CLASS_CONST_CLASS phpType19 phpType20 z) :: ptask_tail*
  -- if S_class = $class_constant_selector(S, phpType19, z)
  -- if S_class.COMPLETION =/= NORMAL
dec $class_constant_member_value(pstate, poperand, poperand, int) : pstate
dec $class_constant_member_typed(pstate, poperand, pvalue, int) : pstate
dec $class_constant_resolve_class(pstate, poperand, int) : pstate
def $class_constant_resolve_class(S, KNOWN (PSTRING ptbytes_class), z) = S
  -- if $class_named(S.CLASSNAMES, $ptlc(ptbytes_class)) =/= eps
def $class_constant_resolve_class(S, KNOWN (PSTRING ptbytes_class), z) = $throw_scalar(S, "Error", $ptascii("Class \"") ++ ptbytes_class ++ $ptascii("\" not found"), z)
  -- if $class_named(S.CLASSNAMES, $ptlc(ptbytes_class)) = eps /\ ~$class_internal(ptbytes_class)
def $class_constant_resolve_class(S, poperand, z) = S[.COMPLETION = UNSUPPORTED "internal class constant lookup"] -- otherwise
def $class_constant_member_value(S, poperand_class, KNOWN pvalue, z) = $class_constant_member_typed(S_class, poperand_class, pvalue, z)
  -- if S.CONSTCONTEXT = eps
  -- if S_class = $class_constant_resolve_class(S, poperand_class, z)
  -- if S_class.COMPLETION = NORMAL
def $class_constant_member_value(S, poperand_class, KNOWN pvalue, z) = S_class
  -- if S.CONSTCONTEXT = eps
  -- if S_class = $class_constant_resolve_class(S, poperand_class, z)
  -- if S_class.COMPLETION =/= NORMAL
def $class_constant_member_value(S, poperand_class, KNOWN pvalue, z) = $class_constant_member_typed(S, poperand_class, pvalue, z)
  -- if S.CONSTCONTEXT =/= eps
def $class_constant_member_typed(S, KNOWN (PSTRING ptbytes_class), PSTRING ptbytes, z) = $class_constant_result(S, PSTRING pclassdesc.NAME, PVSTRING false)
  -- if S.CONSTCONTEXT = eps /\ $ptlc(ptbytes) = $ptascii("class")
  -- if $class_named(S.CLASSNAMES, $ptlc(ptbytes_class)) = (porigin)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
def $class_constant_member_typed(S, poperand_class, PSTRING ptbytes, z) = $class_constant_fetch(S, poperand_class, ptbytes, z)
  -- if S.CONSTCONTEXT =/= eps \/ $ptlc(ptbytes) =/= $ptascii("class")
def $class_constant_member_typed(S, poperand_class, pvalue, z) = $throw_scalar(S, "TypeError", $ptascii("Cannot use value of type ") ++ $ptascii($typed_tag(pvalue)) ++ $ptascii(" as class constant name"), z)
  -- if ~$method_string(pvalue)
rule PhpStep/class-constant-member: S ~> $class_constant_member_value(S_name[.TODO = ptask_tail*], poperand, S_name.RESULT, z)
  -- if S.TODO = (CLASS_CONST_MEMBER phpType19 poperand z) :: (CLASS_CONST_CAPTURE porigin poperand z) :: ptask_tail*
  -- if S.ORIGIN = (porigin)
  -- if S_name = $resolve_at(S, S.RESULT, z)
  -- if S_name.COMPLETION = NORMAL
rule PhpStep/class-constant-member-abrupt: S ~> S_name[.TODO = ptask_tail*]
  -- if S.TODO = (CLASS_CONST_MEMBER phpType19 poperand z) :: (CLASS_CONST_CAPTURE porigin poperand z) :: ptask_tail*
  -- if S_name = $resolve_at(S, S.RESULT, z)
  -- if S_name.COMPLETION =/= NORMAL

dec $class_constant_restore(pstate, pclassconstantcontext, pclassconstantcontext*) : pstate
def $class_constant_restore(S, pclassconstantcontext, pclassconstantcontext_tail*) = S[.CLASSCONSTANTINIT = pclassconstantcontext_tail*][.CONSTCONTEXT = pclassconstantcontext.PREVIOUS][.ORIGIN = pclassconstantcontext.ORIGIN]
rule PhpStep/class-constant-bind: S ~> $class_constant_result($class_constant_restore(S_value[.TODO = ptask_tail*][.CLASSCONSTANTCACHE = S_value.CLASSCONSTANTCACHE ++ [{ORIGIN porigin, VALUE pvalue, CLASS pvalueclass}]], pclassconstantcontext, pclassconstantcontext_tail*), pvalue, pvalueclass)
  -- if S.TODO = (CLASS_CONST_BIND porigin) :: ptask_tail*
  -- if S.CLASSCONSTANTINIT = pclassconstantcontext :: pclassconstantcontext_tail*
  -- if pclassconstantcontext.DECL = porigin
  -- if S.CONSTCONTEXT = (pconstantcontext)
  -- if $class_constant_origin(S.CLASSES, porigin) = (pclassconstantdesc)
  -- if S_value = $resolve_at(S, S.RESULT, pconstantcontext.LINE)
  -- if S_value.COMPLETION = NORMAL
  -- if S_value.RESULT = KNOWN pvalue_raw
  -- if $class_constant_runtime_type(S_value, pclassconstantdesc.TYPE, pvalue_raw)
  -- if pvalue = $class_constant_typed_value(pclassconstantdesc.TYPE, pvalue_raw)
  -- if pvalueclass = $constant_class(S_value, pclassconstantdesc.INITIALIZER)
rule PhpStep/class-constant-bind-type: S ~> $throw_scalar($class_constant_restore(S_value[.TODO = ptask_tail*], pclassconstantcontext, pclassconstantcontext_tail*), "TypeError", $ptascii("Cannot assign ") ++ $ptascii($typed_tag(pvalue)) ++ $ptascii(" to class constant ") ++ pclassconstantdesc.OWNERNAME ++ $ptascii("::") ++ pclassconstantdesc.NAME ++ $ptascii(" of type ") ++ $pttypename(pclassconstantdesc.TYPE), pconstantcontext.LINE)
  -- if S.TODO = (CLASS_CONST_BIND porigin) :: ptask_tail*
  -- if S.CLASSCONSTANTINIT = pclassconstantcontext :: pclassconstantcontext_tail*
  -- if pclassconstantcontext.DECL = porigin
  -- if S.CONSTCONTEXT = (pconstantcontext)
  -- if $class_constant_origin(S.CLASSES, porigin) = (pclassconstantdesc)
  -- if S_value = $resolve_at(S, S.RESULT, pconstantcontext.LINE)
  -- if S_value.COMPLETION = NORMAL
  -- if S_value.RESULT = KNOWN pvalue
  -- if ~$class_constant_runtime_type(S_value, pclassconstantdesc.TYPE, pvalue)
rule PhpStep/class-constant-bind-abrupt: S ~> S_value
  -- if S.TODO = (CLASS_CONST_BIND porigin) :: ptask_tail*
  -- if S.CONSTCONTEXT = (pconstantcontext)
  -- if S_value = $resolve_at(S, S.RESULT, pconstantcontext.LINE)
  -- if S_value.COMPLETION =/= NORMAL

def $constant_shape_class(S, porigin, PFCLASSCONST phpType19 phpType20) = pconstantfact.CLASS
  -- if S.CONSTCONTEXT = (pconstantcontext)
  -- if $constant_fact_at(pconstantcontext.FACTS, porigin) = (pconstantfact)
def $call_after_origin(S, CLASS_CONST_BIND porigin) = $class_constant_restore(S, pclassconstantcontext, pclassconstantcontext_tail*)
  -- if S.CLASSCONSTANTINIT = pclassconstantcontext :: pclassconstantcontext_tail*
  -- if pclassconstantcontext.DECL = porigin
def $return_discard(S, CLASS_CONST_BIND porigin) = S[.CLASSCONSTANTINIT = pclassconstantcontext_tail*][.CONSTCONTEXT = eps][.ORIGIN = pclassconstantcontext.ORIGIN]
  -- if S.CLASSCONSTANTINIT = pclassconstantcontext :: pclassconstantcontext_tail*
  -- if pclassconstantcontext.DECL = porigin

def $task_nodes(CLASS_CONST_MEMBER phpType19 poperand z) = eps
def $task_nodes(CLASS_CONST_CAPTURE porigin poperand z) = $operand_nodes(poperand)

;; A compound evaluator overrides the declaration location. Its synthetic frame
;; records the original fetch only when the file or line actually differs.
dec $class_constant_trace_context(pstate, pclassconstantcontext*) : pclassconstantcontext?
