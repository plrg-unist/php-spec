dec $class_constant_update_continuation(ptask) : bool
dec $class_constant_static_ready(pstate, poperand, ptbytes, int) : bool
dec $class_constant_constructor_ready(pstate, ptbytes, phpType7*, bool, int) : bool
dec $class_constant_pairs_valid(ptask*) : bool
dec $class_constant_previous_valid(pstate) : bool
dec $class_constant_trigger(expression) : bool
dec $class_constant_runtime_type(pstate, ptbranch*, pvalue) : bool
