;; Initialization retains the selected fetch or the source-derived update target.
;; Restoring the previous scope must select this exact declaration again.
dec $class_constant_identifier(phpType20) : bool
def $class_constant_identifier(NIdentifier (BYTES text) metadata) = true
def $class_constant_identifier(phpType20) = false -- otherwise
dec $class_constant_member_record(pvalue?, pconstantfact?, ptbytes, bool) : bool
def $class_constant_member_record((PSTRING ptbytes_value), pconstantfact?, ptbytes, b) = (ptbytes = ptbytes_value)
def $class_constant_member_record(eps, (pconstantfact), ptbytes, b) = (pconstantfact.VALUE = (PSTRING ptbytes))
def $class_constant_member_record(eps, eps, ptbytes, b) = b
def $class_constant_member_record(pvalue?, pconstantfact?, ptbytes, b) = false -- otherwise
dec $class_constant_member_facts(pstate, porigin) : pconstantfact?
def $class_constant_member_facts(S, porigin) = $constant_fact_at(pconstantcontext.FACTS, porigin)
  -- if S.CONSTCONTEXT = (pconstantcontext)
def $class_constant_member_facts(S, porigin) = eps -- if S.CONSTCONTEXT = eps
dec $class_constant_member_origin(pstate, porigin?, ptbytes) : bool
def $class_constant_member_origin(S, (porigin), ptbytes) = $class_constant_member_record($compiled_read(S, porigin), $class_constant_member_facts(S, porigin), ptbytes, S.CONSTCONTEXT = eps)
def $class_constant_member_origin(S, eps, ptbytes) = false
dec $class_constant_member_selected(pstate, phpType20, ptbytes) : bool
def $class_constant_member_selected(S, NIdentifier (BYTES text) metadata, ptbytes) = (ptbytes = $base64(text))
def $class_constant_member_selected(S, expression, ptbytes) = $class_constant_member_origin(S, $origin_child(S.ORIGIN, [PCFIELD 1]), ptbytes)
  -- if ~$class_constant_identifier(expression)

