def $class_constant_merge(pclassconstantdesc_old*, pclassconstantdesc :: pclassconstantdesc_tail*) = $class_constant_merge(pclassconstantdesc_old*, pclassconstantdesc_tail*)
  -- if pclassconstantdesc.VISIBILITY = PROPERTY_PRIVATE \/ $class_constant_desc(pclassconstantdesc_old*, pclassconstantdesc.NAME) =/= eps
def $class_constant_merge(pclassconstantdesc_old*, pclassconstantdesc :: pclassconstantdesc_tail*) = $class_constant_merge(pclassconstantdesc_old* ++ [pclassconstantdesc], pclassconstantdesc_tail*)
  -- if pclassconstantdesc.VISIBILITY =/= PROPERTY_PRIVATE /\ $class_constant_desc(pclassconstantdesc_old*, pclassconstantdesc.NAME) = eps
dec $class_constant_layout(pstate, porigin, nat) : pclassconstantdesc*
dec $class_constant_parent_layout(pstate, porigin, nat) : pclassconstantdesc*
dec $class_constant_interface_layout(pstate, pilref*, nat, pclassconstantdesc*) : pclassconstantdesc*
def $class_constant_layout(S, porigin, n) = $class_constant_interface_layout(S, pilref*, $nabs($(n - 1)), $class_constant_merge(pclassdesc.CONSTANTS, $class_constant_parent_layout(S, porigin, n)))
  -- if $(n > 0)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if $pil_at(S.LINKEDINTERFACES, porigin) = (PILTARGETS pilref*)
def $class_constant_layout(S, porigin, n) = $class_constant_merge(pclassdesc.CONSTANTS, $class_constant_parent_layout(S, porigin, n))
  -- if $(n > 0)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if $pil_at(S.LINKEDINTERFACES, porigin) = eps
def $class_constant_layout(S, porigin, n) = eps -- otherwise
def $class_constant_parent_layout(S, porigin, n) = $class_constant_layout(S, porigin_parent, $nabs($(n - 1)))
  -- if $(n > 0)
  -- if $class_link_at(S.LINKEDPARENTS, porigin) = (SOURCE_PARENT porigin_parent)
def $class_constant_parent_layout(S, porigin, n) = eps -- otherwise
def $class_constant_interface_layout(S, eps, n, pclassconstantdesc*) = pclassconstantdesc*
def $class_constant_interface_layout(S, (PILSOURCE ptbytes porigin) :: pilref_tail*, n, pclassconstantdesc*) = $class_constant_interface_layout(S, pilref_tail*, n, $class_constant_merge(pclassconstantdesc*, $class_constant_layout(S, porigin, n)))
def $class_constant_interface_layout(S, (PILBUILTIN ptbytes) :: pilref_tail*, n, pclassconstantdesc*) = $class_constant_interface_layout(S, pilref_tail*, n, pclassconstantdesc*)

dec $class_constant_update_order(pstate, porigin, nat) : pclassconstantdesc*
def $class_constant_update_order(S, porigin, n) = $class_constant_update_order(S, porigin_parent, $nabs($(n - 1))) ++ $class_constant_layout(S, porigin, n)
  -- if $(n > 0)
  -- if $class_link_at(S.LINKEDPARENTS, porigin) = (SOURCE_PARENT porigin_parent)
def $class_constant_update_order(S, porigin, n) = $class_constant_layout(S, porigin, n) -- otherwise
dec $class_constant_update_pending(pstate, pclassconstantdesc*, porigin*) : porigin*
def $class_constant_update_pending(S, eps, porigin_seen*) = eps
def $class_constant_update_pending(S, pclassconstantdesc :: pclassconstantdesc_tail*, porigin_seen*) = $class_constant_update_pending(S, pclassconstantdesc_tail*, porigin_seen*)
  -- if pclassconstantdesc.FOLDED \/ $default_cache_at(S.CLASSCONSTANTCACHE, pclassconstantdesc.ORIGIN) =/= eps \/ pclassconstantdesc.ORIGIN <- porigin_seen*
def $class_constant_update_pending(S, pclassconstantdesc :: pclassconstantdesc_tail*, porigin_seen*) = pclassconstantdesc.ORIGIN :: $class_constant_update_pending(S, pclassconstantdesc_tail*, porigin_seen* ++ [pclassconstantdesc.ORIGIN])
  -- if ~pclassconstantdesc.FOLDED /\ $default_cache_at(S.CLASSCONSTANTCACHE, pclassconstantdesc.ORIGIN) = eps /\ ~(pclassconstantdesc.ORIGIN <- porigin_seen*)
dec $class_constant_updates(pstate, porigin) : porigin*
def $class_constant_updates(S, porigin) = eps -- if $class_constant_table_done(S, porigin)
def $class_constant_updates(S, porigin) = $class_constant_update_pending(S, $class_constant_update_order(S, porigin, |S.CLASSES|), eps)
  -- if ~$class_constant_table_done(S, porigin)
dec $class_constant_update_tasks(porigin*, int) : ptask*
def $class_constant_update_tasks(eps, z) = eps
def $class_constant_update_tasks(porigin :: porigin_tail*, z) = (CLASS_CONST_UPDATE porigin z) :: $class_constant_update_tasks(porigin_tail*, z)

dec $class_constant_table_parent_tasks(pstate, porigin, int, nat) : ptask*
def $class_constant_table_parent_tasks(S, porigin, z, n) = $class_constant_table_tasks(S, porigin_parent, z, $nabs($(n - 1)))
  -- if $(n > 0)
  -- if $class_link_at(S.LINKEDPARENTS, porigin) = (SOURCE_PARENT porigin_parent)
def $class_constant_table_parent_tasks(S, porigin, z, n) = eps -- otherwise

def $class_constant_table_order(S, porigin, 0) = eps
def $class_constant_table_order(S, porigin, n) = eps
  -- if $(n > 0) /\ $class_constant_table_done(S, porigin)
def $class_constant_table_order(S, porigin, n) = $class_constant_table_order(S, porigin_parent, $nabs($(n - 1))) ++ [porigin]
  -- if $(n > 0) /\ ~$class_constant_table_done(S, porigin)
  -- if $class_link_at(S.LINKEDPARENTS, porigin) = (SOURCE_PARENT porigin_parent)
def $class_constant_table_order(S, porigin, n) = [porigin] -- otherwise

def $class_constant_table_tasks(S, porigin, z, 0) = eps
def $class_constant_table_tasks(S, porigin, z, n) = eps
  -- if $(n > 0) /\ $class_constant_table_done(S, porigin)
def $class_constant_table_tasks(S, porigin, z, n) = $class_constant_table_parent_tasks(S, porigin, z, n) ++ $class_constant_update_tasks($class_constant_update_pending(S, $class_constant_layout(S, porigin, n), $class_constant_update_origins($class_constant_parent_layout(S, porigin, n), eps)), z) ++ [CLASS_CONST_TABLE_UPDATE porigin z]
  -- if $(n > 0) /\ ~$class_constant_table_done(S, porigin)

;; Table completion is distinct from an individual successful constant fetch.
dec $class_constant_new_work(pstate, ptbytes, int) : ptask*
def $class_constant_new_work(S, ptbytes, z) = $class_constant_table_tasks(S, porigin, z, |S.CLASSES|)
  -- if $class_named(S.CLASSNAMES, $ptlc(ptbytes)) = (porigin)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if pclassdesc.KIND = "class" /\ ~pclassdesc.ABSTRACT
def $class_constant_new_work(S, ptbytes, z) = eps -- otherwise
def $constructor_start(S, ptbytes, phpType7*, z) = S[.TODO = ptask_work* ++ [CLASS_CONST_CONSTRUCT ptbytes phpType7* true z] ++ S.TODO][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if ptask_work* = $class_constant_new_work(S, ptbytes, z)
  -- if ptask_work* =/= eps
def $constructor_start(S, ptbytes, phpType7*, z) = $constructor_start_ready(S, ptbytes, phpType7*, z)
  -- if $class_constant_new_work(S, ptbytes, z) = eps
def $noctor_start(S, ptbytes, phpType7*, z) = S[.TODO = ptask_work* ++ [CLASS_CONST_CONSTRUCT ptbytes phpType7* false z] ++ S.TODO][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if ptask_work* = $class_constant_new_work(S, ptbytes, z)
  -- if ptask_work* =/= eps
def $noctor_start(S, ptbytes, phpType7*, z) = $noctor_start_ready(S, ptbytes, phpType7*, z)
  -- if $class_constant_new_work(S, ptbytes, z) = eps
rule PhpStep/class-constant-update: S ~> $class_constant_value(S[.TODO = DISCARD :: ptask_tail*], pclassconstantdesc, CLASS_CONST_UPDATE_SELECT porigin_class, pclassconstantdesc.OWNERNAME, z)
  -- if S.TODO = (CLASS_CONST_UPDATE porigin z) :: ptask_tail*
  -- if $class_constant_update_target(S, ptask_tail*) = (porigin_class)
  -- if $class_constant_origin(S.CLASSES, porigin) = (pclassconstantdesc)
dec $parameter_default_new_ready(pstate, ptbytes, phpType7*, int) : bool
dec $constructor_after_class_update(pstate, ptbytes, phpType7*, int) : pstate
rule PhpStep/class-constant-construct: S ~> $constructor_after_class_update(S[.TODO = ptask_tail*], ptbytes, phpType7*, z)
  -- if S.TODO = (CLASS_CONST_CONSTRUCT ptbytes phpType7* true z) :: ptask_tail*
rule PhpStep/class-constant-construct-noctor: S ~> $noctor_start_ready(S[.TODO = ptask_tail*], ptbytes, phpType7*, z)
  -- if S.TODO = (CLASS_CONST_CONSTRUCT ptbytes phpType7* false z) :: ptask_tail*

