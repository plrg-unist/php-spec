;; Remaining updates are unique and source ordered. Cached entries may remain
;; after nested initialization, but every uncached, nonbusy slot must be present.
def $class_constant_update_origins(eps, porigin_seen*) = eps
def $class_constant_update_origins(pclassconstantdesc :: pclassconstantdesc_tail*, porigin_seen*) = $class_constant_update_origins(pclassconstantdesc_tail*, porigin_seen*)
  -- if pclassconstantdesc.FOLDED \/ pclassconstantdesc.ORIGIN <- porigin_seen*
