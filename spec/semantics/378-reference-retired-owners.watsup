  -- if $(pretiredowner.ARRAY < |S.ARRAYS|)
  -- if (HARRAY pretiredowner.ARRAY) <- S.ALLOCATIONS
  -- if $($heap_owners($heap_graph(S), HARRAY pretiredowner.ARRAY) > 0)
