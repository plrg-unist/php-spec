dec $retired_future_check(pstate, porigin, int, bool, ptask*) : bool
dec $retired_recheck_task(ptask, porigin, int) : bool
dec $retired_recheck_for(ptask*, porigin, int) : bool
;; Coherent recovery after the first real array end-owner release. These rows
;; and paired controls borrow physical identity; they add no heap root or edge.
dec $retired_lookup(pretiredowner*, porigin) : pretiredowner?
def $retired_lookup(eps, porigin) = eps
def $retired_lookup(pretiredowner :: pretiredowner_tail*, porigin) = (pretiredowner)
  -- if pretiredowner.OWNER = porigin
def $retired_lookup(pretiredowner :: pretiredowner_tail*, porigin) = $retired_lookup(pretiredowner_tail*, porigin)
  -- if pretiredowner.OWNER =/= porigin
dec $retired_remove(pretiredowner*, porigin) : pretiredowner*
def $retired_remove(eps, porigin) = eps
def $retired_remove(pretiredowner :: pretiredowner_tail*, porigin) = $retired_remove(pretiredowner_tail*, porigin)
  -- if pretiredowner.OWNER = porigin
def $retired_remove(pretiredowner :: pretiredowner_tail*, porigin) = pretiredowner :: $retired_remove(pretiredowner_tail*, porigin)
  -- if pretiredowner.OWNER =/= porigin
dec $retired_set(pretiredowner*, pretiredowner) : pretiredowner*
def $retired_set(pretiredowner_all*, pretiredowner) = $retired_remove(pretiredowner_all*, pretiredowner.OWNER) ++ [pretiredowner]
def $retired_enter(S, (porigin)) = S[.RETIREDOWNERS = $retired_remove(S.RETIREDOWNERS, porigin)]
def $retired_enter(S, eps) = S

dec $retired_scalar(pvalue) : bool
def $retired_scalar(PNULL) = true
def $retired_scalar(PBOOL b) = true
def $retired_scalar(PINT z) = true
def $retired_scalar(PFLOAT n) = true
def $retired_scalar(PSTRING n*) = true
def $retired_scalar(PSTRING_CARRIER pstringidentity n*) = true
def $retired_scalar(pvalue) = false -- otherwise
dec $retired_scalar_entries(pentry*) : bool
def $retired_scalar_entries(eps) = true
def $retired_scalar_entries((ENTRY pkey (DIRECT pvalue)) :: pentry_tail*) = ($retired_scalar(pvalue) /\ $retired_scalar_entries(pentry_tail*))
def $retired_scalar_entries(pentry*) = false -- otherwise
dec $retired_dense_entries(pentry*, pposition*, nat) : bool
def $retired_dense_entries(eps, eps, n) = true
def $retired_dense_entries((ENTRY (KINT z) (DIRECT pvalue)) :: pentry_tail*, (POSITION (KINT z) n) :: pposition_tail*, n) = ($retired_scalar(pvalue) /\ $retired_dense_entries(pentry_tail*, pposition_tail*, $(n + 1)))
  -- if z = $(n)
def $retired_dense_entries(pentry*, pposition*, n) = false -- otherwise
dec $retired_dense_array(parray) : bool
def $retired_dense_array(parray) = ($retired_dense_entries(parray.ITEMS, parray.POSITIONS, 0) /\ parray.SERIAL = |parray.ITEMS|)

;; This is the pinned ordinary named DO_FCALL VAR result route, not a guess
;; from CODEEXPR's boolean. CV/CONST and ref-returning calls remain separate.
dec $retired_switch_var_site(pstate, porigin) : bool
def $retired_switch_var_site(S, PORIGIN n pcpath) = true
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (NStmtSwitch (NExprFuncCall name (SEQUENCE eps) metadata_call) phpType60 metadata)
  -- if $goto_scope_valid(S, PORIGIN n pcpath)
  -- if $code_at(S.CODE, n) = (pcode)
  -- if pcpath_subject = pcpath ++ [PCFIELD 0]
  -- if $code_name(pcode.NAMES, pcpath_subject) = ((ptbytes_name, eps))
  -- if ~$pfunction_builtin(ptbytes_name)
  -- if $source_emission_noarg_call(S, n, pcpath_subject, NExprFuncCall name (SEQUENCE eps) metadata_call) = (z_init)
  -- if $ppunpack_call_class(pcode.NAMES, pcpath_subject) = (UNPACK_VAR)
  -- if $code_expression(pcode.EXPRESSIONS, pcpath_subject) = ((z_call, false))
  -- if $compiled_read(S, PORIGIN n pcpath_subject) = eps
  -- if $call_target(S, ptbytes_name, eps) = (pfunction)
  -- if ~pfunction.SIGNATURE.BYREF
  -- if $call_supported_signature(S, pfunction)
def $retired_switch_var_site(S, porigin) = false -- otherwise
dec $retired_foreach_site(pstate, porigin) : bool
def $retired_foreach_site(S, porigin) = true
  -- if $origin_node(S.SOURCES, porigin) = (NStmtForeach expression phpType5 (BOOLEAN false) expression_value phpType23 (BOOLEAN false) metadata)
  -- if ~$ppforeach_references(expression_value, false)
  -- if $goto_scope_valid(S, porigin)
def $retired_foreach_site(S, porigin) = false -- otherwise
dec $retired_inside(pstate, porigin, porigin) : bool
def $retired_inside(S, PORIGIN n pcpath_owner, PORIGIN n pcpath_source) = true
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath_owner) = (NStmtSwitch expression phpType60 metadata)
  -- if $effect_below(pcpath_owner ++ [PCFIELD 1], pcpath_source)
def $retired_inside(S, PORIGIN n pcpath_owner, PORIGIN n pcpath_source) = true
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath_owner) = (NStmtForeach expression phpType5 phpType4 expression_value phpType23 phpType4_else metadata)
  -- if $effect_below(pcpath_owner ++ [PCFIELD 4], pcpath_source)
def $retired_inside(S, porigin_owner, porigin_source) = false -- otherwise
dec $retired_return_site(pstate, porigin, int) : bool
def $retired_return_site(S, porigin, z) = true
  -- if $goto_scope_valid(S, porigin)
  -- if $reference_return_source(S[.ORIGIN = (porigin)], z)
  -- if S.CURRENT = (pcallcontext)
  -- if $function_at($all_functions(S), pcallcontext.FUNCTION) = (pfunction)
  -- if pfunction.SIGNATURE.RETURNS =/= eps
  -- if ~("mixed" <- $ptmasks(pfunction.SIGNATURE.RETURNS))
  -- if $ref_replay_owners(S, porigin) =/= eps
  -- if ~$ref_replay_from_finalizer(S, porigin)
  -- if ~$generator_active(S)
def $retired_return_site(S, porigin, z) = false -- otherwise
dec $retired_kind_valid(pstate, pretiredowner) : bool
def $retired_kind_valid(S, pretiredowner) = $retired_switch_var_site(S, pretiredowner.OWNER)
  -- if pretiredowner.KIND = RET_SWITCH_VAR_ARRAY
  -- if pretiredowner.POSITION = eps
def $retired_kind_valid(S, pretiredowner) = $retired_foreach_site(S, pretiredowner.OWNER)
  -- if pretiredowner.KIND = RET_FOREACH_VALUE_ARRAY
  -- if pretiredowner.POSITION = (n_position)
def $retired_kind_valid(S, pretiredowner) = false -- otherwise
;; Source and historical slot bounds survive allocation retirement. Liveness
;; and admitted payload category are checked only for reconstruction or fetch.
dec $retired_row_valid(pstate, pretiredowner) : bool
def $retired_row_valid(S, pretiredowner) = true
  -- if $(pretiredowner.ARRAY < |S.ARRAYS|)
  -- if $retired_kind_valid(S, pretiredowner)
  -- if $retired_return_site(S, pretiredowner.FIRSTRETURN, pretiredowner.FIRSTLINE)
  -- if $retired_return_site(S, pretiredowner.LASTRETURN, pretiredowner.LASTLINE)
  -- if $retired_inside(S, pretiredowner.OWNER, pretiredowner.FIRSTRETURN)
  -- if $retired_inside(S, pretiredowner.OWNER, pretiredowner.LASTRETURN)
def $retired_row_valid(S, pretiredowner) = false -- otherwise

dec $retired_task_row(ptask) : pretiredowner?
def $retired_task_row(RETIRED_SWITCH_END pretiredowner) = (pretiredowner)
def $retired_task_row(RETIRED_FOREACH_NEXT pretiredowner) = (pretiredowner)
def $retired_task_row(RETIRED_OWNER_PHASE pretiredowner) = (pretiredowner)
def $retired_task_row(ptask) = eps -- otherwise
dec $retired_end_task(pretiredowner) : ptask
def $retired_end_task(pretiredowner) = RETIRED_SWITCH_END pretiredowner
  -- if pretiredowner.KIND = RET_SWITCH_VAR_ARRAY
def $retired_end_task(pretiredowner) = RETIRED_FOREACH_NEXT pretiredowner
  -- if pretiredowner.KIND = RET_FOREACH_VALUE_ARRAY
dec $retired_pair_tasks(pretiredowner) : ptask*
def $retired_pair_tasks(pretiredowner) = [$retired_end_task(pretiredowner), RETIRED_OWNER_PHASE pretiredowner]
dec $retired_pair(ptask*, pretiredowner) : bool
def $retired_pair(eps, pretiredowner) = false
def $retired_pair(ptask :: (RETIRED_OWNER_PHASE pretiredowner) :: ptask_tail*, pretiredowner) = true
  -- if ptask = $retired_end_task(pretiredowner)
def $retired_pair(ptask :: ptask_tail*, pretiredowner) = $retired_pair(ptask_tail*, pretiredowner)
  -- if $retired_task_row(ptask) =/= (pretiredowner)
def $retired_pair(ptask*, pretiredowner) = false -- otherwise
dec $retired_owner_count(ptask*, porigin) : nat
def $retired_owner_count(eps, porigin) = 0
def $retired_owner_count(ptask :: ptask_tail*, porigin) = $(1 + $retired_owner_count(ptask_tail*, porigin))
  -- if $retired_task_row(ptask) = (pretiredowner)
  -- if pretiredowner.OWNER = porigin
def $retired_owner_count(ptask :: ptask_tail*, porigin) = $retired_owner_count(ptask_tail*, porigin)
  -- if $retired_task_row(ptask) = eps
def $retired_owner_count(ptask :: ptask_tail*, porigin) = $retired_owner_count(ptask_tail*, porigin)
  -- if $retired_task_row(ptask) = (pretiredowner)
  -- if pretiredowner.OWNER =/= porigin
dec $retired_pair_valid(pstate, pretiredowner) : bool
def $retired_pair_valid(S, pretiredowner) = ($retired_row_valid(S, pretiredowner) /\ $retired_lookup(S.RETIREDOWNERS, pretiredowner.OWNER) = (pretiredowner) /\ $retired_pair(S.TODO, pretiredowner) /\ $retired_owner_count(S.TODO, pretiredowner.OWNER) = 2 /\ $switch_replay_owner_count(S.TODO, pretiredowner.OWNER) = 1)

;; Pending selection is syntactic and separate from descriptor validation.
;; The existing task validators authenticate operands, source and phase.
dec $retired_capability_task(ptask, porigin, int) : bool
def $retired_capability_task(RETURN_REF_UNWIND poperand z b porigin, porigin, z) = true
def $retired_capability_task(FINALLY_REF_RETURN porigin_final porigin poperand z, porigin, z) = true
def $retired_capability_task(REF_RECHECK porigin porigin_first poperand z, porigin, z) = true
def $retired_capability_task(REF_REPLAY porigin poperand z prefowner*, porigin, z) = true
def $retired_capability_task(REF_REPLAY_ORIGIN porigin z prefowner*, porigin, z) = true
def $retired_capability_task(ptask, porigin, z) = false -- otherwise
dec $retired_capability(ptask*, porigin, int) : bool
def $retired_capability(eps, porigin, z) = false
def $retired_capability(ptask :: ptask_tail*, porigin, z) = ($retired_capability_task(ptask, porigin, z) \/ $retired_capability(ptask_tail*, porigin, z))
dec $retired_pending(pstate, pretiredowner, ptask*) : bool
def $retired_pending(S, pretiredowner, eps) = false
def $retired_pending(S, pretiredowner, (RETURN_REF_UNWIND poperand z b porigin) :: ptask_tail*) = true
  -- if pretiredowner.LASTRETURN = porigin /\ pretiredowner.LASTLINE = z
  -- if $retired_future_check(S, porigin, z, b, ptask_tail*)
def $retired_pending(S, pretiredowner, (FINALLY_REF_RETURN porigin_final porigin poperand z) :: ptask_tail*) = true
  -- if pretiredowner.LASTRETURN = porigin /\ pretiredowner.LASTLINE = z
  -- if $finally_source_inside(S, porigin_final, porigin)
  -- if $finally_present(S, porigin_final)
def $retired_pending(S, pretiredowner, (REF_RECHECK porigin porigin_first poperand z) :: ptask_tail*) = true
  -- if pretiredowner.LASTRETURN = porigin /\ pretiredowner.LASTLINE = z
  -- if porigin_first <- $ref_replay_owners(S, porigin)
def $retired_pending(S, pretiredowner, (REF_REPLAY porigin poperand z prefowner*) :: ptask_tail*) = true
  -- if pretiredowner.LASTRETURN = porigin /\ pretiredowner.LASTLINE = z
  -- if prefowner* = $ref_replay_contexts(S, porigin)
def $retired_pending(S, pretiredowner, (REF_REPLAY_ORIGIN porigin z prefowner*) :: (REF_REPLAY_PHASE porigin z prefowner*) :: ptask_tail*) = true
  -- if pretiredowner.LASTRETURN = porigin /\ pretiredowner.LASTLINE = z
  -- if $ref_replay_site(S, porigin, z, prefowner*)
def $retired_pending(S, pretiredowner, ptask :: ptask_tail*) = $retired_pending(S, pretiredowner, ptask_tail*)
  -- if ~$retired_capability_task(ptask, pretiredowner.LASTRETURN, pretiredowner.LASTLINE)
def $retired_pending(S, pretiredowner, ptask*) = false -- otherwise
dec $retired_rows_valid(pstate, pretiredowner*) : bool
def $retired_rows_valid(S, eps) = true
def $retired_rows_valid(S, pretiredowner :: pretiredowner_tail*) = ($retired_row_valid(S, pretiredowner) /\ $retired_lookup(pretiredowner_tail*, pretiredowner.OWNER) = eps /\ ($retired_pair_valid(S, pretiredowner) \/ ($retired_owner_count(S.TODO, pretiredowner.OWNER) = 0 /\ $switch_replay_owner_count(S.TODO, pretiredowner.OWNER) = 0 /\ $retired_pending(S, pretiredowner, S.TODO))) /\ $retired_rows_valid(S, pretiredowner_tail*))
def $retired_current_valid(S) = $retired_rows_valid(S, S.RETIREDOWNERS)

dec $retired_live(pstate, pretiredowner) : bool
def $retired_live(S, pretiredowner) = true
  -- if $(pretiredowner.ARRAY < |S.ARRAYS|)
  -- if (HARRAY pretiredowner.ARRAY) <- S.ALLOCATIONS
  -- if $($heap_owners($heap_graph(S), HARRAY pretiredowner.ARRAY) > 0)
  -- if pretiredowner.KIND = RET_SWITCH_VAR_ARRAY
  -- if $retired_scalar_entries(S.ARRAYS[pretiredowner.ARRAY].ITEMS)
