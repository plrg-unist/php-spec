  -- if $exception_raw_selected(S_history, passertcall.CALLBACK, passertcall.RAW, papiargcursor.TARGET)
  -- if $handler_emitter_valid(S_history, papiargcursor.TARGET)
  -- if $api_cursor_site_valid(S, papiargcursor)
  -- if papiargcursor.VALUES = $api_callback_values(S, papiargcursor.CALL)
  -- if |papiargcursor.SENT| = papiargcursor.INDEX /\ $(papiargcursor.INDEX <= |papiargcursor.VALUES|)
  -- if $api_cursor_sent_valid(S_history, papiargcursor.TARGET, papiargcursor.VALUES, papiargcursor.SENT, 0)
  -- if S.ORIGIN = (papiargcursor.SITE)
def $api_cursor_saved_valid(S, papiargcursor) = false -- otherwise
def $api_cursor_warning_valid(S, papiargcursor) = ($api_cursor_valid(S, papiargcursor) \/ $api_cursor_saved_valid(S, papiargcursor))
def $api_cursor_warning_ref_valid(S, papiargcursor) = true
  -- if $api_cursor_warning_valid(S, papiargcursor)
  -- if $(papiargcursor.INDEX < |papiargcursor.VALUES|)
  -- if S_history = $api_callback_result_scope(S, API_BORROWED_TARGET papiargcursor.PRODUCER)
  -- if $call_parameter_reference(S_history, papiargcursor.TARGET, papiargcursor.INDEX)
def $api_cursor_warning_ref_valid(S, papiargcursor) = false -- otherwise
def $call_task_valid(S, API_CALLBACK_SEND papiargcursor) = $api_cursor_valid(S, papiargcursor)
def $call_task_valid(S, API_CALLBACK_REF papiargcursor) = ($api_cursor_valid(S, papiargcursor) /\ $(papiargcursor.INDEX < |papiargcursor.VALUES|) /\ $call_parameter_reference(S, papiargcursor.TARGET, papiargcursor.INDEX))
rule PhpStep/api-callback-send-expired: S ~> S[.COMPLETION = UNSUPPORTED "expired selected API callback before argument copy"]
