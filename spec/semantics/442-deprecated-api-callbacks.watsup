def $task_nodes(API_CALLBACK_SEND papiargcursor) = $api_callback_roots(papiargcursor.CALL) ++ $operands_roots(papiargcursor.SENT)
def $task_nodes(API_CALLBACK_REF papiargcursor) = $api_callback_roots(papiargcursor.CALL) ++ $operands_roots(papiargcursor.SENT)
def $selected_task_nonce(API_CALLBACK_SEND papiargcursor) = $api_callback_nonce(papiargcursor.CALL)
def $selected_task_nonce(API_CALLBACK_REF papiargcursor) = $api_callback_nonce(papiargcursor.CALL)
