  -- if papiquery.CALLED = $api_frame_called(S)
  -- if papiquery.THIS = $api_frame_this(S)
  -- if papiquery.LINE = $api_source_line(S, papiquery.SOURCE)
def $handler_emitter_valid(S, API_METHOD_TARGET papiquery porigin_method ptbytes b_static) = true
  -- if S.TODO = (API_CALLBACK_REF papiargcursor) :: ptask_tail*
  -- if papiargcursor.CALL = API_ERROR perrorcall
