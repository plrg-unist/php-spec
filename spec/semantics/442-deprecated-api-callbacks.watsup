;; zend_call_function selects its callback before the Deprecated warning. The
;; selected receiver is borrowed through warning dispatch and argument copying;
;; a Closure gains its call owner only when the entered frame is installed.
dec $api_callback_values(pstate, papicallback) : pvalue*
dec $api_callback_selected(pstate, papicallback, pcalltarget) : bool
dec $api_callback_roots(papicallback) : pnode*
dec $api_callback_nonce(papicallback) : nat?
dec $api_callback_discard(pstate, papicallback) : pstate
dec $api_callback_result(papicallback, pshutdownproducer) : ptask
dec $api_callback_producer(pstate, pcalltarget, porigin) : pshutdownproducer
dec $api_cursor_valid(pstate, papiargcursor) : bool
dec $api_cursor_saved_valid(pstate, papiargcursor) : bool
dec $api_cursor_warning_valid(pstate, papiargcursor) : bool
dec $api_cursor_warning_ref_valid(pstate, papiargcursor) : bool
dec $api_cursor_site_valid(pstate, papiargcursor) : bool
dec $api_cursor_producer_shape(papiargcursor) : bool
dec $api_cursor_producer_live(pstate, papiargcursor) : bool
