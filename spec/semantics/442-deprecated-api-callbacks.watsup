def $return_discard(S, API_CALLBACK_REF papiargcursor) = $api_callback_discard(S, papiargcursor.CALL)
;; A throwing diagnostic handler first discards its own RESULT. Transfer the
;; saved cursor back under THROW_SEARCH, then discard its prepared prefix once.
def $error_read_discard(S, API_CALLBACK_SEND papiargcursor) = $api_cursor_read_discard(S, API_CALLBACK_SEND papiargcursor)
def $error_read_discard(S, API_CALLBACK_REF papiargcursor) = $api_cursor_read_discard(S, API_CALLBACK_REF papiargcursor)
def $api_cursor_read_discard(S, API_CALLBACK_SEND papiargcursor) = S[.TODO = (THROW_SEARCH n) :: (API_CALLBACK_SEND papiargcursor) :: ptask_tail*]
  -- if S.TODO = (THROW_SEARCH n) :: ptask_tail*
def $api_cursor_read_discard(S, API_CALLBACK_REF papiargcursor) = S[.TODO = (THROW_SEARCH n) :: (API_CALLBACK_REF papiargcursor) :: ptask_tail*]
  -- if S.TODO = (THROW_SEARCH n) :: ptask_tail*
def $api_cursor_read_discard(S, ptask) = S[.COMPLETION = UNSUPPORTED "API callback abrupt handler completion"] -- otherwise
def $call_after_origin(S, API_CALLBACK_SEND papiargcursor) = S[.ORIGIN = (papiargcursor.SITE)]
def $call_after_origin(S, API_CALLBACK_REF papiargcursor) = S[.ORIGIN = (papiargcursor.SITE)]
def $error_context_trigger(S, pcallcontext) = (passertcall.FAILURE.CALL)
