def $nodiscard_api_target(API_BORROWED_TARGET pshutdownproducer) = true
def $api_borrowed_receiver_retired(S) = true
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.TARGET = API_BORROWED_TARGET pshutdownproducer
  -- if pcallcontext.RECEIVER = (n)
  -- if ~((HOBJECT n) <- S.ALLOCATIONS)
  -- if S.COMPLETION = NORMAL
  -- if S.TODO = ptask :: ptask_tail*
def $api_borrowed_receiver_retired(S) = false -- otherwise
def $output_guard(S) = S[.COMPLETION = UNSUPPORTED "access through a retired API callback receiver"]
  -- if ~S.OUTPUTBLOCKED /\ ~$ob_user_boundary(S)
