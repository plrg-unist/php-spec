dec $api_cursor_reference_event(pstate, papiargcursor, ptbytes) : pevent
dec $api_cursor_deprecated_event(pstate, papiargcursor, ptbytes) : pevent
dec $api_cursor_enter(pstate, papiargcursor) : pstate
dec $api_callback_warn(pstate, pfunction, papiargcursor) : pstate
dec $api_callback_arity(pstate, pfunction, nat, porigin?, int) : pstate
dec $api_cursor_read_discard(pstate, ptask) : pstate

def $target_nodes(API_BORROWED_TARGET pshutdownproducer) = eps
def $target_instance(API_BORROWED_TARGET pshutdownproducer) = $target_instance(pshutdownproducer.TARGET)
def $call_receiver_roots(pcallcontext) = eps
  -- if pcallcontext.TARGET = API_BORROWED_TARGET pshutdownproducer
def $target_receiver(S, API_BORROWED_TARGET pshutdownproducer) = $target_receiver($api_callback_result_scope(S, API_BORROWED_TARGET pshutdownproducer), pshutdownproducer.TARGET)
def $target_lexical_class(S, API_BORROWED_TARGET pshutdownproducer) = $target_lexical_class($api_callback_result_scope(S, API_BORROWED_TARGET pshutdownproducer), pshutdownproducer.TARGET)
def $target_called_class(S, API_BORROWED_TARGET pshutdownproducer) = $target_called_class($api_callback_result_scope(S, API_BORROWED_TARGET pshutdownproducer), pshutdownproducer.TARGET)
;; Result validation may read the completed selection after the call's last
;; Closure owner has gone. This view restores only selection metadata; actual
;; argument sends and body reads use S and its live allocation set.
def $api_callback_result_scope(S, API_BORROWED_TARGET pshutdownproducer) = $consumer_producer_history(S, pshutdownproducer)
def $target_function(S, API_BORROWED_TARGET pshutdownproducer) = $target_function($api_callback_result_scope(S, API_BORROWED_TARGET pshutdownproducer), pshutdownproducer.TARGET)
def $api_borrowed_target(API_BORROWED_TARGET pshutdownproducer) = true
def $api_borrowed_target(pcalltarget) = false -- otherwise
def $handler_method_tag(API_BORROWED_TARGET pshutdownproducer) = true
def $error_handler_selected(S, pvalue, API_BORROWED_TARGET pshutdownproducer) = $error_handler_selected(S, pvalue, pshutdownproducer.TARGET)
def $exception_raw_selected(S, pvalue, (parray), API_BORROWED_TARGET pshutdownproducer) = $exception_raw_selected(S, pvalue, (parray), pshutdownproducer.TARGET)
def $handler_emitter_valid(S, API_BORROWED_TARGET pshutdownproducer) = $handler_emitter_valid(S, pshutdownproducer.TARGET)
def $handler_emitter_valid(S, API_METHOD_TARGET papiquery porigin_method ptbytes b_static) = true
