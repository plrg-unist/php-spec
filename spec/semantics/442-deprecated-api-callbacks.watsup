def $api_callback_values(S, API_ERROR perrorcall) = $error_handler_values(S, perrorcall)
def $api_callback_values(S, API_ASSERT passertcall) = $assertion_callback_values(S, passertcall.FAILURE)
def $api_callback_selected(S, API_ERROR perrorcall, pcalltarget) = ($error_call_valid(S, perrorcall) /\ perrorcall.TARGET = eps /\ S.ERRORHANDLER.CALLBACK = eps /\ $error_handler_selected(S, perrorcall.CALLBACK, pcalltarget) /\ $handler_emitter_valid(S, pcalltarget))
def $api_callback_selected(S, API_ASSERT passertcall, pcalltarget) = ($assertion_failure_valid(S, passertcall.FAILURE) /\ passertcall.TARGET = eps /\ $exception_raw_selected(S, passertcall.CALLBACK, passertcall.RAW, pcalltarget) /\ $handler_emitter_valid(S, pcalltarget))
def $api_callback_roots(API_ERROR perrorcall) = $value_nodes(perrorcall.CALLBACK) ++ $task_nodes(perrorcall.RESUME)
def $api_callback_roots(API_ASSERT passertcall) = $config_nodes(passertcall.FAILURE.CALL) ++ $instance_roots(passertcall.FAILURE.PENDING)
def $api_callback_nonce(API_ERROR perrorcall) = $selected_task_nonce(perrorcall.RESUME)
def $api_callback_nonce(API_ASSERT passertcall) = passertcall.FAILURE.CALL.SELECTION
def $api_callback_discard(S, API_ERROR perrorcall) = $error_read_discard($error_handler_restore(S, perrorcall.CALLBACK), perrorcall.RESUME)
;; THROW_SEARCH has already removed the cursor, so its prepared cells lose
;; their only roots. Reuse assert's live flags and supplied-exception policy.
def $api_callback_discard(S, API_ASSERT passertcall) = $assertion_callback_error(S[.TODO = (CONFIG_INVOKE passertcall.FAILURE.CALL) :: ptask_tail*][.ORIGIN = (passertcall.FAILURE.CALL.SITE)][.COMPLETION = THROWING n], passertcall.FAILURE)
  -- if S.TODO = (THROW_SEARCH n) :: ptask_tail*
  -- if $throwable_live(S, n)
def $api_callback_discard(S, papicallback) = S -- otherwise
def $api_callback_result(API_ERROR perrorcall, pshutdownproducer) = ERROR_HANDLER_RESULT perrorcall[.TARGET = (API_BORROWED_TARGET pshutdownproducer)]
def $api_callback_result(API_ASSERT passertcall, pshutdownproducer) = ASSERT_CALLBACK_RESULT passertcall[.TARGET = (API_BORROWED_TARGET pshutdownproducer)]

;; Save only the selected Closure scope/binding metadata. The producer record
;; contributes no owner; its readonly history is used after the call releases.
def $api_callback_producer(S, pcalltarget, porigin) = {TARGET pcalltarget, SITE (porigin), SCOPE $consumer_producer_scope(S, pcalltarget), BINDING $consumer_producer_binding(S, pcalltarget), INTERNAL true, CLONE eps}

def $api_callback_begin(S, papicallback, pcalltarget, pfunction, pvalue*, porigin, z) = $api_callback_warn(S_pending, pfunction, papiargcursor)
  -- if S.TODO = ptask :: ptask_tail*
  -- if pshutdownproducer = $api_callback_producer(S, pcalltarget, porigin)
  -- if papiargcursor = {CALL papicallback, TARGET pcalltarget, PRODUCER pshutdownproducer, VALUES pvalue*, SENT eps, INDEX 0, SITE porigin, LINE z}
  -- if S_pending = S[.TODO = (API_CALLBACK_SEND papiargcursor) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
def $api_callback_warn(S, pfunction, papiargcursor) = S
  -- if $function_deprecated(S, pfunction) = NO_DEPRECATED
def $api_callback_warn(S, pfunction, papiargcursor) = $error_dispatch(S, 16384, ptbytes, papiargcursor.LINE, $api_cursor_deprecated_event(S, papiargcursor, ptbytes), API_CALLBACK_SEND papiargcursor)
  -- if $function_deprecated(S, pfunction) = DEPRECATED_ATTRIBUTE ptbytes_message ptbytes_since
  -- if ptbytes = $deprecated_warning_message(S, pfunction, ptbytes_message, ptbytes_since)
def $api_callback_warn(S, pfunction, papiargcursor) = S[.COMPLETION = UNSUPPORTED "Deprecated API callback attribute"] -- otherwise

def $api_nodes_present(S, eps) = true
def $api_nodes_present(S, pnode :: pnode_tail*) = ((pnode <- S.ALLOCATIONS) /\ $api_nodes_present(S, pnode_tail*))
def $api_cursor_site_valid(S, papiargcursor) = (papiargcursor.SITE = perrorcall.SITE /\ papiargcursor.LINE = $error_callback_line(S, perrorcall))
  -- if papiargcursor.CALL = API_ERROR perrorcall
def $api_cursor_site_valid(S, papiargcursor) = (papiargcursor.SITE = passertcall.FAILURE.CALL.SITE /\ papiargcursor.LINE = passertcall.FAILURE.CALL.LINE)
  -- if papiargcursor.CALL = API_ASSERT passertcall
def $api_cursor_producer_shape(papiargcursor) = (papiargcursor.PRODUCER.TARGET = papiargcursor.TARGET /\ papiargcursor.PRODUCER.SITE = (papiargcursor.SITE) /\ papiargcursor.PRODUCER.INTERNAL /\ papiargcursor.PRODUCER.CLONE = eps /\ $consumer_producer_snapshot(papiargcursor.PRODUCER))
def $api_cursor_producer_live(S, papiargcursor) = ($api_cursor_producer_shape(papiargcursor) /\ papiargcursor.PRODUCER.SCOPE = $consumer_producer_scope(S, papiargcursor.TARGET) /\ papiargcursor.PRODUCER.BINDING = $consumer_producer_binding(S, papiargcursor.TARGET))
def $api_cursor_sent_valid(S, pcalltarget, pvalue*, eps, n) = true
def $api_cursor_sent_valid(S, pcalltarget, pvalue :: pvalue_tail*, (KNOWN pvalue_sent) :: poperand_tail*, n) = (pvalue_sent = pvalue /\ ~$call_parameter_reference(S, pcalltarget, n) /\ $api_cursor_sent_valid(S, pcalltarget, pvalue_tail*, poperand_tail*, $(n + 1)))
def $api_cursor_sent_valid(S, pcalltarget, pvalue :: pvalue_tail*, (REFERENCE n_cell) :: poperand_tail*, n) = true
  -- if $(n_cell < |S.STORE|)
  -- if (HCELL n_cell) <- S.ALLOCATIONS /\ n_cell <- S.REFCELLS
  -- if S.STORE[n_cell] = DEFINED pvalue
  -- if $call_parameter_reference(S, pcalltarget, n)
  -- if $heap_owners($heap_prune($heap_graph(S)), HCELL n_cell) = 1
  -- if $api_cursor_sent_valid(S, pcalltarget, pvalue_tail*, poperand_tail*, $(n + 1))
def $api_cursor_sent_valid(S, pcalltarget, pvalue*, poperand*, n) = false -- otherwise
def $api_cursor_valid(S, papiargcursor) = ($api_callback_selected(S, papiargcursor.CALL, papiargcursor.TARGET) /\ $api_cursor_site_valid(S, papiargcursor) /\ $api_cursor_producer_live(S, papiargcursor) /\ papiargcursor.VALUES = $api_callback_values(S, papiargcursor.CALL) /\ |papiargcursor.SENT| = papiargcursor.INDEX /\ $(papiargcursor.INDEX <= |papiargcursor.VALUES|) /\ $api_cursor_sent_valid(S, papiargcursor.TARGET, papiargcursor.VALUES, papiargcursor.SENT, 0) /\ S.ORIGIN = (papiargcursor.SITE))
  -- if $api_nodes_present(S, $target_nodes(papiargcursor.TARGET))
def $api_cursor_valid(S, papiargcursor) = false -- otherwise
def $api_cursor_saved_valid(S, papiargcursor) = true
