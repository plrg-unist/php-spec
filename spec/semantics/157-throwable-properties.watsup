;; Internal declaration identities are not fabricated source occurrences.
;; Every live Throwable field has exactly one backing in OBJECTPROPS.
def $throwable_base("Exception") = "Exception"
def $throwable_base("ErrorException") = "Exception"
def $throwable_base("ClosedGeneratorException") = "Exception"
def $throwable_base(text) = "Error" -- otherwise

dec $throwable_key(text, text) : ptbytes
def $throwable_key(text_base, text_field) = [0] ++ $ptascii(text_base) ++ [0] ++ $ptascii(text_field)
  -- if text_field <- ["string", "trace", "previous"]
def $throwable_key(text_base, text_field) = [0, 42, 0] ++ $ptascii(text_field) -- otherwise

dec $throwable_descriptor(text, text, ppropertyvisibility, ptbranch*, ppropdefault) : ppropertydesc
def $throwable_descriptor(text_base, text_field, ppropertyvisibility, ptbranch*, ppropdefault) = {ORIGIN INTERNAL_PROPERTY text_base $ptascii(text_field), NAME $ptascii(text_field), KEY $throwable_key(text_base, text_field), VISIBILITY ppropertyvisibility, SETVISIBILITY eps, FINAL false, STATIC false, TYPE ptbranch*, DEFAULT ppropdefault, LINE 0}
dec $throwable_line_default(text) : ppropdefault
def $throwable_line_default("Error") = PROP_UNINITIALIZED
def $throwable_line_default("Exception") = PROP_LITERAL (PINT 0)
def $throwable_layout("ErrorException") = $throwable_layout("Exception") ++ [$throwable_descriptor("ErrorException", "severity", PROPERTY_PROTECTED, [(PTBRANCH ([PTBUILTIN "int"]))], PROP_LITERAL (PINT 1))]
def $throwable_layout(text) = [
  $throwable_descriptor(text_base, "message", PROPERTY_PROTECTED, eps, PROP_LITERAL (PSTRING eps)),
  $throwable_descriptor(text_base, "string", PROPERTY_PRIVATE, [(PTBRANCH ([PTBUILTIN "string"]))], PROP_LITERAL (PSTRING eps)),
  $throwable_descriptor(text_base, "code", PROPERTY_PROTECTED, eps, PROP_LITERAL (PINT 0)),
  $throwable_descriptor(text_base, "file", PROPERTY_PROTECTED, [(PTBRANCH ([PTBUILTIN "string"]))], PROP_LITERAL (PSTRING eps)),
  $throwable_descriptor(text_base, "line", PROPERTY_PROTECTED, [(PTBRANCH ([PTBUILTIN "int"]))], $throwable_line_default(text_base)),
  $throwable_descriptor(text_base, "trace", PROPERTY_PRIVATE, [(PTBRANCH ([PTBUILTIN "array"]))], PROP_UNINITIALIZED),
  $throwable_descriptor(text_base, "previous", PROPERTY_PRIVATE, [(PTBRANCH ([PTBUILTIN "null"])), (PTBRANCH ([PTCLASS $ptascii("Throwable")]))], PROP_NULL)
]
  -- if $throwable_kind(text)
  -- if text =/= "ErrorException"
  -- if text_base = $throwable_base(text)

def $property_declaring_name(pclassdesc*, INTERNAL_PROPERTY text ptbytes) = $ptascii(text)
  -- if text = "Exception" \/ text = "Error"
  -- if ptbytes <- [$ptascii("message"), $ptascii("string"), $ptascii("code"), $ptascii("file"), $ptascii("line"), $ptascii("trace"), $ptascii("previous")]
def $property_declaring_name(pclassdesc*, INTERNAL_PROPERTY "ErrorException" ptbytes) = $ptascii("ErrorException")
  -- if ptbytes = $ptascii("severity")

dec $throwable_slot(text, text, pvalue) : ppropertyslot
def $throwable_slot(text, text_field, pvalue) = {DECL (INTERNAL_PROPERTY $throwable_base(text) $ptascii(text_field)), NAME $throwable_key($throwable_base(text), text_field), STATE PROP_VALUE (DIRECT pvalue)}
dec $throwable_slots_values(text, preqbytes, preqbytes, int, preqbytes, int, nat, pvalue) : ppropertyslot*
def $throwable_slots_values(text, preqbytes_message, preqbytes_string, z_code, preqbytes_file, z_line, n_trace, pvalue_previous) = [
  $throwable_slot(text, "message", PSTRING preqbytes_message),
  $throwable_slot(text, "string", PSTRING preqbytes_string),
  $throwable_slot(text, "code", PINT z_code),
  $throwable_slot(text, "file", PSTRING preqbytes_file),
  $throwable_slot(text, "line", PINT z_line),
  $throwable_slot(text, "trace", PARRAY n_trace),
  $throwable_slot(text, "previous", pvalue_previous)
]
dec $throwable_severity_slot(int) : ppropertyslot
def $throwable_severity_slot(z) = {DECL (INTERNAL_PROPERTY "ErrorException" $ptascii("severity")), NAME $throwable_key("ErrorException", "severity"), STATE PROP_VALUE (DIRECT (PINT z))}
def $throwable_slots("ErrorException", preqbytes_message, preqbytes_file, z, n_trace, pvalue_previous) = $throwable_slots_values("ErrorException", preqbytes_message, eps, 0, preqbytes_file, z, n_trace, pvalue_previous) ++ [$throwable_severity_slot(1)]
def $throwable_slots(text, preqbytes_message, preqbytes_file, z, n_trace, pvalue_previous) = $throwable_slots_values(text, preqbytes_message, eps, 0, preqbytes_file, z, n_trace, pvalue_previous)
  -- if text =/= "ErrorException"

def $throwable_field(S, n, text_field) = pvalue
  -- if S.OBJECTS[n] = THROWABLE pthrowable
  -- if $objectprops_at(S.OBJECTPROPS, n) = (ppropertyslot_list*)
  -- if $property_slot_at(ppropertyslot_list*, $throwable_key($throwable_base(pthrowable.KIND), text_field)) = (ppropertyslot)
  -- if ppropertyslot.STATE = PROP_VALUE (DIRECT pvalue)
def $throwable_field(S, n, text_field) = pvalue
  -- if S.OBJECTS[n] = THROWABLE pthrowable
  -- if $objectprops_at(S.OBJECTPROPS, n) = (ppropertyslot_list*)
  -- if $property_slot_at(ppropertyslot_list*, $throwable_key($throwable_base(pthrowable.KIND), text_field)) = (ppropertyslot)
  -- if ppropertyslot.STATE = PROP_VALUE (ALIAS n_cell)
  -- if S.STORE[n_cell] = DEFINED pvalue
def $throwable_field(S, n, text_field) = pvalue
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $throwable_member(S, n)
  -- if $class_throwable_kind(S, porigin, |S.CLASSES|) = (text_kind)
  -- if $objectprops_at(S.OBJECTPROPS, n) = (ppropertyslot_list*)
  -- if $property_slot_at(ppropertyslot_list*, $throwable_key($throwable_base(text_kind), text_field)) = (ppropertyslot)
  -- if ppropertyslot.STATE = PROP_VALUE (DIRECT pvalue)
def $throwable_field(S, n, text_field) = pvalue
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $throwable_member(S, n)
  -- if $class_throwable_kind(S, porigin, |S.CLASSES|) = (text_kind)
  -- if $objectprops_at(S.OBJECTPROPS, n) = (ppropertyslot_list*)
  -- if $property_slot_at(ppropertyslot_list*, $throwable_key($throwable_base(text_kind), text_field)) = (ppropertyslot)
  -- if ppropertyslot.STATE = PROP_VALUE (ALIAS n_cell)
  -- if S.STORE[n_cell] = DEFINED pvalue

def $throwable_previous_id(S, n) = eps -- if $throwable_field(S, n, "previous") = PNULL
def $throwable_previous_id(S, n) = (n_previous) -- if $throwable_field(S, n, "previous") = POBJECT n_previous
dec $throwable_previous_value(nat?) : pvalue
def $throwable_previous_value(eps) = PNULL
def $throwable_previous_value((n)) = POBJECT n
dec $throwable_previous_slot_valid(pstate, pvalue) : bool
def $throwable_previous_slot_valid(S, PNULL) = true
def $throwable_previous_slot_valid(S, POBJECT n) = $throwable_member(S, n)
def $throwable_previous_slot_valid(S, pvalue) = false -- otherwise
def $throwable_set_previous_id(S, n, n_previous?) = S[.OBJECTPROPS = $objectprops_set(S.OBJECTPROPS, n, $property_slot_set(ppropertyslot_list*, $throwable_key($throwable_base(pthrowable.KIND), "previous"), PROP_VALUE (DIRECT $throwable_previous_value(n_previous?))))]
  -- if S.OBJECTS[n] = THROWABLE pthrowable
  -- if $objectprops_at(S.OBJECTPROPS, n) = (ppropertyslot_list*)
def $throwable_set_previous_id(S, n, n_previous?) = S[.OBJECTPROPS = $objectprops_set(S.OBJECTPROPS, n, $property_slot_set(ppropertyslot_list*, $throwable_key($throwable_base(text_kind), "previous"), PROP_VALUE (DIRECT $throwable_previous_value(n_previous?))))]
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $throwable_member(S, n)
  -- if $class_throwable_kind(S, porigin, |S.CLASSES|) = (text_kind)
  -- if $objectprops_at(S.OBJECTPROPS, n) = (ppropertyslot_list*)
dec $throwable_constructor_field(pstate, nat, text, pvalue) : pstate
def $throwable_constructor_field(S, n, text_field, pvalue) = S[.OBJECTPROPS = $objectprops_set(S.OBJECTPROPS, n, $property_slot_set(ppropertyslot_list*, $throwable_key($throwable_base(pthrowable.KIND), text_field), PROP_VALUE (DIRECT pvalue)))]
  -- if text_field <- ["message", "code", "previous"]
  -- if S.OBJECTS[n] = THROWABLE pthrowable
  -- if $objectprops_at(S.OBJECTPROPS, n) = (ppropertyslot_list*)
def $throwable_constructor_field(S, n, text_field, pvalue) = S[.OBJECTPROPS = $objectprops_set(S.OBJECTPROPS, n, $property_slot_set(ppropertyslot_list*, $throwable_key("ErrorException", text_field), PROP_VALUE (DIRECT pvalue)))]
  -- if text_field <- ["file", "line", "severity"]
  -- if S.OBJECTS[n] = THROWABLE pthrowable
  -- if pthrowable.KIND = "ErrorException"
  -- if $objectprops_at(S.OBJECTPROPS, n) = (ppropertyslot_list*)
def $throwable_constructor_field(S, n, text_field, pvalue) = S[.OBJECTPROPS = $objectprops_set(S.OBJECTPROPS, n, $property_slot_set(ppropertyslot_list*, $throwable_key($throwable_base(text_kind), text_field), PROP_VALUE (DIRECT pvalue)))]
  -- if text_field <- ["message", "code", "previous"]
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $throwable_member(S, n)
  -- if $class_throwable_kind(S, porigin, |S.CLASSES|) = (text_kind)
  -- if $objectprops_at(S.OBJECTPROPS, n) = (ppropertyslot_list*)
def $throwable_constructor_field(S, n, text_field, pvalue) = S[.OBJECTPROPS = $objectprops_set(S.OBJECTPROPS, n, $property_slot_set(ppropertyslot_list*, $throwable_key("ErrorException", text_field), PROP_VALUE (DIRECT pvalue)))]
  -- if text_field <- ["file", "line", "severity"]
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $throwable_member(S, n)
  -- if $class_throwable_kind(S, porigin, |S.CLASSES|) = ("ErrorException")
  -- if $objectprops_at(S.OBJECTPROPS, n) = (ppropertyslot_list*)
dec $throwable_string_cache(pstate, nat, preqbytes) : pstate
def $throwable_string_cache(S, n, preqbytes) = S[.OBJECTPROPS = $objectprops_set(S.OBJECTPROPS, n, $property_slot_set(ppropertyslot_list*, $throwable_key($throwable_base(pthrowable.KIND), "string"), PROP_VALUE (DIRECT (PSTRING preqbytes))))]
  -- if S.OBJECTS[n] = THROWABLE pthrowable
  -- if $objectprops_at(S.OBJECTPROPS, n) = (ppropertyslot_list*)
def $throwable_string_cache(S, n, preqbytes) = S[.OBJECTPROPS = $objectprops_set(S.OBJECTPROPS, n, $property_slot_set(ppropertyslot_list*, $throwable_key($throwable_base(text_kind), "string"), PROP_VALUE (DIRECT (PSTRING preqbytes))))]
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $throwable_member(S, n)
  -- if $class_throwable_kind(S, porigin, |S.CLASSES|) = (text_kind)
  -- if $objectprops_at(S.OBJECTPROPS, n) = (ppropertyslot_list*)

;; Constructors may change message/code/previous; string cache changes only
;; through __toString. Trace remains the allocation-time array graph.
dec $trace_graph_valid(pstate, nat) : bool
def $throwable_slots_valid(S, n, pthrowable) = true
  -- if pthrowable.KIND = "ErrorException"
  -- if $objectprops_record_at(S.OBJECTPROPS, n) = (pobjectprops)
  -- if ~pobjectprops.MATERIALIZED
  -- if $throwable_field(S, n, "message") = PSTRING preqbytes_message
  -- if $throwable_field(S, n, "string") = PSTRING preqbytes_string
  -- if $throwable_field(S, n, "code") = PINT z_code
  -- if $throwable_field(S, n, "file") = PSTRING preqbytes_file
  -- if $throwable_field(S, n, "line") = PINT z
  -- if $throwable_field(S, n, "trace") = PARRAY n_trace
  -- if $(n_trace < |S.ARRAYS|)
  -- if (HARRAY n_trace) <- S.ALLOCATIONS
  -- if $trace_graph_valid(S, n_trace)
  -- if pvalue_previous = $throwable_field(S, n, "previous")
  -- if $throwable_previous_slot_valid(S, pvalue_previous)
  -- if $throwable_field(S, n, "severity") = PINT z_severity
  -- if pobjectprops.SLOTS = $throwable_slots_values("ErrorException", preqbytes_message, preqbytes_string, z_code, preqbytes_file, z, n_trace, pvalue_previous) ++ [$throwable_severity_slot(z_severity)]
  -- if $property_slots_valid(S, $throwable_layout("ErrorException"), pobjectprops.SLOTS)
def $throwable_slots_valid(S, n, pthrowable) = true
  -- if $objectprops_record_at(S.OBJECTPROPS, n) = (pobjectprops)
  -- if ~pobjectprops.MATERIALIZED
  -- if $throwable_field(S, n, "message") = PSTRING preqbytes_message
  -- if $throwable_field(S, n, "string") = PSTRING preqbytes_string
  -- if $throwable_field(S, n, "code") = PINT z_code
  -- if $throwable_field(S, n, "file") = PSTRING preqbytes_file
  -- if $throwable_field(S, n, "line") = PINT z
  -- if $(z > 0)
  -- if $throwable_field(S, n, "trace") = PARRAY n_trace
  -- if $(n_trace < |S.ARRAYS|)
  -- if (HARRAY n_trace) <- S.ALLOCATIONS
  -- if $trace_graph_valid(S, n_trace)
  -- if pvalue_previous = $throwable_field(S, n, "previous")
  -- if $throwable_previous_slot_valid(S, pvalue_previous)
  -- if pobjectprops.SLOTS = $throwable_slots_values(pthrowable.KIND, preqbytes_message, preqbytes_string, z_code, preqbytes_file, z, n_trace, pvalue_previous)
  -- if $property_slots_valid(S, $throwable_layout(pthrowable.KIND), pobjectprops.SLOTS)
  -- if pthrowable.KIND =/= "ErrorException"
def $throwable_slots_valid(S, n, pthrowable) = false -- otherwise

def $objectprops_valid(S, pobjectprops :: pobjectprops_tail*) = ($throwable_slots_valid(S, pobjectprops.OBJECT, pthrowable) /\ $objectprops_valid(S, pobjectprops_tail*))
  -- if $(pobjectprops.OBJECT < |S.OBJECTS|)
  -- if $objectprops_at(pobjectprops_tail*, pobjectprops.OBJECT) = eps
  -- if S.OBJECTS[pobjectprops.OBJECT] = THROWABLE pthrowable
