  -- if pdestructionoperation.CALLER = S.CURRENT /\ pdestructionoperation.ORIGIN = S.ORIGIN
  -- if $eager_operation_source_guard(S, pdestructionoperation) /\ $throwable_live(S, n)
def $ob_api_done_replay_pending(S, ptask :: ptask_rest*, pobrelease, pcallcontext?, ptask_tail*) = $ob_api_done_replay_pending(S, ptask_rest*, pobrelease, pcallcontext?, ptask_tail*)
  -- if ~$ob_user_failure_exit_task(ptask)
def $ob_api_done_replay_pending(S, ptask*, pobrelease, pcallcontext?, ptask_tail*) = eps -- otherwise

;; The internal API frame outlives callback entry and its argv/ZOH cleanup.
;; A real operation certifies the saved caller; snapshots add no trace owners.
def $ob_api_failure_source_call(OB_USER_FAIL_ARGS pobinvoke n) = $ob_call_api(pobinvoke.CALL)
def $ob_api_failure_source_call(OB_API_FAIL_RELEASE pobrelease pcallcontext? ptask* n) = (pobrelease.CALL)
def $ob_api_failure_source_call(ptask) = eps -- otherwise
def $destructor_internal_site_source(OB_API_FAIL_RELEASE pobrelease pcallcontext? ptask* n) = true
def $destructor_internal_site_source(OB_USER_FAIL_ARGS pobinvoke n) = ($ob_call_api(pobinvoke.CALL) =/= eps)
def $destructor_trace_suffix(S, pcallcontext) = $config_trace_frames(S_history, pconfigcall, eps)
