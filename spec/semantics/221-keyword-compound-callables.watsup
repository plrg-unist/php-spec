;; The suspended USER receiver owns the formal cell. Rebuild its actual table
;; and older frame tail when a deprecation callback is the active frame.
dec $api_pending_task(ptask) : bool
def $api_pending_task(API_CALLABLE_RESULT papiquery n) = true
def $api_pending_task(ERROR_HANDLER_INVOKE perrorcall) = $api_pending_task(perrorcall.RESUME)
def $api_pending_task(ERROR_HANDLER_RESULT perrorcall) = $api_pending_task(perrorcall.RESUME)
def $api_pending_task(AT porigin ptask) = $api_pending_task(ptask)
def $api_pending_task(ptask) = false -- otherwise
dec $api_pending_tasks(ptask*) : bool
def $api_pending_tasks(eps) = false
def $api_pending_tasks(ptask :: ptask_tail*) = ($api_pending_task(ptask) \/ $api_pending_tasks(ptask_tail*))
def $api_saved_frame_scope(S, pframe, pframe_tail*) = $set_active_table(S[.CURRENT = pframe.CONTEXT][.ORIGIN = pframe.ORIGIN][.TODO = pframe.TODO][.FRAMES = pframe_tail*][.BORROWEDREAD = pframe.BORROWEDREAD][.OBJECTCAST = pframe.OBJECTCAST], psymboltable)
  -- if $api_pending_tasks(pframe.TODO)
  -- if pframe.LOCALS = (psymboltable)
