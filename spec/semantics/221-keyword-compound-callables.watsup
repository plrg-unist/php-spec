dec $api_frame_scope(pstate) : porigin?
dec $consumer_exception_source(ptask) : bool
dec $api_keyword(ptbytes) : bool
dec $api_frame_called(pstate) : porigin?
dec $api_frame_this(pstate) : nat?
dec $api_subclass(pstate, porigin, porigin) : bool
dec $api_this(nat?, nat?) : nat?
dec $api_called(pstate, porigin, porigin?, nat?) : porigin
dec $api_named_this(pstate, porigin, porigin?, nat?, nat?) : nat?
dec $api_class(pstate, pvalue, porigin?, porigin?, porigin?, nat?, nat?) : papiclassresult
dec $api_source_line(pstate, ptask) : int
dec $api_string_item(pstate, ptask, ptbytes) : pitem
dec $api_query(pstate, ptask, pvalue, pvalue, pitem, papiclass, ptbytes, nat, nat) : papiquery
dec $api_keyword_message(pvalue) : ptbytes
dec $api_compound_message(pstate, papiquery) : ptbytes
dec $api_continue(pstate, papiquery, nat, ptbytes?) : pstate
dec $api_warning_event(pstate, papiquery, ptbytes) : pevent
dec $api_class_warning(pvalue) : ptbytes?
dec $api_begin(pstate, ptask, pvalue) : pstate
dec $api_initial_class(pstate, pvalue) : papiclassresult
dec $api_after_class(pstate, papiquery) : pstate
dec $api_after_method(pstate, papiquery) : pstate
dec $api_object_class(pstate, papiquery) : porigin?
dec $api_outer_class(papiquery) : porigin
dec $api_object_method(pstate, papiquery, ptbytes) : pmethoddesc?
dec $api_selected_method(pstate, papiquery, ptbytes) : pmethoddesc?
dec $api_method_magic(pstate, papiquery) : bool
dec $api_getter_scope(papiquery) : porigin?
dec $api_getter_denied(pstate, papiquery, pmethoddesc, ptbytes) : ptbytes
dec $api_getter_error(pstate, papiquery, ptbytes) : ptbytes?
dec $api_method_finish(pstate, papiquery, ptbytes) : pstate
dec $api_throw(pstate, papiquery, ptbytes, ptbytes) : pstate
dec $api_method_result(pstate, papiquery, ptbytes) : phandlerresolution
dec $api_finish(pstate, ptask, pvalue, phandlerresolution) : pstate
dec $api_register(pstate, pconfigcall, pvalue) : pstate
dec $api_receive_reject(pstate, porigin, nat) : pstate
dec $api_fallback_reject(pstate, ptask) : pstate
dec $api_slow_conversion(pstate, ptbranch*, pvalue, bool) : ptypeconversion
dec $api_pure_array_method(pstate, papiquery, ptbytes) : phandlerresolution
dec $api_item_snapshot(pitem, pvalue) : bool
dec $api_raw_shape(pstate, papiquery) : bool
dec $api_borrowed_array(pstate, papiquery) : bool
dec $api_query_shape(pstate, papiquery, nat) : bool
dec $api_source_valid(pstate, papiquery) : bool
dec $api_query_valid(pstate, papiquery, nat) : bool
dec $api_warning_message(pstate, papiquery, nat) : ptbytes?
dec $api_target_valid(pstate, papiquery, porigin, ptbytes) : bool
dec $api_leaf_snapshot(papiquery, ptbytes) : bool
dec $api_carrier_valid(pstate, papiquery, porigin, ptbytes, bool) : bool
dec $api_scalar_conversion(pstate, psparam, pvalue) : ptypeconversion

;; Zend API resolution differs from INIT_DYNAMIC_CALL: raw lexical keywords and
;; qualified array methods are deprecated, effectful admission operations.
def $api_keyword(ptbytes) = ($ptlc(ptbytes) <- [$ptascii("self"), $ptascii("parent"), $ptascii("static")])
def $api_frame_called(S) = pcallcontext.CALLED_CLASS -- if S.CURRENT = (pcallcontext)
def $api_frame_called(S) = eps -- if S.CURRENT = eps
def $api_frame_this(S) = pcallcontext.RECEIVER -- if S.CURRENT = (pcallcontext)
def $api_frame_this(S) = eps -- if S.CURRENT = eps

def $api_subclass(S, porigin_child, porigin_parent) = $class_origin_matches(S, porigin_child, pclassdesc.NAME, |S.CLASSES|)
  -- if $class_at(S.CLASSES, porigin_parent) = (pclassdesc)
def $api_this((n), n_frame?) = (n)
def $api_this(eps, n_frame?) = n_frame?
def $api_called(S, porigin_requested, porigin_frame?, (n)) = porigin_object
  -- if S.OBJECTS[n] = INSTANCE porigin_object
def $api_called(S, porigin_requested, (porigin_frame), eps) = porigin_frame
  -- if $api_subclass(S, porigin_frame, porigin_requested)
def $api_called(S, porigin_requested, porigin_frame?, n_receiver?) = porigin_requested -- otherwise

def $api_named_this(S, porigin_requested, porigin_scope?, n_frame?, (n)) = (n)
def $api_named_this(S, porigin_requested, (porigin_scope), (n), eps) = (n)
  -- if S.OBJECTS[n] = INSTANCE porigin_object
  -- if $api_subclass(S, porigin_object, porigin_scope)
  -- if $api_subclass(S, porigin_scope, porigin_requested)
def $api_named_this(S, porigin_requested, porigin_scope?, n_frame?, n_held?) = eps -- otherwise

;; The inner class of an array method uses its outer class as keyword scope;
;; concrete names still use the real USER frame for implicit-this eligibility.
def $api_class(S, POBJECT n, porigin_scope?, porigin_frame?, porigin_called?, n_this?, n_held?) = API_CLASS {REQUESTED porigin, CALLED porigin, RECEIVER (n), STRICT false}
  -- if $(n < |S.OBJECTS|)
  -- if (HOBJECT n) <- S.ALLOCATIONS
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
def $api_class(S, PSTRING ptbytes, eps, porigin_frame?, porigin_called?, n_this?, n_held?) = API_CLASS_INVALID ($ptascii("cannot access \"") ++ $ptlc(ptbytes) ++ $ptascii("\" when no class scope is active"))
  -- if $ptlc(ptbytes) <- [$ptascii("self"), $ptascii("parent")]
def $api_class(S, PSTRING ptbytes, (porigin_scope), porigin_frame?, porigin_called?, n_this?, n_held?) = API_CLASS {REQUESTED porigin_scope, CALLED $api_called(S, porigin_scope, porigin_called?, n_receiver?), RECEIVER n_receiver?, STRICT false}
  -- if $ptlc(ptbytes) = $ptascii("self")
  -- if n_receiver? = $api_this(n_held?, n_this?)
def $api_class(S, PSTRING ptbytes, (porigin_scope), porigin_frame?, porigin_called?, n_this?, n_held?) = API_CLASS {REQUESTED porigin_parent, CALLED $api_called(S, porigin_parent, porigin_called?, n_receiver?), RECEIVER n_receiver?, STRICT true}
  -- if $ptlc(ptbytes) = $ptascii("parent")
  -- if $class_link_at(S.LINKEDPARENTS, porigin_scope) = (SOURCE_PARENT porigin_parent)
  -- if n_receiver? = $api_this(n_held?, n_this?)
def $api_class(S, PSTRING ptbytes, (porigin_scope), porigin_frame?, porigin_called?, n_this?, n_held?) = API_CLASS_INVALID ($ptascii("cannot access \"parent\" when current class scope has no parent"))
  -- if $ptlc(ptbytes) = $ptascii("parent")
  -- if $class_link_at(S.LINKEDPARENTS, porigin_scope) = eps
def $api_class(S, PSTRING ptbytes, porigin_scope?, porigin_frame?, eps, n_this?, n_held?) = API_CLASS_INVALID ($ptascii("cannot access \"static\" when no class scope is active"))
  -- if $ptlc(ptbytes) = $ptascii("static")
def $api_class(S, PSTRING ptbytes, porigin_scope?, porigin_frame?, (porigin_called), n_this?, n_held?) = API_CLASS {REQUESTED porigin_called, CALLED $api_called(S, porigin_called, (porigin_called), n_receiver?), RECEIVER n_receiver?, STRICT true}
  -- if $ptlc(ptbytes) = $ptascii("static")
  -- if n_receiver? = $api_this(n_held?, n_this?)
def $api_class(S, PSTRING ptbytes, porigin_scope?, porigin_frame?, porigin_called?, n_this?, n_held?) = API_CLASS {REQUESTED porigin_requested, CALLED $api_called(S, porigin_requested, eps, n_receiver?), RECEIVER n_receiver?, STRICT true}
  -- if ~$api_keyword(ptbytes)
  -- if $class_named(S.CLASSNAMES, $ptlc($typed_callable_name(ptbytes))) = (porigin_requested)
  -- if n_receiver? = $api_named_this(S, porigin_requested, porigin_frame?, n_this?, n_held?)
def $api_class(S, PSTRING ptbytes, porigin_scope?, porigin_frame?, porigin_called?, n_this?, n_held?) = API_CLASS_INVALID ($ptascii("class \"") ++ $c_string(ptbytes) ++ $ptascii("\" not found"))
  -- if ~$api_keyword(ptbytes)
  -- if $api_keyword($typed_callable_name(ptbytes)) \/ (0 <- ptbytes)
def $api_class(S, pvalue, porigin_scope?, porigin_frame?, porigin_called?, n_this?, n_held?) = API_CLASS_UNKNOWN "callable class, autoload or internal lookup" -- otherwise

def $api_special(S, PARRAY n) = true
  -- if $typed_callback_array(S, n)
  -- if $entry_lookup(S.ARRAYS[n].ITEMS, KINT 0) = (pitem_receiver)
  -- if $entry_lookup(S.ARRAYS[n].ITEMS, KINT 1) = (pitem_method)
  -- if $entry_value(S, pitem_receiver) = PSTRING ptbytes_class
  -- if $api_keyword($typed_callable_name(ptbytes_class))
  -- if $entry_value(S, pitem_method) = PSTRING ptbytes_method
  -- if $method_string_parts(ptbytes_method) = eps
def $api_special(S, PARRAY n) = true
  -- if $typed_callback_array(S, n)
  -- if $entry_lookup(S.ARRAYS[n].ITEMS, KINT 1) = (pitem_method)
  -- if $entry_value(S, pitem_method) = PSTRING ptbytes_method
  -- if $method_string_parts(ptbytes_method) =/= eps
def $api_special(S, PSTRING ptbytes) = true
  -- if ~$typed_registered(S, ptbytes)
  -- if $method_string_parts(ptbytes) = ((ptbytes_class, ptbytes_method))
  -- if $api_keyword($typed_callable_name(ptbytes_class))
def $api_special(S, pvalue) = false -- otherwise

def $api_receive_candidate(S) = true
  -- if S.TODO = [TYPE_RECEIVE porigin n]
  -- if S.CURRENT = (pcallcontext)
  -- if $fixed_parameter_supplied(S, n)
  -- if $function_at($all_functions(S), porigin) = (pfunction)
  -- if $(n < |$call_fixed_parameters(pfunction.SIGNATURE.PARAMETERS)|)
  -- if psparam = pfunction.SIGNATURE.PARAMETERS[n]
  -- if $lookup(S.ENV, psparam.NAME) = (n_cell)
  -- if S.STORE[n_cell] = DEFINED pvalue
  -- if "callable" <- $ptmasks(psparam.TYPE)
  -- if ~$typed_exact(psparam.TYPE, pvalue)
  -- if ~$typed_object_exact(S, psparam.TYPE, pvalue)
  -- if $api_special(S, pvalue)
def $api_receive_candidate(S) = false -- otherwise
def $api_registration_candidate(S, pconfigcall) = ($error_api_arity(S, pconfigcall).COMPLETION = NORMAL /\ $api_special(S, $error_api_value(pconfigcall, 0, PNULL)))
  -- if pconfigcall.KIND = INTRINSIC_SET_ERROR_HANDLER
def $api_registration_candidate(S, pconfigcall) = false -- otherwise

def $api_source_line(S, TYPE_RECEIVE porigin n) = $default_parameter_line(S, porigin, n)
def $api_source_line(S, CONFIG_INVOKE pconfigcall) = pconfigcall.LINE
def $api_source_line(S, ERROR_HANDLER_INVOKE perrorcall) = perrorcall.LINE
def $api_string_item(S, TYPE_RECEIVE porigin n, ptbytes) = ALIAS n_cell
  -- if $function_at($all_functions(S), porigin) = (pfunction)
  -- if pfunction.SIGNATURE.PARAMETERS[n].BYREF
  -- if $lookup(S.ENV, pfunction.SIGNATURE.PARAMETERS[n].NAME) = (n_cell)
def $api_string_item(S, ptask, ptbytes) = DIRECT (PSTRING ptbytes) -- otherwise
def $api_query(S, ptask, pvalue, pvalue_input, pitem, papiclass, ptbytes, n_prefix, n_width) = {SOURCE ptask, VALUE pvalue, INPUT pvalue_input, METHOD pitem, SCOPE $api_frame_scope(S), CALLED $api_frame_called(S), THIS $api_frame_this(S), CLASS papiclass, OUTER eps, ORIGINAL ptbytes, PREFIX n_prefix, WIDTH n_width, LINE $api_source_line(S, ptask)}
def $api_keyword_message(PSTRING ptbytes) = $ptascii("Use of \"") ++ $ptlc(ptbytes) ++ $ptascii("\" in callables is deprecated")
def $api_compound_message(S, papiquery) = $ptascii("Callables of the form [\"") ++ pclassdesc.NAME ++ $ptascii("\", \"") ++ $c_string(papiquery.ORIGINAL) ++ $ptascii("\"] are deprecated")
  -- if papiquery.OUTER = (papiclass)
  -- if $class_at(S.CLASSES, papiclass.REQUESTED) = (pclassdesc)
def $api_continue(S, papiquery, n, eps) = S[.TODO = (API_CALLABLE_RESULT papiquery n) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if ~$consumer_exception_source(papiquery.SOURCE)
  -- if S.TODO = ptask :: ptask_tail*
def $api_continue(S, papiquery, n, (ptbytes)) = $error_dispatch(S_pending, 8192, ptbytes, papiquery.LINE, $api_warning_event(S_pending, papiquery, ptbytes), API_CALLABLE_RESULT papiquery n)
  -- if S_pending = $api_continue(S, papiquery, n, eps)
def $api_warning_event(S, papiquery, ptbytes) = DIAGNOSTIC "Deprecated" ptbytes papiquery.LINE -- otherwise
def $api_class_warning(PSTRING ptbytes) = ($api_keyword_message(PSTRING ptbytes)) -- if $api_keyword(ptbytes)
def $api_class_warning(pvalue) = eps -- otherwise

def $api_begin(S, ptask, PARRAY n) = $api_continue(S, papiquery, 0, $api_class_warning(pvalue_input))
  -- if $entry_lookup(S.ARRAYS[n].ITEMS, KINT 0) = (pitem_receiver)
  -- if $entry_lookup(S.ARRAYS[n].ITEMS, KINT 1) = (pitem_method)
  -- if pvalue_input = $entry_value(S, pitem_receiver)
  -- if $entry_value(S, pitem_method) = PSTRING ptbytes_method
  -- if $api_class(S, pvalue_input, $api_frame_scope(S), $api_frame_scope(S), $api_frame_called(S), $api_frame_this(S), eps) = API_CLASS papiclass
  -- if papiquery = $api_query(S, ptask, PARRAY n, pvalue_input, pitem_method, papiclass, ptbytes_method, 0, 0)
def $api_begin(S, ptask, PSTRING ptbytes) = $api_continue(S, papiquery, 1, $api_class_warning(PSTRING ptbytes_class))
  -- if $method_string_parts(ptbytes) = ((ptbytes_class, ptbytes_method))
  -- if $api_class(S, PSTRING ptbytes_class, $api_frame_scope(S), $api_frame_scope(S), $api_frame_called(S), $api_frame_this(S), eps) = API_CLASS papiclass
  -- if papiquery = $api_query(S, ptask, PSTRING ptbytes, PSTRING ptbytes_class, $api_string_item(S, ptask, ptbytes), papiclass, ptbytes, $(|ptbytes_class| + 2), |ptbytes_method|)
def $api_begin(S, ptask, pvalue) = $api_finish(S, ptask, pvalue, HANDLERINVALID ptbytes)
  -- if $api_initial_class(S, pvalue) = API_CLASS_INVALID ptbytes
def $api_begin(S, ptask, pvalue) = $api_finish(S, ptask, pvalue, HANDLERUNKNOWN text)
  -- if $api_initial_class(S, pvalue) = API_CLASS_UNKNOWN text

def $api_initial_class(S, PARRAY n) = $api_class(S, $entry_value(S, pitem), $api_frame_scope(S), $api_frame_scope(S), $api_frame_called(S), $api_frame_this(S), eps)
  -- if $entry_lookup(S.ARRAYS[n].ITEMS, KINT 0) = (pitem)
def $api_initial_class(S, PSTRING ptbytes) = $api_class(S, PSTRING ptbytes_class, $api_frame_scope(S), $api_frame_scope(S), $api_frame_called(S), $api_frame_this(S), eps)
  -- if $method_string_parts(ptbytes) = ((ptbytes_class, ptbytes_method))

def $api_after_class(S, papiquery) = $api_method_finish(S, papiquery, ptbytes)
  -- if $entry_value(S, papiquery.METHOD) = PSTRING ptbytes
  -- if $method_string_parts(ptbytes) = eps
def $api_after_class(S, papiquery) = $api_continue(S, papiquery_inner, 1, ($api_compound_message(S, papiquery_inner)))
  -- if $entry_value(S, papiquery.METHOD) = PSTRING ptbytes
  -- if $method_string_parts(ptbytes) = ((ptbytes_class, ptbytes_method))
  -- if ptbytes_class =/= eps
  -- if $api_class(S, PSTRING ptbytes_class, (papiquery.CLASS.REQUESTED), papiquery.SCOPE, papiquery.CALLED, papiquery.THIS, papiquery.CLASS.RECEIVER) = API_CLASS papiclass
  -- if $api_subclass(S, papiquery.CLASS.REQUESTED, papiclass.REQUESTED)
  -- if papiquery_inner = papiquery[.CLASS = papiclass][.OUTER = (papiquery.CLASS)][.ORIGINAL = ptbytes][.PREFIX = $(|ptbytes_class| + 2)][.WIDTH = |ptbytes_method|]
def $api_after_class(S, papiquery) = $api_finish(S, papiquery.SOURCE, papiquery.VALUE, HANDLERINVALID ($ptascii("invalid function name")))
  -- if $entry_value(S, papiquery.METHOD) = PSTRING ptbytes
  -- if $method_string_parts(ptbytes) = ((eps, ptbytes_method))
def $api_after_class(S, papiquery) = $api_finish(S, papiquery.SOURCE, papiquery.VALUE, HANDLERINVALID ptbytes_error)
  -- if $entry_value(S, papiquery.METHOD) = PSTRING ptbytes
  -- if $method_string_parts(ptbytes) = ((ptbytes_class, ptbytes_method))
  -- if ptbytes_class =/= eps
  -- if $api_class(S, PSTRING ptbytes_class, (papiquery.CLASS.REQUESTED), papiquery.SCOPE, papiquery.CALLED, papiquery.THIS, papiquery.CLASS.RECEIVER) = API_CLASS_INVALID ptbytes_error
def $api_after_class(S, papiquery) = $api_finish(S, papiquery.SOURCE, papiquery.VALUE, HANDLERINVALID ($ptascii("class ") ++ pclassdesc_outer.NAME ++ $ptascii(" is not a subclass of ") ++ pclassdesc_inner.NAME))
  -- if $entry_value(S, papiquery.METHOD) = PSTRING ptbytes
  -- if $method_string_parts(ptbytes) = ((ptbytes_class, ptbytes_method))
  -- if ptbytes_class =/= eps
  -- if $api_class(S, PSTRING ptbytes_class, (papiquery.CLASS.REQUESTED), papiquery.SCOPE, papiquery.CALLED, papiquery.THIS, papiquery.CLASS.RECEIVER) = API_CLASS papiclass
  -- if ~$api_subclass(S, papiquery.CLASS.REQUESTED, papiclass.REQUESTED)
  -- if $class_at(S.CLASSES, papiquery.CLASS.REQUESTED) = (pclassdesc_outer)
  -- if $class_at(S.CLASSES, papiclass.REQUESTED) = (pclassdesc_inner)
def $api_after_class(S, papiquery) = $api_finish(S, papiquery.SOURCE, papiquery.VALUE, HANDLERUNKNOWN "callable method mutation or autoload") -- otherwise

def $api_after_method(S, papiquery) = $api_method_finish(S, papiquery, ptbytes[papiquery.PREFIX:papiquery.WIDTH])
  -- if $entry_value(S, papiquery.METHOD) = PSTRING ptbytes
  -- if $(papiquery.PREFIX + papiquery.WIDTH <= |ptbytes|)
def $api_after_method(S, papiquery) = $api_finish(S, papiquery.SOURCE, papiquery.VALUE, HANDLERUNKNOWN "callable method mutation outside retained string bounds") -- otherwise

;; A missing requested-table entry may consult the actual object's get_method,
;; only for an array whose calling scope is still its original outer class.
;; That getter checks access before strict-class rejection and API admission.
def $api_outer_class(papiquery) = papiclass.REQUESTED -- if papiquery.OUTER = (papiclass)
def $api_outer_class(papiquery) = papiquery.CLASS.REQUESTED -- if papiquery.OUTER = eps
def $api_object_class(S, papiquery) = (porigin_object)
  -- if $is_array_value(papiquery.VALUE)
  -- if $api_outer_class(papiquery) = papiquery.CLASS.REQUESTED
  -- if papiquery.CLASS.RECEIVER = (n)
  -- if $(n < |S.OBJECTS|) /\ (HOBJECT n) <- S.ALLOCATIONS
  -- if S.OBJECTS[n] = INSTANCE porigin_object
  -- if ~papiquery.CLASS.STRICT \/ $effective_method(S, papiquery.CLASS.REQUESTED, $ptascii("__call"), |S.CLASSES|) = eps
def $api_object_class(S, papiquery) = eps -- otherwise
def $api_object_method(S, papiquery, ptbytes) = $scope_method(S, porigin_object, ptbytes, true, $api_getter_scope(papiquery))
  -- if $scope_method(S, papiquery.CLASS.REQUESTED, ptbytes, ~papiquery.CLASS.STRICT, papiquery.SCOPE) = eps
  -- if $api_object_class(S, papiquery) = (porigin_object)
def $api_object_method(S, papiquery, ptbytes) = eps -- otherwise
def $api_selected_method(S, papiquery, ptbytes) = (pmethoddesc)
  -- if $scope_method(S, papiquery.CLASS.REQUESTED, ptbytes, ~papiquery.CLASS.STRICT, papiquery.SCOPE) = (pmethoddesc)
def $api_selected_method(S, papiquery, ptbytes) = (pmethoddesc)
  -- if $api_object_method(S, papiquery, ptbytes) = (pmethoddesc)
  -- if ~papiquery.CLASS.STRICT \/ $api_subclass(S, papiquery.CLASS.REQUESTED, pmethoddesc.OWNER)
def $api_selected_method(S, papiquery, ptbytes) = eps -- otherwise
def $api_method_magic(S, papiquery) = true
  -- if $api_object_class(S, papiquery) = (porigin_object)
  -- if $array_magic(S, porigin_object)
def $api_method_magic(S, papiquery) = $array_magic(S, papiquery.CLASS.REQUESTED) -- otherwise
def $api_getter_scope(papiquery) = papiquery.SCOPE -- otherwise
def $api_getter_denied(S, papiquery, pmethoddesc, ptbytes) = $scope_denied_message(S, pmethoddesc, ptbytes, $api_getter_scope(papiquery)) -- otherwise
def $api_getter_error(S, papiquery, ptbytes) = ($api_getter_denied(S, papiquery, pmethoddesc, ptbytes))
  -- if $api_object_method(S, papiquery, ptbytes) = (pmethoddesc)
  -- if ~$method_accessible(S, pmethoddesc, $api_getter_scope(papiquery))
  -- if $api_object_class(S, papiquery) = (porigin_object)
  -- if $effective_method(S, porigin_object, $ptascii("__call"), |S.CLASSES|) = eps
def $api_getter_error(S, papiquery, ptbytes) = ($scope_abstract_message(S, pmethoddesc))
  -- if $api_object_method(S, papiquery, ptbytes) = (pmethoddesc)
  -- if $method_accessible(S, pmethoddesc, $api_getter_scope(papiquery))
  -- if pmethoddesc.ABSTRACT
def $api_getter_error(S, papiquery, ptbytes) = eps -- otherwise
def $api_method_finish(S, papiquery, ptbytes) = $api_throw(S, papiquery, ptbytes, ptbytes_error)
  -- if $api_getter_error(S, papiquery, ptbytes) = (ptbytes_error)
def $api_method_finish(S, papiquery, ptbytes) = $api_finish(S, papiquery.SOURCE, papiquery.VALUE, $api_method_result(S, papiquery, ptbytes))
  -- if $api_getter_error(S, papiquery, ptbytes) = eps
def $api_throw(S, papiquery, ptbytes_method, ptbytes) = $throw_scalar(S, "Error", ptbytes, $default_parameter_line(S, porigin, n))
  -- if papiquery.SOURCE = TYPE_RECEIVE porigin n
def $api_throw(S, papiquery, ptbytes_method, ptbytes) = $config_error(S, pconfigcall, "Error", ptbytes)
  -- if papiquery.SOURCE = CONFIG_INVOKE pconfigcall
  -- if pconfigcall.KIND = INTRINSIC_SET_ERROR_HANDLER
;; zend_call_function replaces the getter failure with Invalid callback and
;; retains the first Error as previous; admission APIs retain the getter Error.
def $api_throw(S, papiquery, ptbytes_method, ptbytes) = $error_handler_restore($throwable_previous(S_new, n_new, n_old), perrorcall.CALLBACK)
  -- if papiquery.SOURCE = ERROR_HANDLER_INVOKE perrorcall
  -- if $class_at(S.CLASSES, papiquery.CLASS.REQUESTED) = (pclassdesc)
  -- if S_old = $throwable_materialize($error_invalid_callback(S, perrorcall, ptbytes))
  -- if S_old.COMPLETION = THROWING n_old
  -- if ptbytes_outer = $ptascii("Invalid callback ") ++ $error_callback_name(S, perrorcall.CALLBACK) ++ $ptascii(", class ") ++ pclassdesc.NAME ++ $ptascii(" does not have a method \"") ++ $c_string(ptbytes_method) ++ [34]
  -- if S_new = $throwable_materialize($error_invalid_callback(S_old[.COMPLETION = NORMAL], perrorcall, ptbytes_outer))
  -- if S_new.COMPLETION = THROWING n_new

;; Requested-table API checks abstract/nonstatic before access. self and object
;; selectors retain parent-private redirection; strict selectors retain their guard.
def $api_method_result(S, papiquery, ptbytes) = HANDLERRESOLVED (API_METHOD_TARGET papiquery pmethoddesc.FUNCTION.ORIGIN ptbytes pmethoddesc.STATIC)
  -- if $api_selected_method(S, papiquery, ptbytes) = (pmethoddesc)
  -- if ~pmethoddesc.ABSTRACT
  -- if pmethoddesc.STATIC \/ papiquery.CLASS.RECEIVER =/= eps
  -- if $method_accessible(S, pmethoddesc, papiquery.SCOPE)
def $api_method_result(S, papiquery, ptbytes) = HANDLERINVALID ($ptascii("cannot call abstract method ") ++ pclassdesc.NAME ++ $ptascii("::") ++ pmethoddesc.NAME ++ $ptascii("()"))
  -- if $scope_method(S, papiquery.CLASS.REQUESTED, ptbytes, ~papiquery.CLASS.STRICT, papiquery.SCOPE) = (pmethoddesc)
  -- if pmethoddesc.ABSTRACT
  -- if $class_at(S.CLASSES, papiquery.CLASS.REQUESTED) = (pclassdesc)
def $api_method_result(S, papiquery, ptbytes) = HANDLERINVALID ($ptascii("non-static method ") ++ pclassdesc.NAME ++ $ptascii("::") ++ pmethoddesc.NAME ++ $ptascii("() cannot be called statically"))
  -- if $scope_method(S, papiquery.CLASS.REQUESTED, ptbytes, ~papiquery.CLASS.STRICT, papiquery.SCOPE) = (pmethoddesc)
  -- if ~pmethoddesc.ABSTRACT /\ ~pmethoddesc.STATIC
  -- if papiquery.CLASS.RECEIVER = eps
  -- if $class_at(S.CLASSES, papiquery.CLASS.REQUESTED) = (pclassdesc)
def $api_method_result(S, papiquery, ptbytes) = HANDLERINVALID ($ptascii("cannot access ") ++ $method_visibility_name(pmethoddesc.VISIBILITY) ++ $ptascii(" method ") ++ pclassdesc.NAME ++ $ptascii("::") ++ pmethoddesc.NAME ++ $ptascii("()"))
  -- if $scope_method(S, papiquery.CLASS.REQUESTED, ptbytes, ~papiquery.CLASS.STRICT, papiquery.SCOPE) = (pmethoddesc)
  -- if ~pmethoddesc.ABSTRACT
  -- if pmethoddesc.STATIC \/ papiquery.CLASS.RECEIVER =/= eps
  -- if ~$method_accessible(S, pmethoddesc, papiquery.SCOPE)
  -- if ~$array_magic(S, papiquery.CLASS.REQUESTED)
  -- if $class_at(S.CLASSES, papiquery.CLASS.REQUESTED) = (pclassdesc)
def $api_method_result(S, papiquery, ptbytes) = HANDLERINVALID ($ptascii("class ") ++ pclassdesc.NAME ++ $ptascii(" does not have a method \"") ++ $c_string(ptbytes) ++ [34])
  -- if $api_selected_method(S, papiquery, ptbytes) = eps
  -- if ~$api_method_magic(S, papiquery)
  -- if $class_at(S.CLASSES, papiquery.CLASS.REQUESTED) = (pclassdesc)
def $api_method_result(S, papiquery, ptbytes) = HANDLERUNKNOWN "magic API callable method" -- otherwise

def $api_finish(S, TYPE_RECEIVE porigin n, pvalue, HANDLERRESOLVED pcalltarget) = $default_store(S, pfunction, n, pvalue_live)
  -- if $function_at($all_functions(S), porigin) = (pfunction)
  -- if $lookup(S.ENV, pfunction.SIGNATURE.PARAMETERS[n].NAME) = (n_cell)
  -- if S.STORE[n_cell] = DEFINED pvalue_live
def $api_finish(S, TYPE_RECEIVE porigin n, pvalue, HANDLERINVALID ptbytes) = $api_receive_reject(S, porigin, n)
def $api_finish(S, CONFIG_INVOKE pconfigcall, pvalue, HANDLERRESOLVED pcalltarget) = $api_register(S, pconfigcall, pvalue)[.TODO = ptask_tail*]
  -- if S.TODO = ptask :: ptask_tail*
  -- if pconfigcall.KIND = INTRINSIC_SET_ERROR_HANDLER
def $api_finish(S, CONFIG_INVOKE pconfigcall, pvalue, HANDLERINVALID ptbytes) = $config_error(S, pconfigcall, "TypeError", $ptascii("set_error_handler(): Argument #1 ($callback) must be a valid callback or null, ") ++ ptbytes)
  -- if pconfigcall.KIND = INTRINSIC_SET_ERROR_HANDLER
def $api_finish(S, ERROR_HANDLER_INVOKE perrorcall, pvalue, HANDLERRESOLVED pcalltarget) = $error_handler_enter(S[.TODO = (ERROR_HANDLER_INVOKE perrorcall) :: ptask_tail*], perrorcall, pcalltarget, pfunction)
  -- if S.TODO = ptask :: ptask_tail*
  -- if $target_function(S, pcalltarget) = (pfunction)
  -- if ~pfunction.SIGNATURE.BYREF
def $api_finish(S, ERROR_HANDLER_INVOKE perrorcall, pvalue, HANDLERRESOLVED pcalltarget) = S[.COMPLETION = UNSUPPORTED "error-handler reference-return body"]
  -- if $target_function(S, pcalltarget) = (pfunction)
  -- if pfunction.SIGNATURE.BYREF
def $api_finish(S, ERROR_HANDLER_INVOKE perrorcall, pvalue, HANDLERINVALID ptbytes) = $error_handler_restore($error_invalid_callback(S, perrorcall, $ptascii("Invalid callback ") ++ $error_callback_name(S, pvalue) ++ $ptascii(", ") ++ ptbytes), pvalue)
def $api_finish(S, ptask, pvalue, HANDLERUNKNOWN text) = S[.COMPLETION = UNSUPPORTED text]

def $api_register(S, pconfigcall, pvalue) = S_mask[.ERRORHANDLERS = S.ERRORHANDLER :: S.ERRORHANDLERS][.ERRORHANDLER = {CALLBACK (pvalue), LEVELS $error_int32(i)}][.RESULT = KNOWN $error_handler_value(S.ERRORHANDLER)][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if pconfigcall.KIND = INTRINSIC_SET_ERROR_HANDLER
  -- if S_mask = $error_api_long(S, pconfigcall, 1, $error_api_value(pconfigcall, 1, PINT 30719))
  -- if S_mask.COMPLETION = NORMAL
  -- if S_mask.RESULT = KNOWN (PINT i)
def $api_register(S, pconfigcall, pvalue) = S_mask
  -- if pconfigcall.KIND = INTRINSIC_SET_ERROR_HANDLER
  -- if S_mask = $error_api_long(S, pconfigcall, 1, $error_api_value(pconfigcall, 1, PINT 30719))
  -- if S_mask.COMPLETION =/= NORMAL

def $api_receive_reject(S, porigin, n) = $api_fallback_reject(S, TYPE_RECEIVE porigin n)

rule PhpStep/api-callable-receive: S ~> $api_begin(S, TYPE_RECEIVE porigin n, pvalue)
  -- if $api_receive_candidate(S)
  -- if S.TODO = [TYPE_RECEIVE porigin n]
  -- if $function_at($all_functions(S), porigin) = (pfunction)
  -- if $lookup(S.ENV, pfunction.SIGNATURE.PARAMETERS[n].NAME) = (n_cell)
  -- if S.STORE[n_cell] = DEFINED pvalue
rule PhpStep/api-callable-register: S ~> $api_begin(S, CONFIG_INVOKE pconfigcall, $error_api_value(pconfigcall, 0, PNULL))
  -- if S.TODO = (CONFIG_INVOKE pconfigcall) :: ptask_tail*
  -- if $config_invoke_valid(S, pconfigcall)
  -- if $api_registration_candidate(S, pconfigcall)
rule PhpStep/api-callable-dispatch: S ~> $api_begin(S[.ERRORHANDLER.CALLBACK = eps], ERROR_HANDLER_INVOKE perrorcall, perrorcall.CALLBACK)
  -- if S.TODO = (ERROR_HANDLER_INVOKE perrorcall) :: ptask_tail*
  -- if $call_task_valid(S, ERROR_HANDLER_INVOKE perrorcall)
  -- if $api_special(S, perrorcall.CALLBACK)
rule PhpStep/api-callable-class-result: S ~> $api_after_class(S, papiquery)
  -- if S.TODO = (API_CALLABLE_RESULT papiquery 0) :: ptask_tail*
rule PhpStep/api-callable-method-result: S ~> $api_after_method(S, papiquery)
  -- if S.TODO = (API_CALLABLE_RESULT papiquery 1) :: ptask_tail*

;; Pure facts suppress deprecations; executing consumers must use the stages
;; above. These facts do not certify an entered API invocation.
def $api_source_line(S, DISCARD) = 0
def $api_pure(S, PARRAY n) = $api_pure_array_method(S, papiquery, ptbytes)
  -- if $entry_lookup(S.ARRAYS[n].ITEMS, KINT 0) = (pitem_receiver)
  -- if $entry_lookup(S.ARRAYS[n].ITEMS, KINT 1) = (pitem_method)
  -- if pvalue_input = $entry_value(S, pitem_receiver)
  -- if $entry_value(S, pitem_method) = PSTRING ptbytes
  -- if $api_initial_class(S, PARRAY n) = API_CLASS papiclass
  -- if papiquery = $api_query(S, DISCARD, PARRAY n, pvalue_input, pitem_method, papiclass, ptbytes, 0, 0)
def $api_pure(S, PSTRING ptbytes) = $api_method_result(S, papiquery, ptbytes_method)
  -- if $method_string_parts(ptbytes) = ((ptbytes_class, ptbytes_method))
  -- if $api_initial_class(S, PSTRING ptbytes) = API_CLASS papiclass
  -- if papiquery = $api_query(S, DISCARD, PSTRING ptbytes, PSTRING ptbytes_class, DIRECT (PSTRING ptbytes), papiclass, ptbytes, $(|ptbytes_class| + 2), |ptbytes_method|)
def $api_pure(S, pvalue) = HANDLERINVALID ptbytes -- if $api_initial_class(S, pvalue) = API_CLASS_INVALID ptbytes
def $api_pure(S, pvalue) = HANDLERUNKNOWN text -- if $api_initial_class(S, pvalue) = API_CLASS_UNKNOWN text
def $api_pure_array_method(S, papiquery, ptbytes) = $api_method_result(S, papiquery, ptbytes)
  -- if $method_string_parts(ptbytes) = eps
def $api_pure_array_method(S, papiquery, ptbytes) = $api_method_result(S, papiquery[.CLASS = papiclass][.OUTER = (papiquery.CLASS)][.PREFIX = $(|ptbytes_class| + 2)][.WIDTH = |ptbytes_method|], ptbytes_method)
  -- if $method_string_parts(ptbytes) = ((ptbytes_class, ptbytes_method))
  -- if ptbytes_class =/= eps
  -- if $api_class(S, PSTRING ptbytes_class, (papiquery.CLASS.REQUESTED), papiquery.SCOPE, papiquery.CALLED, papiquery.THIS, papiquery.CLASS.RECEIVER) = API_CLASS papiclass
  -- if $api_subclass(S, papiquery.CLASS.REQUESTED, papiclass.REQUESTED)
def $api_pure_array_method(S, papiquery, ptbytes) = HANDLERINVALID ($ptascii("invalid function name"))
  -- if $method_string_parts(ptbytes) = ((eps, ptbytes_method))
def $api_pure_array_method(S, papiquery, ptbytes) = HANDLERINVALID ptbytes_error
  -- if $method_string_parts(ptbytes) = ((ptbytes_class, ptbytes_method))
  -- if ptbytes_class =/= eps
  -- if $api_class(S, PSTRING ptbytes_class, (papiquery.CLASS.REQUESTED), papiquery.SCOPE, papiquery.CALLED, papiquery.THIS, papiquery.CLASS.RECEIVER) = API_CLASS_INVALID ptbytes_error
def $api_pure_array_method(S, papiquery, ptbytes) = HANDLERINVALID ($ptascii("class ") ++ pclassdesc_outer.NAME ++ $ptascii(" is not a subclass of ") ++ pclassdesc_inner.NAME)
  -- if $method_string_parts(ptbytes) = ((ptbytes_class, ptbytes_method))
  -- if ptbytes_class =/= eps
  -- if $api_class(S, PSTRING ptbytes_class, (papiquery.CLASS.REQUESTED), papiquery.SCOPE, papiquery.CALLED, papiquery.THIS, papiquery.CLASS.RECEIVER) = API_CLASS papiclass
  -- if ~$api_subclass(S, papiquery.CLASS.REQUESTED, papiclass.REQUESTED)
  -- if $class_at(S.CLASSES, papiquery.CLASS.REQUESTED) = (pclassdesc_outer)
  -- if $class_at(S.CLASSES, papiclass.REQUESTED) = (pclassdesc_inner)
def $api_pure_array_method(S, papiquery, ptbytes) = HANDLERUNKNOWN "compound callable class, autoload or internal lookup" -- otherwise
def $api_admission(HANDLERRESOLVED pcalltarget) = (true)
def $api_admission(HANDLERINVALID ptbytes) = (false)
def $api_admission(HANDLERUNKNOWN text) = eps

