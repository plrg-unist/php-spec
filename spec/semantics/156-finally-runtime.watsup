rule PhpStep/ref-replay-expand: S ~> S[.TODO = (THROW_SEARCH n) :: $ref_replay_tasks(porigin_source, z, prefowner_first :: prefowner_tail*)][.ORIGIN = ($ref_owner_origin(prefowner_first))]
