  -- if S_left.TODO = (RETURN_REF_UNWIND (KNOWN PNULL) prefreturncursor.LINE true prefreturncursor.SOURCE) :: (REF_RECHECK prefreturncursor.SOURCE prefreturncursor.OWNER (KNOWN PNULL) prefreturncursor.LINE) :: eps
rule PhpStep/finally-resume-consumed-assigned-integer-call: S ~> S_left[.TODO = [RETURN_REF_UNWIND (KNOWN PNULL) prefreturncursor.LINE true prefreturncursor.SOURCE, REF_RETURN_NOTICE prefreturncursor.SOURCE prefreturncursor.LINE REF_NOTICE_VALUE, REF_RECHECK prefreturncursor.SOURCE prefreturncursor.OWNER (KNOWN PNULL) prefreturncursor.LINE]]
  -- if S.TODO = (FINALLY_REF_CONSUMED prefreturncursor) :: ptask_tail*
  -- if $ref_return_cursor_assigned_int_call(S, prefreturncursor)
  -- if S_left = $finally_leave_ref_return(S, prefreturncursor.OWNER, prefreturncursor.SOURCE, KNOWN PNULL, prefreturncursor.LINE, true, ptask_tail*)
  -- if S_left.TODO = (RETURN_REF_UNWIND (KNOWN PNULL) prefreturncursor.LINE true prefreturncursor.SOURCE) :: (REF_RECHECK prefreturncursor.SOURCE prefreturncursor.OWNER (KNOWN PNULL) prefreturncursor.LINE) :: eps
rule PhpStep/finally-resume-consumed-assigned-folded-integer: S ~> S_left[.TODO = [RETURN_REF_UNWIND (KNOWN PNULL) prefreturncursor.LINE true prefreturncursor.SOURCE, REF_RETURN_NOTICE prefreturncursor.SOURCE prefreturncursor.LINE REF_NOTICE_VALUE, REF_RECHECK prefreturncursor.SOURCE prefreturncursor.OWNER (KNOWN PNULL) prefreturncursor.LINE]]
  -- if S.TODO = (FINALLY_REF_CONSUMED prefreturncursor) :: ptask_tail*
  -- if $ref_return_cursor_assigned_folded_int(S, prefreturncursor)
  -- if S_left = $finally_leave_ref_return(S, prefreturncursor.OWNER, prefreturncursor.SOURCE, KNOWN PNULL, prefreturncursor.LINE, true, ptask_tail*)
  -- if S_left.TODO = (RETURN_REF_UNWIND (KNOWN PNULL) prefreturncursor.LINE true prefreturncursor.SOURCE) :: (REF_RECHECK prefreturncursor.SOURCE prefreturncursor.OWNER (KNOWN PNULL) prefreturncursor.LINE) :: eps
rule PhpStep/finally-resume-consumed-literal: S ~> S_left[.TODO = [RETURN_REF_UNWIND (KNOWN pvalue) prefreturncursor.LINE true prefreturncursor.SOURCE, REF_RETURN_NOTICE prefreturncursor.SOURCE prefreturncursor.LINE REF_NOTICE_VALUE, REF_RECHECK prefreturncursor.SOURCE prefreturncursor.OWNER (KNOWN pvalue) prefreturncursor.LINE]]
  -- if S.TODO = (FINALLY_REF_CONSUMED prefreturncursor) :: ptask_tail*
  -- if $ref_return_cursor_literal(S, prefreturncursor) = (pvalue)
  -- if S_left = $finally_leave_ref_return(S, prefreturncursor.OWNER, prefreturncursor.SOURCE, KNOWN pvalue, prefreturncursor.LINE, true, ptask_tail*)
  -- if S_left.TODO = (RETURN_REF_UNWIND (KNOWN pvalue) prefreturncursor.LINE true prefreturncursor.SOURCE) :: (REF_RECHECK prefreturncursor.SOURCE prefreturncursor.OWNER (KNOWN pvalue) prefreturncursor.LINE) :: eps
rule PhpStep/finally-resume-jump: S ~> $jump_loop($finally_leave(S, porigin, ptask_tail*), porigin_source, n_depth, n_original, b_continue)
  -- if S.TODO = (FINALLY_JUMP porigin porigin_source n_depth n_original b_continue) :: ptask_tail*
rule PhpStep/finally-resume-goto: S ~> S_left[.TODO = (GOTO_UNWIND porigin_source pcpath_source pcpath_target) :: S_left.TODO]
  -- if S.TODO = (FINALLY_GOTO porigin porigin_source pcpath_source pcpath_target) :: ptask_tail*
  -- if S_left = $finally_leave(S, porigin, ptask_tail*)
rule PhpStep/finally-replace-normal: S ~> $finally_leave_throw(S, porigin, n, ptask_tail*)
  -- if S.TODO = (THROW_SEARCH n) :: (FINALLY_RESUME porigin eps) :: ptask_tail*
rule PhpStep/finally-replace-throw: S ~> $finally_leave_throw(S_chained, porigin, n, ptask_tail*)
  -- if S.TODO = (THROW_SEARCH n) :: (FINALLY_RESUME porigin (n_old)) :: ptask_tail*
  -- if S_chained = $finally_exception_previous(S, n, n_old)
rule PhpStep/finally-replace-return: S ~> $finally_leave_throw(S, porigin, n, ptask_tail*)
  -- if S.TODO = (THROW_SEARCH n) :: (FINALLY_RETURN porigin porigin_source poperand) :: ptask_tail*
rule PhpStep/finally-replace-ref-return: S ~> $reference_notice_restore($finally_leave_throw($retired_drop_transfer(S, porigin_source, z), porigin, n, ptask_tail*))
  -- if S.TODO = (THROW_SEARCH n) :: (FINALLY_REF_RETURN porigin porigin_source poperand z) :: ptask_tail*
rule PhpStep/finally-replace-consumed-ref: S ~> $finally_leave_throw(S, prefreturncursor.OWNER, n, ptask_tail*)
  -- if S.TODO = (THROW_SEARCH n) :: (FINALLY_REF_CONSUMED prefreturncursor) :: ptask_tail*
rule PhpStep/finally-replace-consumed-pair: S ~> $finally_leave_throw(S, prefreturncursor_inner.OWNER, n, ptask_tail*)
  -- if S.TODO = (THROW_SEARCH n) :: (FINALLY_REF_PAIR prefreturncursor_inner prefreturncursor_outer) :: ptask_tail*
rule PhpStep/finally-replace-jump: S ~> $finally_leave_throw(S, porigin, n, ptask_tail*)
  -- if S.TODO = (THROW_SEARCH n) :: (FINALLY_JUMP porigin porigin_source n_depth n_original b_continue) :: ptask_tail*
rule PhpStep/finally-replace-goto: S ~> $finally_leave_throw(S, porigin, n, ptask_tail*)
  -- if S.TODO = (THROW_SEARCH n) :: (FINALLY_GOTO porigin porigin_source pcpath_source pcpath_target) :: ptask_tail*

def $throwable_marker(FINALLY_ONLY porigin) = true
def $throwable_marker(FINALLY_RESUME porigin n?) = true
def $throwable_marker(FINALLY_RETURN porigin porigin_source poperand) = true
def $throwable_marker(FINALLY_REF_RETURN porigin porigin_source poperand z) = true
def $throwable_marker(FINALLY_REF_CONSUMED prefreturncursor) = true
def $throwable_marker(FINALLY_REF_PAIR prefreturncursor_inner prefreturncursor_outer) = true
def $throwable_marker(FINALLY_JUMP porigin porigin_source n_depth n_original b_continue) = true
def $throwable_marker(FINALLY_GOTO porigin porigin_source pcpath_source pcpath_target) = true
def $task_nodes(FINALLY_RESUME porigin n?) = $instance_roots(n?)
def $task_nodes(FINALLY_RETURN porigin porigin_source poperand) = $operand_nodes(poperand)
def $task_nodes(FINALLY_REF_RETURN porigin porigin_source poperand z) = $operand_nodes(poperand)
def $task_nodes(FINALLY_REF_CONSUMED prefreturncursor) = eps
def $task_nodes(FINALLY_REF_PAIR prefreturncursor_inner prefreturncursor_outer) = eps

;; The current source origin distinguishes catch/try continuation from an
;; executing finalizer. Each frame may hold at most one marker for a source try.
def $finally_marker_origin(TRY_END porigin) = (porigin)
def $finally_marker_origin(FINALLY_ONLY porigin) = (porigin)
def $finally_marker_origin(FINALLY_RESUME porigin n?) = (porigin)
def $finally_marker_origin(FINALLY_RETURN porigin porigin_source poperand) = (porigin)
def $finally_marker_origin(FINALLY_REF_RETURN porigin porigin_source poperand z) = (porigin)
def $finally_marker_origin(FINALLY_REF_CONSUMED prefreturncursor) = (prefreturncursor.OWNER)
def $finally_marker_origin(FINALLY_REF_PAIR prefreturncursor_inner prefreturncursor_outer) = (prefreturncursor_inner.OWNER)
def $finally_marker_origin(FINALLY_JUMP porigin porigin_source n_depth n_original b_continue) = (porigin)
def $finally_marker_origin(FINALLY_GOTO porigin porigin_source pcpath_source pcpath_target) = (porigin)
def $finally_marker_origin(AT porigin ptask) = $finally_marker_origin(ptask)
def $finally_marker_origin(ptask) = eps -- otherwise
dec $finally_marker_count(ptask*, porigin) : nat
def $finally_marker_count(eps, porigin) = 0
def $finally_marker_count(ptask :: ptask_tail*, porigin) = $(1 + $finally_marker_count(ptask_tail*, porigin))
  -- if $finally_marker_origin(ptask) = (porigin)
def $finally_marker_count(ptask :: ptask_tail*, porigin) = $finally_marker_count(ptask_tail*, porigin)
  -- if $finally_marker_origin(ptask) =/= (porigin)
def $finally_catch_origin(S, porigin, (porigin)) = true
def $finally_catch_origin(S, PORIGIN n pcpath, (PORIGIN n pcpath_active)) = true
  -- if $(|pcpath_active| = |pcpath| + 2)
  -- if n_field = |pcpath|
  -- if n_last = $(n_field + 1)
  -- if pcpath_active[0:n_field] = pcpath
  -- if pcpath_active[n_field] = PCFIELD 1
  -- if pcpath_active[n_last] = PCINDEX n_index
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath_active) = (NStmtCatch phpType42 phpType43 phpType23 metadata)
def $finally_catch_origin(S, porigin, porigin_active?) = false -- otherwise
dec $finally_only_valid(pstate, porigin) : bool
def $finally_only_valid(S, porigin) = ($throwable_try_valid(S, porigin) /\ $finally_present(S, porigin) /\ $finally_catch_origin(S, porigin, S.ORIGIN) /\ $finally_marker_count(S.TODO, porigin) = 1)
dec $finally_saved_valid(pstate, nat?) : bool
def $finally_saved_valid(S, eps) = true
def $finally_saved_valid(S, (n)) = $throwable_live(S, n)
dec $finally_resume_valid(pstate, porigin, nat?) : bool
def $finally_resume_valid(S, porigin, n?) = ($throwable_try_valid(S, porigin) /\ $finally_present(S, porigin) /\ S.ORIGIN = $origin_child((porigin), [PCFIELD 2]) /\ $finally_saved_valid(S, n?) /\ $finally_marker_count(S.TODO, porigin) = 1)
def $call_task_valid(S, FINALLY_ONLY porigin) = $finally_only_valid(S, porigin)
def $finally_phase_of(FINALLY_RESUME porigin n?) = ($finally_outcome_phase(n?))
def $finally_phase_of(FINALLY_RETURN porigin porigin_source poperand) = (2)
def $finally_phase_of(FINALLY_REF_RETURN porigin porigin_source poperand z) = (3)
def $finally_phase_of(FINALLY_REF_CONSUMED prefreturncursor) = (3)
def $finally_phase_of(FINALLY_REF_PAIR prefreturncursor_inner prefreturncursor_outer) = (3)
def $finally_phase_of(FINALLY_JUMP porigin porigin_source n_depth n_original b_continue) = (4)
def $finally_phase_of(FINALLY_GOTO porigin porigin_source pcpath_source pcpath_target) = (5)
def $finally_phase_of(ptask) = eps -- otherwise
dec $finally_phase_after(ptask, ptask*, nat) : bool
def $finally_phase_after(ptask, (FINALLY_PHASE porigin n_phase) :: ptask_tail*, n_phase) = ($finally_marker_origin(ptask) = (porigin) /\ $finally_phase_of(ptask) = (n_phase))
def $finally_phase_after(ptask, ptask_tail*, n_phase) = false -- otherwise
dec $finally_phase_at(ptask*, ptask, nat) : bool
def $finally_phase_at(eps, ptask, n_phase) = false
def $finally_phase_at(ptask_head :: ptask_tail*, ptask, n_phase) = ((ptask_head = ptask /\ $finally_phase_after(ptask_head, ptask_tail*, n_phase)) \/ $finally_phase_at(ptask_tail*, ptask, n_phase))
dec $finally_phase_guard_valid(ptask*, porigin, nat) : bool
def $finally_phase_guard_valid(eps, porigin, n_phase) = false
def $finally_phase_guard_valid(ptask :: ptask_tail*, porigin, n_phase) = ($finally_phase_after(ptask, ptask_tail*, n_phase) \/ $finally_phase_guard_valid(ptask_tail*, porigin, n_phase))
  -- if $finally_marker_origin(ptask) = (porigin)
def $finally_phase_guard_valid(ptask :: ptask_tail*, porigin, n_phase) = $finally_phase_guard_valid(ptask_tail*, porigin, n_phase)
  -- if $finally_marker_origin(ptask) =/= (porigin)
dec $finally_phase_origin(ptask) : porigin?
def $finally_phase_origin(FINALLY_PHASE porigin n_phase) = (porigin)
def $finally_phase_origin(ptask) = eps -- otherwise
dec $finally_phase_count(ptask*, porigin) : nat
def $finally_phase_count(eps, porigin) = 0
def $finally_phase_count(ptask :: ptask_tail*, porigin) = $(1 + $finally_phase_count(ptask_tail*, porigin))
  -- if $finally_phase_origin(ptask) = (porigin)
def $finally_phase_count(ptask :: ptask_tail*, porigin) = $finally_phase_count(ptask_tail*, porigin)
  -- if $finally_phase_origin(ptask) =/= (porigin)
def $call_task_valid(S, FINALLY_RESUME porigin n?) = ($finally_resume_valid(S, porigin, n?) /\ $finally_phase_at(S.TODO, FINALLY_RESUME porigin n?, $finally_outcome_phase(n?)))
def $call_task_valid(S, FINALLY_PHASE porigin n_phase) = ($finally_phase_guard_valid(S.TODO, porigin, n_phase) /\ $finally_phase_count(S.TODO, porigin) = 1)
def $finally_source_inside(S, PORIGIN n pcpath_try, PORIGIN n pcpath_source) = ($effect_below(pcpath_try, pcpath_source) /\ ~$effect_below(pcpath_try ++ [PCFIELD 2], pcpath_source) /\ $goto_scope_valid(S, PORIGIN n pcpath_source))
def $finally_source_inside(S, porigin, porigin_source) = false -- otherwise
dec $finally_return_source_valid(pstate, porigin, porigin) : bool
def $finally_return_source_valid(S, porigin, porigin_source) = true
  -- if $finally_source_inside(S, porigin, porigin_source)
  -- if $origin_node(S.SOURCES, porigin_source) = (NStmtReturn phpType5 metadata)
def $finally_return_source_valid(S, porigin, porigin_source) = false -- otherwise
def $finally_ref_source_valid(S, porigin, porigin_source, z) = ($finally_return_source_valid(S, porigin, porigin_source) /\ ($reference_return_source(S[.ORIGIN = (porigin_source)], z) \/ $reference_return_null_valid(S[.ORIGIN = (porigin_source)], z)))
dec $finally_jump_owner_count(pcpath*, pcpath) : nat
def $finally_jump_owner_count(eps, pcpath_try) = 0
def $finally_jump_owner_count(pcpath_owner :: pcpath_tail*, pcpath_try) = $(1 + $finally_jump_owner_count(pcpath_tail*, pcpath_try))
  -- if $effect_below(pcpath_try, pcpath_owner)
def $finally_jump_owner_count(pcpath_owner :: pcpath_tail*, pcpath_try) = $finally_jump_owner_count(pcpath_tail*, pcpath_try)
  -- if ~$effect_below(pcpath_try, pcpath_owner)
dec $finally_jump_source_valid(pstate, porigin, porigin, nat, nat, bool) : bool
def $finally_jump_source_valid(S, PORIGIN n pcpath_try, PORIGIN n pcpath_source, n_depth, n_original, false) = true
  -- if $finally_source_inside(S, PORIGIN n pcpath_try, PORIGIN n pcpath_source)
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath_source) = (NStmtBreak phpType5 metadata)
  -- if n_original = $jump_depth(phpType5)
  -- if $source_unit(S.SOURCES, n) = (pcunit)
  -- if pcpath_root = $ppfinally_scope(pcunit.OCCURRENCES, pcpath_source)
  -- if pcpath_owner* = $ppgoto_owners(pcunit.OCCURRENCES, pcpath_root, pcpath_source, |pcpath_root|)
  -- if $(n_depth > 0 /\ n_original = n_depth + $finally_jump_owner_count(pcpath_owner*, pcpath_try))
def $finally_jump_source_valid(S, PORIGIN n pcpath_try, PORIGIN n pcpath_source, n_depth, n_original, true) = true
  -- if $finally_source_inside(S, PORIGIN n pcpath_try, PORIGIN n pcpath_source)
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath_source) = (NStmtContinue phpType5 metadata)
  -- if n_original = $jump_depth(phpType5)
  -- if $source_unit(S.SOURCES, n) = (pcunit)
  -- if pcpath_root = $ppfinally_scope(pcunit.OCCURRENCES, pcpath_source)
  -- if pcpath_owner* = $ppgoto_owners(pcunit.OCCURRENCES, pcpath_root, pcpath_source, |pcpath_root|)
  -- if $(n_depth > 0 /\ n_original = n_depth + $finally_jump_owner_count(pcpath_owner*, pcpath_try))
def $finally_jump_source_valid(S, porigin, porigin_source, n_depth, n_original, b_continue) = false -- otherwise
dec $finally_goto_source_valid(pstate, porigin, porigin, pcpath, pcpath) : bool
def $finally_goto_source_valid(S, PORIGIN n pcpath_try, PORIGIN n pcpath_source, pcpath_source, pcpath_target) = ($finally_source_inside(S, PORIGIN n pcpath_try, PORIGIN n pcpath_source) /\ ~$effect_below(pcpath_try, pcpath_target) /\ $goto_site(S, PORIGIN n pcpath_source, pcpath_target))
def $finally_goto_source_valid(S, porigin, porigin_source, pcpath_source, pcpath_target) = false -- otherwise
dec $return_unwind_source_valid(pstate, porigin?) : bool
dec $return_unwind_node(pcnode?) : bool
def $return_unwind_node((NStmtReturn phpType5 metadata)) = true
def $return_unwind_node(pcnode?) = false -- otherwise
dec $return_unwind_fallthrough(pcallcontext?, porigin) : bool
def $return_unwind_fallthrough((pcallcontext), porigin_source) = (pcallcontext.FUNCTION = porigin_source)
def $return_unwind_fallthrough(eps, porigin_source) = false
def $return_unwind_source_valid(S, eps) = (S.CURRENT = eps)
def $return_unwind_source_valid(S, (porigin_source)) = (($goto_scope_valid(S, porigin_source) /\ $return_unwind_node($origin_node(S.SOURCES, porigin_source))) \/ $return_unwind_fallthrough(S.CURRENT, porigin_source))
def $call_task_valid(S, RETURN_UNWIND poperand porigin_source?) = ($return_unwind_source_valid(S, porigin_source?) /\ $finally_return_operand_valid(S, poperand))

def $call_task_valid(S, FINALLY_RETURN porigin porigin_source poperand) = ($finally_resume_valid(S, porigin, eps) /\ $finally_phase_at(S.TODO, FINALLY_RETURN porigin porigin_source poperand, 2) /\ $finally_return_source_valid(S, porigin, porigin_source) /\ $finally_return_operand_valid(S, poperand))
def $call_task_valid(S, FINALLY_REF_RETURN porigin porigin_source poperand z) = ($finally_resume_valid(S, porigin, eps) /\ $finally_phase_at(S.TODO, FINALLY_REF_RETURN porigin porigin_source poperand z, 3) /\ $finally_ref_source_valid(S, porigin, porigin_source, z) /\ $finally_return_operand_valid(S, poperand))
dec $ref_consumed_valid(pstate, prefreturncursor) : bool
def $ref_consumed_valid(S, prefreturncursor) = ($ref_return_cursor_site(S, prefreturncursor) /\ $finally_resume_valid(S, prefreturncursor.OWNER, eps) /\ $finally_phase_at(S.TODO, FINALLY_REF_CONSUMED prefreturncursor, 3) /\ $ref_consumed_tail(S.TODO) = [FINALLY_REF_CONSUMED prefreturncursor, FINALLY_PHASE prefreturncursor.OWNER 3, ORIGIN_RETURN prefreturncursor.OUTER])
;; An intact catch-interposed pair projects Z's restore before its old tail.
dec $ref_consumed_pair_outer_valid(pstate, prefreturncursor) : bool
def $ref_consumed_pair_outer_valid(S, prefreturncursor_outer) = $ref_consumed_valid(S[.ORIGIN = $origin_child((prefreturncursor_outer.OWNER), [PCFIELD 2])], prefreturncursor_outer)
  -- if $ref_consumed_pair_tail(S.TODO) = [FINALLY_REF_PAIR prefreturncursor_inner prefreturncursor_outer, FINALLY_PHASE porigin_inner 3, ORIGIN_RETURN porigin_restore_inner?, FINALLY_REF_CONSUMED prefreturncursor_outer, FINALLY_PHASE porigin_outer 3, ORIGIN_RETURN porigin_restore_outer?]
  -- if $ref_return_pair_computed_sites(S, prefreturncursor_inner, prefreturncursor_outer) \/ $ref_return_pair_mixed_sites(S, prefreturncursor_inner, prefreturncursor_outer) \/ $ref_return_pair_reversed_mixed_sites(S, prefreturncursor_inner, prefreturncursor_outer) \/ $ref_return_pair_array_sites(S, prefreturncursor_inner, prefreturncursor_outer)
  -- if S.ORIGIN = prefreturncursor_inner.OUTER
def $ref_consumed_pair_outer_valid(S, prefreturncursor_outer) = $ref_consumed_valid(S[.ORIGIN = $origin_child((prefreturncursor_outer.OWNER), [PCFIELD 2])], prefreturncursor_outer)
  -- if $ref_consumed_pair_tail(S.TODO) = [FINALLY_REF_PAIR prefreturncursor_inner prefreturncursor_outer, FINALLY_PHASE porigin_inner 3, ORIGIN_RETURN porigin_restore_inner?, FINALLY_REF_CONSUMED prefreturncursor_outer, FINALLY_PHASE porigin_outer 3, ORIGIN_RETURN porigin_restore_outer?]
  -- if $ref_return_pair_sites(S, prefreturncursor_inner, prefreturncursor_outer)
  -- if $ref_return_pair_catch_passage(S, prefreturncursor_inner, prefreturncursor_outer) = (ptask_passage*)
  -- if S.ORIGIN = prefreturncursor_inner.OUTER
def $ref_consumed_pair_outer_valid(S, prefreturncursor_outer) = false -- otherwise
def $call_task_valid(S, FINALLY_REF_CONSUMED prefreturncursor) = ($ref_consumed_valid(S, prefreturncursor) \/ $ref_consumed_pair_outer_valid(S, prefreturncursor))
def $call_task_valid(S, FINALLY_REF_PAIR prefreturncursor_inner prefreturncursor_outer) = (($ref_return_pair_sites(S, prefreturncursor_inner, prefreturncursor_outer) \/ $ref_return_pair_computed_sites(S, prefreturncursor_inner, prefreturncursor_outer) \/ $ref_return_pair_mixed_sites(S, prefreturncursor_inner, prefreturncursor_outer) \/ $ref_return_pair_reversed_mixed_sites(S, prefreturncursor_inner, prefreturncursor_outer) \/ $ref_return_pair_array_sites(S, prefreturncursor_inner, prefreturncursor_outer)) /\ $finally_resume_valid(S, prefreturncursor_inner.OWNER, eps) /\ $finally_phase_at(S.TODO, FINALLY_REF_PAIR prefreturncursor_inner prefreturncursor_outer, 3) /\ $ref_consumed_pair_tail(S.TODO) = [FINALLY_REF_PAIR prefreturncursor_inner prefreturncursor_outer, FINALLY_PHASE prefreturncursor_inner.OWNER 3, ORIGIN_RETURN prefreturncursor_inner.OUTER, FINALLY_REF_CONSUMED prefreturncursor_outer, FINALLY_PHASE prefreturncursor_outer.OWNER 3, ORIGIN_RETURN prefreturncursor_outer.OUTER])
def $call_task_valid(S, FINALLY_JUMP porigin porigin_source n_depth n_original b_continue) = ($finally_resume_valid(S, porigin, eps) /\ $finally_phase_at(S.TODO, FINALLY_JUMP porigin porigin_source n_depth n_original b_continue, 4) /\ $finally_jump_source_valid(S, porigin, porigin_source, n_depth, n_original, b_continue))
def $call_task_valid(S, FINALLY_GOTO porigin porigin_source pcpath_source pcpath_target) = ($finally_resume_valid(S, porigin, eps) /\ $finally_phase_at(S.TODO, FINALLY_GOTO porigin porigin_source pcpath_source pcpath_target, 5) /\ $finally_goto_source_valid(S, porigin, porigin_source, pcpath_source, pcpath_target))
def $finally_return_operand_valid(S, KNOWN pvalue) = true
def $finally_return_operand_valid(S, REFERENCE n) = $call_reference_operand_valid(S, REFERENCE n)
def $finally_return_operand_valid(S, poperand) = false -- otherwise

def $finally_try_unique(S, porigin) = true
  -- if ~$finally_present(S, porigin)
def $finally_try_unique(S, porigin) = ($finally_marker_count(S.TODO, porigin) = 1)
  -- if $finally_present(S, porigin)
def $finally_binding_marker(S, porigin) = true
  -- if ~$finally_present(S, porigin)
def $finally_binding_marker(S, porigin) = ((FINALLY_ONLY porigin) <- S.TODO /\ $finally_marker_count(S.TODO, porigin) = 1)
  -- if $finally_present(S, porigin)

;; Marker presence is checked from the active source region as well as from
;; existing tasks, so deleting the only pending-outcome root cannot skip cleanup.
dec $finally_before_entry(pstate, porigin) : bool
def $finally_before_entry(S, porigin) = true
  -- if S.ORIGIN = (porigin)
