;; Generated-only Stage A previous links form an acyclic chain. Direct
;; constructor writes may create cycles and require a later bounded traversal.
syntax pthrowchain = THROWCHAIN nat* | BADTHROWCHAIN
dec $finally_source_inside(pstate, porigin, porigin) : bool
dec $finally_marker_origin(ptask) : porigin?
dec $finally_catch_origin(pstate, porigin, porigin?) : bool
dec $finally_phase_of(ptask) : nat?
dec $ref_recheck_tail(pstate, porigin, porigin, poperand, int, ptask*) : ptask*
dec $ref_replay_owners(pstate, porigin) : porigin*
dec $ref_recheck_last(ptask*, ptask) : bool
dec $throwable_chain(pstate, nat, nat*) : pthrowchain
dec $throwable_chain_next(pstate, nat?, nat*) : pthrowchain
def $throwable_chain(S, n, n_seen*) = $throwable_chain_next(S, $throwable_previous_id(S, n), n_seen* ++ [n])
  -- if ~(n <- n_seen*)
  -- if $(n < |S.OBJECTS|)
  -- if (HOBJECT n) <- S.ALLOCATIONS
  -- if S.OBJECTS[n] = THROWABLE pthrowable
def $throwable_chain(S, n, n_seen*) = $throwable_chain_next(S, $throwable_previous_id(S, n), n_seen* ++ [n])
  -- if ~(n <- n_seen*)
  -- if $(n < |S.OBJECTS|)
  -- if (HOBJECT n) <- S.ALLOCATIONS
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $throwable_member(S, n)
  -- if $closure_live_object_valid(S, n)
def $throwable_chain(S, n, n_seen*) = BADTHROWCHAIN -- otherwise
def $throwable_chain_next(S, eps, n_seen*) = THROWCHAIN n_seen*
def $throwable_chain_next(S, (n), n_seen*) = $throwable_chain(S, n, n_seen*)
def $throwable_chain_valid(S, n) = true
  -- if $throwable_chain(S, n, eps) = THROWCHAIN n_chain*
def $throwable_chain_valid(S, n) = false -- otherwise

dec $throwable_disjoint(nat*, nat*) : bool
def $throwable_disjoint(eps, n_old*) = true
def $throwable_disjoint(n :: n_tail*, n_old*) = (~(n <- n_old*) /\ $throwable_disjoint(n_tail*, n_old*))
dec $throwable_previous(pstate, nat, nat) : pstate
dec $finally_exception_previous(pstate, nat, nat) : pstate
def $throwable_previous(S, n_new, n_old) = $throwable_set_previous_id(S, n_last, (n_old))
  -- if $throwable_chain(S, n_new, eps) = THROWCHAIN n_new_chain*
  -- if $(|n_new_chain*| > 0)
  -- if n_index = $(|n_new_chain*| - 1)
  -- if n_last = (n_new_chain*)[n_index]
  -- if $throwable_chain(S, n_old, eps) = THROWCHAIN n_old_chain*
  -- if $throwable_disjoint(n_new_chain*, n_old_chain*)
def $throwable_previous(S, n_new, n_old) = S
  -- if $throwable_chain(S, n_new, eps) = THROWCHAIN n_new_chain*
  -- if $throwable_chain(S, n_old, eps) = THROWCHAIN n_old_chain*
  -- if ~$throwable_disjoint(n_new_chain*, n_old_chain*)
def $throwable_previous(S, n_new, n_old) = S[.COMPLETION = UNSUPPORTED "invalid Throwable previous chain"] -- otherwise

def $finally_present(S, porigin) = true
  -- if $origin_node(S.SOURCES, porigin) = (NStmtTryCatch phpType23 phpType65 (NStmtFinally phpType23_final metadata_final) metadata)
def $finally_present(S, porigin) = false -- otherwise
def $finally_catch_tail(S, porigin, ptask*) = (FINALLY_ONLY porigin) :: ptask*
  -- if $finally_present(S, porigin)
def $finally_catch_tail(S, porigin, ptask*) = ptask*
  -- if ~$finally_present(S, porigin)

dec $finally_return_operand_valid(pstate, poperand) : bool
dec $finally_enter(pstate, porigin, nat?, ptask*) : pstate
dec $finally_enter_return(pstate, porigin, porigin, poperand, ptask*) : pstate
;; Pending-outcome phase codes: normal 0, throw 1, value return 2,
;; reference return 3, loop jump 4, goto 5. The separate continuation task
;; prevents a one-task mutation from silently changing the pending outcome.
dec $finally_outcome_phase(nat?) : nat
def $finally_outcome_phase(eps) = 0
def $finally_outcome_phase((n)) = 1
def $finally_enter(S, porigin, n_old?, ptask_tail*) = S[.TODO = $statement_tasks(statement*, $origin_child((porigin_final), [PCFIELD 0]), 0) ++ [FINALLY_RESUME porigin n_old?, FINALLY_PHASE porigin $finally_outcome_phase(n_old?)] ++ ptask_tail*][.ORIGIN = (porigin_final)]
  -- if $origin_child((porigin), [PCFIELD 2]) = (porigin_final)
  -- if $origin_node(S.SOURCES, porigin_final) = (NStmtFinally (SEQUENCE statement*) metadata)
def $finally_enter_return(S, porigin, porigin_source, poperand, ptask_tail*) = S[.TODO = $statement_tasks(statement*, $origin_child((porigin_final), [PCFIELD 0]), 0) ++ [FINALLY_RETURN porigin porigin_source poperand, FINALLY_PHASE porigin 2] ++ ptask_tail*][.ORIGIN = (porigin_final)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if $origin_child((porigin), [PCFIELD 2]) = (porigin_final)
  -- if $origin_node(S.SOURCES, porigin_final) = (NStmtFinally (SEQUENCE statement*) metadata)
def $finally_return_pending(S) = true
  -- if S.ORIGIN = (PORIGIN n pcpath)
  -- if $source_unit(S.SOURCES, n) = (pcunit)
  -- if $ppfinally_protected(pcunit.OCCURRENCES, pcpath) =/= eps
def $finally_return_pending(S) = false -- otherwise
dec $finally_enter_ref_return(pstate, porigin, porigin, poperand, int, ptask*) : pstate
def $finally_enter_ref_return(S, porigin, porigin_source, poperand, z, ptask_tail*) = S[.TODO = $statement_tasks(statement*, $origin_child((porigin_final), [PCFIELD 0]), 0) ++ [FINALLY_REF_RETURN porigin porigin_source poperand z, FINALLY_PHASE porigin 3] ++ ptask_tail*][.ORIGIN = (porigin_final)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if $origin_child((porigin), [PCFIELD 2]) = (porigin_final)
  -- if $origin_node(S.SOURCES, porigin_final) = (NStmtFinally (SEQUENCE statement*) metadata)
dec $finally_enter_jump(pstate, porigin, porigin, nat, nat, bool, ptask*) : pstate
def $finally_enter_jump(S, porigin, porigin_source, n_depth, n_original, b_continue, ptask_tail*) = S[.TODO = $statement_tasks(statement*, $origin_child((porigin_final), [PCFIELD 0]), 0) ++ [FINALLY_JUMP porigin porigin_source n_depth n_original b_continue, FINALLY_PHASE porigin 4] ++ ptask_tail*][.ORIGIN = (porigin_final)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if $origin_child((porigin), [PCFIELD 2]) = (porigin_final)
  -- if $origin_node(S.SOURCES, porigin_final) = (NStmtFinally (SEQUENCE statement*) metadata)
dec $finally_enter_goto(pstate, porigin, porigin, pcpath, ptask*) : pstate
def $finally_enter_goto(S, porigin, porigin_source, pcpath_target, ptask_tail*) = S[.TODO = $statement_tasks(statement*, $origin_child((porigin_final), [PCFIELD 0]), 0) ++ [FINALLY_GOTO porigin porigin_source pcpath_source pcpath_target, FINALLY_PHASE porigin 5] ++ ptask_tail*][.ORIGIN = (porigin_final)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if porigin_source = PORIGIN n pcpath_source
  -- if $origin_child((porigin), [PCFIELD 2]) = (porigin_final)
  -- if $origin_node(S.SOURCES, porigin_final) = (NStmtFinally (SEQUENCE statement*) metadata)

dec $finally_leave(pstate, porigin, ptask*) : pstate
dec $finally_leave_return(pstate, porigin, porigin, poperand, ptask*) : pstate
def $finally_leave(S, porigin, (FINALLY_PHASE porigin n_phase) :: (ORIGIN_RETURN porigin_outer?) :: ptask_tail*) = $return_discard(S[.TODO = ptask_tail*][.ORIGIN = (porigin)], ORIGIN_RETURN porigin_outer?)
def $finally_leave(S, porigin, (FINALLY_PHASE porigin n_phase) :: (REF_REPLAY_ORIGIN porigin_source z prefowner*) :: ptask_tail*) = $return_discard(S[.TODO = ptask_tail*][.ORIGIN = (porigin)], REF_REPLAY_ORIGIN porigin_source z prefowner*)
def $finally_leave(S, porigin, ptask_tail*) = S[.COMPLETION = UNSUPPORTED "invalid finally continuation"] -- otherwise
dec $finally_leave_throw(pstate, porigin, nat, ptask*) : pstate
def $finally_leave_throw(S, porigin, n, ptask_tail*) = S_left[.TODO = (THROW_SEARCH n) :: S_left.TODO][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S_left = $finally_leave(S, porigin, ptask_tail*)
def $finally_leave_return(S, porigin, porigin_source, poperand, ptask_tail*) = S_left[.TODO = (RETURN_UNWIND poperand (porigin_source)) :: S_left.TODO][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S_left = $finally_leave(S, porigin, ptask_tail*)
dec $finally_leave_ref_return(pstate, porigin, porigin, poperand, int, bool, ptask*) : pstate
def $finally_leave_ref_return(S, porigin, porigin_source, poperand, z, b_finalized, ptask_tail*) = S_left[.TODO = (RETURN_REF_UNWIND poperand z true porigin_source) :: $ref_recheck_tail(S_left, porigin, porigin_source, poperand, z, S_left.TODO)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S_left = $finally_leave(S, porigin, ptask_tail*)

;; The first completed protected finalizer leaves one witness at the end of
;; this call's continuation. Later finalizers retain it; an overriding return
;; replaces the old transfer and removes its witness.
dec $ref_recheck_owner(ptask*, porigin, poperand, int) : porigin?
dec $ref_recheck_same(ptask, porigin, poperand, int) : bool
def $ref_recheck_same(REF_RECHECK porigin_source porigin poperand z, porigin_source, poperand, z) = true
def $ref_recheck_same(ptask, porigin_source, poperand, z) = false -- otherwise
def $ref_recheck_owner(eps, porigin_source, poperand, z) = eps
def $ref_recheck_owner((REF_RECHECK porigin_source porigin poperand z) :: ptask_tail*, porigin_source, poperand, z) = (porigin)
def $ref_recheck_owner(ptask :: ptask_tail*, porigin_source, poperand, z) = $ref_recheck_owner(ptask_tail*, porigin_source, poperand, z)
  -- if ~$ref_recheck_same(ptask, porigin_source, poperand, z)
dec $ref_recheck_clean(ptask*) : ptask*
dec $ref_recheck_marker(ptask) : bool
def $ref_recheck_marker(REF_RECHECK porigin_source porigin poperand z) = true
def $ref_recheck_marker(REF_REPLAY porigin_source poperand z prefowner_tail*) = true
def $ref_recheck_marker(ptask) = false -- otherwise
def $ref_recheck_clean(eps) = eps
def $ref_recheck_clean((REF_RECHECK porigin_source porigin poperand z) :: ptask_tail*) = $ref_recheck_clean(ptask_tail*)
def $ref_recheck_clean((REF_REPLAY porigin_source poperand z prefowner_tail*) :: ptask_tail*) = $ref_recheck_clean(ptask_tail*)
def $ref_recheck_clean(ptask :: ptask_tail*) = ptask :: $ref_recheck_clean(ptask_tail*)
  -- if ~$ref_recheck_marker(ptask)
def $ref_recheck_tail(S, porigin, porigin_source, poperand, z, ptask_tail*) = $ref_recheck_clean(ptask_tail*) ++ [REF_RECHECK porigin_source porigin_first poperand z]
  -- if $ref_recheck_owner(ptask_tail*, porigin_source, poperand, z) = (porigin_first)
def $ref_recheck_tail(S, porigin, porigin_source, poperand, z, ptask_tail*) = $ref_recheck_clean(ptask_tail*) ++ [REF_RECHECK porigin_source porigin poperand z]
  -- if $ref_recheck_owner(ptask_tail*, porigin_source, poperand, z) = eps
  -- if $finally_source_inside(S, porigin, porigin_source)
def $ref_recheck_tail(S, porigin, porigin_source, poperand, z, ptask_tail*) = $ref_recheck_clean(ptask_tail*)
  -- if $ref_recheck_owner(ptask_tail*, porigin_source, poperand, z) = eps
  -- if ~$finally_source_inside(S, porigin, porigin_source)
;; A completed return carries its already evaluated operand through each
;; finalizer. A return inside that finalizer discards the older transfer.
def $finally_transfer_marker(S, TRY_END porigin) = $finally_present(S, porigin)
def $finally_transfer_marker(S, FINALLY_ONLY porigin) = true
def $finally_transfer_marker(S, FINALLY_RESUME porigin n?) = true
def $finally_transfer_marker(S, FINALLY_RETURN porigin porigin_source poperand) = true
def $finally_transfer_marker(S, FINALLY_REF_RETURN porigin porigin_source poperand z) = true
def $finally_transfer_marker(S, FINALLY_JUMP porigin porigin_source n_depth n_original b_continue) = true
def $finally_transfer_marker(S, FINALLY_GOTO porigin porigin_source pcpath_source pcpath_target) = true
def $finally_transfer_marker(S, ptask) = false -- otherwise
def $return_step(S, poperand, (porigin_source), (TRY_END porigin) :: ptask_tail*) = $finally_enter_return(S, porigin, porigin_source, poperand, ptask_tail*)
  -- if $finally_present(S, porigin)
def $return_step(S, poperand, (porigin_source), (FINALLY_ONLY porigin) :: ptask_tail*) = $finally_enter_return(S, porigin, porigin_source, poperand, ptask_tail*)
def $return_step(S, poperand, (porigin_source), (FINALLY_RESUME porigin n?) :: ptask_tail*) = $finally_leave_return(S, porigin, porigin_source, poperand, ptask_tail*)
def $return_step(S, poperand, (porigin_source), (FINALLY_RETURN porigin porigin_old poperand_old) :: ptask_tail*) = $finally_leave_return(S, porigin, porigin_source, poperand, ptask_tail*)
def $return_step(S, poperand, (porigin_source), (FINALLY_REF_RETURN porigin porigin_old poperand_old z_old) :: ptask_tail*) = $finally_leave_return(S, porigin, porigin_source, poperand, ptask_tail*)
def $return_step(S, poperand, (porigin_source), (FINALLY_JUMP porigin porigin_old n_depth n_original b_continue) :: ptask_tail*) = $finally_leave_return(S, porigin, porigin_source, poperand, ptask_tail*)
def $return_step(S, poperand, (porigin_source), (FINALLY_GOTO porigin porigin_old pcpath_old pcpath_target) :: ptask_tail*) = $finally_leave_return(S, porigin, porigin_source, poperand, ptask_tail*)

dec $finally_ref_result(pstate, poperand) : poperand
def $finally_ref_result(S, poperand) = poperand -- if $reference_return_used(S)
def $finally_ref_result(S, poperand) = KNOWN PNULL -- if ~$reference_return_used(S)
dec $finally_ref_recheck(pstate, poperand, int) : pstate
def $finally_ref_recheck(S, poperand, z) = S_checked
  -- if S_checked = $typed_return_checked($resolve_at(S, poperand, z), z, $typed_reference_operand_source(S, poperand))
  -- if S_checked.COMPLETION =/= NORMAL
def $finally_ref_recheck(S, poperand, z) = $reference_return_write_operand(S_checked, poperand, pvalue_original, pvalue)
  -- if S_input = $resolve_at(S, poperand, z)
  -- if S_input.RESULT = KNOWN pvalue_original
  -- if S_checked = $typed_return_checked(S_input, z, $typed_reference_operand_source(S, poperand))
  -- if S_checked.COMPLETION = NORMAL
  -- if S_checked.RESULT = KNOWN pvalue
dec $ref_replay_filter(pstate, nat, pcpath*, porigin) : porigin*
def $ref_replay_filter(S, n, eps, porigin_source) = eps
def $ref_replay_filter(S, n, pcpath_try :: pcpath_tail*, porigin_source) = $ref_replay_filter(S, n, pcpath_tail*, porigin_source) ++ [PORIGIN n pcpath_try]
  -- if $finally_source_inside(S, PORIGIN n pcpath_try, porigin_source)
def $ref_replay_filter(S, n, pcpath_try :: pcpath_tail*, porigin_source) = $ref_replay_filter(S, n, pcpath_tail*, porigin_source)
  -- if ~$finally_source_inside(S, PORIGIN n pcpath_try, porigin_source)
def $ref_replay_owners(S, PORIGIN n pcpath_source) = $ref_replay_filter(S, n, $ppfinally_protected(pcunit.OCCURRENCES, pcpath_source), PORIGIN n pcpath_source)
  -- if $source_unit(S.SOURCES, n) = (pcunit)
dec $ref_replay_context_paths(pstate, nat, pcpath, pcpath) : prefowner*
dec $ref_context_kind(pstate, nat, pcpath, pcpath) : prefowner?
def $ref_context_kind(S, n, pcpath_source, pcpath_current) = (REPLAY_TRY (PORIGIN n pcpath_current))
  -- if $throwable_try_valid(S, PORIGIN n pcpath_current)
  -- if $effect_below(pcpath_current ++ [PCFIELD 0], pcpath_source)
def $ref_context_kind(S, n, pcpath_source, pcpath_current) = (REPLAY_CATCH (PORIGIN n pcpath_current))
  -- if $finally_present(S, PORIGIN n pcpath_current)
  -- if $effect_below(pcpath_current ++ [PCFIELD 1], pcpath_source)
def $ref_context_kind(S, n, pcpath_source, pcpath_current) = eps -- otherwise
def $ref_replay_context_paths(S, n, pcpath_source, eps) = eps
def $ref_replay_context_paths(S, n, pcpath_source, pcpath_current) = eps
  -- if $source_unit(S.SOURCES, n) = (pcunit)
  -- if $ppfinally_scope_node(pcunit.OCCURRENCES, pcpath_current)
def $ref_replay_context_paths(S, n, pcpath_source, pcpath_current) = [prefowner] ++ $ref_replay_context_paths(S, n, pcpath_source, pcpath_current[0:n_parent])
  -- if $(|pcpath_current| > 0)
  -- if n_parent = $(|pcpath_current| - 1)
  -- if $source_unit(S.SOURCES, n) = (pcunit)
  -- if ~$ppfinally_scope_node(pcunit.OCCURRENCES, pcpath_current)
  -- if $ref_context_kind(S, n, pcpath_source, pcpath_current) = (prefowner)
def $ref_replay_context_paths(S, n, pcpath_source, pcpath_current) = $ref_replay_context_paths(S, n, pcpath_source, pcpath_current[0:n_parent])
  -- if $(|pcpath_current| > 0)
  -- if n_parent = $(|pcpath_current| - 1)
  -- if $source_unit(S.SOURCES, n) = (pcunit)
  -- if ~$ppfinally_scope_node(pcunit.OCCURRENCES, pcpath_current)
  -- if $ref_context_kind(S, n, pcpath_source, pcpath_current) = eps
dec $ref_replay_contexts(pstate, porigin) : prefowner*
def $ref_replay_contexts(S, PORIGIN n pcpath_source) = $ref_replay_context_paths(S, n, pcpath_source, pcpath_source)
def $ref_recheck_throw_producer(S, S_next) = true
  -- if S.TODO = (RETURN_REF_UNWIND poperand z true porigin_source) :: (REF_RECHECK porigin_source porigin_first poperand z) :: eps
  -- if $ref_replay_owners(S, porigin_source) = porigin_first :: porigin_owner_tail*
  -- if $throwable_pending(S_next.COMPLETION)
  -- if S_next.FRAMES = S.FRAMES
  -- if S_next.CURRENT = S.CURRENT
def $ref_recheck_throw_producer(S, S_next) = false -- otherwise
def $throwable_continuation(S, S_next) = S_next[.TODO = (REF_REPLAY porigin_source poperand z prefowner*) :: eps]
  -- if $ref_recheck_throw_producer(S, S_next)
  -- if S.TODO = (RETURN_REF_UNWIND poperand z true porigin_source) :: (REF_RECHECK porigin_source porigin_first poperand z) :: eps
  -- if prefowner* = $ref_replay_contexts(S, porigin_source)
dec $ref_owner_origin(prefowner) : porigin
def $ref_owner_origin(REPLAY_TRY porigin) = porigin
def $ref_owner_origin(REPLAY_CATCH porigin) = porigin
dec $ref_replay_tasks(porigin, int, prefowner*) : ptask*
def $ref_replay_tasks(porigin_source, z, eps) = eps
def $ref_replay_tasks(porigin_source, z, (REPLAY_TRY porigin) :: prefowner_tail*) = [TRY_END porigin, REF_REPLAY_ORIGIN porigin_source z ((REPLAY_TRY porigin) :: prefowner_tail*), REF_REPLAY_PHASE porigin_source z ((REPLAY_TRY porigin) :: prefowner_tail*)] ++ $ref_replay_tasks(porigin_source, z, prefowner_tail*)
def $ref_replay_tasks(porigin_source, z, (REPLAY_CATCH porigin) :: prefowner_tail*) = [FINALLY_ONLY porigin, REF_REPLAY_ORIGIN porigin_source z ((REPLAY_CATCH porigin) :: prefowner_tail*), REF_REPLAY_PHASE porigin_source z ((REPLAY_CATCH porigin) :: prefowner_tail*)] ++ $ref_replay_tasks(porigin_source, z, prefowner_tail*)
dec $ref_recheck_task(ptask) : bool
def $ref_recheck_task(REF_RECHECK porigin_source porigin_first poperand z) = true
def $ref_recheck_task(ptask) = false -- otherwise

dec $return_ref_step(pstate, poperand, int, bool, porigin, ptask*) : pstate
def $return_ref_step(S, poperand, z, b, porigin_source, (TRY_END porigin) :: ptask_tail*) = $finally_enter_ref_return(S, porigin, porigin_source, poperand, z, ptask_tail*)
  -- if $finally_present(S, porigin)
def $return_ref_step(S, poperand, z, b, porigin_source, (FINALLY_ONLY porigin) :: ptask_tail*) = $finally_enter_ref_return(S, porigin, porigin_source, poperand, z, ptask_tail*)
def $return_ref_step(S, poperand, z, b, porigin_source, (FINALLY_RESUME porigin n?) :: ptask_tail*) = $finally_leave_ref_return(S, porigin, porigin_source, poperand, z, b, ptask_tail*)
def $return_ref_step(S, poperand, z, b, porigin_source, (FINALLY_RETURN porigin porigin_old poperand_old) :: ptask_tail*) = $finally_leave_ref_return(S, porigin, porigin_source, poperand, z, b, ptask_tail*)
def $return_ref_step(S, poperand, z, b, porigin_source, (FINALLY_REF_RETURN porigin porigin_old poperand_old z_old) :: ptask_tail*) = $finally_leave_ref_return(S, porigin, porigin_source, poperand, z, b, ptask_tail*)
def $return_ref_step(S, poperand, z, b, porigin_source, (FINALLY_JUMP porigin porigin_old n_depth n_original b_continue) :: ptask_tail*) = $finally_leave_ref_return(S, porigin, porigin_source, poperand, z, b, ptask_tail*)
def $return_ref_step(S, poperand, z, b, porigin_source, (FINALLY_GOTO porigin porigin_old pcpath_old pcpath_target) :: ptask_tail*) = $finally_leave_ref_return(S, porigin, porigin_source, poperand, z, b, ptask_tail*)
def $return_ref_step(S, poperand, z, b, porigin_source, ptask :: ptask_tail*) = $return_discard(S[.TODO = (RETURN_REF_UNWIND poperand z b porigin_source) :: ptask_tail*], ptask)
  -- if ~$finally_transfer_marker(S, ptask)
  -- if ~$ref_recheck_task(ptask)
def $return_ref_step(S, poperand, z, false, porigin_source, eps) = $return_step(S, poperand, (porigin_source), eps)
def $return_ref_step(S, poperand, z, true, porigin_source, (REF_RECHECK porigin_source porigin_first poperand z) :: eps) = $return_step(S_checked, $finally_ref_result(S_checked, poperand), (porigin_source), eps)
  -- if S_checked = $finally_ref_recheck(S, poperand, z)
  -- if S_checked.COMPLETION = NORMAL
def $return_ref_step(S, poperand, z, true, porigin_source, (REF_RECHECK porigin_source porigin_first poperand z) :: eps) = S_checked
  -- if S_checked = $finally_ref_recheck(S, poperand, z)
  -- if S_checked.COMPLETION =/= NORMAL
def $return_ref_step(S, poperand, z, true, porigin_source, eps) = $return_step(S_checked, $finally_ref_result(S_checked, poperand), (porigin_source), eps)
  -- if S_checked = $finally_ref_recheck(S, poperand, z)
  -- if S_checked.COMPLETION = NORMAL
