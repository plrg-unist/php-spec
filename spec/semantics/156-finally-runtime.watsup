dec $ref_replay_valid(pstate, porigin, poperand, int, prefowner*) : bool
def $ref_replay_valid(S, porigin_source, poperand, z, prefowner*) = ($goto_scope_valid(S, porigin_source) /\ ($reference_return_source(S[.ORIGIN = (porigin_source)], z) \/ $reference_return_null_valid(S[.ORIGIN = (porigin_source)], z)) /\ $finally_return_operand_valid(S, poperand) /\ prefowner* = $ref_replay_contexts(S, porigin_source) /\ prefowner* =/= eps /\ $throwable_live(S, n) /\ pthrowable.KIND = "TypeError")
