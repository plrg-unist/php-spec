def $ref_replay_outer(prefowner :: prefowner_next :: prefowner_tail*) = ($ref_owner_origin(prefowner_next))
def $ref_replay_outer(prefowner :: eps) = $goto_prior_origin($ref_owner_origin(prefowner))
