def $finally_outcome_phase(eps) = 0
def $finally_outcome_phase((n)) = 1
def $finally_enter(S, porigin, n_old?, ptask_tail*) = S[.TODO = $statement_tasks(statement*, $origin_child((porigin_final), [PCFIELD 0]), 0) ++ [FINALLY_RESUME porigin n_old?, FINALLY_PHASE porigin $finally_outcome_phase(n_old?)] ++ ptask_tail*][.ORIGIN = (porigin_final)]
