def $ref_consumed_tasks(prefreturncursor) = [ORIGIN_RETURN $origin_child((prefreturncursor.OWNER), [PCFIELD 2]), FINALLY_REF_CONSUMED prefreturncursor, FINALLY_PHASE prefreturncursor.OWNER 3, ORIGIN_RETURN prefreturncursor.OUTER]
