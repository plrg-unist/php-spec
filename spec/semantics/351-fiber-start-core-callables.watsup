dec $fiber_start_core_trace(pstate, pfiberstart) : ptraceframe*
dec $fiber_start_core_invoke(pstate, pfiberstart) : pstate
def $fiber_start_core_trace(S, pfiberstart) = [{FILE eps, LINE $(-1), FUNCTION $ptascii("start"), CLASS ($ptascii("Fiber")), TYPE ($ptascii("->")), ARGS $fiber_api_trace_args(S, pfiberapi), HASARGS true}]
  -- if pfiberapi = {SITE pfiberstart.SITE, OBJECT pfiberstart.OBJECT, KIND eps, START (pfiberstart.SENT), SENT eps, LINE pfiberstart.LINE, SEQUENCE S.FIBERSEQ}
def $fiber_start_core_invoke(S, pfiberstart) = $throwable_allocate_at(S_started[.COMPLETION = NORMAL], text, ptbytes, pfiberstart.SITE, z, $source_trace_prefixed(S, $fiber_start_core_trace(S, pfiberstart)))
  -- if S_started = $fiber_start(S, pfiberstart)
  -- if S_started.COMPLETION = THROWN text ptbytes z
def $fiber_start_core_invoke(S, pfiberstart) = S_started
  -- if S_started = $fiber_start(S, pfiberstart)
  -- if S_started.COMPLETION = NORMAL
def $fiber_start_core_invoke(S, pfiberstart) = S_started
  -- if S_started = $fiber_start(S, pfiberstart)
  -- if S_started.COMPLETION = UNSUPPORTED text
rule PhpStep/fiber-start-core-invoke: S ~> $fiber_start_core_invoke(S, pfiberstart)
