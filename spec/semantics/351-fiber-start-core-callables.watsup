def $call_task_valid(S, FIBER_START_CORE_INVOKE n_runner n_capture pfiberstart) = $fiber_start_core_result_valid(S, n_runner, n_capture, pfiberstart)
def $call_task_valid(S, FIBER_START_CORE_RESULT n_runner n_capture pfiberstart) = $fiber_start_core_result_valid(S, n_runner, n_capture, pfiberstart)
