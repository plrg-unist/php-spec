;; Fiber::start forwards zend_call_function's copied variadic/named args.
;; RAW and the result tail own the Closure; only the handler/API owns the copy.
dec $fiber_start_core_live(pstate, nat) : bool
dec $fiber_start_core_actor(pstate) : bool
def $fiber_start_core_live(S, n) = true
  -- if $fiber_capture_live(S, n)
  -- if S.OBJECTS[n] = FIBERAPICLOSURE pfibercapture
  -- if pfibercapture.KIND = INTRINSIC_FIBER_START
def $fiber_start_core_live(S, n) = false -- otherwise
def $fiber_start_core_actor(S) = true
  -- if S.ACTIVEFIBER = (n_runner)
  -- if $fiber_at(S, n_runner) = (pfiber)
  -- if pfiber.RAW = POBJECT n_capture
  -- if pfiber.TARGET = (FIBER_API_TARGET n_capture)
  -- if $fiber_start_core_live(S, n_capture)
def $fiber_start_core_actor(S) = false -- otherwise
def $fiber_callback_resolution(S, POBJECT n) = HANDLERRESOLVED (FIBER_API_TARGET n)
  -- if $fiber_start_core_live(S, n)
def $fiber_cached_target_valid(S, pfiber) = true
  -- if pfiber.RAW = POBJECT n
  -- if pfiber.TARGET = (FIBER_API_TARGET n)
  -- if $fiber_start_core_live(S, n)
def $fiber_receive_value(S, pconfigcall, POBJECT n_capture) = $fiber_done($fiber_put(S_birth, n, pfiber[.READY = true][.CALL = (pconfigcall)][.RAW = POBJECT n_capture][.TARGET = (FIBER_API_TARGET n_capture)][.BIRTH = $dynamic_new_find(S, S.TODO, pconfigcall.SITE)][.CAPTURE = $consumer_capture_current(S, pconfigcall.SITE)][.PRODUCER = $consumer_producer_current(S)]), PNULL)
  -- if pconfigcall.KIND = INTRINSIC_FIBER_CONSTRUCT
  -- if $fiber_start_core_live(S, n_capture)
  -- if pconfigcall.OWNER = (n)
  -- if $fiber_at(S, n) = (pfiber)
  -- if ~pfiber.READY
  -- if S_birth = $consumer_clone_birth_record(S, pconfigcall, n)

