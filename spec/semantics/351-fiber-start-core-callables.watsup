def $task_nodes(FIBER_START_CORE_INVOKE n_runner n_capture pfiberstart) = $named_slots_roots(pfiberstart.SENT.SLOTS) ++ $named_roots(pfiberstart.SENT.NAMED)
def $task_nodes(FIBER_START_CORE_RESULT n_runner n_capture pfiberstart) = [HOBJECT n_capture]
def $fiber_caller_api_nodes(pfibercaller) = $named_slots_roots(pfiberstart.SENT.SLOTS) ++ $named_roots(pfiberstart.SENT.NAMED)
  -- if pfiberapi = pfibercaller.API
  -- if pfibercaller.VM.TODO = (FIBER_WAIT pfiberapi) :: (FIBER_START_CORE_RESULT n_runner n_capture pfiberstart) :: ptask_tail*
