  -- if S.ARRAYS[n_array].ITEMS = penumqueryinput.ITEMS
  -- if $enum_is_callable_input_label(S, penumqueryinput.VALUES) = penumqueryinput.VALUE
def $enum_is_callable_input_source(S, penumqueryinput) = false -- otherwise

;; SEND_VAL transfers a temporary array, SEND_VAR transfers a returned value,
;; and SEND_VAR for a CV copies its dereferenced value. Resolving these operands
;; gives the ordinary SENT owner; the receipt never needs an extra pin.
dec $enum_is_callable_array_operand(pstate, poperand) : nat?
def $enum_is_callable_array_operand(S, KNOWN (PARRAY n_array)) = (n_array)
def $enum_is_callable_array_operand(S, VARIABLE n_name* z) = (n_array)
  -- if ~$environment_blocked(S, n_name*)
