;; User enum descriptors are ordinary nominal declarations with real case
;; constants. Singleton objects use the existing permanent constant-cache roots.

def $enum_backing(S, porigin) = $enum_backing_node(phpType50)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if pclassdesc.KIND = "enum"
  -- if $origin_node(S.SOURCES, porigin) = (NStmtEnum phpType14 phpType3 phpType50 phpType42 phpType23 metadata)
