  -- if $enum_is_callable_input_source(S, penumqueryinput)
def $enum_is_callable_capture(S, pconfigcall) = eps -- otherwise
def $enum_is_callable_capture_argument(S, pconfigcall) = ($enum_is_callable_capture(S, pconfigcall) =/= eps)

dec $enum_is_callable_input_match(pstate, penumqueryinput, pvalue) : bool
def $enum_is_callable_input_match(S, penumqueryinput, pvalue_input) = ($string_bytes(pvalue_input) = (penumqueryinput.VALUE))
