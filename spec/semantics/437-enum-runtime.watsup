  -- if S.STORE[n_cell] = DEFINED pvalue_input
  -- if $propref_at(S.PROPREFS, n_cell) = eps /\ $reference_coercion_at(S.REFCOERCIONS, n_cell) = eps
  -- if ~$foreach_released_cell(S, n_cell)
  -- if $enum_array_string_valid(S, pvalue_input)
  -- if $string_bytes(pvalue_input) = (ptbytes_input)
  -- if n_depth = |S.FRAMES|
  -- if penumqueryinput = {CALL pconfigcall, ARGUMENT porigin_target, LINE z_target, DEPTH n_depth, VALUE ptbytes_input, ARRAY eps, ITEMS eps, VALUES eps}
  -- if $enum_is_callable_input_source(S, penumqueryinput)
def $enum_is_callable_capture(S, pconfigcall) = (penumqueryinput)
  -- if $intrinsic_argument(S, pconfigcall.SITE, 0) = ((expression, false, eps, porigin_target, z_target))
