  -- if $enum_is_callable_target(S, PSTRING penumqueryinput.VALUE) = ((porigin_class, ptbytes_method, false))
def $enum_is_callable_input_source(S, penumqueryinput) = true
  -- if pconfigcall = penumqueryinput.CALL
  -- if pconfigcall.KIND = INTRINSIC_IS_CALLABLE /\ pconfigcall.INDEX = 0
  -- if pconfigcall.SENT = eps /\ pconfigcall.PACKS = eps /\ ~pconfigcall.NAMED
