  -- if $class_named(S.CLASSNAMES, $ptlc($typed_callable_name(ptbytes_class))) = (porigin_class)
  -- if $class_at(S.CLASSES, porigin_class) = (pclassdesc)
  -- if pclassdesc.KIND = "enum"
def $enum_is_callable_target(S, PARRAY n) = ((porigin_class, ptbytes_method, b_case))
  -- if $(n < |S.ARRAYS|) /\ (HARRAY n) <- S.ALLOCATIONS
  -- if $typed_callback_array(S, n)
  -- if S.ARRAYS[n] = parray
  -- if $entry_lookup(parray.ITEMS, KINT 0) = (pitem_receiver)
  -- if $entry_lookup(parray.ITEMS, KINT 1) = (pitem_method)
  -- if $enum_is_callable_receiver(S, $entry_value(S, pitem_receiver)) = ((porigin_class, b_case))
  -- if $enum_array_string_valid(S, $entry_value(S, pitem_method))
  -- if $string_bytes($entry_value(S, pitem_method)) = (ptbytes_method)
def $enum_is_callable_target(S, pvalue) = eps -- otherwise

;; SENT owns the original table and its reference cells. A borrowed member
;; snapshot fixes DIRECT slots, while a genuine ALIAS may change its payload.
dec $enum_is_callable_member_snapshot(pstate, pitem, pvalue) : bool
def $enum_is_callable_member_snapshot(S, DIRECT pvalue, pvalue) = true
  -- if pvalue =/= PUNDEFINED
def $enum_is_callable_member_snapshot(S, ALIAS n_cell, pvalue_saved) = true
  -- if $call_reference_operand_valid(S, REFERENCE n_cell)
  -- if S.STORE[n_cell] = DEFINED pvalue_current
  -- if pvalue_current =/= PUNDEFINED
  -- if $propref_at(S.PROPREFS, n_cell) = eps /\ $reference_coercion_at(S.REFCOERCIONS, n_cell) = eps
  -- if $parameter_backing_at(S.PARAMETERBACKINGS, n_cell) = eps /\ $container_init_at(S.CONTAINERINITS, n_cell) = eps
  -- if ~(n_cell <- S.LITERALREFRETAINED) /\ ~(n_cell <- S.LITERALREFDEBTS)
  -- if ~$foreach_released_cell(S, n_cell)
def $enum_is_callable_member_snapshot(S, pitem, pvalue) = false -- otherwise
dec $enum_is_callable_member_live(pstate, pitem) : bool
def $enum_is_callable_member_live(S, DIRECT pvalue) = true
  -- if pvalue =/= PUNDEFINED
def $enum_is_callable_member_live(S, ALIAS n_cell) = $enum_is_callable_member_snapshot(S, ALIAS n_cell, PNULL)
def $enum_is_callable_member_live(S, pitem) = false -- otherwise

;; Wrong length or keys are decided without reading member values. Reference
;; identity must remain genuine, but a shape-only query needs no typed-source
;; coercion or callable admission for the referenced payload.
dec $enum_is_callable_bad_shape(pentry*) : bool
def $enum_is_callable_bad_shape(pentry*) = (|pentry*| =/= 2 \/ $entry_lookup(pentry*, KINT 0) = eps \/ $entry_lookup(pentry*, KINT 1) = eps)
dec $enum_is_callable_raw_item(pstate, pitem) : bool
def $enum_is_callable_raw_item(S, DIRECT pvalue) = (pvalue =/= PUNDEFINED)
def $enum_is_callable_raw_item(S, ALIAS n_cell) = true
  -- if $call_reference_operand_valid(S, REFERENCE n_cell)
  -- if S.STORE[n_cell] = DEFINED pvalue
  -- if pvalue =/= PUNDEFINED
def $enum_is_callable_raw_item(S, pitem) = false -- otherwise
dec $enum_is_callable_raw_items(pstate, pentry*) : bool
def $enum_is_callable_raw_items(S, eps) = true
def $enum_is_callable_raw_items(S, (ENTRY pkey pitem) :: pentry_tail*) = ($enum_is_callable_raw_item(S, pitem) /\ $enum_is_callable_raw_items(S, pentry_tail*))
dec $enum_is_callable_bad_array(pstate, nat) : bool
def $enum_is_callable_bad_array(S, n) = true
  -- if $(n < |S.ARRAYS|) /\ (HARRAY n) <- S.ALLOCATIONS
  -- if $enum_is_callable_bad_shape(S.ARRAYS[n].ITEMS)
  -- if $enum_is_callable_raw_items(S, S.ARRAYS[n].ITEMS)
def $enum_is_callable_bad_array(S, n) = false -- otherwise

dec $enum_is_callable_array_snapshot(pstate, nat, pvalue*) : bool
def $enum_is_callable_array_snapshot(S, n, [pvalue_receiver, pvalue_method]) = true
  -- if $(n < |S.ARRAYS|) /\ (HARRAY n) <- S.ALLOCATIONS
  -- if |S.ARRAYS[n].ITEMS| = 2
  -- if $entry_lookup(S.ARRAYS[n].ITEMS, KINT 0) = (pitem_receiver)
  -- if $entry_lookup(S.ARRAYS[n].ITEMS, KINT 1) = (pitem_method)
  -- if $enum_is_callable_member_snapshot(S, pitem_receiver, pvalue_receiver)
  -- if $enum_is_callable_member_snapshot(S, pitem_method, pvalue_method)
def $enum_is_callable_array_snapshot(S, n, eps) = $enum_is_callable_bad_array(S, n)
def $enum_is_callable_array_snapshot(S, n, pvalue*) = false -- otherwise
dec $enum_is_callable_array_values(pstate, nat) : pvalue*?
def $enum_is_callable_array_values(S, n) = ([pvalue_receiver, pvalue_method])
  -- if $(n < |S.ARRAYS|) /\ (HARRAY n) <- S.ALLOCATIONS
  -- if |S.ARRAYS[n].ITEMS| = 2
  -- if $entry_lookup(S.ARRAYS[n].ITEMS, KINT 0) = (pitem_receiver)
  -- if $entry_lookup(S.ARRAYS[n].ITEMS, KINT 1) = (pitem_method)
  -- if $enum_is_callable_member_live(S, pitem_receiver)
  -- if $enum_is_callable_member_live(S, pitem_method)
  -- if pvalue_receiver = $entry_value(S, pitem_receiver)
  -- if pvalue_method = $entry_value(S, pitem_method)
  -- if $enum_is_callable_array_snapshot(S, n, [pvalue_receiver, pvalue_method])
def $enum_is_callable_array_values(S, n) = (eps)
  -- if $enum_is_callable_bad_array(S, n)
def $enum_is_callable_array_values(S, n) = eps -- otherwise
;; A receipt label describes only the saved bytes or cached case identity. It
;; performs no class lookup and never decides whether the eventual query is
;; callable. Other saved payloads may already be retired when it is checked.
dec $enum_is_callable_input_label(pstate, pvalue*) : ptbytes
def $enum_is_callable_input_label(S, [pvalue_receiver, pvalue_method]) = ptbytes_receiver ++ $ptascii("::") ++ ptbytes_method
  -- if $enum_array_string_valid(S, pvalue_receiver) /\ $enum_array_string_valid(S, pvalue_method)
  -- if $string_bytes(pvalue_receiver) = (ptbytes_receiver)
  -- if $string_bytes(pvalue_method) = (ptbytes_method)
def $enum_is_callable_input_label(S, [POBJECT n_case, pvalue_method]) = pclassdesc.NAME ++ $ptascii("::") ++ ptbytes_method
  -- if $enum_array_string_valid(S, pvalue_method)
  -- if $string_bytes(pvalue_method) = (ptbytes_method)
  -- if $enum_case_object(S, n_case) = (pclassconstantdesc)
  -- if $class_at(S.CLASSES, pclassconstantdesc.OWNER) = (pclassdesc)
  -- if pclassdesc.KIND = "enum"
def $enum_is_callable_input_label(S, pvalue*) = eps -- otherwise

dec $enum_is_callable_pair_invalid(pvalue*) : bool
def $enum_is_callable_pair_invalid([pvalue_receiver, pvalue_method]) = (~$typed_callback_receiver(pvalue_receiver) \/ ~$typed_string_value(pvalue_method))
def $enum_is_callable_pair_invalid(pvalue*) = false -- otherwise

dec $enum_is_callable_pair_name(pstate, pvalue*) : ptbytes?
def $enum_is_callable_pair_name(S, [pvalue_receiver, pvalue_method]) = (ptbytes_receiver ++ $ptascii("::") ++ ptbytes_method)
  -- if $enum_is_callable_receiver(S, pvalue_receiver) = ((porigin_class, false))
  -- if $enum_array_string_valid(S, pvalue_receiver)
  -- if $string_bytes(pvalue_receiver) = (ptbytes_receiver)
  -- if $enum_array_string_valid(S, pvalue_method)
  -- if $string_bytes(pvalue_method) = (ptbytes_method)
def $enum_is_callable_pair_name(S, [POBJECT n_case, pvalue_method]) = (pclassdesc.NAME ++ $ptascii("::") ++ ptbytes_method)
  -- if $enum_is_callable_receiver(S, POBJECT n_case) = ((porigin_class, true))
  -- if $class_at(S.CLASSES, porigin_class) = (pclassdesc)
  -- if $enum_array_string_valid(S, pvalue_method)
  -- if $string_bytes(pvalue_method) = (ptbytes_method)
def $enum_is_callable_pair_name(S, pvalue*) = ($ptascii("Array"))
  -- if $enum_is_callable_pair_invalid(pvalue*)
def $enum_is_callable_pair_name(S, pvalue*) = eps -- otherwise

;; The first SEND fixes the array identity, not the payloads of its references.
;; Both snapshots are metadata: the actual argument remains owned in SENT.
dec $enum_is_callable_variable_array_name(pstate, pvalue) : ptbytes?
def $enum_is_callable_variable_array_name(S, PARRAY n) = $enum_is_callable_pair_name(S, [pvalue_receiver, pvalue_method])
  -- if $enum_is_callable_array_values(S, n) = ([pvalue_receiver, pvalue_method])
def $enum_is_callable_variable_array_name(S, PARRAY n) = ($ptascii("Array"))
  -- if $enum_is_callable_bad_array(S, n)
def $enum_is_callable_variable_array_name(S, pvalue) = eps -- otherwise

dec $enum_is_callable_input_source(pstate, penumqueryinput) : bool
def $enum_is_callable_input_source(S, penumqueryinput) = true
  -- if pconfigcall = penumqueryinput.CALL
  -- if pconfigcall.KIND = INTRINSIC_IS_CALLABLE /\ pconfigcall.INDEX = 0
