def $enum_is_callable_capture(S, pconfigcall) = (penumqueryinput)
  -- if $intrinsic_argument(S, pconfigcall.SITE, 0) = ((NExprVariable (BYTES text_target) metadata_target, false, eps, porigin_target, z_target))
