  -- if $intrinsic_argument(S, pconfigcall.SITE, 2) = ((NExprVariable (BYTES text_output) metadata_output, false, eps, porigin_output, z_output))
  -- if $reference_cv(NExprVariable (BYTES text_output) metadata_output) = (n_output*)
  -- if penumqueryinput.ARRAY = (n_array)
