def $enum_forbidden_names() = [$ptascii("__construct"), $ptascii("__destruct"), $ptascii("__clone"), $ptascii("__get"), $ptascii("__set"), $ptascii("__unset"), $ptascii("__isset"), $ptascii("__toString"), $ptascii("__debugInfo"), $ptascii("__serialize"), $ptascii("__unserialize"), $ptascii("__sleep"), $ptascii("__wakeup"), $ptascii("__set_state")]
def $enum_class_verify(S, pclassdesc) = METHOD_ISSUE ($ptascii("Enum ") ++ pclassdesc.NAME ++ $ptascii(" cannot include properties")) pclassdesc.LINE
  -- if pclassdesc.KIND = "enum" /\ ~$enum_verify_properties(pclassdesc.PROPERTIES)
def $enum_class_verify(S, pclassdesc) = METHOD_ISSUE ($ptascii("Enum ") ++ pclassdesc.NAME ++ $ptascii(" cannot include magic method ") ++ ptbytes) pclassdesc.LINE
  -- if pclassdesc.KIND = "enum" /\ $enum_verify_properties(pclassdesc.PROPERTIES)
  -- if $enum_forbidden(S, pclassdesc, $enum_forbidden_names()) = (ptbytes)
def $enum_class_verify(S, pclassdesc) = METHOD_ISSUE ($ptascii("Enum ") ++ pclassdesc.NAME ++ $ptascii(" cannot implement the Serializable interface")) pclassdesc.LINE
  -- if pclassdesc.KIND = "enum" /\ $enum_verify_properties(pclassdesc.PROPERTIES)
  -- if $enum_forbidden(S, pclassdesc, $enum_forbidden_names()) = eps
