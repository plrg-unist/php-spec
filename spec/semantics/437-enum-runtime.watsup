def $enum_class_verify(S, pclassdesc) = METHOD_OK -- otherwise

def $pil_role(pclassdesc) = $ptascii("Enum") -- if pclassdesc.KIND = "enum"
def $enum_implements_issue(S, pclassdesc, ptbytes) = $enum_implements_message("enum", pclassdesc.NAME, $enum_backing(S, pclassdesc.ORIGIN) =/= "", ptbytes_display)
  -- if pclassdesc.KIND = "enum"
  -- if $class_internal_at($class_internal_catalogue(), $ptlc(ptbytes)) = (INTERNAL ptbytes_key ptbytes_display "interface")
def $enum_implicit_header(S, pclassdesc, ptbytes_name, ptbytes_file) = {DECLARATION $pil_signature_method(pclassdesc.NAME, ptbytes_name, ptbytes_file, $pil_enum_signature(ptbytes_name)), SCOPE $pil_scope(S, pclassdesc), STATIC true, VISIBILITY PROPERTY_PUBLIC, ABSTRACT false, TENTATIVE false, ORIGIN eps}
