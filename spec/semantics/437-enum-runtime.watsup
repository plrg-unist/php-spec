  -- if $propref_at(S.PROPREFS, n_cell) = eps /\ $reference_coercion_at(S.REFCOERCIONS, n_cell) = eps
  -- if ~$foreach_released_cell(S, n_cell)
def $enum_is_callable_array_operand(S, REFERENCE n_cell) = (n_array)
  -- if $call_reference_operand_valid(S, REFERENCE n_cell)
  -- if S.STORE[n_cell] = DEFINED (PARRAY n_array)
  -- if $propref_at(S.PROPREFS, n_cell) = eps /\ $reference_coercion_at(S.REFCOERCIONS, n_cell) = eps
  -- if ~$foreach_released_cell(S, n_cell)
def $enum_is_callable_array_operand(S, poperand) = eps -- otherwise

