def $enum_prelink_methods(S, pclassdesc, pmethoddesc :: pmethoddesc_tail*) = METHOD_ISSUE ($ptascii("Cannot redeclare ") ++ pclassdesc.NAME ++ $ptascii("::") ++ pmethoddesc.NAME ++ $ptascii("()")) pclassdesc.LINE
