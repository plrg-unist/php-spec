;; FETCH_DIM_UNSET warns for literal NULL/BOOL/FLOAT, then raises the fixed nested Error.
;; The original string and converted offset are never used after the Warning.
dec $string_unset_warning_literal(expression, pvalue) : bool
def $string_unset_warning_literal(NExprConstFetch (NName (BYTES text_key) metadata_name) metadata, pvalue_key) = (($ptlc($base64(text_key)) = $ptascii("null") /\ pvalue_key = PNULL) \/ ($ptlc($base64(text_key)) = $ptascii("true") /\ pvalue_key = PBOOL true) \/ ($ptlc($base64(text_key)) = $ptascii("false") /\ pvalue_key = PBOOL false))
def $string_unset_warning_literal(NScalarFloat (FLOAT text) metadata, PFLOAT n) = true
  -- if n = $hex_bits(text, 0)
  -- if $(n < 18446744073709551616)
  -- if ~$fparts_nan($float_decode(n))
def $string_unset_warning_literal(NExprUnaryMinus (NScalarFloat (FLOAT text) metadata_float) metadata, PFLOAT n) = true
  -- if n_child = $hex_bits(text, 0)
  -- if $(n_child < 18446744073709551616)
  -- if ~$fparts_nan($float_decode(n_child))
  -- if n = $float_neg(n_child)
def $string_unset_warning_literal(expression, pvalue) = false -- otherwise

