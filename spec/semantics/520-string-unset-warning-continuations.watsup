  -- if $origin_node(S.SOURCES, PORIGIN 0 pcpath) = (NExprArrayDimFetch expression_inner phpType5 metadata_outer)
  -- if expression_inner = NExprArrayDimFetch (NExprVariable (BYTES text_name) metadata_base) expression_key metadata_inner
  -- if n_name* = $base64(text_name)
  -- if $startup_bytes(n_name*) /\ $c_string(n_name*) = n_name*
  -- if $origin_child((PORIGIN 0 pcpath), [PCFIELD 0]) = (porigin_inner)
