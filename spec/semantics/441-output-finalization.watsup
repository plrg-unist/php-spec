def $output_final_exception_ready(S, pobinvoke, n) = false -- otherwise
def $ob_user_result_discard(S, pobinvoke) = S[.TODO = [THROW_SEARCH n, OUTPUT_FINAL_EXCEPTION pobinvoke true, OUTPUT_DRAIN pobdrain]][.ORIGIN = eps][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
