  -- if $throwable_field(S, n, "string") = PSTRING $throwable_chain_string(S, n, [n])
def $output_pending_cause(S, pobdeactivate, n) = false -- otherwise
def $output_pending_valid(S, pobdeactivate) = true
  -- if $output_deactivate_history(S, pobdeactivate)
  -- if pobdeactivate.INDEX = 0
  -- if $output_ids(S.OUTPUTBUFFERS) = $output_ids(pobdeactivate.BUFFERS)
  -- if S.OUTPUTBUFFERS = poutputbuffer :: poutputbuffer_tail*
  -- if $ob_user_buffer_live(pobdeactivate.CALL, poutputbuffer)
  -- if $output_user_buffers_valid(S, S.OUTPUTBUFFERS)
  -- if pobdeactivate.CALL.CALL = OB_FINAL pobdrain
  -- if $heap_subset($operand_nodes(pobdrain.VALUE) ++ $base_nodes(pobdrain.BASE), S.ALLOCATIONS)
def $output_pending_valid(S, pobdeactivate) = false -- otherwise
def $output_pending_tasks(eps, pobdeactivate) = false
def $output_pending_tasks((OUTPUT_FINAL_PENDING pobdeactivate n b) :: eps, pobdeactivate) = true
def $output_pending_tasks(ptask :: ptask_tail*, pobdeactivate) = $output_pending_tasks(ptask_tail*, pobdeactivate)
  -- if ptask_tail* =/= eps
def $output_pending_tasks(ptask*, pobdeactivate) = false -- otherwise
def $output_pending_frames(eps, pobdeactivate) = false
def $output_pending_frames(pframe :: pframe_tail*, pobdeactivate) = ((pframe.CONTEXT = eps /\ $output_pending_tasks(pframe.TODO, pobdeactivate)) \/ $output_pending_frames(pframe_tail*, pobdeactivate))
def $output_pending_active(S, pobdeactivate) = ($output_pending_valid(S, pobdeactivate) /\ ((S.CURRENT = eps /\ $output_pending_tasks(S.TODO, pobdeactivate)) \/ $output_pending_frames(S.FRAMES, pobdeactivate)))
def $output_drain_task(S, OUTPUT_FINAL_PENDING pobdeactivate n b) = $output_pending_active(S, pobdeactivate)
def $ob_user_active_task(OUTPUT_FINAL_PENDING pobdeactivate n b) = (pobdeactivate.CALL.BUFFER.ID)
def $task_nodes(OUTPUT_FINAL_PENDING pobdeactivate n true) = [HOBJECT n] ++ $operand_nodes(pobdrain.VALUE) ++ $base_nodes(pobdrain.BASE)
  -- if pobdeactivate.CALL.CALL = OB_FINAL pobdrain
def $task_nodes(OUTPUT_FINAL_PENDING pobdeactivate n false) = $operand_nodes(pobdrain.VALUE) ++ $base_nodes(pobdrain.BASE)
  -- if pobdeactivate.CALL.CALL = OB_FINAL pobdrain
def $call_task_valid(S, OUTPUT_FINAL_PENDING pobdeactivate n true) = ($output_pending_valid(S, pobdeactivate) /\ S.CURRENT = eps /\ $output_pending_cause(S, pobdeactivate, n) /\ $source_operand_suffix(S.TODO, OUTPUT_FINAL_PENDING pobdeactivate n true, eps))
def $call_task_valid(S, OUTPUT_FINAL_PENDING pobdeactivate n false) = ($output_pending_valid(S, pobdeactivate) /\ S.CURRENT = eps /\ $source_operand_suffix(S.TODO, OUTPUT_FINAL_PENDING pobdeactivate n false, eps))
rule PhpStep/output-final-pending-release: S ~> S[.TODO = [OUTPUT_FINAL_PENDING pobdeactivate n false]]
  -- if S.TODO = (OUTPUT_FINAL_PENDING pobdeactivate n true) :: ptask_tail*
  -- if ptask_tail* = eps
  -- if $call_task_valid(S, OUTPUT_FINAL_PENDING pobdeactivate n true)
rule PhpStep/output-final-pending-deactivate: S ~> S[.OUTPUTBUFFERS = eps][.TODO = [OUTPUT_FINAL_DEACTIVATE pobdeactivate[.BUFFERS = S.OUTPUTBUFFERS]]]
  -- if S.TODO = (OUTPUT_FINAL_PENDING pobdeactivate n false) :: ptask_tail*
  -- if ptask_tail* = eps
  -- if $call_task_valid(S, OUTPUT_FINAL_PENDING pobdeactivate n false)
  -- if S.DESTRUCTION.CALLS = eps /\ S.DESTRUCTION.RELEASES = eps /\ S.DESTRUCTION.FRAMES = eps /\ S.DESTRUCTION.OPERATIONS = eps /\ S.DESTRUCTION.CLEANUPS = eps
def $eager_operation_source_guard(S, pdestructionoperation) = (($output_pending_active(S, pobdeactivate) \/ $output_pending_abandoned(S, pdestructionoperation, pobdeactivate)) /\ pdestructionoperation.CALLER = eps /\ pdestructionoperation.ORIGIN = eps /\ pdestructionoperation.COMPLETION = NORMAL /\ pdestructionoperation.PENDING = eps /\ pdestructionoperation.VALUE = KNOWN PNULL /\ pdestructionoperation.BASE = BASE_VALUE (KNOWN PNULL))
  -- if pdestructionoperation.SOURCE = OUTPUT_FINAL_PENDING pobdeactivate n true


;; A null-C destructor throw aborts its actual release loop through the existing
;; eager bailout transfer. Its abandoned receiver counts are live; the saved
;; output rows below are a lookup view only, never another buffer/root owner.
dec $output_pending_abandoned_at(pstate, pdestructioncleanup*, pdestructionoperation, pobdeactivate) : bool
dec $output_pending_abandoned_row(pstate, pdestructioncleanup, pdestructionoperation, pobdeactivate) : bool
dec $output_pending_history(pstate, pobdeactivate) : pstate
def $output_pending_history(S, pobdeactivate) = S[.DESTRUCTION.PHASE = DESTRUCTION_DONE][.OUTPUTBUFFERS = pobdeactivate.BUFFERS][.ALLOCATIONS = S.ALLOCATIONS ++ $output_roots(pobdeactivate.BUFFERS) ++ $operand_nodes(pobdrain.VALUE) ++ $base_nodes(pobdrain.BASE)]
  -- if pobdeactivate.CALL.CALL = OB_FINAL pobdrain
def $output_pending_abandoned(S, pdestructionoperation, pobdeactivate) = $output_pending_abandoned_at(S, S.DESTRUCTION.ABANDONED, pdestructionoperation, pobdeactivate)
  -- if S.TODO = [DESTRUCTOR_RESULT pdestructorcall]
  -- if S.DESTRUCTION.PHASE = DESTRUCTION_STORE
