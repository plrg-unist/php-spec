def $output_pending_secondary(S) = eps -- otherwise


;; A selected handler may handle the C-root FINAL throw and return normally.
;; The original output callback still has an undefined retval: retain its real
;; argv and running buffer through the shared exception API cursor/cleanup, then
;; retire argv before taking output.c's failure route without a deprecation.
dec $output_final_exception_ready(pstate, pobinvoke, nat) : bool
dec $output_final_exception_valid(pstate, pobinvoke, bool) : bool
dec $output_final_undefined(pstate, pobinvoke) : pstate
