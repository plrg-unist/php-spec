def $output_pending_abandoned(S, pdestructionoperation, pobdeactivate) = false -- otherwise
def $output_pending_abandoned_at(S, eps, pdestructionoperation, pobdeactivate) = false
def $output_pending_abandoned_at(S, pdestructioncleanup :: pdestructioncleanup_tail*, pdestructionoperation, pobdeactivate) = ($output_pending_abandoned_row(S, pdestructioncleanup, pdestructionoperation, pobdeactivate) \/ $output_pending_abandoned_at(S, pdestructioncleanup_tail*, pdestructionoperation, pobdeactivate))
def $output_pending_abandoned_row(S, pdestructioncleanup, pdestructionoperation, pobdeactivate) = true
  -- if pdestructioncleanup.SOURCE = DESTRUCTOR_RESULT pdestructorcall
