;; zend_exception_error has already cleared EG(exception) before rendering.
;; True retains its local ex zval after reporting; false drops that local owner.
;; Buffers stay active/running through ordinary child release, retaining output.
dec $output_pending_cause(pstate, pobdeactivate, nat) : bool
dec $output_pending_abandoned(pstate, pdestructionoperation, pobdeactivate) : bool
dec $output_pending_valid(pstate, pobdeactivate) : bool
dec $output_pending_tasks(ptask*, pobdeactivate) : bool
dec $output_pending_frames(pframe*, pobdeactivate) : bool
dec $output_pending_active(pstate, pobdeactivate) : bool
def $output_pending_cause(S, pobdeactivate, n) = true
  -- if $throwable_live(S, n)
  -- if S.OBJECTS[n] = THROWABLE pthrowable
  -- if $throwable_field(S, n, "previous") = PNULL
