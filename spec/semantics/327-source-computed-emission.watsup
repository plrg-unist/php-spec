;; A computed variable compiles its name before emitting FETCH_R. A resolved
;; no-argument user call therefore emits INIT first, even when that variable
;; is the receiver of a later property read. Selection certifies compilation;
;; the name callback and target lookup remain runtime work after retirement.
dec $source_emission_computed_call(pstate, nat, pcpath, expression) : porigin?
def $source_emission_computed_call(S, n, pcpath, NExprVariable (NExprFuncCall name (SEQUENCE eps) metadata_call) metadata) = (PORIGIN n (pcpath ++ [PCFIELD 0]))
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (NExprVariable (NExprFuncCall name (SEQUENCE eps) metadata_call) metadata)
  -- if $cv_source_name(S[.ORIGIN = (PORIGIN n pcpath)], NExprFuncCall name (SEQUENCE eps) metadata_call) = eps
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_name(pcode.NAMES, pcpath ++ [PCFIELD 0]) = ((ptbytes_name, eps))
  -- if ~$pfunction_builtin(ptbytes_name)
  -- if $code_expression(pcode.EXPRESSIONS, pcpath ++ [PCFIELD 0]) = ((z_call, false))
  -- if $(z_call > 0)
  -- if z_call = $source_line(metadata_call)
  -- if $code_expression(pcode.EXPRESSIONS, pcpath) = ((z_variable, false))
  -- if z_variable = z_call
  -- if $compiled_effects(S, PORIGIN n pcpath) = eps
def $source_emission_computed_call(S, n, pcpath, expression) = eps -- otherwise

;; Literal CV/auto-global/GLOBALS/this and314's direct call receiver are disjoint.
def $source_echo_emission_origin(S, n, pcpath, expression) = (porigin)
  -- if $source_emission_computed_call(S, n, pcpath, expression) = (porigin)
def $source_echo_emission_origin(S, n, pcpath, NExprPropertyFetch expression_receiver (NIdentifier (BYTES text_property) metadata_property) metadata) = (porigin)
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (NExprPropertyFetch expression_receiver (NIdentifier (BYTES text_property) metadata_property) metadata)
  -- if $source_emission_computed_call(S, n, pcpath ++ [PCFIELD 0], expression_receiver) = (porigin)
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_expression(pcode.EXPRESSIONS, pcpath) = ((z_property, false))
  -- if $(z_property > 0)
  -- if z_property = $source_line(metadata_property)
  -- if $compiled_effects(S, PORIGIN n pcpath) = eps

;; FETCH_R captures the missing target once. A returning warning handler may
;; define that name, but the interrupted read still produces null. Only the
;; authenticated ordinary computed-call form enters this continuation; source
;; keyword operands retain293's separate warning protocol.
dec $computed_name_source(pstate, pnameread) : bool
def $computed_name_source(S, pnameread) = true
  -- if pnameread.SITE = PORIGIN n pcpath
  -- if $origin_node(S.SOURCES, pnameread.SITE) = (expression)
  -- if $source_emission_computed_call(S, n, pcpath, expression) = (porigin_name)
  -- if $code_expression_at_source(S, pnameread.SITE, [PCFIELD 0]) = (pnameread.LINE)
  -- if ~$scope_global(S[.ORIGIN = (pnameread.SITE)], eps)
  -- if ~$this_name(pnameread.NAME) /\ ~$psautoglobal(pnameread.NAME)
def $computed_name_source(S, pnameread) = false -- otherwise
def $computed_name_plan(S) = (pnameread)
  -- if S.TODO = (NAME_READ z) :: ptask_tail*
  -- if ~$source_name_pending(S)
  -- if S.ORIGIN = (porigin)
  -- if S_name = $resolve_name(S, $captured_name(S, [PCFIELD 0], S.RESULT), z)
  -- if S_name.COMPLETION = NORMAL
  -- if S_name.RESULT = KNOWN (PSTRING n_name*)
  -- if pnameread = {SITE porigin, NAME n_name*, LINE z}
  -- if $computed_name_source(S, pnameread)
  -- if $error_missing_operand(S_name, VARIABLE n_name* z)
def $computed_name_plan(S) = eps -- otherwise
def $computed_name_begin(S, pnameread) = $error_dispatch(S_name, 2, $ptascii("Undefined variable $") ++ pnameread.NAME, pnameread.LINE, WARNING pnameread.NAME pnameread.LINE, NAME_READ_RESULT pnameread)
  -- if $computed_name_plan(S) = (pnameread)
  -- if S_name = $resolve_name(S, $captured_name(S, [PCFIELD 0], S.RESULT), pnameread.LINE)
dec $computed_name_valid(pstate, pnameread) : bool
def $computed_name_valid(S, pnameread) = (S.ORIGIN = (pnameread.SITE) /\ $computed_name_source(S, pnameread))
def $call_task_valid(S, NAME_READ_RESULT pnameread) = $computed_name_valid(S, pnameread)
def $error_call_valid(S, perrorcall) = true
  -- if perrorcall.RESUME = NAME_READ_RESULT pnameread
  -- if $computed_name_valid(S, pnameread)
  -- if perrorcall.SITE = pnameread.SITE
  -- if perrorcall.LEVEL = 2
  -- if perrorcall.LINE = pnameread.LINE
  -- if perrorcall.MESSAGE = $ptascii("Undefined variable $") ++ pnameread.NAME
  -- if perrorcall.EVENT = WARNING pnameread.NAME pnameread.LINE
rule PhpStep/computed-name-warning-resume: S ~> S[.TODO = ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (NAME_READ_RESULT pnameread) :: ptask_tail*
  -- if $computed_name_valid(S, pnameread)
def $task_nodes(NAME_READ_RESULT pnameread) = eps
