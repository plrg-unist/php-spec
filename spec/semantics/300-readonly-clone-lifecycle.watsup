  -- if $clone_consumers_valid(S, pclonemaker.CONSUMERS, pmethoddesc.FUNCTION)
  -- if $clone_makers_valid(S, pclonemaker_tail*, pclonemaker.OBJECT :: n_seen*)
def $clone_makers_valid(S, pclonemaker*, n_seen*) = false -- otherwise
def $clone_windows_valid(S) = ($clone_windows_records_valid(S, S.CLONES, eps) /\ $clone_makers_valid(S, S.CLONEMAKERS, eps) /\ $clone_consumer_keys_unique($clone_consumer_keys(S.CLONEMAKERS), eps) /\ $clone_shutdown_births_valid(S, S.SHUTDOWN.ENTRIES, 0))


def $named_context_valid(S, pcallcontext) = true
  -- if $clone_context_valid(S, pcallcontext)
  -- if pcallcontext.NAMED = eps /\ pcallcontext.WRAPPER = eps
def $call_extent_valid(S, pcallcontext) = true
  -- if $clone_context_valid(S, pcallcontext)
  -- if pcallcontext.ARGC = 0


;; Terminal unwinding discards only this stack's clone continuations. A parked
;; stack's genuine operation keeps its own lifetime until that stack is unwound.
def $clone_drop_tasks(S, eps) = S
def $clone_drop_tasks(S, (CLONE_CALLBACK_ENTER pcloneoperation) :: ptask_tail*) = $clone_drop_tasks(S[.CLONES = $clone_window_delete(S.CLONES, pcloneoperation)], ptask_tail*)
def $clone_drop_tasks(S, (CLONE_CALLBACK_RESULT pcloneoperation) :: ptask_tail*) = $clone_drop_tasks(S[.CLONES = $clone_window_delete(S.CLONES, pcloneoperation)], ptask_tail*)
def $clone_drop_tasks(S, ptask :: ptask_tail*) = $clone_drop_tasks(S, ptask_tail*)
  -- if ~$clone_window_task_kind(ptask)
def $clone_window_task_kind(CLONE_CALLBACK_ENTER pcloneoperation) = true
def $clone_window_task_kind(CLONE_CALLBACK_RESULT pcloneoperation) = true
def $clone_window_task_kind(ptask) = false -- otherwise
def $clone_exit_drop(S) = $clone_drop_tasks(S, S.TODO)
