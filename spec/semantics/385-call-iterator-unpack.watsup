def $iterator_unpack_named_target(S, piteratorunpack) = $unpack_target(pfunction.SIGNATURE.PARAMETERS, pkey, |piteratorunpack.CALL.SENT.SLOTS|)
  -- if piteratorunpack.KEY = KNOWN pvalue
  -- if $fiber_traversal_key(pvalue) = (pkey)
  -- if $target_function(S, piteratorunpack.CALL.FUNCTION) = (pfunction)
def $iterator_unpack_scalar(PNULL) = true
def $iterator_unpack_scalar(PBOOL b) = true
def $iterator_unpack_scalar(PINT z) = true
def $iterator_unpack_scalar(PFLOAT n) = true
def $iterator_unpack_scalar(pvalue) = false -- otherwise
def $iterator_unpack_scalar_operand(S, KNOWN pvalue) = $iterator_unpack_scalar(pvalue)
  -- if $string_bytes(pvalue) = eps
def $iterator_unpack_scalar_operand(S, KNOWN (PSTRING n*)) = $startup_bytes(n*)
def $iterator_unpack_scalar_operand(S, KNOWN (PSTRING_CARRIER pstringidentity n*)) = $string_carrier_valid(S, PSTRING_CARRIER pstringidentity n*)
