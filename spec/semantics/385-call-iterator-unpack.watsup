def $iterator_unpack_nodes(piteratorunpack) = $operand_nodes(piteratorunpack.KEY) ++ $operand_nodes(piteratorunpack.CURRENT) ++ [HOBJECT piteratorunpack.OBJECT] ++ $operand_nodes(piteratorunpack.INPUT) ++ $operand_nodes(piteratorunpack.HOLD)
