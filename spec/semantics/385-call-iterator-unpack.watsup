;; Retain the raw valid() retval through the warning, then reread its double
;; payload once before retiring it and entering current() or iterator teardown.
rule PhpStep/iterator-unpack-valid-nan: S ~> $error_dispatch(S_read, 2, $ptascii("unexpected NAN value was coerced to bool"), z, DIAGNOSTIC "Warning" ($ptascii("unexpected NAN value was coerced to bool")) z, ITERATOR_UNPACK piteratorunpack[.CURRENT = S.RESULT] "valid-nan")
  -- if S.TODO = (ITERATOR_UNPACK piteratorunpack "valid") :: ptask_tail*
  -- if $iterator_unpack_result_valid(S, piteratorunpack, "valid")
  -- if z = $unpack_line(S, piteratorunpack.CALL)
  -- if S_read = $resolve_at(S, S.RESULT, z)
  -- if S_read.COMPLETION = NORMAL
  -- if S_read.RESULT = KNOWN pvalue
  -- if $generator_from_nan(pvalue)
rule PhpStep/iterator-unpack-valid-nan-current: S ~> $iterator_unpack_retire(S, piteratorunpack[.CURRENT = KNOWN PNULL], "current-start", ptask_tail*, $operand_nodes(piteratorunpack.CURRENT))
  -- if S.TODO = (ITERATOR_UNPACK piteratorunpack "valid-nan") :: ptask_tail*
  -- if $generator_from_valid_decision(S, piteratorunpack.CURRENT) = (true)
rule PhpStep/iterator-unpack-valid-nan-empty: S ~> $iterator_unpack_retire(S, piteratorunpack[.CURRENT = KNOWN PNULL], "finish", ptask_tail*, $operand_nodes(piteratorunpack.CURRENT))
  -- if S.TODO = (ITERATOR_UNPACK piteratorunpack "valid-nan") :: ptask_tail*
