def $iterator_unpack_scalar_operand(S, poperand) = false -- otherwise
def $iterator_unpack_object_order({SLOTS eps, NAMED eps}, pfunction, pnamedtarget) = true
def $iterator_unpack_object_order(pnamedargs, pfunction, NAMED_POSITION n) = $(n < |$call_fixed_parameters(pfunction.SIGNATURE.PARAMETERS)|)
  -- if pnamedargs =/= {SLOTS eps, NAMED eps}
def $iterator_unpack_object_order(pnamedargs, pfunction, NAMED_EXTRA preqbytes) = (pnamedargs.NAMED = eps)
  -- if pnamedargs =/= {SLOTS eps, NAMED eps}
def $iterator_unpack_object_order(pnamedargs, pfunction, pnamedtarget) = false -- otherwise
;; Restrict the separated rest representation to one direct, statically named
;; Iterator construction. General shared extra-named buffers remain open.
def $iterator_unpack_extra_site(S, (porigin)) = true
  -- if $origin_node(S.SOURCES, porigin) = (NExprFuncCall phpType19_name (SEQUENCE ([(NArg ABSENT (NExprNew phpType19_class (SEQUENCE eps) metadata_new) (BOOLEAN false) (BOOLEAN true) metadata_arg)])) metadata_call)
  -- if $origin_child((porigin), [PCFIELD 1, PCINDEX 0, PCFIELD 1]) = (porigin_new)
  -- if $new_source_name(S, porigin_new) = (ptbytes)
  -- if $class_named(S.CLASSNAMES, $ptlc(ptbytes)) = (porigin_class)
