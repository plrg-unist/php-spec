;; Class-method strings use full bytes. Admission and computed dispatch share
;; public lookup, while a compiled constant may use the active this receiver.
dec $method_string_colon(ptbytes, nat, nat?) : nat?
def $method_string_colon(eps, n, n_previous?) = n_previous?
def $method_string_colon(58 :: ptbytes, n, n_previous?) = $method_string_colon(ptbytes, $(n + 1), (n))
def $method_string_colon(n_byte :: ptbytes, n, n_previous?) = $method_string_colon(ptbytes, $(n + 1), n_previous?)
  -- if n_byte =/= 58
dec $method_string_parts(ptbytes) : (ptbytes, ptbytes)?
def $method_string_parts(ptbytes) = ((ptbytes[0:n_class], ptbytes[n_method:n_length]))
  -- if $method_string_colon(ptbytes, 0, eps) = (n_colon)
  -- if $(n_colon > 0)
  -- if n_class = $nabs($(n_colon - 1))
  -- if ptbytes[n_class:1] = [58]
  -- if n_method = $(n_colon + 1)
  -- if n_length = $nabs($(|ptbytes| - n_method))
def $method_string_parts(ptbytes) = eps -- otherwise

dec $string_fixed_receiver(pstate, porigin) : nat?
def $string_fixed_receiver(S, porigin_requested) = (n_receiver)
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.RECEIVER = (n_receiver)
  -- if $(n_receiver < |S.OBJECTS|)
  -- if (HOBJECT n_receiver) <- S.ALLOCATIONS
  -- if S.OBJECTS[n_receiver] = INSTANCE porigin_called
  -- if $class_at(S.CLASSES, porigin_requested) = (pclassdesc)
  -- if $class_origin_matches(S, porigin_called, pclassdesc.NAME, |S.CLASSES|)
def $string_fixed_receiver(S, porigin_requested) = eps -- otherwise

dec $string_fixed_method(pstate, ptbytes, ptbytes) : parrayresolution
def $string_fixed_method(S, ptbytes_class, ptbytes_method) = $scope_string_fixed(S, ptbytes_class, ptbytes_method)

dec $string_resolve(pstate, ptbytes, parraymode, bool) : parrayresolution
def $string_resolve(S, ptbytes, ARRAY_DISPATCH, true) = $string_fixed_method(S, ptbytes_class, ptbytes_method)
  -- if $method_string_parts(ptbytes) = ((ptbytes_class, ptbytes_method))
def $string_resolve(S, ptbytes, parraymode, b_fixed) = $array_receiver(S, PSTRING ptbytes_class, ptbytes_method, parraymode)
  -- if parraymode = ARRAY_ADMISSION \/ ~b_fixed
  -- if $method_string_parts(ptbytes) = ((ptbytes_class, ptbytes_method))
def $string_resolve(S, ptbytes, parraymode, b_fixed) = ARRAYINVALID ($ptascii("Invalid class-method string")) -- otherwise
def $string_callable(S, ptbytes) = $array_admission($string_resolve(S, ptbytes, ARRAY_ADMISSION, false))

;; Initial literal code names remove one leading slash. Keep its original
;; source bytes; later constant names and computed values already retain theirs.
dec $string_original(pstate, ptbytes, porigin) : ptbytes
def $string_original(S, ptbytes, porigin_site) = ptbytes_original
  -- if $origin_node(S.SOURCES, porigin_site) = (NExprFuncCall expression phpType6 metadata)
  -- if $ppcall_literal(expression) = (ptbytes_original)
  -- if $ppcall_literal_name(ptbytes_original) = ptbytes
def $string_original(S, ptbytes, porigin_site) = ptbytes -- otherwise

dec $string_source_possible(expression) : bool
def $string_source_possible(expression) = false
  -- if $parser_literal(expression) = (pvalue)
  -- if ~$typed_string_value(pvalue)
def $string_source_possible(NExprArray phpType12 metadata) = false
def $string_source_possible(NExprNew phpType28 phpType6 metadata) = false
def $string_source_possible(NExprClosure phpType14 phpType4_static phpType4_ref phpType16 phpType21 phpType18 phpType23 metadata) = false
def $string_source_possible(NExprArrowFunction phpType14 phpType4_static phpType4_ref phpType16 phpType18 expression metadata) = false
def $string_source_possible(NExprCastArray expression metadata) = false
def $string_source_possible(NExprCastBool expression metadata) = false
def $string_source_possible(NExprCastDouble expression metadata) = false
def $string_source_possible(NExprCastInt expression metadata) = false
def $string_source_possible(NExprCastObject expression metadata) = false
def $string_source_possible(NExprClone expression metadata) = false
def $string_source_possible(expression) = true -- otherwise
