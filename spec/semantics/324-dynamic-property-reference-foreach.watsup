rule PhpStep/foreach-fetch-reference-object: S ~> $object_foreach_fetch(S_selected, n, n_object, statement, porigin?, z, ptbytes, pitem, n_next, true)
  -- if S.TODO = (FOREACH_NEXT n (HCELL n_cell) statement porigin? z) :: ptask_tail*
