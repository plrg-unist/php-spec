dec $foreach_bind_plain_payload(pstate, ptbytes, nat, int, pvalue) : bool
def $foreach_bind_plain_payload(S, ptbytes, n_source, z, POBJECT n_previous) = ((HOBJECT n_previous) <- S.ALLOCATIONS /\ ~(n_previous <- S.DESTRUCTION.CALLED))
