rule PhpStep/foreach-fetch-reference-replacement-kind: S ~> S[.COMPLETION = UNSUPPORTED "reference foreach replacement object kind"]
  -- if S.TODO = (FOREACH_NEXT n (HCELL n_cell) statement porigin? z) :: ptask_tail*
  -- if S.STORE[n_cell] = DEFINED (POBJECT n_object)
  -- if ~$class_plain_instance(S, n_object)

;; A late scalar fetch warns once, then leaves the loop even if its callback
;; changes the wrapper payload. The iterator retains only its real wrapper.
dec $foreach_scalar_value(pvalue) : bool
def $foreach_scalar_value(pvalue) = (~$is_array_value(pvalue) /\ $type_bytes(pvalue) =/= $ptascii("object"))
def $foreach_late_scalar(S, HCELL n_cell) = true
  -- if S.SOURCEPENDING = eps
  -- if S.TODO = (FOREACH_NEXT n (HCELL n_cell) statement (porigin) z) :: ptask_tail*
  -- if S.STORE[n_cell] = DEFINED pvalue
  -- if $foreach_scalar_value(pvalue)
  -- if $iterator_lookup(S.ITERATORS, n) = (piterator)
  -- if $foreach_reference_iterator(piterator)
def $foreach_late_scalar(S, pnode) = false -- otherwise
dec $foreach_scalar_message(pvalue) : ptbytes
def $foreach_scalar_message(pvalue) = $ptascii("foreach() argument must be of type array|object, ") ++ $unpack_type_bytes(pvalue) ++ $ptascii(" given")
dec $foreach_scalar_valid(pstate, nat, nat, porigin, pvalue, int) : bool
def $foreach_scalar_valid(S, n, n_cell, porigin, pvalue, z) = true
  -- if S.ORIGIN = (porigin)
  -- if $origin_node(S.SOURCES, porigin) = (statement)
  -- if statement = NStmtForeach expression phpType5 (BOOLEAN b_ref) expression_value phpType23 (BOOLEAN false) metadata
  -- if $ppforeach_references(expression_value, b_ref)
  -- if z = $runtime_line(S, [PCFIELD 0], expression)
  -- if (HCELL n_cell) <- S.ALLOCATIONS /\ n_cell <- S.REFCELLS
  -- if S.STORE[n_cell] = DEFINED pvalue_current
  -- if $foreach_scalar_value(pvalue)
  -- if $iterator_lookup(S.ITERATORS, n) = (piterator)
  -- if $foreach_reference_iterator(piterator)
def $foreach_scalar_valid(S, n, n_cell, porigin, pvalue, z) = false -- otherwise
rule PhpStep/foreach-fetch-reference-scalar: S ~> $error_dispatch(S[.ORIGIN = (porigin)], 2, $foreach_scalar_message(pvalue), z, DIAGNOSTIC "Warning" $foreach_scalar_message(pvalue) z, FOREACH_SCALAR_END n n_cell porigin pvalue z)
  -- if S.TODO = (FOREACH_NEXT n (HCELL n_cell) statement (porigin) z) :: ptask_tail*
  -- if $foreach_late_scalar(S, HCELL n_cell)
  -- if S.STORE[n_cell] = DEFINED pvalue
  -- if $foreach_scalar_valid(S[.ORIGIN = (porigin)], n, n_cell, porigin, pvalue, z)
def $task_nodes(FOREACH_SCALAR_END n n_cell porigin pvalue z) = [HCELL n_cell]
def $error_task_iterator(FOREACH_SCALAR_END n n_cell porigin pvalue z) = [n]
def $return_discard(S, FOREACH_SCALAR_END n n_cell porigin pvalue z) = S[.ITERATORS = $iterator_remove(S.ITERATORS, n)]
def $error_read_discard(S, FOREACH_SCALAR_END n n_cell porigin pvalue z) = S[.ITERATORS = $iterator_remove(S.ITERATORS, n)]
def $call_task_valid(S, FOREACH_SCALAR_END n n_cell porigin pvalue z) = $foreach_scalar_valid(S, n, n_cell, porigin, pvalue, z)
def $error_call_valid(S, perrorcall) = true
  -- if perrorcall.RESUME = FOREACH_SCALAR_END n n_cell porigin pvalue z
  -- if $foreach_scalar_valid(S, n, n_cell, porigin, pvalue, z)
  -- if perrorcall.TARGET =/= eps \/ S.STORE[n_cell] = DEFINED pvalue
  -- if perrorcall.SITE = porigin /\ perrorcall.LINE = z /\ perrorcall.LEVEL = 2
  -- if perrorcall.MESSAGE = $foreach_scalar_message(pvalue)
  -- if perrorcall.EVENT = DIAGNOSTIC "Warning" $foreach_scalar_message(pvalue) z
rule PhpStep/foreach-reference-scalar-end: S ~> $foreach_finish(S, n)
  -- if S.TODO = (FOREACH_SCALAR_END n n_cell porigin pvalue z) :: ptask_tail*
  -- if $foreach_scalar_valid(S, n, n_cell, porigin, pvalue, z)

;; FE_FETCH_RW owns the selected wrapper before dropping the previous CV, but
;; installs that wrapper only after the old value's destructor has returned.
;; The old CV bits are borrowed during this interval, not an extra value owner.
dec $foreach_bind_source(pstate, ptbytes, int, ptask*) : (nat, nat, porigin, pnode)?
dec $foreach_bind_source_task(pstate, ptbytes, int, ptask) : (nat, nat, porigin, pnode)?
dec $foreach_bind_owner_valid(pstate, pnode, nat) : bool
def $foreach_bind_owner_valid(S, HOBJECT n, n) = ((HOBJECT n) <- S.ALLOCATIONS)
def $foreach_bind_owner_valid(S, HCELL n, n_object) = ((HCELL n) <- S.ALLOCATIONS /\ n <- S.REFCELLS)
def $foreach_bind_owner_valid(S, pnode, n) = false -- otherwise
def $foreach_bind_source_task(S, ptbytes, z, FOREACH_NEXT n_iterator pnode statement (porigin) z_foreach) = ((n_iterator, n_object, porigin, pnode))
  -- if statement = NStmtForeach expression_iterable phpType5 (BOOLEAN true) (NExprVariable phpType32 metadata_target) phpType23 (BOOLEAN false) metadata
  -- if $cv_name(phpType32) = (ptbytes)
  -- if $origin_node(S.SOURCES, porigin) = (statement)
  -- if $iterator_lookup(S.ITERATORS, n_iterator) = (OBJECTITER n_iterator n_object n_position true)
  -- if $foreach_bind_owner_valid(S, pnode, n_object)
  -- if S.ORIGIN = $origin_child((porigin), [PCFIELD 3])
  -- if z = $runtime_line(S, eps, NExprVariable phpType32 metadata_target)
def $foreach_bind_source_task(S, ptbytes, z, ptask) = eps -- otherwise
def $foreach_bind_source(S, ptbytes, z, eps) = eps
def $foreach_bind_source(S, ptbytes, z, ptask :: ptask_tail*) = (n_iterator, n_object, porigin, pnode)
  -- if $foreach_bind_source_task(S, ptbytes, z, ptask) = (n_iterator, n_object, porigin, pnode)
def $foreach_bind_source(S, ptbytes, z, ptask :: ptask_tail*) = $foreach_bind_source(S, ptbytes, z, ptask_tail*)
  -- if $foreach_bind_source_task(S, ptbytes, z, ptask) = eps

dec $foreach_bind_view(pstate) : pstate
def $foreach_bind_view(S) = $global_table_view(S) -- if $scope_global(S, eps)
def $foreach_bind_view(S) = S -- if ~$scope_global(S, eps)

;; Plain containers use the same physical child-zval release queue.
;; Their old CV bits remain borrowed after retirement, without a payload owner.
dec $foreach_bind_prior_unsupported(pstate, ptbytes, nat, int) : bool
dec $foreach_bind_internal_nodes(pstate, pnode*) : bool
def $foreach_bind_internal_nodes(S, eps) = false
def $foreach_bind_internal_nodes(S, pnode :: pnode_tail*) = ($internal_destructor_pending(S, pnode) \/ $foreach_bind_internal_nodes(S, pnode_tail*))
;; Per-slot typed-source detachment during child callbacks is still required.
dec $foreach_bind_source_retired(pproptypesource, pnode*) : bool
def $foreach_bind_source_retired(OBJECT_PROP_SOURCE n ptbytes ppropertyid, pnode*) = ((HOBJECT n) <- pnode*)
def $foreach_bind_source_retired(pproptypesource, pnode*) = false -- otherwise
dec $foreach_bind_sources_retired(pproptypesource*, pnode*) : bool
def $foreach_bind_sources_retired(eps, pnode*) = false
def $foreach_bind_sources_retired(pproptypesource :: pproptypesource_tail*, pnode*) = ($foreach_bind_source_retired(pproptypesource, pnode*) \/ $foreach_bind_sources_retired(pproptypesource_tail*, pnode*))
dec $foreach_bind_retired_types(ppropref*, pnode*) : bool
def $foreach_bind_retired_types(eps, pnode*) = false
def $foreach_bind_retired_types(ppropref :: ppropref_tail*, pnode*) = ($foreach_bind_sources_retired(ppropref.SOURCES, pnode*) \/ $foreach_bind_retired_types(ppropref_tail*, pnode*))
dec $foreach_bind_children(pstate, ptbytes, nat, int, pnode) : bool
