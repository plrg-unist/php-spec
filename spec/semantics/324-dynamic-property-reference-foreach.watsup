dec $foreach_bind_address_valid(pstate, pforeachbind) : bool
def $foreach_bind_address_valid(S, pforeachbind) = ($lookup(S_view.ENV, pforeachbind.NAME) = (pforeachbind.OLD))
  -- if S_view = $foreach_bind_view(S)

dec $foreach_bind_operation_queued(ptask*, pforeachbind) : bool
dec $foreach_bind_operation_task(ptask, pforeachbind) : bool
def $foreach_bind_operation_task(DESTRUCTOR_OPERATION_EXIT pdestructionoperation, pforeachbind) = (pdestructionoperation.SOURCE = FOREACH_BIND_RELEASE pforeachbind)
def $foreach_bind_operation_task(ptask, pforeachbind) = false -- otherwise
def $foreach_bind_operation_queued(eps, pforeachbind) = false
def $foreach_bind_operation_queued(ptask :: ptask_tail*, pforeachbind) = ($foreach_bind_operation_task(ptask, pforeachbind) \/ $foreach_bind_operation_queued(ptask_tail*, pforeachbind))
def $call_task_valid(S, FOREACH_BIND_RELEASE pforeachbind) = ($foreach_bind_capture(S, pforeachbind.NAME, pforeachbind.NEW, pforeachbind.LINE) = (pforeachbind))
def $call_task_valid(S, FOREACH_BIND_COMMIT pforeachbind) = ($foreach_bind_body_valid(S, pforeachbind) /\ $foreach_bind_address_valid(S, pforeachbind) /\ (~$destructor_operational(S) \/ $foreach_bind_operation_queued(S.TODO, pforeachbind)))
def $task_nodes(FOREACH_BIND_RELEASE pforeachbind) = [HCELL pforeachbind.NEW]
def $task_nodes(FOREACH_BIND_COMMIT pforeachbind) = [HCELL pforeachbind.NEW]
rule PhpStep/foreach-bind-release: S ~> S[.TODO = (FOREACH_BIND_COMMIT pforeachbind) :: ptask_tail*]
  -- if S.TODO = (FOREACH_BIND_RELEASE pforeachbind) :: ptask_tail*
  -- if $call_task_valid(S, FOREACH_BIND_RELEASE pforeachbind)

;; Ownership predicates inspect the actual saved queues. They add no OLD root.
dec $foreach_bind_pending_task(pstate, nat, ptask) : bool
dec $foreach_bind_pending_after(pstate, ptask) : pstate
dec $foreach_bind_pending_tasks(pstate, nat, ptask*) : bool
dec $foreach_bind_pending_frames(pstate, nat, pframe*) : bool
dec $foreach_bind_pending_vm(pstate, nat, pfibervm) : bool
dec $foreach_bind_pending_objects(pstate, nat, pobject*) : bool
dec $foreach_bind_pending_object(pstate, nat, pobject) : bool
dec $foreach_bind_pending_callers(pstate, nat, pfibercaller*) : bool
dec $foreach_bind_pending_closers(pstate, nat, pfiberclose*) : bool
def $foreach_bind_pending_task(S, n, AT porigin ptask) = $foreach_bind_pending_task(S[.ORIGIN = (porigin)], n, ptask)
def $foreach_bind_pending_task(S, n, FOREACH_BIND_COMMIT pforeachbind) = (n = pforeachbind.OLD /\ $foreach_bind_body_valid(S, pforeachbind))
def $foreach_bind_pending_task(S, n, ptask) = false -- otherwise
def $foreach_bind_pending_after(S, FOREACH_BIND_COMMIT pforeachbind) = S
def $foreach_bind_pending_after(S, ptask) = $call_after_origin(S, ptask) -- otherwise
def $foreach_bind_pending_tasks(S, n, eps) = false
def $foreach_bind_pending_tasks(S, n, ptask :: ptask_tail*) = ($foreach_bind_pending_task(S, n, ptask) \/ $foreach_bind_pending_tasks($foreach_bind_pending_after(S, ptask), n, ptask_tail*))
def $foreach_bind_pending_frames(S, n, eps) = false
def $foreach_bind_pending_frames(S, n, pframe :: pframe_tail*) = ($foreach_bind_pending_tasks($constant_frame_scope(S, pframe, pframe_tail*), n, pframe.TODO) \/ $foreach_bind_pending_frames(S, n, pframe_tail*))
def $foreach_bind_pending_vm(S, n, pfibervm) = ($foreach_bind_pending_tasks(S_view, n, S_view.TODO) \/ $foreach_bind_pending_frames(S_view, n, S_view.FRAMES))
  -- if S_view = $fiber_vm_restore(S, pfibervm)
def $foreach_bind_pending_objects(S, n, eps) = false
def $foreach_bind_pending_objects(S, n, pobject :: pobject_tail*) = ($foreach_bind_pending_object(S, n, pobject) \/ $foreach_bind_pending_objects(S, n, pobject_tail*))
def $foreach_bind_pending_object(S, n, FIBER pfiber) = $foreach_bind_pending_vm(S, n, pfibervm)
  -- if pfiber.VM = (pfibervm)
def $foreach_bind_pending_object(S, n, GENERATOR pgenerator) = $foreach_bind_pending_tasks($constant_frame_scope(S, pframe, eps), n, pframe.TODO)
  -- if pgenerator.FRAME = (pframe)
def $foreach_bind_pending_object(S, n, pobject) = false -- otherwise
def $foreach_bind_pending_callers(S, n, eps) = false
def $foreach_bind_pending_callers(S, n, pfibercaller :: pfibercaller_tail*) = ($foreach_bind_pending_vm(S, n, pfibercaller.VM) \/ $foreach_bind_pending_callers(S, n, pfibercaller_tail*))
def $foreach_bind_pending_closers(S, n, eps) = false
def $foreach_bind_pending_closers(S, n, pfiberclose :: pfiberclose_tail*) = ($foreach_bind_pending_vm(S, n, pfiberclose.VM) \/ $foreach_bind_pending_closers(S, n, pfiberclose_tail*))
def $foreach_released_cell(S, n) = ($foreach_bind_pending_tasks(S, n, S.TODO) \/ $foreach_bind_pending_frames(S, n, S.FRAMES) \/ $foreach_bind_pending_objects(S, n, S.OBJECTS) \/ $foreach_bind_pending_callers(S, n, S.FIBERCALLERS) \/ $foreach_bind_pending_closers(S, n, S.FIBERCLOSERS))
def $foreach_released_name(S, ptbytes) = $foreach_released_cell(S, n)
  -- if $lookup(S.ENV, ptbytes) = (n)
def $foreach_released_name(S, ptbytes) = false -- otherwise

;; No ordinary fetch may turn a retired raw container pointer into an owner.
def $foreach_released_container_cell(S, n) = true
  -- if S.STORE[n] = DEFINED (PARRAY n_array)
  -- if $foreach_released_cell(S, n)
def $foreach_released_container_cell(S, n) = true
  -- if S.STORE[n] = DEFINED (POBJECT n_object)
  -- if ~((HOBJECT n_object) <- S.ALLOCATIONS)
  -- if $foreach_released_cell(S, n)
def $foreach_released_container_cell(S, n) = false -- otherwise
def $foreach_released_container_name(S, ptbytes) = true
  -- if $lookup(S.ENV, ptbytes) = (n)
  -- if $foreach_released_container_cell(S, n)
def $foreach_released_container_name(S, ptbytes) = false -- otherwise

dec $foreach_bind_store(pstate, pforeachbind) : pstate
def $foreach_bind_store(S, pforeachbind) = $scope_bind_name(S[.STORE = $set_cell(S.STORE, pforeachbind.OLD, UNDEFINED)][.CELL = pforeachbind.NEW], eps, pforeachbind.NAME, pforeachbind.LINE)[.RESULT = KNOWN PNULL]
def $call_after_origin(S, FOREACH_BIND_COMMIT pforeachbind) = $foreach_bind_store(S, pforeachbind)
def $return_discard(S, FOREACH_BIND_COMMIT pforeachbind) = S[.STORE = $set_cell(S.STORE, pforeachbind.OLD, UNDEFINED)]
rule PhpStep/foreach-bind-commit: S ~> $foreach_bind_store(S[.TODO = ptask_tail*], pforeachbind)
  -- if S.TODO = (FOREACH_BIND_COMMIT pforeachbind) :: ptask_tail*
  -- if ~$destructor_operational(S)
  -- if $call_task_valid(S, FOREACH_BIND_COMMIT pforeachbind)

dec $foreach_bind_scope(pstate, pforeachbind, pframe*) : pstate?
dec $foreach_bind_same_scope(pstate, pforeachbind) : bool
def $foreach_bind_same_scope(S, pforeachbind) = (S.CURRENT = pforeachbind.CALLER /\ S.ORIGIN = (pforeachbind.SITE) /\ S.CONSTCONTEXT = pforeachbind.CONSTCONTEXT)
def $foreach_bind_scope(S, pforeachbind, pframe*) = (S)
  -- if $foreach_bind_same_scope(S, pforeachbind)
def $foreach_bind_scope(S, pforeachbind, pframe :: pframe_tail*) = $foreach_bind_scope($constant_frame_scope(S, pframe, pframe_tail*), pforeachbind, pframe_tail*)
  -- if ~$foreach_bind_same_scope(S, pforeachbind)
def $foreach_bind_scope(S, pforeachbind, eps) = eps
  -- if ~$foreach_bind_same_scope(S, pforeachbind)
dec $foreach_bind_operation_source_valid(pstate, pdestructionoperation, pforeachbind) : bool
def $foreach_bind_operation_source_valid(S, pdestructionoperation, pforeachbind) = true
  -- if pdestructionoperation.CALLER = pforeachbind.CALLER /\ pdestructionoperation.ORIGIN = (pforeachbind.SITE) /\ pdestructionoperation.CONSTCONTEXT = pforeachbind.CONSTCONTEXT
  -- if $foreach_bind_scope(S, pforeachbind, S.FRAMES) = (S_scope)
  -- if $foreach_bind_body_valid(S_scope, pforeachbind)
  -- if $foreach_bind_address_valid(S_scope, pforeachbind)
  -- if $foreach_bind_operation_queued(S_scope.TODO, pforeachbind)
def $foreach_bind_operation_source_valid(S, pdestructionoperation, pforeachbind) = false -- otherwise
def $eager_operation_source_guard(S, pdestructionoperation) = $foreach_bind_operation_source_valid(S, pdestructionoperation, pforeachbind)
  -- if pdestructionoperation.SOURCE = FOREACH_BIND_RELEASE pforeachbind

;; Finish the C binding before propagating a destructor's pending exception.
def $destructor_operation_postfinish(S, pdestructionoperation) = $foreach_bind_store(S[.TODO = ptask_tail*], pforeachbind)
  -- if pdestructionoperation.SOURCE = FOREACH_BIND_RELEASE pforeachbind
  -- if S.TODO = (FOREACH_BIND_COMMIT pforeachbind) :: ptask_tail*
def $destructor_operation_postfinish(S, pdestructionoperation) = $foreach_bind_store(S[.TODO = (THROW_SEARCH n) :: ptask_tail*], pforeachbind)
  -- if pdestructionoperation.SOURCE = FOREACH_BIND_RELEASE pforeachbind
  -- if S.TODO = (THROW_SEARCH n) :: (FOREACH_BIND_COMMIT pforeachbind) :: ptask_tail*

dec $foreach_bind_exit_tasks(pstate, ptask*) : bool
dec $foreach_bind_exit_task(pstate, ptask) : bool
dec $foreach_bind_exit_frames(pstate, pframe*) : bool
def $foreach_bind_exit_tasks(S, eps) = false
def $foreach_bind_exit_tasks(S, ptask :: ptask_tail*) = ($foreach_bind_exit_task(S, ptask) \/ $foreach_bind_exit_tasks($foreach_bind_pending_after(S, ptask), ptask_tail*))
def $foreach_bind_exit_task(S, FOREACH_BIND_COMMIT pforeachbind) = $foreach_bind_body_valid(S, pforeachbind)
def $foreach_bind_exit_task(S, ptask) = false -- otherwise
def $foreach_bind_exit_frames(S, eps) = false
def $foreach_bind_exit_frames(S, pframe :: pframe_tail*) = ($foreach_bind_exit_tasks($constant_frame_scope(S, pframe, pframe_tail*), pframe.TODO) \/ $foreach_bind_exit_frames(S, pframe_tail*))
def $foreach_bind_exit_pending(S) = ($foreach_bind_exit_tasks(S, S.TODO) \/ $foreach_bind_exit_frames(S, S.FRAMES))
def $exit_start_unwind(S, z) = S[.COMPLETION = UNSUPPORTED "foreach reference binding exit continuation"]
  -- if ~$fiber_closing(S, S.ACTIVEFIBER)
  -- if ~$property_dynamic_exit_pending(S)
  -- if $foreach_bind_exit_pending(S)
