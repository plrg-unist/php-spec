def $foreach_bind_plain_payload(S, ptbytes, n_source, z, PARRAY n_previous) = $foreach_bind_children(S, ptbytes, n_source, z, HARRAY n_previous)
def $foreach_bind_plain_payload(S, ptbytes, n_source, z, pvalue) = false -- otherwise
dec $foreach_bind_payload_kind(pstate, pvalue) : bool
def $foreach_bind_payload_kind(S, POBJECT n) = $(n < |S.OBJECTS|)
def $foreach_bind_payload_kind(S, PARRAY n) = $(n < |S.ARRAYS|)
def $foreach_bind_payload_kind(S, pvalue) = false -- otherwise

