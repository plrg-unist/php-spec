;; Compound concatenation captures the actual destination and operand values
;; before invoking user code. Only the final store checks setter permission.
dec $compound_string_line(pstate, porigin, expression, expression, metadata) : int
def $compound_string_line(S, porigin_site, NExprArrayDimFetch expression expression_key metadata_key, expression_right, metadata) = $runtime_line(S[.ORIGIN = $origin_child((porigin_site), [PCFIELD 0])], [PCFIELD 1], expression_key)
def $compound_string_line(S, porigin_site, NExprArrayDimFetch expression ABSENT metadata_key, expression_right, metadata) = $runtime_line(S[.ORIGIN = $origin_child((porigin_site), [PCFIELD 0])], eps, NExprArrayDimFetch expression ABSENT metadata_key)
def $compound_string_line(S, porigin_site, expression_left, expression_right, metadata) = $runtime_line(S[.ORIGIN = (porigin_site)], eps, NExprAssignOpConcat expression_left expression_right metadata) -- otherwise
def $compound_string_site_valid(S, PORIGIN n_unit pcpath_site, z) = true
  -- if $origin_node(S.SOURCES, PORIGIN n_unit pcpath_site) = (NExprAssignOpConcat expression_left expression_right metadata)
  -- if $code_at(S.CODE, n_unit) = (pcode)
  -- if $code_expression(pcode.EXPRESSIONS, pcpath_site) = ((z_code, b))
  -- if z = $compound_string_line(S, PORIGIN n_unit pcpath_site, expression_left, expression_right, metadata)

