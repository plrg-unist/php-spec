;; Backed instance setters reuse Zend's normalized declaration and lexical
;; permission. Ordinary reads and escaped CV aliases retain their own access.
def $ppproperty_instance_supported(flags) = (~$ppproperty_flag(flags, 8) /\ $ppproperty_static_supported($(flags + 8)))

dec $property_instance_set_desc(pstate, nat, ptbytes) : ppropertydesc?
def $property_instance_set_desc(S, n, ptbytes) = (ppropertydesc)
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $property_desc_at($property_layout(S, porigin, |S.CLASSES|), ptbytes) = (ppropertydesc)
  -- if ~ppropertydesc.STATIC
  -- if ppropertydesc.SETVISIBILITY =/= eps \/ ppropertydesc.READONLY
def $property_instance_set_desc(S, n, ptbytes) = eps -- otherwise

def $property_set_denied(S, n, ptbytes) = true
  -- if $property_instance_set_desc(S, n, ptbytes) = (ppropertydesc)
  -- if $property_readonly_written(S, n, ptbytes) \/ ~$class_static_set_allowed(S, ppropertydesc)
def $property_set_check(S, n, ptbytes, ptbytes_operation, z) = $property_readonly_error(S, n, ptbytes, ptbytes_operation, z)
  -- if $property_readonly_written(S, n, ptbytes)
def $property_set_check(S, n, ptbytes, ptbytes_operation, z) = $class_static_set_error(S, ppropertydesc, ptbytes_operation, z)
  -- if $property_set_denied(S, n, ptbytes)
  -- if ~$property_readonly_written(S, n, ptbytes)
  -- if $property_instance_set_desc(S, n, ptbytes) = (ppropertydesc)

dec $property_instance_raw_object(pstate, nat, ptbytes) : bool
def $property_instance_raw_object(S, n, ptbytes) = true
  -- if $objectprops_record_at(S.OBJECTPROPS, n) = (pobjectprops)
  -- if $property_slot_at(pobjectprops.SLOTS, ptbytes) = (ppropertyslot)
  -- if ppropertyslot.STATE = PROP_VALUE (DIRECT (POBJECT n_value))
def $property_instance_raw_object(S, n, ptbytes) = false -- otherwise

def $property_instance_indirect_check(S, n, ptbytes, b_object, z) = $property_readonly_error(S, n, ptbytes, $ptascii("indirectly modify"), z)
  -- if $property_instance_set_desc(S, n, ptbytes) = (ppropertydesc)
  -- if ppropertydesc.READONLY
  -- if ~b_object \/ ~$property_instance_raw_object(S, n, ptbytes)
def $property_instance_indirect_check(S, n, ptbytes, b_object, z) = $class_static_set_error(S, ppropertydesc, $ptascii("indirectly modify"), z)
  -- if $property_instance_set_desc(S, n, ptbytes) = (ppropertydesc)
  -- if ~ppropertydesc.READONLY
  -- if ~$class_static_set_allowed(S, ppropertydesc)
  -- if ~b_object \/ ~$property_instance_raw_object(S, n, ptbytes)

def $property_unset_indirect_check(S, n, ptbytes, z) = $property_instance_indirect_check(S, n, ptbytes, true, z)
  -- if $location_slot(S, PROPERTY n ptbytes) = DEFINED pvalue
def $property_rw_check(S, n, ptbytes, STRINGNESTED, z) = $property_instance_indirect_check(S, n, ptbytes, true, z)
;; A failed object increment still invokes the denied setter. Its Error keeps
;; the pending arithmetic TypeError as previous, as zend_std_write_property does.
def $property_update_abrupt(S, PROPERTY n ptbytes, POBJECT n_value, z) = $property_set_check(S, n, ptbytes, $ptascii("modify"), z)
  -- if $throwable_pending(S.COMPLETION)
  -- if $property_set_denied(S, n, ptbytes)

