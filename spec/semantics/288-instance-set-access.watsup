def $compound_string_place(S, ELEMENT n pkey, NExprArrayDimFetch expression phpType5 metadata) = ($heap_member(HARRAY n, S.ALLOCATIONS) /\ $(n < |S.ARRAYS|))
def $compound_string_place(S, PROPERTY n ptbytes_key, NExprPropertyFetch expression (NIdentifier (BYTES text) metadata_name) metadata) = true
  -- if $class_plain_instance(S, n)
  -- if $property_resolve(S, n, $base64(text)) = PROPERTY_ACCESS ptbytes_key
def $compound_string_place(S, PROPERTY n ptbytes_key, NExprPropertyFetch expression expression_name metadata) = true
  -- if $class_plain_instance(S, n)
  -- if $property_computed_name(expression_name)
  -- if $objectprops_record_at(S.OBJECTPROPS, n) = (pobjectprops)
  -- if $property_slot_at(pobjectprops.SLOTS, ptbytes_key) =/= eps
def $compound_string_place(S, plocation, expression) = false -- otherwise

dec $compound_string_source(pstate, plocation, porigin, int) : bool
def $compound_string_source(S, plocation, porigin_site, z) = true
  -- if $compound_string_site_valid(S, porigin_site, z)
  -- if $origin_node(S.SOURCES, porigin_site) = (NExprAssignOpConcat expression_left expression_right metadata)
  -- if $compound_string_place(S, plocation, expression_left)
def $compound_string_source(S, plocation, porigin_site, z) = false -- otherwise
dec $compound_string_right_value(pstate, porigin, pvalue) : bool
def $compound_string_right_value(S, porigin_site, pvalue) = true
  -- if $origin_child((porigin_site), [PCFIELD 1]) = (porigin_right)
  -- if $compiled_read(S, porigin_right) = (pvalue)
def $compound_string_right_value(S, porigin_site, pvalue) = $heap_subset($value_nodes(pvalue), S.ALLOCATIONS)
  -- if $origin_child((porigin_site), [PCFIELD 1]) = (porigin_right)
  -- if $compiled_read(S, porigin_right) = eps
def $compound_string_right_value(S, porigin_site, pvalue) = false -- otherwise

dec $compound_string_place_nodes(plocation) : pnode*
def $compound_string_place_nodes(PROPERTY n ptbytes) = [HOBJECT n]
def $compound_string_place_nodes(ELEMENT n pkey) = [HARRAY n]
def $compound_string_place_nodes(plocation) = eps -- otherwise
