def $compound_string_initial_place(S, PROPERTY n ptbytes, porigin_site) = true
def $compound_string_initial_place(S, ELEMENT n pkey, porigin_site) = true
def $compound_string_initial_place(S, plocation, porigin_site) = false -- otherwise
def $task_nodes(COMPOUND_STRING_PREP plocation pvalue_left pvalue_right porigin_site z) = $compound_string_place_nodes(plocation) ++ $value_nodes(pvalue_left) ++ $value_nodes(pvalue_right)
def $task_nodes(COMPOUND_STRING_LEFT plocation pvalue_right porigin_site z) = $compound_string_place_nodes(plocation) ++ $value_nodes(pvalue_right)
def $task_nodes(COMPOUND_STRING_RIGHT plocation ptbytes_left porigin_site z) = $compound_string_place_nodes(plocation)

def $compound_string_pending(S) = true
  -- if S.TODO = (COMPOUND_STRING_PREP plocation pvalue_left pvalue_right porigin_site z) :: ptask_tail*
def $compound_value(S, CONCAT, pvalue_left, pvalue_right, z) = S[.TODO = (COMPOUND_STRING_PREP S.LOCATION pvalue_left pvalue_right porigin_site z) :: S.TODO][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if $user_string_value(S, pvalue_left) \/ $user_string_value(S, pvalue_right)
  -- if S.ORIGIN = (porigin_site)
  -- if $compound_string_source(S, S.LOCATION, porigin_site, z)

def $call_task_valid(S, COMPOUND_STRING_PREP plocation pvalue_left pvalue_right porigin_site z) = (S.ORIGIN = (porigin_site) /\ $compound_string_source(S, plocation, porigin_site, z) /\ $compound_string_initial_place(S, plocation, porigin_site) /\ $location_slot(S, plocation) = DEFINED pvalue_left /\ ($user_string_value(S, pvalue_left) \/ $user_string_value(S, pvalue_right)) /\ $heap_subset($value_nodes(pvalue_left), S.ALLOCATIONS) /\ $compound_string_right_value(S, porigin_site, pvalue_right))
def $call_task_valid(S, COMPOUND_STRING_LEFT plocation pvalue_right porigin_site z) = (S.ORIGIN = (porigin_site) /\ $compound_string_source(S, plocation, porigin_site, z) /\ $compound_string_right_value(S, porigin_site, pvalue_right))
def $call_task_valid(S, COMPOUND_STRING_RIGHT plocation ptbytes_left porigin_site z) = (S.ORIGIN = (porigin_site) /\ $compound_string_source(S, plocation, porigin_site, z))
def $stringify_source(S, porigin_site, z, COMPOUND_STRING_LEFT plocation pvalue_right porigin_site z) = ($compound_string_source(S, plocation, porigin_site, z) /\ $compound_string_right_value(S, porigin_site, pvalue_right))
def $stringify_source(S, porigin_site, z, COMPOUND_STRING_RIGHT plocation ptbytes_left porigin_site z) = $compound_string_source(S, plocation, porigin_site, z)
