;; The native iterator owns DATA; resume operations borrow it. VALUE/REFCELL/KEY remain in the
;; Generator through resumed code and CLOSED, until its real storage retires.
dec $array_generator_input_source(pstate, expression, poperand, nat, porigin) : bool
dec $array_generator_input_live(pstate, poperand, nat) : bool
dec $array_generator_history(pstate, parraygenerator) : bool
dec $array_generator_source(pstate, parraygenerator) : bool
