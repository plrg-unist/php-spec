dec $array_generator_valid(pstate, parraygenerator, text) : bool
dec $array_generator_value(pstate, parraygenerator) : pvalue?
dec $array_generator_cache(pstate, parraygenerator) : bool
dec $array_generator_ready(pstate, parraygenerator) : bool
dec $array_generator_plan(pstate) : parraygenerator?
dec $array_generator_header(pstate, pgeneratorop, parraygenerator, text) : bool
dec $array_generator_operation_tasks(pstate, pgeneratorop, ptask*) : bool
dec $array_generator_operation_frames(pstate, pgeneratorop, pframe*) : bool
