def $array_generator_history(S, parraygenerator) = false -- otherwise
def $array_generator_source(S, parraygenerator) = ($array_generator_history(S, parraygenerator) /\ (HOBJECT parraygenerator.OBJECT) <- S.ALLOCATIONS)
