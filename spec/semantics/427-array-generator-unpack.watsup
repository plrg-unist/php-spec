;; A partial semantic boundary retains its real owners; it must not trigger
;; generic temporary release and accidentally run a suspended Generator finally.
def $array_generator_blocked(S) = true
  -- if S.COMPLETION = UNSUPPORTED "array Generator cache or builder outside direct domain"
  -- if ~S.COMPILESTOP
  -- if S.TODO = (ARRAY_GENERATOR parraygenerator "ready") :: ptask*
