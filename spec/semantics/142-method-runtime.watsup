  -- if $method_ctor_parent_proto(S, pclassdesc_child.ORIGIN, |S.CLASSES|) = eps
  -- if ~pmethoddesc_parent.ABSTRACT
def $method_override_one(S, pclassdesc_child, PPMINHERITED pmethoddesc_parent pclassdesc_parent) = $method_signature_issue(S, pclassdesc_child, pmethoddesc_child, pclassdesc_proto, pmethoddesc_proto)
  -- if $method_named(pclassdesc_child.METHODS, pmethoddesc_parent.NAME) = (pmethoddesc_child)
  -- if ~pmethoddesc_parent.FINAL /\ ~(pmethoddesc_child.ABSTRACT /\ ~pmethoddesc_parent.ABSTRACT)
  -- if $ptlc(pmethoddesc_parent.NAME) = $ptascii("__construct")
  -- if $method_ctor_parent_proto(S, pclassdesc_child.ORIGIN, |S.CLASSES|) = (PPMINHERITED pmethoddesc_proto pclassdesc_proto)
def $method_override_one(S, pclassdesc_child, PPMINHERITED pmethoddesc_parent pclassdesc_parent) = $method_signature_issue(S, pclassdesc_child, pmethoddesc_child, pclassdesc_parent, pmethoddesc_parent)
  -- if $method_named(pclassdesc_child.METHODS, pmethoddesc_parent.NAME) = (pmethoddesc_child)
  -- if ~pmethoddesc_parent.FINAL /\ ~(pmethoddesc_child.ABSTRACT /\ ~pmethoddesc_parent.ABSTRACT)
