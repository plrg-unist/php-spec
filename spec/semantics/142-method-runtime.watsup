def $method_prototype(S, porigin, ptbytes, n) = porigin -- otherwise
dec $method_accessible(pstate, pmethoddesc, porigin?) : bool
def $method_accessible(S, pmethoddesc, porigin?) = true
  -- if pmethoddesc.VISIBILITY = PROPERTY_PUBLIC
def $method_accessible(S, pmethoddesc, (porigin_scope)) = true
  -- if pmethoddesc.VISIBILITY = PROPERTY_PRIVATE
  -- if pmethoddesc.OWNER = porigin_scope
def $method_accessible(S, pmethoddesc, (porigin_scope)) = true
  -- if pmethoddesc.VISIBILITY = PROPERTY_PROTECTED
  -- if $class_at(S.CLASSES, porigin_scope) = (pclassdesc_scope)
  -- if porigin_prototype = $method_prototype(S, pmethoddesc.OWNER, pmethoddesc.NAME, |S.CLASSES|)
  -- if $class_at(S.CLASSES, porigin_prototype) = (pclassdesc_prototype)
  -- if $class_origin_matches(S, porigin_scope, pclassdesc_prototype.NAME, |S.CLASSES|) \/ $class_origin_matches(S, porigin_prototype, pclassdesc_scope.NAME, |S.CLASSES|)
def $method_accessible(S, pmethoddesc, porigin?) = false -- otherwise
dec $method_scope_suffix(pstate, porigin?) : ptbytes
def $method_scope_suffix(S, (porigin_scope)) = $ptascii(" from scope ") ++ pclassdesc_scope.NAME
  -- if $class_at(S.CLASSES, porigin_scope) = (pclassdesc_scope)
def $method_scope_suffix(S, porigin?) = $ptascii(" from global scope") -- otherwise
dec $method_visibility_name(ppropertyvisibility) : ptbytes
def $method_visibility_name(PROPERTY_PRIVATE) = $ptascii("private")
def $method_visibility_name(PROPERTY_PROTECTED) = $ptascii("protected")
def $method_visibility_name(PROPERTY_PUBLIC) = $ptascii("public")
dec $method_denied(pstate, pmethoddesc, ptbytes, porigin?, bool, int) : pstate
def $method_denied(S, pmethoddesc, ptbytes, porigin?, false, z) = $throw_scalar(S, "Error", $ptascii("Call to ") ++ $method_visibility_name(pmethoddesc.VISIBILITY) ++ $ptascii(" method ") ++ pclassdesc.NAME ++ $ptascii("::") ++ $c_string(ptbytes) ++ $ptascii("()") ++ $method_scope_suffix(S, porigin?), z)
  -- if $class_at(S.CLASSES, pmethoddesc.OWNER) = (pclassdesc)
def $method_denied(S, pmethoddesc, ptbytes, porigin?, true, z) = $throw_scalar(S, "Error", $ptascii("Call to ") ++ $method_visibility_name(pmethoddesc.VISIBILITY) ++ $ptascii(" ") ++ pclassdesc.NAME ++ $ptascii("::__construct()") ++ $method_scope_suffix(S, porigin?), z)
  -- if $class_at(S.CLASSES, pmethoddesc.OWNER) = (pclassdesc)

def $new_has_ctor(S, preqbytes) = true
