def $call_selected_valid(S, CLOSURE_TARGET n, (porigin_site)) = true
  -- if $origin_node(S.SOURCES, porigin_site) = (NExprMethodCall expression phpType20 (SEQUENCE phpType7*) metadata)
  -- if $method_source_name(phpType20, $ptascii("__invoke"))
  -- if $(n < |S.OBJECTS|)
