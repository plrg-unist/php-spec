def $method_ctor_proto(S, porigin, n) = eps -- otherwise
def $method_ctor_parent_proto(S, porigin, n) = $method_ctor_proto(S, porigin_parent, $nabs($(n - 1)))
  -- if $(n > 0)
  -- if $class_link_at(S.LINKEDPARENTS, porigin) = (SOURCE_PARENT porigin_parent)
def $method_ctor_parent_proto(S, porigin, n) = eps -- otherwise

dec $method_signature_issue(pstate, pclassdesc, pmethoddesc, pclassdesc, pmethoddesc) : pmethodissue
def $method_signature_issue(S, pclassdesc_child, pmethoddesc_child, pclassdesc_parent, pmethoddesc_parent) = METHOD_OK
  -- if $pmcompare(PMUSER $pmethod_user(pmethoddesc_child, pclassdesc_child, $call_sourcefile(S.FILES, pclassdesc_child.ORIGIN)), $pmethod_scope(pclassdesc_child, $method_ancestor_names(S, pclassdesc_child.ORIGIN, |S.CLASSES|)), PMUSER $pmethod_user(pmethoddesc_parent, pclassdesc_parent, $call_sourcefile(S.FILES, pclassdesc_parent.ORIGIN)), $pmethod_scope(pclassdesc_parent, $method_ancestor_names(S, pclassdesc_parent.ORIGIN, |S.CLASSES|)), $method_active_registry(S, S.CLASSNAMES)) = PMCHECK PVYES ptbytes*
def $method_signature_issue(S, pclassdesc_child, pmethoddesc_child, pclassdesc_parent, pmethoddesc_parent) = METHOD_ISSUE pmdiagnostic.MESSAGE pmethoddesc_child.FUNCTION.LINE
  -- if $pmcompare(PMUSER $pmethod_user(pmethoddesc_child, pclassdesc_child, $call_sourcefile(S.FILES, pclassdesc_child.ORIGIN)), $pmethod_scope(pclassdesc_child, $method_ancestor_names(S, pclassdesc_child.ORIGIN, |S.CLASSES|)), PMUSER $pmethod_user(pmethoddesc_parent, pclassdesc_parent, $call_sourcefile(S.FILES, pclassdesc_parent.ORIGIN)), $pmethod_scope(pclassdesc_parent, $method_ancestor_names(S, pclassdesc_parent.ORIGIN, |S.CLASSES|)), $method_active_registry(S, S.CLASSNAMES)) = PMCHECK PVNO ptbytes*
  -- if $pmmismatch($pmethod_user(pmethoddesc_child, pclassdesc_child, $call_sourcefile(S.FILES, pclassdesc_child.ORIGIN)), $pmethod_scope(pclassdesc_child, $method_ancestor_names(S, pclassdesc_child.ORIGIN, |S.CLASSES|)), $pmethod_user(pmethoddesc_parent, pclassdesc_parent, $call_sourcefile(S.FILES, pclassdesc_parent.ORIGIN)), $pmethod_scope(pclassdesc_parent, $method_ancestor_names(S, pclassdesc_parent.ORIGIN, |S.CLASSES|)), 14) = PMDIAGNOSTIC pmdiagnostic
def $method_signature_issue(S, pclassdesc_child, pmethoddesc_child, pclassdesc_parent, pmethoddesc_parent) = METHOD_UNSUPPORTED "method signature comparison" -- otherwise

dec $method_override_one(pstate, pclassdesc, ppmethodinherited) : pmethodissue
def $method_override_one(S, pclassdesc_child, PPMINHERITED pmethoddesc_parent pclassdesc_parent) = METHOD_OK
  -- if $method_named(pclassdesc_child.METHODS, pmethoddesc_parent.NAME) = eps
def $method_override_one(S, pclassdesc_child, PPMINHERITED pmethoddesc_parent pclassdesc_parent) = METHOD_ISSUE ($ptascii("Cannot override final method ") ++ pclassdesc_parent.NAME ++ $ptascii("::") ++ pmethoddesc_child.NAME ++ $ptascii("()")) pmethoddesc_child.FUNCTION.LINE
  -- if $method_named(pclassdesc_child.METHODS, pmethoddesc_parent.NAME) = (pmethoddesc_child)
  -- if pmethoddesc_parent.FINAL
def $method_override_one(S, pclassdesc_child, PPMINHERITED pmethoddesc_parent pclassdesc_parent) = METHOD_ISSUE ($ptascii("Cannot make non abstract method ") ++ pclassdesc_parent.NAME ++ $ptascii("::") ++ pmethoddesc_child.NAME ++ $ptascii("() abstract in class ") ++ pclassdesc_child.NAME) pmethoddesc_child.FUNCTION.LINE
  -- if $method_named(pclassdesc_child.METHODS, pmethoddesc_parent.NAME) = (pmethoddesc_child)
  -- if ~pmethoddesc_parent.FINAL /\ pmethoddesc_child.ABSTRACT /\ ~pmethoddesc_parent.ABSTRACT
def $method_override_one(S, pclassdesc_child, PPMINHERITED pmethoddesc_parent pclassdesc_parent) = METHOD_OK
  -- if $method_named(pclassdesc_child.METHODS, pmethoddesc_parent.NAME) = (pmethoddesc_child)
  -- if ~pmethoddesc_parent.FINAL /\ ~(pmethoddesc_child.ABSTRACT /\ ~pmethoddesc_parent.ABSTRACT)
