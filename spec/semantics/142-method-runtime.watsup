def $method_class_private(S, porigin_class, ptbytes, (porigin_scope)) = (pmethoddesc)
  -- if $class_at(S.CLASSES, porigin_scope) = (pclassdesc_scope)
  -- if $method_named(pclassdesc_scope.METHODS, ptbytes) = (pmethoddesc)
  -- if pmethoddesc.VISIBILITY = PROPERTY_PRIVATE
  -- if $class_origin_matches(S, porigin_class, pclassdesc_scope.NAME, |S.CLASSES|)
def $method_class_private(S, porigin_class, ptbytes, porigin?) = eps -- otherwise
dec $method_lexical_private(pstate, nat, ptbytes, porigin?) : pmethoddesc?
def $method_lexical_private(S, n, ptbytes, porigin?) = $method_class_private(S, porigin_class, ptbytes, porigin?)
  -- if S.OBJECTS[n] = INSTANCE porigin_class
def $method_lexical_private(S, n, ptbytes, porigin?) = eps -- otherwise
dec $method_class_selected(pstate, porigin, ptbytes, porigin?) : pmethoddesc?
def $method_class_selected(S, porigin_class, ptbytes, porigin?) = (pmethoddesc)
  -- if $method_class_private(S, porigin_class, ptbytes, porigin?) = (pmethoddesc)
def $method_class_selected(S, porigin_class, ptbytes, porigin?) = $effective_method(S, porigin_class, ptbytes, |S.CLASSES|)
  -- if $method_class_private(S, porigin_class, ptbytes, porigin?) = eps
dec $method_selected_scope(pstate, nat, ptbytes, porigin?) : pmethoddesc?
