  -- if $class_at(S.CLASSES, porigin_class) = (pclassdesc)
  -- if $method_self_class_scope_valid(S, pclassdesc)
def $call_task_valid(S, EVAL (NExprClassConstFetch phpType19 (NIdentifier (BYTES text_member) metadata_member) metadata)) = true
