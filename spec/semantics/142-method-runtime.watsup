;; Deferred constant CLASS_NAME uses lexical scope, including rebound Closure
;; defaults. The AST no-scope error says self even for a parent request.
dec $constant_classname(pstate, ptbytes, int) : pstate
def $constant_classname(S, ptbytes, z) = $throw_scalar(S, "Error", $ptascii("Cannot use \"self\" when no class scope is active"), z)
  -- if $method_current_scope(S) = eps
def $constant_classname(S, ptbytes, z) = S[.RESULT = KNOWN (PSTRING pclassdesc.NAME)]
  -- if ptbytes = $ptascii("self")
  -- if $method_current_scope(S) = (porigin_class)
  -- if $class_at(S.CLASSES, porigin_class) = (pclassdesc)
def $constant_classname(S, ptbytes, z) = S[.RESULT = KNOWN (PSTRING pclassdesc_parent.NAME)]
  -- if ptbytes = $ptascii("parent")
  -- if $method_current_scope(S) = (porigin_class)
  -- if $class_link_at(S.LINKEDPARENTS, porigin_class) = (SOURCE_PARENT porigin_parent)
  -- if $class_at(S.CLASSES, porigin_parent) = (pclassdesc_parent)
def $constant_classname(S, ptbytes, z) = S[.RESULT = KNOWN (PSTRING $ptascii(text))]
  -- if ptbytes = $ptascii("parent")
  -- if $method_current_scope(S) = (porigin_class)
  -- if $class_link_at(S.LINKEDPARENTS, porigin_class) = (INTERNAL_THROWABLE_PARENT text)
def $constant_classname(S, ptbytes, z) = $throw_scalar(S, "Error", $ptascii("Cannot use \"parent\" when current class scope has no parent"), z)
  -- if ptbytes = $ptascii("parent")
  -- if $method_current_scope(S) = (porigin_class)
  -- if $class_at(S.CLASSES, porigin_class) = (pclassdesc)
  -- if pclassdesc.PARENT = eps
rule PhpStep/constant-classname: S ~> $constant_classname(S[.TODO = ptask_tail*], $pfclassname_keyword(phpType19), $runtime_line(S, eps, NExprClassConstFetch phpType19 phpType20 metadata))
  -- if S.TODO = (EVAL (NExprClassConstFetch phpType19 phpType20 metadata)) :: ptask_tail*
  -- if S.CONSTCONTEXT =/= eps
  -- if $pfclassname_keyword(phpType19) <- [$ptascii("self"), $ptascii("parent")]
  -- if $pfclassname_member(phpType20)
  -- if $method_source_task(S, NExprClassConstFetch phpType19 phpType20 metadata)
dec $method_self_class_scope_valid(pstate, pclassdesc) : bool
def $method_self_class_scope_valid(S, pclassdesc) = ($class_named(S.CLASSNAMES, $ptlc(pclassdesc.NAME)) = (pclassdesc.ORIGIN)) -- otherwise
rule PhpStep/method-self-class: S ~> S[.TODO = ptask_tail*][.RESULT = KNOWN (PSTRING pclassdesc.NAME)]
  -- if S.TODO = (EVAL (NExprClassConstFetch phpType19 (NIdentifier (BYTES text_member) metadata_member) metadata)) :: ptask_tail*
