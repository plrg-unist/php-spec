dec $method_source_name(phpType20, ptbytes) : bool
def $method_source_name(NIdentifier (BYTES text) metadata, ptbytes) = ($ptlc($base64(text)) = $ptlc(ptbytes))
def $method_source_name(expression_name, ptbytes) = true
  -- if $property_computed_name(expression_name)
def $method_source_name(phpType20, ptbytes) = false -- otherwise

;; A selected call can be paused in its caller, or already entered with the
;; caller saved immediately below it. Recover the executed scope from that
;; call chain rather than the selected method's declaring class.
dec $method_context_scope(pcallcontext?) : porigin?
def $method_context_scope((pcallcontext)) = pcallcontext.LEXICAL_CLASS
def $method_context_scope(eps) = eps
dec $method_target_caller(pcallcontext?, pframe*, porigin, porigin) : porigin?
def $method_target_caller((pcallcontext), pframe :: pframe_tail*, porigin_method, porigin_site) = $method_context_scope(pframe.CONTEXT)
  -- if pcallcontext.FUNCTION = porigin_method
  -- if pcallcontext.CALLSITE = (porigin_site)
  -- if pframe.ORIGIN = (porigin_site)
def $method_target_caller((pcallcontext), pframe :: pframe_tail*, porigin_method, porigin_site) = $method_target_caller(pframe.CONTEXT, pframe_tail*, porigin_method, porigin_site)
  -- if ~(pcallcontext.FUNCTION = porigin_method /\ pcallcontext.CALLSITE = (porigin_site) /\ pframe.ORIGIN = (porigin_site))
def $method_target_caller(eps, pframe :: pframe_tail*, porigin_method, porigin_site) = $method_target_caller(pframe.CONTEXT, pframe_tail*, porigin_method, porigin_site)
def $method_target_caller(pcallcontext?, eps, porigin_method, porigin_site) = eps
dec $method_frame_site_scope(pstate, pframe*, pfunction?) : porigin?
def $method_frame_site_scope(S, pframe :: pframe_tail*, pfunction?) = $method_context_scope(pframe.CONTEXT)
  -- if $goto_owner_scope(pframe.CONTEXT, pfunction?)
def $method_frame_site_scope(S, pframe :: pframe_tail*, pfunction?) = $method_frame_site_scope(S, pframe_tail*, pfunction?)
  -- if ~$goto_owner_scope(pframe.CONTEXT, pfunction?)
def $method_frame_site_scope(S, eps, pfunction?) = eps
dec $constructor_source_name(pstate, pcalltarget, porigin) : preqbytes?
dec $dynamic_new_entered(pstate, pcalltarget, porigin) : bool
def $dynamic_new_entered(S, pcalltarget, porigin) = false -- otherwise
def $constructor_source_name(S, pcalltarget, porigin) = $new_source_name(S, porigin) -- if ~$dynamic_new_entered(S, pcalltarget, porigin)
dec $method_site_scope(pstate, porigin, porigin) : porigin?
dec $generator_method_scope_kind(pstate, porigin, porigin) : bool
dec $method_entered_here(pstate, porigin, porigin) : bool
def $method_entered_here(S, porigin_method, porigin_site) = true
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.FUNCTION = porigin_method
  -- if pcallcontext.CALLSITE = (porigin_site)
def $method_entered_here(S, porigin_method, porigin_site) = false -- otherwise
def $method_site_scope(S, porigin_method, porigin_site) = $method_target_caller(S.CURRENT, S.FRAMES, porigin_method, porigin_site)
  -- if $method_entered_here(S, porigin_method, porigin_site)
  -- if ~$generator_method_scope_kind(S, porigin_method, porigin_site)
def $method_site_scope(S, porigin_method, PORIGIN n_unit pcpath) = $method_context_scope(S.CURRENT)
  -- if ~$method_entered_here(S, porigin_method, PORIGIN n_unit pcpath)
  -- if ~$generator_method_scope_kind(S, porigin_method, PORIGIN n_unit pcpath)
  -- if $goto_source_owner($all_functions(S), n_unit, pcpath) = pfunction?
  -- if $goto_owner_scope(S.CURRENT, pfunction?)
def $method_site_scope(S, porigin_method, PORIGIN n_unit pcpath) = $method_frame_site_scope(S, S.FRAMES, $goto_source_owner($all_functions(S), n_unit, pcpath))
  -- if ~$method_entered_here(S, porigin_method, PORIGIN n_unit pcpath)
  -- if ~$generator_method_scope_kind(S, porigin_method, PORIGIN n_unit pcpath)
  -- if ~$goto_owner_scope(S.CURRENT, $goto_source_owner($all_functions(S), n_unit, pcpath))
dec $scoped_caller_frame(pcallcontext?, pframe*, porigin, porigin) : pcallcontext?
def $scoped_caller_frame((pcallcontext), pframe :: pframe_tail*, porigin_method, porigin_site) = pframe.CONTEXT
  -- if pcallcontext.FUNCTION = porigin_method
  -- if pcallcontext.CALLSITE = (porigin_site)
  -- if pframe.ORIGIN = (porigin_site)
def $scoped_caller_frame((pcallcontext), pframe :: pframe_tail*, porigin_method, porigin_site) = $scoped_caller_frame(pframe.CONTEXT, pframe_tail*, porigin_method, porigin_site)
  -- if ~(pcallcontext.FUNCTION = porigin_method /\ pcallcontext.CALLSITE = (porigin_site) /\ pframe.ORIGIN = (porigin_site))
def $scoped_caller_frame(eps, pframe :: pframe_tail*, porigin_method, porigin_site) = $scoped_caller_frame(pframe.CONTEXT, pframe_tail*, porigin_method, porigin_site)
def $scoped_caller_frame(pcallcontext?, eps, porigin_method, porigin_site) = eps
dec $scoped_frame_site_context(pframe*, pfunction?) : pcallcontext?
def $scoped_frame_site_context(pframe :: pframe_tail*, pfunction?) = pframe.CONTEXT
  -- if $goto_owner_scope(pframe.CONTEXT, pfunction?)
def $scoped_frame_site_context(pframe :: pframe_tail*, pfunction?) = $scoped_frame_site_context(pframe_tail*, pfunction?)
  -- if ~$goto_owner_scope(pframe.CONTEXT, pfunction?)
def $scoped_frame_site_context(eps, pfunction?) = eps
dec $scoped_site_context(pstate, porigin, porigin) : pcallcontext?
def $scoped_site_context(S, porigin_method, porigin_site) = $scoped_caller_frame(S.CURRENT, S.FRAMES, porigin_method, porigin_site)
  -- if $method_entered_here(S, porigin_method, porigin_site)
def $scoped_site_context(S, porigin_method, PORIGIN n_unit pcpath) = S.CURRENT
  -- if ~$method_entered_here(S, porigin_method, PORIGIN n_unit pcpath)
  -- if $goto_owner_scope(S.CURRENT, $goto_source_owner($all_functions(S), n_unit, pcpath))
def $scoped_site_context(S, porigin_method, PORIGIN n_unit pcpath) = $scoped_frame_site_context(S.FRAMES, $goto_source_owner($all_functions(S), n_unit, pcpath))
  -- if ~$method_entered_here(S, porigin_method, PORIGIN n_unit pcpath)
  -- if ~$goto_owner_scope(S.CURRENT, $goto_source_owner($all_functions(S), n_unit, pcpath))
dec $method_call_origin_valid(pstate, nat, pmethoddesc, porigin) : bool
def $method_call_origin_valid(S, n, pmethoddesc, porigin_site) = true
  -- if porigin_scope? = $method_site_scope(S, pmethoddesc.FUNCTION.ORIGIN, porigin_site)
  -- if $method_selected_scope(S, n, pmethoddesc.NAME, porigin_scope?) = (pmethoddesc)
  -- if $method_accessible(S, pmethoddesc, porigin_scope?)
def $method_call_origin_valid(S, n, pmethoddesc, porigin_site) = false -- otherwise
dec $static_method_call_origin_valid(pstate, porigin, pmethoddesc, porigin) : bool
def $static_method_call_origin_valid(S, porigin_class, pmethoddesc, porigin_site) = true
  -- if porigin_scope? = $method_site_scope(S, pmethoddesc.FUNCTION.ORIGIN, porigin_site)
