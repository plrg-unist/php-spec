  -- if phpType14 =/= SEQUENCE eps
  -- if $origin_source(porigin) = PORIGIN n_unit pcpath
  -- if $(|pcpath| >= 2)
  -- if pcpath_method = pcpath[0:$nabs($(|pcpath| - 2))]
  -- if pcpath[$nabs($(|pcpath| - 2))] = PCFIELD 4
  -- if pcpath[$nabs($(|pcpath| - 1))] = PCINDEX n
  -- if $class_method_origin(S.CLASSES, PORIGIN n_unit pcpath_method) = (pmethoddesc)
  -- if $promotion_source(S, pmethoddesc.FUNCTION) = (SEQUENCE phpType17*)
  -- if $(n < |phpType17*|)
  -- if phpType17*[n] = NParam phpType14 phpType24 phpType18 phpType4_ref phpType4_var phpType10 phpType5 phpType37 metadata
