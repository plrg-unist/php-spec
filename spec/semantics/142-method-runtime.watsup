;; Promotion reads the current parameter cell after all receives, before the
;; original body. No synthetic AST, cached RHS, or extra receiver owner is used.
dec $promotion_source(pstate, pfunction) : phpType16?
dec $promotion_tasks_from(porigin, phpType17*, nat) : ptask*
dec $promotion_task(porigin, nat, psinput) : ptask*
dec $promotion_raw(pstate, pfunction, nat) : psraw?
dec $promotion_attribute_context(pfunction) : ptcontext
dec $promotion_descriptor(pstate, pfunction, nat) : ppropertydesc?
dec $promotion_type_scope(pclassdesc) : ptscope
dec $trait_data_import_type(pclassdesc, ptbranch*) : ptbranch*
dec $promotion_task_valid(pstate, porigin, nat) : bool
dec $promotion_write(pstate, nat, ptbytes, nat, psraw) : pstate
dec $promotion_write_reference(pstate, nat, ptbytes, nat, int) : pstate

def $promotion_source(S, pfunction) = (SEQUENCE phpType17*)
  -- if $origin_node(S.SOURCES, pfunction.ORIGIN) = (NStmtClassMethod phpType14 (INTEGER flags) phpType4 (NIdentifier (BYTES text) metadata_name) (SEQUENCE phpType17*) phpType18 (SEQUENCE statement*) metadata)
  -- if $iterator_notice_attributes(pfunction.ENV, phpType14)
  -- if $ptlc($base64(text)) = $ptascii("__construct")
  -- if ~$ppproperty_flag(flags, 8) /\ ~$ppproperty_flag(flags, 16)
def $promotion_source(S, pfunction) = eps -- otherwise
def $promotion_tasks(S, pfunction) = $promotion_tasks_from(pfunction.ORIGIN, phpType17*, 0)
  -- if $promotion_source(S, pfunction) = (SEQUENCE phpType17*)
def $promotion_tasks(S, pfunction) = eps -- otherwise
def $promotion_tasks_from(porigin, eps, n) = eps
def $promotion_tasks_from(porigin, phpType17 :: phpType17_tail*, n) = $promotion_task(porigin, n, $pslower(phpType17)) ++ $promotion_tasks_from(porigin, phpType17_tail*, $(n + 1))
def $promotion_task(porigin, n, PSINPUT psraw) = [PROMOTE_PARAMETER porigin n] -- if psraw.FLAGS =/= 0
def $promotion_task(porigin, n, PSINPUTATTRIBUTES psraw phpType14) = $promotion_task(porigin, n, PSINPUT psraw)
def $promotion_task(porigin, n, psinput) = eps -- otherwise

def $promotion_raw(S, pfunction, n) = (psraw)
  -- if $promotion_source(S, pfunction) = (SEQUENCE phpType17*)
  -- if $(n < |phpType17*|) /\ $(n < |pfunction.SIGNATURE.PARAMETERS|)
  -- if $pspromotion_raw($promotion_attribute_context(pfunction), $pslower(phpType17*[n])) = (psraw)
  -- if psraw.FLAGS =/= 0 /\ ~psraw.EXTRA /\ ~psraw.VARIADIC
  -- if $ppproperty_supported(psraw.FLAGS) /\ ~$ppproperty_flag(psraw.FLAGS, 8)
  -- if psraw.NAME = pfunction.SIGNATURE.PARAMETERS[n].NAME
  -- if psraw.BYREF = pfunction.SIGNATURE.PARAMETERS[n].BYREF
  -- if ~pfunction.SIGNATURE.PARAMETERS[n].VARIADIC
def $promotion_raw(S, pfunction, n) = eps -- otherwise
def $promotion_attribute_context(pfunction) = { NAMESPACE pfunction.ENV.NAMESPACE, IMPORTS pfunction.ENV.CLASSES, SCOPE PTGLOBAL, POSITION PTPARAMETER, OWNER eps, MEMBER eps, FILE eps, LINE 0 }

;; Override belongs to the effective promoted property, including a retained
;; trait declaration. Compatible collisions keep the surviving source origin.
dec $trait_data_property(pclassdesc, ppropertydesc) : ppropertydesc
dec $trait_restore(pstate, pstate) : pstate
dec $promotion_override_property(pstate, pclassdesc, ppropertydesc) : bool
dec $promotion_override_parent_layout(pstate, pclassdesc) : ppropertydesc*
dec $promotion_override_parent_match(ppropertydesc*, ptbytes) : bool
dec $promotion_override_issue(pstate, pclassdesc, ppropertydesc*, ppropertydesc*) : ptbytes?
dec $promotion_override_finish(pstate, pclassdesc, pstate) : pstate

def $promotion_override_property(S, pclassdesc, ppropertydesc) = true
  -- if $class_at(S.CLASSES, pclassdesc.ORIGIN) = (pclassdesc)
