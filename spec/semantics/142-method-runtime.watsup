;; Linking scans the parent's effective insertion order. Method resolution and
;; type variance both use the active parent graph, including conditional classes.
dec $method_info_layout(pstate, porigin, nat) : ppmethodinherited*
def $method_info_layout(S, porigin, 0) = eps
def $method_info_layout(S, porigin, n) = $ppmethod_own(pclassdesc, pclassdesc.METHODS) ++ $ppmethod_extra($method_info_layout(S, porigin_parent, $nabs($(n - 1))), pclassdesc.METHODS)
  -- if $(n > 0)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if $class_link_at(S.LINKEDPARENTS, porigin) = (SOURCE_PARENT porigin_parent)
def $method_info_layout(S, porigin, n) = $ppmethod_own(pclassdesc, pclassdesc.METHODS)
  -- if $(n > 0)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if $class_link_at(S.LINKEDPARENTS, porigin) = eps
def $method_info_layout(S, porigin, n) = $ppmethod_own(pclassdesc, pclassdesc.METHODS)
  -- if $(n > 0)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if $class_link_at(S.LINKEDPARENTS, porigin) = (STDCLASS_PARENT)
def $method_info_layout(S, porigin, n) = eps -- otherwise

dec $method_ancestor_names(pstate, porigin, nat) : ptbytes*
def $method_ancestor_names(S, porigin, 0) = eps
def $method_ancestor_names(S, porigin, n) = [pclassdesc_parent.NAME] ++ $method_ancestor_names(S, porigin_parent, $nabs($(n - 1)))
  -- if $(n > 0)
  -- if $class_link_at(S.LINKEDPARENTS, porigin) = (SOURCE_PARENT porigin_parent)
  -- if $class_at(S.CLASSES, porigin_parent) = (pclassdesc_parent)
def $method_ancestor_names(S, porigin, n) = [$ptascii("stdClass")]
  -- if $(n > 0)
  -- if $class_link_at(S.LINKEDPARENTS, porigin) = (STDCLASS_PARENT)
def $method_ancestor_names(S, porigin, n) = eps -- otherwise
dec $method_active_registry(pstate, (preqbytes, porigin)*) : pvclasses
def $method_active_registry(S, eps) = [($ptascii("stdclass"), {NAME $ptascii("stdClass"), PARENT eps, ANCESTORS eps, FINAL false})]
def $method_active_registry(S, (preqbytes, porigin) :: (preqbytes_tail, porigin_tail)*) = [($ptlc(pclassdesc.NAME), $pmethod_scope(pclassdesc, $method_ancestor_names(S, porigin, |S.CLASSES|)))] ++ $method_active_registry(S, (preqbytes_tail, porigin_tail)*)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)

dec $method_ctor_proto(pstate, porigin, nat) : ppmethodinherited?
