dec $method_current_scope(pstate) : porigin?
def $method_current_scope(S) = pcallcontext.LEXICAL_CLASS -- if S.CURRENT = (pcallcontext) -- if ~$class_constant_active(S) -- if $static_default_scope(S) = eps
def $method_current_scope(S) = eps -- if S.CURRENT = eps /\ ~$class_constant_active(S) -- if $static_default_scope(S) = eps
dec $method_called_scope(pstate) : porigin?
def $method_called_scope(S) = pcallcontext.CALLED_CLASS -- if S.CURRENT = (pcallcontext)
def $method_called_scope(S) = eps -- otherwise

dec $method_prototype(pstate, porigin, ptbytes, nat) : porigin
def $method_prototype(S, porigin, ptbytes, n) = $method_prototype(S, porigin_parent, ptbytes, $nabs($(n - 1)))
  -- if $(n > 0)
  -- if $class_link_at(S.LINKEDPARENTS, porigin) = (SOURCE_PARENT porigin_parent)
  -- if $effective_method(S, porigin_parent, ptbytes, |S.CLASSES|) = (pmethoddesc_parent)
