  -- if (ppropertydesc = ppropertydesc_source /\ pclassdesc.ORIGIN = pmethoddesc.OWNER) \/ (pclassdesc_source.KIND = "trait" /\ ppropertydesc = $trait_data_property(pclassdesc, ppropertydesc_source))
def $promotion_override_property(S, pclassdesc, ppropertydesc) = false -- otherwise

def $promotion_override_parent_layout(S, pclassdesc) = $property_info_layout(S, porigin_parent, |S.CLASSES|)
  -- if $class_link_at(S.LINKEDPARENTS, pclassdesc.ORIGIN) = (SOURCE_PARENT porigin_parent)
def $promotion_override_parent_layout(S, pclassdesc) = $throwable_layout(text_kind)
  -- if $class_link_at(S.LINKEDPARENTS, pclassdesc.ORIGIN) = (INTERNAL_THROWABLE_PARENT text_kind)
def $promotion_override_parent_layout(S, pclassdesc) = eps -- otherwise
def $promotion_override_parent_match(ppropertydesc_parent*, ptbytes) = (ppropertydesc_found.VISIBILITY =/= PROPERTY_PRIVATE)
  -- if $ppproperty_desc_at(ppropertydesc_parent*, ptbytes) = (ppropertydesc_found)
def $promotion_override_parent_match(ppropertydesc*, ptbytes) = false -- otherwise
def $promotion_override_issue(S, pclassdesc, ppropertydesc_parent*, eps) = eps
def $promotion_override_issue(S, pclassdesc, ppropertydesc_parent*, ppropertydesc :: ppropertydesc_tail*) = (pclassdesc.NAME ++ $ptascii("::$") ++ ppropertydesc.NAME ++ $ptascii(" has #[\\Override] attribute, but no matching parent property exists"))
  -- if $promotion_override_property(S, pclassdesc, ppropertydesc)
  -- if ~$promotion_override_parent_match(ppropertydesc_parent*, ppropertydesc.NAME)
def $promotion_override_issue(S, pclassdesc, ppropertydesc_parent*, ppropertydesc :: ppropertydesc_tail*) = $promotion_override_issue(S, pclassdesc, ppropertydesc_parent*, ppropertydesc_tail*)
  -- if ~$promotion_override_property(S, pclassdesc, ppropertydesc) \/ $promotion_override_parent_match(ppropertydesc_parent*, ppropertydesc.NAME)

;; Ordinary inheritance diagnostics precede this check. A failure restores the
;; attempted publication through the existing class/trait rollback protocol.
def $promotion_override_finish(S, pclassdesc, S_linked) = S_linked
  -- if S_linked.COMPLETION =/= NORMAL \/ pclassdesc.KIND = "trait"
def $promotion_override_finish(S, pclassdesc, S_linked) = S_linked
  -- if S_linked.COMPLETION = NORMAL /\ pclassdesc.KIND =/= "trait"
  -- if $class_at(S_linked.CLASSES, pclassdesc.ORIGIN) = (pclassdesc_effective)
  -- if $promotion_override_issue(S_linked, pclassdesc_effective, $promotion_override_parent_layout(S_linked, pclassdesc_effective), pclassdesc_effective.PROPERTIES) = eps
def $promotion_override_finish(S, pclassdesc, S_linked) = $trait_restore(S, $pil_method_fatal(S_linked, pclassdesc.ORIGIN, ptbytes_message, pclassdesc.LINE))
  -- if S_linked.COMPLETION = NORMAL /\ pclassdesc.KIND =/= "trait"
  -- if $class_at(S_linked.CLASSES, pclassdesc.ORIGIN) = (pclassdesc_effective)
  -- if $promotion_override_issue(S_linked, pclassdesc_effective, $promotion_override_parent_layout(S_linked, pclassdesc_effective), pclassdesc_effective.PROPERTIES) = (ptbytes_message)

;; A trait keeps its declaration certificate even if a compatible class or
;; earlier trait supplies the effective slot. Scope resolves the actual target.
def $promotion_descriptor(S, pfunction, n) = (ppropertydesc)
  -- if $promotion_raw(S, pfunction, n) = (psraw)
  -- if $class_method_origin(S.CLASSES, $origin_source(pfunction.ORIGIN)) = (pmethoddesc_source)
