;; Closure::__invoke is an internal trampoline. Its original sent operands
;; remain owned separately from the weakly received callee parameters.
dec $wrapper_site(pstate, pcalltarget, porigin?) : bool
def $wrapper_site(S, CLOSURE_TARGET n, (porigin)) = $exit_method_site(S, porigin)
def $wrapper_site(S, pcalltarget, porigin?) = false -- otherwise
def $wrapper_after_enter(S, pnamedargs) = S[.CURRENT = (pcallcontext[.WRAPPER = (pnamedargs)])]
  -- if S.CURRENT = (pcallcontext)
  -- if $wrapper_site(S, $context_target(pcallcontext), pcallcontext.CALLSITE)
def $wrapper_after_enter(S, pnamedargs) = S -- otherwise
def $wrapper_send_name(S, pcalltarget, porigin?, preqbytes) = $ptascii("Closure::__invoke")
  -- if $wrapper_site(S, pcalltarget, porigin?)
def $wrapper_send_name(S, pcalltarget, porigin?, preqbytes) = preqbytes -- otherwise
def $wrapper_called_suffix(S, pcallcontext) = eps -- if pcallcontext.WRAPPER =/= eps
def $wrapper_called_suffix(S, pcallcontext) = $ptascii(", called in ") ++ $call_sourcefile(S.FILES, porigin) ++ $ptascii(" on line ") ++ $decimal_integer(pcallcontext.LINE)
  -- if pcallcontext.WRAPPER = eps
  -- if pcallcontext.CALLSITE = (porigin)
dec $wrapper_values(pstate, pnamedslot*) : pvalue*
def $wrapper_values(S, eps) = eps
def $wrapper_values(S, NAMED_HOLE :: pnamedslot*) = PNULL :: $wrapper_values(S, pnamedslot*)
def $wrapper_values(S, (NAMED_SENT poperand) :: pnamedslot*) = $variadic_operand_value(S, poperand) :: $wrapper_values(S, pnamedslot*)
def $wrapper_trace(S, pcallcontext) = eps -- if pcallcontext.WRAPPER = eps
def $wrapper_trace(S, pcallcontext) = [{FILE $call_sourcefile(S.FILES, porigin), LINE pcallcontext.LINE, NAME $ptascii("Closure->__invoke"), VALUES (pvalue* ++ $named_values(S, pnamedargs.NAMED)), ARGTEXT $named_trace_arguments(S, pvalue*, pnamedargs.NAMED)}]
  -- if pcallcontext.WRAPPER = (pnamedargs)
  -- if pcallcontext.CALLSITE = (porigin)
  -- if pvalue* = $wrapper_values(S, pnamedargs.SLOTS)
def $wrapper_context_valid(S, pcallcontext) = true
  -- if ~$wrapper_site(S, $context_target(pcallcontext), pcallcontext.CALLSITE)
  -- if pcallcontext.WRAPPER = eps
def $wrapper_context_valid(S, pcallcontext) = true
  -- if $wrapper_site(S, $context_target(pcallcontext), pcallcontext.CALLSITE)
  -- if pcallcontext.WRAPPER = (pnamedargs)
  -- if |pnamedargs.SLOTS| = pcallcontext.ARGC
  -- if ~$call_unpack_site(S, pcallcontext.CALLSITE)
  -- if $unpack_static_prefix(S, $context_target(pcallcontext), $wrapper_arguments(S, pcallcontext), pnamedargs)
def $wrapper_context_valid(S, pcallcontext) = true
  -- if $wrapper_site(S, $context_target(pcallcontext), pcallcontext.CALLSITE)
  -- if pcallcontext.WRAPPER = (pnamedargs)
  -- if |pnamedargs.SLOTS| = pcallcontext.ARGC
  -- if $call_unpack_site(S, pcallcontext.CALLSITE)
  -- if $unpack_slots_valid(S, $context_target(pcallcontext), 0, pnamedargs.SLOTS)
  -- if $unpack_names_valid(S, $context_target(pcallcontext), pnamedargs.NAMED)
def $wrapper_context_valid(S, pcallcontext) = false -- otherwise
def $wrapper_arguments(S, pcallcontext) = phpType7*
  -- if pcallcontext.CALLSITE = (porigin)
  -- if $call_argument_source(S, porigin) = PCALLARGUMENTS phpType7* n_field
def $wrapper_passed_suffix(S, pcallcontext) = $ptascii(" passed") -- if pcallcontext.WRAPPER =/= eps
def $wrapper_passed_suffix(S, pcallcontext) = $ptascii(" passed in ") ++ $call_sourcefile(S.FILES, porigin) ++ $ptascii(" on line ") ++ $decimal_integer(pcallcontext.LINE)
  -- if pcallcontext.WRAPPER = eps
  -- if pcallcontext.CALLSITE = (porigin)

def $acquire_call_valid(S) = true
  -- if S.ORIGIN = (porigin)
  -- if $origin_node(S.SOURCES, porigin) = (NExprMethodCall expression_receiver phpType20 phpType6 metadata_call)
  -- if $acquire_call_parent(S) = (NExprAssignRef expression (NExprMethodCall expression_receiver phpType20 phpType6 metadata_call) metadata)
rule PhpStep/acquire-method-call: S ~> S[.TODO = [EVAL (NExprMethodCall expression phpType20 phpType6 metadata), ACQUIRE_CALL] ++ ptask_tail*]
  -- if S.TODO = (ACQUIRE (NExprMethodCall expression phpType20 phpType6 metadata)) :: ptask_tail*
  -- if $acquire_call_valid(S)
def $reference_value_call(S) = true
  -- if S.ORIGIN = (porigin)
  -- if $origin_node(S.SOURCES, porigin) = (NExprAssignRef expression_target (NExprMethodCall expression phpType20 phpType6 metadata_call) metadata)
  -- if S.RESULT = KNOWN pvalue
def $reference_assignment_root(pcoccurrence*, pcpath) = true
  -- if $occurrence_node(pcoccurrence*, pcpath) = (NExprAssignRef expression_target (NExprMethodCall expression phpType20 phpType6 metadata_call) metadata)
