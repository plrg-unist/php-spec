def $wrapper_site(S, CLOSURE_TARGET n, (porigin)) = $exit_method_site(S, porigin)
def $wrapper_site(S, pcalltarget, porigin?) = false -- otherwise
def $wrapper_after_enter(S, pnamedargs) = S[.CURRENT = (pcallcontext[.WRAPPER = (pnamedargs)])]
  -- if S.CURRENT = (pcallcontext)
  -- if $wrapper_site(S, $context_target(pcallcontext), pcallcontext.CALLSITE)
def $wrapper_after_enter(S, pnamedargs) = S -- otherwise
def $wrapper_send_name(S, pcalltarget, porigin?, preqbytes) = $ptascii("Closure::__invoke")
  -- if $wrapper_site(S, pcalltarget, porigin?)
def $wrapper_send_name(S, pcalltarget, porigin?, preqbytes) = preqbytes -- otherwise
def $wrapper_called_suffix(S, pcallcontext) = eps -- if pcallcontext.WRAPPER =/= eps
def $wrapper_called_suffix(S, pcallcontext) = $ptascii(", called in ") ++ $call_sourcefile(S.FILES, porigin) ++ $ptascii(" on line ") ++ $decimal_integer(pcallcontext.LINE)
