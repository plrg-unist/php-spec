;; A receiver operand retains its expression result kind across a computed
;; method name: a CV can be reread, while a fetched property is already a value.
dec $method_capture(pstate, bool, int) : (pstate, poperand)
dec $method_base_value(pbase) : bool
def $method_base_value(BASE_VALUE poperand) = true
def $method_base_value(pbase) = false -- otherwise
def $method_capture(S, false, z) = (S, S.RESULT)
def $method_capture(S, true, z) = (S, poperand)
  -- if S.BASE = BASE_VALUE poperand
def $method_capture(S, true, z) = (S_read, S_read.RESULT)
  -- if S.BASE =/= BASE_SHORT
  -- if ~$method_base_value(S.BASE)
  -- if S_read = $base_read(S, S.BASE, z)

dec $method_args_task(pcalltarget, phpType7*, porigin?, int) : ptask
def $method_args_task(pcalltarget, phpType7*, porigin?, z) = UNPACK_ARGS {FUNCTION pcalltarget, ARGUMENTS phpType7*, INDEX 0, SENT {SLOTS eps, NAMED eps}, CALLSITE porigin?, LINE z}
  -- if $call_unpack_present(phpType7*)
def $method_args_task(pcalltarget, phpType7*, porigin?, z) = NAMED_ARGS pcalltarget phpType7* 0 {SLOTS eps, NAMED eps} porigin? z
  -- if ~$call_unpack_present(phpType7*)
  -- if $named_present(phpType7*)
def $method_args_task(pcalltarget, phpType7*, porigin?, z) = CALL_ARGS pcalltarget phpType7* 0 eps porigin? z
  -- if ~$named_present(phpType7*)

