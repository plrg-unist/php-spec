;; Class-owned methods are callable targets only through an active receiver.
dec $method_functions(pmethoddesc*) : pfunction*
def $method_functions(eps) = eps
def $method_functions(pmethoddesc :: pmethoddesc_tail*) = pmethoddesc.FUNCTION :: $method_functions(pmethoddesc_tail*)
def $class_method_functions(eps) = eps
def $class_method_functions(pclassdesc :: pclassdesc_tail*) = $method_functions(pclassdesc.METHODS) ++ $class_method_functions(pclassdesc_tail*)

dec $method_named(pmethoddesc*, ptbytes) : pmethoddesc?
def $method_named(eps, ptbytes) = eps
def $method_named(pmethoddesc :: pmethoddesc_tail*, ptbytes) = (pmethoddesc)
  -- if $ptlc(pmethoddesc.NAME) = $ptlc(ptbytes)
def $method_named(pmethoddesc :: pmethoddesc_tail*, ptbytes) = $method_named(pmethoddesc_tail*, ptbytes)
  -- if $ptlc(pmethoddesc.NAME) =/= $ptlc(ptbytes)

dec $method_origin(pmethoddesc*, porigin) : pmethoddesc?
def $method_origin(eps, porigin) = eps
def $method_origin(pmethoddesc :: pmethoddesc_tail*, porigin) = (pmethoddesc)
  -- if pmethoddesc.FUNCTION.ORIGIN = porigin
def $method_origin(pmethoddesc :: pmethoddesc_tail*, porigin) = $method_origin(pmethoddesc_tail*, porigin)
  -- if pmethoddesc.FUNCTION.ORIGIN =/= porigin
def $class_method_origin(eps, porigin) = eps
def $class_method_origin(pclassdesc :: pclassdesc_tail*, porigin) = (pmethoddesc)
  -- if $method_origin(pclassdesc.METHODS, porigin) = (pmethoddesc)
def $class_method_origin(pclassdesc :: pclassdesc_tail*, porigin) = $class_method_origin(pclassdesc_tail*, porigin)
  -- if $method_origin(pclassdesc.METHODS, porigin) = eps

dec $effective_method(pstate, porigin, ptbytes, nat) : pmethoddesc?
def $effective_method(S, porigin, ptbytes, 0) = eps
def $effective_method(S, porigin, ptbytes, n) = (pmethoddesc)
  -- if $(n > 0)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if $method_named(pclassdesc.METHODS, ptbytes) = (pmethoddesc)
def $effective_method(S, porigin, ptbytes, n) = $effective_method(S, porigin_parent, ptbytes, $nabs($(n - 1)))
  -- if $(n > 0)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if $method_named(pclassdesc.METHODS, ptbytes) = eps
  -- if $class_link_at(S.LINKEDPARENTS, porigin) = (SOURCE_PARENT porigin_parent)
def $effective_method(S, porigin, ptbytes, n) = eps -- otherwise

def $new_has_ctor(S, preqbytes) = true
  -- if $class_named(S.CLASSNAMES, $ptlc(preqbytes)) = (porigin_class)
  -- if $effective_method(S, porigin_class, $ptascii("__construct"), |S.CLASSES|) = (pmethoddesc)
def $new_has_ctor(S, preqbytes) = false -- otherwise

def $target_nodes(METHOD_TARGET n porigin) = [HOBJECT n]
def $target_instance(METHOD_TARGET n porigin) = eps
def $target_receiver(S, METHOD_TARGET n porigin) = (n)
def $target_lexical_class(S, METHOD_TARGET n porigin) = (pmethoddesc.OWNER)
  -- if $class_method_origin(S.CLASSES, porigin) = (pmethoddesc)
def $target_lexical_class(S, pcalltarget) = eps -- otherwise
def $target_called_class(S, METHOD_TARGET n porigin) = (porigin_class)
  -- if $(n < |S.OBJECTS|)
  -- if S.OBJECTS[n] = INSTANCE porigin_class
def $target_called_class(S, pcalltarget) = eps -- otherwise
def $target_function(S, METHOD_TARGET n porigin) = (pmethoddesc.FUNCTION)
  -- if $(n < |S.OBJECTS|)
  -- if (HOBJECT n) <- S.ALLOCATIONS
  -- if S.OBJECTS[n] = INSTANCE porigin_class
  -- if $class_at(S.CLASSES, porigin_class) = (pclassdesc)
  -- if $class_named(S.CLASSNAMES, $ptlc(pclassdesc.NAME)) = (porigin_class)
  -- if $class_links_valid(S)
  -- if $class_method_origin(S.CLASSES, porigin) = (pmethoddesc)
  -- if $effective_method(S, porigin_class, pmethoddesc.NAME, |S.CLASSES|) = (pmethoddesc)
def $target_function(S, pcalltarget) = eps -- otherwise

