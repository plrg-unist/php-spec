  -- if $origin_source(pfunction.ORIGIN) = PORIGIN n_unit pcpath
  -- if ppropertydesc.ORIGIN = PORIGIN n_unit (pcpath ++ [PCFIELD 4, PCINDEX n])
  -- if ppropertydesc.NAME = psraw.NAME
  -- if ppropertydesc.KEY = $ppproperty_key(psraw.FLAGS, psraw.NAME, pclassdesc_source.NAME)
  -- if ppropertydesc.VISIBILITY = $ppproperty_visibility(psraw.FLAGS)
  -- if ppropertydesc.READONLY = ($ppproperty_flag(psraw.FLAGS, 64) \/ pclassdesc_source.READONLY)
  -- if ppropertydesc.SETVISIBILITY = $ppproperty_declared_set(psraw.FLAGS, ppropertydesc.READONLY)
  -- if ppropertydesc.FINAL = $ppproperty_final(psraw.FLAGS) /\ ~ppropertydesc.STATIC
  -- if $ptype_normalize(psraw.TYPE, {NAMESPACE pmethoddesc_source.FUNCTION.ENV.NAMESPACE, IMPORTS pmethoddesc_source.FUNCTION.ENV.CLASSES, SCOPE $promotion_type_scope(pclassdesc_source), POSITION PTPROPERTY, OWNER pclassdesc_source.NAME, MEMBER psraw.NAME, FILE $call_sourcefile(S.FILES, pmethoddesc_source.FUNCTION.ORIGIN), LINE psraw.LINE}) = PTOK ptbranch* ptdiagnostic*
  -- if $ppproperty_type_equal(ppropertydesc.TYPE, ptbranch*)
  -- if $ppproperty_type_equal(ppropertydesc.TYPE, pmethoddesc_source.FUNCTION.SIGNATURE.PARAMETERS[n].TYPE)
  -- if (ppropertydesc.TYPE = eps /\ ppropertydesc.DEFAULT = PROP_NULL) \/ (ppropertydesc.TYPE =/= eps /\ ppropertydesc.DEFAULT = PROP_UNINITIALIZED)
  -- if ppropertydesc.LINE = psraw.LINE
  -- if $class_method_origin(S.CLASSES, pfunction.ORIGIN) = (pmethoddesc)
  -- if $class_at(S.CLASSES, pmethoddesc.OWNER) = (pclassdesc)
  -- if $ppproperty_type_equal($trait_data_import_type(pclassdesc, ppropertydesc.TYPE), pfunction.SIGNATURE.PARAMETERS[n].TYPE)
def $promotion_descriptor(S, pfunction, n) = eps -- otherwise
def $promotion_type_scope(pclassdesc) = PTTRAIT pclassdesc.NAME -- if pclassdesc.KIND = "trait"
def $promotion_type_scope(pclassdesc) = PTKNOWN pclassdesc.NAME pclassdesc.PARENT -- if pclassdesc.KIND =/= "trait"

def $promotion_task_valid(S, porigin, n) = true
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.FUNCTION = porigin /\ pcallcontext.DEFAULTRECEIVE = eps
  -- if S.ORIGIN = (porigin) /\ S.CONSTCONTEXT = eps
  -- if $call_current_valid(S)
  -- if $receiving_function(S, porigin) = (pfunction)
  -- if $class_method_origin(S.CLASSES, porigin) = (pmethoddesc)
  -- if pcallcontext.LEXICAL_CLASS = (pmethoddesc.OWNER)
  -- if pcallcontext.RECEIVER = (n_receiver)
  -- if $promotion_source(S, pfunction) = (SEQUENCE phpType17*)
  -- if $promotion_raw(S, pfunction, n) = (psraw)
  -- if $promotion_descriptor(S, pfunction, n) = (ppropertydesc)
  -- if $default_received_slots(S, pfunction.SIGNATURE.PARAMETERS, |pfunction.SIGNATURE.PARAMETERS|)
  -- if $origin_source(porigin) = PORIGIN n_unit pcpath
  -- if pfunction.BODY = pcpath ++ [PCFIELD 6]
  -- if $origin_node(S.SOURCES, porigin) = (NStmtClassMethod phpType14 phpType24 phpType4 phpType11 phpType16 phpType18 (SEQUENCE statement*) metadata)
  -- if S.TODO = $promotion_tasks_from(porigin, phpType17*[n:$nabs($(|phpType17*| - n))], n) ++ $statement_tasks(statement*, (PORIGIN n_unit pfunction.BODY), 0) ++ [$function_fallthrough(S, pfunction)]
  -- if $property_resolve(S, n_receiver, psraw.NAME) = PROPERTY_ACCESS ptbytes
  -- if $lookup(S.ENV, psraw.NAME) = (n_cell)
  -- if S.STORE[n_cell] = DEFINED pvalue
def $promotion_task_valid(S, porigin, n) = false -- otherwise
def $call_task_valid(S, PROMOTE_PARAMETER porigin n) = $promotion_task_valid(S, porigin, n)

def $promotion_write(S, n_receiver, ptbytes, n_cell, psraw) = $property_store_key(S, n_receiver, ptbytes, pvalue, psraw.LINE)
  -- if ~psraw.BYREF
  -- if S.STORE[n_cell] = DEFINED pvalue
def $promotion_write(S, n_receiver, ptbytes, n_cell, psraw) = $promotion_write_reference(S, n_receiver, ptbytes, n_cell, psraw.LINE)
  -- if psraw.BYREF
def $promotion_write_reference(S, n_receiver, ptbytes, n_cell, z) = $assign_property_reference(S_checked, n_receiver, ptbytes, n_cell, z)
  -- if S_checked = $property_reference_target_check(S, n_receiver, ptbytes, z)
  -- if S_checked.COMPLETION = NORMAL
def $promotion_write_reference(S, n_receiver, ptbytes, n_cell, z) = S_checked
  -- if S_checked = $property_reference_target_check(S, n_receiver, ptbytes, z)
  -- if S_checked.COMPLETION =/= NORMAL

