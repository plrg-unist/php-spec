def $clone_visit_received(S, TYPESTRING (PSTRING ptbytes), PSTRING ptbytes_new, z_precision) = (ptbytes = ptbytes_new)
def $clone_visit_received(S, TYPESTRING (PINT i), PSTRING ptbytes, z_precision) = (ptbytes = $decimal_integer(i))
def $clone_visit_received(S, TYPESTRING (PBOOL b), PSTRING ptbytes, z_precision) = (ptbytes = $echo_value(PBOOL b))
def $clone_visit_received(S, TYPESTRING (PFLOAT n), PSTRING ptbytes, z_precision) = true
  -- if (ptbytes, b_warning) = $number_text(NFLOAT n, z_precision)
def $clone_visit_received(S, TYPEBOOL pvalue, PBOOL b, z_precision) = (b = $truth(S, pvalue))
