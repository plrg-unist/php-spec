;; Pure reception compares stable DIRECT inputs without diagnostics or writes.
;; A later alias value or captured Stringable result has no rereadable history.
def $clone_visit_received(S, TYPEVALUE pvalue, pvalue_new, z_precision) = (pvalue = pvalue_new)
def $clone_visit_received(S, TYPEINTEGER pvalue, PINT i, z_precision) = true
  -- if $typed_number(pvalue) = (NINT i)
def $clone_visit_received(S, TYPEINTEGER pvalue, PINT i, z_precision) = true
