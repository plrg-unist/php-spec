  -- if $property_string_consumer_guard(S_caller, n, CLONE_READONLY_STRING pcloneupdatestring)
def $trace_context(S, pbinding*, (pcallcontext)) = [{FILE eps, LINE $(-1), FUNCTION $trace_context_function(S, pcallcontext), CLASS $trace_context_class(S, pcallcontext), TYPE ($ptascii("->")), ARGS eps, HASARGS true}, ptraceframe] ++ $clone_wrapper_trace(S, pclonecall, pvalue*)
  -- if $clone_update_string_context(S, pcallcontext)
  -- if S.FRAMES = pframe :: pframe_tail*
  -- if pframe.TODO = (STRINGIFY_RESULT n porigin_site z) :: (CLONE_READONLY_STRING pcloneupdatestring) :: ptask_tail*
  -- if pcloneupdatestring.UPDATE.OPERATION.CALL = (pclonecall)
  -- if pvalue* = $trace_extra(S, $clone_trace_operands(pclonecall.SENT))
  -- if ptraceframe = {FILE $call_sourcefile(S.FILES, pclonecall.SITE), LINE pclonecall.LINE, FUNCTION $ptascii("clone"), CLASS eps, TYPE eps, ARGS $trace_indexed_args(pvalue*, 0), HASARGS true}
def $eval_frame_context(S, pframe, pframe_tail*) = $trace_context(S_context, psymboltable.ENV, pframe.CONTEXT)
