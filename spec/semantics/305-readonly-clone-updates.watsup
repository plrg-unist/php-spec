;; The builtin admits the slot before conversion. User code receives its own
;; lexical scope; the completed conversion resumes the saved cloning caller.
def $clone_update_string_entry_valid(DIRECT (POBJECT n), n_object) = (n = n_object)
def $clone_update_string_entry_valid(ALIAS n_cell, n_object) = true
