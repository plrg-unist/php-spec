;; Nonempty clone-with opens a second physical-slot window after __clone.
;; Visited entries describe completed writes; admission never repeats them.
;; Captured readonly reception values add no owner. Physical write revisions
;; distinguish them from later preadmitted commits. Mutable values stay live.
dec $clone_updates_base_valid(pstate, pcloneupdate) : bool
dec $clone_updates_valid(pstate, pcloneupdate) : bool
dec $clone_visits_valid(pstate, nat, pentry*, pclonevisit*) : bool
dec $clone_visit_valid(pstate, nat, pentry, pclonevisit) : bool
dec $clone_visit_received(pstate, ptypeconversion, pvalue, int) : bool
dec $clone_visit_source_valid(pstate, ppropertydesc, pitem, pclonevisit) : bool
dec $clone_visit_revision_valid(pstate, nat, pclonevisit, pvalue) : bool
dec $clone_visit_committed(pstate, nat, pkey, int) : pclonevisit
dec $clone_visit_decl(pstate, nat, ptbytes) : ppropertyid?
dec $clone_update_callback_access(pstate, pcloneoperation) : bool
dec $clone_readonly_advance(pstate, pcloneupdate, ptask*, int) : pstate
dec $clone_update_string_capture(pstate, pcloneupdate) : pcloneupdatestring?
dec $clone_update_string_valid(pstate, pcloneupdatestring) : bool
dec $clone_update_string_entry_valid(pitem, nat) : bool
dec $clone_arguments_this_source(phpType7*) : bool
dec $clone_named_this_source(phpType7*) : bool
dec $clone_named_this_argument(phpType7) : bool

;; Literal $this remains tied to the saved caller after argument capture.
;; Mutable operands and unpacked value history remain captured CALL data.
def $clone_arguments_this_source((NArg ABSENT expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType7*) = $clone_this_expression(expression)
def $clone_arguments_this_source(phpType7*) = $clone_named_this_source(phpType7*) -- otherwise
def $clone_named_this_source(eps) = false
def $clone_named_this_source(phpType7 :: phpType7_tail*) = ($clone_named_this_argument(phpType7) \/ $clone_named_this_source(phpType7_tail*))
def $clone_named_this_argument(NArg phpType3 expression (BOOLEAN false) (BOOLEAN false) metadata) = ($exit_argument_name(phpType3) = ($ptascii("object")) /\ $clone_this_expression(expression))
def $clone_named_this_argument(phpType7) = false -- otherwise
def $clone_call_arguments_source_valid(S, PCALLARGUMENTS phpType7* n_field, n) = (~$clone_arguments_this_source(phpType7*) \/ $this_receiver(S) = (n))

def $clone_update_callback_access(S, pcloneoperation) = true
  -- if $clone_method(S, pcloneoperation.TARGET) = eps
def $clone_update_callback_access(S, pcloneoperation) = $method_accessible(S, pmethoddesc, pcloneoperation.SCOPE)
  -- if $clone_method(S, pcloneoperation.TARGET) = (pmethoddesc)

def $clone_updates_body_valid(S, pcloneoperation) = true
  -- if pcloneoperation.CALL = (pclonecall)
  -- if pcloneoperation.INPUT = eps
  -- if pclonecall.SITE = pcloneoperation.SITE /\ pclonecall.LINE = pcloneoperation.LINE
  -- if pclonecall.SENT = [NAMED_SENT (KNOWN (POBJECT pcloneoperation.SOURCE)), NAMED_SENT (KNOWN (PARRAY n_array))]
  -- if $(pcloneoperation.SOURCE < pcloneoperation.TARGET) /\ $(pcloneoperation.TARGET < |S.OBJECTS|)
  -- if (HOBJECT pcloneoperation.SOURCE) <- S.ALLOCATIONS
  -- if (HOBJECT pcloneoperation.TARGET) <- S.ALLOCATIONS
  -- if $clone_same_kind($object_body(S.OBJECTS[pcloneoperation.SOURCE]), $object_body(S.OBJECTS[pcloneoperation.TARGET]))
