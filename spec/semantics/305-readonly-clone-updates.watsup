  -- if S_error = $clone_error(S_written, pclonecall, text, preqbytes)

;; A conversion inside clone() has an internal method frame followed by the
;; real intrinsic frame, including its original argument buffer and wrapper.
def $clone_update_string_context(S, pcallcontext) = true
  -- if S.FRAMES = pframe :: pframe_tail*
  -- if pframe.TODO = (STRINGIFY_RESULT n porigin_site z) :: (CLONE_READONLY_STRING pcloneupdatestring) :: ptask_tail*
