def $clone_updates_body_valid(S, pcloneoperation) = false -- otherwise

def $clone_readonly_start(S, pcloneoperation, n_array, ptask_tail*) = S[.TODO = (CLONE_READONLY_UPDATE pcloneupdate) :: ptask_tail*][.CLONES = {OPERATION pcloneoperation, PHASE CLONE_UPDATES, AVAILABLE $clone_readonly_keys(S, pcloneoperation.TARGET), REVISIONS $clone_revisions_start($clone_readonly_keys(S, pcloneoperation.TARGET))} :: $clone_window_delete(S.CLONES, pcloneoperation)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if pcloneupdate = {OPERATION pcloneoperation, ARRAY n_array, CURSOR 0, VISITED eps}
def $task_nodes(CLONE_READONLY_UPDATE pcloneupdate) = $clone_operation_nodes(pcloneupdate.OPERATION)
def $clone_window_task(CLONE_READONLY_UPDATE pcloneupdate, pcloneoperation, pclonephase) = (pcloneupdate.OPERATION = pcloneoperation /\ pclonephase = CLONE_UPDATES)
def $clone_window_task_kind(CLONE_READONLY_UPDATE pcloneupdate) = true
def $clone_drop_tasks(S, (CLONE_READONLY_UPDATE pcloneupdate) :: ptask_tail*) = $clone_drop_tasks(S[.CLONES = $clone_window_delete(S.CLONES, pcloneupdate.OPERATION)], ptask_tail*)
def $return_discard(S, CLONE_READONLY_UPDATE pcloneupdate) = S[.CLONES = $clone_window_delete(S.CLONES, pcloneupdate.OPERATION)]
def $call_after_origin(S, CLONE_READONLY_UPDATE pcloneupdate) = S[.CLONES = $clone_window_delete(S.CLONES, pcloneupdate.OPERATION)]

