rule PhpStep/dimension-prepare-append: S ~> S[.TODO = [DIM_PREP expression, DIM_APPEND $compiled_line(expression)] ++ ptask_tail*]
  -- if S.TODO = (DIM_PREP (NExprArrayDimFetch expression ABSENT metadata)) :: ptask_tail*
rule PhpStep/dimension-append: S ~> S[.TODO = ptask_tail*][.BASE = BASE_APPEND S.BASE z]
  -- if S.TODO = (DIM_APPEND z) :: ptask_tail*

rule PhpStep/acquire-array: S ~> S[.TODO = [DIM_PREP (NExprArrayDimFetch expression phpType5 metadata), ACQUIRE_ARRAY $compiled_line(NExprArrayDimFetch expression phpType5 metadata)] ++ ptask_tail*]
