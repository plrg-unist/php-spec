rule PhpStep/array-assignment: S ~> S[.TODO = [DIM_PREP (NExprArrayDimFetch expression_base phpType5 metadata_dim), ASSIGN_PREP (NExprArrayDimFetch expression_base phpType5 metadata_dim) expression] ++ ptask_tail*]
