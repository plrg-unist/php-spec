rule PhpStep/array-assignment-prepare: S ~> S[.TODO = [EVAL expression, ASSIGN_ARRAY S.BASE $compiled_line(expression_target) $assignment_self(expression_target, expression)] ++ ptask_tail*][.BASE = BASE_VALUE (KNOWN PNULL)][.RESULT = KNOWN PNULL]
  -- if S.TODO = (ASSIGN_PREP expression_target expression) :: ptask_tail*
rule PhpStep/array-assignment-write: S ~> S_written[.HELD = S.HELD]
  -- if S.TODO = (ASSIGN_ARRAY pbase z false) :: ptask_tail*
