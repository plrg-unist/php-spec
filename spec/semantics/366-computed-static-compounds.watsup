def $class_static_ref_pending_tail((COMPOUND_PREP CONCAT (NExprStaticPropertyFetch phpType19 expression_name metadata) expression_right z) :: ptask*) = $class_static_computed_name(expression_name)
def $compound_target(S, CONCAT, BASE_CLASS_STATIC_PENDING poperand_class poperand_name, poperand_right, z) = S[.TODO = (COMPOUND_STATIC_NAME pcomputedcompound) :: S.TODO][.ORIGIN = (porigin_fetch)][.BASE = BASE_VALUE (KNOWN PNULL)][.RESULT = KNOWN PNULL]
  -- if S.ORIGIN = (porigin)
  -- if $origin_child((porigin), [PCFIELD 0]) = (porigin_fetch)
  -- if $origin_node(S.SOURCES, porigin_fetch) = (NExprStaticPropertyFetch phpType19 expression_name metadata)
