  -- if $computed_static_valid(S, pcomputedcompound)
def $task_nodes(COMPOUND_STATIC_NAME pcomputedcompound) = $operand_nodes(pcomputedcompound.NAME) ++ $operand_nodes(pcomputedcompound.RIGHT)
def $task_nodes(COMPOUND_STATIC_READY pcomputedcompound porigin ptbytes) = $operand_nodes(pcomputedcompound.NAME) ++ $operand_nodes(pcomputedcompound.RIGHT)
def $call_task_valid(S, COMPOUND_STATIC_NAME pcomputedcompound) = ($computed_static_valid(S, pcomputedcompound) /\ S.ORIGIN = $origin_child((pcomputedcompound.SITE), [PCFIELD 0]))
def $computed_static_ready(S, pcomputedcompound, porigin, ptbytes) = (S.BASE = BASE_CLASS_STATIC porigin ptbytes /\ $class_constant_static_work(S, pcomputedcompound.CLASS, ptbytes, pcomputedcompound.LINE) = eps)
  -- if S.TODO = (COMPOUND_STATIC_READY pcomputedcompound porigin ptbytes) :: ptask*
def $computed_static_ready(S, pcomputedcompound, porigin, ptbytes) = $computed_static_marker(S, S.TODO, pcomputedcompound, porigin, ptbytes)
  -- if S.TODO = ptask_head :: ptask_tail*
  -- if ptask_head =/= COMPOUND_STATIC_READY pcomputedcompound porigin ptbytes
def $computed_static_ready(S, pcomputedcompound, porigin, ptbytes) = false -- if S.TODO = eps
def $computed_static_marker_pair((CLASS_CONST_STATIC poperand ptbytes z) :: (COMPOUND_STATIC_READY pcomputedcompound porigin ptbytes) :: ptask*, pcomputedcompound, porigin, ptbytes) = true
def $computed_static_marker_pair((CLASS_CONST_SELECTED pstaticselection ptbytes z) :: (COMPOUND_STATIC_READY pcomputedcompound porigin ptbytes) :: ptask*, pcomputedcompound, porigin, ptbytes) = true
def $computed_static_marker_pair(ptask*, pcomputedcompound, porigin, ptbytes) = false -- otherwise
def $computed_static_marker(S, (CLASS_CONST_STATIC poperand ptbytes z) :: (COMPOUND_STATIC_READY pcomputedcompound porigin ptbytes) :: ptask*, pcomputedcompound, porigin, ptbytes) = (poperand = pcomputedcompound.CLASS /\ z = pcomputedcompound.LINE)
def $computed_static_marker(S, (CLASS_CONST_SELECTED pstaticselection ptbytes z) :: (COMPOUND_STATIC_READY pcomputedcompound porigin ptbytes) :: ptask*, pcomputedcompound, porigin, ptbytes) = (pstaticselection.ROOT = porigin /\ pstaticselection.SITE = $origin_child((pcomputedcompound.SITE), [PCFIELD 0]) /\ z = pcomputedcompound.LINE /\ $class_static_selection_valid(S, pstaticselection))
def $computed_static_marker(S, ptask_head :: ptask_tail*, pcomputedcompound, porigin, ptbytes) = $computed_static_marker(S, ptask_tail*, pcomputedcompound, porigin, ptbytes)
  -- if ~$computed_static_marker_pair(ptask_head :: ptask_tail*, pcomputedcompound, porigin, ptbytes)
def $computed_static_marker(S, eps, pcomputedcompound, porigin, ptbytes) = false
def $call_task_valid(S, COMPOUND_STATIC_READY pcomputedcompound porigin ptbytes) = ($computed_static_valid(S, pcomputedcompound) /\ S.ORIGIN = $origin_child((pcomputedcompound.SITE), [PCFIELD 0]) /\ $scoped_selector_class(S, pcomputedcompound.CLASS) = (porigin) /\ $computed_static_name_compatible(S, pcomputedcompound.SITE, ptbytes) /\ $computed_static_ready(S, pcomputedcompound, porigin, ptbytes))

