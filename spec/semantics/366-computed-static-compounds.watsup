;; Static op1 CVs are read after eager RHS work; evaluated name operands retain
;; their real owners until the property address has been fetched.
dec $computed_static_source(pstate, porigin) : bool
dec $computed_static_operand(pstate, porigin, pcpath, poperand) : bool
dec $computed_static_valid(pstate, pcomputedcompound) : bool
dec $computed_static_ready(pstate, pcomputedcompound, porigin, ptbytes) : bool
dec $computed_static_marker(pstate, ptask*, pcomputedcompound, porigin, ptbytes) : bool
dec $computed_static_marker_pair(ptask*, pcomputedcompound, porigin, ptbytes) : bool
dec $computed_static_name_compatible(pstate, porigin, ptbytes) : bool
dec $computed_static_named_root(pstate, porigin) : porigin?
dec $computed_static_base(pstate, ppropertyid, porigin) : (porigin, ptbytes)?
dec $computed_static_selection_allowed(pstate, porigin) : bool
dec $computed_static_selection_closure(pstate, pclosureevidence?) : bool
dec $computed_static_name_call(pstate, pcomputedcompound) : bool
def $computed_static_name_call(S, pcomputedcompound) = false -- otherwise

def $compound_string_line(S, porigin, NExprStaticPropertyFetch phpType19 expression_name metadata_fetch, expression_right, metadata) = $runtime_line(S[.ORIGIN = $origin_child((porigin), [PCFIELD 0])], eps, NExprStaticPropertyFetch phpType19 expression_name metadata_fetch)
  -- if $class_static_computed_name(expression_name)
