  -- if $function_cache_source(S, porigin) = (pmethoddesc)
  -- if ~pmethoddesc.STATIC
  -- if pboundfake.SCOPE = BIND_CLASS pmethoddesc.OWNER
def $closure_call_cache_function(S, n) = $closure_cache_function(S.OBJECTS[n])
  -- if $(n < |S.OBJECTS|)
  -- if ~$bound_fake_object(S, n)
def $closure_call_cache_function(S, n) = eps -- otherwise

dec $closure_call_cache_policy(pstate, nat, nat, nat) : pfncacheowner?
def $closure_call_cache_policy(S, n_source, n_receiver, n) = (CACHE_CALL n)
  -- if $(n_source < |S.OBJECTS|) /\ $(n_receiver < |S.OBJECTS|)
  -- if S.OBJECTS[n_receiver] = INSTANCE porigin
  -- if $closure_cache_at(S.CLOSURECACHES, n_source) = (pclosurecache)
  -- if $closure_call_cache_function(S, n_source) = (pclosurecache.FUNCTION)
  -- if pclosurecache.CACHE = (CACHE_PRIVATE n_private)
def $closure_call_cache_policy(S, n_source, n_receiver, n) = (CACHE_SHARED)
  -- if $(n_source < |S.OBJECTS|) /\ $(n_receiver < |S.OBJECTS|)
  -- if S.OBJECTS[n_receiver] = INSTANCE porigin
  -- if $closure_cache_at(S.CLOSURECACHES, n_source) = (pclosurecache)
  -- if $closure_call_cache_function(S, n_source) = (pclosurecache.FUNCTION)
  -- if pclosurecache.CACHE = (CACHE_SHARED) /\ pclosurecache.SCOPE = (BIND_CLASS porigin)
def $closure_call_cache_policy(S, n_source, n_receiver, n) = (CACHE_CALL n)
  -- if $(n_source < |S.OBJECTS|) /\ $(n_receiver < |S.OBJECTS|)
  -- if S.OBJECTS[n_receiver] = INSTANCE porigin
  -- if $closure_cache_at(S.CLOSURECACHES, n_source) = (pclosurecache)
  -- if $closure_call_cache_function(S, n_source) = (pclosurecache.FUNCTION)
  -- if pclosurecache.CACHE = (CACHE_SHARED)
  -- if pclosurecache.SCOPE = (pbindscope)
  -- if pbindscope =/= BIND_CLASS porigin
def $closure_call_cache_policy(S, n_source, n_receiver, n) = eps -- otherwise

dec $closure_call_cache_record_valid(pstate, nat, pclosurecallcache) : bool
def $closure_call_cache_record_valid(S, n, pclosurecallcache) = true
  -- if $closure_call_copy_site(S, pclosurecallcache.SITE)
  -- if $function_at(S.CLOSURETEMPLATES, pclosurecallcache.FUNCTION) = (pfunction)
  -- if ~$function_generator(S, pfunction)
  -- if ~$closure_static(S, pfunction)
  -- if $(pclosurecallcache.SOURCE < |S.OBJECTS|)
  -- if $closure_cache_function(S.OBJECTS[pclosurecallcache.SOURCE]) = (pclosurecallcache.FUNCTION)
  -- if $closure_call_cache_policy(S, pclosurecallcache.SOURCE, pclosurecallcache.RECEIVER, n) = (CACHE_CALL n)
def $closure_call_cache_record_valid(S, n, pclosurecallcache) = true
  -- if $closure_call_copy_site(S, pclosurecallcache.SITE)
  -- if $function_cache_source(S, pclosurecallcache.FUNCTION) = (pmethoddesc)
  -- if ~pmethoddesc.STATIC
  -- if $(pclosurecallcache.SOURCE < |S.OBJECTS|) /\ $(pclosurecallcache.RECEIVER < |S.OBJECTS|)
  -- if $closure_call_cache_function(S, pclosurecallcache.SOURCE) = (pclosurecallcache.FUNCTION)
  -- if $closure_cache_at(S.CLOSURECACHES, pclosurecallcache.SOURCE) = (pclosurecache)
  -- if pclosurecache.SCOPE = (BIND_CLASS pmethoddesc.OWNER)
  -- if S.OBJECTS[pclosurecallcache.RECEIVER] = INSTANCE pmethoddesc.OWNER
  -- if $closure_call_cache_policy(S, pclosurecallcache.SOURCE, pclosurecallcache.RECEIVER, n) = (CACHE_CALL n)
def $closure_call_cache_record_valid(S, n, pclosurecallcache) = false -- otherwise
def $closure_call_cache_records(S, eps, n) = true
def $closure_call_cache_records(S, pclosurecallcache :: pclosurecallcache_tail*, n) = ($closure_call_cache_record_valid(S, n, pclosurecallcache) /\ $closure_call_cache_records(S, pclosurecallcache_tail*, $(n + 1)))

def $closure_call_cache_enter(S) = S[.CURRENT = (pcallcontext[.CACHE = (CACHE_CALL n)])][.CLOSURECALLCACHES = S.CLOSURECALLCACHES ++ [pclosurecallcache]]
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.CACHE = eps
  -- if pcallcontext.TARGET = CLOSURE_CALL_TARGET n_source n_receiver
  -- if pcallcontext.CALLSITE = (porigin_site)
  -- if HOBJECT n_source <- S.ALLOCATIONS /\ HOBJECT n_receiver <- S.ALLOCATIONS
  -- if n = |S.CLOSURECALLCACHES|
  -- if pclosurecallcache = {FUNCTION pcallcontext.FUNCTION, SOURCE n_source, RECEIVER n_receiver, SITE porigin_site}
  -- if $closure_call_cache_record_valid(S, n, pclosurecallcache)
def $closure_call_cache_enter(S) = S[.CURRENT = (pcallcontext[.CACHE = (CACHE_SHARED)])]
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.CACHE = eps
  -- if pcallcontext.TARGET = CLOSURE_CALL_TARGET n_source n_receiver
  -- if pcallcontext.CALLSITE = (porigin_site)
  -- if $closure_call_copy_site(S, porigin_site)
  -- if $closure_call_cache_policy(S, n_source, n_receiver, 0) = (CACHE_SHARED)
  -- if HOBJECT n_source <- S.ALLOCATIONS /\ HOBJECT n_receiver <- S.ALLOCATIONS
  -- if $closure_call_cache_function(S, n_source) = (pcallcontext.FUNCTION)
def $closure_call_cache_enter(S) = S -- otherwise

def $closure_call_context_cache_valid(S, pcallcontext) = true
  -- if pcallcontext.CACHE = eps
def $closure_call_context_cache_valid(S, pcallcontext) = true
  -- if pcallcontext.TARGET = CLOSURE_CALL_TARGET n_source n_receiver
  -- if HOBJECT n_source <- S.ALLOCATIONS /\ HOBJECT n_receiver <- S.ALLOCATIONS
  -- if pcallcontext.CACHE = (CACHE_CALL n)
  -- if $(n < |S.CLOSURECALLCACHES|)
  -- if pcallcontext.CALLSITE = (porigin_site)
  -- if S.CLOSURECALLCACHES[n] = {FUNCTION pcallcontext.FUNCTION, SOURCE n_source, RECEIVER n_receiver, SITE porigin_site}
  -- if $closure_call_cache_record_valid(S, n, S.CLOSURECALLCACHES[n])
def $closure_call_context_cache_valid(S, pcallcontext) = true
  -- if pcallcontext.TARGET = CLOSURE_CALL_TARGET n_source n_receiver
  -- if pcallcontext.CACHE = (CACHE_SHARED)
  -- if pcallcontext.CALLSITE = (porigin_site)
  -- if $closure_call_copy_site(S, porigin_site)
  -- if $closure_call_cache_policy(S, n_source, n_receiver, 0) = (CACHE_SHARED)
  -- if HOBJECT n_source <- S.ALLOCATIONS /\ HOBJECT n_receiver <- S.ALLOCATIONS
  -- if $closure_call_cache_function(S, n_source) = (pcallcontext.FUNCTION)
def $closure_call_context_cache_valid(S, pcallcontext) = false -- otherwise

def $closure_function_cache_owner(S, PORIGIN n_unit pcpath) = (pfncacheowner)
  -- if S.ACTIVEFIBER = eps /\ S.FIBERCALLERS = eps /\ S.FIBERCLOSERS = eps
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.TARGET = CLOSURE_CALL_TARGET n_source n_receiver
  -- if pcallcontext.CACHE = (pfncacheowner)
  -- if $closure_call_context_cache_valid(S, pcallcontext)
  -- if $goto_source_owner($all_functions(S), n_unit, pcpath) = (pfunction)
  -- if pfunction.ORIGIN = pcallcontext.FUNCTION
  -- if $closure_cache_query_source(S, pfunction.ORIGIN)
def $closure_function_cache_history(S, PORIGIN n_unit pcpath, CACHE_CALL n) = true
  -- if $(n < |S.CLOSURECALLCACHES|)
  -- if $goto_source_owner($all_functions(S), n_unit, pcpath) = (pfunction)
  -- if $closure_cache_query_source(S, pfunction.ORIGIN)
  -- if S.CLOSURECALLCACHES[n].FUNCTION = pfunction.ORIGIN
  -- if $closure_call_cache_record_valid(S, n, S.CLOSURECALLCACHES[n])

;; Raw method op_arrays share their actual compiled function cache across calls.
;; A source site is admitted only through its owning named-Class descriptor.
def $enum_is_callable_method_cache_source(S, porigin) = (pmethoddesc)
  -- if $closure_cache_method_source(S, porigin) = (pmethoddesc)
  -- if ~$function_generator(S, pmethoddesc.FUNCTION)
def $enum_is_callable_method_cache_source(S, porigin) = eps -- otherwise

def $closure_function_cache_owner(S, porigin) = (CACHE_SHARED)
  -- if S.ACTIVEFIBER = eps /\ S.FIBERCALLERS = eps /\ S.FIBERCLOSERS = eps
  -- if $enum_is_callable_method_cache_source(S, porigin) = (pmethoddesc)
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.CACHE = eps
  -- if pcallcontext.FUNCTION = pmethoddesc.FUNCTION.ORIGIN
  -- if pcallcontext.LEXICAL_CLASS = (pmethoddesc.OWNER)
  -- if $closure_cache_method_target(pcallcontext.TARGET, pcallcontext.FUNCTION)
  -- if $target_function(S, pcallcontext.TARGET) = (pmethoddesc.FUNCTION)
  -- if $call_current_valid(S)

;; Runtime INIT and plain-function zend_fetch_function prime the source cache.
;; Constant/default method captures bypass INIT and remain unproved here.
dec $closure_cache_runtime_method_site(pstate, porigin, pmethoddesc) : bool
def $closure_cache_runtime_method_site(S, PORIGIN n_unit pcpath, pmethoddesc) = true
  -- if $source_unit(S.SOURCES, n_unit) = (pcunit)
  -- if ~$constant_class_origin_allowed(pcunit, pcpath)
  -- if $method_capture_site(S, PORIGIN n_unit pcpath, pmethoddesc)
def $closure_cache_runtime_method_site(S, porigin, pmethoddesc) = false -- otherwise

def $closure_cache_capture_scope(S, n, porigin) = (BIND_UNSCOPED)
  -- if $(n < |S.OBJECTS|)
  -- if $object_body(S.OBJECTS[n]) = NAMEDCLOSURE porigin
  -- if $closure_cache_named_source(S, porigin) =/= eps
def $closure_cache_capture_scope(S, n, porigin) = (BIND_CLASS pmethoddesc.OWNER)
  -- if $(n < |S.OBJECTS|)
  -- if S.OBJECTS[n] = METHODCLOSURE porigin porigin_site porigin_requested pmethodcapture?
  -- if $closure_cache_declared_method(S, porigin) = (pmethoddesc)
  -- if ~$function_generator(S, pmethoddesc.FUNCTION)
  -- if $closure_cache_runtime_method_site(S, porigin_site, pmethoddesc)
dec $closure_cache_array_descriptor(pstate, pcalltarget, parrayselection) : pmethoddesc?
def $closure_cache_array_descriptor(S, SCOPE_METHOD_TARGET pcalltarget pcallableaccess, parrayselection) = $scope_method(S, parrayselection.REQUESTED, parrayselection.NAME, pcallableaccess.OBJECT, pcallableaccess.SCOPE)
def $closure_cache_array_descriptor(S, pcalltarget, parrayselection) = $effective_method(S, parrayselection.REQUESTED, parrayselection.NAME, |S.CLASSES|) -- otherwise
dec $closure_cache_runtime_capture_site(pstate, porigin) : bool
def $closure_cache_runtime_capture_site(S, PORIGIN n_unit pcpath) = true
  -- if $source_unit(S.SOURCES, n_unit) = (pcunit)
  -- if ~$constant_class_origin_allowed(pcunit, pcpath)
def $closure_cache_runtime_capture_site(S, porigin) = false -- otherwise

def $closure_cache_capture_scope(S, n, porigin) = (BIND_CLASS pmethoddesc.OWNER)
  -- if $(n < |S.OBJECTS|)
  -- if S.OBJECTS[n] = ARRAYMETHODCLOSURE pcalltarget parrayselection pmethodcapture?
  -- if $closure_cache_target_origin(pcalltarget) = (porigin)
  -- if $function_cache_source(S, porigin) = (pmethoddesc)
  -- if $closure_cache_array_descriptor(S, pcalltarget, parrayselection) = (pmethoddesc)
  -- if $closure_cache_runtime_capture_site(S, parrayselection.SITE)
  -- if $array_site_valid(S, parrayselection, true)
def $closure_cache_capture_scope(S, n, porigin) = (BIND_CLASS pmethoddesc.OWNER)
  -- if $(n < |S.OBJECTS|)
  -- if S.OBJECTS[n] = STRINGMETHODCLOSURE pcalltarget pstringselection
  -- if $closure_cache_target_origin(pcalltarget) = (porigin)
  -- if $function_cache_source(S, porigin) = (pmethoddesc)
  -- if $string_target_descriptor(S, pstringselection) = (pmethoddesc)
  -- if $closure_cache_runtime_capture_site(S, pstringselection.SITE)
  -- if $string_site_valid(S, pstringselection, true)
def $closure_cache_capture_scope(S, n, porigin) = eps -- otherwise

def $closure_cache_shared_capture(S, n) = S[.CLOSURECACHES = S.CLOSURECACHES ++ [{OBJECT n, FUNCTION porigin, SOURCE eps, SCOPE (pbindscope), CACHE (CACHE_SHARED)}]]
  -- if $(n < |S.OBJECTS|) /\ HOBJECT n <- S.ALLOCATIONS
  -- if $closure_cache_function(S.OBJECTS[n]) = (porigin)
  -- if $closure_cache_at(S.CLOSURECACHES, n) = eps
  -- if $closure_cache_capture_scope(S, n, porigin) = (pbindscope)
  -- if $closure_cache_object_scope(S, n) = (pbindscope)
  -- if $closure_cache_capture_initialized(S, n, porigin)
def $closure_cache_shared_capture(S, n) = S -- otherwise

def $closure_cache_capture_copy(S, n_source, n) = $closure_cache_copy(S, n_source, n)
  -- if $closure_cache_at(S.CLOSURECACHES, n_source) =/= eps
def $closure_cache_capture_copy(S, n_source, n) = S -- otherwise

def $closure_cache_record_valid(S, pclosurecache_prefix*, pclosurecache) = true
  -- if $closure_cache_record_object(S, pclosurecache)
  -- if $closure_cache_at(pclosurecache_prefix*, pclosurecache.OBJECT) = eps
  -- if pclosurecache.SOURCE = eps
  -- if pclosurecache.CACHE = (CACHE_SHARED)
  -- if pclosurecache.SCOPE = (pbindscope)
  -- if $closure_cache_capture_scope(S, pclosurecache.OBJECT, pclosurecache.FUNCTION) = (pbindscope)
  -- if $closure_cache_capture_initialized(S, pclosurecache.OBJECT, pclosurecache.FUNCTION)

;; Raw method op_arrays start cold at registration. Object-count boundaries keep
;; capture policy stable after later INIT or uncertain events, without owners.
dec $function_cache_at(pfunctioncache*, porigin) : pfunctioncache?
def $function_cache_at(eps, porigin) = eps
def $function_cache_at(pfunctioncache :: pfunctioncache_tail*, porigin) = (pfunctioncache) -- if pfunctioncache.FUNCTION = porigin
def $function_cache_at(pfunctioncache :: pfunctioncache_tail*, porigin) = $function_cache_at(pfunctioncache_tail*, porigin) -- if pfunctioncache.FUNCTION =/= porigin
dec $function_cache_set(pfunctioncache*, pfunctioncache) : pfunctioncache*
def $function_cache_set(eps, pfunctioncache) = [pfunctioncache]
def $function_cache_set(pfunctioncache_old :: pfunctioncache_tail*, pfunctioncache) = pfunctioncache :: pfunctioncache_tail* -- if pfunctioncache_old.FUNCTION = pfunctioncache.FUNCTION
def $function_cache_set(pfunctioncache_old :: pfunctioncache_tail*, pfunctioncache) = pfunctioncache_old :: $function_cache_set(pfunctioncache_tail*, pfunctioncache) -- if pfunctioncache_old.FUNCTION =/= pfunctioncache.FUNCTION
def $function_cache_source(S, porigin) = (pmethoddesc)
  -- if $closure_cache_declared_method(S, porigin) = (pmethoddesc)
  -- if ~$function_generator(S, pmethoddesc.FUNCTION)
def $function_cache_source(S, porigin) = eps -- otherwise
dec $function_cache_boundary(nat?, nat) : bool
def $function_cache_boundary(eps, n) = true
def $function_cache_boundary((n_before), n) = $(n_before <= n)
def $function_cache_records(S, pfunctioncache_prefix*, eps) = true
def $function_cache_records(S, pfunctioncache_prefix*, pfunctioncache :: pfunctioncache_tail*) = true
  -- if $function_cache_source(S, pfunctioncache.FUNCTION) =/= eps
  -- if $function_cache_at(pfunctioncache_prefix*, pfunctioncache.FUNCTION) = eps
  -- if $function_cache_boundary(pfunctioncache.INITIALIZED, |S.OBJECTS|)
  -- if $function_cache_boundary(pfunctioncache.UNKNOWN, |S.OBJECTS|)
  -- if $function_cache_records(S, pfunctioncache_prefix* ++ [pfunctioncache], pfunctioncache_tail*)
def $function_cache_records(S, pfunctioncache_prefix*, pfunctioncache*) = false -- otherwise

dec $function_cache_register_methods(pstate, porigin, pmethoddesc*) : pstate
def $function_cache_register_methods(S, porigin, eps) = S
dec $function_cache_register_method(pstate, porigin, pmethoddesc) : pstate
def $function_cache_register_methods(S, porigin, pmethoddesc :: pmethoddesc_tail*) = $function_cache_register_methods($function_cache_register_method(S, porigin, pmethoddesc), porigin, pmethoddesc_tail*)
def $function_cache_register_method(S, porigin, pmethoddesc) = S[.FUNCTIONCACHES = S.FUNCTIONCACHES ++ [{FUNCTION pmethoddesc.FUNCTION.ORIGIN, INITIALIZED eps, UNKNOWN eps}]]
  -- if pmethoddesc.OWNER = porigin
  -- if $function_cache_source(S, pmethoddesc.FUNCTION.ORIGIN) = (pmethoddesc)
  -- if $function_cache_at(S.FUNCTIONCACHES, pmethoddesc.FUNCTION.ORIGIN) = eps
def $function_cache_register_method(S, porigin, pmethoddesc) = S -- otherwise
def $function_cache_register(S, pclassdesc) = $function_cache_register_methods(S, pclassdesc.ORIGIN, pclassdesc_live.METHODS)
  -- if S.COMPLETION = NORMAL
  -- if $class_named(S.CLASSNAMES, $ptlc(pclassdesc.NAME)) = (pclassdesc.ORIGIN)
  -- if $class_at(S.CLASSES, pclassdesc.ORIGIN) = (pclassdesc_live)
def $function_cache_register(S, pclassdesc) = S -- otherwise

dec $function_cache_event(pfunctioncache?, porigin, bool, nat) : pfunctioncache
def $function_cache_event(eps, porigin, b, n) = $function_cache_event(({FUNCTION porigin, INITIALIZED eps, UNKNOWN (0)}), porigin, b, n)
def $function_cache_event((pfunctioncache), porigin, true, n) = pfunctioncache[.INITIALIZED = (n)] -- if pfunctioncache.INITIALIZED = eps
def $function_cache_event((pfunctioncache), porigin, false, n) = pfunctioncache[.UNKNOWN = (n)] -- if pfunctioncache.UNKNOWN = eps
def $function_cache_event((pfunctioncache), porigin, true, n) = pfunctioncache -- if pfunctioncache.INITIALIZED =/= eps
def $function_cache_event((pfunctioncache), porigin, false, n) = pfunctioncache -- if pfunctioncache.UNKNOWN =/= eps
syntax pfunctioncacheevent = SOURCE_CACHE_INIT | SOURCE_CACHE_COPY | SOURCE_CACHE_UNKNOWN
dec $function_cache_observe(pstate, pcalltarget, pfunctioncacheevent) : pstate
def $function_cache_observe(S, pcalltarget, SOURCE_CACHE_COPY) = S
def $function_cache_observe(S, pcalltarget, pfunctioncacheevent) = S[.FUNCTIONCACHES = $function_cache_set(S.FUNCTIONCACHES, $function_cache_event($function_cache_at(S.FUNCTIONCACHES, pfunction.ORIGIN), pfunction.ORIGIN, b_init, |S.OBJECTS|))]
  -- if pfunctioncacheevent =/= SOURCE_CACHE_COPY
  -- if $target_function(S, pcalltarget) = (pfunction)
  -- if $function_cache_source(S, pfunction.ORIGIN) = (pmethoddesc)
  -- if b_init = (pfunctioncacheevent = SOURCE_CACHE_INIT /\ pmethoddesc.FUNCTION = pfunction)
def $function_cache_observe(S, pcalltarget, pfunctioncacheevent) = S -- otherwise

;; Only original raw opcode targets initialize before their PHP arguments.
;; Trampolines reach the handler's raw cache later, at actual CAPI entry.
dec $function_cache_opcode_kind(pcalltarget) : pfunctioncacheevent
def $function_cache_opcode_kind(METHOD_TARGET n porigin) = SOURCE_CACHE_INIT
def $function_cache_opcode_kind(STATIC_METHOD_TARGET porigin_class porigin) = SOURCE_CACHE_INIT
def $function_cache_opcode_kind(SCOPED_TARGET porigin_class porigin porigin_called n? poperand) = SOURCE_CACHE_INIT
def $function_cache_opcode_kind(ARRAY_METHOD_TARGET pcalltarget parrayselection) = $function_cache_opcode_kind(pcalltarget)
def $function_cache_opcode_kind(STRING_METHOD_TARGET pcalltarget pstringselection) = $function_cache_opcode_kind(pcalltarget)
def $function_cache_opcode_kind(SCOPE_METHOD_TARGET pcalltarget pcallableaccess) = $function_cache_opcode_kind(pcalltarget)
def $function_cache_opcode_kind(PIPE_OBJECT_TARGET pcalltarget pobjectselection) = $function_cache_opcode_kind(pcalltarget)
def $function_cache_opcode_kind(CLOSURE_TARGET n) = SOURCE_CACHE_COPY
def $function_cache_opcode_kind(CLOSURE_CALL_TARGET n_source n_receiver) = SOURCE_CACHE_COPY
def $function_cache_opcode_kind(CLOSURE_INVOKE_PENDING_TARGET n) = SOURCE_CACHE_COPY
def $function_cache_opcode_kind(MAGIC_METHOD_SEND_TARGET pmagicmethodcall) = SOURCE_CACHE_COPY
def $function_cache_opcode_kind(MAGIC_STATIC_METHOD_SEND_TARGET pmagicstaticmethodcall) = SOURCE_CACHE_COPY
def $function_cache_opcode_kind(pcalltarget) = SOURCE_CACHE_UNKNOWN -- otherwise

dec $function_cache_task_target(ptask) : pcalltarget?
def $function_cache_task_target(CALL_ARGS pcalltarget phpType7* 0 eps porigin? z) = (pcalltarget)
def $function_cache_task_target(NAMED_ARGS pcalltarget phpType7* 0 pnamedargs porigin? z) = (pcalltarget) -- if pnamedargs = {SLOTS eps, NAMED eps}
def $function_cache_task_target(UNPACK_ARGS punpackcall) = (punpackcall.FUNCTION) -- if punpackcall.INDEX = 0 /\ punpackcall.SENT = {SLOTS eps, NAMED eps}
def $function_cache_task_target(METHOD_CONVERT pcalltarget porigin z) = (pcalltarget)
def $function_cache_task_target(ptask) = eps -- otherwise
def $function_cache_task(pcalltarget, ptask) = FUNCTION_CACHE_INIT pcalltarget ptask -- if $function_cache_opcode_kind(pcalltarget) =/= SOURCE_CACHE_COPY
def $function_cache_task(pcalltarget, ptask) = ptask -- otherwise
def $task_nodes(FUNCTION_CACHE_INIT pcalltarget ptask) = $task_nodes(ptask)
def $call_task_valid(S, FUNCTION_CACHE_INIT pcalltarget ptask) = ($function_cache_task_target(ptask) = (pcalltarget) /\ $call_task_valid(S, ptask))
rule PhpStep/function-cache-init: S ~> $function_cache_observe(S[.TODO = ptask :: ptask_tail*], pcalltarget, $function_cache_opcode_kind(pcalltarget))
  -- if S.TODO = (FUNCTION_CACHE_INIT pcalltarget ptask) :: ptask_tail*
  -- if $function_cache_task_target(ptask) = (pcalltarget)
  -- if $call_task_valid(S[.TODO = ptask :: ptask_tail*], ptask)

def $function_cache_fcc(S, pcalltarget, PORIGIN n_unit pcpath) = $function_cache_observe(S, pcalltarget, $function_cache_opcode_kind(pcalltarget))
  -- if $source_unit(S.SOURCES, n_unit) = (pcunit)
  -- if ~$constant_class_origin_allowed(pcunit, pcpath)
def $function_cache_fcc(S, pcalltarget, porigin) = $function_cache_observe(S, pcalltarget, SOURCE_CACHE_UNKNOWN) -- otherwise

;; Existing Closure bodies are copied functions; magic trampoline bodies forward
;; to a raw handler. Unknown wrappers taint a source instead of inventing cold.
dec $function_cache_copy_body(pobject) : bool
def $function_cache_copy_body(pobject) = ($closure_cache_function(pobject) =/= eps \/ $closure_cache_resolved_body(pobject))
dec $function_cache_closure_kind(pstate, nat) : pfunctioncacheevent
def $function_cache_closure_kind(S, n) = SOURCE_CACHE_COPY
  -- if $(n < |S.OBJECTS|)
  -- if $function_cache_copy_body(S.OBJECTS[n])
def $function_cache_closure_kind(S, n) = SOURCE_CACHE_COPY
  -- if $(n < |S.OBJECTS|)
  -- if S.OBJECTS[n] = BOUNDFAKECLOSURE pboundfake
  -- if $closure_cache_object_function(S, n) =/= eps
def $function_cache_closure_kind(S, n) = SOURCE_CACHE_UNKNOWN -- otherwise
dec $function_cache_entry_kind(pstate, pcalltarget) : pfunctioncacheevent
def $function_cache_entry_kind(S, CLOSURE_TARGET n) = $function_cache_closure_kind(S, n)
def $function_cache_entry_kind(S, CLOSURE_CALL_TARGET n_source n_receiver) = SOURCE_CACHE_COPY
def $function_cache_entry_kind(S, CLOSURE_INVOKE_PENDING_TARGET n) = SOURCE_CACHE_COPY
def $function_cache_entry_kind(S, CALLBACK_INVOKE_TARGET n) = $function_cache_entry_kind(S, CLOSURE_TARGET n)
def $function_cache_entry_kind(S, ARRAY_METHOD_TARGET pcalltarget parrayselection) = $function_cache_entry_kind(S, pcalltarget)
def $function_cache_entry_kind(S, STRING_METHOD_TARGET pcalltarget pstringselection) = $function_cache_entry_kind(S, pcalltarget)
def $function_cache_entry_kind(S, SCOPE_METHOD_TARGET pcalltarget pcallableaccess) = $function_cache_entry_kind(S, pcalltarget)
def $function_cache_entry_kind(S, PIPE_OBJECT_TARGET pcalltarget pobjectselection) = $function_cache_entry_kind(S, pcalltarget)
def $function_cache_entry_kind(S, HANDLER_METHOD_TARGET b porigin ptbytes pcalltarget) = $function_cache_entry_kind(S, pcalltarget)
def $function_cache_entry_kind(S, OUTPUT_BORROWED_TARGET pcalltarget) = $function_cache_entry_kind(S, pcalltarget)
def $function_cache_entry_kind(S, CALLBACK_BORROWED_TARGET pcalltarget) = $function_cache_entry_kind(S, pcalltarget)
def $function_cache_entry_kind(S, API_BORROWED_TARGET pshutdownproducer) = $function_cache_entry_kind(S, pshutdownproducer.TARGET)
def $function_cache_entry_kind(S, PROPERTY_GET_TARGET n porigin) = SOURCE_CACHE_INIT
def $function_cache_entry_kind(S, PROPERTY_ISSET_TARGET ppropertyisset) = SOURCE_CACHE_INIT
def $function_cache_entry_kind(S, PROPERTY_UNSET_TARGET ppropertyunset) = SOURCE_CACHE_INIT
def $function_cache_entry_kind(S, PROPERTY_EMPTY_TARGET ppropertyempty b) = SOURCE_CACHE_INIT
def $function_cache_entry_kind(S, PROPERTY_COALESCE_TARGET ppropertycoalesce b) = SOURCE_CACHE_INIT
def $function_cache_entry_kind(S, PROPERTY_MAGIC_SET_TARGET ppropertymagicset) = SOURCE_CACHE_INIT
def $function_cache_entry_kind(S, AGGREGATE_METHOD_TARGET n porigin) = SOURCE_CACHE_INIT
def $function_cache_entry_kind(S, UNPACK_ITERATOR_TARGET n porigin) = SOURCE_CACHE_INIT
def $function_cache_entry_kind(S, FIBER_METHOD_TARGET pfibercallable) = SOURCE_CACHE_INIT
def $function_cache_entry_kind(S, MAGIC_METHOD_TARGET pmagicmethodcall n pvalue*) = SOURCE_CACHE_INIT
def $function_cache_entry_kind(S, MAGIC_METHOD_NAMED_TARGET pmagicmethodcall n_arguments n_named pvalue*) = SOURCE_CACHE_INIT
def $function_cache_entry_kind(S, MAGIC_STATIC_METHOD_TARGET pmagicstaticmethodcall n pvalue*) = SOURCE_CACHE_INIT
def $function_cache_entry_kind(S, MAGIC_UNPACK_TARGET pcalltarget n_arguments n_named? pnamedargs) = SOURCE_CACHE_INIT
def $function_cache_entry_kind(S, pcalltarget) = $function_cache_opcode_kind(pcalltarget) -- otherwise

def $function_cache_enter(S, pcalltarget) = $function_cache_observe(S, pcalltarget, $function_cache_entry_kind(S, pcalltarget))
  -- if S.COMPLETION = NORMAL
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.TARGET = pcalltarget
  -- if $target_function(S, pcalltarget) = (pfunction)
  -- if pcallcontext.FUNCTION = pfunction.ORIGIN
def $function_cache_enter(S, pcalltarget) = S -- otherwise

dec $function_cache_after(nat?, nat) : bool
def $function_cache_after(eps, n) = true
def $function_cache_after((n_before), n) = $(n_before > n)
dec $function_cache_policy_raw(pstate, porigin, nat) : pfncacheowner?
def $function_cache_policy_raw(S, porigin, n) = (CACHE_SHARED)
  -- if $function_cache_at(S.FUNCTIONCACHES, porigin) = (pfunctioncache)
  -- if pfunctioncache.INITIALIZED = (n_init)
  -- if $(n_init <= n)
def $function_cache_policy_raw(S, porigin, n) = (CACHE_PRIVATE n)
  -- if $function_cache_at(S.FUNCTIONCACHES, porigin) = (pfunctioncache)
  -- if $function_cache_after(pfunctioncache.INITIALIZED, n)
  -- if $function_cache_after(pfunctioncache.UNKNOWN, n)
def $function_cache_policy_raw(S, porigin, n) = eps -- otherwise

def $function_cache_policy(S, porigin, n) = $function_cache_policy_raw(S, porigin, n)
  -- if $(n < |S.OBJECTS|)
  -- if $function_cache_source(S, porigin) =/= eps
  -- if $function_cache_at(S.FUNCTIONCACHES, porigin) = (pfunctioncache)
  -- if $function_cache_boundary(pfunctioncache.INITIALIZED, |S.OBJECTS|)
  -- if $function_cache_boundary(pfunctioncache.UNKNOWN, |S.OBJECTS|)
def $function_cache_policy(S, porigin, n) = eps -- otherwise

;; API method-table lookup does not itself allocate the source runtime cache.
def $closure_cache_method_api_scope(S, n, porigin) = (BIND_CLASS pmethoddesc.OWNER)
  -- if $(n < |S.OBJECTS|)
  -- if S.OBJECTS[n] = FROMCALLABLECLOSURE pfrommethod
  -- if pfrommethod.FUNCTION = porigin
  -- if $from_source_valid(S, pfrommethod)
  -- if $function_cache_source(S, porigin) = (pmethoddesc)
  -- if pmethoddesc.STATIC = pfrommethod.STATIC
def $closure_cache_method_api_scope(S, n, porigin) = eps -- otherwise

def $closure_cache_method_api_birth(S, n) = S[.CLOSURECACHES = S.CLOSURECACHES ++ [{OBJECT n, FUNCTION porigin, SOURCE eps, SCOPE (pbindscope), CACHE $function_cache_policy(S, porigin, n)}]]
  -- if $(n < |S.OBJECTS|) /\ HOBJECT n <- S.ALLOCATIONS
  -- if $closure_cache_function(S.OBJECTS[n]) = (porigin)
  -- if $closure_cache_at(S.CLOSURECACHES, n) = eps
  -- if $closure_cache_method_api_scope(S, n, porigin) = (pbindscope)
  -- if $closure_cache_object_scope(S, n) = (pbindscope)
def $closure_cache_method_api_birth(S, n) = S -- otherwise

def $closure_cache_record_valid(S, pclosurecache_prefix*, pclosurecache) = true
  -- if $closure_cache_record_object(S, pclosurecache)
  -- if $closure_cache_at(pclosurecache_prefix*, pclosurecache.OBJECT) = eps
  -- if pclosurecache.SOURCE = eps
  -- if pclosurecache.SCOPE = (pbindscope)
  -- if $closure_cache_method_api_scope(S, pclosurecache.OBJECT, pclosurecache.FUNCTION) = (pbindscope)
  -- if $function_cache_policy(S, pclosurecache.FUNCTION, pclosurecache.OBJECT) = pclosurecache.CACHE
