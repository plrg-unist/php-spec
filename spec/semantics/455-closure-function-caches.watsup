;; These stamps retain cache policy, never captured values or heap owners.
dec $closure_cache_at(pclosurecache*, nat) : pclosurecache?
def $closure_cache_at(eps, n) = eps
def $closure_cache_at(pclosurecache :: pclosurecache_tail*, n) = (pclosurecache)
  -- if pclosurecache.OBJECT = n
def $closure_cache_at(pclosurecache :: pclosurecache_tail*, n) = $closure_cache_at(pclosurecache_tail*, n)
  -- if pclosurecache.OBJECT =/= n
dec $closure_cache_first(pclosurecache*, porigin) : pclosurecache?
def $closure_cache_first(eps, porigin) = eps
def $closure_cache_first(pclosurecache :: pclosurecache_tail*, porigin) = (pclosurecache)
  -- if pclosurecache.FUNCTION = porigin /\ pclosurecache.SOURCE = eps
def $closure_cache_first(pclosurecache :: pclosurecache_tail*, porigin) = $closure_cache_first(pclosurecache_tail*, porigin)
  -- if pclosurecache.FUNCTION =/= porigin \/ pclosurecache.SOURCE =/= eps
;; Saved raw targets identify code after receiver/selected-array retirement.
dec $closure_cache_target_origin(pcalltarget) : porigin?
def $closure_cache_target_origin(METHOD_TARGET n porigin) = (porigin)
def $closure_cache_target_origin(STATIC_METHOD_TARGET porigin_class porigin) = (porigin)
def $closure_cache_target_origin(SCOPED_TARGET porigin_class porigin porigin_called n_receiver? poperand) = (porigin)
def $closure_cache_target_origin(SCOPE_METHOD_TARGET pcalltarget pcallableaccess) = $closure_cache_target_origin(pcalltarget)
def $closure_cache_target_origin(pcalltarget) = eps -- otherwise
dec $closure_cache_resolved_body(pobject) : bool
def $closure_cache_resolved_body(pobject) = true -- if $object_body(pobject) = ARRAYMETHODCLOSURE pcalltarget parrayselection pmethodcapture?
def $closure_cache_resolved_body(pobject) = true -- if $object_body(pobject) = STRINGMETHODCLOSURE pcalltarget pstringselection
def $closure_cache_resolved_body(pobject) = false -- otherwise
dec $function_cache_policy(pstate, porigin, nat) : pfncacheowner?
dec $function_cache_source(pstate, porigin) : pmethoddesc?
dec $closure_cache_capture_initialized(pstate, nat, porigin) : bool
def $closure_cache_capture_initialized(S, n, porigin) = (~$closure_cache_resolved_body(S.OBJECTS[n]) \/ $function_cache_policy(S, porigin, n) = (CACHE_SHARED))
  -- if $(n < |S.OBJECTS|)
def $closure_cache_capture_initialized(S, n, porigin) = false -- otherwise
dec $closure_cache_function(pobject) : porigin?
def $closure_cache_function(pobject) = (porigin)
  -- if $object_body(pobject) = REALCLOSURE porigin pitem* pstaticcell*
def $closure_cache_function(pobject) = (porigin)
  -- if $object_body(pobject) = NAMEDCLOSURE porigin
def $closure_cache_function(pobject) = (porigin)
  -- if $object_body(pobject) = METHODCLOSURE porigin porigin_site porigin_requested pmethodcapture?
def $closure_cache_function(pobject) = (pfrommethod.FUNCTION)
  -- if $object_body(pobject) = FROMCALLABLECLOSURE pfrommethod
def $closure_cache_function(pobject) = $closure_cache_target_origin(pcalltarget)
  -- if $object_body(pobject) = ARRAYMETHODCLOSURE pcalltarget parrayselection pmethodcapture?
def $closure_cache_function(pobject) = $closure_cache_target_origin(pcalltarget)
  -- if $object_body(pobject) = STRINGMETHODCLOSURE pcalltarget pstringselection
def $closure_cache_function(pobject) = eps -- otherwise
dec $closure_cache_prior(pobject*, porigin) : bool
def $closure_cache_prior(eps, porigin) = false
def $closure_cache_prior(pobject :: pobject_tail*, porigin) = ($closure_cache_function(pobject) = (porigin) \/ $closure_cache_prior(pobject_tail*, porigin))

;; Method factories use the compiled lexical owner, never the receiver class.
