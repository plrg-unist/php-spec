  -- if $closure_scope_row_valid(S_created, pclosurescope)
def $closure_cache_birth_scope(S, S_created, pfunction, n) = eps -- otherwise
def $closure_cache_birth(S, S_created, pfunction) = S_created[.CLOSURECACHES = S_created.CLOSURECACHES ++ [pclosurecache]]
  -- if n = |S.OBJECTS|
  -- if $(n < |S_created.OBJECTS|)
