  -- if pmethoddesc.OWNER = PORIGIN n_unit pcpath_class
  -- if $effect_below(pcpath_class, pcpath_method)
  -- if $origin_node(S.SOURCES, PORIGIN n_unit pcpath_method) = (NStmtClassMethod phpType14 phpType24 phpType4 phpType11 phpType16 phpType18 (SEQUENCE statement*) metadata_method)
  -- if $origin_node(S.SOURCES, pmethoddesc.OWNER) = (NStmtClass phpType14_class phpType24_class (NIdentifier (BYTES text_name) metadata_name) phpType44 phpType42 phpType23 metadata_class)
def $closure_cache_declared_method(S, porigin) = eps -- otherwise
dec $closure_cache_method_source(pstate, porigin) : pmethoddesc?
def $closure_cache_method_source(S, PORIGIN n_unit pcpath) = (pmethoddesc)
  -- if $goto_source_owner($all_functions(S), n_unit, pcpath) = (pfunction_creator)
  -- if $closure_cache_declared_method(S, pfunction_creator.ORIGIN) = (pmethoddesc)
  -- if pmethoddesc.FUNCTION = pfunction_creator
