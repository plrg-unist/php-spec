dec $closure_cache_named_source(pstate, porigin) : pfunction?
def $closure_cache_named_source(S, porigin) = (pfunction)
  -- if $function_at(S.FUNCTIONS, porigin) = (pfunction)
  -- if $origin_node(S.SOURCES, porigin) = (NStmtFunction phpType14 phpType4 phpType11 phpType16 phpType18 (SEQUENCE statement*) metadata)
  -- if ~$function_generator(S, pfunction)
