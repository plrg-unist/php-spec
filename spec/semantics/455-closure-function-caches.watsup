def $closure_cache_records_valid(S) = ($function_cache_records(S, eps, S.FUNCTIONCACHES) /\ $closure_cache_records(S, eps, S.CLOSURECACHES) /\ $closure_call_cache_records(S, S.CLOSURECALLCACHES, 0))

