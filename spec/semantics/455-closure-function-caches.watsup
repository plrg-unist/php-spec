def $closure_cache_records(S, pclosurecache_prefix*, pclosurecache :: pclosurecache_tail*) = ($closure_cache_record_valid(S, pclosurecache_prefix*, pclosurecache) /\ $closure_cache_records(S, pclosurecache_prefix* ++ [pclosurecache], pclosurecache_tail*))
