def $power_conversion_converted(S, pintegeroperation, ARITHMETIC_LEFT, pnumber) = S[.TODO = (POWER_CONVERT pintegeroperation (ARITHMETIC_RIGHT pnumber)) :: ptask_tail*][.RESULT = KNOWN PNULL]
