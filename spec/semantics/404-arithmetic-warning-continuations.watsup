;; Failed delayed conversion reports current operand types without replacing
;; the target. Array rejection borrows its existing rooted identity only.
dec $bothassign_rhs_rejected(pstate, pvalue) : bool
def $bothassign_rhs_rejected(S, pvalue) = true
  -- if $string_bytes(pvalue) = (n_bytes*)
  -- if $string_plain(pvalue) = pvalue \/ $string_carrier_valid(S, pvalue)
  -- if $string_long(n_bytes*) = STRINTERROR
def $bothassign_rhs_rejected(S, PARRAY n) = true
  -- if $(n < |S.ARRAYS|) /\ (HARRAY n) <- S.ALLOCATIONS
def $bothassign_rhs_rejected(S, pvalue) = false -- otherwise

dec $bothassign_type_failure_operands(pstate, pintegeroperation, nat, nat) : (pvalue, pvalue)?
def $bothassign_type_failure_operands(S, pintegeroperation, n_target, n_right) = ((pvalue_left, pvalue_right))
