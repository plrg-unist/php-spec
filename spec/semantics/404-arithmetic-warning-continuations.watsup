def $submul_converted(S, pintegeroperation, ARITHMETIC_RIGHT pnumber_left, pnumber_right) = $number_result(S[.TODO = ptask_tail*][.RESULT = KNOWN PNULL], NUM $num_mul(pnumber_left, pnumber_right), pintegeroperation.LINE)
