  -- if pintegerpointer_right = INTEGER_CELL n_right
  -- if (HCELL n_left) <- S.ALLOCATIONS /\ (HCELL n_right) <- S.ALLOCATIONS
  -- if $propref_at(S.PROPREFS, n_left) = eps /\ $propref_at(S.PROPREFS, n_right) = eps
  -- if $integer_pointer_value(S, pintegerpointer_left) = (pvalue_left)
  -- if $integer_pointer_value(S, pintegerpointer_right) = (pvalue_right)
  -- if $submul_initial_value(S, pvalue_left) /\ $submul_initial_value(S, pvalue_right)
  -- if $arithmetic_add_conversion(pvalue_left) = ((pnumber_left, true))
  -- if pintegeroperation = {SITE porigin, OP pbin, LINE z, SWAPPED false, LEFT poperand_left, RIGHT poperand_right, LEFTPOINTER pintegerpointer_left, RIGHTPOINTER pintegerpointer_right}
  -- if $submul_valid(S, pintegeroperation)
def $submul_warning_plan(S) = eps -- otherwise
dec $submul_converted(pstate, pintegeroperation, parithmeticphase, pnumber) : pstate
def $submul_converted(S, pintegeroperation, ARITHMETIC_LEFT, pnumber) = S[.TODO = (SUBMUL_CONVERT pintegeroperation (ARITHMETIC_RIGHT pnumber)) :: ptask_tail*][.RESULT = KNOWN PNULL]
  -- if S.TODO = ptask :: ptask_tail*
def $submul_converted(S, pintegeroperation, ARITHMETIC_RIGHT pnumber_left, pnumber_right) = $number_result(S[.TODO = ptask_tail*][.RESULT = KNOWN PNULL], NUM $num_sub(pnumber_left, pnumber_right), pintegeroperation.LINE)
  -- if S.TODO = ptask :: ptask_tail*
