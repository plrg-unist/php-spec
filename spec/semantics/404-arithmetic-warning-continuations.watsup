  -- if $integer_pointer_value(S, pintegeroperation.LEFTPOINTER) = (PFLOAT n_bits_left)
  -- if $integer_pointer_value(S, pintegeroperation.RIGHTPOINTER) = (pvalue_right)
  -- if $bothassign_initial_right_valid(S, pvalue_right)
def $modassign_both_snapshot(S, pintegeroperation, n_target, n_right, n_bits_left) = false -- otherwise

dec $modassign_both_left_valid(pstate, pintegeroperation, nat, nat, nat, int, nat) : bool
def $modassign_both_left_valid(S, pintegeroperation, n_target, n_right, n_bits_left, i_left, n_stage) = true
  -- if $modassign_warning_source(S, pintegeroperation)
  -- if $(n_target < |S.STORE| /\ n_right < |S.STORE| /\ n_target =/= n_right /\ n_bits_left < 18446744073709551616 /\ n_stage <= 1)
