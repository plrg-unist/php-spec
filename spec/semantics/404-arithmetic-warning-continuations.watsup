def $array_string_cast_items((ENTRY pkey (DIRECT pvalue)) :: pentry_tail*) = (pvalue =/= PUNDEFINED /\ $value_nodes(pvalue) = eps /\ $array_string_cast_items(pentry_tail*))
def $array_string_cast_items(pentry*) = false -- otherwise

