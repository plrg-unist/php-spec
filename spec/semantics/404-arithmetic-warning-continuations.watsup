  -- if $integer_pointer_value(S, pintegeroperation.RIGHTPOINTER) = (pvalue_right)
  -- if $submul_initial_value(S, pvalue_left) /\ $submul_initial_value(S, pvalue_right)
  -- if $arithmetic_add_conversion(pvalue_right) = eps
def $submul_failure_operands(S, pintegeroperation, parithmeticphase) = eps -- otherwise

