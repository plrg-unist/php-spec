dec $arithmetic_cv_converted(pstate, pintegeroperation, parithmeticphase, pnumber) : pstate
def $arithmetic_cv_converted(S, pintegeroperation, ARITHMETIC_LEFT, pnumber) = S[.TODO = (ARITHMETIC_CV_CONVERT pintegeroperation (ARITHMETIC_RIGHT pnumber)) :: ptask_tail*][.RESULT = KNOWN PNULL]
  -- if S.TODO = ptask :: ptask_tail*
def $arithmetic_cv_converted(S, pintegeroperation, ARITHMETIC_RIGHT pnumber_left, pnumber_right) = $number_result(S[.TODO = ptask_tail*][.RESULT = KNOWN PNULL], $number_binary(pintegeroperation.OP, pnumber_left, pnumber_right), pintegeroperation.LINE)
