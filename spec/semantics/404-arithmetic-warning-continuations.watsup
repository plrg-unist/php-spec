def $modassign_both_left_valid(S, pintegeroperation, n_target, n_right, n_bits_left, i_left, n_stage) = false -- otherwise

def $modassign_both_warning_plan(S) = (MOD_ASSIGN_BOTH_LEFT pintegeroperation n_target n_right n_bits_left i_left 0)
  -- if S.TODO = (COMPOUND_APPLY MODULO (BASE_VALUE poperand_left) false z) :: ptask_tail*
