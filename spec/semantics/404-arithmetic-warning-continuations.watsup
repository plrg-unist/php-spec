dec $arithmetic_cv_warning_valid(pstate, pintegeroperation, parithmeticphase, pvalue, pnumber, nat) : bool
def $arithmetic_cv_warning_valid(S, pintegeroperation, parithmeticphase, pvalue, pnumber, n) = ($arithmetic_cv_valid(S, pintegeroperation) /\ $arithmetic_add_phase_valid(parithmeticphase) /\ $submul_initial_value(S, pvalue) /\ $arithmetic_add_conversion(pvalue) = ((pnumber, true)) /\ $(n <= 1) /\ (n = 1 \/ $arithmetic_cv_fresh(S, pintegeroperation, parithmeticphase, pvalue)))
