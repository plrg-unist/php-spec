  -- if $bitnot_source_valid(S, pbitnotwarning)
def $bitnot_warning_plan(S) = eps -- otherwise

dec $bitnot_warning_valid(pstate, pbitnotwarning, nat) : bool
def $bitnot_warning_valid(S, pbitnotwarning, n) = ($bitnot_source_valid(S, pbitnotwarning) /\ $(n <= 1) /\ (n = 1 \/ $bitnot_snapshot(S, pbitnotwarning)))

