dec $arithmetic_cv_pointer(pintegeroperation, parithmeticphase) : pintegerpointer
def $arithmetic_cv_pointer(pintegeroperation, ARITHMETIC_LEFT) = $integer_phase_pointer(pintegeroperation, INTEGER_LEFT)
def $arithmetic_cv_pointer(pintegeroperation, ARITHMETIC_RIGHT pnumber) = $integer_phase_pointer(pintegeroperation, INTEGER_RIGHT 0)
