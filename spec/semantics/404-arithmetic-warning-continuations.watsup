dec $modassign_both_right_valid(pstate, pintegeroperation, nat, nat, nat, int, nat, int, nat) : bool
def $modassign_both_right_valid(S, pintegeroperation, n_target, n_right, n_bits_left, i_left, n_bits_right, i_right, n_stage) = true
