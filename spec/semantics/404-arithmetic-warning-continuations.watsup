;; bitwise_not_function captures the converted long before E_DEPRECATED and
;; checks the callback's exception before complementing that saved integer.
syntax pbitnotwarning = { SITE porigin, LINE int, INPUT poperand, BITS nat, VALUE int }

dec $bitnot_source_valid(pstate, pbitnotwarning) : bool
def $bitnot_source_valid(S, pbitnotwarning) = true
