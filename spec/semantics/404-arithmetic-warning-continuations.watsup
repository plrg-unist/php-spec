  -- if $arithmetic_addassign_source(S, pintegeroperation)
def $arithmetic_addassign_plan(S) = eps -- otherwise

dec $arithmetic_addassign_warning_valid(pstate, pintegeroperation, pvalue, pnumber, nat) : bool
def $arithmetic_addassign_warning_valid(S, pintegeroperation, pvalue, pnumber, n) = ($arithmetic_addassign_source(S, pintegeroperation) /\ $arithmetic_add_phase_valid(ARITHMETIC_RIGHT pnumber) /\ $arithmetic_add_conversion(pvalue) = ((pnumber, true)) /\ $(n <= 1) /\ (n = 1 \/ ($arithmetic_add_selected(S, pintegeroperation) /\ $integer_pointer_value(S, pintegeroperation.LEFTPOINTER) = (pvalue))))

