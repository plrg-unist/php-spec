  -- if $(n_bits_right < 18446744073709551616)
  -- if $float_long(n_bits_right, true) = (i_right, [PRECISIONLOSS])
def $modassign_both_right_snapshot(S, pintegeroperation, n_target, n_right) = eps -- otherwise

