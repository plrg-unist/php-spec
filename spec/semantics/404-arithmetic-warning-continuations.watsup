  -- if $submul_source_operator(expression) = (pintegeroperation.OP)
  -- if pintegeroperation.LEFT = VARIABLE ptbytes_left z_left
  -- if pintegeroperation.RIGHT = VARIABLE ptbytes_right z_right
  -- if $integer_operand_source(S, pintegeroperation.SITE, [PCFIELD 0], pintegeroperation.LEFT)
  -- if $integer_operand_source(S, pintegeroperation.SITE, [PCFIELD 1], pintegeroperation.RIGHT)
  -- if $code_expression_at_source(S, pintegeroperation.SITE, [PCFIELD 1]) = (pintegeroperation.LINE)
  -- if pintegeroperation.LEFTPOINTER = INTEGER_CELL n_left
  -- if pintegeroperation.RIGHTPOINTER = INTEGER_CELL n_right
  -- if $integer_pointer_source(S, pintegeroperation.LEFTPOINTER, pintegeroperation.LEFT)
  -- if $integer_pointer_source(S, pintegeroperation.RIGHTPOINTER, pintegeroperation.RIGHT)
  -- if n_left <- S.REFCELLS /\ n_right <- S.REFCELLS
def $submul_valid(S, pintegeroperation) = false -- otherwise
def $submul_warning_plan(S) = (pintegeroperation)
  -- if S.TODO = (BINARY_RIGHT pbin poperand_left z) :: ptask_tail*
  -- if $error_handler_eligible(S, 2) /\ $arithmetic_add_named(S)
  -- if ~$gc_retired_binary(S, pbin, poperand_left)
  -- if S.ORIGIN = (porigin)
  -- if poperand_right = S.RESULT
  -- if $integer_pointer_select(S, poperand_left) = (pintegerpointer_left)
  -- if $integer_pointer_select(S, poperand_right) = (pintegerpointer_right)
  -- if pintegerpointer_left = INTEGER_CELL n_left
  -- if pintegerpointer_right = INTEGER_CELL n_right
  -- if (HCELL n_left) <- S.ALLOCATIONS /\ (HCELL n_right) <- S.ALLOCATIONS
  -- if $propref_at(S.PROPREFS, n_left) = eps /\ $propref_at(S.PROPREFS, n_right) = eps
  -- if $integer_pointer_value(S, pintegerpointer_left) = (pvalue_left)
  -- if $integer_pointer_value(S, pintegerpointer_right) = (pvalue_right)
  -- if $submul_initial_value(S, pvalue_left) /\ $submul_initial_value(S, pvalue_right)
  -- if $arithmetic_add_conversion(pvalue_left) = ((pnumber_left, true))
  -- if pintegeroperation = {SITE porigin, OP pbin, LINE z, SWAPPED false, LEFT poperand_left, RIGHT poperand_right, LEFTPOINTER pintegerpointer_left, RIGHTPOINTER pintegerpointer_right}
  -- if $submul_valid(S, pintegeroperation)
def $submul_warning_plan(S) = eps -- otherwise
dec $submul_converted(pstate, pintegeroperation, parithmeticphase, pnumber) : pstate
def $submul_converted(S, pintegeroperation, ARITHMETIC_LEFT, pnumber) = S[.TODO = (SUBMUL_CONVERT pintegeroperation (ARITHMETIC_RIGHT pnumber)) :: ptask_tail*][.RESULT = KNOWN PNULL]
  -- if S.TODO = ptask :: ptask_tail*
def $submul_converted(S, pintegeroperation, ARITHMETIC_RIGHT pnumber_left, pnumber_right) = $number_result(S[.TODO = ptask_tail*][.RESULT = KNOWN PNULL], NUM $num_sub(pnumber_left, pnumber_right), pintegeroperation.LINE)
  -- if S.TODO = ptask :: ptask_tail*
  -- if pintegeroperation.OP = SUBTRACT
def $submul_converted(S, pintegeroperation, ARITHMETIC_RIGHT pnumber_left, pnumber_right) = $number_result(S[.TODO = ptask_tail*][.RESULT = KNOWN PNULL], NUM $num_mul(pnumber_left, pnumber_right), pintegeroperation.LINE)
  -- if S.TODO = ptask :: ptask_tail*
  -- if pintegeroperation.OP = MULTIPLY
dec $submul_warning_valid(pstate, pintegeroperation, parithmeticphase, pvalue, pnumber, nat) : bool
def $submul_warning_valid(S, pintegeroperation, parithmeticphase, pvalue, pnumber, n) = ($submul_valid(S, pintegeroperation) /\ $arithmetic_add_phase_valid(parithmeticphase) /\ $submul_initial_value(S, pvalue) /\ $arithmetic_add_conversion(pvalue) = ((pnumber, true)) /\ $(n <= 1) /\ (n = 1 \/ parithmeticphase =/= ARITHMETIC_LEFT \/ $arithmetic_add_selected(S, pintegeroperation)) /\ (n = 1 \/ $integer_pointer_value(S, $arithmetic_add_pointer(pintegeroperation, parithmeticphase)) = (pvalue)))
dec $submul_failure_operands(pstate, pintegeroperation, parithmeticphase) : (pvalue, pvalue)?
def $submul_failure_operands(S, pintegeroperation, ARITHMETIC_RIGHT pnumber) = ((pvalue_left, pvalue_right))
