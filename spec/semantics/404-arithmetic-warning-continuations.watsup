dec $arithmetic_addassign_cv_right_warning_valid(pstate, pintegeroperation, pvalue, pnumber, pvalue, pnumber, nat) : bool
def $arithmetic_addassign_cv_right_warning_valid(S, pintegeroperation, pvalue_left, pnumber_left, pvalue_right, pnumber_right, n) = ($arithmetic_addassign_cv_warning_valid(S, pintegeroperation, pvalue_left, pnumber_left, 1) /\ $arithmetic_add_conversion(pvalue_right) = ((pnumber_right, true)) /\ $arithmetic_add_phase_valid(ARITHMETIC_RIGHT pnumber_right) /\ $(n <= 1) /\ (n = 1 \/ $arithmetic_addassign_cv_right_snapshot(S, pintegeroperation) = ((pvalue_right, pnumber_right))))

