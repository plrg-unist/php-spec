def $task_nodes(ARITHMETIC_CV_CONVERT pintegeroperation parithmeticphase) = $operand_nodes(pintegeroperation.LEFT) ++ $operand_nodes(pintegeroperation.RIGHT)
def $task_nodes(ARITHMETIC_CV_WARNING pintegeroperation parithmeticphase pvalue pnumber n) = $operand_nodes(pintegeroperation.LEFT) ++ $operand_nodes(pintegeroperation.RIGHT)
def $call_task_valid(S, ARITHMETIC_CV_CONVERT pintegeroperation parithmeticphase) = ($arithmetic_cv_valid(S, pintegeroperation) /\ $arithmetic_add_phase_valid(parithmeticphase) /\ (parithmeticphase =/= ARITHMETIC_LEFT \/ $arithmetic_add_selected(S, pintegeroperation)))
