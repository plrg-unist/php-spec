;; Both-fractional shifts use the ordered captures, with shift-only source
;; authority and signed integer operations at the final commit.
dec $shiftassign_both_left_valid(pstate, pintegeroperation, nat, nat, nat, int, nat) : bool
def $shiftassign_both_left_valid(S, pintegeroperation, n_target, n_right, n_bits_left, i_left, n_stage) = true
  -- if $shiftassign_warning_source(S, pintegeroperation)
  -- if $(n_target < |S.STORE| /\ n_right < |S.STORE| /\ n_target =/= n_right /\ n_bits_left < 18446744073709551616 /\ n_stage <= 1)
  -- if $float_long(n_bits_left, true) = (i_left, [PRECISIONLOSS])
  -- if n_stage = 1 \/ $modassign_both_snapshot(S, pintegeroperation, n_target, n_right, n_bits_left)
def $shiftassign_both_left_valid(S, pintegeroperation, n_target, n_right, n_bits_left, i_left, n_stage) = false -- otherwise

def $shiftassign_both_warning_plan(S) = (SHIFT_ASSIGN_BOTH_LEFT pintegeroperation n_target n_right n_bits_left i_left 0)
  -- if S.TODO = (COMPOUND_APPLY pbin (BASE_VALUE poperand_left) false z) :: ptask_tail*
