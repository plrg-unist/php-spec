  -- if $float_long(pbitnotwarning.BITS, true) = (pbitnotwarning.VALUE, [PRECISIONLOSS])
def $bitnot_source_valid(S, pbitnotwarning) = false -- otherwise
dec $bitnot_snapshot(pstate, pbitnotwarning) : bool
def $bitnot_snapshot(S, pbitnotwarning) = true
  -- if $integer_pointer_select(S, pbitnotwarning.INPUT) = (INTEGER_CV ptbytes)
  -- if $integer_pointer_value(S, INTEGER_CV ptbytes) = (PFLOAT pbitnotwarning.BITS)
