;; ZEND_CAST calls non-try zval_get_string: an array warning selects the fixed
;; interned result before callback return. A borrowed CV adds no saved array root.
dec $array_string_cast_items(pentry*) : bool
def $array_string_cast_items(eps) = true
def $array_string_cast_items((ENTRY pkey (DIRECT pvalue)) :: pentry_tail*) = (pvalue =/= PUNDEFINED /\ $value_nodes(pvalue) = eps /\ $array_string_cast_items(pentry_tail*))
