;; SUB/MUL dereference both source CVs before converting LEFT. Initial bad text
;; on RIGHT is not rejected until its selected referent is actually converted.
dec $submul_source_operator(expression) : pbin?
def $submul_source_operator(NExprBinaryOpMinus expression_left expression_right metadata) = (SUBTRACT)
def $submul_source_operator(NExprBinaryOpMul expression_left expression_right metadata) = (MULTIPLY)
def $submul_source_operator(expression) = eps -- otherwise
dec $submul_initial_value(pstate, pvalue) : bool
def $submul_initial_value(S, PNULL) = true
def $submul_initial_value(S, PBOOL b) = true
def $submul_initial_value(S, PINT i) = $(i >= -9223372036854775808 /\ i <= 9223372036854775807)
def $submul_initial_value(S, PFLOAT n) = $(n < 18446744073709551616)
def $submul_initial_value(S, pvalue) = true
  -- if $string_bytes(pvalue) = (n_bytes*)
  -- if $startup_bytes(n_bytes*)
  -- if $string_plain(pvalue) = pvalue \/ $string_carrier_valid(S, pvalue)
def $submul_initial_value(S, pvalue) = false -- otherwise
dec $submul_valid(pstate, pintegeroperation) : bool
def $submul_valid(S, pintegeroperation) = true
  -- if S.ORIGIN = (pintegeroperation.SITE) /\ ~pintegeroperation.SWAPPED
