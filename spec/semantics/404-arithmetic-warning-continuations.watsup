rule PhpStep/bitassign-right-warning-commit: S ~> $arithmetic_addassign_cv_write(S[.TODO = ptask_tail*][.RESULT = KNOWN (PINT i_result)], ptbytes_left, PINT i_result)
  -- if S.TODO = (BIT_ASSIGN_RIGHT_WARNING pintegeroperation n_target n_right i_left n_bits i_right 1) :: ptask_tail*
  -- if $bitassign_right_warning_valid(S, pintegeroperation, n_target, n_right, i_left, n_bits, i_right, 1)
  -- if $powerassign_warning_ready(S, pintegeroperation, n_target)
  -- if $integer_binary(pintegeroperation.OP, i_left, i_right) = IRESULT i_result
  -- if pintegeroperation.LEFTPOINTER = INTEGER_CV ptbytes_left
rule PhpStep/bitassign-right-warning-boundary: S ~> S[.COMPLETION = UNSUPPORTED "bitwise assignment expired, rebound, owning or constrained target after RHS deprecation"]
  -- if S.TODO = (BIT_ASSIGN_RIGHT_WARNING pintegeroperation n_target n_right i_left n_bits i_right 1) :: ptask_tail*
  -- if $bitassign_right_warning_valid(S, pintegeroperation, n_target, n_right, i_left, n_bits, i_right, 1)
  -- if ~$powerassign_warning_ready(S, pintegeroperation, n_target)

def $task_nodes(BIT_ASSIGN_RIGHT_WARNING pintegeroperation n_target n_right i_left n_bits i_right n_stage) = eps
def $call_task_valid(S, BIT_ASSIGN_RIGHT_WARNING pintegeroperation n_target n_right i_left n_bits i_right n_stage) = $bitassign_right_warning_valid(S, pintegeroperation, n_target, n_right, i_left, n_bits, i_right, n_stage)
def $error_call_valid(S, perrorcall) = true
  -- if perrorcall.RESUME = BIT_ASSIGN_RIGHT_WARNING pintegeroperation n_target n_right i_left n_bits i_right 1
  -- if $bitassign_right_warning_valid(S, pintegeroperation, n_target, n_right, i_left, n_bits, i_right, 1)
  -- if perrorcall.TARGET =/= eps \/ $bitassign_right_warning_valid(S, pintegeroperation, n_target, n_right, i_left, n_bits, i_right, 0)
  -- if perrorcall.SITE = pintegeroperation.SITE /\ perrorcall.LINE = pintegeroperation.LINE
  -- if perrorcall.LEVEL = 8192
  -- if $integer_float_notices([PRECISIONLOSS], n_bits) = [(8192, perrorcall.MESSAGE)]
  -- if perrorcall.EVENT = DIAGNOSTIC "Deprecated" perrorcall.MESSAGE pintegeroperation.LINE

;; The initial RHS is not converted before LEFT's callback. Keep the old PINT
;; entry separate; initialized nonowning scalars use the shared delayed route.
dec $bothassign_initial_right_valid(pstate, pvalue) : bool
def $bothassign_initial_right_valid(S, PNULL) = true
def $bothassign_initial_right_valid(S, PBOOL b) = true
def $bothassign_initial_right_valid(S, PFLOAT n_bits) = true
  -- if $(n_bits < 18446744073709551616)
  -- if $fparts_fits($float_decode(n_bits))
def $bothassign_initial_right_valid(S, pvalue) = true
  -- if $string_bytes(pvalue) = (n_bytes*)
  -- if $startup_bytes(n_bytes*)
  -- if $string_plain(pvalue) = pvalue \/ $string_carrier_valid(S, pvalue)
def $bothassign_initial_right_valid(S, pvalue) = false -- otherwise

dec $modassign_both_snapshot(pstate, pintegeroperation, nat, nat, nat) : bool
def $modassign_both_snapshot(S, pintegeroperation, n_target, n_right, n_bits_left) = true
