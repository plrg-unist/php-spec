dec $power_conversion_warning_valid(pstate, pintegeroperation, parithmeticphase, pvalue, pnumber, nat) : bool
def $power_conversion_warning_valid(S, pintegeroperation, parithmeticphase, pvalue, pnumber, n) = ($power_conversion_valid(S, pintegeroperation) /\ $arithmetic_add_phase_valid(parithmeticphase) /\ $submul_initial_value(S, pvalue) /\ $arithmetic_add_conversion(pvalue) = ((pnumber, true)) /\ $(n <= 1) /\ (n = 1 \/ parithmeticphase =/= ARITHMETIC_LEFT \/ $arithmetic_add_selected(S, pintegeroperation)) /\ (n = 1 \/ $integer_pointer_value(S, $arithmetic_add_pointer(pintegeroperation, parithmeticphase)) = (pvalue)))
