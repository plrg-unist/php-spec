def $arithmetic_cv_source_operator(NExprBinaryOpMinus expression_left expression_right metadata) = (SUBTRACT)
def $arithmetic_cv_source_operator(NExprBinaryOpMul expression_left expression_right metadata) = (MULTIPLY)
def $arithmetic_cv_source_operator(NExprBinaryOpDiv expression_left expression_right metadata) = (DIVIDE)
def $arithmetic_cv_source_operator(NExprBinaryOpPow expression_left expression_right metadata) = (POWER)
def $arithmetic_cv_source_operator(pcnode) = eps -- otherwise
