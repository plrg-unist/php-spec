def $modassign_both_warning_plan(S) = eps -- otherwise

;; At the second conversion LEFT has already been captured and may now be a
;; late reference. Authenticate only the current RHS and safe original target.
dec $modassign_both_right_snapshot(pstate, pintegeroperation, nat, nat) : (nat, int)?
def $modassign_both_right_snapshot(S, pintegeroperation, n_target, n_right) = ((n_bits_right, i_right))
