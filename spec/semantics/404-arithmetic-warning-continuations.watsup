  -- if $integer_float_notices([PRECISIONLOSS], n_bits) = [(8192, n_message*)]
  -- if ~$error_handler_eligible(S, 8192) \/ $arithmetic_add_named(S)
rule PhpStep/bitassign-right-warning-owning-handler: S ~> S[.COMPLETION = UNSUPPORTED "bitwise assignment owning RHS deprecation callback"]
  -- if S.TODO = (BIT_ASSIGN_RIGHT_WARNING pintegeroperation n_target n_right i_left n_bits i_right 0) :: ptask_tail*
  -- if $bitassign_right_warning_valid(S, pintegeroperation, n_target, n_right, i_left, n_bits, i_right, 0)
