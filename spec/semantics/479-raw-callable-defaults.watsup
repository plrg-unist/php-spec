;; Dynamic callable lookup has already selected a normal public method before
;; argument effects. A quiet CV is the source site, never the cache identity.
dec $parameter_raw_callable_site(pstate, porigin) : bool
def $parameter_raw_callable_site(S, porigin) = true
  -- if $origin_node(S.SOURCES, porigin) = (NExprFuncCall (NExprVariable phpType32 metadata_variable) (SEQUENCE phpType7*) metadata)
  -- if $cv_name(phpType32) = (ptbytes)
  -- if ~$direct_this(phpType32) /\ ~$ppfirstclass(phpType7*)
  -- if $dynamic_fixed_name(S, porigin) = eps
def $parameter_raw_callable_site(S, porigin) = false -- otherwise

dec $parameter_raw_named_class(pstate, porigin) : bool
def $parameter_raw_named_class(S, porigin) = true
  -- if $origin_node(S.SOURCES, porigin) = (NStmtClass phpType14 (INTEGER int) (NIdentifier (BYTES text) metadata_name) phpType44 phpType42 phpType23 metadata)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if pclassdesc.KIND = "class"
def $parameter_raw_named_class(S, porigin) = false -- otherwise

dec $parameter_raw_normal_target(pcalltarget) : bool
def $parameter_raw_normal_target(METHOD_TARGET n porigin) = true
def $parameter_raw_normal_target(STATIC_METHOD_TARGET porigin_class porigin) = true
def $parameter_raw_normal_target(SCOPED_TARGET porigin_requested porigin porigin_called n_receiver? poperand) = true
def $parameter_raw_normal_target(pcalltarget) = false -- otherwise

