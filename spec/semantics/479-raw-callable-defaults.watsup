;; Only actual raw wrappers use this owning-hit route. Existing FCC, Closure,
;; API and ordinary method entries keep their independent rules.
def $default_nonclosure_recipient(S, pfunction, pdefault) = $parameter_raw_callable_current(S, pfunction)
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.TARGET = ARRAY_METHOD_TARGET pcalltarget parrayselection
  -- if $parameter_default_owned_source(S, pdefault.ORIGIN)
def $default_nonclosure_recipient(S, pfunction, pdefault) = $parameter_raw_callable_current(S, pfunction)
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.TARGET = STRING_METHOD_TARGET pcalltarget pstringselection
  -- if $parameter_default_owned_source(S, pdefault.ORIGIN)
