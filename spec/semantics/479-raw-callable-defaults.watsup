  -- if $call_selected_valid(S, STRING_METHOD_TARGET pcalltarget pstringselection, (porigin_site))
def $parameter_raw_callable_target(S, pcalltarget, porigin_site) = false -- otherwise

dec $parameter_raw_callable_current(pstate, pfunction) : bool
def $parameter_raw_callable_current(S, pfunction) = true
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.FUNCTION = pfunction.ORIGIN /\ pcallcontext.NAME = pfunction.NAME
  -- if pcallcontext.CALLSITE = (porigin_site)
  -- if $parameter_raw_callable_site(S, porigin_site)
  -- if $parameter_raw_callable_target(S, pcallcontext.TARGET, porigin_site)
  -- if $parameter_method_source(S, pfunction) = (pmethoddesc)
  -- if pmethoddesc.VISIBILITY = PROPERTY_PUBLIC
  -- if pcallcontext.LEXICAL_CLASS = (pmethoddesc.OWNER)
  -- if pcallcontext.CALLED_CLASS = (porigin_called)
  -- if $parameter_raw_named_class(S, porigin_called)
  -- if pcallcontext.RECEIVER = $target_receiver(S, pcallcontext.TARGET)
  -- if pcallcontext.CALLED_CLASS = $target_called_class(S, pcallcontext.TARGET)
  -- if $target_function(S, pcallcontext.TARGET) = (pfunction)
  -- if pcallcontext.INSTANCE = eps /\ pcallcontext.WRAPPER = eps /\ pcallcontext.CACHE = eps
  -- if $default_cache_owner(S) = (CACHE_SHARED)
def $parameter_raw_callable_current(S, pfunction) = false -- otherwise

;; The source-local override also returns false for FCC/API targets, so their
;; explicit recipient rules cannot gain a duplicate generic method route.
def $parameter_method_current_valid(S, pfunction) = $parameter_raw_callable_current(S, pfunction)
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.CALLSITE = (porigin_site)
  -- if $parameter_raw_callable_site(S, porigin_site)

