rule PhpStep/array-iterator-start: S ~> S[.ITERATORS = S.ITERATORS ++ [OBJECTITER parrayiterator.ITERATOR parrayiterator.OBJECT 0 false]][.NEXTITER = $(S.NEXTITER + 1)][.TODO = (ARRAY_ITERATOR parrayiterator "rewind-start") :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
