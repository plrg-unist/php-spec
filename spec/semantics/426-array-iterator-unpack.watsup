;; ADD_ARRAY_UNPACK owns the partial builder and Iterator DATA. Its current
;; cache survives key(), is dereferenced only afterward, and retires before next().
dec $array_iterator_item(pstate, phpType13*, int) : (porigin, expression)?
dec $array_iterator_methods(pstate, nat, text*) : bool
dec $array_iterator_source(pstate, parrayiterator) : bool
dec $array_iterator_stage(parrayiterator, text) : bool
dec $array_iterator_valid(pstate, parrayiterator, text) : bool
dec $array_iterator_table(pstate, nat) : bool
dec $array_iterator_value(pstate, poperand) : pvalue?
dec $array_iterator_ready(pstate, parrayiterator) : bool
dec $array_iterator_plan(pstate) : parrayiterator?
dec $array_iterator_call(pstate, parrayiterator, text, ptask*) : pstate
dec $array_iterator_call_stage(text) : text?
dec $array_iterator_valid_stage(bool) : text
dec $array_iterator_clear(pstate, parrayiterator, text, ptask*) : pstate
dec $array_iterator_capture(pstate, parrayiterator, bool, ptask*) : pstate
dec $array_iterator_key_valid(pvalue) : bool
dec $array_iterator_key(pvalue) : pkey?
dec $array_iterator_insert(pstate, parrayiterator, ptask*) : pstate
dec $array_iterator_nodes(parrayiterator) : pnode*
dec $array_iterator_target(pstate, parrayiterator, pcalltarget, text) : bool
dec $array_iterator_frame(pstate, pcallcontext, pframe) : bool
dec $array_iterator_discard(pstate, parrayiterator, text) : pstate

def $array_unpack_traversable(S, POBJECT n) = $class_instanceof(S, POBJECT n, $ptascii("Traversable"))
def $array_unpack_traversable(S, pvalue) = false -- otherwise

def $array_iterator_item(S, phpType13*, z) = ((porigin, expression))
  -- if S.ORIGIN = (porigin)
  -- if $origin_node(S.SOURCES, porigin) = (NArrayItem ABSENT expression (BOOLEAN false) (BOOLEAN true) metadata)
  -- if $code_expression_at_source(S, porigin, [PCFIELD 1]) = (z)
  -- if $(z > 0)
  -- if $reference_origin_parent(porigin, 2) = ((porigin_array, [PCFIELD 0, PCINDEX n_index]))
  -- if $origin_node(S.SOURCES, porigin_array) = (NExprArray (SEQUENCE phpType13_all*) metadata_array)
  -- if $(n_index < |phpType13_all*|)
  -- if n_after = $(n_index + 1)
  -- if n_remaining = $(|phpType13_all*| - n_after)
  -- if phpType13* = phpType13_all*[n_after:n_remaining]
def $array_iterator_item(S, phpType13*, z) = eps -- otherwise

def $array_iterator_methods(S, n, eps) = true
def $array_iterator_methods(S, n, text :: text_tail*) = $array_iterator_methods(S, n, text_tail*)
