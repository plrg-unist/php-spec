def $array_iterator_frame(S, pcallcontext, pframe) = false -- otherwise
def $useriter_frame(S, pcallcontext, pframe) = true -- if $array_iterator_frame(S, pcallcontext, pframe)
def $useriter_marker(pframe) = true -- if pframe.TODO = (ARRAY_ITERATOR parrayiterator text) :: ptask_tail*
def $reference_callback_used(S, pcallcontext) = (text <- ["valid", "current", "key"])
  -- if S.CURRENT = (pcallcontext)
  -- if S.FRAMES = pframe :: pframe_tail*
