;; Flat cache values have no owning descendants or destructors. Allocated
;; zero-owner nodes are permitted while an abrupt pop is about to retire them.
def $array_iterator_table(S, n) = true
  -- if $(n < |S.ARRAYS|) /\ (HARRAY n) <- S.ALLOCATIONS
  -- if ~(n <- S.LITERALARRAYDEBTS)
  -- if $entries_nodes(S.ARRAYS[n].ITEMS) = eps
  -- if $array_null_const_items(S, S.ARRAYS[n].ITEMS, [n])
def $array_iterator_table(S, n) = false -- otherwise

def $array_iterator_value(S, KNOWN (PARRAY n)) = (PARRAY n)
