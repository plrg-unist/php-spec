def $array_iterator_nodes(parrayiterator) = [HARRAY parrayiterator.ARRAY, HOBJECT parrayiterator.OBJECT] ++ $operand_nodes(parrayiterator.CURRENT) ++ $operand_nodes(parrayiterator.KEY)
def $task_nodes(ARRAY_ITERATOR parrayiterator text) = $array_iterator_nodes(parrayiterator)
def $call_task_valid(S, ARRAY_ITERATOR parrayiterator text) = $array_iterator_valid(S, parrayiterator, text)
def $useriter_task_ids(ARRAY_ITERATOR parrayiterator text) = [parrayiterator.ITERATOR]
def $error_task_iterator(ARRAY_ITERATOR parrayiterator text) = [parrayiterator.ITERATOR]

def $array_iterator_discard(S, parrayiterator, text) = S[.ITERATORS = $iterator_remove(S.ITERATORS, parrayiterator.ITERATOR)][.ORIGIN = (parrayiterator.SITE)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if $array_iterator_ready(S, parrayiterator)
def $array_iterator_discard(S, parrayiterator, text) = S[.TODO = (THROW_SEARCH n) :: (ARRAY_ITERATOR parrayiterator text) :: ptask_tail*][.COMPLETION = UNSUPPORTED "array Iterator unpack abrupt payload outside quiet domain"]
  -- if ~$array_iterator_ready(S, parrayiterator)
  -- if S.TODO = (THROW_SEARCH n) :: ptask_tail*
def $return_discard(S, ARRAY_ITERATOR parrayiterator text) = $array_iterator_discard(S, parrayiterator, text)
