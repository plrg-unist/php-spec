  -- if ~$function_generator(S, pmethoddesc.FUNCTION)
def $array_iterator_methods(S, n, text*) = false -- otherwise

;; INPUT is a source receipt after entry, even if rewind/key unsets that CV.
;; Payload eligibility is separate so legal callback mutations can refuse cleanly.
def $array_iterator_source(S, parrayiterator) = true
  -- if S.ORIGIN = (parrayiterator.SITE)
  -- if $array_iterator_item(S, parrayiterator.TAIL, parrayiterator.LINE) = ((parrayiterator.SITE, expression))
  -- if parrayiterator.INPUT = VARIABLE n_name* z
  -- if $array_float_key_input_source(S, expression, parrayiterator.INPUT)
  -- if $(parrayiterator.ARRAY < |S.ARRAYS|) /\ (HARRAY parrayiterator.ARRAY) <- S.ALLOCATIONS
  -- if ~$array_immutable(S, parrayiterator.ARRAY)
  -- if $heap_count(HARRAY parrayiterator.ARRAY, $pools_nodes(S.POOLS)) = 0
  -- if $useriter_instance(S, parrayiterator.OBJECT)
  -- if S.OBJECTS[parrayiterator.OBJECT] = INSTANCE porigin_class
  -- if $effective_method(S, porigin_class, $ptascii("__destruct"), |S.CLASSES|) = eps
  -- if $array_iterator_methods(S, parrayiterator.OBJECT, ["rewind", "valid", "current", "key", "next"])
def $array_iterator_source(S, parrayiterator) = false -- otherwise

