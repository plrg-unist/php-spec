def $array_iterator_capture(S, parrayiterator, false, ptask_tail*) = S[.TODO = (ARRAY_ITERATOR parrayiterator[.CURRENT = S.RESULT] "key-start") :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
