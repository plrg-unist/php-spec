;; DATA is the sole receiver owner; the borrowed callback target adds none.
def $array_iterator_target(S, parrayiterator, UNPACK_ITERATOR_TARGET n porigin_method, text) = (n = parrayiterator.OBJECT /\ $useriter_method_selected(S, n, porigin_method, text))
def $array_iterator_target(S, parrayiterator, pcalltarget, text) = false -- otherwise
