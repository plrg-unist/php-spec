rule PhpStep/array-iterator-finish: S ~> S[.TODO = (ARRAY_NEXT parrayiterator.ARRAY parrayiterator.TAIL) :: ptask_tail*][.ITERATORS = $iterator_remove(S.ITERATORS, parrayiterator.ITERATOR)][.ORIGIN = $origin_next_item(S.ORIGIN, parrayiterator.TAIL)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
