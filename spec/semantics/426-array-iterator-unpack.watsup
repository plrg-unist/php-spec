def $array_iterator_key_valid(PINT i) = $(-9223372036854775808 <= i /\ i <= 9223372036854775807)
def $array_iterator_key_valid(pvalue) = ($string_bytes(pvalue) =/= eps) -- otherwise
def $array_iterator_key(PINT i) = eps
def $array_iterator_key(pvalue) = eps
  -- if $string_bytes(pvalue) = (n_bytes*)
  -- if $string_key(n_bytes*) = INTEGERKEY i
def $array_iterator_key(pvalue) = (KSTRING n_bytes*)
  -- if $string_bytes(pvalue) = (n_bytes*)
  -- if $string_key(n_bytes*) = STRINGKEY

def $array_iterator_insert(S, parrayiterator, ptask_tail*) = $throw_scalar(S, "Error", $ptascii("Keys must be of type int|string during array unpacking"), parrayiterator.LINE)
  -- if parrayiterator.KEY = KNOWN pvalue_key
  -- if ~$array_iterator_key_valid(pvalue_key)
def $array_iterator_insert(S, parrayiterator, ptask_tail*) = $array_iterator_clear(S_insert, parrayiterator, "next-start", ptask_tail*)
  -- if parrayiterator.KEY = KNOWN pvalue_key
  -- if $array_iterator_key_valid(pvalue_key)
  -- if $array_iterator_value(S, parrayiterator.CURRENT) = (pvalue)
  -- if S_insert = $literal_insert(S, parrayiterator.ARRAY, $array_iterator_key(pvalue_key), pvalue, parrayiterator.LINE)
  -- if S_insert.COMPLETION = NORMAL
def $array_iterator_insert(S, parrayiterator, ptask_tail*) = S_insert
  -- if parrayiterator.KEY = KNOWN pvalue_key
  -- if $array_iterator_key_valid(pvalue_key)
  -- if $array_iterator_value(S, parrayiterator.CURRENT) = (pvalue)
  -- if S_insert = $literal_insert(S, parrayiterator.ARRAY, $array_iterator_key(pvalue_key), pvalue, parrayiterator.LINE)
  -- if S_insert.COMPLETION =/= NORMAL
rule PhpStep/array-iterator-insert: S ~> $array_iterator_insert(S, parrayiterator, ptask_tail*)
