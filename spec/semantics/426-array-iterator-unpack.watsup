def $array_iterator_stage(parrayiterator, text) = false -- otherwise

def $array_iterator_valid(S, parrayiterator, text) = true
  -- if $array_iterator_source(S, parrayiterator)
  -- if $array_iterator_stage(parrayiterator, text)
