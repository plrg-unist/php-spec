def $array_iterator_clear(S, parrayiterator, text, ptask_tail*) = S[.TODO = (ARRAY_ITERATOR parrayiterator[.CURRENT = KNOWN PNULL][.KEY = KNOWN PNULL] text) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
def $array_iterator_call_stage("rewind-start") = ("rewind")
def $array_iterator_call_stage("valid-start") = ("valid")
def $array_iterator_call_stage("current-start") = ("current")
def $array_iterator_call_stage("key-start") = ("key")
def $array_iterator_call_stage("next-start") = ("next")
