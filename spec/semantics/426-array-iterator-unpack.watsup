def $array_iterator_call(S, parrayiterator, text, ptask_tail*) = S[.TODO = [(CALL_ARGS (UNPACK_ITERATOR_TARGET parrayiterator.OBJECT pmethoddesc.FUNCTION.ORIGIN) eps 0 eps (parrayiterator.SITE) parrayiterator.LINE), ARRAY_ITERATOR parrayiterator text] ++ ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
