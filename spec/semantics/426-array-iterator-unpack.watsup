  -- if S.ORIGIN = (porigin_site)
  -- if S.TODO = (CALL_ARGS (UNPACK_ITERATOR_TARGET n porigin_method) eps 0 eps (porigin_site) z) :: (ARRAY_ITERATOR parrayiterator text) :: ptask_tail*
