;; RECV converts the formal slot after SEND has copied a by-value argument.
;; The saved integer and notice borrow that ENV-owned cell; they add no root.
dec $lossy_parameter_metadata(pstate, porigin, int) : bool
def $lossy_parameter_metadata(S, porigin_function, z) = true
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.FUNCTION = porigin_function /\ pcallcontext.TARGET = porigin_function
  -- if pcallcontext.WRAPPER = eps /\ pcallcontext.INSTANCE = eps /\ pcallcontext.RECEIVER = eps
  -- if pcallcontext.LEXICAL_CLASS = eps /\ pcallcontext.CALLED_CLASS = eps
  -- if pcallcontext.ARGC = 1 /\ pcallcontext.HOLES = eps /\ pcallcontext.EXTRA = eps /\ pcallcontext.NAMED = eps
  -- if pcallcontext.CALLSITE = (porigin_call)
  -- if $origin_node(S.SOURCES, porigin_call) = (NExprFuncCall phpType19 (SEQUENCE phpType7*) metadata_call)
  -- if phpType7* = (NArg ABSENT expression (BOOLEAN false) (BOOLEAN false) metadata) :: eps
  -- if $call_selected_valid(S, porigin_function, (porigin_call))
  -- if $function_at(S.FUNCTIONS, porigin_function) = (pfunction)
  -- if ~pfunction.SIGNATURE.BYREF /\ ~$function_generator(S, pfunction) /\ ~$generator_active(S)
  -- if S.ACTIVEFIBER = eps /\ S.CONSTCONTEXT = eps
  -- if pfunction.SIGNATURE.PARAMETERS = [psparam]
  -- if psparam.REQUIRED /\ psparam.DEFAULT = PSNONE /\ ~psparam.BYREF /\ ~psparam.VARIADIC
  -- if $ptmasks(psparam.TYPE) = ["int"]
  -- if ~$typed_caller_strict(S)
  -- if z = $default_parameter_line(S, porigin_function, 0)
  -- if $parameter_string_site_valid(S, $default_parameter_origin(S, porigin_function, 0), z)
  -- if $typed_receive_valid(S[.TODO = [TYPE_RECEIVE porigin_function 0]][.ORIGIN = (porigin_function)], porigin_function, 0)
def $lossy_parameter_metadata(S, porigin_function, z) = false -- otherwise

dec $lossy_parameter_snapshot(nat) : (int, ptbytes)?
def $lossy_parameter_snapshot(n_bits) = ((pintegerconversion.VALUE, ptbytes))
  -- if $(n_bits < 18446744073709551616)
  -- if $typed_weak(["int"], PFLOAT n_bits) = TYPEINTEGER (PFLOAT n_bits)
  -- if $integer_conversion(PFLOAT n_bits) = (pintegerconversion)
  -- if pintegerconversion.NOTICES = [(8192, ptbytes)]
def $lossy_parameter_snapshot(n_bits) = eps -- otherwise

dec $lossy_parameter_source_valid(pstate, ptask) : bool
def $lossy_parameter_source_valid(S, LOSSY_PARAMETER_RECEIVE porigin_function n_cell n_bits i z) = true
  -- if $lossy_parameter_metadata(S, porigin_function, z)
  -- if S.ORIGIN = ($default_parameter_origin(S, porigin_function, 0))
  -- if $function_at(S.FUNCTIONS, porigin_function) = (pfunction)
  -- if $lookup(S.ENV, pfunction.SIGNATURE.PARAMETERS[0].NAME) = (n_cell)
  -- if $(n_cell < |S.STORE|) /\ (HCELL n_cell) <- S.ALLOCATIONS
  -- if $lossy_parameter_snapshot(n_bits) = ((i, ptbytes))
def $lossy_parameter_source_valid(S, ptask) = false -- otherwise
def $call_task_valid(S, LOSSY_PARAMETER_RECEIVE porigin_function n_cell n_bits i z) = (S.TODO = [LOSSY_PARAMETER_RECEIVE porigin_function n_cell n_bits i z] /\ $lossy_parameter_source_valid(S, LOSSY_PARAMETER_RECEIVE porigin_function n_cell n_bits i z))
def $task_nodes(LOSSY_PARAMETER_RECEIVE porigin_function n_cell n_bits i z) = eps

dec $lossy_parameter_ready(pstate, nat, nat) : bool
def $lossy_parameter_ready(S, n_cell, n_bits) = true
  -- if S.STORE[n_cell] = DEFINED (PFLOAT n_bits)
  -- if ~(n_cell <- S.REFCELLS) /\ $propref_at(S.PROPREFS, n_cell) = eps
  -- if $heap_owners($heap_graph(S), HCELL n_cell) = 1
  -- if S.HELD = eps /\ S.OUTPUTBUFFERS = eps /\ ~S.OUTPUTBLOCKED /\ S.TICKENTRIES = eps
def $lossy_parameter_ready(S, n_cell, n_bits) = false -- otherwise

dec $lossy_parameter_capture(pstate) : ptask?
def $lossy_parameter_capture(S) = (LOSSY_PARAMETER_RECEIVE porigin_function n_cell n_bits i z)
  -- if S.TODO = [TYPE_RECEIVE porigin_function 0]
  -- if S.COMPLETION = NORMAL
  -- if $function_at(S.FUNCTIONS, porigin_function) = (pfunction)
  -- if z = $default_parameter_line(S, porigin_function, 0)
  -- if $lossy_parameter_metadata(S, porigin_function, z)
  -- if $lookup(S.ENV, pfunction.SIGNATURE.PARAMETERS[0].NAME) = (n_cell)
  -- if $(n_cell < |S.STORE|) /\ (HCELL n_cell) <- S.ALLOCATIONS
  -- if S.STORE[n_cell] = DEFINED (PFLOAT n_bits)
  -- if $typed_parameter_conversion(S, pfunction.SIGNATURE.PARAMETERS[0], PFLOAT n_bits) = TYPEINTEGER (PFLOAT n_bits)
  -- if $lossy_parameter_snapshot(n_bits) = ((i, ptbytes))
def $lossy_parameter_capture(S) = eps -- otherwise
def $lossy_parameter_candidate(S) = ($lossy_parameter_capture(S) =/= eps)

rule PhpStep/lossy-parameter-begin: S ~> $error_dispatch(S[.TODO = [ptask_source]][.ORIGIN = (porigin_site)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], 8192, ptbytes, z, DIAGNOSTIC "Deprecated" ptbytes z, ptask_source)
  -- if $lossy_parameter_capture(S) = (ptask_source)
  -- if ptask_source = LOSSY_PARAMETER_RECEIVE porigin_function n_cell n_bits i z
  -- if $lossy_parameter_ready(S, n_cell, n_bits)
  -- if $lossy_parameter_snapshot(n_bits) = ((i, ptbytes))
  -- if porigin_site = $default_parameter_origin(S, porigin_function, 0)
rule PhpStep/lossy-parameter-entry-refused: S ~> S[.COMPLETION = UNSUPPORTED "lossy parameter receive context"]
  -- if $lossy_parameter_capture(S) = (LOSSY_PARAMETER_RECEIVE porigin_function n_cell n_bits i z)
  -- if ~$lossy_parameter_ready(S, n_cell, n_bits)

def $error_call_valid(S, perrorcall) = true
  -- if perrorcall.RESUME = LOSSY_PARAMETER_RECEIVE porigin_function n_cell n_bits i z
  -- if $lossy_parameter_source_valid(S, perrorcall.RESUME)
  -- if $lossy_parameter_snapshot(n_bits) = ((i, ptbytes))
  -- if perrorcall.SITE = $default_parameter_origin(S, porigin_function, 0)
