rule PhpStep/lossy-parameter-finish: S ~> $default_store(S, pfunction, 0, PINT i)
  -- if S.TODO = [LOSSY_PARAMETER_RECEIVE porigin_function n_cell n_bits i z]
  -- if $lossy_parameter_source_valid(S, LOSSY_PARAMETER_RECEIVE porigin_function n_cell n_bits i z)
  -- if $lossy_parameter_ready(S, n_cell, n_bits)
  -- if $function_at(S.FUNCTIONS, porigin_function) = (pfunction)
rule PhpStep/lossy-parameter-finish-refused: S ~> S[.COMPLETION = UNSUPPORTED "lossy parameter receive continuation"]
  -- if S.TODO = [LOSSY_PARAMETER_RECEIVE porigin_function n_cell n_bits i z]
