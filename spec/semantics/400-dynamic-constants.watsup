;; Dynamic global constants capture the evaluated arguments in the ordinary
;; constant table. Primitive variable payloads keep its structural value policy.
def $intrinsic_name(INTRINSIC_DEFINE) = $ptascii("define")
def $intrinsic_name(INTRINSIC_DEFINED) = $ptascii("defined")
def $intrinsic_name(INTRINSIC_CONSTANT) = $ptascii("constant")
def $intrinsic_named(preqbytes) = (INTRINSIC_DEFINE) -- if $ptlc(preqbytes) = $ptascii("define")
def $intrinsic_named(preqbytes) = (INTRINSIC_DEFINED) -- if $ptlc(preqbytes) = $ptascii("defined")
def $intrinsic_named(preqbytes) = (INTRINSIC_CONSTANT) -- if $ptlc(preqbytes) = $ptascii("constant")
def $config_kind(INTRINSIC_DEFINE) = true
def $config_kind(INTRINSIC_DEFINED) = true
def $config_kind(INTRINSIC_CONSTANT) = true
def $dynamic_constant_kind(INTRINSIC_DEFINE) = true
def $dynamic_constant_kind(INTRINSIC_DEFINED) = true
def $dynamic_constant_kind(INTRINSIC_CONSTANT) = true
dec $dynamic_scalar_constant_call(pconfigcall) : bool
dec $dynamic_null_constant_call(pconfigcall) : bool
dec $dynamic_null_define_call(pconfigcall) : bool
dec $dynamic_scalar_define_flag_call(pconfigcall) : bool
dec $dynamic_null_define_flag_call(pconfigcall) : bool
dec $dynamic_nan_define_flag_call(pconfigcall) : bool
dec $dynamic_class_define_call(pconfigcall) : bool
dec $dynamic_class_define_scalar_call(pconfigcall) : bool
dec $dynamic_class_define_null_call(pconfigcall) : bool
dec $dynamic_class_define_nan_call(pconfigcall) : bool
def $config_parameter(INTRINSIC_DEFINE, preqbytes) = (0) -- if preqbytes = $ptascii("constant_name")
def $config_parameter(INTRINSIC_DEFINE, preqbytes) = (1) -- if preqbytes = $ptascii("value")
def $config_parameter(INTRINSIC_DEFINE, preqbytes) = (2) -- if preqbytes = $ptascii("case_insensitive")
def $config_parameter(INTRINSIC_DEFINED, preqbytes) = (0) -- if preqbytes = $ptascii("constant_name")
def $config_parameter(INTRINSIC_CONSTANT, preqbytes) = (0) -- if preqbytes = $ptascii("name")
def $config_parameter_name(INTRINSIC_DEFINE, 0) = $ptascii("constant_name")
def $config_parameter_name(INTRINSIC_DEFINE, 1) = $ptascii("value")
def $config_parameter_name(INTRINSIC_DEFINE, 2) = $ptascii("case_insensitive")
def $config_parameter_name(INTRINSIC_DEFINED, 0) = $ptascii("constant_name")
def $config_parameter_name(INTRINSIC_CONSTANT, 0) = $ptascii("name")

dec $dynamic_constant_class_name(preqbytes) : bool
def $dynamic_constant_class_name(eps) = false
def $dynamic_constant_class_name([n_byte]) = false
def $dynamic_constant_class_name(n_first :: n_second :: n_tail*) = ((n_first = 58 /\ n_second = 58) \/ $dynamic_constant_class_name(n_second :: n_tail*))
dec $dynamic_constant_global_name(preqbytes) : bool
def $dynamic_constant_global_name(preqbytes) = (~(0 <- preqbytes) /\ ~$dynamic_constant_class_name(preqbytes) /\ preqbytes =/= $ptascii("__COMPILER_HALT_OFFSET__"))
dec $dynamic_constant_initial(preqbytes) : bool
def $dynamic_constant_initial(preqbytes) = ($initial_constant_bytes(preqbytes) \/ $special_constant(preqbytes) =/= eps)
dec $dynamic_constant_query(preqbytes) : preqbytes
def $dynamic_constant_query(92 :: n_tail*) = n_tail*
def $dynamic_constant_query(preqbytes) = preqbytes -- otherwise
dec $dynamic_constant_exists(pstate, preqbytes) : bool
def $dynamic_constant_exists(S, preqbytes) = ($source_constant_lookup(S, $dynamic_constant_query(preqbytes)) =/= eps \/ $special_constant($dynamic_constant_query(preqbytes)) =/= eps)
dec $dynamic_constant_class(pvalue) : pvalueclass?
def $dynamic_constant_class(PSTRING_CARRIER INTERNED_STRING n_bytes*) = (PVSTRING true)
def $dynamic_constant_class(PSTRING_CARRIER (REQUEST_STRING n_string) n_bytes*) = (PVSTRING false)
def $dynamic_constant_class(pvalue) = (PVSCALAR) -- if $constant_nonstring_scalar(pvalue)
def $dynamic_constant_class(pvalue) = eps -- otherwise

dec $dynamic_define_value_class(pstate, pvalue) : pvalueclass?
def $dynamic_define_value_class(S, pvalue) = (pvalueclass)
  -- if $dynamic_constant_class(pvalue) = (pvalueclass)
def $dynamic_define_value_class(S, POBJECT n_object) = (PVSTDCLASS n_object pconstantstdobject.SITE)
  -- if $global_std_record(S.CONSTANTSTDOBJECTS, n_object) = (pconstantstdobject)
  -- if $constant_value_class_valid(S, POBJECT n_object, PVSTDCLASS n_object pconstantstdobject.SITE)
def $dynamic_define_value_class(S, pvalue) = eps -- otherwise

;; A historical definition does not resolve mutable CVs or a namespace fallback
;; that a later conditional function declaration could shadow.
dec $dynamic_define_selected(pstate, porigin, pselectedcall*) : bool
def $dynamic_define_selected(S, porigin, eps) = false
def $dynamic_define_selected(S, porigin, pselectedcall :: pselectedcall_tail*) = true
  -- if pselectedcall.SITE = porigin
  -- if pselectedcall.KIND = INTRINSIC_DEFINE
  -- if $selected_entry_source_valid(S, pselectedcall)
def $dynamic_define_selected(S, porigin, pselectedcall :: pselectedcall_tail*) = $dynamic_define_selected(S, porigin, pselectedcall_tail*)
  -- if pselectedcall.SITE =/= porigin \/ pselectedcall.KIND =/= INTRINSIC_DEFINE \/ ~$selected_entry_source_valid(S, pselectedcall)
dec $dynamic_define_source(pstate, porigin) : bool
def $dynamic_define_source(S, porigin) = true
  -- if $exit_fixed(S, porigin) = ((preqbytes, preqbytes_fallback?))
  -- if $intrinsic_named(preqbytes) = (INTRINSIC_DEFINE)
  -- if $intrinsic_count(S, porigin) = (n_count)
  -- if $(n_count >= 2 /\ n_count <= 3)
def $dynamic_define_source(S, porigin) = true
  -- if $exit_fixed(S, porigin) = eps
  -- if $dynamic_define_selected(S, porigin, S.SELECTEDCALLS)
  -- if $intrinsic_count(S, porigin) = (n_count)
  -- if $(n_count >= 2 /\ n_count <= 3)
def $dynamic_define_source(S, porigin) = false -- otherwise
dec $dynamic_define_values(pconfigcall) : (preqbytes, pvalue)?
def $dynamic_define_values(pconfigcall) = ((preqbytes, pvalue))
  -- if pconfigcall.SENT = [NAMED_SENT (KNOWN pvalue_name), NAMED_SENT (KNOWN pvalue)]
  -- if $string_bytes(pvalue_name) = (preqbytes)
def $dynamic_define_values(pconfigcall) = ((preqbytes, pvalue))
  -- if pconfigcall.SENT = [NAMED_SENT (KNOWN pvalue_name), NAMED_SENT (KNOWN pvalue), NAMED_SENT (KNOWN (PBOOL false))]
  -- if $string_bytes(pvalue_name) = (preqbytes)
def $dynamic_define_values(pconfigcall) = ((preqbytes, pvalue))
  -- if pconfigcall.SENT = [NAMED_SENT (KNOWN pvalue_name), NAMED_SENT (KNOWN pvalue), NAMED_SENT (KNOWN (PBOOL true))]
  -- if $string_bytes(pvalue_name) = (preqbytes)
def $dynamic_define_values(pconfigcall) = eps -- otherwise

dec $dynamic_constant_case_flag(pconfigcall) : bool
def $dynamic_constant_case_flag(pconfigcall) = true
  -- if pconfigcall.SENT = [NAMED_SENT (KNOWN pvalue_name), NAMED_SENT (KNOWN pvalue), NAMED_SENT (KNOWN (PBOOL true))]
def $dynamic_constant_case_flag(pconfigcall) = false -- otherwise
dec $dynamic_constant_case_message() : ptbytes
def $dynamic_constant_case_message() = $ptascii("define(): Argument #3 ($case_insensitive) is ignored since declaration of case-insensitive constants is no longer supported")
dec $dynamic_constant_case_valid(pstate, pconfigcall) : bool
dec $dynamic_constant_duplicate_valid(pstate, pconfigcall, nat) : bool
dec $dynamic_startup_define_duplicate_valid(pstate, pconfigcall, nat) : bool
;; Registration occurs after the ignored-flag warning, so a callback may have
;; installed the same key. Keep the original captured arguments in either path.
dec $dynamic_define_known(pstate, porigin, nat) : pvalue?
dec $dynamic_array_call_valid(pstate, pconfigcall) : bool
dec $dynamic_array_duplicate_call_valid(pstate, pconfigcall, nat) : bool
dec $dynamic_array_duplicate_valid(pstate, pconfigcall, nat, pvalueclass, nat) : bool
dec $dynamic_array_value(pstate, pvalue, nat*, bool) : (pstate, pvalue, pvalueclass)?
dec $dynamic_array_recursive(pstate, pvalue, nat*) : bool?
dec $dynamic_array_known_matches(pstate, pvalue, pvalue?) : bool
dec $dynamic_defined_receive(pstate, pconfigcall) : pstate
dec $dynamic_class_constant_receive(pstate, pconfigcall) : pstate
dec $dynamic_global_constant_call(pconfigcall) : bool
dec $dynamic_halt_call(pconfigcall) : bool
dec $dynamic_halt_receive(pstate, pconfigcall) : pstate
dec $dynamic_global_constant_finish(pstate, pconfigcall) : pstate
dec $dynamic_scalar_define_call(pconfigcall) : bool
dec $dynamic_scalar_define_arguments(pstate, pconfigcall, nat) : bool
dec $dynamic_nan_define_name_entry(pstate, pconfigcall) : bool
dec $dynamic_define_finish(pstate, pconfigcall) : pstate
def $dynamic_define_finish(S, pconfigcall) = S[.TODO = ptask_tail*][.USERCONSTANTS = S.USERCONSTANTS ++ [{NAME $user_constant_key(preqbytes), ORIGIN pconfigcall.SITE, VALUE pvalue, CLASS pvalueclass, READS eps, RECEIVES eps}]][.RESULT = KNOWN (PBOOL true)][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if pconfigcall.KIND = INTRINSIC_DEFINE
  -- if pconfigcall.OWNER = eps /\ pconfigcall.PACKS = eps
  -- if $dynamic_define_source(S, pconfigcall.SITE)
  -- if $dynamic_define_values(pconfigcall) = ((preqbytes, pvalue))
  -- if $dynamic_constant_global_name(preqbytes)
  -- if $dynamic_define_value_class(S, pvalue) = (pvalueclass)
  -- if ~$dynamic_constant_case_flag(pconfigcall) \/ $dynamic_constant_class(pvalue) =/= eps
  -- if $string_plain(pvalue) = pvalue \/ $string_carrier_valid(S, pvalue)
  -- if ~$dynamic_constant_initial(preqbytes)
  -- if $source_constant_lookup(S, preqbytes) = eps
  -- if S.TODO = ptask :: ptask_tail*
def $dynamic_define_finish(S, pconfigcall) = $error_dispatch(S[.TODO = (DYNAMIC_CONSTANT_DUPLICATE pconfigcall n_constants) :: ptask_tail*], 2, ptbytes_message, pconfigcall.LINE, DIAGNOSTIC "Warning" ptbytes_message pconfigcall.LINE, DYNAMIC_CONSTANT_DUPLICATE pconfigcall n_constants)
  -- if n_constants = |S.USERCONSTANTS|
  -- if $dynamic_constant_duplicate_valid(S, pconfigcall, n_constants)
  -- if $dynamic_define_values(pconfigcall) = ((preqbytes, pvalue))
  -- if ptbytes_message = $global_constant_duplicate_message(preqbytes)
  -- if S.TODO = ptask :: ptask_tail*
def $dynamic_define_finish(S, pconfigcall) = S_copy[.TODO = ptask_tail*][.USERCONSTANTS = S.USERCONSTANTS ++ [{NAME $user_constant_key(preqbytes), ORIGIN pconfigcall.SITE, VALUE pvalue, CLASS pvalueclass, READS eps, RECEIVES eps}]][.RESULT = KNOWN (PBOOL true)][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if $dynamic_array_call_valid(S, pconfigcall)
  -- if $dynamic_define_values(pconfigcall) = ((preqbytes, PARRAY n_array))
  -- if $source_constant_lookup(S, preqbytes) = eps
  -- if $dynamic_array_value(S, PARRAY n_array, eps, true) = ((S_copy, pvalue, pvalueclass))
  -- if $dynamic_array_known_matches(S_copy, pvalue, $dynamic_define_known(S_copy, pconfigcall.SITE, 1))
  -- if S.TODO = ptask :: ptask_tail*
def $dynamic_define_finish(S, pconfigcall) = $config_error(S[.TODO = ptask_tail*], pconfigcall, "ValueError", $ptascii("define(): Argument #2 ($value) cannot be a recursive array"))
  -- if $dynamic_array_call_valid(S, pconfigcall)
  -- if $dynamic_define_values(pconfigcall) = ((preqbytes, PARRAY n_array))
  -- if $dynamic_define_known(S, pconfigcall.SITE, 1) = eps
  -- if $dynamic_array_recursive(S, PARRAY n_array, eps) = (true)
  -- if S.TODO = (CONFIG_INVOKE pconfigcall) :: ptask_tail*
def $dynamic_define_finish(S, pconfigcall) = $error_dispatch(S_copy[.TODO = (DYNAMIC_ARRAY_CONSTANT_DUPLICATE pconfigcall n_candidate pvalueclass n_constants) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], 2, ptbytes_message, pconfigcall.LINE, DIAGNOSTIC "Warning" ptbytes_message pconfigcall.LINE, DYNAMIC_ARRAY_CONSTANT_DUPLICATE pconfigcall n_candidate pvalueclass n_constants)
  -- if n_constants = |S.USERCONSTANTS|
  -- if $dynamic_array_duplicate_call_valid(S, pconfigcall, n_constants)
  -- if $dynamic_define_values(pconfigcall) = ((preqbytes, PARRAY n_input))
  -- if $dynamic_array_value(S, PARRAY n_input, eps, true) = ((S_copy, PARRAY n_candidate, pvalueclass))
  -- if $dynamic_array_duplicate_valid(S_copy, pconfigcall, n_candidate, pvalueclass, n_constants)
  -- if ptbytes_message = $global_constant_duplicate_message(preqbytes)
  -- if S.TODO = ptask :: ptask_tail*
def $dynamic_define_finish(S, pconfigcall) = S[.COMPLETION = UNSUPPORTED "dynamic constant call domain"] -- otherwise

;; Query arity is checked before string reception and lookup.
dec $dynamic_query_arity_call(pconfigcall) : bool
def $dynamic_query_arity_call(pconfigcall) = true
  -- if pconfigcall.KIND <- [INTRINSIC_CONSTANT, INTRINSIC_DEFINED]
  -- if pconfigcall.OWNER = eps /\ pconfigcall.PACKS = eps /\ ~pconfigcall.NAMED
  -- if $(|pconfigcall.SENT| =/= 1)
def $dynamic_query_arity_call(pconfigcall) = false -- otherwise
dec $dynamic_query_arity_arguments(pstate, pnamedslot*) : bool
def $dynamic_query_arity_arguments(S, eps) = true
def $dynamic_query_arity_arguments(S, (NAMED_SENT (KNOWN pvalue)) :: pnamedslot*) = true
  -- if $dynamic_constant_class(pvalue) =/= eps
  -- if $string_plain(pvalue) = pvalue \/ $string_carrier_valid(S, pvalue)
  -- if $dynamic_query_arity_arguments(S, pnamedslot*)
def $dynamic_query_arity_arguments(S, pnamedslot*) = false -- otherwise
dec $dynamic_query_arity_valid(pstate, pconfigcall) : bool
def $dynamic_query_arity_valid(S, pconfigcall) = true
  -- if $dynamic_query_arity_call(pconfigcall) /\ $config_invoke_valid(S, pconfigcall)
  -- if $dynamic_scalar_define_arguments(S, pconfigcall, 0)
  -- if $dynamic_query_arity_arguments(S, pconfigcall.SENT)
def $dynamic_query_arity_valid(S, pconfigcall) = false -- otherwise
dec $dynamic_define_arity_call(pconfigcall) : bool
def $dynamic_define_arity_call(pconfigcall) = true
  -- if pconfigcall.KIND = INTRINSIC_DEFINE
  -- if pconfigcall.OWNER = eps /\ pconfigcall.PACKS = eps /\ ~pconfigcall.NAMED
  -- if $(|pconfigcall.SENT| < 2 \/ |pconfigcall.SENT| > 3)
def $dynamic_define_arity_call(pconfigcall) = false -- otherwise
dec $dynamic_define_arity_valid(pstate, pconfigcall) : bool
def $dynamic_define_arity_valid(S, pconfigcall) = true
  -- if $dynamic_define_arity_call(pconfigcall) /\ $config_invoke_valid(S, pconfigcall)
  -- if $dynamic_scalar_define_arguments(S, pconfigcall, 0)
  -- if $dynamic_query_arity_arguments(S, pconfigcall.SENT)
def $dynamic_define_arity_valid(S, pconfigcall) = false -- otherwise
dec $dynamic_define_arity_message(pconfigcall) : preqbytes
def $dynamic_define_arity_message(pconfigcall) = $ptascii("define() expects at least 2 arguments, ") ++ $decimal_integer(|pconfigcall.SENT|) ++ $ptascii(" given")
  -- if $(|pconfigcall.SENT| < 2)
def $dynamic_define_arity_message(pconfigcall) = $ptascii("define() expects at most 3 arguments, ") ++ $decimal_integer(|pconfigcall.SENT|) ++ $ptascii(" given")
  -- if $(|pconfigcall.SENT| > 3)

;; Array names fail string reception without copying their trace-owned payload.
dec $dynamic_query_array_call(pconfigcall) : bool
def $dynamic_query_array_call(pconfigcall) = true
  -- if pconfigcall.KIND <- [INTRINSIC_CONSTANT, INTRINSIC_DEFINED]
  -- if pconfigcall.OWNER = eps /\ pconfigcall.PACKS = eps /\ ~pconfigcall.NAMED
  -- if pconfigcall.SENT = [NAMED_SENT (KNOWN (PARRAY n_array))]
def $dynamic_query_array_call(pconfigcall) = false -- otherwise
dec $dynamic_query_array_entries(pstate, pentry*) : bool
def $dynamic_query_array_entries(S, eps) = true
def $dynamic_query_array_entries(S, (ENTRY pkey (DIRECT pvalue)) :: pentry*) = $dynamic_query_array_entries(S, pentry*)
  -- if $dynamic_query_arity_arguments(S, [NAMED_SENT (KNOWN pvalue)])
def $dynamic_query_array_entries(S, (ENTRY pkey (ALIAS n_cell)) :: pentry*) = $dynamic_query_array_entries(S, pentry*)
  -- if $call_reference_operand_valid(S, REFERENCE n_cell)
  -- if S.STORE[n_cell] = DEFINED pvalue
  -- if $dynamic_query_arity_arguments(S, [NAMED_SENT (KNOWN pvalue)])
def $dynamic_query_array_entries(S, pentry*) = false -- otherwise
dec $dynamic_query_array_valid(pstate, pconfigcall) : bool
def $dynamic_query_array_valid(S, pconfigcall) = true
  -- if $dynamic_query_array_call(pconfigcall) /\ $config_invoke_valid(S, pconfigcall)
  -- if pconfigcall.SENT = [NAMED_SENT (KNOWN (PARRAY n_array))]
  -- if $intrinsic_argument(S, pconfigcall.SITE, 0) = ((expression, false, eps, porigin_argument, z_argument))
  -- if $dynamic_array_known_matches(S, PARRAY n_array, $compiled_read(S, porigin_argument))
  -- if $dynamic_query_array_entries(S, S.ARRAYS[n_array].ITEMS)
def $dynamic_query_array_valid(S, pconfigcall) = false -- otherwise

;; The first string parameter rejects arrays before optional bool reception.
dec $dynamic_define_array_name_call(pconfigcall) : bool
def $dynamic_define_array_name_call(pconfigcall) = true
  -- if pconfigcall.KIND = INTRINSIC_DEFINE
  -- if pconfigcall.OWNER = eps /\ pconfigcall.PACKS = eps /\ ~pconfigcall.NAMED
  -- if pconfigcall.SENT = (NAMED_SENT (KNOWN (PARRAY n_array))) :: pnamedslot*
  -- if $(|pnamedslot*| = 1 \/ |pnamedslot*| = 2)
def $dynamic_define_array_name_call(pconfigcall) = false -- otherwise
dec $dynamic_define_array_name_valid(pstate, pconfigcall) : bool
def $dynamic_define_array_name_valid(S, pconfigcall) = true
  -- if $dynamic_define_array_name_call(pconfigcall) /\ $config_invoke_valid(S, pconfigcall)
  -- if $dynamic_define_source(S, pconfigcall.SITE)
  -- if pconfigcall.SENT = (NAMED_SENT (KNOWN (PARRAY n_array))) :: pnamedslot*
  -- if $intrinsic_argument(S, pconfigcall.SITE, 0) = ((expression, false, eps, porigin_argument, z_argument))
  -- if $dynamic_array_known_matches(S, PARRAY n_array, $compiled_read(S, porigin_argument))
  -- if $dynamic_query_array_entries(S, S.ARRAYS[n_array].ITEMS)
  -- if $dynamic_scalar_define_arguments(S, pconfigcall, 1)
  -- if $dynamic_query_arity_arguments(S, pnamedslot*)
def $dynamic_define_array_name_valid(S, pconfigcall) = false -- otherwise

dec $dynamic_constant_receive(pstate, pconfigcall) : pstate
def $dynamic_constant_receive(S, pconfigcall) = $config_error(S[.TODO = ptask_tail*], pconfigcall, "TypeError", $ptascii("define(): Argument #1 ($constant_name) must be of type string, array given"))
  -- if $dynamic_define_array_name_valid(S, pconfigcall)
  -- if S.TODO = (CONFIG_INVOKE pconfigcall) :: ptask_tail*
def $dynamic_constant_receive(S, pconfigcall) = $config_error(S[.TODO = ptask_tail*], pconfigcall, "TypeError", $intrinsic_name(pconfigcall.KIND) ++ $ptascii("(): Argument #1 ($") ++ $config_parameter_name(pconfigcall.KIND, 0) ++ $ptascii(") must be of type string, array given"))
  -- if $dynamic_query_array_valid(S, pconfigcall)
  -- if S.TODO = (CONFIG_INVOKE pconfigcall) :: ptask_tail*
def $dynamic_constant_receive(S, pconfigcall) = $config_error(S[.TODO = ptask_tail*], pconfigcall, "ArgumentCountError", $dynamic_define_arity_message(pconfigcall))
  -- if $dynamic_define_arity_valid(S, pconfigcall)
  -- if S.TODO = (CONFIG_INVOKE pconfigcall) :: ptask_tail*
def $dynamic_constant_receive(S, pconfigcall) = $config_error(S[.TODO = ptask_tail*], pconfigcall, "ArgumentCountError", $intrinsic_name(pconfigcall.KIND) ++ $ptascii("() expects exactly 1 argument, ") ++ $decimal_integer(|pconfigcall.SENT|) ++ $ptascii(" given"))
  -- if $dynamic_query_arity_valid(S, pconfigcall)
  -- if S.TODO = (CONFIG_INVOKE pconfigcall) :: ptask_tail*
def $dynamic_constant_receive(S, pconfigcall) = $dynamic_define_finish(S, pconfigcall)
  -- if pconfigcall.KIND = INTRINSIC_DEFINE
  -- if ~$dynamic_constant_case_flag(pconfigcall)
  -- if ~$dynamic_define_arity_call(pconfigcall)
  -- if ~$dynamic_define_array_name_call(pconfigcall)
  -- if S.TODO = (CONFIG_INVOKE pconfigcall) :: ptask_tail*
def $dynamic_constant_receive(S, pconfigcall) = S[.TODO = ptask_tail*][.RESULT = KNOWN (PBOOL $dynamic_constant_exists(S, preqbytes))][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if pconfigcall.KIND = INTRINSIC_DEFINED
  -- if pconfigcall.OWNER = eps
  -- if pconfigcall.SENT = [NAMED_SENT (KNOWN pvalue_name)]
  -- if $string_bytes(pvalue_name) = (preqbytes)
  -- if $dynamic_constant_global_name($dynamic_constant_query(preqbytes))
  -- if S.TODO = (CONFIG_INVOKE pconfigcall) :: ptask_tail*
def $dynamic_constant_receive(S, pconfigcall) = $error_dispatch(S[.TODO = (DYNAMIC_CONSTANT_CASE_WARNING pconfigcall) :: ptask_tail*], 2, $dynamic_constant_case_message(), pconfigcall.LINE, DIAGNOSTIC "Warning" $dynamic_constant_case_message() pconfigcall.LINE, DYNAMIC_CONSTANT_CASE_WARNING pconfigcall)
  -- if $dynamic_constant_case_valid(S, pconfigcall)
  -- if S.TODO = (CONFIG_INVOKE pconfigcall) :: ptask_tail*
def $dynamic_constant_receive(S, pconfigcall) = $dynamic_defined_receive(S, pconfigcall)
  -- if pconfigcall.KIND = INTRINSIC_DEFINED
  -- if pconfigcall.SENT = [NAMED_SENT (KNOWN pvalue_query)]
  -- if $string_bytes(pvalue_query) = (preqbytes)
  -- if $dynamic_constant_class_name($dynamic_constant_query(preqbytes))
def $dynamic_constant_receive(S, pconfigcall) = $dynamic_class_constant_receive(S, pconfigcall)
  -- if pconfigcall.KIND = INTRINSIC_CONSTANT
  -- if ~$dynamic_global_constant_call(pconfigcall)
  -- if ~$dynamic_halt_call(pconfigcall)
  -- if ~$dynamic_query_arity_call(pconfigcall)
  -- if ~$dynamic_query_array_call(pconfigcall)
def $dynamic_constant_receive(S, pconfigcall) = $dynamic_halt_receive(S, pconfigcall)
  -- if pconfigcall.KIND = INTRINSIC_DEFINED \/ pconfigcall.KIND = INTRINSIC_CONSTANT
  -- if $dynamic_halt_call(pconfigcall)
def $dynamic_constant_receive(S, pconfigcall) = $dynamic_global_constant_finish(S, pconfigcall)
  -- if pconfigcall.KIND = INTRINSIC_CONSTANT
  -- if $dynamic_global_constant_call(pconfigcall)
def $dynamic_constant_receive(S, pconfigcall) = S[.COMPLETION = UNSUPPORTED "dynamic constant call domain"] -- otherwise

rule PhpStep/dynamic-constant-invoke: S ~> $dynamic_constant_receive(S, pconfigcall)
  -- if S.TODO = (CONFIG_INVOKE pconfigcall) :: ptask_tail*
  -- if $config_invoke_valid(S, pconfigcall)
  -- if $dynamic_constant_kind(pconfigcall.KIND)
  -- if ~$dynamic_scalar_constant_call(pconfigcall)
  -- if ~$dynamic_scalar_define_call(pconfigcall)
  -- if ~$dynamic_null_constant_call(pconfigcall)
  -- if ~$dynamic_null_define_call(pconfigcall)
  -- if ~$dynamic_scalar_define_flag_call(pconfigcall)
  -- if ~$dynamic_null_define_flag_call(pconfigcall)
  -- if ~$dynamic_nan_define_flag_call(pconfigcall)
  -- if ~$dynamic_class_define_call(pconfigcall)

def $task_nodes(DYNAMIC_CONSTANT_CASE_WARNING pconfigcall) = $config_nodes(pconfigcall)
def $selected_task_nonce(DYNAMIC_CONSTANT_CASE_WARNING pconfigcall) = pconfigcall.SELECTION
def $call_task_valid(S, DYNAMIC_CONSTANT_CASE_WARNING pconfigcall) = $dynamic_constant_case_valid(S, pconfigcall)
rule PhpStep/dynamic-constant-case-warning: S ~> $dynamic_define_finish(S, pconfigcall)
  -- if S.TODO = (DYNAMIC_CONSTANT_CASE_WARNING pconfigcall) :: ptask_tail*
  -- if $dynamic_constant_case_valid(S, pconfigcall)

def $task_nodes(DYNAMIC_CONSTANT_DUPLICATE pconfigcall n_constants) = $config_nodes(pconfigcall)
def $selected_task_nonce(DYNAMIC_CONSTANT_DUPLICATE pconfigcall n_constants) = pconfigcall.SELECTION
def $call_task_valid(S, DYNAMIC_CONSTANT_DUPLICATE pconfigcall n_constants) = $dynamic_constant_duplicate_valid(S, pconfigcall, n_constants)
rule PhpStep/dynamic-constant-duplicate: S ~> S[.TODO = ptask_tail*][.RESULT = KNOWN (PBOOL false)][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (DYNAMIC_CONSTANT_DUPLICATE pconfigcall n_constants) :: ptask_tail*
  -- if $dynamic_constant_duplicate_valid(S, pconfigcall, n_constants)

;; Only immutable compiler facts constrain literal payloads. A mutable variable
;; argument is captured by the runtime row and is never evaluated again here.
def $dynamic_define_known(S, porigin, 0) = $compiled_read(S, porigin_argument)
  -- if $intrinsic_argument(S, porigin, 0) = ((expression, false, eps, porigin_argument, z))
def $dynamic_define_known(S, porigin, 1) = $compiled_read(S, porigin_argument)
  -- if $intrinsic_argument(S, porigin, 0) = ((expression_name, false, eps, porigin_name, z_name))
  -- if $intrinsic_argument(S, porigin, 1) = ((expression, false, eps, porigin_argument, z))
def $dynamic_define_known(S, porigin, n) = eps -- otherwise
dec $dynamic_define_name_matches(preqbytes, pvalue?) : bool
def $dynamic_define_name_matches(preqbytes, eps) = true
def $dynamic_define_name_matches(preqbytes, (pvalue)) = (preqbytes = $user_constant_key(n_name*))
  -- if $string_bytes(pvalue) = (n_name*)
def $dynamic_define_name_matches(preqbytes, pvalue?) = false -- otherwise
dec $dynamic_define_value_matches(pvalue, pvalue?) : bool
def $dynamic_define_value_matches(pvalue, eps) = true
def $dynamic_define_value_matches(pvalue, (pvalue_expected)) = ($string_plain(pvalue) = $string_plain(pvalue_expected))
def $user_constants_valid(S, puserconstant :: puserconstant_tail*) = true
  -- if $dynamic_define_source(S, puserconstant.ORIGIN)
  -- if $dynamic_constant_global_name(puserconstant.NAME)
  -- if puserconstant.NAME = $user_constant_key(puserconstant.NAME)
  -- if ~$dynamic_constant_initial(puserconstant.NAME)
  -- if $dynamic_define_value_class(S, puserconstant.VALUE) = (puserconstant.CLASS)
  -- if $string_plain(puserconstant.VALUE) = puserconstant.VALUE \/ $string_carrier_valid(S, puserconstant.VALUE)
  -- if puserconstant.READS = eps
  -- if puserconstant.RECEIVES = eps
  -- if $dynamic_define_name_matches(puserconstant.NAME, $dynamic_define_known(S, puserconstant.ORIGIN, 0))
  -- if $dynamic_define_value_matches(puserconstant.VALUE, $dynamic_define_known(S, puserconstant.ORIGIN, 1))
  -- if $user_constant_at(puserconstant_tail*, puserconstant.NAME) = eps
  -- if $user_constants_valid(S, puserconstant_tail*)

;; The warning may append other constants through its handler. The rejected
;; candidate remains captured while the original key belongs to the old prefix.
def $dynamic_constant_duplicate_valid(S, pconfigcall, n_constants) = true
  -- if pconfigcall.KIND = INTRINSIC_DEFINE
  -- if pconfigcall.OWNER = eps /\ pconfigcall.PACKS = eps
  -- if $config_invoke_valid(S, pconfigcall)
  -- if $dynamic_define_source(S, pconfigcall.SITE)
  -- if $dynamic_define_values(pconfigcall) = ((preqbytes, pvalue))
  -- if $dynamic_constant_global_name(preqbytes)
  -- if ~$dynamic_constant_initial(preqbytes)
  -- if $dynamic_define_value_class(S, pvalue) = (pvalueclass)
  -- if ~$dynamic_constant_case_flag(pconfigcall) \/ $dynamic_constant_class(pvalue) =/= eps
  -- if $string_plain(pvalue) = pvalue \/ $string_carrier_valid(S, pvalue)
  -- if $(n_constants <= |S.USERCONSTANTS|)
  -- if $user_constant_at(S.USERCONSTANTS[0:n_constants], $user_constant_key(preqbytes)) =/= eps
  -- if $dynamic_define_name_matches($user_constant_key(preqbytes), $dynamic_define_known(S, pconfigcall.SITE, 0))
  -- if $dynamic_define_value_matches(pvalue, $dynamic_define_known(S, pconfigcall.SITE, 1))
def $dynamic_constant_duplicate_valid(S, pconfigcall, n_constants) = true
  -- if $dynamic_startup_define_duplicate_valid(S, pconfigcall, n_constants)
def $dynamic_constant_duplicate_valid(S, pconfigcall, n_constants) = false -- otherwise
def $error_call_valid(S, perrorcall) = true
  -- if perrorcall.RESUME = DYNAMIC_CONSTANT_DUPLICATE pconfigcall n_constants
  -- if $dynamic_constant_duplicate_valid(S, pconfigcall, n_constants)
  -- if $dynamic_define_values(pconfigcall) = ((preqbytes, pvalue))
  -- if perrorcall.SITE = pconfigcall.SITE /\ perrorcall.LEVEL = 2 /\ perrorcall.LINE = pconfigcall.LINE
  -- if perrorcall.MESSAGE = $global_constant_duplicate_message(preqbytes)
  -- if perrorcall.EVENT = DIAGNOSTIC "Warning" perrorcall.MESSAGE pconfigcall.LINE
def $error_context_trigger(S, pcallcontext) = (pconfigcall)
  -- if $error_context_call(S, pcallcontext) = (perrorcall)
  -- if perrorcall.RESUME = DYNAMIC_CONSTANT_DUPLICATE pconfigcall n_constants
;; Trace projection runs in handler scope; marker validity restores the caller.
def $error_handler_trace_values(S, pcallcontext, pconfigcall_api) = $trace_extra(S, $getclass_trace_operands(pconfigcall_api.SENT))
  -- if $error_context_call(S, pcallcontext) = (perrorcall)
  -- if perrorcall.RESUME = DYNAMIC_CONSTANT_DUPLICATE pconfigcall n_constants
  -- if $dynamic_define_values(pconfigcall) = ((preqbytes, pvalue))
  -- if $builtin_value_bytes(preqbytes) =/= eps \/ $special_constant(preqbytes) =/= eps
  -- if ~$dynamic_constant_case_flag(pconfigcall)
  -- if pconfigcall_api = pconfigcall

;; This phase bypasses only the warning already delivered; SENT stays true.
def $dynamic_constant_case_valid(S, pconfigcall) = true
  -- if pconfigcall.KIND = INTRINSIC_DEFINE
  -- if pconfigcall.OWNER = eps /\ pconfigcall.PACKS = eps
  -- if $config_invoke_valid(S, pconfigcall)
  -- if $dynamic_define_source(S, pconfigcall.SITE)
  -- if $dynamic_constant_case_flag(pconfigcall)
  -- if $dynamic_define_values(pconfigcall) = ((preqbytes, pvalue))
  -- if $dynamic_constant_global_name(preqbytes)
  -- if ~$dynamic_constant_initial(preqbytes)
  -- if $dynamic_constant_class(pvalue) = (pvalueclass)
  -- if $string_plain(pvalue) = pvalue \/ $string_carrier_valid(S, pvalue)
  -- if $dynamic_define_name_matches($user_constant_key(preqbytes), $dynamic_define_known(S, pconfigcall.SITE, 0))
  -- if $dynamic_define_value_matches(pvalue, $dynamic_define_known(S, pconfigcall.SITE, 1))
def $dynamic_constant_case_valid(S, pconfigcall) = false -- otherwise
def $error_call_valid(S, perrorcall) = true
  -- if perrorcall.RESUME = DYNAMIC_CONSTANT_CASE_WARNING pconfigcall
  -- if $dynamic_constant_case_valid(S, pconfigcall)
  -- if perrorcall.SITE = pconfigcall.SITE /\ perrorcall.LEVEL = 2 /\ perrorcall.LINE = pconfigcall.LINE
  -- if perrorcall.MESSAGE = $dynamic_constant_case_message()
  -- if perrorcall.EVENT = DIAGNOSTIC "Warning" perrorcall.MESSAGE pconfigcall.LINE
def $error_context_trigger(S, pcallcontext) = (pconfigcall)
  -- if $error_context_call(S, pcallcontext) = (perrorcall)
  -- if perrorcall.RESUME = DYNAMIC_CONSTANT_CASE_WARNING pconfigcall

;; Dynamic array constants copy bounded trees and share certified object leaves.
;; Reference cells and append history belong only to the source. Check mode
;; allocates nothing and requires the copying fold's exact DIRECT tables.
dec $dynamic_array_item(pstate, pitem, bool) : pvalue?
def $dynamic_array_item(S, DIRECT pvalue, b_copy) = (pvalue)
def $dynamic_array_item(S, ALIAS n_cell, true) = (pvalue)
  -- if $(n_cell < |S.STORE|)
  -- if HCELL n_cell <- S.ALLOCATIONS
  -- if S.STORE[n_cell] = DEFINED pvalue
def $dynamic_array_item(S, pitem, b_copy) = eps -- otherwise

dec $dynamic_array_entries(pstate, pentry*, nat*, parray, (pkey, pvalueclass)*, bool) : (pstate, parray, (pkey, pvalueclass)*)?
dec $dynamic_array_finish(pstate, nat, parray, (pkey, pvalueclass)*, bool) : (pstate, pvalue, pvalueclass)?
;; Byte-only leaves keep unknown string identity and create no carrier.
def $dynamic_array_value(S, PSTRING n_bytes*, n_seen*, b_copy) = ((S, PSTRING n_bytes*, PVSTRING false))
  -- if $startup_bytes(n_bytes*)
def $dynamic_array_value(S, pvalue, n_seen*, b_copy) = ((S, pvalue, pvalueclass))
  -- if $dynamic_define_value_class(S, pvalue) = (pvalueclass)
  -- if $string_plain(pvalue) = pvalue \/ $string_carrier_valid(S, pvalue)
;; Empty descendants retain authenticated immutable provenance or rebuild
;; mutable tables canonically. The ancestor list guards every array descent.
def $dynamic_array_value(S, PARRAY n_array, n_seen*, b_copy) = ((S, PARRAY n_array, PVARRAY true eps))
  -- if $(n_array < |S.ARRAYS|)
  -- if HARRAY n_array <- S.ALLOCATIONS
  -- if ~(n_array <- n_seen*)
  -- if $array_immutable(S, n_array)
def $dynamic_array_value(S, PARRAY n_array, n_seen*, b_copy) = $dynamic_array_finish(S, n_array, $array_empty(), eps, b_copy)
  -- if $(n_array < |S.ARRAYS|)
  -- if HARRAY n_array <- S.ALLOCATIONS
  -- if ~(n_array <- n_seen*)
  -- if S.ARRAYS[n_array].ITEMS = eps
  -- if ~$array_immutable(S, n_array)
def $dynamic_array_value(S, PARRAY n_array, n_seen*, b_copy) = $dynamic_array_finish(S_items, n_array, parray, (pkey_items, pvalueclass_items)*, b_copy)
  -- if $(n_array < |S.ARRAYS|)
  -- if HARRAY n_array <- S.ALLOCATIONS
  -- if ~(n_array <- n_seen*)
  -- if S.ARRAYS[n_array].ITEMS =/= eps
  -- if $dynamic_array_entries(S, S.ARRAYS[n_array].ITEMS, n_seen* ++ [n_array], $array_empty(), eps, b_copy) = ((S_items, parray, (pkey_items, pvalueclass_items)*))
def $dynamic_array_value(S, pvalue, n_seen*, b_copy) = eps -- otherwise

def $dynamic_array_entries(S, eps, n_seen*, parray, (pkey_prior, pvalueclass_prior)*, b_copy) = ((S, parray, (pkey_prior, pvalueclass_prior)*))
def $dynamic_array_entries(S, (ENTRY pkey pitem) :: pentry_tail*, n_seen*, parray, (pkey_prior, pvalueclass_prior)*, b_copy) = $dynamic_array_entries(S_item, pentry_tail*, n_seen*, $array_insert(parray, pkey, DIRECT pvalue_copy), (pkey_prior, pvalueclass_prior)* ++ [(pkey, pvalueclass_copy)], b_copy)
  -- if $dynamic_array_item(S, pitem, b_copy) = (pvalue)
  -- if $dynamic_array_value(S, pvalue, n_seen*, b_copy) = ((S_item, pvalue_copy, pvalueclass_copy))
def $dynamic_array_entries(S, pentry*, n_seen*, parray, (pkey_prior, pvalueclass_prior)*, b_copy) = eps -- otherwise

def $dynamic_array_finish(S, n_array, parray, (pkey_items, pvalueclass_items)*, true) = ((S_copy, pvalue, PVARRAY false (pkey_items, pvalueclass_items)*))
  -- if S_copy = $allocate_array(S, parray)
  -- if S_copy.RESULT = KNOWN pvalue
def $dynamic_array_finish(S, n_array, parray, (pkey_items, pvalueclass_items)*, false) = ((S, PARRAY n_array, PVARRAY false (pkey_items, pvalueclass_items)*))
  -- if S.ARRAYS[n_array] = parray
def $dynamic_array_finish(S, n_array, parray, (pkey_items, pvalueclass_items)*, b_copy) = eps -- otherwise

;; Validate current dereferenced edges before copying or checking duplicate keys.
;; An ancestor path permits repeated DAG children; malformed edges are not cycles.
dec $dynamic_array_recursive_entries(pstate, pentry*, nat*) : bool?
def $dynamic_array_recursive(S, pvalue, n_seen*) = (false)
  -- if ~$is_array_value(pvalue)
def $dynamic_array_recursive(S, PARRAY n_array, n_seen*) = (true)
  -- if $(n_array < |S.ARRAYS|)
  -- if HARRAY n_array <- S.ALLOCATIONS
  -- if n_array <- n_seen*
def $dynamic_array_recursive(S, PARRAY n_array, n_seen*) = $dynamic_array_recursive_entries(S, S.ARRAYS[n_array].ITEMS, n_seen* ++ [n_array])
  -- if $(n_array < |S.ARRAYS|)
  -- if HARRAY n_array <- S.ALLOCATIONS
  -- if ~(n_array <- n_seen*)
def $dynamic_array_recursive(S, pvalue, n_seen*) = eps -- otherwise
def $dynamic_array_recursive_entries(S, eps, n_seen*) = (false)
def $dynamic_array_recursive_entries(S, (ENTRY pkey pitem) :: pentry_tail*, n_seen*) = (true)
  -- if $dynamic_array_item(S, pitem, true) = (pvalue)
  -- if $dynamic_array_recursive(S, pvalue, n_seen*) = (true)
def $dynamic_array_recursive_entries(S, (ENTRY pkey pitem) :: pentry_tail*, n_seen*) = $dynamic_array_recursive_entries(S, pentry_tail*, n_seen*)
  -- if $dynamic_array_item(S, pitem, true) = (pvalue)
  -- if $dynamic_array_recursive(S, pvalue, n_seen*) = (false)
def $dynamic_array_recursive_entries(S, pentry*, n_seen*) = eps -- otherwise

;; Literal facts constrain contents and empty-array provenance, not internal IDs.
;; Variables keep the same structural table policy as primitive dynamic values.
dec $dynamic_array_same(pstate, pvalue, pvalue) : bool
dec $dynamic_array_same_entries(pstate, pentry*, pentry*) : bool
def $dynamic_array_same(S, PARRAY n_left, PARRAY n_right) = $dynamic_array_same_entries(S, S.ARRAYS[n_left].ITEMS, S.ARRAYS[n_right].ITEMS)
  -- if $(n_left < |S.ARRAYS| /\ n_right < |S.ARRAYS|)
  -- if HARRAY n_left <- S.ALLOCATIONS /\ HARRAY n_right <- S.ALLOCATIONS
  -- if $array_immutable(S, n_left) = $array_immutable(S, n_right)
def $dynamic_array_same(S, PARRAY n_left, PARRAY n_right) = false
  -- if $(n_left >= |S.ARRAYS| \/ n_right >= |S.ARRAYS|) \/ ~(HARRAY n_left <- S.ALLOCATIONS) \/ ~(HARRAY n_right <- S.ALLOCATIONS) \/ $array_immutable(S, n_left) =/= $array_immutable(S, n_right)
def $dynamic_array_same(S, pvalue_left, pvalue_right) = ($string_plain(pvalue_left) = $string_plain(pvalue_right)) -- otherwise
def $dynamic_array_same_entries(S, eps, eps) = true
def $dynamic_array_same_entries(S, (ENTRY pkey (DIRECT pvalue)) :: pentry_left*, (ENTRY pkey pitem) :: pentry_right*) = ($dynamic_array_same(S, pvalue, pvalue_known) /\ $dynamic_array_same_entries(S, pentry_left*, pentry_right*))
  -- if $dynamic_array_item(S, pitem, true) = (pvalue_known)
def $dynamic_array_same_entries(S, pentry_left*, pentry_right*) = false -- otherwise
def $dynamic_array_known_matches(S, pvalue, eps) = true
def $dynamic_array_known_matches(S, pvalue, (pvalue_known)) = $dynamic_array_same(S, pvalue, pvalue_known)

dec $dynamic_array_source(pstate, porigin) : bool
def $dynamic_array_source(S, porigin) = $dynamic_define_source(S, porigin)
def $dynamic_array_call_valid(S, pconfigcall) = true
  -- if pconfigcall.KIND = INTRINSIC_DEFINE
  -- if pconfigcall.OWNER = eps /\ pconfigcall.PACKS = eps
  -- if $config_invoke_valid(S, pconfigcall)
  -- if $dynamic_array_source(S, pconfigcall.SITE)
  -- if $dynamic_define_values(pconfigcall) = ((preqbytes, PARRAY n_array))
  -- if ~$dynamic_constant_case_flag(pconfigcall)
  -- if $dynamic_constant_global_name(preqbytes)
  -- if ~$dynamic_constant_initial(preqbytes)
  -- if $dynamic_define_name_matches($user_constant_key(preqbytes), $dynamic_define_known(S, pconfigcall.SITE, 0))
def $dynamic_array_call_valid(S, pconfigcall) = false -- otherwise

def $user_constants_valid(S, puserconstant :: puserconstant_tail*) = true
  -- if $dynamic_array_source(S, puserconstant.ORIGIN)
  -- if $dynamic_constant_global_name(puserconstant.NAME)
  -- if puserconstant.NAME = $user_constant_key(puserconstant.NAME)
  -- if ~$dynamic_constant_initial(puserconstant.NAME)
  -- if puserconstant.VALUE = PARRAY n_array
  -- if $dynamic_array_value(S, PARRAY n_array, eps, false) = ((S, PARRAY n_array, puserconstant.CLASS))
  -- if puserconstant.READS = eps /\ puserconstant.RECEIVES = eps
  -- if $dynamic_define_name_matches(puserconstant.NAME, $dynamic_define_known(S, puserconstant.ORIGIN, 0))
  -- if $dynamic_array_known_matches(S, puserconstant.VALUE, $dynamic_define_known(S, puserconstant.ORIGIN, 1))
  -- if $user_constant_at(puserconstant_tail*, puserconstant.NAME) = eps
  -- if $user_constants_valid(S, puserconstant_tail*)

;; Qualified existence queries do not fetch a value. This slice admits folded
;; user-class constants only, with the caller's actual lexical visibility.
dec $dynamic_defined_split(preqbytes, preqbytes) : (preqbytes, preqbytes)?
dec $dynamic_defined_query(pconfigcall) : (preqbytes, preqbytes)?
dec $dynamic_defined_valid(pstate, pconfigcall) : bool
dec $dynamic_defined_finish(pstate, pconfigcall) : pstate
dec $dynamic_defined_autoload_valid(pstate, pautoloadcall) : bool
def $dynamic_defined_split(preqbytes_prefix, eps) = eps
def $dynamic_defined_split(preqbytes_prefix, [n_byte]) = eps
def $dynamic_defined_split(preqbytes_prefix, n_first :: n_second :: n_tail*) = ((preqbytes_prefix, n_tail*))
  -- if n_first = 58 /\ n_second = 58
def $dynamic_defined_split(preqbytes_prefix, n_first :: n_second :: n_tail*) = $dynamic_defined_split(preqbytes_prefix ++ [n_first], n_second :: n_tail*)
  -- if n_first =/= 58 \/ n_second =/= 58
def $dynamic_defined_query(pconfigcall) = $dynamic_defined_split(eps, $dynamic_constant_query(preqbytes))
  -- if pconfigcall.SENT = [NAMED_SENT (KNOWN pvalue_query)]
  -- if $string_bytes(pvalue_query) = (preqbytes)
def $dynamic_defined_query(pconfigcall) = eps -- otherwise
def $dynamic_defined_valid(S, pconfigcall) = true
  -- if pconfigcall.KIND = INTRINSIC_DEFINED
  -- if pconfigcall.OWNER = eps /\ pconfigcall.PACKS = eps
  -- if $config_invoke_valid(S, pconfigcall)
  -- if $dynamic_defined_query(pconfigcall) = ((preqbytes_class, preqbytes_member))
  -- if $autoload_class_name(preqbytes_class)
  -- if ~$class_internal(preqbytes_class)
  -- if ~($ptlc(preqbytes_class) <- [$ptascii("self"), $ptascii("parent"), $ptascii("static")])
  -- if preqbytes_member =/= eps /\ ~(0 <- preqbytes_member) /\ ~(58 <- preqbytes_member)
  -- if pconfigcall.SENT = [NAMED_SENT (KNOWN pvalue_query)]
  -- if $string_plain(pvalue_query) = pvalue_query \/ $string_carrier_valid(S, pvalue_query)
  -- if $dynamic_define_value_matches(pvalue_query, $dynamic_define_known(S, pconfigcall.SITE, 0))
def $dynamic_defined_valid(S, pconfigcall) = false -- otherwise
def $dynamic_defined_finish(S, pconfigcall) = S[.TODO = ptask_tail*][.RESULT = KNOWN (PBOOL false)][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if $dynamic_defined_valid(S, pconfigcall)
  -- if $dynamic_defined_query(pconfigcall) = ((preqbytes_class, preqbytes_member))
  -- if $class_named(S.CLASSNAMES, $ptlc(preqbytes_class)) = eps
  -- if S.TODO = ptask :: ptask_tail*
def $dynamic_defined_finish(S, pconfigcall) = S[.TODO = ptask_tail*][.RESULT = KNOWN (PBOOL false)][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if $dynamic_defined_valid(S, pconfigcall)
  -- if $dynamic_defined_query(pconfigcall) = ((preqbytes_class, preqbytes_member))
  -- if $class_named(S.CLASSNAMES, $ptlc(preqbytes_class)) = (porigin_class)
  -- if $class_at(S.CLASSES, porigin_class) = (pclassdesc)
  -- if pclassdesc.KIND = "class"
  -- if $class_constant_lookup(S, porigin_class, preqbytes_member, |S.CLASSES|) = eps
  -- if S.TODO = ptask :: ptask_tail*
def $dynamic_defined_finish(S, pconfigcall) = S[.TODO = ptask_tail*][.RESULT = KNOWN (PBOOL false)][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if $dynamic_defined_valid(S, pconfigcall)
  -- if $dynamic_defined_query(pconfigcall) = ((preqbytes_class, preqbytes_member))
  -- if $class_named(S.CLASSNAMES, $ptlc(preqbytes_class)) = (porigin_class)
  -- if $class_at(S.CLASSES, porigin_class) = (pclassdesc)
  -- if pclassdesc.KIND = "class"
  -- if $class_constant_lookup(S, porigin_class, preqbytes_member, |S.CLASSES|) = (pclassconstantdesc)
  -- if ~$class_constant_visible(S, pclassconstantdesc)
  -- if S.TODO = ptask :: ptask_tail*
def $dynamic_defined_finish(S, pconfigcall) = S[.TODO = ptask_tail*][.RESULT = KNOWN (PBOOL true)][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if $dynamic_defined_valid(S, pconfigcall)
  -- if $dynamic_defined_query(pconfigcall) = ((preqbytes_class, preqbytes_member))
  -- if $class_named(S.CLASSNAMES, $ptlc(preqbytes_class)) = (porigin_class)
  -- if $class_at(S.CLASSES, porigin_class) = (pclassdesc)
  -- if pclassdesc.KIND = "class"
  -- if $class_constant_lookup(S, porigin_class, preqbytes_member, |S.CLASSES|) = (pclassconstantdesc)
  -- if $class_constant_visible(S, pclassconstantdesc)
  -- if pclassconstantdesc.FOLDED
  -- if $compiled_read(S, pclassconstantdesc.INITIALIZER) = (pvalue)
  -- if S.TODO = ptask :: ptask_tail*
def $dynamic_defined_finish(S, pconfigcall) = S[.COMPLETION = UNSUPPORTED "class constant defined query"] -- otherwise
def $dynamic_defined_receive(S, pconfigcall) = $autoload_begin(S[.TODO = ptask_tail*], pconfigcall.SITE, preqbytes_class, $ptlc(preqbytes_class), pconfigcall.LINE, AUTO_EXPLICIT pconfigcall, DYNAMIC_DEFINED_RESUME pconfigcall)
  -- if $dynamic_defined_valid(S, pconfigcall)
  -- if $dynamic_defined_query(pconfigcall) = ((preqbytes_class, preqbytes_member))
  -- if $autoload_pending(S, preqbytes_class)
  -- if S.TODO = ptask :: ptask_tail*
def $dynamic_defined_receive(S, pconfigcall) = $dynamic_defined_finish(S, pconfigcall)
  -- if $dynamic_defined_valid(S, pconfigcall)
  -- if $dynamic_defined_query(pconfigcall) = ((preqbytes_class, preqbytes_member))
  -- if ~$autoload_pending(S, preqbytes_class)
def $dynamic_defined_receive(S, pconfigcall) = S[.COMPLETION = UNSUPPORTED "class constant defined query"] -- otherwise
def $task_nodes(DYNAMIC_DEFINED_RESUME pconfigcall) = $config_nodes(pconfigcall)
def $selected_task_nonce(DYNAMIC_DEFINED_RESUME pconfigcall) = pconfigcall.SELECTION
