;; Native Generator unpack owns DATA once, with no PHP Generator-method frame
;; or public iterator cursor. INPUT and completed string sends are nonowning.
dec $config_generator_history(pstate, pconfiggenerator) : bool
dec $config_generator_quiet_closed(pstate, pconfiggenerator) : bool
dec $config_generator_retired_scope(pstate, pconfiggenerator) : bool
dec $config_generator_saved_scope(pstate, pconfiggenerator) : bool
dec $config_generator_stage_scope(pstate, pconfiggenerator, text) : bool
dec $config_generator_finish_allowed(pstate, pconfiggenerator) : bool
dec $config_generator_callee(pstate, nat?, nat) : bool
dec $config_generator_stage(pstate, pconfiggenerator, text) : bool
dec $config_generator_at(ptask, porigin) : bool
dec $config_generator_count(ptask*, porigin) : nat
dec $config_generator_valid(pstate, pconfiggenerator, text) : bool
dec $config_generator_header(pstate, pgeneratorop, pconfiggenerator, text) : bool
dec $config_generator_operation_tasks(pstate, pgeneratorop, ptask*) : bool
dec $config_generator_operation_frames(pstate, pgeneratorop, pframe*) : bool
dec $config_generator_run(pstate, pconfiggenerator, text, ptask*) : pstate
dec $config_generator_send_allowed(pstate, pconfiggenerator) : bool
dec $config_generator_send(pstate, pconfiggenerator, ptask*) : pstate
dec $config_generator_nodes(pconfiggenerator, text) : pnode*
dec $config_generator_finish(pstate, pconfiggenerator, ptask*) : pstate
dec $config_generator_invoke(pstate, pconfiggenerator) : pstate
dec $config_generator_discard_allowed(pstate, pconfiggenerator) : bool
dec $config_generator_discard(pstate, pconfiggenerator, text) : pstate
dec $config_generator_blocked(pstate) : bool

;; Object slots retain historical metadata after physical allocation retirement.
;; Active stages still require the live allocation through scope below.
def $config_generator_history(S, pconfiggenerator) = true
  -- if pconfiggenerator.CALL.KIND = INTRINSIC_INI_SET
  -- if pconfiggenerator.CALL.INDEX = 0 /\ pconfiggenerator.CALL.SENT = eps
  -- if ~pconfiggenerator.CALL.NAMED /\ pconfiggenerator.CALL.PACKS = eps
  -- if ~$pipe_site(S, pconfiggenerator.CALL.SITE)
  -- if $intrinsic_count(S, pconfiggenerator.CALL.SITE) = (1)
  -- if $config_pending_valid(S[.ORIGIN = (pconfiggenerator.CALL.SITE)], pconfiggenerator.CALL, true)
  -- if $intrinsic_argument(S, pconfiggenerator.CALL.SITE, 0) = ((expression, true, eps, PORIGIN n_source pcpath, z))
  -- if pconfiggenerator.INPUT = VARIABLE ptbytes z
  -- if $code_at(S.CODE, n_source) = (pcode)
  -- if $source_unit(S.SOURCES, n_source) = (pcunit)
  -- if $unpack_cv_at(pcode, pcunit, pcpath) = (ptbytes)
  -- if $(pconfiggenerator.OBJECT < |S.OBJECTS|)
  -- if S.OBJECTS[pconfiggenerator.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.CLOSURE = eps /\ pgenerator.ACCESS = eps
  -- if $function_at($all_functions(S), pgenerator.FUNCTION) = (pfunction)
  -- if $origin_node(S.SOURCES, pfunction.ORIGIN) = (NStmtFunction phpType14 phpType4 phpType11 phpType16 phpType18 phpType23 metadata)
  -- if $function_generator(S, pfunction)
  -- if pfunction.SIGNATURE.PARAMETERS = eps /\ ~pfunction.SIGNATURE.BYREF
  -- if $(|pconfiggenerator.ITEMS| <= 2)
  -- if $config_iterator_items(S, pconfiggenerator.ITEMS)
def $config_generator_history(S, pconfiggenerator) = false -- otherwise
def $config_generator_scope(S, pconfiggenerator) = ($config_generator_history(S, pconfiggenerator) /\ ((HOBJECT pconfiggenerator.OBJECT) <- S.ALLOCATIONS))
def $config_generator_quiet_closed(S, pconfiggenerator) = true
  -- if $config_generator_history(S, pconfiggenerator)
  -- if S.OBJECTS[pconfiggenerator.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.PHASE = GENERATOR_CLOSED
  -- if ~$generator_storage_active(S, pconfiggenerator.OBJECT)
  -- if $node_children(S, HOBJECT pconfiggenerator.OBJECT) = eps
def $config_generator_quiet_closed(S, pconfiggenerator) = false -- otherwise
def $config_generator_retired_scope(S, pconfiggenerator) = ($config_generator_quiet_closed(S, pconfiggenerator) /\ ~((HOBJECT pconfiggenerator.OBJECT) <- S.ALLOCATIONS))
def $config_generator_saved_scope(S, pconfiggenerator) = $config_generator_scope(S, pconfiggenerator)
  -- if (HOBJECT pconfiggenerator.OBJECT) <- S.ALLOCATIONS
def $config_generator_saved_scope(S, pconfiggenerator) = $config_generator_retired_scope(S, pconfiggenerator)
  -- if ~((HOBJECT pconfiggenerator.OBJECT) <- S.ALLOCATIONS)
def $config_generator_stage_scope(S, pconfiggenerator, "invoke") = $config_generator_saved_scope(S, pconfiggenerator)
def $config_generator_stage_scope(S, pconfiggenerator, text) = $config_generator_scope(S, pconfiggenerator)
  -- if text =/= "invoke"
def $config_generator_callee(S, eps, n) = true
def $config_generator_callee(S, (n_owner), n) = $($heap_owners($heap_graph(S), HOBJECT n_owner) > n)
def $config_generator_start(S, pconfigcall, poperand, n) = true
  -- if S.COMPLETION = NORMAL
  -- if S.TODO = (CONFIG_UNPACK_PREP pconfigcall) :: ptask_tail*
  -- if $config_pending_valid(S, pconfigcall, true)
  -- if $config_generator_scope(S, {CALL pconfigcall, OBJECT n, INPUT poperand, ITEMS eps})
  -- if poperand = VARIABLE ptbytes z
  -- if $lookup(S.ENV, ptbytes) = (n_cell)
  -- if S.STORE[n_cell] = DEFINED (POBJECT n)
  -- if S.OBJECTS[n] = GENERATOR pgenerator
  -- if pgenerator.PHASE = GENERATOR_FRESH /\ pgenerator.DELEGATE = eps
  -- if $($heap_owners($heap_graph(S), HOBJECT n) > 0)
  -- if $config_generator_callee(S, pconfigcall.OWNER, 1)
def $config_generator_start(S, pconfigcall, poperand, n) = false -- otherwise
def $config_generator_stage(S, pconfiggenerator, "rewind") = (pconfiggenerator.ITEMS = eps)
def $config_generator_stage(S, pconfiggenerator, "next") = $(|pconfiggenerator.ITEMS| > 0)
def $config_generator_stage(S, pconfiggenerator, "ready") = true
def $config_generator_stage(S, pconfiggenerator, text) = (pgenerator.PHASE = GENERATOR_CLOSED)
  -- if text <- ["finish", "invoke"]
  -- if S.OBJECTS[pconfiggenerator.OBJECT] = GENERATOR pgenerator
def $config_generator_stage(S, pconfiggenerator, text) = false -- otherwise
def $config_generator_at(CONFIG_GENERATOR pconfiggenerator text, porigin) = (pconfiggenerator.CALL.SITE = porigin)
def $config_generator_at(ptask, porigin) = false -- otherwise
def $config_generator_count(eps, porigin) = 0
def $config_generator_count(ptask :: ptask_tail*, porigin) = $(1 + $config_generator_count(ptask_tail*, porigin)) -- if $config_generator_at(ptask, porigin)
def $config_generator_count(ptask :: ptask_tail*, porigin) = $config_generator_count(ptask_tail*, porigin) -- if ~$config_generator_at(ptask, porigin)
def $config_generator_valid(S, pconfiggenerator, text) = true
  -- if $config_generator_stage_scope(S, pconfiggenerator, text)
  -- if $config_generator_stage(S, pconfiggenerator, text)
  -- if $intrinsic_argument(S, pconfiggenerator.CALL.SITE, 0) = ((expression, true, eps, porigin, z))
  -- if (text = "invoke" /\ S.ORIGIN = (pconfiggenerator.CALL.SITE)) \/ (text =/= "invoke" /\ S.ORIGIN = (porigin))
  -- if $config_generator_count(S.TODO, pconfiggenerator.CALL.SITE) = 1
def $config_generator_valid(S, pconfiggenerator, text) = false -- otherwise
rule PhpStep/config-generator-start: S ~> S_value[.ORIGIN = (porigin)][.TODO = (CONFIG_GENERATOR {CALL pconfigcall, OBJECT n, INPUT S.RESULT, ITEMS eps} "rewind") :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (CONFIG_UNPACK_PREP pconfigcall) :: ptask_tail*
  -- if $intrinsic_argument(S, pconfigcall.SITE, 0) = ((expression, true, eps, porigin, z))
  -- if S_value = $resolve_at(S, S.RESULT, z)
  -- if S_value.COMPLETION = NORMAL
  -- if S_value.RESULT = KNOWN (POBJECT n)
  -- if $config_generator_start(S, pconfigcall, S.RESULT, n)

;; STARTPACK/BORROWED resumes borrow this marker's DATA and preserve the real
;; saved native resumer. Its trace contains no synthetic Generator method frame.
def $config_generator_header(S, pgeneratorop, pconfiggenerator, text) = true
  -- if pgeneratorop.STARTPACK /\ pgeneratorop.BORROWED
  -- if pgeneratorop.OBJECT = pconfiggenerator.OBJECT
  -- if $intrinsic_argument(S, pconfiggenerator.CALL.SITE, 0) = ((expression, true, eps, pgeneratorop.SITE, pgeneratorop.LINE))
  -- if pgeneratorop.LOOP = eps /\ pgeneratorop.ARGUMENTS = eps /\ ~pgeneratorop.ADVANCE
  -- if pgeneratorop.NAME = text /\ (text <- ["rewind", "next"])
  -- if $config_generator_stage(S, pconfiggenerator, text)
def $config_generator_header(S, pgeneratorop, pconfiggenerator, text) = false -- otherwise
def $config_generator_operation_tasks(S, pgeneratorop, (GENERATOR_RESUME pgeneratorop) :: (CONFIG_GENERATOR pconfiggenerator text) :: ptask*) = true
  -- if $config_generator_header(S, pgeneratorop, pconfiggenerator, text)
  -- if $config_generator_valid(S, pconfiggenerator, text)
  -- if $generator_flat_tasks(S.TODO)
def $config_generator_operation_tasks(S, pgeneratorop, (THROW_SEARCH n) :: ptask*) = $config_generator_operation_tasks(S, pgeneratorop, ptask*)
def $config_generator_operation_tasks(S, pgeneratorop, ptask*) = false -- otherwise
def $config_generator_operation_frames(S, pgeneratorop, eps) = false
def $config_generator_operation_frames(S, pgeneratorop, pframe :: pframe_tail*) = ($config_generator_operation_tasks($constant_frame_scope(S, pframe, pframe_tail*), pgeneratorop, pframe.TODO) \/ $config_generator_operation_frames(S, pgeneratorop, pframe_tail*))
def $config_generator_operation_valid(S, pgeneratorop) = ($config_generator_operation_tasks(S, pgeneratorop, S.TODO) \/ $config_generator_operation_frames(S, pgeneratorop, S.FRAMES))
def $config_generator_run(S, pconfiggenerator, text, ptask*) = $generator_operate(S[.TODO = (CONFIG_GENERATOR pconfiggenerator text) :: ptask*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], {OBJECT pconfiggenerator.OBJECT, NAME text, SITE porigin, LINE z, LOOP eps, ADVANCE false, ARGUMENTS eps, STARTPACK true, BORROWED true})
  -- if $config_generator_valid(S, pconfiggenerator, text)
  -- if $intrinsic_argument(S, pconfiggenerator.CALL.SITE, 0) = ((expression, true, eps, porigin, z))
rule PhpStep/config-generator-resume: S ~> $config_generator_run(S, pconfiggenerator, text, ptask*)
  -- if S.TODO = (CONFIG_GENERATOR pconfiggenerator text) :: ptask*
  -- if text <- ["rewind", "next"]
def $fiber_traversal_complete(S, pgeneratorop) = S[.TODO = (CONFIG_GENERATOR pconfiggenerator "ready") :: ptask*]
  -- if S.TODO = (CONFIG_GENERATOR pconfiggenerator text) :: ptask*
  -- if $config_generator_header(S, pgeneratorop, pconfiggenerator, text)
  -- if $config_generator_valid(S, pconfiggenerator, text)
  -- if S.OBJECTS[pconfiggenerator.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.PHASE <- [GENERATOR_PAUSED, GENERATOR_CLOSED]
def $fiber_traversal_complete(S, pgeneratorop) = S[.COMPLETION = UNSUPPORTED "CONFIG Generator unpack producer outside direct domain"]
  -- if S.TODO = (CONFIG_GENERATOR pconfiggenerator text) :: ptask*
  -- if $config_generator_header(S, pgeneratorop, pconfiggenerator, text)
  -- if $config_generator_valid(S, pconfiggenerator, text)
  -- if S.OBJECTS[pconfiggenerator.OBJECT] = GENERATOR pgenerator
  -- if ~(pgenerator.PHASE <- [GENERATOR_PAUSED, GENERATOR_CLOSED])
def $config_generator_send_allowed(S, pconfiggenerator) = true
  -- if S.OBJECTS[pconfiggenerator.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.PHASE = GENERATOR_PAUSED /\ pgenerator.DELEGATE = eps
  -- if pgenerator.BORROWED = eps /\ pgenerator.REFCELL = eps
  -- if pgenerator.VALUE = (pvalue)
  -- if pgenerator.KEY = (PINT z)
  -- if $config_iterator_string(S, pvalue)
  -- if $(|pconfiggenerator.ITEMS| < 2)
def $config_generator_send_allowed(S, pconfiggenerator) = false -- otherwise
def $config_generator_send(S, pconfiggenerator, ptask*) = S[.TODO = (CONFIG_GENERATOR pconfiggenerator[.ITEMS = pconfiggenerator.ITEMS ++ [ENTRY (KINT z) (DIRECT pvalue)]] "next") :: ptask*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if $config_generator_send_allowed(S, pconfiggenerator)
  -- if S.OBJECTS[pconfiggenerator.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.VALUE = (pvalue)
  -- if pgenerator.KEY = (PINT z)
def $config_generator_send(S, pconfiggenerator, ptask*) = S[.COMPLETION = UNSUPPORTED "CONFIG Generator unpack send outside two-string integer-key domain"]
  -- if ~$config_generator_send_allowed(S, pconfiggenerator)
rule PhpStep/config-generator-item: S ~> $config_generator_send(S, pconfiggenerator, ptask*)
  -- if S.TODO = (CONFIG_GENERATOR pconfiggenerator "ready") :: ptask*
  -- if $config_generator_valid(S, pconfiggenerator, "ready")
  -- if S.OBJECTS[pconfiggenerator.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.PHASE =/= GENERATOR_CLOSED
rule PhpStep/config-generator-closed: S ~> S[.TODO = (CONFIG_GENERATOR pconfiggenerator "finish") :: ptask*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (CONFIG_GENERATOR pconfiggenerator "ready") :: ptask*
  -- if $config_generator_valid(S, pconfiggenerator, "ready")
  -- if S.OBJECTS[pconfiggenerator.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.PHASE = GENERATOR_CLOSED

def $config_generator_nodes(pconfiggenerator, "invoke") = $config_nodes(pconfiggenerator.CALL)
def $config_generator_nodes(pconfiggenerator, text) = [HOBJECT pconfiggenerator.OBJECT] ++ $config_nodes(pconfiggenerator.CALL) -- if text =/= "invoke"
def $task_nodes(CONFIG_GENERATOR pconfiggenerator text) = $config_generator_nodes(pconfiggenerator, text)
def $call_task_valid(S, CONFIG_GENERATOR pconfiggenerator text) = $config_generator_valid(S, pconfiggenerator, text)
def $selected_task_nonce(CONFIG_GENERATOR pconfiggenerator text) = pconfiggenerator.CALL.SELECTION
def $generator_internal_task(CONFIG_GENERATOR pconfiggenerator text) = true
def $eager_explicit_task(CONFIG_GENERATOR pconfiggenerator text) = true
def $config_generator_finish_allowed(S, pconfiggenerator) = ($config_generator_callee(S, pconfiggenerator.CALL.OWNER, 1) /\ ($($heap_owners($heap_graph(S), HOBJECT pconfiggenerator.OBJECT) > 1) \/ $config_generator_quiet_closed(S, pconfiggenerator)))
def $config_generator_finish(S, pconfiggenerator, ptask*) = $fiber_start_unpack_release(S[.ORIGIN = (pconfiggenerator.CALL.SITE)][.TODO = (CONFIG_GENERATOR pconfiggenerator "invoke") :: ptask*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], [HOBJECT pconfiggenerator.OBJECT])
  -- if $config_generator_finish_allowed(S, pconfiggenerator)
def $config_generator_finish(S, pconfiggenerator, ptask*) = S[.COMPLETION = UNSUPPORTED "CONFIG Generator unpack last DATA or callee owner"]
  -- if ~$config_generator_finish_allowed(S, pconfiggenerator)
rule PhpStep/config-generator-finish: S ~> $config_generator_finish(S, pconfiggenerator, ptask*)
  -- if S.TODO = (CONFIG_GENERATOR pconfiggenerator "finish") :: ptask*
  -- if $config_generator_valid(S, pconfiggenerator, "finish")
def $config_generator_invoke(S, pconfiggenerator) = $config_receive(S, pconfigcall[.INDEX = 1])
  -- if $config_pack_prefix(pconfiggenerator.CALL, pconfiggenerator.ITEMS, false) = (pconfigcall)
def $config_generator_invoke(S, pconfiggenerator) = S[.COMPLETION = UNSUPPORTED "CONFIG Generator unpack argument prefix outside domain"]
  -- if $config_pack_prefix(pconfiggenerator.CALL, pconfiggenerator.ITEMS, false) = eps
rule PhpStep/config-generator-invoke: S ~> $config_generator_invoke(S, pconfiggenerator)
  -- if S.TODO = (CONFIG_GENERATOR pconfiggenerator "invoke") :: ptask*
  -- if $config_generator_valid(S, pconfiggenerator, "invoke")

def $return_discard(S, GENERATOR_RESUME pgeneratorop) = S[.ORIGIN = (pgeneratorop.SITE)]
  -- if pgeneratorop.STARTPACK /\ pgeneratorop.BORROWED
  -- if S.TODO = (THROW_SEARCH n) :: (CONFIG_GENERATOR pconfiggenerator text) :: ptask*
  -- if $config_generator_header(S, pgeneratorop, pconfiggenerator, text)
  -- if $config_generator_valid(S, pconfiggenerator, text)
def $config_generator_discard_allowed(S, pconfiggenerator) = (($($heap_owners($heap_graph(S), HOBJECT pconfiggenerator.OBJECT) > 0) \/ $config_generator_quiet_closed(S, pconfiggenerator)) /\ $config_generator_callee(S, pconfiggenerator.CALL.OWNER, 0))
def $config_generator_discard(S, pconfiggenerator, text) = S[.TODO = (THROW_SEARCH n) :: (CONFIG_GENERATOR pconfiggenerator text) :: ptask*][.COMPLETION = UNSUPPORTED "CONFIG Generator unpack last cleanup owner"]
  -- if ~$config_generator_discard_allowed(S, pconfiggenerator)
  -- if S.TODO = (THROW_SEARCH n) :: ptask*
def $config_generator_discard(S, pconfiggenerator, text) = $eager_operation_begin(S_clean, S, CONFIG_GENERATOR pconfiggenerator text, $config_generator_nodes(pconfiggenerator, text))
  -- if $config_generator_discard_allowed(S, pconfiggenerator)
  -- if $destructor_operational(S) /\ $eager_operation_pending(S) =/= eps
  -- if S_clean = S[.ORIGIN = (pconfiggenerator.CALL.SITE)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
def $config_generator_discard(S, pconfiggenerator, text) = $fiber_start_unpack_release(S[.ORIGIN = (pconfiggenerator.CALL.SITE)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], $config_generator_nodes(pconfiggenerator, text))
  -- if $config_generator_discard_allowed(S, pconfiggenerator)
  -- if ~$destructor_operational(S) \/ $eager_operation_pending(S) = eps
def $eager_operation_source_valid(S, pdestructionoperation) = true
  -- if pdestructionoperation.SOURCE = CONFIG_GENERATOR pconfiggenerator text
  -- if pdestructionoperation.CLEANUP = eps /\ pdestructionoperation.NOGC = eps
  -- if pdestructionoperation.PENDING =/= eps /\ pdestructionoperation.COMPLETION = NORMAL
  -- if pdestructionoperation.VALUE = KNOWN PNULL /\ pdestructionoperation.BASE = BASE_VALUE (KNOWN PNULL)
  -- if pdestructionoperation.ORIGIN = (pconfiggenerator.CALL.SITE)
  -- if S_scope = S[.CURRENT = pdestructionoperation.CALLER][.ORIGIN = pdestructionoperation.ORIGIN][.CONSTCONTEXT = pdestructionoperation.CONSTCONTEXT]
  -- if $config_generator_saved_scope(S_scope, pconfiggenerator)
  -- if $config_generator_stage(S_scope, pconfiggenerator, text)
def $return_discard(S, CONFIG_GENERATOR pconfiggenerator text) = $config_generator_discard(S, pconfiggenerator, text)
  -- if S.TODO = (THROW_SEARCH n) :: ptask*
  -- if $throwable_live(S, n)
  -- if ~$config_generator_discard_allowed(S, pconfiggenerator) \/ $config_generator_valid(S[.TODO = (THROW_SEARCH n) :: (CONFIG_GENERATOR pconfiggenerator text) :: ptask*], pconfiggenerator, text)
def $throwable_same_frame_continuation(S, S_next, ptask*) = S_next
  -- if S.TODO = (CONFIG_GENERATOR pconfiggenerator text) :: ptask*
  -- if $config_generator_valid(S, pconfiggenerator, text)
  -- if S_next.TODO = S.TODO
  -- if $throwable_pending(S_next.COMPLETION)
def $config_generator_blocked(S) = true
  -- if S.COMPLETION = UNSUPPORTED text_reason
  -- if text_reason <- ["CONFIG Generator unpack producer outside direct domain", "CONFIG Generator unpack send outside two-string integer-key domain", "CONFIG Generator unpack last DATA or callee owner", "CONFIG Generator unpack argument prefix outside domain", "CONFIG Generator unpack last cleanup owner"]
  -- if S.TODO = (CONFIG_GENERATOR pconfiggenerator text) :: ptask*
  -- if $config_generator_valid(S, pconfiggenerator, text)
def $config_generator_blocked(S) = true
  -- if S.COMPLETION = UNSUPPORTED text_reason
  -- if text_reason <- ["CONFIG Generator unpack producer outside direct domain", "CONFIG Generator unpack send outside two-string integer-key domain", "CONFIG Generator unpack last DATA or callee owner", "CONFIG Generator unpack argument prefix outside domain", "CONFIG Generator unpack last cleanup owner"]
  -- if S.TODO = (THROW_SEARCH n) :: (CONFIG_GENERATOR pconfiggenerator text) :: ptask*
  -- if $config_generator_valid(S, pconfiggenerator, text)
def $config_generator_blocked(S) = false -- otherwise
def $generator_close_terminal_pending(S) = true -- if $config_generator_blocked(S)
def $drive_steps(S, n) = S -- if $config_generator_blocked(S)
