;; SEND_UNPACK normalizes a numeric string key for the argument, not the
;; Generator's cached key. Other string keys remain named arguments.
def $config_generator_key(S, PINT z) = (KINT z)
def $config_generator_key(S, PSTRING n*) = (KINT z)
  -- if $startup_bytes(n*)
  -- if $string_key(n*) = INTEGERKEY z
def $config_generator_key(S, PSTRING n*) = (KSTRING n*)
  -- if $startup_bytes(n*)
  -- if $string_key(n*) = STRINGKEY
def $config_generator_key(S, PSTRING_CARRIER pstringidentity n*) = $config_generator_key(S, PSTRING n*)
  -- if $string_carrier_valid(S, PSTRING_CARRIER pstringidentity n*)
def $config_generator_key(S, pvalue) = eps -- otherwise
def $config_generator_string_key_input(pconfiggenerator) = true
  -- if pconfiggenerator.PRODUCER = eps
