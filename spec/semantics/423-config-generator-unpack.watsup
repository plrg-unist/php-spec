;; Native Generator unpack owns DATA once, with no PHP Generator-method frame
;; or public cursor. CV INPUT is nonowning; copied owning sends keep prefix
;; roots. A call-result INPUT keeps its opcode owner until DATA dtor then FREE_OP1.
dec $config_generator_input(pstate, pconfiggenerator) : bool
dec $config_generator_start_input(pstate, poperand, nat) : bool
dec $config_generator_owning_input(pconfiggenerator) : bool
dec $config_generator_input_nodes(pconfiggenerator) : pnode*
dec $config_generator_initial(poperand, pgenerator) : bool
dec $config_generator_release_input(pstate, pconfiggenerator, ptask*) : pstate
dec $config_generator_discard_state(pstate, pconfiggenerator, text) : pstate
dec $config_generator_discard_nodes(pconfiggenerator, text) : pnode*
dec $config_generator_origin(pstate, pconfiggenerator, pgenerator, pfunction) : bool
dec $config_generator_reference_input(pconfiggenerator) : bool
dec $config_generator_temporary_reference_input(pstate, pconfiggenerator) : bool
dec $config_generator_factory_reference_input(pstate, pconfiggenerator) : bool
dec $config_generator_owning_value_source(pstate, pconfiggenerator) : bool
dec $config_generator_history(pstate, pconfiggenerator) : bool
dec $config_generator_quiet_closed(pstate, pconfiggenerator) : bool
dec $config_generator_return_history(pstate, pconfiggenerator) : bool
dec $config_generator_return_storage(pstate, pconfiggenerator) : bool
dec $config_generator_reference_history(pstate, pconfiggenerator) : bool
dec $config_generator_reference_storage(pstate, pconfiggenerator) : bool
dec $config_generator_storage_history(pstate, pconfiggenerator) : bool
dec $config_generator_storage_child(pstate, pconfiggenerator) : bool
dec $config_generator_storage_release(pstate, pconfiggenerator, ptask*) : pstate
dec $config_generator_storage_finish(pstate, pconfiggenerator, ptask*) : pstate
dec $config_generator_retired_scope(pstate, pconfiggenerator) : bool
dec $config_generator_saved_scope(pstate, pconfiggenerator) : bool
dec $config_generator_stage_scope(pstate, pconfiggenerator, text) : bool
dec $config_generator_finish_allowed(pstate, pconfiggenerator) : bool
dec $config_generator_callee(pstate, nat?, nat) : bool
dec $config_generator_stage(pstate, pconfiggenerator, text) : bool
dec $config_generator_at(ptask, porigin) : bool
dec $config_generator_count(ptask*, porigin) : nat
dec $config_generator_valid(pstate, pconfiggenerator, text) : bool
dec $config_generator_header(pstate, pgeneratorop, pconfiggenerator, text) : bool
dec $config_generator_operation_tasks(pstate, pgeneratorop, ptask*) : bool
dec $config_generator_operation_frames(pstate, pgeneratorop, pframe*) : bool
dec $config_generator_run(pstate, pconfiggenerator, text, ptask*) : pstate
dec $config_generator_send_allowed(pstate, pconfiggenerator) : bool
dec $config_generator_value(pstate, pconfiggenerator) : pvalue?
dec $config_generator_send(pstate, pconfiggenerator, ptask*) : pstate
dec $config_generator_key(pstate, pvalue) : pkey?
dec $config_generator_string_key_input(pconfiggenerator) : bool
dec $config_generator_key_input(pconfiggenerator, pvalue) : bool
dec $config_generator_items(pstate, pconfiggenerator, pentry*) : bool
dec $config_generator_argument_nodes(pconfiggenerator) : pnode*
dec $config_generator_owning_items_live(pstate, pentry*) : bool
dec $config_generator_nodes(pconfiggenerator, text) : pnode*
dec $config_generator_finish(pstate, pconfiggenerator, ptask*) : pstate
dec $config_generator_invoke(pstate, pconfiggenerator) : pstate
dec $config_generator_discard_allowed(pstate, pconfiggenerator) : bool
dec $config_generator_discard(pstate, pconfiggenerator, text) : pstate
dec $config_generator_blocked(pstate) : bool

;; A VAR call result is a real opcode INPUT owner, distinct from iterator DATA.
;; Its emitted noarg USER call remains the factory source; the returned named
;; Generator retains its own independently authenticated function/frame origin.
def $config_generator_input(S, pconfiggenerator) = true
  -- if $intrinsic_argument(S, pconfiggenerator.CALL.SITE, 0) = ((expression, true, eps, PORIGIN n_source pcpath, z))
  -- if pconfiggenerator.INPUT = VARIABLE ptbytes z
  -- if $code_at(S.CODE, n_source) = (pcode)
  -- if $source_unit(S.SOURCES, n_source) = (pcunit)
  -- if $unpack_cv_at(pcode, pcunit, pcpath) = (ptbytes)
def $config_generator_input(S, pconfiggenerator) = true
  -- if pconfiggenerator.INPUT = KNOWN (POBJECT pconfiggenerator.OBJECT)
  -- if pconfiggenerator.PRODUCER = eps
  -- if $intrinsic_argument(S, pconfiggenerator.CALL.SITE, 0) = ((expression, true, eps, PORIGIN n_source pcpath, z))
  -- if expression = NExprFuncCall name (SEQUENCE eps) metadata
  -- if $source_emission_noarg_call(S, n_source, pcpath, expression) = (z_call)
  -- if $code_at(S.CODE, n_source) = (pcode)
  -- if $source_unit(S.SOURCES, n_source) = (pcunit)
  -- if $ppunpack_class(pcode, pcunit, pcpath) = (UNPACK_VAR)
  -- if $code_name(pcode.NAMES, pcpath) = ((preqbytes, eps))
  -- if $call_target(S, preqbytes, eps) = (pfunction_call)
  -- if $origin_node(S.SOURCES, pfunction_call.ORIGIN) = (NStmtFunction phpType14 phpType4 phpType11 phpType16 phpType18 phpType23 metadata_call)
  -- if pfunction_call.SIGNATURE.PARAMETERS = eps /\ ~pfunction_call.SIGNATURE.BYREF
def $config_generator_input(S, pconfiggenerator) = true
  -- if $config_generator_temporary_reference_input(S, pconfiggenerator)
def $config_generator_input(S, pconfiggenerator) = false -- otherwise
def $config_generator_start_input(S, VARIABLE ptbytes z, n) = true
  -- if $lookup(S.ENV, ptbytes) = (n_cell)
  -- if S.STORE[n_cell] = DEFINED (POBJECT n)
def $config_generator_start_input(S, KNOWN (POBJECT n), n) = true
def $config_generator_start_input(S, poperand, n) = false -- otherwise
def $config_generator_owning_input(pconfiggenerator) = (n = pconfiggenerator.OBJECT)
  -- if pconfiggenerator.INPUT = KNOWN (POBJECT n)
def $config_generator_owning_input(pconfiggenerator) = false -- otherwise
def $config_generator_input_nodes(pconfiggenerator) = [HOBJECT pconfiggenerator.OBJECT]
  -- if $config_generator_owning_input(pconfiggenerator)
def $config_generator_input_nodes(pconfiggenerator) = eps
  -- if ~$config_generator_owning_input(pconfiggenerator)

