  -- if $string_bytes(pvalue_cache) = (n*)
  -- if pgenerator.KEY = (PINT z)
  -- if pgenerator.RETURN = (POBJECT n_return)
  -- if $ref_return_retire_method(S, n_return) = (pmethoddesc)
def $config_generator_return_history(S, pconfiggenerator) = false -- otherwise
def $config_generator_return_storage(S, pconfiggenerator) = true
