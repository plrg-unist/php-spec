def $config_generator_reference_storage(S, pconfiggenerator) = false -- otherwise
def $config_generator_storage_history(S, pconfiggenerator) = ($config_generator_return_history(S, pconfiggenerator) \/ $config_generator_reference_history(S, pconfiggenerator))
def $config_generator_storage_child(S, pconfiggenerator) = ($config_generator_return_storage(S, pconfiggenerator) \/ $config_generator_reference_storage(S, pconfiggenerator))
def $config_generator_retired_scope(S, pconfiggenerator) = (($config_generator_quiet_closed(S, pconfiggenerator) \/ $config_generator_storage_history(S, pconfiggenerator)) /\ ~$generator_storage_active(S, pconfiggenerator.OBJECT) /\ ~((HOBJECT pconfiggenerator.OBJECT) <- S.ALLOCATIONS))
def $config_generator_saved_scope(S, pconfiggenerator) = $config_generator_scope(S, pconfiggenerator)
  -- if (HOBJECT pconfiggenerator.OBJECT) <- S.ALLOCATIONS
def $config_generator_saved_scope(S, pconfiggenerator) = $config_generator_retired_scope(S, pconfiggenerator)
  -- if ~((HOBJECT pconfiggenerator.OBJECT) <- S.ALLOCATIONS)
def $config_generator_stage_scope(S, pconfiggenerator, text) = $config_generator_saved_scope(S, pconfiggenerator)
  -- if text <- ["invoke", "storage-released"]
def $config_generator_stage_scope(S, pconfiggenerator, text) = $config_generator_scope(S, pconfiggenerator)
  -- if ~(text <- ["invoke", "storage-released"])
def $config_generator_callee(S, eps, n) = true
def $config_generator_callee(S, (n_owner), n) = $($heap_owners($heap_graph(S), HOBJECT n_owner) > n)
;; A CV keeps the outside owner needed when rewind rejects a paused Generator.
;; Temporary INPUT still enters only fresh: its final release requires CLOSED.
def $config_generator_initial(poperand, pgenerator) = true
  -- if pgenerator.PHASE = GENERATOR_FRESH /\ pgenerator.DELEGATE = eps
def $config_generator_initial(VARIABLE ptbytes z, pgenerator) = true
  -- if pgenerator.PHASE <- [GENERATOR_PAUSED, GENERATOR_CLOSED]
  -- if pgenerator.DELEGATE = eps
def $config_generator_initial(poperand, pgenerator) = false -- otherwise
def $config_generator_start(S, pconfigcall, poperand, n) = true
  -- if S.COMPLETION = NORMAL
  -- if S.TODO = (CONFIG_UNPACK_PREP pconfigcall) :: ptask_tail*
  -- if $config_pending_valid(S, pconfigcall, true)
  -- if $config_generator_scope(S, {CALL pconfigcall, OBJECT n, INPUT poperand, ITEMS eps, PRODUCER eps})
  -- if $config_generator_start_input(S, poperand, n)
  -- if S.OBJECTS[n] = GENERATOR pgenerator
  -- if $config_generator_initial(poperand, pgenerator)
  -- if $($heap_owners($heap_graph(S), HOBJECT n) > 0)
  -- if $config_generator_callee(S, pconfigcall.OWNER, 1)
def $config_generator_start(S, pconfigcall, poperand, n) = false -- otherwise
def $config_generator_stage(S, pconfiggenerator, "rewind") = (pconfiggenerator.ITEMS = eps)
def $config_generator_stage(S, pconfiggenerator, "next") = $(|pconfiggenerator.ITEMS| > 0)
def $config_generator_stage(S, pconfiggenerator, "ready") = true
def $config_generator_stage(S, pconfiggenerator, text) = (pgenerator.PHASE = GENERATOR_CLOSED)
  -- if text <- ["finish", "invoke"]
  -- if S.OBJECTS[pconfiggenerator.OBJECT] = GENERATOR pgenerator
def $config_generator_stage(S, pconfiggenerator, "input-release") = true
  -- if $config_generator_owning_input(pconfiggenerator)
  -- if S.OBJECTS[pconfiggenerator.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.PHASE = GENERATOR_CLOSED
def $config_generator_stage(S, pconfiggenerator, "storage-released") = $config_generator_storage_history(S, pconfiggenerator)
def $config_generator_stage(S, pconfiggenerator, text) = false -- otherwise
def $config_generator_at(CONFIG_GENERATOR pconfiggenerator text, porigin) = (pconfiggenerator.CALL.SITE = porigin)
def $config_generator_at(ptask, porigin) = false -- otherwise
def $config_generator_count(eps, porigin) = 0
def $config_generator_count(ptask :: ptask_tail*, porigin) = $(1 + $config_generator_count(ptask_tail*, porigin)) -- if $config_generator_at(ptask, porigin)
def $config_generator_count(ptask :: ptask_tail*, porigin) = $config_generator_count(ptask_tail*, porigin) -- if ~$config_generator_at(ptask, porigin)
def $config_generator_valid(S, pconfiggenerator, text) = true
  -- if $config_generator_stage_scope(S, pconfiggenerator, text)
  -- if $config_generator_stage(S, pconfiggenerator, text)
  -- if $intrinsic_argument(S, pconfiggenerator.CALL.SITE, 0) = ((expression, true, eps, porigin, z))
  -- if ((text <- ["invoke", "input-release"]) /\ S.ORIGIN = (pconfiggenerator.CALL.SITE)) \/ (~(text <- ["invoke", "input-release"]) /\ S.ORIGIN = (porigin))
  -- if $config_generator_count(S.TODO, pconfiggenerator.CALL.SITE) = 1
def $config_generator_valid(S, pconfiggenerator, text) = false -- otherwise
rule PhpStep/config-generator-start: S ~> S_value[.ORIGIN = (porigin)][.TODO = (CONFIG_GENERATOR {CALL pconfigcall, OBJECT n, INPUT S.RESULT, ITEMS eps, PRODUCER eps} "rewind") :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (CONFIG_UNPACK_PREP pconfigcall) :: ptask_tail*
  -- if $intrinsic_argument(S, pconfigcall.SITE, 0) = ((expression, true, eps, porigin, z))
  -- if S_value = $resolve_at(S, S.RESULT, z)
  -- if S_value.COMPLETION = NORMAL
  -- if S_value.RESULT = KNOWN (POBJECT n)
  -- if $config_generator_start(S, pconfigcall, S.RESULT, n)
  -- if S.OBJECTS[n] = GENERATOR pgenerator
  -- if pgenerator.PHASE =/= GENERATOR_CLOSED

;; get_iterator rejects CLOSED before acquiring DATA. Resolve only to identify
