  -- if $(pconfiggenerator.OBJECT < |S.OBJECTS|)
  -- if S.OBJECTS[pconfiggenerator.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.CLOSURE = eps /\ pgenerator.ACCESS = eps
  -- if $function_at($all_functions(S), pgenerator.FUNCTION) = (pfunction)
  -- if $config_generator_origin(S, pconfiggenerator, pgenerator, pfunction)
  -- if $function_generator(S, pfunction)
  -- if pfunction.SIGNATURE.PARAMETERS = eps
  -- if ~pfunction.SIGNATURE.BYREF \/ $config_generator_reference_input(pconfiggenerator) \/ $config_generator_temporary_reference_input(S, pconfiggenerator) \/ $config_generator_factory_reference_input(S, pconfiggenerator)
  -- if $(|pconfiggenerator.ITEMS| <= 2)
  -- if $config_generator_items(S, pconfiggenerator, pconfiggenerator.ITEMS)
  -- if $config_pack_prefix(pconfiggenerator.CALL, pconfiggenerator.ITEMS, false) = (pconfigcall_prefix)
def $config_generator_history(S, pconfiggenerator) = false -- otherwise
def $config_generator_scope(S, pconfiggenerator) = ($config_generator_history(S, pconfiggenerator) /\ ((HOBJECT pconfiggenerator.OBJECT) <- S.ALLOCATIONS))
