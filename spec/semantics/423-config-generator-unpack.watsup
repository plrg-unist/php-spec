  -- if $node_children(S, HOBJECT pconfiggenerator.OBJECT) = eps
def $config_generator_quiet_closed(S, pconfiggenerator) = false -- otherwise
;; Retired slots authenticate immutable identity/type/source metadata, not live
;; RETURN children. free_storage may already have consumed the recorded value.
def $config_generator_return_history(S, pconfiggenerator) = true
  -- if $config_generator_history(S, pconfiggenerator)
  -- if S.OBJECTS[pconfiggenerator.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.PHASE = GENERATOR_CLOSED /\ pgenerator.FRAME = eps
  -- if pgenerator.DELEGATE = eps /\ pgenerator.BORROWED = eps /\ pgenerator.REFCELL = eps
