  -- if pgenerator.VALUE = eps
  -- if pgenerator.RETURN = eps \/ pgenerator.RETURN = (PNULL)
  -- if pgenerator.REFCELL = (n_cell)
  -- if $(n_cell < |S.STORE|)
  -- if pgenerator.KEY = (PINT z)
  -- if $generator_reference_producer(S, pgenerator)
def $config_generator_reference_history(S, pconfiggenerator) = false -- otherwise
def $config_generator_reference_storage(S, pconfiggenerator) = true
  -- if $config_generator_reference_history(S, pconfiggenerator)
  -- if (HOBJECT pconfiggenerator.OBJECT) <- S.ALLOCATIONS
  -- if ~$generator_storage_active(S, pconfiggenerator.OBJECT)
  -- if S.OBJECTS[pconfiggenerator.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.REFCELL = (n_cell)
  -- if $ordinary_reference_value(S, n_cell) = (pvalue)
  -- if $config_iterator_scalar(S, pvalue)
