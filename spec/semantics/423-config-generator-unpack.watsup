def $config_generator_string_key_input(pconfiggenerator) = false -- otherwise
def $config_generator_key_input(pconfiggenerator, PINT z) = true
def $config_generator_key_input(pconfiggenerator, PSTRING n*) = $config_generator_string_key_input(pconfiggenerator)
def $config_generator_key_input(pconfiggenerator, PSTRING_CARRIER pstringidentity n*) = $config_generator_string_key_input(pconfiggenerator)
def $config_generator_key_input(pconfiggenerator, pvalue) = false -- otherwise
;; Owning ITEMS keep bounded history; their graph and finalizer gates are live.
def $config_generator_items(S, pconfiggenerator, eps) = true
def $config_generator_items(S, pconfiggenerator, (ENTRY (KINT z) (DIRECT pvalue)) :: pentry*) = (($config_iterator_scalar(S, pvalue) \/ ($config_generator_owning_value_source(S, pconfiggenerator) /\ $value_nodes(pvalue) =/= eps /\ $config_iterator_value_receipt(S, pvalue))) /\ $config_generator_items(S, pconfiggenerator, pentry*))
def $config_generator_items(S, pconfiggenerator, (ENTRY (KSTRING n*) (DIRECT pvalue)) :: pentry*) = ($config_generator_string_key_input(pconfiggenerator) /\ $string_key(n*) = STRINGKEY /\ $config_iterator_scalar(S, pvalue) /\ $config_generator_items(S, pconfiggenerator, pentry*))
def $config_generator_items(S, pconfiggenerator, pentry*) = false -- otherwise
