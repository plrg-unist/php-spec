  -- if $node_children(S, HOBJECT n_return) = eps
  -- if $node_children(S, HOBJECT pconfiggenerator.OBJECT) = [HOBJECT n_return]
def $config_generator_return_storage(S, pconfiggenerator) = false -- otherwise
;; The live gate reads the scalar while its cell is allocated. Retired history
;; uses only the saved Generator/source shape after storage releases that cell.
def $config_generator_reference_history(S, pconfiggenerator) = true
  -- if $config_generator_history(S, pconfiggenerator)
  -- if $config_generator_reference_input(pconfiggenerator) \/ $config_generator_temporary_reference_input(S, pconfiggenerator) \/ $config_generator_factory_reference_input(S, pconfiggenerator)
  -- if S.OBJECTS[pconfiggenerator.OBJECT] = GENERATOR pgenerator
  -- if pgenerator.PHASE = GENERATOR_CLOSED /\ pgenerator.FRAME = eps
