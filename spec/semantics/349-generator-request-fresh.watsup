;; The untouched creation state certifies a function site, not an executed yield.
;; Ordinary paused close continues to require its original source yield site.
def $generator_request_fresh_closed(pgenerator) = true
  -- if pgenerator.PHASE = GENERATOR_CLOSED /\ pgenerator.FRAME = eps
  -- if ~pgenerator.FIRST /\ pgenerator.INDEX = $(-1)
  -- if pgenerator.VALUE = eps /\ pgenerator.REFCELL = eps /\ pgenerator.KEY = eps
  -- if pgenerator.BORROWED = eps /\ pgenerator.RETURN = eps /\ pgenerator.DELEGATE = eps
def $generator_request_fresh_closed(pgenerator) = false -- otherwise
def $generator_close_done_site(S, pgenerator, pgenclose) = (pgenclose.SITE = pgenerator.FUNCTION /\ pgenclose.STAGE = CLOSE_FINISHED /\ pgenclose.NEXT = 0 /\ $generator_close_function(S, pgenerator))
