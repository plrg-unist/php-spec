dec $ordinary_internal_string_saved_site(pstate, pframe*, porigin, int) : bool
def $ordinary_internal_string_saved_site(S, eps, porigin_site, z) = false
def $ordinary_internal_string_saved_site(S, pframe :: pframe_tail*, porigin_site, z) = ($ordinary_internal_string_frame_site(S, pframe, pframe_tail*, porigin_site, z) \/ $ordinary_internal_string_saved_site(S, pframe_tail*, porigin_site, z))
