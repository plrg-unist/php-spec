;; Callback locations are internal; the actual ordinary constructor frame
;; keeps its compiled call line and live rewritten slots through reentry.
def $ordinary_internal_callback_context(S, pcallcontext) = true
  -- if $ordinary_internal_string_context_data(S, pcallcontext, S.CURRENT, S.FRAMES) = (pordinaryinternal)
def $ordinary_internal_callback_context(S, pcallcontext) = true
  -- if $error_context_call(S, pcallcontext) = (perrorcall)
  -- if perrorcall.RESUME = ORDINARY_CTOR_WARNING pordinaryinternal pvalue
  -- if $error_context_valid(S, pcallcontext)
def $trace_context(S, pbinding*, (pcallcontext)) = [{FILE eps, LINE $(-1), FUNCTION $trace_context_function(S, pcallcontext), CLASS $trace_context_class(S, pcallcontext), TYPE ($ptascii("->")), ARGS eps, HASARGS true}, $default_internal_ctor_trace(S, pordinaryinternal.CALL)]
  -- if $ordinary_internal_string_context_data(S, pcallcontext, S.CURRENT, S.FRAMES) = (pordinaryinternal)
def $trace_context(S, pbinding*, (pcallcontext)) = [{FILE eps, LINE $(-1), FUNCTION $trace_context_function(S, pcallcontext), CLASS $trace_context_class(S, pcallcontext), TYPE $trace_context_type(S, pcallcontext), ARGS $trace_indexed_args(pvalue*, 0), HASARGS true}, $default_internal_ctor_trace(S, pordinaryinternal.CALL)]
