;; Ordinary SEND/name processing is unchanged. The live API slots own values;
;; SOURCE records only nonowning metadata for the received-prefix certificate.
def $ordinary_internal_ready(S, pctorcall) = true
  -- if $call_task_valid(S, CTOR_INVOKE pctorcall)
  -- if $(|pctorcall.SENT| <= $default_internal_arity(pctorcall.BASE))

;; Successful weak string parsing releases the supplied object. Completed
;; prefix evidence uses its immutable arena body, not a new live owner.
dec $ordinary_internal_string_evidence(pstate, nat) : bool
def $ordinary_internal_string_evidence(S, n) = true
  -- if $(n < |S.OBJECTS|)
  -- if S.OBJECTS[n] = INSTANCE porigin_class
  -- if $class_at(S.CLASSES, porigin_class) = (pclassdesc)
  -- if $effective_method(S, porigin_class, $ptascii("__toString"), |S.CLASSES|) = (pmethoddesc)
  -- if pmethoddesc.VISIBILITY = PROPERTY_PUBLIC /\ ~pmethoddesc.ABSTRACT
def $ordinary_internal_string_evidence(S, n) = true
  -- if $(n < |S.OBJECTS|)
  -- if S.OBJECTS[n] = INSTANCE porigin_class
  -- if $effective_method(S, porigin_class, $ptascii("__toString"), |S.CLASSES|) = eps
  -- if $class_throwable_kind(S, porigin_class, |S.CLASSES|) = (text_kind)
  -- if $throwable_nominal(text_kind, $ptascii("Stringable"), 4)
def $ordinary_internal_string_evidence(S, n) = true
  -- if $(n < |S.OBJECTS|)
  -- if S.OBJECTS[n] = THROWABLE pthrowable
  -- if $throwable_nominal(pthrowable.KIND, $ptascii("Stringable"), 4)
def $ordinary_internal_string_evidence(S, n) = false -- otherwise

dec $ordinary_internal_received_value(pstate, pctorcall, nat, pvalue) : bool
def $ordinary_internal_received_value(S, pctorcall, n, PSTRING ptbytes) = true
  -- if ~$exit_strict(S, pctorcall.SITE)
  -- if $default_internal_string(pctorcall.BASE, n)
  -- if $named_slot_at(pctorcall.SENT, n) = NAMED_SENT (KNOWN (POBJECT n_object))
  -- if $ordinary_internal_string_evidence(S, n_object)
def $ordinary_internal_received_value(S, pctorcall, n, pvalue) = true
  -- if $default_internal_warning(S, pctorcall, n) = ((ptbytes, pvalue))
def $ordinary_internal_received_value(S, pctorcall, n, pvalue) = true
  -- if $default_internal_warning(S, pctorcall, n) = eps
  -- if S_value = $default_internal_parameter(S, pctorcall, n, $named_slot_at(pctorcall.SENT, n))
  -- if S_value.COMPLETION = NORMAL
  -- if S_value.RESULT = KNOWN pvalue
def $ordinary_internal_received_value(S, pctorcall, n, pvalue) = false -- otherwise
dec $ordinary_internal_received_prefix(pstate, pctorcall, pvalue*, nat) : bool
def $ordinary_internal_received_prefix(S, pctorcall, eps, n) = true
def $ordinary_internal_received_prefix(S, pctorcall, pvalue :: pvalue_tail*, n) = ($ordinary_internal_received_value(S, pctorcall, n, pvalue) /\ $ordinary_internal_received_prefix(S, pctorcall, pvalue_tail*, $(n + 1)))
dec $ordinary_internal_receiving_valid(pstate, pordinaryinternal) : bool
def $ordinary_internal_receiving_valid(S, pordinaryinternal) = true
  -- if $ordinary_internal_ready(S, pordinaryinternal.SOURCE)
  -- if pctorcall_filled = pordinaryinternal.SOURCE[.SENT = $default_internal_fill(pordinaryinternal.SOURCE.BASE, pordinaryinternal.SOURCE.SENT, 0)]
  -- if pordinaryinternal.CALL = $default_internal_received_call(pctorcall_filled, pordinaryinternal.VALUES, 0)
  -- if pordinaryinternal.INDEX = |pordinaryinternal.VALUES|
  -- if $(pordinaryinternal.INDEX <= $default_internal_arity(pordinaryinternal.CALL.BASE))
  -- if $ordinary_internal_received_prefix(S, pctorcall_filled, pordinaryinternal.VALUES, 0)
def $ordinary_internal_receiving_valid(S, pordinaryinternal) = false -- otherwise
dec $ordinary_internal_receiving_nodes(pordinaryinternal) : pnode*
def $ordinary_internal_receiving_nodes(pordinaryinternal) = $ctor_nodes(pordinaryinternal.CALL)
def $task_nodes(ORDINARY_CTOR_RECEIVE pordinaryinternal) = $ordinary_internal_receiving_nodes(pordinaryinternal)
def $task_nodes(ORDINARY_CTOR_WARNING pordinaryinternal pvalue) = $ordinary_internal_receiving_nodes(pordinaryinternal) ++ $value_nodes(pvalue)
def $task_nodes(ORDINARY_CTOR_STRING pordinaryinternal) = $ordinary_internal_receiving_nodes(pordinaryinternal)
def $call_task_valid(S, ORDINARY_CTOR_RECEIVE pordinaryinternal) = $ordinary_internal_receiving_valid(S, pordinaryinternal)
dec $ordinary_internal_warning_valid(pstate, pordinaryinternal, pvalue) : bool
def $ordinary_internal_warning_valid(S, pordinaryinternal, pvalue) = true
  -- if $ordinary_internal_receiving_valid(S, pordinaryinternal)
  -- if $default_internal_warning(S, pordinaryinternal.CALL, pordinaryinternal.INDEX) = ((ptbytes, pvalue))
def $ordinary_internal_warning_valid(S, pordinaryinternal, pvalue) = false -- otherwise
def $call_task_valid(S, ORDINARY_CTOR_WARNING pordinaryinternal pvalue) = $ordinary_internal_warning_valid(S, pordinaryinternal, pvalue)

rule PhpStep/ordinary-internal-constructor-receive: S ~> S[.TODO = (ORDINARY_CTOR_RECEIVE {SOURCE pctorcall, CALL pctorcall[.SENT = $default_internal_fill(pctorcall.BASE, pctorcall.SENT, 0)], INDEX 0, VALUES eps}) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (CTOR_INVOKE pctorcall) :: ptask_tail*
  -- if $ordinary_internal_ready(S, pctorcall)
dec $ordinary_internal_receiving_next(pstate, pordinaryinternal, pvalue, ptask*) : pstate
def $ordinary_internal_receiving_next(S, pordinaryinternal, pvalue, ptask_tail*) = S[.TODO = (ORDINARY_CTOR_RECEIVE pordinaryinternal[.CALL = $default_internal_string_slot(pordinaryinternal.CALL, pordinaryinternal.INDEX, pvalue)][.INDEX = $(pordinaryinternal.INDEX + 1)][.VALUES = pordinaryinternal.VALUES ++ [pvalue]]) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
rule PhpStep/ordinary-internal-receiving-warning: S ~> $error_dispatch(S, 8192, ptbytes, pordinaryinternal.CALL.LINE, DIAGNOSTIC "Deprecated" ptbytes pordinaryinternal.CALL.LINE, ORDINARY_CTOR_WARNING pordinaryinternal pvalue)
