dec $ordinary_internal_string_record(ptask*) : (nat, porigin, int, pordinaryinternal)?
def $ordinary_internal_string_record((STRINGIFY_RESULT n porigin_site z) :: (ORDINARY_CTOR_STRING pordinaryinternal) :: ptask_tail*) = ((n, porigin_site, z, pordinaryinternal))
def $ordinary_internal_string_record((CALL_ARGS (METHOD_TARGET n porigin_method) eps 0 eps (porigin_site) z) :: ptask_tail*) = $ordinary_internal_string_record(ptask_tail*)
def $ordinary_internal_string_record((THROW_SEARCH n) :: ptask_tail*) = $ordinary_internal_string_record(ptask_tail*)
def $ordinary_internal_string_record(ptask*) = eps -- otherwise
def $ordinary_internal_string_result_kind(ptask*) = ($ordinary_internal_string_record(ptask*) =/= eps)
def $parameter_string_frame_scope(S, pframe, pframe_tail*) = $constant_frame_scope(S, pframe, pframe_tail*)
