  -- if $class_at(S.CLASSES, porigin_requested) = (pclassdesc)

;; Only real notice dispatch creates this saved authority. No RESULT fallback.
def $class_constant_notice_valid(S, porigin, ptbytes_class, ptbytes_member, z) = true
