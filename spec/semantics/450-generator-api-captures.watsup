def $generator_capture_operation(pgeneratorop) = $generator_capture_selection_tag(pgeneratorop.SELECTION)
def $generator_temporary_selection(eps) = false
def $generator_temporary_selection((pgeneratormethodselection)) = pgeneratormethodselection.TEMPORARY
def $generator_temporary_operation(pgeneratorop) = $generator_temporary_selection(pgeneratorop.SELECTION)
def $generator_wrapper_operation(S, pgeneratorop) = ($generator_capture_operation(pgeneratorop) /\ ~$generator_temporary_operation(pgeneratorop) /\ $generator_capture_wrapper_site(S, pgeneratorop.SITE))
