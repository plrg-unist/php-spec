  -- if ~$generator_capture_wrapper_site(S, porigin)
  -- if S.RESULT = KNOWN pvalue
  -- if $value_nodes(pvalue) =/= eps
def $generator_capture_unused_result(S, n, porigin) = false -- otherwise
