  -- if $generator_capture_unused_result(S, n, porigin)
def $getter_capture_finish(S, n, porigin, ptask*) = S[.TODO = ptask*][.BASE = BASE_VALUE S.RESULT]
  -- if ~$generator_capture_unused_result(S, n, porigin)

