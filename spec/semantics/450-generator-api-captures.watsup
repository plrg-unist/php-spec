dec $generator_capture_marker(ptask*, nat, porigin) : bool
dec $generator_capture_marker_frames(pframe*, nat, porigin) : bool
def $generator_capture_marker(eps, n, porigin) = false
def $generator_capture_marker(ptask :: ptask_tail*, n, porigin) = ((ptask = GETTER_CAPTURE_RESULT n porigin) \/ $generator_invoke_marker(ptask, n, porigin) \/ $generator_capture_marker(ptask_tail*, n, porigin))
def $generator_capture_marker_frames(eps, n, porigin) = false
def $generator_capture_marker_frames(pframe :: pframe_tail*, n, porigin) = ($generator_capture_marker(pframe.TODO, n, porigin) \/ $generator_capture_marker_frames(pframe_tail*, n, porigin))
