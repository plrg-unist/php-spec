  -- if S.OBJECTS[n] = INTRINSICCLOSURE INTRINSIC_GET_CLASS
  -- if $exit_fixed(S, pgetclasscall.SITE) = eps
  -- if $exit_dynamic_site(S, pgetclasscall.SITE)
def $getclass_selected_valid(S, pgetclasscall) = true
  -- if pgetclasscall.OWNER = (n)
  -- if $(n < |S.OBJECTS|)
  -- if (HOBJECT n) <- S.ALLOCATIONS
  -- if S.OBJECTS[n] = INTRINSICCLOSURE INTRINSIC_GET_CLASS
  -- if $exit_method_site(S, pgetclasscall.SITE)
def $getclass_selected_valid(S, pgetclasscall) = false -- otherwise
dec $getclass_slots_valid(pnamedslot*, nat, nat, bool) : bool
def $getclass_slots_valid(eps, n, n_total, b) = true
def $getclass_slots_valid((NAMED_SENT (KNOWN pvalue)) :: pnamedslot*, n, n_total, b) = $getclass_slots_valid(pnamedslot*, $(n + 1), n_total, b)
def $getclass_slots_valid(pnamedslot*, n, n_total, b) = false -- otherwise
dec $getclass_slots_live(pstate, pnamedslot*) : bool
def $getclass_slots_live(S, eps) = true
def $getclass_slots_live(S, (NAMED_SENT (KNOWN (POBJECT n))) :: pnamedslot*) = ($getclass_live_object(S, n) /\ $getclass_slots_live(S, pnamedslot*))
def $getclass_slots_live(S, (NAMED_SENT (KNOWN pvalue)) :: pnamedslot*) = $getclass_slots_live(S, pnamedslot*)
  -- if ~$getclass_is_object(pvalue)
def $getclass_slots_live(S, pnamedslot*) = false -- otherwise
dec $getclass_slot_shape(pnamedslot*) : bool*
def $getclass_slot_shape(eps) = eps
def $getclass_slot_shape(NAMED_HOLE :: pnamedslot*) = false :: $getclass_slot_shape(pnamedslot*)
def $getclass_slot_shape((NAMED_SENT poperand) :: pnamedslot*) = true :: $getclass_slot_shape(pnamedslot*)
dec $getclass_source_prefix(phpType7*, pnamedslot*, bool) : (pnamedslot*, bool)?
def $getclass_source_prefix(eps, pnamedslot*, b) = ((pnamedslot*, b))
def $getclass_source_prefix((NArg phpType3 expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType7*, pnamedslot*, b) = $getclass_source_prefix(phpType7*, $named_slot_set(pnamedslot*, n, KNOWN PNULL), (b \/ preqbytes? =/= eps))
  -- if preqbytes? = $exit_argument_name(phpType3)
  -- if $getclass_destination(preqbytes?, |pnamedslot*|) = (n)
  -- if $named_slot_at(pnamedslot*, n) = NAMED_HOLE
  -- if ~(b /\ preqbytes? = eps)
def $getclass_source_prefix(phpType7*, pnamedslot*, b) = eps -- otherwise
dec $getclass_sent_shape(pstate, pgetclasscall) : bool
def $getclass_sent_shape(S, pgetclasscall) = true
  -- if $exit_callable_arguments(S, pgetclasscall.SITE) = PCALLARGUMENTS phpType7* n_field
  -- if $(pgetclasscall.INDEX <= |phpType7*|)
