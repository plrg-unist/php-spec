  -- if S.OBJECTS[n] = NAMEDCLOSURE porigin
def $getclass_live_object(S, n) = false -- otherwise

dec $getclass_receive(pstate, pgetclasscall) : pstate
def $getclass_receive(S, pgetclasscall) = $getclass_error(S, pgetclasscall, "ArgumentCountError", $ptascii("get_class() expects at most 1 argument, ") ++ $decimal_integer(|pgetclasscall.SENT|) ++ $ptascii(" given"))
  -- if $(|pgetclasscall.SENT| > 1)
def $getclass_receive(S, pgetclasscall) = $getclass_error(S, pgetclasscall, "Error", $ptascii("get_class() without arguments must be called from within a class"))
  -- if pgetclasscall.SENT = eps
  -- if $method_current_scope(S) = eps
def $getclass_receive(S, pgetclasscall) = S_report[.TODO = ptask_tail*][.RESULT = KNOWN (PSTRING pclassdesc.NAME)][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if pgetclasscall.SENT = eps
  -- if $method_current_scope(S) = (porigin)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if S_report = $diagnostic(S, "Deprecated", $ptascii("Calling get_class() without arguments is deprecated"), pgetclasscall.LINE)
  -- if S_report.COMPLETION = NORMAL
  -- if S.TODO = ptask :: ptask_tail*
def $getclass_receive(S, pgetclasscall) = S_report
  -- if pgetclasscall.SENT = eps
  -- if $method_current_scope(S) = (porigin)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if S_report = $diagnostic(S, "Deprecated", $ptascii("Calling get_class() without arguments is deprecated"), pgetclasscall.LINE)
  -- if S_report.COMPLETION =/= NORMAL
def $getclass_receive(S, pgetclasscall) = $getclass_error(S, pgetclasscall, "TypeError", $ptascii("get_class(): Argument #1 ($object) must be of type object, ") ++ $typed_given(S, pvalue) ++ $ptascii(" given"))
  -- if pgetclasscall.SENT = [NAMED_SENT (KNOWN pvalue)]
  -- if ~$getclass_is_object(pvalue)
def $getclass_receive(S, pgetclasscall) = S[.TODO = ptask_tail*][.RESULT = KNOWN (PSTRING $object_name(S, n))][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if pgetclasscall.SENT = [NAMED_SENT (KNOWN (POBJECT n))]
  -- if $getclass_live_object(S, n)
  -- if S.TODO = ptask :: ptask_tail*
rule PhpStep/getclass-invoke: S ~> $getclass_receive(S, pgetclasscall)
  -- if S.TODO = (GETCLASS_INVOKE pgetclasscall) :: ptask_tail*

def $getclass_is_object(POBJECT n) = true
def $getclass_is_object(pvalue) = false -- otherwise


;; Captured receiver state is checked separately from the current head result.
;; Origin-return simulation authenticates queued continuations after child eval.
dec $getclass_selected_valid(pstate, pgetclasscall) : bool
def $getclass_selected_valid(S, pgetclasscall) = true
  -- if pgetclasscall.OWNER = eps
  -- if $exit_fixed(S, pgetclasscall.SITE) = ((preqbytes, preqbytes_fallback?))
  -- if $call_target(S, preqbytes, preqbytes_fallback?) = eps
  -- if $intrinsic_lookup(preqbytes, preqbytes_fallback?) = (INTRINSIC_GET_CLASS)
def $getclass_selected_valid(S, pgetclasscall) = true
  -- if pgetclasscall.OWNER = eps
  -- if $exit_fixed(S, pgetclasscall.SITE) = eps
  -- if $exit_dynamic_site(S, pgetclasscall.SITE)
def $getclass_selected_valid(S, pgetclasscall) = true
  -- if pgetclasscall.OWNER = (n)
  -- if $(n < |S.OBJECTS|)
