  -- if $getclass_slots_live(S, pgetclasscall.SENT)
def $getclass_call_valid(S, pgetclasscall) = false -- otherwise
dec $getclass_pending_valid(pstate, pgetclasscall, bool) : bool
def $getclass_pending_valid(S, pgetclasscall, b) = true
  -- if $getclass_call_valid(S, pgetclasscall)
  -- if $getclass_sent_shape(S, pgetclasscall)
  -- if $intrinsic_argument(S, pgetclasscall.SITE, pgetclasscall.INDEX) = ((expression, b, preqbytes?, porigin, z))
def $getclass_pending_valid(S, pgetclasscall, b) = false -- otherwise
def $call_task_valid(S, GETCLASS_ARGS pgetclasscall) = ($getclass_call_valid(S, pgetclasscall) /\ $getclass_sent_shape(S, pgetclasscall))
def $call_task_valid(S, GETCLASS_SEND pgetclasscall) = $getclass_pending_valid(S, pgetclasscall, false)
def $call_task_valid(S, GETCLASS_UNPACK_PREP pgetclasscall) = $getclass_pending_valid(S, pgetclasscall, true)
dec $getclass_invoke_valid(pstate, pgetclasscall) : bool
def $getclass_invoke_valid(S, pgetclasscall) = true
  -- if $getclass_call_valid(S, pgetclasscall)
  -- if $getclass_sent_shape(S, pgetclasscall)
  -- if $intrinsic_count(S, pgetclasscall.SITE) = (pgetclasscall.INDEX)
def $getclass_invoke_valid(S, pgetclasscall) = false -- otherwise
def $call_task_valid(S, GETCLASS_INVOKE pgetclasscall) = $getclass_invoke_valid(S, pgetclasscall)
dec $getclass_unpack_valid(pstate, pgetclasscall, poperand, nat) : bool
def $getclass_unpack_valid(S, pgetclasscall, KNOWN (PARRAY n), n_cursor) = true
  -- if $getclass_call_valid(S, pgetclasscall)
  -- if $intrinsic_argument(S, pgetclasscall.SITE, pgetclasscall.INDEX) = ((expression, true, preqbytes?, porigin, z))
  -- if $(n < |S.ARRAYS|)
  -- if (HARRAY n) <- S.ALLOCATIONS
  -- if $(n_cursor <= |S.ARRAYS[n].ITEMS|)
  -- if $getclass_sent_shape(S, pgetclasscall)
  -- if $getclass_unpack_prefix(S, pgetclasscall, S.ARRAYS[n].ITEMS[0:n_cursor]) = (pgetclasscall_prefix)
def $getclass_unpack_valid(S, pgetclasscall, poperand, n_cursor) = false -- otherwise
def $call_task_valid(S, GETCLASS_UNPACK_NEXT pgetclasscall poperand n_cursor) = $getclass_unpack_valid(S, pgetclasscall, poperand, n_cursor)

dec $getclass_pending_result_valid(pstate, pgetclasscall, bool) : bool
def $getclass_pending_result_valid(S, pgetclasscall, b_unpack) = true
  -- if $intrinsic_argument(S, pgetclasscall.SITE, pgetclasscall.INDEX) = ((expression, b_unpack, preqbytes?, PORIGIN n pcpath, z))
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $source_unit(S.SOURCES, n) = (pcunit)
  -- if $ppunpack_class(pcode, pcunit, pcpath) = (UNPACK_CV)
  -- if $exit_cv_operand(pcode, pcunit, pcpath) = (S.RESULT)
def $getclass_pending_result_valid(S, pgetclasscall, b_unpack) = true
  -- if $intrinsic_argument(S, pgetclasscall.SITE, pgetclasscall.INDEX) = ((expression, b_unpack, preqbytes?, PORIGIN n pcpath, z))
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $source_unit(S.SOURCES, n) = (pcunit)
  -- if $ppunpack_class(pcode, pcunit, pcpath) = (punpackclass)
  -- if punpackclass =/= UNPACK_CV
  -- if $unpack_owned(S, S.RESULT)
def $getclass_pending_result_valid(S, pgetclasscall, b_unpack) = false -- otherwise
def $getclass_result_valid(S) = $getclass_result_valid(S[.ORIGIN = (porigin)][.TODO = ptask :: ptask_tail*])
  -- if S.TODO = (AT porigin ptask) :: ptask_tail*
def $getclass_result_valid(S) = $getclass_result_valid(S[.ORIGIN = porigin?][.TODO = ptask_tail*])
  -- if S.TODO = (ORIGIN_RETURN porigin?) :: ptask_tail*
def $getclass_result_valid(S) = $getclass_pending_result_valid(S, pgetclasscall, false)
  -- if S.TODO = (GETCLASS_SEND pgetclasscall) :: ptask_tail*
def $getclass_result_valid(S) = $getclass_pending_result_valid(S, pgetclasscall, true)
  -- if S.TODO = (GETCLASS_UNPACK_PREP pgetclasscall) :: ptask_tail*
def $getclass_result_valid(S) = true -- otherwise

;; Recheck an unpacked prefix without repeating observable effects.
def $getclass_unpack_prefix(S, pgetclasscall, eps) = (pgetclasscall)
def $getclass_unpack_prefix(S, pgetclasscall, (ENTRY pkey pitem) :: pentry*) = $getclass_unpack_prefix(S, $getclass_sent(pgetclasscall, KNOWN $entry_value(S, pitem), preqbytes?), pentry*)
  -- if preqbytes? = $exit_key_name(pkey)
  -- if S_checked = $getclass_send_check(S, pgetclasscall, preqbytes?, pgetclasscall.LINE)
  -- if S_checked.COMPLETION = NORMAL
def $getclass_unpack_prefix(S, pgetclasscall, pentry*) = eps -- otherwise
