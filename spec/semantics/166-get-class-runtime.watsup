  -- if S.OBJECTS[n] = THROWABLE pthrowable
def $getclass_live_object(S, n) = true
  -- if $(n < |S.OBJECTS|)
  -- if (HOBJECT n) <- S.ALLOCATIONS
  -- if S.OBJECTS[n] = INTRINSICCLOSURE pintrinsic
def $getclass_live_object(S, n) = true
  -- if $(n < |S.OBJECTS|)
  -- if (HOBJECT n) <- S.ALLOCATIONS
  -- if S.OBJECTS[n] = REALCLOSURE porigin pitem* pstaticcell*
def $getclass_live_object(S, n) = true
  -- if $(n < |S.OBJECTS|)
