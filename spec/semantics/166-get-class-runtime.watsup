;; get_class is a finite authored intrinsic; ordinary call machinery supplies source arguments.
def $intrinsic_name(INTRINSIC_GET_CLASS) = $ptascii("get_class")
def $intrinsic_named(preqbytes) = (INTRINSIC_GET_CLASS) -- if $ptlc(preqbytes) = $ptascii("get_class")
def $intrinsic_prepare(S, INTRINSIC_GET_CLASS, z, n_owner?) = S[.TODO = (GETCLASS_ARGS {SITE porigin, INDEX 0, SENT eps, NAMED false, OWNER n_owner?, LINE z}) :: S.TODO][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.ORIGIN = (porigin)
def $intrinsic_pipe(S, INTRINSIC_GET_CLASS, pvalue, porigin, z, n_owner?) = S[.TODO = (GETCLASS_INVOKE {SITE porigin, INDEX 1, SENT ([NAMED_SENT (KNOWN pvalue)]), NAMED false, OWNER n_owner?, LINE z}) :: S.TODO][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
dec $getclass_unpack_prefix(pstate, pgetclasscall, pentry*) : pgetclasscall?
dec $getclass_is_object(pvalue) : bool

dec $getclass_call_nodes(pgetclasscall) : pnode*
def $getclass_call_nodes(pgetclasscall) = $exit_owner_nodes(pgetclasscall.OWNER) ++ $named_slots_roots(pgetclasscall.SENT)
def $task_nodes(GETCLASS_ARGS pgetclasscall) = $getclass_call_nodes(pgetclasscall)
def $task_nodes(GETCLASS_SEND pgetclasscall) = $getclass_call_nodes(pgetclasscall)
def $task_nodes(GETCLASS_UNPACK_PREP pgetclasscall) = $getclass_call_nodes(pgetclasscall)
def $task_nodes(GETCLASS_UNPACK_NEXT pgetclasscall poperand n) = $getclass_call_nodes(pgetclasscall) ++ $operand_nodes(poperand)
def $task_nodes(GETCLASS_INVOKE pgetclasscall) = $getclass_call_nodes(pgetclasscall)

dec $getclass_trace_operands(pnamedslot*) : poperand*
def $getclass_trace_operands(eps) = eps
def $getclass_trace_operands(NAMED_HOLE :: pnamedslot*) = (KNOWN PNULL) :: $getclass_trace_operands(pnamedslot*)
def $getclass_trace_operands((NAMED_SENT poperand) :: pnamedslot*) = poperand :: $getclass_trace_operands(pnamedslot*)
dec $getclass_method_receiver(pstate, pgetclasscall) : bool
def $getclass_method_receiver(S, pgetclasscall) = true
  -- if pgetclasscall.OWNER = (n)
  -- if $exit_method_site(S, pgetclasscall.SITE)
def $getclass_method_receiver(S, pgetclasscall) = false -- otherwise
dec $getclass_wrapper_trace(pstate, pgetclasscall, pvalue*) : ptraceframe*
def $getclass_wrapper_trace(S, pgetclasscall, pvalue*) = [{FILE $call_sourcefile(S.FILES, pgetclasscall.SITE), LINE pgetclasscall.LINE, NAME $ptascii("Closure->__invoke"), VALUES pvalue*, ARGTEXT $trace_arguments_text(S, pvalue*)}]
  -- if $getclass_method_receiver(S, pgetclasscall)
def $getclass_wrapper_trace(S, pgetclasscall, pvalue*) = eps -- otherwise
dec $getclass_error(pstate, pgetclasscall, text, preqbytes) : pstate
def $getclass_error(S, pgetclasscall, text, preqbytes) = $throwable_allocate(S[.ORIGIN = (pgetclasscall.SITE)], text, preqbytes, pgetclasscall.LINE, $eval_exception_trace(S))
  -- if $getclass_special(S, pgetclasscall.SITE)
def $getclass_error(S, pgetclasscall, text, preqbytes) = $throwable_allocate(S[.ORIGIN = (pgetclasscall.SITE)], text, preqbytes, pgetclasscall.LINE, [ptraceframe] ++ $getclass_wrapper_trace(S, pgetclasscall, pvalue*) ++ $eval_exception_trace(S))
  -- if ~$getclass_special(S, pgetclasscall.SITE)
  -- if pvalue* = $trace_extra(S, $getclass_trace_operands(pgetclasscall.SENT))
  -- if ptraceframe = {FILE $call_sourcefile(S.FILES, pgetclasscall.SITE), LINE pgetclasscall.LINE, NAME $ptascii("get_class"), VALUES pvalue*, ARGTEXT $trace_arguments_text(S, pvalue*)}
dec $getclass_destination(preqbytes?, nat) : nat?
def $getclass_destination(eps, n) = (n)
def $getclass_destination((preqbytes), n) = (0) -- if preqbytes = $ptascii("object")
def $getclass_destination(preqbytes?, n) = eps -- otherwise
dec $getclass_send_check(pstate, pgetclasscall, preqbytes?, int) : pstate
def $getclass_send_check(S, pgetclasscall, (preqbytes), z) = $throw_scalar(S, "Error", $ptascii("Unknown named parameter $") ++ $c_string(preqbytes), z)
  -- if $getclass_destination((preqbytes), |pgetclasscall.SENT|) = eps
def $getclass_send_check(S, pgetclasscall, (preqbytes), z) = $throw_scalar(S, "Error", $ptascii("Named parameter $") ++ preqbytes ++ $ptascii(" overwrites previous argument"), z)
  -- if $getclass_destination((preqbytes), |pgetclasscall.SENT|) = (n)
  -- if $named_slot_at(pgetclasscall.SENT, n) = NAMED_SENT poperand
def $getclass_send_check(S, pgetclasscall, eps, z) = $throw_scalar(S, "Error", $ptascii("Cannot use positional argument after named argument during unpacking"), z)
  -- if pgetclasscall.NAMED
def $getclass_send_check(S, pgetclasscall, preqbytes?, z) = S -- otherwise
dec $getclass_sent(pgetclasscall, poperand, preqbytes?) : pgetclasscall
def $getclass_sent(pgetclasscall, poperand, preqbytes?) = pgetclasscall[.SENT = $named_slot_set(pgetclasscall.SENT, n, poperand)][.NAMED = (pgetclasscall.NAMED \/ preqbytes? =/= eps)]
  -- if $getclass_destination(preqbytes?, |pgetclasscall.SENT|) = (n)

rule PhpStep/getclass-argument: S ~> S[.TODO = [$at_task((porigin), EVAL expression), GETCLASS_SEND pgetclasscall] ++ ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
