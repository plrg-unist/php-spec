rule PhpStep/getclass-unpack-array: S ~> S_value[.TODO = (GETCLASS_UNPACK_NEXT pgetclasscall S_value.RESULT 0) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
