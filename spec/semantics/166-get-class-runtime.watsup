def $getclass_sent_shape(S, pgetclasscall) = true
  -- if $exit_callable_arguments(S, pgetclasscall.SITE) = PCALLARGUMENTS phpType7* n_field
  -- if $(pgetclasscall.INDEX <= |phpType7*|)
