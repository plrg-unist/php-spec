  -- if (~$exit_prefix_named(phpType7*[0:pgetclasscall.INDEX]) \/ pgetclasscall.NAMED)
def $getclass_sent_shape(S, pgetclasscall) = true
  -- if $pipe_site(S, pgetclasscall.SITE)
  -- if pgetclasscall.INDEX = 1
  -- if |pgetclasscall.SENT| = 1
  -- if ~pgetclasscall.NAMED
def $getclass_sent_shape(S, pgetclasscall) = false -- otherwise
dec $getclass_call_valid(pstate, pgetclasscall) : bool
def $getclass_call_valid(S, pgetclasscall) = true
  -- if S.ORIGIN = (pgetclasscall.SITE)
  -- if $getclass_selected_valid(S, pgetclasscall)
  -- if pgetclasscall.SITE = PORIGIN n pcpath
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_expression(pcode.EXPRESSIONS, pcpath) = ((pgetclasscall.LINE, false))
