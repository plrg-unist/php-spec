dec $getclass_live_object(pstate, nat) : bool
def $getclass_live_object(S, n) = true
  -- if $(n < |S.OBJECTS|)
  -- if (HOBJECT n) <- S.ALLOCATIONS
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
def $getclass_live_object(S, n) = true
  -- if $(n < |S.OBJECTS|)
  -- if (HOBJECT n) <- S.ALLOCATIONS
  -- if S.OBJECTS[n] = STDINSTANCE
def $getclass_live_object(S, n) = true
  -- if $(n < |S.OBJECTS|)
