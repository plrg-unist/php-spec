def $autoload_entry(S, pconfigcall, pautoloadtarget) = {CALL pconfigcall, CAPTURE $consumer_capture_current(S, pconfigcall.SITE), PRODUCER $consumer_producer_current(S), RAW $autoload_snapshot(S, pconfigcall, pcalltarget), TARGET pautoloadtarget, SCOPE $consumer_producer_scope(S, pcalltarget), BINDING $consumer_producer_binding(S, pcalltarget)}
  -- if pautoloadtarget = AUTO_TARGET pcalltarget
def $autoload_entry(S, pconfigcall, pautoloadtarget) = {CALL pconfigcall, CAPTURE $consumer_capture_current(S, pconfigcall.SITE), PRODUCER $consumer_producer_current(S), RAW eps, TARGET pautoloadtarget, SCOPE eps, BINDING eps}
  -- if ~$autoload_source_target(pautoloadtarget)

def $autoload_target_nodes(AUTO_TARGET pcalltarget) = $target_nodes(pcalltarget)
def $autoload_target_nodes(pautoloadtarget) = eps -- otherwise
def $autoload_object_identity(pautoloadentry) = (n) -- if $autoload_raw(pautoloadentry) = POBJECT n
def $autoload_object_identity(pautoloadentry) = eps -- otherwise
def $autoload_entry_nodes(pautoloadentry) = $autoload_target_nodes(pautoloadentry.TARGET) ++ $scoped_receiver_nodes(n_receiver?)
  -- if pautoloadentry.TARGET = AUTO_TARGET pcalltarget
  -- if $target_instance(pcalltarget) =/= eps
  -- if n_receiver? = $autoload_closure_receiver(pautoloadentry)
;; An invokable raw object is retained as both receiver and original OBJECT.
def $autoload_entry_nodes(pautoloadentry) = $autoload_target_nodes(pautoloadentry.TARGET) ++ $scoped_receiver_nodes($autoload_object_identity(pautoloadentry))
  -- if pautoloadentry.TARGET = AUTO_TARGET pcalltarget
  -- if $target_instance(pcalltarget) = eps
def $autoload_entry_nodes(pautoloadentry) = eps -- if ~$autoload_source_target(pautoloadentry.TARGET)

def $autoload_entry_history(S, pautoloadentry) = S_tables[.ALLOCATIONS = S_tables.ALLOCATIONS ++ $autoload_entry_nodes(pautoloadentry)]
  -- if S_tables = S[.CLOSURESCOPES = $consumer_producer_scopes(pautoloadentry.SCOPE) ++ S.CLOSURESCOPES][.CLOSUREBINDINGS = $consumer_producer_bindings(pautoloadentry.BINDING) ++ S.CLOSUREBINDINGS]
def $autoload_entry_valid(S, pautoloadentry) = true
