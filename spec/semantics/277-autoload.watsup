  -- if papiquery.CALLED = $consumer_capture_called(S, pautoloadentry.CALL.SITE, pautoloadentry.CAPTURE)
  -- if $consumer_capture_this(S, pautoloadentry.CALL.SITE, pautoloadentry.CAPTURE, papiquery.THIS)
  -- if papiquery.LINE = pautoloadentry.CALL.LINE
  -- if $autoload_raw(pautoloadentry) = papiquery.VALUE
  -- if $consumer_snapshot_valid(papiquery, pautoloadentry.RAW)
def $autoload_api_entry_scope(S, papiquery, pautoloadentry) = false -- otherwise
def $autoload_api_entry_owner(S, papiquery, eps) = false
def $autoload_api_entry_owner(S, papiquery, pautoloadentry :: pautoloadentry_tail*) = ($autoload_api_entry_scope(S, papiquery, pautoloadentry) \/ $autoload_api_entry_owner(S, papiquery, pautoloadentry_tail*))
def $autoload_api_entry_tasks(eps) = eps
def $autoload_api_entry_tasks((AUTO_REGISTER_RECEIVE pautoloadregistration) :: ptask_tail*) = pautoloadregistration.ENTRY :: $autoload_api_entry_tasks(ptask_tail*)
def $autoload_api_entry_tasks((AUTO_REGISTER_NULL pautoloadregistration) :: ptask_tail*) = pautoloadregistration.ENTRY :: $autoload_api_entry_tasks(ptask_tail*)
def $autoload_api_entry_tasks((AUTO_REGISTER_NOTICE pautoloadregistration) :: ptask_tail*) = pautoloadregistration.ENTRY :: $autoload_api_entry_tasks(ptask_tail*)
def $autoload_api_entry_tasks((AUTO_UNREGISTER pautoloadentry) :: ptask_tail*) = pautoloadentry :: $autoload_api_entry_tasks(ptask_tail*)
def $autoload_api_entry_tasks((AUTO_REFERENCE pautoloadcall pautoloadentry) :: ptask_tail*) = pautoloadentry :: $autoload_api_entry_tasks(ptask_tail*)
def $autoload_api_entry_tasks((AUTO_ENTER pautoloadcall pautoloadentry poperand) :: ptask_tail*) = pautoloadentry :: $autoload_api_entry_tasks(ptask_tail*)
def $autoload_api_entry_tasks((AUTO_RESULT pautoloadcall pautoloadentry poperand) :: ptask_tail*) = pautoloadentry :: $autoload_api_entry_tasks(ptask_tail*)
def $autoload_api_entry_tasks((ERROR_HANDLER_INVOKE perrorcall) :: ptask_tail*) = $autoload_api_entry_tasks([perrorcall.RESUME]) ++ $autoload_api_entry_tasks(ptask_tail*)
def $autoload_api_entry_tasks((ERROR_HANDLER_RESULT perrorcall) :: ptask_tail*) = $autoload_api_entry_tasks([perrorcall.RESUME]) ++ $autoload_api_entry_tasks(ptask_tail*)
def $autoload_api_entry_tasks(ptask :: ptask_tail*) = $autoload_api_entry_tasks(ptask_tail*) -- otherwise
def $autoload_api_entry_frames(eps) = eps
def $autoload_api_entry_frames(pframe :: pframe_tail*) = $autoload_api_entry_tasks(pframe.TODO) ++ $autoload_api_entry_frames(pframe_tail*)
