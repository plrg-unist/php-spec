def $autoload_source_target(AUTO_TARGET pcalltarget) = true
def $autoload_source_target(pautoloadtarget) = false -- otherwise
def $autoload_is_bool(PBOOL b) = true
def $autoload_is_bool(pvalue) = false -- otherwise
def $autoload_remove(pautoloadentry? :: pautoloadentry_tail?*, 0) = eps :: pautoloadentry_tail?*
def $autoload_remove(pautoloadentry? :: pautoloadentry_tail?*, n) = pautoloadentry? :: $autoload_remove(pautoloadentry_tail?*, $nabs($(n - 1))) -- if $(n > 0)
def $autoload_array_items(parray, eps) = parray
def $autoload_array_items(parray, (ENTRY pkey pitem) :: pentry_tail*) = $autoload_array_items($array_insert(parray, pkey, pitem), pentry_tail*)
def $autoload_closure_receiver(pautoloadentry) = pclosurescope.RECEIVER -- if pautoloadentry.SCOPE = (pclosurescope)
def $autoload_closure_receiver(pautoloadentry) = pclosurebinding.RECEIVER -- if pautoloadentry.SCOPE = eps -- if pautoloadentry.BINDING = (pclosurebinding)
def $autoload_closure_receiver(pautoloadentry) = eps -- if pautoloadentry.SCOPE = eps /\ pautoloadentry.BINDING = eps

def $intrinsic_name(INTRINSIC_AUTO_REGISTER) = $ptascii("spl_autoload_register")
def $intrinsic_name(INTRINSIC_AUTO_UNREGISTER) = $ptascii("spl_autoload_unregister")
