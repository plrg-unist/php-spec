def $autoload_special(S, PSTRING ptbytes) = (AUTO_DEFAULT) -- if $ptlc($typed_callable_name(ptbytes)) = $ptascii("spl_autoload")
def $autoload_special(S, PSTRING ptbytes) = (AUTO_ALL) -- if $ptlc($typed_callable_name(ptbytes)) = $ptascii("spl_autoload_call")
