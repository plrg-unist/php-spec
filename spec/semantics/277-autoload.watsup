;; A mixed table starts at eight buckets. Appends compact only at capacity;
;; external HashPosition cursors are intentionally left at their old indices.
def $autoload_initialize(S) = S[.AUTOLOAD.CAPACITY = 8] -- if S.AUTOLOAD.CAPACITY = 0
def $autoload_initialize(S) = S -- if $(S.AUTOLOAD.CAPACITY > 0)
def $autoload_resize(S) = S -- if $(|S.AUTOLOAD.ENTRIES| < S.AUTOLOAD.CAPACITY)
def $autoload_resize(S) = S[.AUTOLOAD.ENTRIES = $autoload_compact(S.AUTOLOAD.ENTRIES)]
  -- if $(|S.AUTOLOAD.ENTRIES| >= S.AUTOLOAD.CAPACITY)
  -- if n_count = $autoload_count(S.AUTOLOAD.ENTRIES)
  -- if $(|S.AUTOLOAD.ENTRIES| > n_count + (n_count / 32))
def $autoload_resize(S) = S[.AUTOLOAD.CAPACITY = $(2 * S.AUTOLOAD.CAPACITY)]
  -- if $(|S.AUTOLOAD.ENTRIES| >= S.AUTOLOAD.CAPACITY)
  -- if n_count = $autoload_count(S.AUTOLOAD.ENTRIES)
  -- if $(|S.AUTOLOAD.ENTRIES| <= n_count + (n_count / 32))
def $autoload_append(S, pautoloadentry) = S[.AUTOLOAD.ENTRIES = S.AUTOLOAD.ENTRIES ++ [(pautoloadentry)]]
def $autoload_prepend(S, b) = S -- if n_count = $autoload_count(S.AUTOLOAD.ENTRIES) -- if ~b \/ $(n_count <= 1)
def $autoload_prepend(S, true) = S[.AUTOLOAD.ENTRIES = [(pautoloadentry)] ++ $autoload_compact(S.AUTOLOAD.ENTRIES[0:n])]
  -- if n_count = $autoload_count(S.AUTOLOAD.ENTRIES)
  -- if $(n_count > 1)
  -- if n = $nabs($(|S.AUTOLOAD.ENTRIES| - 1))
  -- if S.AUTOLOAD.ENTRIES[n] = (pautoloadentry)
def $autoload_capacity_valid(0) = true
def $autoload_capacity_valid(8) = true
def $autoload_capacity_valid(n) = $autoload_capacity_valid($(n / 2)) -- if $(n > 8) /\ $(n \ 2) = 0
def $autoload_capacity_valid(n) = false -- otherwise

