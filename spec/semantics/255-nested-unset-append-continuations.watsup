def $key_unset_fetch_value(S, pkeyread) = $key_unset_fetch_dispatch(S, pkeyread[.PHASE = KEY_NULL])
  -- if pkeyread.VALUE = PNULL
def $key_unset_fetch_value(S, pkeyread) = $key_unset_fetch_dispatch(S, pkeyread[.PHASE = KEY_FLOAT castnotice castnotice_tail*][.KEY = KINT i])
  -- if pkeyread.VALUE = PFLOAT n_bits
  -- if $float_long(n_bits, true) = (i, castnotice :: castnotice_tail*)
def $key_unset_fetch_value(S, pkeyread) = $key_unset_fetch_lookup(S, pkeyread[.KEY = pkey])
  -- if pkeyread.VALUE =/= PNULL
  -- if $key_plain_value(pkeyread.VALUE)
  -- if $key_selected_key(pkeyread.VALUE) = (pkey)
def $key_unset_fetch_value(S, pkeyread) = $dimension_key_value(S, pkeyread.VALUE, pkeyread.LINE)
  -- if $key_selected_key(pkeyread.VALUE) = eps
def $key_unset_fetch_lookup(S, pkeyread) = $key_unset_fetch_done(S_found, S_found.LOCATION)
  -- if pkeyread.BASE = PARRAY n
  -- if S_found = $find_element(S, n, pkeyread.KEY)
def $key_unset_fetch_dispatch(S, pkeyread) = $error_dispatch(S[.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], $key_read_level(pkeyread), $key_read_message(pkeyread), pkeyread.LINE, $key_read_event(pkeyread), KEY_UNSET_FETCH_RESULT pkeyread)
def $task_nodes(KEY_UNSET_FETCH_RESULT pkeyread) = $value_nodes(pkeyread.BASE)
def $key_unset_fetch_resume(S, pkeyread) = $key_unset_fetch_dispatch(S, pkeyread[.PHASE = KEY_FLOAT castnotice_next castnotice_tail*])
  -- if pkeyread.PHASE = KEY_FLOAT castnotice (castnotice_next :: castnotice_tail*)
def $key_unset_fetch_resume(S, pkeyread) = $key_unset_fetch_done(S, NOWHERE)
  -- if ~$key_float_more(pkeyread.PHASE)
  -- if ~$key_read_live(S, pkeyread)
def $key_unset_fetch_resume(S, pkeyread) = $key_unset_fetch_dispatch(S, pkeyread[.PHASE = KEY_NULL][.VALUE = PNULL][.NAME = eps])
  -- if pkeyread.PHASE = KEY_CV
  -- if $key_read_live(S, pkeyread)
def $key_unset_fetch_resume(S, pkeyread) = $key_unset_fetch_lookup(S, pkeyread)
  -- if pkeyread.PHASE = KEY_NULL \/ ($key_float_phase(pkeyread.PHASE) /\ ~$key_float_more(pkeyread.PHASE))
