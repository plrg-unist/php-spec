;; A dead/missing prefix returns its independent null operand. Its next key
;; CV still warns, but neither creates a table nor converts null as an array key.
def $key_unset_null_mode(true) = KEY_R
def $key_unset_null_mode(false) = KEY_IS
def $key_unset_dimension(S, poperand, z, b) = $error_dispatch(S[.RESULT = KNOWN PNULL], 2, $key_read_message(pkeyread), z, $key_read_event(pkeyread), KEY_UNSET_NULL_RESULT pkeyread)
  -- if $key_tail_slot($location_slot(S, S.LOCATION)) = PNULL
  -- if $error_missing_operand(S, poperand)
  -- if poperand = VARIABLE n_name* z_operand
