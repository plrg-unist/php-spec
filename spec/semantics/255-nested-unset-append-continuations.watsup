dec $key_unset_null_valid(pstate, pkeyread) : bool
def $key_tail_slot(DEFINED pvalue) = pvalue
def $key_tail_slot(UNDEFINED) = PNULL
def $key_tail_chain(BASE_VALUE (VARIABLE n_name* z)) = (~$this_name(n_name*) /\ n_name* =/= $ptascii("GLOBALS"))
def $key_tail_chain(BASE_DIM pbase poperand z) = $key_tail_chain(pbase)
def $key_tail_chain(pbase) = false -- otherwise
def $key_unset_source(S, porigin, pbase) = true
