  -- if b
  -- if S_out = $unset_final($hold_task_inputs(S), pvalue, S.LOCATION, poperand, z)
def $key_unset_dimension(S, poperand, z, false) = S_out[.HELD = S.HELD][.RESULT = KNOWN PNULL]
  -- if ~$key_write_array_slot($location_slot(S, S.LOCATION))
  -- if $key_tail_slot($location_slot(S, S.LOCATION)) =/= PNULL \/ ~$error_missing_operand(S, poperand)
  -- if pvalue = $key_tail_slot($location_slot(S, S.LOCATION))
