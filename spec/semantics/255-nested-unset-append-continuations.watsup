def $key_writer_valid(S, pkeywriter, ptask*) = true
  -- if $key_append_task(pkeywriter.TASK)
  -- if $key_write_writer(S, pkeywriter.SITE, pkeywriter.TASK, pkeywriter.BASE, pkeywriter.RHS) = (pkeywriter[.TEMP = eps])
