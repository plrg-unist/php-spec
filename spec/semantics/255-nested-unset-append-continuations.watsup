  -- if $key_write_temporary_valid(S, pkeywriter)
def $key_append_context(S, (KEY_WRITE_FINISH pkeywriter) :: ptask_tail*) = $key_append_task(pkeywriter.TASK)
def $key_append_context(S, ptask :: ptask_tail*) = $key_append_context(S, ptask_tail*)
  -- if ~$key_write_finish_task(ptask)
def $key_append_context(S, eps) = false
def $key_append_cut(S, porigin, pbase, porigin) = BASE_PLACE porigin NOWHERE
def $key_append_cut(S, porigin_root, BASE_DIM pbase poperand z, porigin) = BASE_DIM $key_append_cut(S, porigin_child, pbase, porigin) poperand z
  -- if porigin_root =/= porigin
  -- if $origin_child((porigin_root), [PCFIELD 0]) = (porigin_child)
def $key_append_temporary((KEY_WRITE_FINISH pkeywriter) :: ptask_tail*, S, porigin, n) = (KEY_WRITE_FINISH pkeywriter[.BASE = $key_append_cut(S, pkeywriter.TARGET, pkeywriter.BASE, porigin)][.TEMP = ((porigin, n))]) :: ptask_tail*
  -- if $key_append_task(pkeywriter.TASK)
  -- if pkeywriter.TEMP = eps
def $key_append_temporary(ptask :: ptask_tail*, S, porigin, n) = ptask :: $key_append_temporary(ptask_tail*, S, porigin, n)
  -- if ~$key_write_finish_task(ptask)
rule PhpStep/key-append-intermediate-null: S ~> S[.TODO = $key_append_temporary(S.TODO, S, porigin, n)][.STORE = S.STORE ++ [DEFINED PNULL]][.ALLOCATIONS = S.ALLOCATIONS ++ [HCELL n]][.LOCATION = ROOT n][.RESULT = KNOWN PNULL]
  -- if S.TODO = (KEY_WRITE_DIM poperand z b) :: ptask_tail*
  -- if S.LOCATION = NOWHERE
  -- if $key_append_context(S, S.TODO)
  -- if $origin_child(S.ORIGIN, [PCFIELD 0]) = (porigin)
  -- if n = |S.STORE|
rule PhpStep/key-append-final-null: S ~> S[.TODO = $key_append_temporary(S.TODO, S, pkeywriter.TARGET, n)][.STORE = S.STORE ++ [DEFINED PNULL]][.ALLOCATIONS = S.ALLOCATIONS ++ [HCELL n]][.LOCATION = ROOT n][.RESULT = KNOWN PNULL]
  -- if S.TODO = (KEY_WRITE_FINISH pkeywriter) :: ptask_tail*
  -- if $key_append_task(pkeywriter.TASK)
  -- if S.ORIGIN = (pkeywriter.SITE)
  -- if S.LOCATION = NOWHERE
  -- if $key_writer_valid(S, pkeywriter, ptask_tail*)
  -- if n = |S.STORE|
def $key_append_finish(S, pkeywriter) = $error_dispatch(S_array[.RESULT = KNOWN PNULL], 2, $ptascii("Undefined variable $") ++ n_name*, z, WARNING n_name* z, KEY_APPEND_RESULT pappendread)
  -- if pkeywriter.TASK = ASSIGN_ARRAY (BASE_APPEND pbase z_key) z b
  -- if $key_write_array_slot($location_slot(S, S.LOCATION)) \/ $key_write_array_init($location_slot(S, S.LOCATION))
  -- if S_array = $location_array(S, S.LOCATION, z_key)
  -- if S_array.COMPLETION = NORMAL
  -- if S_array.RESULT = KNOWN (PARRAY n)
  -- if $error_missing_operand(S_array, pkeywriter.RHS)
  -- if pkeywriter.RHS = VARIABLE n_name* z_rhs
  -- if pappendread = {WRITER pkeywriter, PLACE S_array.LOCATION, ARRAY n, NAME n_name*, LINE z}
def $key_append_finish(S, pkeywriter) = S_written[.HELD = S.HELD]
  -- if pkeywriter.TASK = ASSIGN_ARRAY (BASE_APPEND pbase z_key) z b
  -- if ~$error_missing_operand(S, pkeywriter.RHS) \/ (~$key_write_array_slot($location_slot(S, S.LOCATION)) /\ ~$key_write_array_init($location_slot(S, S.LOCATION)))
  -- if S_written = $assign_dimension($hold_task_inputs(S), eps, pkeywriter.RHS, z_key, z)
rule PhpStep/key-append-finish: S ~> $key_append_finish(S, pkeywriter)
  -- if S.TODO = (KEY_WRITE_FINISH pkeywriter) :: ptask_tail*
  -- if $key_append_task(pkeywriter.TASK)
  -- if S.ORIGIN = (pkeywriter.SITE)
  -- if S.LOCATION =/= NOWHERE
  -- if $key_writer_valid(S, pkeywriter, ptask_tail*)
def $task_nodes(KEY_APPEND_RESULT pappendread) = $key_write_finish_roots(pappendread.WRITER) ++ [HARRAY pappendread.ARRAY]
def $key_append_live(S, pappendread) = $($heap_owners($heap_prune($heap_graph(S)), HARRAY pappendread.ARRAY) > 1)
def $key_append_insert(S, pappendread) = $literal_insert(S, n, eps, PNULL, pappendread.LINE)
  -- if $location_slot(S, pappendread.PLACE) = DEFINED (PARRAY n)
def $key_append_resume(S, pappendread) = S[.TODO = ptask_tail*][.RESULT = KNOWN PNULL]
  -- if S.TODO = (KEY_APPEND_RESULT pappendread) :: ptask_tail*
  -- if ~$key_append_live(S, pappendread)
def $key_append_resume(S, pappendread) = S_out[.TODO = ptask_tail*][.HELD = S.HELD]
  -- if S.TODO = (KEY_APPEND_RESULT pappendread) :: ptask_tail*
  -- if $key_append_live(S, pappendread)
  -- if S_out = $key_append_insert(S[.HELD = S.HELD ++ $key_write_finish_roots(pappendread.WRITER)], pappendread)
rule PhpStep/key-append-rhs-resume: S ~> $key_append_resume(S, pappendread)
  -- if S.TODO = (KEY_APPEND_RESULT pappendread) :: ptask_tail*
  -- if $key_append_valid(S, pappendread)
def $key_append_place(ROOT n) = true
def $key_append_place(ELEMENT n pkey) = true
def $key_append_place(plocation) = false -- otherwise
def $key_append_valid(S, pappendread) = true
  -- if S.ORIGIN = (pappendread.WRITER.SITE)
  -- if $key_append_task(pappendread.WRITER.TASK)
  -- if $key_writer_valid(S, pappendread.WRITER, eps)
  -- if pappendread.WRITER.RHS = VARIABLE pappendread.NAME z_rhs
  -- if pappendread.LINE = $key_write_line(pappendread.WRITER.TASK)
  -- if $key_append_place(pappendread.PLACE)
  -- if (HARRAY pappendread.ARRAY) <- S.ALLOCATIONS
def $key_append_valid(S, pappendread) = false -- otherwise
def $call_task_valid(S, KEY_APPEND_RESULT pappendread) = $key_append_valid(S, pappendread)
def $error_call_valid(S, perrorcall) = true
  -- if perrorcall.RESUME = KEY_APPEND_RESULT pappendread
  -- if $key_append_valid(S, pappendread)
  -- if perrorcall.SITE = pappendread.WRITER.SITE
  -- if perrorcall.LEVEL = 2
  -- if perrorcall.LINE = pappendread.LINE
  -- if perrorcall.MESSAGE = $ptascii("Undefined variable $") ++ pappendread.NAME
  -- if perrorcall.EVENT = WARNING pappendread.NAME pappendread.LINE

;; ASSIGN_DIM UNUSED still inserts null after a missing RHS handler throws,
;; provided the original protected table survived. Key-conversion throws do not.
def $key_append_throw(S, pappendread) = S_written[.RESULT = S.RESULT][.HELD = S.HELD]
  -- if S.COMPLETION = NORMAL
  -- if S.TODO = (THROW_SEARCH n_throwable) :: ptask_tail*
  -- if S_probe = S[.HELD = S.HELD ++ $task_nodes(KEY_APPEND_RESULT pappendread)]
  -- if $key_append_valid(S_probe, pappendread)
  -- if $key_append_live(S_probe, pappendread)
  -- if S_written = $key_append_insert(S_probe, pappendread)
def $key_append_throw(S, pappendread) = S -- otherwise
def $error_read_discard(S, KEY_APPEND_RESULT pappendread) = $key_append_throw(S, pappendread)
