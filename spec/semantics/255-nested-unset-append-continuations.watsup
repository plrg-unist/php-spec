  -- if pkeyread = {SITE porigin, GLOBAL false, MODE $key_unset_null_mode(b), INPUT poperand, VALUE PNULL, BASE PNULL, OWNERS BASE_VALUE (KNOWN PNULL), LINE z, PHASE KEY_CV, KEY KSTRING eps, NAME n_name*}
def $key_unset_dimension(S, poperand, z, b) = S_out[.HELD = S.HELD][.RESULT = KNOWN PNULL]
  -- if ~$key_write_array_slot($location_slot(S, S.LOCATION))
  -- if $key_tail_slot($location_slot(S, S.LOCATION)) =/= PNULL \/ ~$error_missing_operand(S, poperand)
