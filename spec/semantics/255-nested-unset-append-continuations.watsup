;; Nested UNSET uses BP_VAR_UNSET for its prefix, not the final UNSET_DIM
;; conversion. Delayed dimension fetches run after the key expressions.
dec $key_tail_chain(pbase) : bool
dec $key_tail_slot(pslot) : pvalue
dec $key_unset_nested_context(pstate, porigin, pbase, porigin) : bool
dec $key_unset_fetch_context(pstate, ptask*, porigin) : bool
dec $key_unset_fetch_done(pstate, plocation) : pstate
dec $key_unset_dimension(pstate, poperand, int, bool) : pstate
