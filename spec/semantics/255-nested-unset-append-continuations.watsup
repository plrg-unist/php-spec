  -- if $key_write_base_source(S, porigin, pbase)
def $key_unset_nested_context(S, porigin_root, pbase, porigin) = true
  -- if $key_unset_source(S, porigin_root, pbase)
  -- if $key_write_site(S, porigin_root, false, porigin, false)
def $key_unset_nested_context(S, porigin_root, pbase, porigin) = false -- otherwise
def $key_unset_pending(S) = true
  -- if $error_handler_eligible(S, 2) \/ $error_handler_eligible(S, 8192) \/ $access_unset_walk(S)
  -- if S.TODO = UNSET_ARRAY :: ptask_tail*
  -- if S.ORIGIN = (porigin)
  -- if ~$key_edit_direct_base(S.BASE)
  -- if $key_unset_source(S, porigin, S.BASE)
  -- if $key_write_root(S, S.BASE)
def $key_unset_begin(S) = S[.TODO = [KEY_UNSET_BASE S.BASE true, KEY_UNSET_FINISH porigin S.BASE] ++ ptask_tail*][.BASE = BASE_VALUE (KNOWN PNULL)][.RESULT = KNOWN PNULL]
  -- if S.TODO = UNSET_ARRAY :: ptask_tail*
  -- if S.ORIGIN = (porigin)
  -- if ~$key_edit_direct_base(S.BASE)
rule PhpStep/key-unset-walk: S ~> S[.TODO = [$at_task($origin_child(S.ORIGIN, [PCFIELD 0]), KEY_UNSET_BASE pbase false), KEY_UNSET_DIM poperand z b] ++ ptask_tail*]
  -- if S.TODO = (KEY_UNSET_BASE (BASE_DIM pbase poperand z) b) :: ptask_tail*
rule PhpStep/key-unset-cv: S ~> S_found[.TODO = ptask_tail*][.RESULT = KNOWN PNULL]
  -- if S.TODO = (KEY_UNSET_BASE (BASE_VALUE (VARIABLE n_name* z)) b) :: ptask_tail*
  -- if S_found = $find_name(S, n_name*, z, false)
def $task_nodes(KEY_UNSET_BASE pbase b) = eps
def $task_nodes(KEY_UNSET_DIM poperand z b) = eps
def $key_unset_fetch_done(S, plocation) = $access_fetch_release(S_out, plocation)
  -- if S.TODO = ptask :: ptask_tail*
  -- if S_out = S[.TODO = ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)][.LOCATION = plocation]
def $key_unset_dimension(S, poperand, z, b) = $key_unset_dispatch(S_array, pkeyread)
