;; Append's prefix fetches follow the computed RHS. Simple RHS CVs remain
;; delayed until the final ASSIGN_DIM, even when a prefix fetch returned null.
dec $key_append_cut(pstate, porigin, pbase, porigin) : pbase
dec $key_append_temporary(ptask*, pstate, porigin, nat) : ptask*
dec $key_append_finish(pstate, pkeywriter) : pstate
dec $key_append_place(plocation) : bool
dec $key_append_valid(pstate, pappendread) : bool
dec $key_append_live(pstate, pappendread) : bool
dec $key_append_insert(pstate, pappendread) : pstate
dec $key_append_resume(pstate, pappendread) : pstate
dec $key_append_throw(pstate, pappendread) : pstate
def $key_append_expression(NExprArrayDimFetch expression ABSENT metadata) = true
def $key_append_expression(expression) = false -- otherwise
def $key_append_task(ASSIGN_ARRAY (BASE_APPEND pbase z_key) z b) = true
def $key_append_task(ptask) = false -- otherwise
def $key_write_writer(S, porigin, ASSIGN_ARRAY (BASE_APPEND pbase_original z_key) z b, pbase, poperand) = ({SITE porigin, TARGET porigin_prefix, TASK ASSIGN_ARRAY (BASE_APPEND pbase_original z_key) z b, BASE pbase, RHS poperand, TEMP eps})
  -- if $origin_node(S.SOURCES, porigin) = (NExprAssign expression_target expression_rhs metadata)
  -- if b = $assignment_self(expression_target, expression_rhs)
  -- if $origin_child((porigin), [PCFIELD 0]) = (porigin_target)
  -- if $origin_node(S.SOURCES, porigin_target) = (NExprArrayDimFetch expression_base ABSENT metadata_dim)
  -- if $code_expression_at_source(S, porigin_target, eps) = (z)
  -- if $code_expression_at_source(S, porigin_target, [PCFIELD 0]) = (z_key)
  -- if $origin_child((porigin_target), [PCFIELD 0]) = (porigin_prefix)
  -- if $key_tail_chain(pbase_original)
  -- if $key_write_base_source(S, porigin_prefix, pbase_original)
  -- if $key_write_base_source(S, porigin_prefix, pbase)
def $key_write_plan(S) = (pkeywriter)
  -- if S.ORIGIN = (porigin)
  -- if S.TODO = (ASSIGN_ARRAY (BASE_APPEND pbase z_key) z b) :: ptask_tail*
  -- if $key_write_root(S, pbase)
