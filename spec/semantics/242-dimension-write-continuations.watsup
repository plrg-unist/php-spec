rule PhpStep/key-write-captured-place: S ~> S[.TODO = ptask_tail*][.LOCATION = plocation][.RESULT = KNOWN PNULL]
  -- if S.TODO = (KEY_WRITE_BASE (BASE_PLACE porigin plocation) b) :: ptask_tail*
  -- if plocation =/= NOWHERE
;; An aborted FETCH_W returns a writable VAR containing null. A following
;; nested fetch owns that unnamed value, while the original row stays borrowed.
def $key_write_temporary_root(eps) = eps
def $key_write_temporary_root(((porigin, n))) = [HCELL n]
def $key_write_add_temporary((KEY_WRITE_FINISH pkeywriter) :: ptask_tail*, porigin, n) = (KEY_WRITE_FINISH pkeywriter[.TEMP = ((porigin, n))]) :: ptask_tail*
  -- if pkeywriter.TEMP = eps
def $key_write_add_temporary(ptask :: ptask_tail*, porigin, n) = ptask :: $key_write_add_temporary(ptask_tail*, porigin, n)
  -- if ~$key_write_finish_task(ptask)
rule PhpStep/key-write-null-temporary: S ~> S[.TODO = $key_write_add_temporary(ptask_tail*, porigin, n)][.STORE = S.STORE ++ [DEFINED PNULL]][.ALLOCATIONS = S.ALLOCATIONS ++ [HCELL n]][.LOCATION = ROOT n][.RESULT = KNOWN PNULL]
  -- if S.TODO = (KEY_WRITE_BASE (BASE_PLACE porigin NOWHERE) b) :: ptask_tail*
  -- if n = |S.STORE|
rule PhpStep/key-write-global-base: S ~> S[.TODO = (KEY_WRITE_GLOBAL poperand z) :: ptask_tail*]
  -- if S.TODO = (KEY_WRITE_BASE (BASE_GLOBAL poperand z) false) :: ptask_tail*

def $key_write_dimension(S, poperand, z, b_rw) = $key_write_dispatch(S_array[.RESULT = KNOWN PNULL], pkeywrite)
  -- if S.ORIGIN = (porigin)
  -- if $location_slot(S, S.LOCATION) = DEFINED (PARRAY n_old)
