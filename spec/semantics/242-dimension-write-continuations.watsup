  -- if S_ready = S -- if ~$key_write_self(ptask)
  -- if $key_write_plan(S_ready) = (pkeywriter)
def $key_write_begin(S) = S_ready[.TODO = [$at_task((pkeywriter.TARGET), KEY_WRITE_BASE pkeywriter.BASE $key_write_mode(pkeywriter.TASK, ptask_tail*)), KEY_WRITE_FINISH pkeywriter] ++ ptask_tail*][.BASE = BASE_VALUE (KNOWN PNULL)][.RESULT = KNOWN PNULL]
