  -- if $key_write_plan(S_ready) = (pkeywriter)
rule PhpStep/key-write-start: S ~> $key_write_begin(S)
  -- if $key_write_pending(S)

;; The finish carrier owns each original operand once. Captured table pointers
;; and INDIRECT places never add roots, including a retired parent array row.
def $base_nodes(BASE_PLACE porigin plocation) = eps
def $base_acquire(S, BASE_PLACE porigin plocation, z) = S[.LOCATION = plocation]
def $rw_base(S, BASE_PLACE porigin plocation, pstringfetch, z) = S[.LOCATION = plocation]
def $key_write_finish_roots(pkeywriter) = $base_nodes(pkeywriter.BASE) ++ $key_write_temporary_root(pkeywriter.TEMP)
  -- if pkeywriter.TASK = DIM_PATH pbase z
def $key_write_finish_roots(pkeywriter) = $base_nodes(pkeywriter.BASE) ++ $operand_nodes(pkeywriter.RHS) ++ $key_write_temporary_root(pkeywriter.TEMP)
  -- if ~$key_write_path_task(pkeywriter.TASK)
  -- if ~$key_write_named_task(pkeywriter.TASK)
def $key_write_finish_roots(pkeywriter) = $task_nodes(pkeywriter.TASK) ++ $base_nodes(pkeywriter.BASE) ++ $key_write_temporary_root(pkeywriter.TEMP)
  -- if $key_write_named_task(pkeywriter.TASK)
def $task_nodes(KEY_WRITE_BASE pbase b) = eps
def $task_nodes(KEY_WRITE_DIM poperand z b) = eps
def $task_nodes(KEY_WRITE_GLOBAL poperand z) = eps
def $task_nodes(KEY_WRITE_FINISH pkeywriter) = $key_write_finish_roots(pkeywriter)
def $task_nodes(KEY_WRITE_RESULT pkeywrite) = $value_nodes(pkeywrite.READ.BASE)
  -- if ~pkeywrite.READ.GLOBAL
def $task_nodes(KEY_WRITE_RESULT pkeywrite) = eps -- if pkeywrite.READ.GLOBAL

def $key_write_done(S, plocation) = S[.TODO = ptask_tail*][.LOCATION = plocation][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = ptask :: ptask_tail*
rule PhpStep/key-write-derived-base: S ~> S[.TODO = [$at_task($origin_child(S.ORIGIN, [PCFIELD 0]), KEY_WRITE_BASE pbase b), KEY_WRITE_DIM poperand z b] ++ ptask_tail*]
  -- if S.TODO = (KEY_WRITE_BASE (BASE_DIM pbase poperand z) b) :: ptask_tail*
rule PhpStep/key-write-cv-base: S ~> S_place[.TODO = ptask_tail*][.RESULT = KNOWN PNULL]
  -- if S.TODO = (KEY_WRITE_BASE (BASE_VALUE (VARIABLE n_name* z)) b) :: ptask_tail*
