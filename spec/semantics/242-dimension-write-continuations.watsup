  -- if pkeywrite = {READ {SITE porigin, GLOBAL false, MODE KEY_R, INPUT poperand, VALUE pvalue, BASE PARRAY n, OWNERS BASE_VALUE (KNOWN PNULL), LINE z, PHASE KEY_NULL, KEY KSTRING eps, NAME eps}, PLACE S.LOCATION, RW b_rw}
def $key_write_dimension(S, poperand, z, b_rw) = $key_write_done(S_place, S_place.LOCATION)
