;; Receives run in parameter order after all argument expressions and binding.
;; By-reference aliases may change earlier parameters, so no value history is kept.
def $typed_parameters(eps) = false
def $typed_parameters(psparam :: psparam_tail*) = (psparam.TYPE =/= eps \/ $typed_parameters(psparam_tail*))
dec $typed_caller_strict(pstate) : bool
def $typed_caller_strict(S) = pfunction.CODE.STRICT
  -- if S.FRAMES = pframe :: pframe_tail*
  -- if pframe.CONTEXT = (pcallcontext)
  -- if $function_at($all_functions(S), pcallcontext.FUNCTION) = (pfunction)
def $typed_caller_strict(S) = pcode.STRICT
  -- if S.FRAMES = pframe :: pframe_tail*
  -- if pframe.CONTEXT = eps
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.CALLSITE = (PORIGIN n pcpath)
  -- if $code_at(S.CODE, n) = (pcode)

dec $typed_parameter_value(pstate, pfunction, nat, pvalue) : pstate
;; A cell constrained by a typed property cannot be converted while binding a
;; by-reference parameter. Value parameters and ordinary reference cells retain
;; the caller's usual scalar conversion rules.
dec $typed_reference_cell_source(pstate, nat) : bool
def $typed_reference_cell_source(S, n_cell) = true
  -- if $propref_at(S.PROPREFS, n_cell) = (ppropref)
def $typed_reference_cell_source(S, n_cell) = false -- otherwise
dec $typed_reference_operand_source(pstate, poperand) : bool
def $typed_reference_operand_source(S, REFERENCE n_cell) = $typed_reference_cell_source(S, n_cell)
def $typed_reference_operand_source(S, poperand) = false -- otherwise
dec $typed_reference_name_source(pstate, nat*) : bool
def $typed_reference_name_source(S, n_name*) = $typed_reference_cell_source(S, n_cell)
  -- if $lookup(S.ENV, n_name*) = (n_cell)
def $typed_reference_name_source(S, n_name*) = false -- otherwise
dec $typed_reference_location_source(pstate, plocation) : bool
def $typed_reference_location_source(S, ROOT n_cell) = $typed_reference_cell_source(S, n_cell)
def $typed_reference_location_source(S, ELEMENT n_array pkey) = $typed_reference_cell_source(S, n_cell)
  -- if $entry_lookup(S.ARRAYS[n_array].ITEMS, pkey) = (ALIAS n_cell)
def $typed_reference_location_source(S, PROPERTY n_object ptbytes) = $typed_reference_cell_source(S, n_cell)
  -- if $objectprops_record_at(S.OBJECTPROPS, n_object) = (pobjectprops)
  -- if $property_slot_at(pobjectprops.SLOTS, ptbytes) = (ppropertyslot)
  -- if ppropertyslot.STATE = PROP_VALUE (ALIAS n_cell)
def $typed_reference_location_source(S, PROPERTY n_object ptbytes) = true
  -- if S.OBJECTS[n_object] = INSTANCE porigin_class
  -- if $property_desc_at($property_layout(S, porigin_class, |S.CLASSES|), ptbytes) = (ppropertydesc)
  -- if ppropertydesc.TYPE =/= eps
def $typed_reference_location_source(S, plocation) = false -- otherwise
dec $typed_reference_conversion(pstate, ptbranch*, pvalue, bool, bool) : ptypeconversion
dec $typed_reference_allowed(ptypeconversion, pvalue) : bool
def $typed_reference_allowed(TYPEVALUE pvalue, pvalue) = true
def $typed_reference_allowed(TYPEDEPENDENT text, pvalue) = true
def $typed_reference_allowed(ptypeconversion, pvalue) = false -- otherwise
def $typed_reference_conversion(S, ptbranch*, pvalue, b_strict, true) = ptypeconversion
  -- if ptypeconversion = $typed_conversion_at(S, ptbranch*, pvalue, b_strict)
  -- if $typed_reference_allowed(ptypeconversion, pvalue)
def $typed_reference_conversion(S, ptbranch*, pvalue, b_strict, true) = TYPEREJECT
  -- if ptypeconversion = $typed_conversion_at(S, ptbranch*, pvalue, b_strict)
  -- if ~$typed_reference_allowed(ptypeconversion, pvalue)
def $typed_reference_conversion(S, ptbranch*, pvalue, b_strict, false) = $typed_conversion_at(S, ptbranch*, pvalue, b_strict)
dec $typed_parameter_source(pstate, psparam) : bool
def $typed_parameter_source(S, psparam) = $typed_reference_name_source(S, psparam.NAME)
  -- if psparam.BYREF
def $typed_parameter_source(S, psparam) = false -- otherwise
dec $typed_parameter_conversion(pstate, psparam, pvalue) : ptypeconversion
def $typed_parameter_conversion(S, psparam, pvalue) = $typed_reference_conversion(S, psparam.TYPE, pvalue, $typed_caller_strict(S), $typed_parameter_source(S, psparam))
def $typed_parameter_value(S, pfunction, n, pvalue) = $typed_apply(S, ptypeconversion, $default_parameter_line(S, pfunction.ORIGIN, n))
  -- if ptypeconversion = $typed_parameter_conversion(S, pfunction.SIGNATURE.PARAMETERS[n], pvalue)
  -- if ptypeconversion =/= TYPEREJECT
def $typed_parameter_value(S, pfunction, n, pvalue) = $throw_scalar(S, "TypeError", pfunction.NAME ++ $ptascii("(): Argument #") ++ $ntunsigned($(n + 1)) ++ $ptascii(" ($") ++ psparam.NAME ++ $ptascii(") must be of type ") ++ $pttypename(psparam.TYPE) ++ $ptascii(", ") ++ $typed_given(S, pvalue) ++ $ptascii(" given, called in ") ++ $call_sourcefile(S.FILES, porigin) ++ $ptascii(" on line ") ++ $decimal_integer(pcallcontext.LINE), $default_parameter_line(S, pfunction.ORIGIN, n))
  -- if psparam = pfunction.SIGNATURE.PARAMETERS[n]
  -- if $typed_parameter_conversion(S, psparam, pvalue) = TYPEREJECT
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.CALLSITE = (porigin)

def $typed_default_store(S, pfunction, n, pvalue) = $default_store(S_value, pfunction, n, pvalue_new)
  -- if S_value = $typed_parameter_value(S, pfunction, n, pvalue)
  -- if S_value.COMPLETION = NORMAL
  -- if S_value.RESULT = KNOWN pvalue_new
def $typed_default_store(S, pfunction, n, pvalue) = S_value
  -- if S_value = $typed_parameter_value(S, pfunction, n, pvalue)
  -- if S_value.COMPLETION =/= NORMAL
def $typed_stored_default(PSDEFAULT phpType5 "float", PINT i) = PFLOAT $float_of_int(i)
def $typed_stored_default(psdefault, pvalue) = pvalue -- otherwise

rule PhpStep/type-receive-supplied: S ~> $typed_default_store(S, pfunction, n, pvalue)
  -- if S.TODO = (TYPE_RECEIVE porigin n) :: ptask_tail*
  -- if ptask_tail* = eps
  -- if S.CURRENT = (pcallcontext)
  -- if $(n < pcallcontext.ARGC)
  -- if $function_at($all_functions(S), porigin) = (pfunction)
  -- if $(n < |$call_fixed_parameters(pfunction.SIGNATURE.PARAMETERS)|)
  -- if $lookup(S.ENV, pfunction.SIGNATURE.PARAMETERS[n].NAME) = (n_cell)
  -- if S.STORE[n_cell] = DEFINED pvalue
rule PhpStep/type-receive-missing: S ~> $default_begin(S, pfunction, n)
  -- if S.TODO = (TYPE_RECEIVE porigin n) :: ptask_tail*
  -- if ptask_tail* = eps
  -- if S.CURRENT = (pcallcontext)
  -- if $(n >= pcallcontext.ARGC)
  -- if $function_at($all_functions(S), porigin) = (pfunction)
  -- if $(n < |$call_fixed_parameters(pfunction.SIGNATURE.PARAMETERS)|)

;; Value returns resolve their source operand but never write coercions back to it.
def $typed_fallthrough(pfunction) = RETURN_NULL -- if pfunction.SIGNATURE.RETURNS = eps /\ ~pfunction.SIGNATURE.BYREF
def $typed_fallthrough(pfunction) = RETURN_REF_NULL pfunction.ENDLINE -- if pfunction.SIGNATURE.RETURNS = eps /\ pfunction.SIGNATURE.BYREF
def $typed_fallthrough(pfunction) = TYPE_FALLTHROUGH pfunction.ORIGIN -- if pfunction.SIGNATURE.RETURNS =/= eps
def $typed_return_line(S, z) = z_return
  -- if S.CURRENT = (pcallcontext)
  -- if $function_at($all_functions(S), pcallcontext.FUNCTION) = (pfunction)
  -- if pfunction.SIGNATURE.RETURNS =/= eps \/ pfunction.SIGNATURE.BYREF
  -- if S.ORIGIN = (PORIGIN n pcpath)
  -- if n = pfunction.CODE.UNIT
  -- if $code_expression(pfunction.CODE.EXPRESSIONS, pcpath) = ((z_return, false))
def $typed_return_line(S, z) = z -- otherwise

dec $typed_return_check(pstate, int) : pstate
dec $typed_return_checked(pstate, int, bool) : pstate
def $typed_return_value(S, z) = $typed_return_check($resolve_at(S, S.RESULT, z), z)
def $typed_return_check(S, z) = $typed_return_checked(S, z, false)
def $typed_return_checked(S, z, b_source) = S -- if S.COMPLETION =/= NORMAL
def $typed_return_checked(S, z, b_source) = S -- if S.COMPLETION = NORMAL /\ S.CURRENT = eps
def $typed_return_checked(S, z, b_source) = $typed_apply(S, ptypeconversion, z)
  -- if S.COMPLETION = NORMAL
  -- if S.CURRENT = (pcallcontext)
  -- if $function_at($all_functions(S), pcallcontext.FUNCTION) = (pfunction)
  -- if S.RESULT = KNOWN pvalue
  -- if ptypeconversion = $typed_reference_conversion(S, pfunction.SIGNATURE.RETURNS, pvalue, pfunction.CODE.STRICT, b_source)
  -- if ptypeconversion =/= TYPEREJECT
def $typed_return_checked(S, z, b_source) = $throw_scalar(S, "TypeError", pfunction.NAME ++ $ptascii("(): Return value must be of type ") ++ $pttypename(pfunction.SIGNATURE.RETURNS) ++ $ptascii(", ") ++ $typed_given(S, pvalue) ++ $ptascii(" returned"), z)
  -- if S.COMPLETION = NORMAL
  -- if S.CURRENT = (pcallcontext)
  -- if $function_at($all_functions(S), pcallcontext.FUNCTION) = (pfunction)
  -- if S.RESULT = KNOWN pvalue
  -- if $typed_reference_conversion(S, pfunction.SIGNATURE.RETURNS, pvalue, pfunction.CODE.STRICT, b_source) = TYPEREJECT
rule PhpStep/type-fallthrough-void: S ~> S[.TODO = $reference_empty_task(S, pfunction.ENDLINE) :: ptask*]
  -- if S.TODO = (TYPE_FALLTHROUGH porigin) :: ptask*
  -- if $function_at($all_functions(S), porigin) = (pfunction)
  -- if "void" <- $ptmasks(pfunction.SIGNATURE.RETURNS)
rule PhpStep/type-fallthrough-never: S ~> $throw_scalar(S, "TypeError", pfunction.NAME ++ $ptascii("(): never-returning function must not implicitly return"), pfunction.ENDLINE)
  -- if S.TODO = (TYPE_FALLTHROUGH porigin) :: ptask*
  -- if $function_at($all_functions(S), porigin) = (pfunction)
  -- if "never" <- $ptmasks(pfunction.SIGNATURE.RETURNS)
rule PhpStep/type-fallthrough-value: S ~> $throw_scalar(S, "TypeError", pfunction.NAME ++ $ptascii("(): Return value must be of type ") ++ $pttypename(pfunction.SIGNATURE.RETURNS) ++ $ptascii(", none returned"), pfunction.ENDLINE)
  -- if S.TODO = (TYPE_FALLTHROUGH porigin) :: ptask*
  -- if $function_at($all_functions(S), porigin) = (pfunction)
  -- if ~("void" <- $ptmasks(pfunction.SIGNATURE.RETURNS) \/ "never" <- $ptmasks(pfunction.SIGNATURE.RETURNS))

;; Source-bound stages constrain metadata, not the values already received.
dec $named_receives_ready(pstate, pfunction) : bool
dec $typed_receive_valid(pstate, porigin, nat) : bool
def $typed_receive_valid(S, porigin, n) = true
  -- if S.TODO = (TYPE_RECEIVE porigin n) :: ptask*
  -- if ptask* = eps
  -- if S.CONSTCONTEXT = eps
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.FUNCTION = porigin
  -- if S.ORIGIN = (porigin)
  -- if $function_at($all_functions(S), porigin) = (pfunction)
  -- if $typed_parameters($call_fixed_parameters(pfunction.SIGNATURE.PARAMETERS))
  -- if $(n < |$call_fixed_parameters(pfunction.SIGNATURE.PARAMETERS)|)
  -- if $default_received_slots(S, pfunction.SIGNATURE.PARAMETERS, n)
  -- if $named_receives_ready(S, pfunction)
def $typed_receive_valid(S, porigin, n) = false -- otherwise

dec $typed_fallthrough_valid(pstate, porigin) : bool
def $typed_fallthrough_valid(S, porigin) = true
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.FUNCTION = porigin
  -- if $function_at($all_functions(S), porigin) = (pfunction)
  -- if pfunction.SIGNATURE.RETURNS =/= eps
def $typed_fallthrough_valid(S, porigin) = false -- otherwise

dec $arrow_context(pstate) : bool
dec $typed_return_task_valid(pstate, int) : bool
def $typed_return_task_valid(S, z) = true
  -- if S.CURRENT = eps
def $typed_return_task_valid(S, z) = true
  -- if S.CURRENT = (pcallcontext)
  -- if $function_at($all_functions(S), pcallcontext.FUNCTION) = (pfunction)
  -- if pfunction.SIGNATURE.RETURNS = eps
  -- if ~pfunction.SIGNATURE.BYREF
  -- if ~$arrow_context(S)
def $typed_return_task_valid(S, z) = true
  -- if S.CURRENT = (pcallcontext)
  -- if $function_at($all_functions(S), pcallcontext.FUNCTION) = (pfunction)
  -- if pfunction.SIGNATURE.RETURNS =/= eps
  -- if ~pfunction.SIGNATURE.BYREF
  -- if S.ORIGIN = (PORIGIN n pcpath)
  -- if n = pfunction.CODE.UNIT
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (NStmtReturn expression metadata)
  -- if $code_expression(pfunction.CODE.EXPRESSIONS, pcpath) = ((z, false))
def $typed_return_task_valid(S, z) = false -- otherwise

def $call_task_valid(S, TYPE_RECEIVE porigin n) = $typed_receive_valid(S, porigin, n)
def $call_task_valid(S, TYPE_FALLTHROUGH porigin) = $typed_fallthrough_valid(S, porigin)
def $call_task_valid(S, RETURN_VALUE z) = $typed_return_task_valid(S, z)

;; The unit projection retains each actual return instruction as well as the
;; function-owned copy used for return verification.
dec $typed_return_node(pcnode) : bool
def $typed_return_node(NStmtReturn phpType5 metadata) = true
def $typed_return_node(pcnode) = false -- otherwise
dec $typed_return_root(pcoccurrence*, pcpath) : bool
def $typed_return_root(eps, pcpath) = false
def $typed_return_root((PCOCCURRENCE pcpath_other pcnode) :: pcoccurrence*, pcpath) = ((pcpath_other = pcpath /\ $typed_return_node(pcnode)) \/ $typed_return_root(pcoccurrence*, pcpath))

dec $typed_return_entry(pcoccurrence*, pcodeexpr) : pcodeexpr*
def $typed_return_entry(pcoccurrence*, CODEEXPR pcpath z b) = [CODEEXPR pcpath z b]
  -- if $typed_return_root(pcoccurrence*, pcpath)
def $typed_return_entry(pcoccurrence*, CODEEXPR pcpath z b) = eps
  -- if ~$typed_return_root(pcoccurrence*, pcpath)
def $typed_return_entry(pcoccurrence*, CODEARG pcpath) = eps
def $typed_return_entry(pcoccurrence*, CODEWRITE pcpath z) = eps
def $typed_return_entry(pcoccurrence*, CODEEFFECT pcpath) = eps
dec $typed_return_code(pcoccurrence*, pcodeexpr*) : pcodeexpr*
def $typed_return_code(pcoccurrence*, eps) = eps
def $typed_return_code(pcoccurrence*, pcodeexpr :: pcodeexpr_tail*) = $typed_return_entry(pcoccurrence*, pcodeexpr) ++ $typed_return_code(pcoccurrence*, pcodeexpr_tail*)

def $typed_unit_code_valid(P, pcode) = ($typed_return_code(P.FOLD.SOURCE.OCCURRENCES, pcode.EXPRESSIONS) = $typed_return_code(P.FOLD.SOURCE.OCCURRENCES, $compiled_operands(P, P.EXPRESSIONS)))
