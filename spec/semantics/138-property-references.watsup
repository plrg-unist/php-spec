rule PhpStep/property-reference-acquire: S ~> S[.TODO = [DIM_PREP (NExprPropertyFetch expression phpType20 metadata), PROPERTY_REF_FETCH $runtime_line(S, eps, NExprPropertyFetch expression phpType20 metadata)] ++ ptask_tail*]
