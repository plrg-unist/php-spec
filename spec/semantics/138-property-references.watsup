dec $property_ref_name_matches(phpType20, ptbytes) : bool
def $property_ref_name_matches(NIdentifier (BYTES text) metadata_name, ptbytes) = (ptbytes = $base64(text))
def $property_ref_name_matches(phpType20, ptbytes) = true
