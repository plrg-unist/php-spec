def $property_ref_base_task(S, pbase, z) = false -- otherwise
dec $property_ref_rhs_cv(pstate, nat*) : bool
def $property_ref_rhs_cv(S, n_name*) = true
  -- if S.ORIGIN = (PORIGIN n pcpath)
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (NExprAssignRef expression_target expression_rhs metadata)
  -- if $reference_cv(expression_rhs) = (n_name*)
def $property_ref_rhs_cv(S, n_name*) = false -- otherwise
dec $property_ref_rhs_noncv(pstate) : bool
def $property_ref_rhs_noncv(S) = true
  -- if S.ORIGIN = (PORIGIN n pcpath)
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (NExprAssignRef expression_target expression_rhs metadata)
  -- if $reference_cv(expression_rhs) = eps
def $property_ref_rhs_noncv(S) = false -- otherwise
dec $property_ref_fetch_task(pstate, int) : bool
dec $property_ref_demand(pstate) : bool
dec $property_ref_property_base(pbase) : bool
def $property_ref_property_base(BASE_PROPERTY pvalue ptbytes) = true
def $property_ref_property_base(pbase) = false -- otherwise
dec $property_ref_fetch_result_valid(pstate, phpType20) : bool
def $property_ref_demand(S) = true
  -- if S.ORIGIN = (PORIGIN n pcpath)
  -- if $(|pcpath| > 0)
  -- if n_parent = $(|pcpath| - 1)
  -- if pcpath[n_parent:1] = [PCFIELD 1]
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath[0:n_parent]) = (NExprAssignRef expression_target expression_rhs metadata)
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (expression_rhs)
def $property_ref_demand(S) = true
  -- if S.ORIGIN = (PORIGIN n pcpath)
  -- if $(|pcpath| > 0)
  -- if n_parent = $(|pcpath| - 1)
  -- if pcpath[n_parent:1] = [PCFIELD 1]
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath[0:n_parent]) = (NArrayItem phpType5 expression_rhs (BOOLEAN true) (BOOLEAN false) metadata)
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (expression_rhs)
def $property_ref_demand(S) = true
  -- if S.ORIGIN = (PORIGIN n pcpath)
  -- if $(|pcpath| > 0)
  -- if n_parent = $(|pcpath| - 1)
  -- if pcpath[n_parent:1] = [PCFIELD 1]
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath[0:n_parent]) = (NExprAssign expression_pattern expression_rhs metadata)
  -- if $list_pattern(expression_pattern) = (phpType13*)
  -- if $list_references(phpType13*)
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (expression_rhs)
def $property_ref_demand(S) = false -- otherwise
def $property_ref_fetch_result_valid(S, phpType20) = $property_ref_name_matches(phpType20, ptbytes)
  -- if S.TODO = (PROPERTY_REF_FETCH z) :: ptask_tail*
  -- if S.BASE = BASE_PROPERTY pvalue ptbytes
def $property_ref_fetch_result_valid(S, phpType20) = false
  -- if S.TODO = (PROPERTY_REF_FETCH z) :: ptask_tail*
  -- if ~$property_ref_property_base(S.BASE)
def $property_ref_fetch_result_valid(S, phpType20) = true -- otherwise
def $property_ref_fetch_task(S, z) = true
  -- if S.ORIGIN = (PORIGIN n pcpath)
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (NExprPropertyFetch expression_receiver phpType20 metadata_property)
  -- if $property_ref_fetch_result_valid(S, phpType20)
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_expression(pcode.EXPRESSIONS, pcpath) = ((z_code, b))
  -- if z = $runtime_line(S, eps, NExprPropertyFetch expression_receiver phpType20 metadata_property)
  -- if $property_ref_demand(S)
def $property_ref_fetch_task(S, z) = false -- otherwise
def $call_task_valid(S, EVAL (NExprAssignRef (NExprPropertyFetch expression_receiver phpType20 metadata_property) expression_rhs metadata)) = $property_source_task(S, NExprAssignRef (NExprPropertyFetch expression_receiver phpType20 metadata_property) expression_rhs metadata)
def $call_task_valid(S, ACQUIRE (NExprPropertyFetch expression_receiver phpType20 metadata_property)) = ($property_source_task(S, NExprPropertyFetch expression_receiver phpType20 metadata_property) /\ $property_ref_demand(S))
def $call_task_valid(S, PROPERTY_REF_PREP expression_rhs z) = $property_ref_assignment_task(S, expression_rhs, z)
def $call_task_valid(S, PROPERTY_REF_CAPTURE pbase z) = ($property_ref_base_task(S, pbase, z) /\ $property_ref_rhs_noncv(S))
def $call_task_valid(S, PROPERTY_REF_BIND pbase n_cell z) = ($property_ref_base_task(S, pbase, z) /\ $property_ref_rhs_noncv(S) /\ (HCELL n_cell) <- S.ALLOCATIONS /\ n_cell <- S.REFCELLS)
def $call_task_valid(S, PROPERTY_REF_BIND_CV pbase n_name* z) = ($property_ref_base_task(S, pbase, z) /\ $property_ref_rhs_cv(S, n_name*))
def $call_task_valid(S, PROPERTY_REF_FETCH z) = $property_ref_fetch_task(S, z)

def $property_reference_fetch(S, n_object, ptbytes, z) = $reference_cell(S, n_cell)[.CELL = n_cell][.RESULT = REFERENCE n_cell]
