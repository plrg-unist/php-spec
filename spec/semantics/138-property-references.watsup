def $property_reference_fetch(S, n_object, ptbytes, z) = S_attached[.OBJECTPROPS = $objectprops_set(S_attached.OBJECTPROPS, n_object, $property_slot_set(pobjectprops.SLOTS, ptbytes, PROP_VALUE (ALIAS n_cell)))][.CELL = n_cell][.RESULT = REFERENCE n_cell]
