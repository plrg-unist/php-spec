  -- if S.ORIGIN = (porigin_site)
  -- if $ptlc($base64(text_class)) = $ptascii("closure")
  -- if $ptlc(n_class*) = $ptascii("closure")
  -- if $ptlc(ptbytes_method) = $ptascii("bind")
  -- if ~$ppfirstclass(phpType7*)
  -- if $bind_args_at(S, porigin_site) = phpType7*

def $task_nodes(BIND_ARGS pbindcall) = $instance_roots(pbindcall.SOURCE) ++ $operands_roots(pbindcall.SENT)
def $task_nodes(BIND_SEND pbindcall) = $instance_roots(pbindcall.SOURCE) ++ $operands_roots(pbindcall.SENT)
def $task_nodes(BIND_INVOKE pbindcall) = $instance_roots(pbindcall.SOURCE) ++ $operands_roots(pbindcall.SENT)

rule PhpStep/bind-argument: S ~> S[.TODO = [$at_task($origin_child((pbindcall.SITE), [PCFIELD 2, PCINDEX pbindcall.INDEX, PCFIELD 1]), EVAL expression), BIND_SEND pbindcall] ++ ptask_tail*]
  -- if S.TODO = (BIND_ARGS pbindcall) :: ptask_tail*
  -- if $bind_args_at(S, pbindcall.SITE) = phpType7*
  -- if $(pbindcall.INDEX < |phpType7*|)
  -- if phpType7*[pbindcall.INDEX] = NArg ABSENT expression (BOOLEAN false) (BOOLEAN false) metadata
rule PhpStep/bind-argument-unsupported: S ~> S[.TODO = eps][.COMPLETION = UNSUPPORTED "Closure::bindTo named or unpacked operand"]
  -- if S.TODO = (BIND_ARGS pbindcall) :: ptask_tail*
  -- if $bind_args_at(S, pbindcall.SITE) = phpType7*
  -- if $(pbindcall.INDEX < |phpType7*|)
  -- if phpType7*[pbindcall.INDEX] = NArg phpType3 expression (BOOLEAN b_ref) (BOOLEAN b_unpack) metadata
  -- if phpType3 =/= ABSENT \/ b_ref \/ b_unpack
rule PhpStep/bind-send: S ~> S_read[.TODO = (BIND_ARGS pbindcall[.INDEX = $(pbindcall.INDEX + 1)][.SENT = pbindcall.SENT ++ [KNOWN pvalue]]) :: ptask_tail*][.RESULT = KNOWN PNULL]
  -- if S.TODO = (BIND_SEND pbindcall) :: ptask_tail*
  -- if S_read = $resolve_at(S, S.RESULT, pbindcall.LINE)
  -- if S_read.COMPLETION = NORMAL
  -- if S_read.RESULT = KNOWN pvalue
rule PhpStep/bind-send-abrupt: S ~> S_read[.TODO = eps]
  -- if S.TODO = (BIND_SEND pbindcall) :: ptask_tail*
  -- if S_read = $resolve_at(S, S.RESULT, pbindcall.LINE)
  -- if S_read.COMPLETION =/= NORMAL
rule PhpStep/bind-arguments-done: S ~> S[.TODO = (BIND_INVOKE pbindcall) :: ptask_tail*]
  -- if S.TODO = (BIND_ARGS pbindcall) :: ptask_tail*
  -- if $bind_args_at(S, pbindcall.SITE) = phpType7*
  -- if pbindcall.INDEX = |phpType7*|
rule PhpStep/bind-invoke: S ~> $bind_result(S, pbindcall)
  -- if S.TODO = (BIND_INVOKE pbindcall) :: ptask_tail*

dec $bind_task_valid(pstate, pbindcall) : bool
dec $bind_simple_variable(expression) : bool
def $bind_simple_variable(NExprVariable (BYTES text) metadata) = true
def $bind_simple_variable(expression) = false -- otherwise
dec $bind_variable_matches(pstate, preqbytes, nat) : bool
def $bind_variable_matches(S, n_name*, n_source) = true
  -- if n_name* = $ptascii("this")
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.RECEIVER = (n_source)
def $bind_variable_matches(S, n_name*, n_source) = true
  -- if n_name* =/= $ptascii("this")
  -- if $lookup(S.ENV, n_name*) = (n_cell)
  -- if S.STORE[n_cell] = DEFINED (POBJECT n_source)
def $bind_variable_matches(S, n_name*, n_source) = false -- otherwise
dec $bind_initial_source_valid(pstate, pbindcall) : bool
def $bind_initial_source_valid(S, pbindcall) = $bind_variable_matches(S, $base64(text), n_source)
  -- if pbindcall.KIND = INSTANCE_BIND
  -- if pbindcall.INDEX = 0
  -- if pbindcall.SOURCE = (n_source)
  -- if $origin_node(S.SOURCES, pbindcall.SITE) = (NExprMethodCall (NExprVariable (BYTES text) metadata_var) phpType20 (SEQUENCE phpType7*) metadata)
def $bind_initial_source_valid(S, pbindcall) = true
  -- if pbindcall.KIND = INSTANCE_BIND
  -- if pbindcall.INDEX = 0
  -- if $origin_node(S.SOURCES, pbindcall.SITE) = (NExprMethodCall expression phpType20 (SEQUENCE phpType7*) metadata)
  -- if ~$bind_simple_variable(expression)
def $bind_initial_source_valid(S, pbindcall) = true
  -- if pbindcall.KIND = INSTANCE_BIND
  -- if $(pbindcall.INDEX > 0)
def $bind_initial_source_valid(S, pbindcall) = $bind_variable_matches(S, $base64(text), n_source)
  -- if pbindcall.KIND = STATIC_BIND
  -- if pbindcall.INDEX = 1
  -- if pbindcall.SENT = [KNOWN (POBJECT n_source)]
  -- if $bind_args_at(S, pbindcall.SITE) = phpType7*
  -- if phpType7*[0] = NArg ABSENT (NExprVariable (BYTES text) metadata_var) (BOOLEAN false) (BOOLEAN false) metadata_arg
def $bind_initial_source_valid(S, pbindcall) = true
  -- if pbindcall.KIND = STATIC_BIND
  -- if pbindcall.INDEX = 1
  -- if $bind_args_at(S, pbindcall.SITE) = phpType7*
  -- if phpType7*[0] = NArg ABSENT expression (BOOLEAN false) (BOOLEAN false) metadata_arg
  -- if ~$bind_simple_variable(expression)
def $bind_initial_source_valid(S, pbindcall) = true
  -- if pbindcall.KIND = STATIC_BIND
  -- if pbindcall.INDEX =/= 1
def $bind_initial_source_valid(S, pbindcall) = false -- otherwise
def $bind_task_valid(S, pbindcall) = true
  -- if pbindcall.KIND = INSTANCE_BIND
  -- if $origin_node(S.SOURCES, pbindcall.SITE) = (NExprMethodCall expression (NIdentifier (BYTES text_name) metadata_name) (SEQUENCE phpType7*) metadata)
  -- if $ptlc($base64(text_name)) = $ptascii("bindto")
  -- if pbindcall.LINE = $runtime_line(S, eps, NExprMethodCall expression (NIdentifier (BYTES text_name) metadata_name) (SEQUENCE phpType7*) metadata)
  -- if pbindcall.SOURCE = (n_source)
  -- if $(n_source < |S.OBJECTS|)
  -- if (HOBJECT n_source) <- S.ALLOCATIONS
  -- if S.OBJECTS[n_source] = REALCLOSURE porigin pitem* pstaticcell*
  -- if $(pbindcall.INDEX <= |phpType7*|)
  -- if |pbindcall.SENT| = pbindcall.INDEX
def $bind_task_valid(S, pbindcall) = true
  -- if pbindcall.KIND = STATIC_BIND
  -- if pbindcall.SOURCE = eps
  -- if $origin_node(S.SOURCES, pbindcall.SITE) = (NExprStaticCall (NName (BYTES text_class) metadata_class) (NIdentifier (BYTES text_name) metadata_name) (SEQUENCE phpType7*) metadata)
  -- if $ptlc($base64(text_class)) = $ptascii("closure")
  -- if $ptlc($base64(text_name)) = $ptascii("bind")
  -- if pbindcall.LINE = $runtime_line(S, eps, NExprStaticCall (NName (BYTES text_class) metadata_class) (NIdentifier (BYTES text_name) metadata_name) (SEQUENCE phpType7*) metadata)
  -- if $(pbindcall.INDEX <= |phpType7*|)
  -- if |pbindcall.SENT| = pbindcall.INDEX
def $bind_task_valid(S, pbindcall) = false -- otherwise
def $call_task_valid(S, BIND_ARGS pbindcall) = ($bind_task_valid(S, pbindcall) /\ $bind_initial_source_valid(S, pbindcall))
def $call_task_valid(S, BIND_SEND pbindcall) = $bind_task_valid(S, pbindcall)
def $call_task_valid(S, BIND_INVOKE pbindcall) = $bind_task_valid(S, pbindcall)
