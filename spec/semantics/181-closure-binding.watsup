def $closure_bindings_valid(S, eps) = true
def $closure_bindings_valid(S, pclosurebinding :: pclosurebinding_tail*) = ($closure_binding_source_valid(S, pclosurebinding) /\ $closure_bindings_valid(S, pclosurebinding_tail*))
