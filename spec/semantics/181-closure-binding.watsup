  -- if n = pclosurebinding.OBJECT
  -- if $(n < |S.OBJECTS|)
  -- if (HOBJECT n) <- S.ALLOCATIONS
  -- if S.OBJECTS[n] = REALCLOSURE porigin pitem* pstaticcell*
  -- if n_source = pclosurebinding.SOURCE
  -- if $(n_source < n)
  -- if S.OBJECTS[n_source] = REALCLOSURE porigin pitem_source* pstaticcell_source*
  -- if $origin_node(S.SOURCES, pclosurebinding.SITE) = (NExprStaticCall (NName (BYTES text_class) metadata_class) (NIdentifier (BYTES text_name) metadata_name) (SEQUENCE phpType7*) metadata)
  -- if $ptlc($base64(text_class)) = $ptascii("closure")
  -- if $ptlc($base64(text_name)) = $ptascii("bind")
  -- if $closure_scope_at(S.CLOSURESCOPES, n) = eps
  -- if $binding_scope_valid(S, pclosurebinding)
def $closure_binding_source_valid(S, pclosurebinding) = false -- otherwise

def $binding_scope_valid(S, pclosurebinding) = true
  -- if pclosurebinding.RECEIVER = (n_receiver)
  -- if $(n_receiver < |S.OBJECTS|)
  -- if (HOBJECT n_receiver) <- S.ALLOCATIONS
