  -- if (HOBJECT n) <- S.ALLOCATIONS
  -- if S.OBJECTS[n] = REALCLOSURE porigin pitem* pstaticcell*
  -- if n_source = pclosurebinding.SOURCE
  -- if $(n_source < n)
  -- if S.OBJECTS[n_source] = REALCLOSURE porigin pitem_source* pstaticcell_source*
  -- if $origin_node(S.SOURCES, pclosurebinding.SITE) = (NExprMethodCall expression (NIdentifier (BYTES text_name) metadata_name) (SEQUENCE phpType7*) metadata)
  -- if $ptlc($base64(text_name)) = $ptascii("bindto")
  -- if $closure_scope_at(S.CLOSURESCOPES, n) = eps
  -- if $binding_scope_valid(S, pclosurebinding)
