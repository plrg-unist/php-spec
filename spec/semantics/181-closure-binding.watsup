;; A bound closure owns copied captures and static cells. This separate record
;; preserves its changed invocation scope without rewriting the source row.
dec $binding_scope_valid(pstate, pclosurebinding) : bool
dec $binding_lexical_valid(pstate, porigin?) : bool
def $closure_binding_at(eps, n) = eps
def $closure_binding_at(pclosurebinding :: pclosurebinding_tail*, n) = (pclosurebinding)
  -- if pclosurebinding.OBJECT = n
def $closure_binding_at(pclosurebinding :: pclosurebinding_tail*, n) = $closure_binding_at(pclosurebinding_tail*, n)
  -- if pclosurebinding.OBJECT =/= n

def $closure_bindings_prune(eps, pnode*) = eps
def $closure_bindings_prune(pclosurebinding :: pclosurebinding_tail*, pnode*) = pclosurebinding :: $closure_bindings_prune(pclosurebinding_tail*, pnode*)
  -- if (HOBJECT pclosurebinding.OBJECT) <- pnode*
def $closure_bindings_prune(pclosurebinding :: pclosurebinding_tail*, pnode*) = $closure_bindings_prune(pclosurebinding_tail*, pnode*)
  -- if ~((HOBJECT pclosurebinding.OBJECT) <- pnode*)

def $binding_receiver_roots(pclosurebinding_all*, n) = [HOBJECT n_receiver]
  -- if $closure_binding_at(pclosurebinding_all*, n) = (pclosurebinding)
  -- if pclosurebinding.RECEIVER = (n_receiver)
