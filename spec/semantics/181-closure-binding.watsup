  -- if $closure_binding_at(pclosurebinding_all*, n) = (pclosurebinding)
  -- if pclosurebinding.RECEIVER = eps
def $binding_receiver_roots(pclosurebinding_all*, n) = eps
  -- if $closure_binding_at(pclosurebinding_all*, n) = eps

dec $closure_binding_source_valid(pstate, pclosurebinding) : bool
def $closure_binding_source_valid(S, pclosurebinding) = true
