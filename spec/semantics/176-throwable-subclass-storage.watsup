  -- if $class_links_valid(S)
  -- if $property_initial_slots(S, $property_layout(S, porigin, |S.CLASSES|)) = eps

def $throwable_member(S, n) = true
  -- if S.OBJECTS[n] = THROWABLE pthrowable
  -- if $throwable_kind(pthrowable.KIND)
def $throwable_member(S, n) = true
  -- if $(n < |S.OBJECTS|)
