def $scoped_internal_method_kind(S, NName (BYTES text) metadata, n_class*, ptbytes_method) = (text_kind)
  -- if $ptlc($base64(text)) = $ptascii("parent")
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.LEXICAL_CLASS = (porigin_scope)
  -- if $class_link_at(S.LINKEDPARENTS, porigin_scope) = (INTERNAL_THROWABLE_PARENT text_kind)
  -- if n_class* = $ptascii(text_kind)
def $scoped_internal_method_kind(S, NName (BYTES text) metadata, n_class*, ptbytes_method) = (text_kind)
  -- if $ptlc($base64(text)) = $ptascii("parent")
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.LEXICAL_CLASS = (porigin_scope)
  -- if $class_link_at(S.LINKEDPARENTS, porigin_scope) = (SOURCE_PARENT porigin_parent)
  -- if $class_at(S.CLASSES, porigin_parent) = (pclassdesc_parent)
  -- if n_class* = pclassdesc_parent.NAME
  -- if $class_throwable_kind(S, porigin_parent, |S.CLASSES|) = (text_kind)
  -- if $effective_method(S, porigin_parent, ptbytes_method, |S.CLASSES|) = eps
def $scoped_internal_method_kind(S, phpType19, n_class*, ptbytes_method) = eps -- otherwise
def $scoped_internal_ctor_kind(S, phpType19, n_class*) = $scoped_internal_method_kind(S, phpType19, n_class*, $ptascii("__construct"))
