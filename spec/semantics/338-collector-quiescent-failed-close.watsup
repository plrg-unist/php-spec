;; A throwing finalizer drops the pending graceful exception before returning.
;; The destroy frame's one private zval retires at return, while the genuine
;; caller operation retains the real exception. Admit only that storage tail.
dec $gc_worker_quiescent_failed_retiring(pstate, nat) : bool
def $gc_worker_quiescent_failed_retiring(S, n_exit) = true
