dec $lossy_reference_parameter_capture(pstate) : ptask?
def $lossy_reference_parameter_capture(S) = (LOSSY_REFERENCE_PARAMETER_RECEIVE porigin_function n_cell n_bits i z)
  -- if S.TODO = [TYPE_RECEIVE porigin_function 0]
  -- if S.COMPLETION = NORMAL
  -- if $function_at(S.FUNCTIONS, porigin_function) = (pfunction)
  -- if z = $default_parameter_line(S, porigin_function, 0)
  -- if $lossy_reference_parameter_metadata(S, porigin_function, z)
  -- if $lookup(S.ENV, pfunction.SIGNATURE.PARAMETERS[0].NAME) = (n_cell)
  -- if $(n_cell < |S.STORE|) /\ (HCELL n_cell) <- S.ALLOCATIONS
  -- if S.STORE[n_cell] = DEFINED (PFLOAT n_bits)
  -- if $typed_parameter_conversion(S, pfunction.SIGNATURE.PARAMETERS[0], PFLOAT n_bits) = TYPEINTEGER (PFLOAT n_bits)
  -- if $lossy_parameter_snapshot(n_bits) = ((i, ptbytes))
def $lossy_reference_parameter_capture(S) = eps -- otherwise
def $lossy_reference_parameter_candidate(S) = ($lossy_reference_parameter_capture(S) =/= eps)

rule PhpStep/lossy-reference-parameter-begin: S ~> $error_dispatch(S[.TODO = [ptask_source]][.ORIGIN = (porigin_site)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], 8192, ptbytes, z, DIAGNOSTIC "Deprecated" ptbytes z, ptask_source)
  -- if $lossy_reference_parameter_capture(S) = (ptask_source)
