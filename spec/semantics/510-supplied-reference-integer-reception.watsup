  -- if $lossy_parameter_snapshot(n_bits) = ((i, ptbytes))
  -- if porigin_site = $default_parameter_origin(S, porigin_function, 0)
rule PhpStep/lossy-reference-parameter-entry-refused: S ~> S[.COMPLETION = UNSUPPORTED "lossy reference parameter receive context"]
  -- if $lossy_reference_parameter_capture(S) = (LOSSY_REFERENCE_PARAMETER_RECEIVE porigin_function n_cell n_bits i z)
  -- if ~$lossy_reference_parameter_ready(S, n_cell)

