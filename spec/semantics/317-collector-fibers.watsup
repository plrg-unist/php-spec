def $gc_worker_put_guard(S, n, pgcguard?) = $fiber_put(S, n, pfiber[.GC = (pgcworker[.GUARD = pgcguard?])])
  -- if $fiber_at(S, n) = (pfiber)
  -- if pfiber.GC = (pgcworker)
def $gc_worker_plan_set(S, pgcplan) = S[.GC.PLAN = (pgcplan)][.GC.ACTIVE = (pgcplan.CALL)][.FIBERCALLERS = pfibercaller[.VM.TODO = (GC_WORKER_WAIT pfibercaller.OBJECT pgcplan) :: ptask_tail*] :: pfibercaller_tail*]
