def $gc_worker_enter(S, n, pgcplan, n_object) = $destructor_select(S_guarded, n_object, false, eps)
  -- if pgcguard = {WORKER n, SOURCE pgcplan.CALL[.PENDING = eps], INDEX pgcplan.INDEX, OBJECT n_object, PENDING pgcplan.CALL.PENDING}
  -- if S_moved = $gc_worker_plan_set(S, pgcplan[.CALL.PENDING = eps])
  -- if S_guarded = $gc_worker_put_guard(S_moved[.TODO = [GC_WORKER_GUARD pgcguard, FIBER_FINISH n]], n, (pgcguard))
rule PhpStep/gc-worker-idle: S ~> $gc_worker_idle(S, n, pgcplan)
  -- if S.TODO = [GC_WORKER_RUN n]
  -- if $gc_worker_run_valid(S, n)
  -- if S.GC.PLAN = (pgcplan)
  -- if pgcplan.INDEX = |pgcplan.DTORS|
def $gc_worker_idle(S, n, pgcplan) = S_returned[.TODO = (GC_FREE pgcplan) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if $fiber_at(S, n) = (pfiber)
  -- if S_idle = S[.TODO = [GC_WORKER_IDLE n]][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S_saved = $fiber_put(S_idle, n, pfiber[.STATUS = FIBER_SUSPENDED][.VM = ($fiber_vm(S_idle))])
  -- if S.FIBERCALLERS = pfibercaller :: pfibercaller_tail*
  -- if S_returned = $fiber_vm_restore(S_saved, pfibercaller.VM)[.ACTIVEFIBER = pfibercaller.PREVIOUS][.FIBERCALLERS = pfibercaller_tail*]
  -- if S_returned.TODO = (GC_WORKER_WAIT n pgcplan) :: ptask_tail*

def $gc_worker_guard_task(AT porigin ptask, pgcguard) = $gc_worker_guard_task(ptask, pgcguard)
def $gc_worker_guard_task(GC_WORKER_GUARD pgcguard_task, pgcguard) = 1 -- if pgcguard_task = pgcguard
def $gc_worker_guard_task(ptask, pgcguard) = 0 -- otherwise
def $gc_worker_guard_count(eps, pgcguard) = 0
def $gc_worker_guard_count(ptask :: ptask_tail*, pgcguard) = $($gc_worker_guard_task(ptask, pgcguard) + $gc_worker_guard_count(ptask_tail*, pgcguard))
def $gc_worker_guard_frames(eps, pgcguard) = 0
def $gc_worker_guard_frames(pframe :: pframe_tail*, pgcguard) = $($gc_worker_guard_count(pframe.TODO, pgcguard) + $gc_worker_guard_frames(pframe_tail*, pgcguard))
def $gc_worker_guard_tail([GC_WORKER_GUARD pgcguard, FIBER_FINISH n], pgcguard) = (n = pgcguard.WORKER)
def $gc_worker_guard_tail(ptask :: ptask_tail*, pgcguard) = $gc_worker_guard_tail(ptask_tail*, pgcguard)
  -- if ptask =/= GC_WORKER_GUARD pgcguard
def $gc_worker_guard_tail(ptask*, pgcguard) = false -- otherwise
def $gc_worker_guard_frame_tail(eps, pgcguard) = false
def $gc_worker_guard_frame_tail(pframe :: pframe_tail*, pgcguard) = ($gc_worker_guard_tail(pframe.TODO, pgcguard) \/ $gc_worker_guard_frame_tail(pframe_tail*, pgcguard))
def $gc_worker_guard_at(S) = (pgcguard)
  -- if S.ACTIVEFIBER = (n)
  -- if $fiber_at(S, n) = (pfiber)
  -- if pfiber.GC = (pgcworker)
  -- if pgcworker.GUARD = (pgcguard)
  -- if $gc_worker_guard_valid(S, pgcguard)
def $gc_worker_guard_at(S) = eps -- otherwise
def $gc_worker_guard_valid(S, pgcguard) = true
  -- if S.ACTIVEFIBER = (pgcguard.WORKER)
  -- if $fiber_at(S, pgcguard.WORKER) = (pfiber)
  -- if $gc_worker_cache_valid(S, pgcguard.WORKER, pfiber)
  -- if pfiber.GC = (pgcworker)
  -- if pgcworker.GUARD = (pgcguard)
  -- if $gc_worker_birth_valid(S, pgcguard.SOURCE)
  -- if (HOBJECT pgcguard.OBJECT) <- S.ALLOCATIONS
  -- if pgcguard.OBJECT <- S.DESTRUCTION.CALLED
  -- if $destructor_pending_valid(S, pgcguard.PENDING)
  -- if $($gc_worker_guard_count(S.TODO, pgcguard) + $gc_worker_guard_frames(S.FRAMES, pgcguard)) = 1
  -- if $gc_worker_guard_tail(S.TODO, pgcguard) \/ $gc_worker_guard_frame_tail(S.FRAMES, pgcguard)
  -- if $gc_worker_guard_attachment(S, pgcguard)
def $gc_worker_guard_valid(S, pgcguard) = false -- otherwise

;; The real source-less C root saves its empty table when entering a destructor.
;; Its adjacent guard authenticates this frame after the original caller retires.
dec $gc_worker_base_frame(pstate, pframe) : bool
def $gc_worker_base_frame(S, pframe) = true
  -- if S.ACTIVEFIBER = (n)
  -- if pframe.CONTEXT = eps
  -- if pframe.LOCALS = ($empty_table())
  -- if pframe.TODO = [DESTRUCTOR_RESULT pdestructorcall, GC_WORKER_GUARD pgcguard, FIBER_FINISH n]
  -- if pframe.ORIGIN = eps
  -- if pframe.SILENCES = eps
  -- if pframe.HELD = eps
  -- if pframe.BORROWEDREAD = eps
  -- if pframe.OBJECTCAST = eps
  -- if pframe.CONSTCONTEXT = eps
  -- if pgcguard.WORKER = n
  -- if pdestructorcall.OBJECT = pgcguard.OBJECT
  -- if pdestructorcall.CALLER = eps
  -- if pdestructorcall.ORIGIN = eps
  -- if pdestructorcall.CONSTCONTEXT = eps
  -- if $gc_worker_guard_valid(S, pgcguard)
def $gc_worker_base_frame(S, pframe) = false -- otherwise
def $call_saved_context_valid(S, pframe) = true -- if $gc_worker_base_frame(S, pframe)

def $gc_worker_guard_attachment(S, pgcguard) = true
  -- if S.GC.WORKER = (pgcguard.WORKER)
  -- if S.GC.PLAN = (pgcplan)
  -- if $gc_plan_live(S, pgcplan)
  -- if pgcplan.CALL = pgcguard.SOURCE
  -- if pgcplan.INDEX = pgcguard.INDEX
  -- if $(pgcplan.INDEX < |pgcplan.DTORS|)
  -- if pgcplan.DTORS[pgcplan.INDEX] = HOBJECT pgcguard.OBJECT
def $gc_worker_guard_attachment(S, pgcguard) = true -- if S.GC.WORKER =/= (pgcguard.WORKER)
def $gc_worker_guard_attachment(S, pgcguard) = false -- otherwise
def $call_task_valid(S, GC_WORKER_GUARD pgcguard) = $gc_worker_guard_valid(S, pgcguard)
def $destructor_leaf_valid(S, pdestructorcall) = true
  -- if pdestructorcall.RELEASE = eps
  -- if pdestructorcall.FRAME = eps
  -- if pdestructorcall.OPERATION = eps
  -- if $gc_worker_guard_at(S) = (pgcguard)
  -- if pgcguard.OBJECT = pdestructorcall.OBJECT
  -- if pdestructorcall.CALLER = eps
  -- if pdestructorcall.ORIGIN = eps
  -- if pdestructorcall.CONSTCONTEXT = eps
def $gc_source(S) = true
  -- if S.CURRENT = eps
  -- if $gc_worker_guard_at(S) =/= eps
def $destructor_tail_pending((GC_WORKER_GUARD pgcguard) :: ptask_tail*) = pgcguard.PENDING
def $gc_worker_scope(eps) = eps
def $gc_worker_scope((pcallcontext)) = pcallcontext.LEXICAL_CLASS
def $destructor_access_scope(S) = $gc_worker_scope(pgcguard.SOURCE.CALLER)
  -- if S.CURRENT = eps
  -- if $gc_worker_guard_at(S) = (pgcguard)

def $gc_worker_pending_tasks(eps, pgcguard, pgcguard_new) = eps
def $gc_worker_pending_tasks((GC_WORKER_GUARD pgcguard) :: ptask_tail*, pgcguard, pgcguard_new) = (GC_WORKER_GUARD pgcguard_new) :: ptask_tail*
def $gc_worker_pending_tasks(ptask :: ptask_tail*, pgcguard, pgcguard_new) = ptask :: $gc_worker_pending_tasks(ptask_tail*, pgcguard, pgcguard_new)
  -- if ptask =/= GC_WORKER_GUARD pgcguard
def $gc_worker_pending(S, pgcguard, n_error) = $gc_worker_put_guard(S[.TODO = $gc_worker_pending_tasks(ptask_tail*, pgcguard, pgcguard_new)], pgcguard.WORKER, (pgcguard_new))
  -- if S.TODO = (THROW_SEARCH n_error) :: ptask_tail*
  -- if pgcguard_new = pgcguard[.PENDING = (n_error)]
def $destructor_resume_pending(S, pdestructorcall) = $gc_worker_pending(S, pgcguard, n_error)
  -- if pdestructorcall.RELEASE = eps
  -- if pdestructorcall.FRAME = eps
  -- if pdestructorcall.OPERATION = eps
  -- if S.TODO = (THROW_SEARCH n_error) :: ptask_tail*
  -- if $gc_worker_guard_at(S) = (pgcguard)
  -- if pgcguard.OBJECT = pdestructorcall.OBJECT
rule PhpStep/gc-worker-guard-return: S ~> $gc_worker_guard_done(S, pgcguard)
  -- if S.TODO = (GC_WORKER_GUARD pgcguard) :: ptask_tail*
  -- if $gc_worker_guard_valid(S, pgcguard)
  -- if S.CURRENT = eps
  -- if S.FRAMES = eps
def $gc_worker_guard_drop(S, pgcguard) = $gc_worker_put_guard(S[.TODO = ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], pgcguard.WORKER, eps)
  -- if S.TODO = (GC_WORKER_GUARD pgcguard) :: ptask_tail*
def $gc_worker_guard_done(S, pgcguard) = $gc_worker_plan_set($gc_worker_guard_drop(S, pgcguard)[.TODO = [GC_WORKER_RUN pgcguard.WORKER]], pgcplan_next)
  -- if S.GC.WORKER = (pgcguard.WORKER)
  -- if S.GC.PLAN = (pgcplan)
  -- if pgcplan_next = pgcplan[.CALL.PENDING = pgcguard.PENDING][.INDEX = $(pgcplan.INDEX + 1)][.STEPS = pgcplan.STEPS ++ [GC_CALLED (HOBJECT pgcguard.OBJECT)]][.DONE = pgcplan.DONE ++ [HOBJECT pgcguard.OBJECT]]
def $gc_worker_guard_done(S, pgcguard) = S[.COMPLETION = UNSUPPORTED "zero-owner target after detached collector guard retirement"]
  -- if S.GC.WORKER =/= (pgcguard.WORKER)
  -- if S_dropped = $gc_worker_guard_drop(S, pgcguard)
  -- if $heap_owners($heap_graph(S_dropped), HOBJECT pgcguard.OBJECT) = 0
def $gc_worker_guard_done(S, pgcguard) = S_dropped[.GC = $gc_buffer_add(S_dropped.GC, HOBJECT pgcguard.OBJECT)]
  -- if S.GC.WORKER =/= (pgcguard.WORKER)
  -- if pgcguard.PENDING = eps
  -- if S_dropped = $gc_worker_guard_drop(S, pgcguard)
  -- if $($heap_owners($heap_graph(S_dropped), HOBJECT pgcguard.OBJECT) > 0)
def $gc_worker_guard_done(S, pgcguard) = S_dropped[.GC = $gc_buffer_add(S_dropped.GC, HOBJECT pgcguard.OBJECT)][.TODO = (THROW_SEARCH n_error) :: S_dropped.TODO]
  -- if S.GC.WORKER =/= (pgcguard.WORKER)
  -- if pgcguard.PENDING = (n_error)
  -- if S_dropped = $gc_worker_guard_drop(S, pgcguard)
  -- if $($heap_owners($heap_graph(S_dropped), HOBJECT pgcguard.OBJECT) > 0)

;; Suspension moves the current dtor_obj frame, including old_exception, into
;; the detached VM. The real cache owner becomes one ordinary release job.
def $fiber_back(S, pvalue, false) = $gc_worker_detach(S, pfibercaller.OBJECT, pgcplan)
  -- if S.FIBERCALLERS = pfibercaller :: pfibercaller_tail*
  -- if $gc_worker_api(pfibercaller.API)
  -- if S.ACTIVEFIBER = (pfibercaller.OBJECT)
  -- if ~$fiber_close_boundary(S)
  -- if pfibercaller.VM.TODO = (GC_WORKER_WAIT pfibercaller.OBJECT pgcplan) :: ptask_tail*
def $gc_worker_detach(S, n, pgcplan) = $destructor_release_begin(S_detached, [DESTRUCTION_VALUE (HOBJECT n)])
  -- if S.FIBERCALLERS = pfibercaller :: pfibercaller_tail*
  -- if pfibercaller.OBJECT = n
  -- if $fiber_at(S, n) = (pfiber)
  -- if pfiber.GC = (pgcworker)
  -- if pgcworker.GUARD = (pgcguard)
  -- if pgcplan_next = pgcplan[.INDEX = $(pgcplan.INDEX + 1)][.STEPS = pgcplan.STEPS ++ [GC_DETACHED (HOBJECT pgcguard.OBJECT)]]
  -- if S_returned = $fiber_vm_restore(S, pfibercaller.VM)[.ACTIVEFIBER = pfibercaller.PREVIOUS][.FIBERCALLERS = pfibercaller_tail*]
  -- if S_returned.TODO = (GC_WORKER_WAIT n pgcplan) :: ptask_tail*
  -- if S_detached = S_returned[.GC.WORKER = eps][.GC.PLAN = (pgcplan_next)][.GC.ACTIVE = (pgcplan_next.CALL)][.TODO = (GC_WORKER_REPLACE pgcplan_next) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)][.COMPLETION = NORMAL]
def $gc_steps_valid(S, (HOBJECT n) :: pnode*, (GC_DETACHED (HOBJECT n)) :: pgcprogress*) = (n <- S.DESTRUCTION.CALLED /\ $gc_steps_valid(S, pnode*, pgcprogress*))
def $gc_step_done((GC_DETACHED pnode) :: pgcprogress*) = $gc_step_done(pgcprogress*)
def $call_task_valid(S, GC_WORKER_REPLACE pgcplan) = ($gc_plan_valid(S, pgcplan) /\ S.GC.WORKER = eps /\ $(pgcplan.INDEX > 0))
rule PhpStep/gc-worker-replace: S ~> $gc_worker_start(S, pgcplan, false)
  -- if S.TODO = (GC_WORKER_REPLACE pgcplan) :: ptask_tail*
  -- if $call_task_valid(S, GC_WORKER_REPLACE pgcplan)

def $gc_worker_replacement_tasks((GC_WORKER_REPLACE pgcplan) :: ptask_tail*, pgcplan) = true
def $gc_worker_replacement_tasks((DESTRUCTOR_RELEASE pdestructionrelease) :: ptask_tail*, pgcplan) = $gc_worker_replacement_tasks(ptask_tail*, pgcplan)
def $gc_worker_replacement_tasks(ptask_tail*, pgcplan) = false -- otherwise
def $gc_worker_replace_tasks((GC_WORKER_REPLACE pgcplan) :: ptask_tail*, pgcplan, pgcplan_new) = (GC_WORKER_REPLACE pgcplan_new) :: ptask_tail*
def $gc_worker_replace_tasks((DESTRUCTOR_RELEASE pdestructionrelease) :: ptask_tail*, pgcplan, pgcplan_new) = (DESTRUCTOR_RELEASE pdestructionrelease) :: $gc_worker_replace_tasks(ptask_tail*, pgcplan, pgcplan_new)
def $gc_worker_replacement_pending(S, pgcplan, n_error) = S_linked[.TODO = $gc_worker_replace_tasks(S_linked.TODO, pgcplan, pgcplan_new)][.GC.PLAN = (pgcplan_new)][.GC.ACTIVE = (pgcplan_new.CALL)]
  -- if S_linked = $fiber_close_chain(S, n_error, pgcplan.CALL.PENDING)
  -- if pgcplan_new = pgcplan[.CALL.PENDING = (n_error)]
def $fiber_close_error_return(S, n_error) = $gc_worker_replacement_pending(S, pgcplan, n_error)
  -- if S.GC.PLAN = (pgcplan)
  -- if $gc_plan_live(S, pgcplan)
  -- if $gc_worker_replacement_tasks(S.TODO, pgcplan)

;; Empty function_name needs no callback retirement. DESTROYED handling still
;; uses the genuine force-close frame and its private graceful control object.
def $fiber_finish(S, n) = $fiber_close_back($fiber_put(S, n, $fiber_terminated(pfiber, PNULL, false)), PNULL, false)
  -- if $gc_internal_worker(S, n)
  -- if $fiber_close_boundary(S)
  -- if S.ACTIVEFIBER = (n)
  -- if S.CURRENT = eps
  -- if S.FRAMES = eps
  -- if $fiber_at(S, n) = (pfiber)
def $fiber_throw_finish(S, n, n_exit) = $fiber_close_back($fiber_put(S, n, $fiber_terminated(pfiber, PNULL, false)[.GRACEFUL = true][.RETURNED = false]), PNULL, false)
  -- if $gc_internal_worker(S, n)
  -- if $fiber_close_boundary(S)
  -- if $fiber_at(S, n) = (pfiber)
  -- if $fiber_graceful_for(S, n, pfiber.SEQUENCE, n_exit)
def $fiber_throw_finish(S, n, n_error) = $fiber_close_back($fiber_put(S, n, $fiber_terminated(pfiber, PNULL, true)), POBJECT n_error, true)
  -- if $gc_internal_worker(S, n)
  -- if $fiber_close_boundary(S)
  -- if $throwable_member(S, n_error)
  -- if $fiber_at(S, n) = (pfiber)

def $destructor_trace_suffix(S, pcallcontext) = [{FILE eps, LINE $(-1), FUNCTION $ptascii("gc_destructor_fiber"), CLASS eps, TYPE eps, ARGS eps, HASARGS true}]
  -- if $destructor_context_call(pcallcontext, S.CURRENT, S.FRAMES) = (pdestructorcall)
  -- if $gc_worker_guard_at(S) = (pgcguard)
  -- if pgcguard.OBJECT = pdestructorcall.OBJECT
def $fiber_caller_trace(S) = $config_trace_frames(S_caller, pgcplan.CALL.CALL, eps) ++ $eval_exception_trace_from(S_caller, eps)
  -- if S.FIBERCALLERS = pfibercaller :: pfibercaller_tail*
  -- if $gc_worker_api(pfibercaller.API)
  -- if ~$fiber_close_boundary(S)
  -- if pfibercaller.VM.TODO = (GC_WORKER_WAIT pfibercaller.OBJECT pgcplan) :: ptask_tail*
  -- if S_caller = $fiber_vm_restore(S, pfibercaller.VM)[.ACTIVEFIBER = pfibercaller.PREVIOUS][.FIBERCALLERS = pfibercaller_tail*]
