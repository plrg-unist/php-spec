  -- if $internal_destructor_pending(S, HOBJECT n)
  -- if $fiber_at(S, n) = (pfiber)
  -- if $fiber_record_valid(S, n, pfiber)
  -- if pfiber.GC = (pgcworker)
  -- if pgcworker.GUARD = eps
rule PhpStep/gc-worker-idle-store: S ~> S_retired[.GC = $gc_buffer_add(S_retired.GC, HOBJECT n)]
  -- if $gc_worker_idle_store_ready(S)
  -- if S.GC.WORKER = (n)
