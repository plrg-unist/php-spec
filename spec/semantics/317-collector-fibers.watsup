  -- if $gc_worker_api(pfibercaller.API)
  -- if pfibercaller.VM.TODO = (GC_WORKER_WAIT pfibercaller.OBJECT pgcplan_old) :: ptask_tail*
def $gc_worker_start(S, pgcplan, b_fresh) = $gc_worker_start_vm(S_running, n, pfiber)[.TODO = [GC_WORKER_RUN n]][.ACTIVEFIBER = (n)][.FIBERCALLERS = pfibercaller :: S_caller.FIBERCALLERS][.FIBERSEQ = $(S_caller.FIBERSEQ + 1)]
