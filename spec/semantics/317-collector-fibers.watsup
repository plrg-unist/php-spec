def $task_nodes(GC_WORKER_RUN n) = eps
def $task_nodes(GC_WORKER_IDLE n) = eps
def $task_nodes(GC_WORKER_WAIT n pgcplan) = $instance_roots(pgcplan.CALL.CALL.OWNER) ++ $instance_roots(pgcplan.CALL.PENDING)
def $task_nodes(GC_WORKER_REPLACE pgcplan) = $instance_roots(pgcplan.CALL.CALL.OWNER) ++ $instance_roots(pgcplan.CALL.PENDING)
def $task_nodes(GC_WORKER_GUARD pgcguard) = [HOBJECT pgcguard.OBJECT] ++ $instance_roots(pgcguard.PENDING)
