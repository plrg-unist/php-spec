;; The request object-store pass destroys the cached idle internal handler. It
;; has no PHP callback or live guard; DESTROYED exits its loop and drops cache.
def $gc_worker_idle_store_ready(S) = true
  -- if S.TODO = [DESTRUCTOR_STORE]
  -- if $call_task_valid(S, DESTRUCTOR_STORE)
  -- if $(S.DESTRUCTION.INDEX < S.DESTRUCTION.NEXT)
