  -- if pgcplan_next = $gc_worker_start_plan(S_cached, pgcplan, b_fresh)
  -- if S_caller = $gc_replace($gc_worker_start_buffer(S_cached, pgcplan_next, b_fresh), pgcplan_next, GC_WORKER_WAIT n pgcplan_next)
  -- if pfiberapi = {SITE pgcplan.CALL.CALL.SITE, OBJECT n, KIND (INTRINSIC_GC_COLLECT), START eps, SENT eps, LINE pgcplan.CALL.CALL.LINE, SEQUENCE S_caller.FIBERSEQ}
  -- if pfibercaller = {OBJECT n, PREVIOUS S_caller.ACTIVEFIBER, VM $fiber_vm(S_caller), API pfiberapi}
  -- if S_running = $fiber_put(S_caller, n, pfiber[.STATUS = FIBER_RUNNING][.VM = eps][.SEQUENCE = pfiberapi.SEQUENCE])
def $gc_worker_start_vm(S, n, pfiber) = $fiber_fresh_vm(S, n, {SLOTS eps, NAMED eps})
  -- if pfiber.VM = eps
def $gc_worker_start_vm(S, n, pfiber) = $fiber_vm_restore(S, pfibervm)
  -- if pfiber.VM = (pfibervm)
def $gc_worker_cached(S, pgccall) = $destruction_store_new(S[.OBJECTS = S.OBJECTS ++ [FIBER pfiber]][.ALLOCATIONS = S.ALLOCATIONS ++ [HOBJECT n]][.GC.WORKER = (n)])
  -- if S.GC.WORKER = eps
  -- if n = |S.OBJECTS|
  -- if pfiber = $fiber_empty()[.READY = true][.GC = ({BIRTH pgccall[.PENDING = eps], GUARD eps})]
def $gc_worker_cached(S, pgccall) = S -- if S.GC.WORKER =/= eps
def $gc_worker_start_plan(S, pgcplan, true) = $gc_plan(S, pgcplan.CALL)
def $gc_worker_start_plan(S, pgcplan, false) = pgcplan
def $gc_worker_start_buffer(S, pgcplan, true) = S[.GC.BUFFER = pgcplan.BUFFER][.GC.FREE = eps]
def $gc_worker_start_buffer(S, pgcplan, false) = S
def $gc_fiber_trace(S, pgcplan) = $gc_worker_start(S, pgcplan, true)
  -- if $fiber_transfer_domain(S)
def $gc_fiber_trace(S, pgcplan) = S[.COMPLETION = UNSUPPORTED "collector Fiber transfer during an initializer, source loader or Generator continuation"]
  -- if ~$fiber_transfer_domain(S)

rule PhpStep/gc-worker-skip: S ~> $gc_worker_plan_set(S, pgcplan_next)
  -- if S.TODO = [GC_WORKER_RUN n]
  -- if $gc_worker_run_valid(S, n)
