;; Zend/zend_gc.c::gc_call_destructors_in_fiber. The internal handler is a
;; genuine Fiber with no PHP function_name/constructor callback. BIRTH and
;; SOURCE are borrowed; the cache and the live guard are its actual owners.
dec $gc_worker_birth_valid(pstate, pgccall) : bool
dec $gc_worker_call_source_valid(pstate, pconfigcall) : bool
dec $gc_worker_selected_source_valid(pstate, pconfigcall) : bool
dec $gc_worker_cache_valid(pstate, nat, pfiber) : bool
dec $gc_worker_guard_valid(pstate, pgcguard) : bool
dec $gc_worker_guard_count(ptask*, pgcguard) : nat
dec $gc_worker_guard_task(ptask, pgcguard) : nat
dec $gc_worker_guard_frames(pframe*, pgcguard) : nat
dec $gc_worker_guard_tail(ptask*, pgcguard) : bool
dec $gc_worker_guard_frame_tail(pframe*, pgcguard) : bool
dec $gc_worker_guard_at(pstate) : pgcguard?
dec $gc_worker_put_guard(pstate, nat, pgcguard?) : pstate
dec $gc_worker_plan_set(pstate, pgcplan) : pstate
dec $gc_worker_start(pstate, pgcplan, bool) : pstate
dec $gc_worker_cached(pstate, pgccall) : pstate
dec $gc_worker_start_plan(pstate, pgcplan, bool) : pgcplan
dec $gc_worker_guard_attachment(pstate, pgcguard) : bool
dec $gc_worker_start_vm(pstate, nat, pfiber) : pstate
dec $gc_worker_enter(pstate, nat, pgcplan, nat) : pstate
dec $gc_worker_idle(pstate, nat, pgcplan) : pstate
dec $gc_worker_detach(pstate, nat, pgcplan) : pstate
dec $gc_worker_guard_done(pstate, pgcguard) : pstate
dec $gc_worker_guard_drop(pstate, pgcguard) : pstate
dec $gc_worker_pending_tasks(ptask*, pgcguard, pgcguard) : ptask*
dec $gc_worker_pending(pstate, pgcguard, nat) : pstate
dec $gc_worker_run_valid(pstate, nat) : bool
dec $gc_worker_wait_valid(pstate, nat, pgcplan) : bool
dec $gc_worker_replace_tasks(ptask*, pgcplan, pgcplan) : ptask*
dec $gc_worker_replacement_tasks(ptask*, pgcplan) : bool
dec $gc_worker_replacement_pending(pstate, pgcplan, nat) : pstate
dec $gc_call_vm_count(pstate, pfibervm, nat?, pgccall) : nat
dec $gc_plan_vm_count(pstate, pfibervm, nat?, pgcplan) : nat
