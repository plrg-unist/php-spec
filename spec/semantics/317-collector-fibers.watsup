dec $gc_plan_close_count(pstate, pfiberclose*, pgcplan) : nat
dec $gc_caller_scope(pstate, pfibercaller*, pgccall) : pstate?
dec $gc_close_scope(pstate, pfiberclose*, pgccall) : pstate?
dec $gc_worker_scope(pcallcontext?) : porigin?
dec $gc_worker_start_buffer(pstate, pgcplan, bool) : pstate

;; Restored VM views exclude their borrowed parked copy. Only TODO/FRAMES,
;; never destructor histories or PLAN itself, authenticate the global pass.
def $gc_call_vm_count(S, pfibervm, n?, pgccall) = $($gc_consumer_count(pfibervm.TODO, pgccall) + $gc_consumer_frame_count(pfibervm.FRAMES, pgccall))
  -- if n? =/= S.ACTIVEFIBER
def $gc_call_vm_count(S, pfibervm, n?, pgccall) = 0 -- if n? = S.ACTIVEFIBER
def $gc_plan_vm_count(S, pfibervm, n?, pgcplan) = $($gc_plan_consumer_count(pfibervm.TODO, pgcplan) + $gc_plan_frame_count(pfibervm.FRAMES, pgcplan))
  -- if n? =/= S.ACTIVEFIBER
def $gc_plan_vm_count(S, pfibervm, n?, pgcplan) = 0 -- if n? = S.ACTIVEFIBER
def $gc_call_caller_count(S, eps, pgccall) = 0
def $gc_call_caller_count(S, pfibercaller :: pfibercaller_tail*, pgccall) = $($gc_call_vm_count(S, pfibercaller.VM, pfibercaller.PREVIOUS, pgccall) + $gc_call_caller_count(S, pfibercaller_tail*, pgccall))
def $gc_plan_caller_count(S, eps, pgcplan) = 0
def $gc_plan_caller_count(S, pfibercaller :: pfibercaller_tail*, pgcplan) = $($gc_plan_vm_count(S, pfibercaller.VM, pfibercaller.PREVIOUS, pgcplan) + $gc_plan_caller_count(S, pfibercaller_tail*, pgcplan))
def $gc_call_close_count(S, eps, pgccall) = 0
def $gc_call_close_count(S, pfiberclose :: pfiberclose_tail*, pgccall) = $($gc_call_vm_count(S, pfiberclose.VM, pfiberclose.PREVIOUS, pgccall) + $gc_call_close_count(S, pfiberclose_tail*, pgccall))
def $gc_plan_close_count(S, eps, pgcplan) = 0
def $gc_plan_close_count(S, pfiberclose :: pfiberclose_tail*, pgcplan) = $($gc_plan_vm_count(S, pfiberclose.VM, pfiberclose.PREVIOUS, pgcplan) + $gc_plan_close_count(S, pfiberclose_tail*, pgcplan))
def $gc_parked_call_count(S, pgccall) = $($gc_call_caller_count(S, S.FIBERCALLERS, pgccall) + $gc_call_close_count(S, S.FIBERCLOSERS, pgccall))
def $gc_parked_plan_count(S, pgcplan) = $($gc_plan_caller_count(S, S.FIBERCALLERS, pgcplan) + $gc_plan_close_count(S, S.FIBERCLOSERS, pgcplan))
def $gc_caller_scope(S, eps, pgccall) = eps
def $gc_caller_scope(S, pfibercaller :: pfibercaller_tail*, pgccall) = ($fiber_vm_restore(S, pfibercaller.VM)[.ACTIVEFIBER = pfibercaller.PREVIOUS][.FIBERCALLERS = pfibercaller_tail*][.COMPLETION = NORMAL])
  -- if $($gc_call_vm_count(S, pfibercaller.VM, pfibercaller.PREVIOUS, pgccall) > 0)
def $gc_caller_scope(S, pfibercaller :: pfibercaller_tail*, pgccall) = $gc_caller_scope(S, pfibercaller_tail*, pgccall)
  -- if $gc_call_vm_count(S, pfibercaller.VM, pfibercaller.PREVIOUS, pgccall) = 0
def $gc_close_scope(S, eps, pgccall) = eps
def $gc_close_scope(S, pfiberclose :: pfiberclose_tail*, pgccall) = ($fiber_vm_restore(S, pfiberclose.VM)[.ACTIVEFIBER = pfiberclose.PREVIOUS][.FIBERCLOSERS = pfiberclose_tail*][.COMPLETION = NORMAL])
  -- if $($gc_call_vm_count(S, pfiberclose.VM, pfiberclose.PREVIOUS, pgccall) > 0)
def $gc_close_scope(S, pfiberclose :: pfiberclose_tail*, pgccall) = $gc_close_scope(S, pfiberclose_tail*, pgccall)
  -- if $gc_call_vm_count(S, pfiberclose.VM, pfiberclose.PREVIOUS, pgccall) = 0
def $gc_consumer_scope(S, pgccall) = (S_scope)
  -- if $($gc_consumer_count(S.TODO, pgccall) + $gc_consumer_frame_count(S.FRAMES, pgccall)) = 0
  -- if $gc_caller_scope(S, S.FIBERCALLERS, pgccall) = (S_scope)
def $gc_consumer_scope(S, pgccall) = (S_scope)
  -- if $($gc_consumer_count(S.TODO, pgccall) + $gc_consumer_frame_count(S.FRAMES, pgccall)) = 0
  -- if $gc_caller_scope(S, S.FIBERCALLERS, pgccall) = eps
  -- if $gc_close_scope(S, S.FIBERCLOSERS, pgccall) = (S_scope)

def $gc_task_consumer(GC_WORKER_WAIT n pgcplan, pgccall) = 1 -- if pgcplan.CALL = pgccall
def $gc_task_consumer(GC_WORKER_REPLACE pgcplan, pgccall) = 1 -- if pgcplan.CALL = pgccall
