;; Global constant values are installed only after the genuine initializer.
;; Receipts borrow the declaration and immutable source-entry scope.
dec $global_constant_declaration_source(pcunit*, porigin) : bool
def $global_constant_declaration_source(pcunit*, PORIGIN n_unit pcpath_decl) = true
  -- if $(|pcpath_decl| >= 2)
  -- if pcpath_decl[$nabs($(|pcpath_decl| - 1))] = PCINDEX n_const
  -- if pcpath_decl[$nabs($(|pcpath_decl| - 2))] = PCFIELD 1
  -- if pcpath_statement = pcpath_decl[0:$nabs($(|pcpath_decl| - 2))]
  -- if $origin_node(pcunit*, PORIGIN n_unit pcpath_statement) = (NStmtConst (SEQUENCE eps) (SEQUENCE phpType46*) metadata_statement)
  -- if $origin_node(pcunit*, PORIGIN n_unit pcpath_decl) = (NConst phpType11 expression metadata)
def $global_constant_declaration_source(pcunit*, porigin_decl) = false -- otherwise

dec $ppglobal_constant_initializer(ppstate) : bool
dec $global_constant_closure_parent(pcunit, pcpath) : bool
def $global_constant_closure_parent(pcunit, pcpath) = true
  -- if $origin_node([pcunit], PORIGIN pcunit.ID pcpath) = (pcnode)
  -- if $default_closure_node(pcnode)
def $global_constant_closure_parent(pcunit, pcpath) = false -- otherwise
dec $global_constant_initializer_root(pcunit, pcpath) : porigin?
def $global_constant_initializer_root(pcunit, pcpath) = (porigin_decl)
  -- if $(|pcpath| > 0)
  -- if pcpath[$nabs($(|pcpath| - 1))] = PCFIELD 1
  -- if pcpath_decl = pcpath[0:$nabs($(|pcpath| - 1))]
  -- if porigin_decl = PORIGIN pcunit.ID pcpath_decl
  -- if $global_constant_declaration_source([pcunit], porigin_decl)
def $global_constant_initializer_root(pcunit, pcpath) = $global_constant_initializer_root(pcunit, pcpath_parent)
  -- if $(|pcpath| > 0)
  -- if pcpath_parent = pcpath[0:$nabs($(|pcpath| - 1))]
  -- if ~$global_constant_declaration_source([pcunit], PORIGIN pcunit.ID pcpath_parent)
  -- if ~$global_constant_closure_parent(pcunit, pcpath_parent)
def $global_constant_initializer_root(pcunit, pcpath) = eps -- otherwise
def $ppglobal_constant_initializer(P) = true
  -- if P.CLASSCONTEXT = eps
  -- if P.FOLD.CONSTANT /\ ~P.FOLD.DEFAULT
  -- if $global_constant_initializer_root(P.FOLD.SOURCE, P.LOCATION.PATH) =/= eps
def $ppglobal_constant_initializer(P) = false -- otherwise
def $ppconstant_callable_initializer(P) = true
  -- if $ppglobal_constant_initializer(P)

;; A nullable class is a valid global scope. Missing source identity is not.
dec $global_constant_scope(pstate, nat) : (bool, porigin?)
def $global_constant_scope(S, 0) = (true, eps)
  -- if $source_unit(S.SOURCES, 0) =/= eps
  -- if $file_binding_at(S.FILEBINDINGS, 0) = eps
  -- if $eval_binding_at(S.EVALBINDINGS, 0) = eps
def $global_constant_scope(S, n_unit) = (true, pfilebinding.CLASS)
  -- if $(n_unit > 0)
  -- if $file_binding_at(S.FILEBINDINGS, n_unit) = (pfilebinding)
  -- if $eval_binding_at(S.EVALBINDINGS, n_unit) = eps
  -- if $source_unit(S.SOURCES, n_unit) =/= eps
def $global_constant_scope(S, n_unit) = (true, pevalbinding.CLASS)
  -- if $(n_unit > 0)
  -- if $eval_binding_at(S.EVALBINDINGS, n_unit) = (pevalbinding)
  -- if $file_binding_at(S.FILEBINDINGS, n_unit) = eps
  -- if $source_unit(S.SOURCES, n_unit) =/= eps
def $global_constant_scope(S, n_unit) = (false, eps) -- otherwise
dec $global_constant_scope_published(pdeclaration*, porigin?) : bool
def $global_constant_scope_published(pdeclaration*, eps) = true
def $global_constant_scope_published(pdeclaration*, (porigin_scope)) = $constant_callable_published(pdeclaration*, porigin_scope)

dec $global_constant_callable_context(pstate, porigin) : (porigin, porigin?)?
def $global_constant_callable_context(S, porigin_site) = ((porigin_decl, porigin_scope?))
  -- if S.CONSTCONTEXT = (pconstantcontext)
  -- if porigin_decl = pconstantcontext.ORIGIN
  -- if porigin_decl = PORIGIN n_unit pcpath_decl
  -- if $global_constant_declaration_source(S.SOURCES, porigin_decl)
  -- if $constant_declaration(S, porigin_decl) = ((preqbytes, pconstantcontext.LINE))
  -- if $declaration_entered(S.DECLARATIONS, n_unit)
  -- if $constant_bindings(S, S.TODO) = [porigin_decl]
  -- if $global_constant_scope(S, n_unit) = (true, porigin_scope?)
  -- if $global_constant_scope_published(S.DECLARATIONS, porigin_scope?)
  -- if $constant_callable_path(S, porigin_site, $constant_child(porigin_decl, [PCFIELD 1]))
  -- if $origin_node(S.SOURCES, porigin_site) = (pcnode)
  -- if $constant_callable_form(pcnode)
def $global_constant_callable_context(S, porigin_site) = eps -- otherwise
def $global_constant_callable_active(S, porigin_site) = ($global_constant_callable_context(S, porigin_site) =/= eps)

def $constant_callable_stamp(S, n_object, porigin_site, n_prefix) = S[.OBJECTS = $object_set(S.OBJECTS, n_object, CONSTANTCLOSURE porigin_site S.OBJECTS[n_object])][.CONSTANTCLOSURES = S.CONSTANTCLOSURES ++ [{OBJECT n_object, SITE porigin_site, DECL porigin_decl, PREFIX n_prefix}]]
  -- if $global_constant_callable_context(S, porigin_site) = ((porigin_decl, porigin_scope?))

dec $global_constant_callable_header(pstate, pconstantclosure) : bool
def $global_constant_callable_header(S, pconstantclosure) = true
  -- if $(pconstantclosure.OBJECT < |S.OBJECTS|) /\ $(pconstantclosure.PREFIX <= |S.DECLARATIONS|)
  -- if pconstantclosure.DECL = PORIGIN n_unit pcpath_decl
  -- if $global_constant_declaration_source(S.SOURCES, pconstantclosure.DECL)
  -- if $constant_declaration(S, pconstantclosure.DECL) = ((preqbytes, z))
  -- if $declaration_entered(S.DECLARATIONS[0:pconstantclosure.PREFIX], n_unit)
  -- if $global_constant_scope(S, n_unit) = (true, porigin_scope?)
  -- if $global_constant_scope_published(S.DECLARATIONS[0:pconstantclosure.PREFIX], porigin_scope?)
  -- if $constant_callable_path(S, pconstantclosure.SITE, $constant_child(pconstantclosure.DECL, [PCFIELD 1]))
  -- if $origin_node(S.SOURCES, pconstantclosure.SITE) = (pcnode)
  -- if $constant_callable_form(pcnode)
  -- if $constant_callable_record_prefix(S, pconstantclosure)
def $global_constant_callable_header(S, pconstantclosure) = false -- otherwise

dec $global_constant_real_scope(pstate, nat, porigin?) : pstate
def $global_constant_real_scope(S, n_object, eps) = S
def $global_constant_real_scope(S, n_object, (porigin_scope)) = S[.CLOSURESCOPES = S.CLOSURESCOPES ++ [{OBJECT n_object, LEXICAL porigin_scope, CALLED porigin_scope, RECEIVER eps, CREATION eps}]]
def $constant_closure_create(S, pfunction) = $constant_callable_stamp($global_constant_real_scope(S_created, n_object, porigin_scope?), n_object, pfunction.ORIGIN, |S.DECLARATIONS|)
  -- if $global_constant_callable_context(S, pfunction.ORIGIN) = ((porigin_decl, porigin_scope?))
  -- if $closure_lexicals(pfunction.CODE.EXPRESSIONS) = eps
  -- if n_object = |S.OBJECTS|
  -- if S_created = S[.OBJECTS = S.OBJECTS ++ [REALCLOSURE pfunction.ORIGIN eps eps]][.ALLOCATIONS = S.ALLOCATIONS ++ [HOBJECT n_object]][.RESULT = KNOWN (POBJECT n_object)][.BASE = BASE_VALUE (KNOWN PNULL)]

;; Global scope is nullable; named class selectors do not require a class owner.
dec $global_constant_unscoped_class_name(pstate, porigin, phpType19) : ptbytes?
dec $global_constant_class_name(pstate, porigin, porigin?, phpType19) : ptbytes?
def $global_constant_class_name(S, porigin_site, (porigin_scope), phpType19) = $constant_callable_class_name(S, porigin_site, porigin_scope, phpType19)
def $global_constant_class_name(S, porigin_site, eps, phpType19) = $global_constant_unscoped_class_name(S, porigin_site, phpType19)
def $global_constant_unscoped_class_name(S, PORIGIN n_unit pcpath, phpType19) = (ptbytes)
  -- if $ppscoped_named(phpType19) /\ ~$ppscoped_keyword(phpType19)
  -- if $code_at(S.CODE, n_unit) = (pcode)
  -- if $code_name(pcode.NAMES, pcpath) = ((ptbytes, eps))
def $global_constant_unscoped_class_name(S, porigin_site, NScalarString (BYTES text) metadata) = ($ppcall_literal_name($base64(text)))
  -- if $constant_callable_invalid_class(NScalarString (BYTES text) metadata) = eps
def $global_constant_unscoped_class_name(S, porigin_site, phpType19) = eps -- otherwise
dec $global_constant_method(pstate, porigin, porigin?, nat) : (pmethoddesc, porigin)?
def $global_constant_method(S, porigin_site, porigin_scope?, n_prefix) = ((pmethoddesc, porigin_called))
  -- if $(n_prefix <= |S.DECLARATIONS|)
  -- if $origin_node(S.SOURCES, porigin_site) = (NExprStaticCall phpType19 phpType20 phpType6 metadata)
  -- if $global_constant_class_name(S, porigin_site, porigin_scope?, phpType19) = (ptbytes_class)
