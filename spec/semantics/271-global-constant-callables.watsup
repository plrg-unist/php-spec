;; Installed constants retain the preceding constant bindings. A later
;; namespace shadow cannot change an earlier alias's source transfer.
dec $global_constant_prefix(puserconstant*, porigin, puserconstant*) : puserconstant*?
def $global_constant_prefix(eps, porigin_decl, puserconstant_prior*) = eps
def $global_constant_prefix(puserconstant :: puserconstant_tail*, porigin_decl, puserconstant_prior*) = (puserconstant_prior*)
  -- if puserconstant.ORIGIN = porigin_decl
def $global_constant_prefix(puserconstant :: puserconstant_tail*, porigin_decl, puserconstant_prior*) = $global_constant_prefix(puserconstant_tail*, porigin_decl, puserconstant_prior* ++ [puserconstant])
  -- if puserconstant.ORIGIN =/= porigin_decl
dec $global_constant_candidates(puserconstant*, preqbytes, preqbytes?) : puserconstant?
def $global_constant_candidates(puserconstant_prior*, preqbytes, preqbytes_fallback?) = (puserconstant)
  -- if $user_constant_at(puserconstant_prior*, $user_constant_key(preqbytes)) = (puserconstant)
def $global_constant_candidates(puserconstant_prior*, preqbytes, (preqbytes_fallback)) = $user_constant_at(puserconstant_prior*, $user_constant_key(preqbytes_fallback))
  -- if $user_constant_at(puserconstant_prior*, $user_constant_key(preqbytes)) = eps
  -- if $constant_lookup_bytes(preqbytes) = eps
def $global_constant_candidates(puserconstant_prior*, preqbytes, preqbytes_fallback?) = eps -- otherwise
dec $global_constant_alias(pstate, puserconstant*, porigin) : puserconstant?
def $global_constant_alias(S, puserconstant_prior*, PORIGIN n_unit pcpath) = $global_constant_candidates(puserconstant_prior*, preqbytes, preqbytes_fallback?)
  -- if $origin_node(S.SOURCES, PORIGIN n_unit pcpath) = (NExprConstFetch name metadata)
  -- if $code_at(S.CODE, n_unit) = (pcode)
  -- if $code_name(pcode.NAMES, pcpath) = ((preqbytes, preqbytes_fallback?))
def $global_constant_alias(S, puserconstant_prior*, porigin_site) = eps -- otherwise
dec $global_constant_class_visible(pstate, pclassconstantdesc, porigin?) : bool
def $global_constant_class_visible(S, pclassconstantdesc, eps) = (pclassconstantdesc.VISIBILITY = PROPERTY_PUBLIC)
def $global_constant_class_visible(S, pclassconstantdesc, (porigin_scope)) = $constant_callable_alias_visible(S, pclassconstantdesc, porigin_scope)
dec $global_constant_class_alias(pstate, porigin, porigin?) : pclassconstantdesc?
def $global_constant_class_alias(S, porigin_site, porigin_scope?) = (pclassconstantdesc)
  -- if $origin_node(S.SOURCES, porigin_site) = (NExprClassConstFetch phpType19 phpType20 metadata)
  -- if ~$pfclassname_member(phpType20)
  -- if $global_constant_class_name(S, porigin_site, porigin_scope?, phpType19) = (ptbytes_class)
  -- if $constant_callable_method_name(phpType20) = (ptbytes_name)
  -- if $class_named(S.CLASSNAMES, $ptlc(ptbytes_class)) = (porigin_class)
  -- if $constant_callable_published(S.DECLARATIONS, porigin_class)
  -- if $class_constant_lookup(S, porigin_class, ptbytes_name, |S.CLASSES|) = (pclassconstantdesc)
  -- if $global_constant_class_visible(S, pclassconstantdesc, porigin_scope?)
def $global_constant_class_alias(S, porigin_site, porigin_scope?) = eps -- otherwise
dec $global_constant_flow(pstate, porigin, porigin, porigin?, pvalueclass, puserconstant*, porigin*) : bool
dec $global_constant_flow_at(pstate, porigin, porigin, porigin?, pvalueclass, puserconstant*, porigin*) : bool
dec $global_constant_array_flow(pstate, porigin, porigin, porigin?, nat, phpType13*, (pkey, pvalueclass)*, int, puserconstant*, porigin*) : bool
dec $global_constant_class_supported(pvalueclass) : bool
dec $global_constant_classes_supported((pkey, pvalueclass)*) : bool
def $global_constant_class_supported(PVOBJECT) = false
def $global_constant_class_supported(PVARRAY b (pkey, pvalueclass)*) = $global_constant_classes_supported((pkey, pvalueclass)*)
def $global_constant_class_supported(pvalueclass) = true -- otherwise
def $global_constant_classes_supported(eps) = true
def $global_constant_classes_supported((pkey, pvalueclass) :: (pkey_tail, pvalueclass_tail)*) = ($global_constant_class_supported(pvalueclass) /\ $global_constant_classes_supported((pkey_tail, pvalueclass_tail)*))
def $global_constant_flow(S, porigin_site, porigin_decl, porigin_scope?, pvalueclass, puserconstant_prior*, porigin_seen*) = true
  -- if $constant_callable_foldable(pvalueclass)
def $global_constant_flow(S, porigin_site, porigin_decl, porigin_scope?, pvalueclass, puserconstant_prior*, porigin_seen*) = $global_constant_flow_at(S, porigin_site, porigin_decl, porigin_scope?, pvalueclass, puserconstant_prior*, porigin_seen* ++ [porigin_site])
  -- if ~$constant_callable_foldable(pvalueclass)
  -- if ~(porigin_site <- porigin_seen*)
def $global_constant_flow(S, porigin_site, porigin_decl, porigin_scope?, pvalueclass, puserconstant_prior*, porigin_seen*) = false -- otherwise
def $global_constant_flow_at(S, porigin_site, porigin_decl, porigin_scope?, pvalueclass, puserconstant_prior*, porigin_seen*) = $global_constant_flow(S, porigin_target, porigin_decl, porigin_scope?, pvalueclass, puserconstant_prior*, porigin_seen*)
  -- if $compiled_redirect(S, porigin_site) = ((porigin_target, expression, false, z))
def $global_constant_flow_at(S, porigin_site, porigin_decl, porigin_scope?, PVCLOSURE n_object porigin_site, puserconstant_prior*, porigin_seen*) = true
  -- if $compiled_redirect(S, porigin_site) = eps
  -- if $constant_callable_record(S.CONSTANTCLOSURES, n_object) = (pconstantclosure)
  -- if pconstantclosure.DECL = porigin_decl /\ pconstantclosure.SITE = porigin_site
  -- if $constant_callable_identity_valid(S, n_object, porigin_site)
def $global_constant_flow_at(S, porigin_site, porigin_decl, porigin_scope?, pvalueclass, puserconstant_prior*, porigin_seen*) = true
  -- if $compiled_redirect(S, porigin_site) = eps
  -- if $global_constant_alias(S, puserconstant_prior*, porigin_site) = (puserconstant)
  -- if puserconstant.CLASS = pvalueclass
def $global_constant_flow_at(S, porigin_site, porigin_decl, porigin_scope?, pvalueclass, puserconstant_prior*, porigin_seen*) = $constant_callable_alias_flow(S, pclassconstantdesc, pvalueclass, |S.DECLARATIONS|, porigin_seen*)
  -- if $compiled_redirect(S, porigin_site) = eps
  -- if $global_constant_class_alias(S, porigin_site, porigin_scope?) = (pclassconstantdesc)
def $global_constant_flow_at(S, porigin_site, porigin_decl, porigin_scope?, PVARRAY b (pkey, pvalueclass)*, puserconstant_prior*, porigin_seen*) = $global_constant_array_flow(S, porigin_site, porigin_decl, porigin_scope?, 0, phpType13*, (pkey, pvalueclass)*, $(-9223372036854775808), puserconstant_prior*, porigin_seen*)
  -- if $compiled_redirect(S, porigin_site) = eps
  -- if $origin_node(S.SOURCES, porigin_site) = (NExprArray (SEQUENCE phpType13*) metadata)
def $global_constant_flow_at(S, porigin_site, porigin_decl, porigin_scope?, pvalueclass, puserconstant_prior*, porigin_seen*) = $global_constant_flow(S, porigin_target, porigin_decl, porigin_scope?, pvalueclass, puserconstant_prior*, porigin_seen*)
  -- if $compiled_redirect(S, porigin_site) = eps
  -- if $property_callable_projection(S, porigin_site) = (porigin_target)
def $global_constant_flow_at(S, porigin_site, porigin_decl, porigin_scope?, pvalueclass, puserconstant_prior*, porigin_seen*) = false -- otherwise
def $global_constant_array_flow(S, porigin_array, porigin_decl, porigin_scope?, n_item, eps, eps, i, puserconstant_prior*, porigin_seen*) = true
def $global_constant_array_flow(S, porigin_array, porigin_decl, porigin_scope?, n_item, (NArrayItem phpType5 expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType13*, (pkey, pvalueclass) :: (pkey_tail, pvalueclass_tail)*, i, puserconstant_prior*, porigin_seen*) = $global_constant_array_flow(S, porigin_array, porigin_decl, porigin_scope?, $(n_item + 1), phpType13*, (pkey_tail, pvalueclass_tail)*, $next_history(i, pkey), puserconstant_prior*, porigin_seen*)
  -- if porigin_item = $constant_child(porigin_array, [PCFIELD 0, PCINDEX n_item])
  -- if $constant_callable_flow_key(S, porigin_item, phpType5, i) = (pkey)
  -- if $global_constant_flow(S, $constant_child(porigin_item, [PCFIELD 1]), porigin_decl, porigin_scope?, pvalueclass, puserconstant_prior*, porigin_seen*)
def $global_constant_array_flow(S, porigin_array, porigin_decl, porigin_scope?, n_item, phpType13*, (pkey, pvalueclass)*, i, puserconstant_prior*, porigin_seen*) = false -- otherwise
def $global_constant_transfer_valid(S, porigin_decl, pvalueclass, puserconstant_prior*) = true
  -- if $constant_callable_foldable(pvalueclass) /\ $global_constant_class_supported(pvalueclass)
def $global_constant_transfer_valid(S, porigin_decl, pvalueclass, puserconstant_prior*) = $global_constant_flow(S, $constant_child(porigin_decl, [PCFIELD 1]), porigin_decl, porigin_scope?, pvalueclass, puserconstant_prior*, eps)
  -- if ~$constant_callable_foldable(pvalueclass)
  -- if $global_constant_class_supported(pvalueclass)
  -- if porigin_decl = PORIGIN n_unit pcpath_decl
  -- if $global_constant_declaration_source(S.SOURCES, porigin_decl)
  -- if $global_constant_scope(S, n_unit) = (true, porigin_scope?)
def $global_constant_transfer_valid(S, porigin_decl, pvalueclass, puserconstant_prior*) = false -- otherwise
def $global_constant_user_valid(S, puserconstant) = true
  -- if $constant_callable_foldable(puserconstant.CLASS) /\ $global_constant_class_supported(puserconstant.CLASS)
def $global_constant_user_valid(S, puserconstant) = $global_constant_transfer_valid(S, puserconstant.ORIGIN, puserconstant.CLASS, puserconstant_prior*)
  -- if ~$constant_callable_foldable(puserconstant.CLASS)
  -- if $global_constant_prefix(S.USERCONSTANTS, puserconstant.ORIGIN, eps) = (puserconstant_prior*)
def $global_constant_user_valid(S, puserconstant) = false -- otherwise

;; Registration warns before releasing its rejected candidate. The successful
;; earlier constant owns its value; only this genuine pending task owns the copy.
dec $global_constant_duplicate_message(preqbytes) : ptbytes
def $global_constant_duplicate_message(preqbytes) = $ptascii("Constant ") ++ $user_constant_key(preqbytes) ++ $ptascii(" already defined, this will be an error in PHP 9")
def $global_constant_duplicate(S, porigin_decl, preqbytes, pvalue, pvalueclass, z) = $error_dispatch(S_pending, 2, ptbytes_message, z, DIAGNOSTIC "Warning" ptbytes_message z, ptask_resume)
  -- if ptask_resume = GLOBAL_CONSTANT_DUPLICATE porigin_decl pvalue pvalueclass z
  -- if ptbytes_message = $global_constant_duplicate_message(preqbytes)
  -- if S_pending = S[.TODO = ptask_resume :: S.TODO][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
dec $global_constant_duplicate_valid(pstate, porigin, pvalue, pvalueclass, int) : bool
def $global_constant_duplicate_valid(S, porigin_decl, pvalue, pvalueclass, z) = true
  -- if S.ORIGIN = (porigin_decl)
  -- if S.CONSTCONTEXT = eps
  -- if porigin_decl = PORIGIN n_unit pcpath_decl
  -- if $global_constant_declaration_source(S.SOURCES, porigin_decl)
  -- if $declaration_entered(S.DECLARATIONS, n_unit)
  -- if $constant_declaration(S, porigin_decl) = ((preqbytes, z))
  -- if $source_constant_lookup(S, preqbytes) =/= eps
  -- if $constant_value_class_valid(S, pvalue, pvalueclass)
  -- if $global_constant_transfer_valid(S, porigin_decl, pvalueclass, S.USERCONSTANTS)
def $global_constant_duplicate_valid(S, porigin_decl, pvalue, pvalueclass, z) = false -- otherwise
def $task_nodes(GLOBAL_CONSTANT_DUPLICATE porigin_decl pvalue pvalueclass z) = $value_nodes(pvalue)
def $call_task_valid(S, GLOBAL_CONSTANT_DUPLICATE porigin_decl pvalue pvalueclass z) = $global_constant_duplicate_valid(S, porigin_decl, pvalue, pvalueclass, z)
rule PhpStep/global-constant-duplicate: S ~> S[.TODO = ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (GLOBAL_CONSTANT_DUPLICATE porigin_decl pvalue pvalueclass z) :: ptask_tail*
  -- if $global_constant_duplicate_valid(S, porigin_decl, pvalue, pvalueclass, z)
def $error_call_valid(S, perrorcall) = true
  -- if perrorcall.RESUME = GLOBAL_CONSTANT_DUPLICATE porigin_decl pvalue pvalueclass z
  -- if $global_constant_duplicate_valid(S, porigin_decl, pvalue, pvalueclass, z)
  -- if $constant_declaration(S, porigin_decl) = ((preqbytes, z))
  -- if perrorcall.SITE = porigin_decl /\ perrorcall.LEVEL = 2 /\ perrorcall.LINE = z
  -- if perrorcall.MESSAGE = $global_constant_duplicate_message(preqbytes)
  -- if perrorcall.EVENT = DIAGNOSTIC "Warning" perrorcall.MESSAGE z
