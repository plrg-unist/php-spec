  -- if $origin_node(S.SOURCES, porigin_site) = (expression)
def $global_constant_method_create(S, porigin_site, porigin_scope?) = $throw_scalar(S, "Error", $ptascii("Cannot call abstract method ") ++ pclassdesc.NAME ++ $ptascii("::") ++ pmethoddesc.NAME ++ $ptascii("()"), $runtime_line(S, eps, expression))
  -- if $global_constant_method(S, porigin_site, porigin_scope?, $constant_callable_prefix(S, porigin_site)) = ((pmethoddesc, porigin_called))
  -- if $method_accessible(S, pmethoddesc, porigin_scope?) /\ pmethoddesc.STATIC /\ pmethoddesc.ABSTRACT
  -- if $class_at(S.CLASSES, pmethoddesc.OWNER) = (pclassdesc)
  -- if $origin_node(S.SOURCES, porigin_site) = (expression)
def $global_constant_method_create(S, porigin_site, porigin_scope?) = $throw_scalar(S, "Error", $ptascii("Class \"") ++ ptbytes_class ++ $ptascii("\" not found"), $runtime_line(S, eps, expression))
  -- if $origin_node(S.SOURCES, porigin_site) = (NExprStaticCall phpType19 phpType20 phpType6 metadata)
  -- if $global_constant_class_name(S, porigin_site, porigin_scope?, phpType19) = (ptbytes_class)
  -- if $class_named(S.CLASSNAMES, $ptlc(ptbytes_class)) = eps
  -- if expression = NExprStaticCall phpType19 phpType20 phpType6 metadata
def $global_constant_method_create(S, porigin_site, porigin_scope?) = $throw_scalar(S, "Error", $ptascii("Call to undefined method ") ++ ptbytes_class ++ $ptascii("::") ++ ptbytes_method ++ $ptascii("()"), $runtime_line(S, eps, expression))
  -- if $origin_node(S.SOURCES, porigin_site) = (NExprStaticCall phpType19 phpType20 phpType6 metadata)
  -- if $global_constant_class_name(S, porigin_site, porigin_scope?, phpType19) = (ptbytes_class)
  -- if $class_named(S.CLASSNAMES, $ptlc(ptbytes_class)) = (porigin_called)
  -- if $constant_callable_method_name(phpType20) = (ptbytes_method)
  -- if $effective_method(S, porigin_called, $ptlc(ptbytes_method), |S.CLASSES|) = eps
  -- if expression = NExprStaticCall phpType19 phpType20 phpType6 metadata
def $global_constant_method_create(S, porigin_site, eps) = $throw_scalar(S, "Error", $ptascii("Cannot access \"") ++ $ptlc($base64(text)) ++ $ptascii("\" when no class scope is active"), $runtime_line(S, eps, expression))
  -- if $origin_node(S.SOURCES, porigin_site) = (NExprStaticCall (NName (BYTES text) metadata_name) phpType20 phpType6 metadata)
  -- if $ptlc($base64(text)) <- [$ptascii("self"), $ptascii("parent")]
  -- if expression = NExprStaticCall (NName (BYTES text) metadata_name) phpType20 phpType6 metadata
def $global_constant_method_create(S, porigin_site, porigin_scope?) = S[.COMPLETION = UNSUPPORTED "global constant callable class scope"] -- otherwise
def $constant_callable_method_create(S, porigin_site) = $global_constant_method_create(S, porigin_site, porigin_scope?)
  -- if $global_constant_callable_context(S, porigin_site) = ((porigin_decl, porigin_scope?))

;; AST trait warnings precede cache publication and object allocation. The
;; selected method and its source prefix survive the ordinary handler frame.
def $global_constant_method_message(S, porigin_method) = $ptascii("Calling static trait method ") ++ pclassdesc.NAME ++ $ptascii("::") ++ pmethoddesc.NAME ++ $ptascii(" is deprecated, it should only be called on a class using the trait")
  -- if $class_method_origin(S.CLASSES, porigin_method) = (pmethoddesc)
  -- if $class_at(S.CLASSES, pmethoddesc.OWNER) = (pclassdesc)
dec $global_constant_method_resume_valid(pstate, porigin, porigin, porigin, nat) : bool
def $global_constant_method_resume_valid(S, porigin_site, porigin_method, porigin_called, n_prefix) = true
