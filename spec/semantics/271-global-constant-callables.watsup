  -- if $effective_method(S, porigin_called, $ptlc(ptbytes_method), |S.CLASSES|) = (pmethoddesc)
def $global_constant_method(S, porigin_site, porigin_scope?, n_prefix) = eps -- otherwise
dec $global_constant_method_create(pstate, porigin, porigin?) : pstate
dec $global_constant_method_trait(pstate, pmethoddesc) : bool
