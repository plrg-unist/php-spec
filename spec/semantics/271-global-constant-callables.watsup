  -- if $method_accessible(S, pmethoddesc, porigin_scope?)
def $global_constant_method_resume_valid(S, porigin_site, porigin_method, porigin_called, n_prefix) = false -- otherwise
def $call_task_valid(S, GLOBAL_CONSTANT_METHOD_RESUME porigin_site porigin_method porigin_called n_prefix) = $global_constant_method_resume_valid(S, porigin_site, porigin_method, porigin_called, n_prefix)
rule PhpStep/global-constant-method-resume: S ~> $constant_callable_method_allocate(S[.TODO = ptask_tail*], porigin_site, pmethoddesc, porigin_called, $constant_callable_prefix(S, porigin_site))
