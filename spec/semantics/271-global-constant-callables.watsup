def $global_constant_method_create(S, porigin_site, porigin_scope?) = $error_dispatch(S_pending, 8192, ptbytes_message, z, DIAGNOSTIC "Deprecated" ptbytes_message z, ptask_resume)
  -- if n_prefix = $constant_callable_prefix(S, porigin_site)
