  -- if S_pending = S[.TODO = ptask_resume :: S.TODO][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
def $global_constant_method_create(S, porigin_site, porigin_scope?) = $method_denied(S, pmethoddesc, pmethoddesc.NAME, porigin_scope?, false, $runtime_line(S, eps, expression))
  -- if $global_constant_method(S, porigin_site, porigin_scope?, $constant_callable_prefix(S, porigin_site)) = ((pmethoddesc, porigin_called))
  -- if ~$method_accessible(S, pmethoddesc, porigin_scope?)
  -- if $origin_node(S.SOURCES, porigin_site) = (expression)
def $global_constant_method_create(S, porigin_site, porigin_scope?) = $throw_scalar(S, "Error", $ptascii("Non-static method ") ++ pclassdesc.NAME ++ $ptascii("::") ++ pmethoddesc.NAME ++ $ptascii("() cannot be called statically"), $runtime_line(S, eps, expression))
  -- if $global_constant_method(S, porigin_site, porigin_scope?, $constant_callable_prefix(S, porigin_site)) = ((pmethoddesc, porigin_called))
