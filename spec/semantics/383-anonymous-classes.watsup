  -- if $origin_node(S.SOURCES, porigin) = (NExprNew (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class) (SEQUENCE phpType7*) metadata)
  -- if $anonymous_new_name(S, porigin) = (ptbytes_name)
  -- if $new_has_ctor(S, ptbytes_name)

dec $anonymous_new_task_valid(pstate, expression) : bool
def $anonymous_new_task_valid(S, NExprNew (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class) (SEQUENCE eps) metadata) = true
  -- if S.ORIGIN = (porigin)
  -- if $origin_node(S.SOURCES, porigin) = (NExprNew (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class) (SEQUENCE eps) metadata)
  -- if $anonymous_new_name(S, porigin) =/= eps \/ $anonymous_new_pending(S, porigin) =/= eps
def $anonymous_new_task_valid(S, NExprNew (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class) (SEQUENCE phpType7*) metadata) = true
  -- if phpType7* =/= eps
  -- if S.ORIGIN = (porigin)
  -- if $origin_node(S.SOURCES, porigin) = (NExprNew (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class) (SEQUENCE phpType7*) metadata)
  -- if $anonymous_new_name(S, porigin) =/= eps \/ $anonymous_new_pending(S, porigin) =/= eps
def $anonymous_new_task_valid(S, expression) = false -- otherwise
def $call_task_valid(S, EVAL (NExprNew (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class) (SEQUENCE eps) metadata)) = $anonymous_new_task_valid(S, NExprNew (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class) (SEQUENCE eps) metadata)
def $call_task_valid(S, EVAL (NExprNew (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class) (SEQUENCE phpType7*) metadata)) = $anonymous_new_task_valid(S, NExprNew (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class) (SEQUENCE phpType7*) metadata)
  -- if phpType7* =/= eps

;; Dynamic units continue the request compiler's RTD sequence. Only closed,
;; successful compilation history is counted; runtime NEW visits do not count.
;; Site admission authenticates NEW/class-child structure and existing args.
;; Compiled descriptors decide key costs; pruned expressions lack them.
dec $anonymous_rtd_site(pcunit, pcpath) : bool
def $anonymous_rtd_site(pcunit, pcpath) = true
  -- if $(|pcpath| > 0)
  -- if pcpath_new = pcpath[0:$nabs($(|pcpath| - 1))]
  -- if pcpath = pcpath_new ++ [PCFIELD 0]
  -- if $origin_node([pcunit], PORIGIN pcunit.ID pcpath_new) = (NExprNew (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class) (SEQUENCE phpType7*) metadata)
  -- if $anonymous_new_arguments(phpType7*)
def $anonymous_rtd_site(pcunit, pcpath) = false -- otherwise

;; This admission count counts sites, not RTD keys. Actual key costs below
;; come from compiler descriptors; functions/Closures/arrows add no class keys.
dec $anonymous_rtd_nodes(pcunit, pcoccurrence*) : nat?
def $anonymous_rtd_nodes(pcunit, eps) = (0)
def $anonymous_rtd_nodes(pcunit, (PCOCCURRENCE pcpath pcnode) :: pcoccurrence*) = ($(n + 1))
  -- if $anonymous_class_node(pcnode)
  -- if $anonymous_rtd_site(pcunit, pcpath)
  -- if $anonymous_rtd_nodes(pcunit, pcoccurrence*) = (n)
def $anonymous_rtd_nodes(pcunit, (PCOCCURRENCE pcpath pcnode) :: pcoccurrence*) = $anonymous_rtd_nodes(pcunit, pcoccurrence*)
  -- if $anonymous_named_class_node(pcnode) \/ $anonymous_interface_node(pcnode) \/ $anonymous_co_resident_node(pcnode)
def $anonymous_rtd_nodes(pcunit, (PCOCCURRENCE pcpath pcnode) :: pcoccurrence*) = $anonymous_rtd_nodes(pcunit, pcoccurrence*)
  -- if ~$anonymous_class_like(pcnode)
def $anonymous_rtd_nodes(pcunit, pcoccurrence*) = eps -- otherwise

def $anonymous_rtd_unit(pcunit) = $anonymous_rtd_nodes(pcunit, pcunit.OCCURRENCES)
  -- if $anonymous_compilation_unit(pcunit)
def $anonymous_rtd_unit(pcunit) = eps -- otherwise

dec $anonymous_rtd_enter(pdeclaration) : nat?
def $anonymous_rtd_enter(PDENTER n porigin? z) = (n)
def $anonymous_rtd_enter(PDENTERPRECISION n porigin? z z_precision) = (n)
def $anonymous_rtd_enter(pdeclaration) = eps -- otherwise
dec $anonymous_rtd_exit(pdeclaration) : bool
def $anonymous_rtd_exit(PDEXIT n pcompilestop) = true
def $anonymous_rtd_exit(pdeclaration) = false -- otherwise

dec $anonymous_rtd_segment(pdeclaration*, nat) : pdeclaration*?
def $anonymous_rtd_segment((PDEXIT n PCSCOMPLETE) :: pdeclaration*, n) = (pdeclaration*)
def $anonymous_rtd_segment(pdeclaration :: pdeclaration_tail*, n) = $anonymous_rtd_segment(pdeclaration_tail*, n)
  -- if $anonymous_rtd_enter(pdeclaration) = eps /\ ~$anonymous_rtd_exit(pdeclaration)
def $anonymous_rtd_segment(pdeclaration*, n) = eps -- otherwise

dec $anonymous_rtd_count(pstate, pcunit) : nat?
def $anonymous_rtd_count(S, pcunit) = (n_counter)
  -- if pcunit.ID = 0 /\ $anonymous_unit(pcunit)
  -- if $compilation_projection(S, pcunit) = (ppinstalled)
  -- if $anonymous_class_count(pcunit, $call_sourcefile(S.FILES, PORIGIN 0 eps), ppinstalled.CLASSES, eps, 0) = (n_counter)
def $anonymous_rtd_count(S, pcunit) = ($nabs($(n_after - n_seed)))
  -- if $(pcunit.ID > 0) /\ $anonymous_rtd_unit(pcunit) =/= eps
  -- if $class_constant_compile_entry(S, pcunit.ID) = (S_entry)
  -- if $anonymous_history_seed(S, pcunit.ID) = (n_seed)
  -- if $compilation_projection(S, pcunit) = (ppinstalled)
  -- if $anonymous_compiled_class_count(pcunit, $call_sourcefile(S.FILES, PORIGIN pcunit.ID eps), ppinstalled.CLASSES, eps, (S_entry), n_seed) = (n_after)
  -- if $(n_after >= n_seed)
def $anonymous_rtd_count(S, pcunit) = eps -- otherwise

;; Parser rejection reserves a source ID but reaches no class compiler.
;; The existing failure record authenticates its actual service and filename.
dec $anonymous_parser_rejected(pstate, pdeclaration, nat) : bool
def $anonymous_parser_rejected(S, pdeclaration, n) = true
  -- if $(n > 0)
  -- if $declaration_entry_input(pdeclaration, n) = ((porigin_site?, z_reporting, z_precision))
  -- if porigin_site? = (PORIGIN n_site pcpath)
  -- if $(n_site < n)
  -- if $failed_source_at(S.FAILEDSOURCES, n) = (pfailedsource)
  -- if pfailedsource.SITE = PORIGIN n_site pcpath
  -- if $failed_source_record_valid(S, pfailedsource)
  -- if $source_unit(S.SOURCES, n) = eps /\ $code_at(S.CODE, n) = eps
  -- if $eval_binding_at(S.EVALBINDINGS, n) = eps /\ $file_binding_at(S.FILEBINDINGS, n) = eps
def $anonymous_parser_rejected(S, pdeclaration, n) = false -- otherwise

dec $anonymous_rtd_history(pstate, pdeclaration*, nat, nat, nat) : nat?
def $anonymous_rtd_history(S, eps, n, n, n_counter) = (n_counter)
  -- if $(n > 0)
def $anonymous_rtd_history(S, pdeclaration_entry :: (PDEXIT n_expected PCSREJECT) :: pdeclaration_tail*, n_expected, n_target, n_counter) = $anonymous_rtd_history(S, pdeclaration_tail*, $(n_expected + 1), n_target, n_counter)
  -- if $(n_expected < n_target)
  -- if $anonymous_parser_rejected(S, pdeclaration_entry, n_expected)
def $anonymous_rtd_history(S, pdeclaration :: pdeclaration_tail*, n_expected, n_target, n_counter) = $anonymous_rtd_history(S, pdeclaration_rest*, $(n_expected + 1), n_target, $(n_counter + n_count))
  -- if $(n_expected < n_target)
  -- if $anonymous_rtd_enter(pdeclaration) = (n_expected)
  -- if $source_unit(S.SOURCES, n_expected) = (pcunit)
  -- if $anonymous_rtd_count(S, pcunit) = (n_count)
  -- if $anonymous_rtd_segment(pdeclaration_tail*, n_expected) = (pdeclaration_rest*)
def $anonymous_rtd_history(S, pdeclaration :: pdeclaration_tail*, n_expected, n_target, n_counter) = $anonymous_rtd_history(S, pdeclaration_tail*, n_expected, n_target, n_counter)
  -- if $anonymous_rtd_enter(pdeclaration) = eps /\ ~$anonymous_rtd_exit(pdeclaration)
def $anonymous_rtd_history(S, pdeclaration*, n_expected, n_target, n_counter) = eps -- otherwise

def $anonymous_dynamic_seed(P) = $anonymous_rtd_history(S_external, S_external.DECLARATIONS, 0, P.FOLD.SOURCE.ID, 0)
  -- if $(P.FOLD.SOURCE.ID > 0)
  -- if P.FOLD.EXTERNAL = (S_external)
def $anonymous_dynamic_seed(P) = eps -- otherwise

def $anonymous_history_seed(S, n) = $anonymous_rtd_history(S, S.DECLARATIONS[0:n_prefix], 0, n, 0)
  -- if $(n > 0)
  -- if $class_constant_compile_prefix(S.DECLARATIONS, n, 0) = (n_prefix)
def $anonymous_history_seed(S, n) = eps -- otherwise
