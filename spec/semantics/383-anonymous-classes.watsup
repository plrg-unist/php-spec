def $anonymous_conditional_factory_path(pcunit, pcpath) = true
  -- if $(|pcpath| >= 3)
  -- if pcpath_if = pcpath[0:$nabs($(|pcpath| - 2))]
  -- if pcpath[$nabs($(|pcpath| - 2)):2] = [(PCFIELD 1),(PCINDEX n_factory)]
  -- if $anonymous_top_path(pcunit, pcpath_if) \/ $anonymous_conditional_factory_path(pcunit, pcpath_if)
  -- if $origin_node([pcunit], PORIGIN 0 pcpath_if) = (NStmtIf expression phpType23 phpType53 phpType55 metadata)
  -- if $origin_node([pcunit], PORIGIN 0 pcpath) =/= eps
def $anonymous_conditional_factory_path(pcunit, pcpath) = true
  -- if $(|pcpath| >= 5)
  -- if pcpath_if = pcpath[0:$nabs($(|pcpath| - 4))]
  -- if pcpath[$nabs($(|pcpath| - 4)):4] = [(PCFIELD 2),(PCINDEX n_elseif),(PCFIELD 1),(PCINDEX n_factory)]
  -- if $anonymous_top_path(pcunit, pcpath_if) \/ $anonymous_conditional_factory_path(pcunit, pcpath_if)
  -- if $origin_node([pcunit], PORIGIN 0 pcpath_if) = (NStmtIf expression phpType23 phpType53 phpType55 metadata)
  -- if $origin_node([pcunit], PORIGIN 0 (pcpath_if ++ [(PCFIELD 2),(PCINDEX n_elseif)])) = (NStmtElseIf expression_branch phpType23_branch metadata_branch)
  -- if $origin_node([pcunit], PORIGIN 0 pcpath) =/= eps
def $anonymous_conditional_factory_path(pcunit, pcpath) = true
  -- if $(|pcpath| >= 4)
  -- if pcpath_if = pcpath[0:$nabs($(|pcpath| - 3))]
  -- if pcpath[$nabs($(|pcpath| - 3)):3] = [(PCFIELD 3),(PCFIELD 0),(PCINDEX n_factory)]
  -- if $anonymous_top_path(pcunit, pcpath_if) \/ $anonymous_conditional_factory_path(pcunit, pcpath_if)
  -- if $origin_node([pcunit], PORIGIN 0 pcpath_if) = (NStmtIf expression phpType23 phpType53 phpType55 metadata)
  -- if $origin_node([pcunit], PORIGIN 0 (pcpath_if ++ [(PCFIELD 3)])) = (NStmtElse phpType23_branch metadata_branch)
  -- if $origin_node([pcunit], PORIGIN 0 pcpath) =/= eps
def $anonymous_conditional_factory_path(pcunit, pcpath) = true
  -- if $(|pcpath| >= 3)
  -- if pcpath_parent = pcpath[0:$nabs($(|pcpath| - 2))]
  -- if pcpath[$nabs($(|pcpath| - 2)):2] = [(PCFIELD 0),(PCINDEX n_child)]
  -- if $origin_node([pcunit], PORIGIN 0 pcpath_parent) = (NStmtBlock phpType23 metadata)
  -- if $origin_node([pcunit], PORIGIN 0 pcpath) =/= eps
  -- if $anonymous_conditional_factory_path(pcunit, pcpath_parent)
