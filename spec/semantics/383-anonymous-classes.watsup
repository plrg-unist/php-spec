  -- if pcpath[$nabs($(|pcpath| - 4)):4] = [(PCFIELD 2),(PCINDEX n_elseif),(PCFIELD 1),(PCINDEX n_factory)]
  -- if $anonymous_top_path(pcunit, pcpath_if) \/ $anonymous_conditional_factory_path(pcunit, pcpath_if) \/ $anonymous_while_factory_path(pcunit, pcpath_if) \/ $anonymous_do_factory_path(pcunit, pcpath_if)
  -- if $origin_node([pcunit], PORIGIN pcunit.ID pcpath_if) = (NStmtIf expression phpType23 phpType53 phpType55 metadata)
