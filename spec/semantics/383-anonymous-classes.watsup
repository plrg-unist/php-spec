  -- if $origin_node(S.SOURCES, PORIGIN 0 pcpath) = (NExprNew (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class) (SEQUENCE eps) metadata)
  -- if $compilation_projection(S, pcunit) = (ppinstalled)
  -- if $class_at(ppinstalled.CLASSES, PORIGIN 0 (pcpath ++ [PCFIELD 0])) = (pclassdesc)
  -- if $class_at(S.CLASSES, pclassdesc.ORIGIN) = (pclassdesc)
  -- if $anonymous_class_prefix(pcunit, $call_sourcefile(S.FILES, pclassdesc.ORIGIN), ppinstalled.CLASSES, 0)
  -- if $class_named(S.CLASSNAMES, $ptlc(pclassdesc.NAME)) = (pclassdesc.ORIGIN)
  -- if $declaration_early(S.DECLARATIONS, pclassdesc.ORIGIN, PPCLASS)
def $anonymous_new_name(S, porigin) = eps -- otherwise

;; Constructor selection and its result marker reuse the ordinary call receipt.
;; No-constructor NEW retains the direct allocation path below.
def $new_source_name(S, porigin) = (ptbytes_name)
  -- if $anonymous_new_name(S, porigin) = (ptbytes_name)
  -- if $new_has_ctor(S, ptbytes_name)

rule PhpStep/anonymous-new: S ~> $new_class(S[.TODO = ptask_tail*], ptbytes_name, $runtime_line(S, eps, NExprNew (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class) (SEQUENCE eps) metadata))
