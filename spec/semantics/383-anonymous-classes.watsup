dec $anonymous_unit_nodes(pcunit, pcoccurrence*) : bool
def $anonymous_unit_nodes(pcunit, eps) = true
def $anonymous_unit_nodes(pcunit, (PCOCCURRENCE pcpath pcnode) :: pcoccurrence*) = (($anonymous_unit_node(pcnode) \/ $anonymous_named_factory_path(pcunit, pcpath)) /\ $anonymous_unit_nodes(pcunit, pcoccurrence*))
dec $anonymous_compilation_unit(pcunit) : bool
def $anonymous_compilation_unit(pcunit) = (pcunit = $pcsource(pcunit.ID, pcunit.AST) /\ $anonymous_unit_nodes(pcunit, pcunit.OCCURRENCES))
dec $anonymous_unit(pcunit) : bool
def $anonymous_unit(pcunit) = (pcunit.ID = 0 /\ $anonymous_compilation_unit(pcunit))

;; Descriptor order follows the real compiler walk, including loop ordering.
;; Root block lists retain early binding; other enclosing statements do not.
