dec $ppanonymous_class(ppstate, pcpath, statement) : ppstate
def $ppanonymous_class(P, pcpath, statement) = P_next[.EARLY = P.EARLY][.LOCATION = P.LOCATION][.FOLD = P_next.FOLD[.VALUE = eps]]
  -- if $anonymous_compiler_unit(P) /\ $anonymous_class_node(statement)
  -- if $anonymous_parentless_class_node(statement)
  -- if ($ppimage_unit(P) \/ $anonymous_factory_context(P, pcpath)) /\ ~P.FOLD.CONSTANT
  -- if $origin_node([P.FOLD.SOURCE], PORIGIN P.FOLD.SOURCE.ID (pcpath ++ [PCFIELD 0])) = (statement)
  -- if $class_at(P.CLASSES, PORIGIN P.FOLD.SOURCE.ID (pcpath ++ [PCFIELD 0])) = eps
  -- if $anonymous_compiler_seed(P) = (n_seed)
  -- if $anonymous_compiled_class_count(P.FOLD.SOURCE, P.LOCATION.FILE, P.CLASSES, eps, P.FOLD.EXTERNAL, n_seed) = (n_counter)
  -- if $pchlower(statement) = PCHRAW pchraw
