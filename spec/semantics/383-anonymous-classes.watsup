;; Other named scopes retain their whole-unit exclusion.
dec $anonymous_named_scope(pcnode) : bool
def $anonymous_named_scope(NStmtNamespace phpType44 phpType23 metadata) = ($anonymous_namespace_name(NStmtNamespace phpType44 phpType23 metadata) = eps)
def $anonymous_named_scope(NStmtFunction phpType14 phpType4 phpType11 phpType16 phpType18 phpType23 metadata) = true
def $anonymous_named_scope(NExprClosure phpType14 phpType4_static phpType4_byref phpType16 phpType21 phpType18 phpType23 metadata) = true
def $anonymous_named_scope(pcnode) = false -- otherwise
dec $anonymous_no_named_classes(pcoccurrence*) : bool
def $anonymous_no_named_classes(eps) = true
def $anonymous_no_named_classes((PCOCCURRENCE pcpath pcnode) :: pcoccurrence*) = ((~$anonymous_class_like(pcnode) \/ $anonymous_class_node(pcnode)) /\ $anonymous_no_named_classes(pcoccurrence*))

dec $anonymous_unit_node(pcnode) : bool
def $anonymous_unit_node(pcnode) = (($anonymous_class_node(pcnode) \/ $anonymous_named_class_node(pcnode)) /\ $anonymous_no_classes($pcwalk($pcchildren(pcnode, eps))))
  -- if $anonymous_class_like(pcnode)
def $anonymous_unit_node(pcnode) = $anonymous_no_named_classes($pcwalk($pcchildren(pcnode, eps)))
  -- if ~$anonymous_class_like(pcnode) /\ $anonymous_named_scope(pcnode)
def $anonymous_unit_node(pcnode) = true -- if ~$anonymous_class_like(pcnode) /\ ~$anonymous_named_scope(pcnode)
