  -- if P.CLASSCONTEXT = eps /\ P.FOLD.CLASSCONTEXT = eps
  -- if P.CLOSURE = P.FOLD.CLOSURE
  -- if ~P.FOLD.CONSTANT /\ ~P.FOLD.DEFAULT
  -- if $origin_node([P.FOLD.SOURCE], PORIGIN 0 (P.GOTOROOT)) = (pcnode)
  -- if $anonymous_factory_source(P, pcnode) = ((ptbytes_name, n_body))
  -- if P.FOLD.FUNCTION = ptbytes_name
  -- if pcpath_body = P.GOTOROOT ++ [PCFIELD n_body]
  -- if $(|pcpath_body| < |pcpath|)
  -- if pcpath[0:|pcpath_body|] = pcpath_body
def $anonymous_factory_context(P, pcpath) = false -- otherwise

def $ppimage_publication_ready(P, PORIGIN 0 pcpath, PPCLASS) = true
  -- if ~$ppimage_unit(P) /\ $anonymous_factory_context(P, pcpath)
  -- if $origin_node([P.FOLD.SOURCE], PORIGIN 0 pcpath) = (pcnode)
  -- if $anonymous_class_node(pcnode)
  -- if $anonymous_class_prefix(P.FOLD.SOURCE, P.LOCATION.FILE, P.CLASSES, 0)
  -- if $class_at(P.CLASSES, PORIGIN 0 pcpath) = (pclassdesc)
  -- if pclassdesc.EARLY

dec $ppanonymous_class(ppstate, pcpath, statement) : ppstate
def $ppanonymous_class(P, pcpath, statement) = P_next[.EARLY = P.EARLY][.LOCATION = P.LOCATION][.FOLD = P_next.FOLD[.VALUE = eps]]
  -- if $anonymous_unit(P.FOLD.SOURCE) /\ $anonymous_class_node(statement)
  -- if ($ppimage_unit(P) \/ $anonymous_factory_context(P, pcpath)) /\ ~P.FOLD.CONSTANT
  -- if $origin_node([P.FOLD.SOURCE], PORIGIN 0 (pcpath ++ [PCFIELD 0])) = (statement)
  -- if $class_at(P.CLASSES, PORIGIN 0 (pcpath ++ [PCFIELD 0])) = eps
  -- if $anonymous_class_count(P.FOLD.SOURCE, P.LOCATION.FILE, P.CLASSES, eps, 0) = (n_counter)
  -- if $pchlower(statement) = PCHRAW pchraw
  -- if z_line = $source_line($pcmetadata(statement))
  -- if $anonymous_class_name(P.LOCATION.FILE, z_line, n_counter) = (ptbytes_name)
  -- if P_class = $pplocate(P[.EARLY = (pcpath ++ [PCFIELD 0])], pcpath ++ [PCFIELD 0], z_line)
  -- if P_next = $ppclass_result(P_class, pcpath ++ [PCFIELD 0], PCHOK { KIND "class", NAME ptbytes_name, ABSTRACT false, FINAL false, READONLY false, PARENT eps, INTERFACES eps, BODY pchraw.BODY } eps)
def $ppanonymous_class(P, pcpath, statement) = $ppunsupported(P, "anonymous class RTD, body, or compiler publication context") -- otherwise
def $ppdispatch(P, pcpath, NExprNew (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class) (SEQUENCE eps) metadata, PPR) = $ppanonymous_class(P, pcpath, NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class)

;; The live name already exists before the first NEW. Recompute the installed
;; source descriptor to authenticate the site, filename, line and counter.
dec $anonymous_new_name(pstate, porigin) : ptbytes?
def $anonymous_new_name(S, PORIGIN 0 pcpath) = (pclassdesc.NAME)
  -- if $source_unit(S.SOURCES, 0) = (pcunit)
