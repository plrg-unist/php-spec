dec $anonymous_class_like(pcnode) : bool
def $anonymous_class_like(NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata) = true
def $anonymous_class_like(NStmtInterface phpType14 phpType3 phpType42 phpType23 metadata) = true
def $anonymous_class_like(NStmtTrait phpType14 phpType3 phpType23 metadata) = true
def $anonymous_class_like(NStmtEnum phpType14 phpType3 phpType50 phpType42 phpType23 metadata) = true
def $anonymous_class_like(pcnode) = false -- otherwise
dec $anonymous_no_classes(pcoccurrence*) : bool
def $anonymous_no_classes(eps) = true
def $anonymous_no_classes((PCOCCURRENCE pcpath pcnode) :: pcoccurrence*) = (~$anonymous_class_like(pcnode) /\ $anonymous_no_classes(pcoccurrence*))

