  -- if $anonymous_class_name(P.LOCATION.FILE, z_line, n_counter) = (ptbytes_name)
  -- if P_class = $pplocate(P[.EARLY = (pcpath ++ [PCFIELD 0])], pcpath ++ [PCFIELD 0], z_line)
  -- if P_next = $ppclass_result(P_class, pcpath ++ [PCFIELD 0], PCHOK { KIND "class", NAME ptbytes_name, ABSTRACT false, FINAL false, READONLY false, PARENT eps, INTERFACES eps, BODY pchraw.BODY } eps)
def $ppanonymous_class(P, pcpath, statement) = P_next[.EARLY = P.EARLY][.LOCATION = P.LOCATION][.FOLD = P_next.FOLD[.VALUE = eps]]
  -- if $anonymous_compiler_unit(P) /\ $anonymous_class_node(statement)
  -- if ~$anonymous_parentless_class_node(statement)
  -- if ($ppimage_unit(P) \/ $anonymous_factory_context(P, pcpath)) /\ ~P.FOLD.CONSTANT
  -- if $origin_node([P.FOLD.SOURCE], PORIGIN P.FOLD.SOURCE.ID (pcpath ++ [PCFIELD 0])) = (statement)
  -- if $class_at(P.CLASSES, PORIGIN P.FOLD.SOURCE.ID (pcpath ++ [PCFIELD 0])) = eps
  -- if $anonymous_compiler_seed(P) = (n_seed)
  -- if $anonymous_compiled_class_count(P.FOLD.SOURCE, P.LOCATION.FILE, P.CLASSES, eps, P.FOLD.EXTERNAL, n_seed) = (n_counter)
  -- if $pchlower(statement) = PCHRAW pchraw
  -- if z_line = $source_line($pcmetadata(statement))
  -- if P_class = $pplocate(P[.EARLY = eps], pcpath ++ [PCFIELD 0], z_line)
  -- if $pchparent(pchraw.PARENT, $ppclass_context(P_class)) = PCHNAMES ptbytes_parent* eps
  -- if ptbytes_parent_option? = $pchparentoption(ptbytes_parent*)
  -- if pchraw.INTERFACES = SEQUENCE name*
  -- if $pchrefs(name*, "interface name", $ppclass_context(P_class)) = PCHNAMES ptbytes_interface* eps
  -- if $anonymous_interface_prefix(ptbytes_parent_option?, ptbytes_interface*) = (ptbytes_prefix)
  -- if $anonymous_parent_class_name(ptbytes_prefix, P.LOCATION.FILE, z_line, n_counter) = (ptbytes_name)
  -- if P_next = $ppclass_result(P_class, pcpath ++ [PCFIELD 0], PCHOK { KIND "class", NAME ptbytes_name, ABSTRACT false, FINAL false, READONLY false, PARENT ptbytes_parent_option?, INTERFACES ptbytes_interface*, BODY pchraw.BODY } eps)
def $ppanonymous_class(P, pcpath, statement) = $ppunsupported(P, "anonymous class RTD, body, or compiler publication context") -- otherwise
def $ppdispatch(P, pcpath, NExprNew (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class) (SEQUENCE eps) metadata, PPR) = $ppanonymous_class(P, pcpath, NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class)
dec $anonymous_new_arguments(phpType7*) : bool
def $anonymous_new_arguments(eps) = true
def $anonymous_new_arguments((NArg ABSENT expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType7*) = $anonymous_new_arguments(phpType7*)
def $anonymous_new_arguments((NArg (NIdentifier (BYTES text) metadata_name) expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType7*) = ($ptvalidname($base64(text), false) /\ $anonymous_new_arguments(phpType7*))
def $anonymous_new_arguments(phpType7*) = false -- otherwise
def $ppdispatch(P, pcpath, NExprNew (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class) (SEQUENCE phpType7*) metadata, PPR) = $ppcall_args($ppanonymous_class(P, pcpath, NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class), pcpath ++ [PCFIELD 1], 0, phpType7*, PNUNSUPPORTED "constructor has deferred argument modes")
