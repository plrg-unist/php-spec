  -- if $origin_node([pcunit], PORIGIN pcunit.ID pcpath) =/= eps
  -- if $anonymous_while_factory_path(pcunit, pcpath_parent)
def $anonymous_while_factory_path(pcunit, pcpath) = false -- otherwise
def $anonymous_do_factory_path(pcunit, pcpath) = true
  -- if $(|pcpath| >= 3)
  -- if pcpath_do = pcpath[0:$nabs($(|pcpath| - 2))]
  -- if pcpath[$nabs($(|pcpath| - 2)):2] = [(PCFIELD 0),(PCINDEX n_factory)]
  -- if $anonymous_top_path(pcunit, pcpath_do) \/ $anonymous_conditional_factory_path(pcunit, pcpath_do) \/ $anonymous_while_factory_path(pcunit, pcpath_do) \/ $anonymous_do_factory_path(pcunit, pcpath_do)
  -- if $origin_node([pcunit], PORIGIN pcunit.ID pcpath_do) = (NStmtDo phpType23 expression metadata)
  -- if $origin_node([pcunit], PORIGIN pcunit.ID pcpath) =/= eps
def $anonymous_do_factory_path(pcunit, pcpath) = true
  -- if $(|pcpath| >= 3)
  -- if pcpath_parent = pcpath[0:$nabs($(|pcpath| - 2))]
  -- if pcpath[$nabs($(|pcpath| - 2)):2] = [(PCFIELD 0),(PCINDEX n_child)]
  -- if $origin_node([pcunit], PORIGIN pcunit.ID pcpath_parent) = (NStmtBlock phpType23 metadata)
  -- if $origin_node([pcunit], PORIGIN pcunit.ID pcpath) =/= eps
  -- if $anonymous_do_factory_path(pcunit, pcpath_parent)
def $anonymous_do_factory_path(pcunit, pcpath) = false -- otherwise
dec $anonymous_named_factory_path(pcunit, pcpath) : bool
def $anonymous_named_factory_path(pcunit, pcpath) = true
  -- if $origin_node([pcunit], PORIGIN pcunit.ID pcpath) = (pcnode)
  -- if $anonymous_named_factory_node(pcnode)
  -- if $anonymous_top_path(pcunit, pcpath) \/ $anonymous_conditional_factory_path(pcunit, pcpath) \/ $anonymous_while_factory_path(pcunit, pcpath) \/ $anonymous_do_factory_path(pcunit, pcpath)
def $anonymous_named_factory_path(pcunit, pcpath) = true
  -- if $(|pcpath| >= 3)
  -- if pcpath_statement = pcpath[0:$nabs($(|pcpath| - 2))]
  -- if pcpath = pcpath_statement ++ [(PCFIELD 0),(PCFIELD 1)]
  -- if $origin_node([pcunit], PORIGIN pcunit.ID pcpath_statement) = (pcnode)
  -- if $anonymous_named_closure_statement(pcnode)
  -- if $anonymous_top_path(pcunit, pcpath_statement) \/ $anonymous_conditional_factory_path(pcunit, pcpath_statement) \/ $anonymous_while_factory_path(pcunit, pcpath_statement) \/ $anonymous_do_factory_path(pcunit, pcpath_statement)
def $anonymous_named_factory_path(pcunit, pcpath) = false -- otherwise
dec $anonymous_unit_nodes(pcunit, pcoccurrence*) : bool
def $anonymous_unit_nodes(pcunit, eps) = true
def $anonymous_unit_nodes(pcunit, (PCOCCURRENCE pcpath pcnode) :: pcoccurrence*) = (($anonymous_unit_node(pcnode) \/ $anonymous_named_factory_path(pcunit, pcpath)) /\ $anonymous_unit_nodes(pcunit, pcoccurrence*))
dec $anonymous_compilation_unit(pcunit) : bool
def $anonymous_compilation_unit(pcunit) = (pcunit = $pcsource(pcunit.ID, pcunit.AST) /\ $anonymous_unit_nodes(pcunit, pcunit.OCCURRENCES))
dec $anonymous_unit(pcunit) : bool
def $anonymous_unit(pcunit) = (pcunit.ID = 0 /\ $anonymous_compilation_unit(pcunit))

;; Descriptor order follows the real compiler walk, including loop ordering.
;; Root block lists retain early binding; other enclosing statements do not.
dec $anonymous_top_block(pcunit, pcpath, pcpath) : bool
def $anonymous_top_block(pcunit, pcpath_prefix, eps) = ($origin_node([pcunit], PORIGIN pcunit.ID pcpath_prefix) =/= eps)
def $anonymous_top_block(pcunit, pcpath_prefix, (PCFIELD 0) :: (PCINDEX n) :: pcpath_tail) = $anonymous_top_block(pcunit, pcpath_prefix ++ [(PCFIELD 0),(PCINDEX n)], pcpath_tail)
  -- if $origin_node([pcunit], PORIGIN pcunit.ID pcpath_prefix) = (NStmtBlock phpType23 metadata)
def $anonymous_top_block(pcunit, pcpath_prefix, pcpath_tail) = false -- otherwise
def $anonymous_top_path(pcunit, (PCINDEX n) :: (PCFIELD 1) :: (PCINDEX n_body) :: pcpath_tail) = $anonymous_top_block(pcunit, [(PCINDEX n),(PCFIELD 1),(PCINDEX n_body)], pcpath_tail)
  -- if $origin_node([pcunit], PORIGIN pcunit.ID ([(PCINDEX n)])) = (pcnode)
  -- if $anonymous_namespace_name(pcnode) = (ptbytes)
def $anonymous_top_path(pcunit, (PCINDEX n) :: pcpath_tail) = $anonymous_top_block(pcunit, [(PCINDEX n)], pcpath_tail)
  -- if $origin_node([pcunit], PORIGIN pcunit.ID ([(PCINDEX n)])) = (pcnode)
  -- if ~$anonymous_namespace_tag(pcnode)
def $anonymous_top_path(pcunit, pcpath) = false -- otherwise
dec $anonymous_named_early(pcunit, pcpath, pclassdesc*, ptbytes) : bool
def $anonymous_named_early(pcunit, pcpath, pclassdesc*, ptbytes) = ($anonymous_top_path(pcunit, pcpath) /\ ~$ppclass_early(pclassdesc*, ptbytes) /\ ~$class_internal(ptbytes))
dec $anonymous_named_key(bool) : nat
def $anonymous_named_key(true) = 0
def $anonymous_named_key(false) = 1
dec $anonymous_interface_prefix(ptbytes?, ptbytes*) : ptbytes?
def $anonymous_interface_prefix((ptbytes_parent), ptbytes*) = (ptbytes_parent)
def $anonymous_interface_prefix(eps, ptbytes :: ptbytes_tail*) = (ptbytes)
def $anonymous_interface_prefix(ptbytes_parent?, ptbytes_interface*) = eps -- otherwise
;; This header view delegates declaration rules to the ordinary compiler.
;; The caller's prefix descriptors already contain its normalized own methods.
dec $anonymous_named_header(pcnode, ptcontext) : (pchheader, int)?
def $anonymous_named_header(NStmtClass phpType14 phpType24 (NIdentifier (BYTES text) metadata_name) phpType44 phpType42 phpType23 metadata, ptcontext) = ((pchheader, z_line))
  -- if $class_header_line(metadata, NIdentifier (BYTES text) metadata_name, phpType14) = z_line
  -- if $(z_line > 0)
  -- if $pchcompile(NStmtClass phpType14 phpType24 (NIdentifier (BYTES text) metadata_name) phpType44 phpType42 phpType23 metadata, false, ptcontext[.LINE = $nabs(z_line)]) = PCHOK pchheader pchdiagnostic*
def $anonymous_named_header(NStmtInterface phpType14 (NIdentifier (BYTES text) metadata_name) phpType42 phpType23 metadata, ptcontext) = ((pchheader, z_line))
  -- if $class_header_line(metadata, NIdentifier (BYTES text) metadata_name, phpType14) = z_line
  -- if $(z_line > 0)
  -- if $pchcompile(NStmtInterface phpType14 (NIdentifier (BYTES text) metadata_name) phpType42 phpType23 metadata, false, ptcontext[.LINE = $nabs(z_line)]) = PCHOK pchheader pchdiagnostic*
def $anonymous_named_header(NStmtTrait phpType14 (NIdentifier (BYTES text) metadata_name) phpType23 metadata, ptcontext) = ((pchheader, z_line))
  -- if $class_header_line(metadata, NIdentifier (BYTES text) metadata_name, phpType14) = z_line
  -- if $(z_line > 0)
  -- if $pchcompile(NStmtTrait phpType14 (NIdentifier (BYTES text) metadata_name) phpType23 metadata, false, ptcontext[.LINE = $nabs(z_line)]) = PCHOK pchheader pchdiagnostic*
def $anonymous_named_header(NStmtEnum phpType14 (NIdentifier (BYTES text) metadata_name) phpType50 phpType42 phpType23 metadata, ptcontext) = ((pchheader, z_line))
  -- if $class_header_line(metadata, NIdentifier (BYTES text) metadata_name, phpType14) = z_line
  -- if $(z_line > 0)
  -- if $pchcompile(NStmtEnum phpType14 (NIdentifier (BYTES text) metadata_name) phpType50 phpType42 phpType23 metadata, false, ptcontext[.LINE = $nabs(z_line)]) = PCHOK pchheader pchdiagnostic*
def $anonymous_named_header(pcnode, ptcontext) = eps -- otherwise

;; Kind-specific implicit interfaces come from the ordinary compiler helpers.
;; The enum clause and final refusal live with that compiler in436.
dec $anonymous_header_interfaces(pcnode, pchheader, pmethoddesc*) : ptbytes*?
def $anonymous_header_interfaces(pcnode, pchheader, pmethoddesc*) = ($ppclass_interfaces(pchheader.INTERFACES, pmethoddesc*))
  -- if pchheader.KIND <- ["class", "interface"]
def $anonymous_header_interfaces(pcnode, pchheader, pmethoddesc*) = (pchheader.INTERFACES)
  -- if pchheader.KIND = "trait"

dec $anonymous_compiled_class_count(pcunit, ptbytes, pclassdesc*, pclassdesc*, pstate?, nat) : nat?
def $anonymous_compiled_class_count(pcunit, ptbytes_file, eps, pclassdesc_seen*, pstate_external?, n_counter) = (n_counter)
def $anonymous_compiled_class_count(pcunit, ptbytes_file, pclassdesc :: pclassdesc_tail*, pclassdesc_seen*, pstate_external?, n_counter) = $anonymous_compiled_class_count(pcunit, ptbytes_file, pclassdesc_tail*, pclassdesc_seen* ++ [pclassdesc], pstate_external?, $(n_counter + 1))
  -- if pclassdesc.ORIGIN = PORIGIN pcunit.ID pcpath
  -- if $origin_node([pcunit], pclassdesc.ORIGIN) = (NStmtClass (SEQUENCE eps) (INTEGER flags) ABSENT ABSENT (SEQUENCE eps) (SEQUENCE statement*) metadata)
  -- if $anonymous_parentless_class_node(NStmtClass (SEQUENCE eps) (INTEGER flags) ABSENT ABSENT (SEQUENCE eps) (SEQUENCE statement*) metadata)
  -- if pclassdesc.PARENT = eps
  -- if pclassdesc.LINE = $anonymous_class_line(flags, metadata)
  -- if pclassdesc.READONLY = (flags = 64)
  -- if $anonymous_class_name(ptbytes_file, pclassdesc.LINE, n_counter) = (pclassdesc.NAME)
  -- if pclassdesc.INTERFACES = $ppclass_interfaces(eps, pclassdesc.METHODS)
  -- if pclassdesc.KIND = "class" /\ pclassdesc.EARLY = (pclassdesc.INTERFACES = eps /\ ~$pptrait_body_uses(SEQUENCE statement*))
  -- if $class_at(pclassdesc_tail*, pclassdesc.ORIGIN) = eps
def $anonymous_compiled_class_count(pcunit, ptbytes_file, pclassdesc :: pclassdesc_tail*, pclassdesc_seen*, pstate_external?, n_counter) = $anonymous_compiled_class_count(pcunit, ptbytes_file, pclassdesc_tail*, pclassdesc_seen* ++ [pclassdesc], pstate_external?, $(n_counter + 1))
  -- if pclassdesc.ORIGIN = PORIGIN pcunit.ID pcpath
  -- if $origin_node([pcunit], pclassdesc.ORIGIN) = (NStmtClass phpType14 (INTEGER flags) phpType3 phpType44 (SEQUENCE name*) phpType23 metadata)
  -- if $anonymous_class_node(NStmtClass phpType14 (INTEGER flags) phpType3 phpType44 (SEQUENCE name*) phpType23 metadata)
  -- if ~$anonymous_parentless_class_node(NStmtClass phpType14 (INTEGER flags) phpType3 phpType44 (SEQUENCE name*) phpType23 metadata)
  -- if $plclasscontext(pcunit, pcpath, ptbytes_file, pclassdesc.LINE) = (ptcontext)
  -- if $pchrefs(name*, "interface name", ptcontext) = PCHNAMES ptbytes_interface* eps
  -- if $pchparent(phpType44, ptcontext) = PCHNAMES ptbytes_parent* eps
  -- if pclassdesc.PARENT = $pchparentoption(ptbytes_parent*)
  -- if pclassdesc.INTERFACES = $ppclass_interfaces(ptbytes_interface*, pclassdesc.METHODS)
  -- if $anonymous_interface_prefix(pclassdesc.PARENT, ptbytes_interface*) = (ptbytes_prefix)
  -- if $anonymous_parent_class_name(ptbytes_prefix, ptbytes_file, pclassdesc.LINE, n_counter) = (pclassdesc.NAME)
  -- if pclassdesc.KIND = "class" /\ ~pclassdesc.EARLY
  -- if pclassdesc.LINE = $anonymous_class_line(flags, metadata)
  -- if pclassdesc.READONLY = (flags = 64)
  -- if $class_at(pclassdesc_tail*, pclassdesc.ORIGIN) = eps
def $anonymous_compiled_class_count(pcunit, ptbytes_file, pclassdesc :: pclassdesc_tail*, pclassdesc_seen*, pstate_external?, n_counter) = $anonymous_compiled_class_count(pcunit, ptbytes_file, pclassdesc_tail*, pclassdesc_seen* ++ [pclassdesc], pstate_external?, $(n_counter + $anonymous_named_key(b_early)))
  -- if pclassdesc.ORIGIN = PORIGIN pcunit.ID pcpath
  -- if $origin_node([pcunit], pclassdesc.ORIGIN) = (pcnode)
  -- if $plclasscontext(pcunit, pcpath, ptbytes_file, pclassdesc.LINE) = (ptcontext)
  -- if $anonymous_named_header(pcnode, ptcontext) = ((pchheader, z_line))
  -- if pclassdesc.KIND = pchheader.KIND /\ pclassdesc.NAME = pchheader.NAME
  -- if pclassdesc.PARENT = pchheader.PARENT
  -- if $anonymous_header_interfaces(pcnode, pchheader, pclassdesc.METHODS) = (pclassdesc.INTERFACES)
  -- if pclassdesc.ABSTRACT = pchheader.ABSTRACT /\ pclassdesc.FINAL = pchheader.FINAL /\ pclassdesc.READONLY = pchheader.READONLY
  -- if b_early = ($anonymous_named_early(pcunit, pcpath, pclassdesc_seen*, pchheader.NAME) /\ ~$ppclass_external_known(pstate_external?, pchheader.NAME) /\ $ppclass_parent_available(pclassdesc_seen*, pstate_external?, pchheader.PARENT) /\ pclassdesc.INTERFACES = eps /\ ~$pptrait_body_uses(pchheader.BODY))
  -- if pclassdesc.EARLY = b_early /\ pclassdesc.LINE = $nabs(z_line)
  -- if $class_at(pclassdesc_tail*, pclassdesc.ORIGIN) = eps
def $anonymous_compiled_class_count(pcunit, ptbytes_file, pclassdesc*, pclassdesc_seen*, pstate_external?, n_counter) = eps -- otherwise

dec $anonymous_class_count(pcunit, ptbytes, pclassdesc*, pclassdesc*, nat) : nat?
def $anonymous_class_count(pcunit, ptbytes_file, pclassdesc*, pclassdesc_seen*, n_counter) = $anonymous_compiled_class_count(pcunit, ptbytes_file, pclassdesc*, pclassdesc_seen*, eps, n_counter)

dec $anonymous_class_prefix(pcunit, ptbytes, pclassdesc*, nat) : bool
def $anonymous_class_prefix(pcunit, ptbytes_file, pclassdesc*, n_counter) = ($anonymous_class_count(pcunit, ptbytes_file, pclassdesc*, eps, n_counter) =/= eps)

;; These factory bodies restore their own CV/code scope before the unit
;; image is saved. Only the class checkpoint is recorded inside the body.
dec $anonymous_factory_source(ppstate, pcnode) : (ptbytes, nat)?
def $anonymous_factory_source(P, NStmtFunction (SEQUENCE eps) (BOOLEAN false) (NIdentifier (BYTES text) metadata_name) (SEQUENCE eps) ABSENT (SEQUENCE statement*) metadata) = (($ptjoin(P.ENV.NAMESPACE, $base64(text)), 5))
  -- if ~P.CLOSURE
def $anonymous_factory_source(P, NExprClosure (SEQUENCE eps) (BOOLEAN true) (BOOLEAN false) (SEQUENCE eps) (SEQUENCE eps) ABSENT (SEQUENCE statement*) metadata) = (($ptascii("{closure:") ++ P.LOCATION.FILE ++ [58] ++ $ntunsigned($psline(metadata)) ++ [125], 6))
  -- if P.CLOSURE
def $anonymous_factory_source(P, pcnode) = eps -- otherwise

dec $anonymous_rtd_unit(pcunit) : nat?
dec $anonymous_dynamic_seed(ppstate) : nat?
dec $anonymous_compiler_seed(ppstate) : nat?
def $anonymous_compiler_seed(P) = (0) -- if P.FOLD.SOURCE.ID = 0
def $anonymous_compiler_seed(P) = $anonymous_dynamic_seed(P) -- if $(P.FOLD.SOURCE.ID > 0)

dec $anonymous_compiler_unit(ppstate) : bool
def $anonymous_compiler_unit(P) = $anonymous_unit(P.FOLD.SOURCE) -- if P.FOLD.SOURCE.ID = 0
def $anonymous_compiler_unit(P) = ($anonymous_rtd_unit(P.FOLD.SOURCE) =/= eps /\ P.EVALCLASS = eps /\ P.DIAGNOSTICS = eps)
  -- if $(P.FOLD.SOURCE.ID > 0)

;; Zend allocates the anonymous owner's key before compiling its members.
;; The provisional descriptor is compiler-local until the whole body succeeds.
dec $anonymous_owner_key(ppstate, pcpath, pchheader, int, nat) : bool
def $anonymous_owner_key(P, pcpath, pchheader, z_line, n_counter) = true
  -- if pchheader.PARENT = eps /\ P.EARLY = (pcpath)
  -- if $anonymous_class_name(P.LOCATION.FILE, z_line, n_counter) = (pchheader.NAME)
def $anonymous_owner_key(P, pcpath, pchheader, z_line, n_counter) = true
  -- if pchheader.PARENT = (ptbytes_parent)
  -- if P.EARLY = eps
  -- if $anonymous_parent_class_name(ptbytes_parent, P.LOCATION.FILE, z_line, n_counter) = (pchheader.NAME)
def $anonymous_owner_key(P, pcpath, pchheader, z_line, n_counter) = false -- otherwise
def $anonymous_owner_factory_header(P, pcpath, pchheader) = true
  -- if P.COMPLETION = PPCNORMAL /\ P.FOLD.SOURCE.ID = 0
  -- if $origin_node([P.FOLD.SOURCE], PORIGIN 0 pcpath) = (NStmtClass (SEQUENCE eps) (INTEGER flags) ABSENT phpType44 (SEQUENCE eps) (SEQUENCE statement*) metadata)
  -- if $anonymous_owner_factory_node(NStmtClass (SEQUENCE eps) (INTEGER flags) ABSENT phpType44 (SEQUENCE eps) (SEQUENCE statement*) metadata)
  -- if $class_at(P.CLASSES, PORIGIN 0 pcpath) = eps
  -- if pchheader.KIND = "class" /\ ~pchheader.ABSTRACT /\ ~pchheader.FINAL
  -- if pchheader.BODY = SEQUENCE statement* /\ pchheader.INTERFACES = eps
  -- if pchheader.READONLY = (flags = 64)
  -- if $pchparent(phpType44, $ppclass_context(P)) = PCHNAMES ptbytes_parent* eps
  -- if pchheader.PARENT = $pchparentoption(ptbytes_parent*)
  -- if z_line = $anonymous_class_line(flags, metadata)
  -- if P.LOCATION.LINE = z_line
  -- if $anonymous_compiled_class_count(P.FOLD.SOURCE, P.LOCATION.FILE, P.CLASSES, eps, P.FOLD.EXTERNAL, 0) = (n_counter)
  -- if $anonymous_owner_key(P, pcpath, pchheader, z_line, n_counter)
def $anonymous_owner_factory_header(P, pcpath, pchheader) = false -- otherwise

dec $anonymous_owner_reserve(ppstate, pcpath, pchheader) : ppstate
def $anonymous_owner_reserve(P, pcpath, pchheader) = P[.CLASSES = P.CLASSES ++ [{ ORIGIN PORIGIN 0 pcpath, KIND "class", NAME pchheader.NAME, PARENT pchheader.PARENT, INTERFACES eps, PROPERTIES eps, METHODS eps, CONSTANTS eps, ABSTRACT false, FINAL false, READONLY pchheader.READONLY, EARLY (pchheader.PARENT = eps), LINE P.LOCATION.LINE }]]
  -- if P.COMPLETION = PPCNORMAL
def $anonymous_owner_reserve(P, pcpath, pchheader) = P -- otherwise
dec $anonymous_owner_finish(ppstate, pcpath, pchheader, ppropertydesc*, pmethoddesc*) : ppstate
def $anonymous_owner_finish(P, pcpath, pchheader, ppropertydesc*, pmethoddesc*) = P[.CLASSES = $trait_class_set(P.CLASSES, pclassdesc[.INTERFACES = ptbytes_interface*][.PROPERTIES = ppropertydesc*][.METHODS = pmethoddesc*][.CONSTANTS = $ppclass_constants(P.CLASSCONSTANTS, PORIGIN 0 pcpath)][.EARLY = (pclassdesc.EARLY /\ ptbytes_interface* = eps)])]
  -- if P.COMPLETION = PPCNORMAL
  -- if $class_at(P.CLASSES, PORIGIN 0 pcpath) = (pclassdesc)
  -- if $ppclass_interfaces(pchheader.INTERFACES, pmethoddesc*) = ptbytes_interface*
def $anonymous_owner_finish(P, pcpath, pchheader, ppropertydesc*, pmethoddesc*) = P
  -- if P.COMPLETION =/= PPCNORMAL
def $anonymous_owner_finish(P, pcpath, pchheader, ppropertydesc*, pmethoddesc*) = $ppunsupported(P, "missing provisional anonymous owner") -- otherwise

def $ppclass_result_body(P, pcpath, PCHOK pchheader pchdiagnostic*) = $anonymous_owner_finish($pppromotion_override_unbound(P_next[.LOCATION = P_header.LOCATION][.FOLD = P_next.FOLD[.VALUE = eps]], pchheader, ppropertydesc*, pmethoddesc*), pcpath, pchheader, ppropertydesc*, pmethoddesc*)
  -- if pchheader.PARENT = eps /\ $anonymous_owner_factory_header(P, pcpath, pchheader)
  -- if P_header = $ppclass_diagnostics(P, pchdiagnostic*)
  -- if pchheader.BODY = SEQUENCE statement*
  -- if PPMEMBERS P_next ppropertydesc* pmethoddesc* = $ppmember_groups($anonymous_owner_reserve(P_header, pcpath, pchheader), pcpath, 0, statement*, eps, eps, pchheader)
def $ppclass_result_body(P, pcpath, PCHOK pchheader pchdiagnostic*) = $anonymous_owner_finish(P_next[.LOCATION = P_header.LOCATION][.FOLD = P_next.FOLD[.VALUE = eps]], pcpath, pchheader, ppropertydesc*, pmethoddesc*)
  -- if pchheader.PARENT =/= eps /\ $anonymous_owner_factory_header(P, pcpath, pchheader)
  -- if P_header = $ppclass_diagnostics(P, pchdiagnostic*)
  -- if pchheader.BODY = SEQUENCE statement*
  -- if PPMEMBERS P_next ppropertydesc* pmethoddesc* = $ppmember_groups($anonymous_owner_reserve(P_header, pcpath, pchheader), pcpath, 0, statement*, eps, eps, pchheader)

;; Abrupt unit compilation cannot install earlier anonymous owner children.
;; Diagnostic replay still runs before this source-authenticated skip.
dec $anonymous_failed_owner_child_occurrences(ppstate, pcpath, pcoccurrence*) : bool
dec $anonymous_failed_owner_child_member(ppstate, pcpath, pcoccurrence) : bool
def $anonymous_failed_owner_child_member(P, pcpath_child, PCOCCURRENCE pcpath_method (NStmtClassMethod (SEQUENCE eps) (INTEGER flags) (BOOLEAN false) (NIdentifier (BYTES text) metadata_name) phpType16 phpType18 (SEQUENCE statement*) metadata)) = true
  -- if $anonymous_method_factory_node(NStmtClassMethod (SEQUENCE eps) (INTEGER flags) (BOOLEAN false) (NIdentifier (BYTES text) metadata_name) phpType16 phpType18 (SEQUENCE statement*) metadata)
  -- if $(|pcpath_method| >= 2)
  -- if pcpath_owner = pcpath_method[0:$nabs($(|pcpath_method| - 2))]
  -- if pcpath_method[$nabs($(|pcpath_method| - 2)):2] = [PCFIELD 5, PCINDEX n_method]
  -- if $origin_node([P.FOLD.SOURCE], PORIGIN 0 pcpath_owner) = (pcnode_owner)
  -- if $anonymous_owner_factory_node(pcnode_owner)
  -- if $class_at(P.CLASSES, PORIGIN 0 pcpath_owner) = (pclassdesc_owner)
  -- if $class_at(P.INSTALLED.CLASSES, PORIGIN 0 pcpath_owner) = eps
  -- if pcpath_body = pcpath_method ++ [PCFIELD 6]
  -- if $(|pcpath_body| < |pcpath_child|)
  -- if pcpath_child[0:|pcpath_body|] = pcpath_body
def $anonymous_failed_owner_child_member(P, pcpath_child, pcoccurrence) = false -- otherwise
def $anonymous_failed_owner_child_occurrences(P, pcpath_child, eps) = false
def $anonymous_failed_owner_child_occurrences(P, pcpath_child, pcoccurrence_head :: pcoccurrence_tail*) = true
  -- if $anonymous_failed_owner_child_member(P, pcpath_child, pcoccurrence_head)
def $anonymous_failed_owner_child_occurrences(P, pcpath_child, pcoccurrence_head :: pcoccurrence_tail*) = $anonymous_failed_owner_child_occurrences(P, pcpath_child, pcoccurrence_tail*)
  -- if ~$anonymous_failed_owner_child_member(P, pcpath_child, pcoccurrence_head)
def $anonymous_failed_owner_child_checkpoint(P, PORIGIN 0 pcpath_child) = true
  -- if P.FOLD.SOURCE.ID = 0 /\ $anonymous_unit(P.FOLD.SOURCE)
  -- if P.COMPLETION = PPCABRUPT pcompletion
  -- if ~$declaration_unsupported(pcompletion)
  -- if $origin_node([P.FOLD.SOURCE], PORIGIN 0 pcpath_child) = (NStmtClass phpType14 phpType24 ABSENT phpType44 phpType42 phpType23 metadata)
  -- if $class_at(P.CLASSES, PORIGIN 0 pcpath_child) = (pclassdesc_child)
  -- if $class_at(P.INSTALLED.CLASSES, PORIGIN 0 pcpath_child) = eps
  -- if $anonymous_failed_owner_child_occurrences(P, pcpath_child, P.FOLD.SOURCE.OCCURRENCES)
def $anonymous_failed_owner_child_checkpoint(P, porigin) = false -- otherwise

dec $anonymous_factory_context(ppstate, pcpath) : bool
def $anonymous_factory_context(P, pcpath) = true
  -- if $anonymous_compilation_unit(P.FOLD.SOURCE)
  -- if P.CLASSCONTEXT = eps /\ P.FOLD.CLASSCONTEXT = eps
  -- if P.CLOSURE = P.FOLD.CLOSURE
  -- if ~P.FOLD.CONSTANT /\ ~P.FOLD.DEFAULT
  -- if $origin_node([P.FOLD.SOURCE], PORIGIN P.FOLD.SOURCE.ID (P.GOTOROOT)) = (pcnode)
  -- if $anonymous_factory_source(P, pcnode) = ((ptbytes_name, n_body))
  -- if P.FOLD.FUNCTION = ptbytes_name
  -- if pcpath_body = P.GOTOROOT ++ [PCFIELD n_body]
  -- if $(|pcpath_body| < |pcpath|)
