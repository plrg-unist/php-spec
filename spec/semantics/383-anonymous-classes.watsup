;; Ordinary anonymous classes use a compiled identity, not a visit counter.
;; Early named classes consume no RTD key, including bounded parent sources.
dec $anonymous_hex(nat) : ptbytes
def $anonymous_hex(n) = [$(48 + n)] -- if $(n < 10)
def $anonymous_hex(n) = [$(87 + n)] -- if $(n >= 10 /\ n < 16)
def $anonymous_hex(n) = $anonymous_hex($(n / 16)) ++ $anonymous_hex($(n \ 16)) -- if $(n >= 16)

dec $anonymous_class_name(ptbytes, int, nat) : ptbytes?
def $anonymous_class_name(ptbytes_file, z_line, n_counter) = ($ptascii("class@anonymous") ++ [0] ++ ptbytes_file ++ [58] ++ $ntunsigned($nabs(z_line)) ++ [36] ++ $anonymous_hex(n_counter))
  -- if ptbytes_file =/= eps /\ $(z_line > 0 /\ n_counter < 4294967296)
def $anonymous_class_name(ptbytes_file, z_line, n_counter) = eps -- otherwise

dec $anonymous_parent_class_name(ptbytes, ptbytes, int, nat) : ptbytes?
def $anonymous_parent_class_name(ptbytes_parent, ptbytes_file, z_line, n_counter) = (ptbytes_parent ++ $ptascii("@anonymous") ++ [0] ++ ptbytes_file ++ [58] ++ $ntunsigned($nabs(z_line)) ++ [36] ++ $anonymous_hex(n_counter))
  -- if ptbytes_parent =/= eps /\ ptbytes_file =/= eps /\ $(z_line > 0 /\ n_counter < 4294967296)
def $anonymous_parent_class_name(ptbytes_parent, ptbytes_file, z_line, n_counter) = eps -- otherwise

