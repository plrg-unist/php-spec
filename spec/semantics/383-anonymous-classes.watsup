  -- if pclassdesc.PARENT =/= eps \/ pclassdesc.INTERFACES =/= eps
  -- if $class_named(S.CLASSNAMES, $ptlc(pclassdesc.NAME)) = eps
  -- if $class_link_at(S.LINKEDPARENTS, pclassdesc.ORIGIN) = eps
  -- if $pil_at(S.LINKEDINTERFACES, pclassdesc.ORIGIN) = eps
  -- if ~$anonymous_runtime_declaration(S.DECLARATIONS, pclassdesc.ORIGIN)
def $anonymous_new_pending(S, porigin) = (pclassdesc)
  -- if $anonymous_new_descriptor(S, porigin) = (pclassdesc)
  -- if ~pclassdesc.EARLY /\ pclassdesc.PARENT = eps /\ pclassdesc.INTERFACES = eps
  -- if $origin_node(S.SOURCES, pclassdesc.ORIGIN) = (pcnode)
  -- if $anonymous_parentless_trait_node(pcnode)
  -- if $class_named(S.CLASSNAMES, $ptlc(pclassdesc.NAME)) = eps
  -- if $class_link_at(S.LINKEDPARENTS, pclassdesc.ORIGIN) = eps
  -- if $pil_at(S.LINKEDINTERFACES, pclassdesc.ORIGIN) = eps
  -- if ~$anonymous_runtime_declaration(S.DECLARATIONS, pclassdesc.ORIGIN)
def $anonymous_new_pending(S, porigin) = eps -- otherwise

;; Declaration-history replay already supplies compiler-derived prefix classes.
;; Authenticate the exact NEW child without recursively replaying that history.
def $declaration_new_selection(S, PORIGIN n_unit pcpath, NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class, porigin_called, pdeclcalls) = true
  -- if $origin_node(S.SOURCES, PORIGIN n_unit pcpath) = (NExprNew (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class) (SEQUENCE phpType7*) metadata)
  -- if porigin_called = PORIGIN n_unit (pcpath ++ [PCFIELD 0])
  -- if $anonymous_class_node(NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class)
  -- if $class_at(S.CLASSES, porigin_called) = (pclassdesc)
  -- if pclassdesc.KIND = "class"
  -- if $class_named(S.CLASSNAMES, $ptlc(pclassdesc.NAME)) = (porigin_called)

;; Link notices run at the class child before the original NEW is resumed.
dec $anonymous_link_resume(pstate, porigin) : pstate
def $anonymous_link_resume(S, porigin) = S[.TODO = (DECL_NOTICES pdeclnoticebatch) :: (AT porigin (EVAL expression)) :: ptask_tail*]
  -- if S.COMPLETION = NORMAL
  -- if S.TODO = (DECL_NOTICES pdeclnoticebatch) :: (EVAL expression) :: ptask_tail*
  -- if pdeclnoticebatch.KIND = NOTICE_RUNTIME
  -- if S.ORIGIN = (pdeclnoticebatch.SITE)
  -- if $origin_node(S.SOURCES, porigin) = (expression)
def $anonymous_link_resume(S, porigin) = S[.ORIGIN = (porigin)] -- otherwise

rule PhpStep/anonymous-parent-link: S ~> $anonymous_link_resume(S_linked, porigin)
  -- if S.TODO = (EVAL (NExprNew (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class) (SEQUENCE phpType7*) metadata)) :: ptask_tail*
  -- if S.ORIGIN = (porigin)
  -- if $origin_node(S.SOURCES, porigin) = (NExprNew (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class) (SEQUENCE phpType7*) metadata)
  -- if $anonymous_new_pending(S, porigin) = (pclassdesc)
  -- if $anonymous_dependencies_ready(S, pclassdesc)
  -- if S_linked = $activate_class(S[.ORIGIN = (pclassdesc.ORIGIN)], pclassdesc)

;; A missing dependency enters its genuine declaration child. Existing source
;; autoload continuations finish there; AT restores the original NEW before args.
rule PhpStep/anonymous-dependency-stage: S ~> S[.TODO = (AT pclassdesc.ORIGIN (STMT (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class))) :: S.TODO]
  -- if S.TODO = (EVAL (NExprNew (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class) (SEQUENCE phpType7*) metadata)) :: ptask_tail*
  -- if S.ORIGIN = (porigin)
  -- if $origin_node(S.SOURCES, porigin) = (NExprNew (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class) (SEQUENCE phpType7*) metadata)
  -- if $anonymous_new_pending(S, porigin) = (pclassdesc)
  -- if ~$anonymous_dependencies_ready(S, pclassdesc)

;; Constructor selection and its result marker reuse the ordinary call receipt.
;; Anonymous class NEW is not the suspended named-class parameter-default form.
def $parameter_default_constructor(S, NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class, phpType7*, metadata) = false

;; No-constructor NEW completes pending property defaults before allocation.
def $new_source_name(S, porigin) = (ptbytes_name)
  -- if $anonymous_new_name(S, porigin) = (ptbytes_name)
  -- if $new_has_ctor(S, ptbytes_name)
def $new_source_name(S, porigin) = (ptbytes_name)
  -- if $anonymous_new_name(S, porigin) = (ptbytes_name)
  -- if ~$new_has_ctor(S, ptbytes_name)
  -- if $origin_node(S.SOURCES, porigin) = (NExprNew (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class) (SEQUENCE phpType7*) metadata)

dec $anonymous_new_noctor(pstate, ptbytes, int) : pstate
def $anonymous_new_noctor(S, ptbytes_name, z) = $noctor_start(S, ptbytes_name, eps, z)
  -- if $class_named(S.CLASSNAMES, $ptlc(ptbytes_name)) = (porigin)
  -- if $instance_default_tasks(S, porigin, z) =/= eps \/ $static_default_tasks(S, porigin, z) =/= eps
def $anonymous_new_noctor(S, ptbytes_name, z) = $new_class(S, ptbytes_name, z) -- otherwise

rule PhpStep/anonymous-new: S ~> $anonymous_new_noctor(S[.TODO = ptask_tail*], ptbytes_name, $runtime_line(S, eps, NExprNew (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class) (SEQUENCE eps) metadata))
  -- if S.TODO = (EVAL (NExprNew (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class) (SEQUENCE eps) metadata)) :: ptask_tail*
  -- if S.ORIGIN = (porigin)
  -- if $origin_node(S.SOURCES, porigin) = (NExprNew (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class) (SEQUENCE eps) metadata)
  -- if $anonymous_new_name(S, porigin) = (ptbytes_name)
  -- if ~$new_has_ctor(S, ptbytes_name)
rule PhpStep/anonymous-new-constructor: S ~> $constructor_start(S[.TODO = ptask_tail*], ptbytes_name, eps, $runtime_line(S, eps, NExprNew (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class) (SEQUENCE eps) metadata))
  -- if S.TODO = (EVAL (NExprNew (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class) (SEQUENCE eps) metadata)) :: ptask_tail*
  -- if S.ORIGIN = (porigin)
  -- if $origin_node(S.SOURCES, porigin) = (NExprNew (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class) (SEQUENCE eps) metadata)
  -- if $anonymous_new_name(S, porigin) = (ptbytes_name)
  -- if $new_has_ctor(S, ptbytes_name)
rule PhpStep/anonymous-new-arguments: S ~> $noctor_start(S[.TODO = ptask_tail*], ptbytes_name, phpType7*, $runtime_line(S, eps, NExprNew (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class) (SEQUENCE phpType7*) metadata))
  -- if S.TODO = (EVAL (NExprNew (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class) (SEQUENCE phpType7*) metadata)) :: ptask_tail*
  -- if phpType7* =/= eps
  -- if S.ORIGIN = (porigin)
  -- if $origin_node(S.SOURCES, porigin) = (NExprNew (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class) (SEQUENCE phpType7*) metadata)
  -- if $anonymous_new_name(S, porigin) = (ptbytes_name)
  -- if ~$new_has_ctor(S, ptbytes_name)
rule PhpStep/anonymous-new-constructor-arguments: S ~> $constructor_start(S[.TODO = ptask_tail*], ptbytes_name, phpType7*, $runtime_line(S, eps, NExprNew (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata_class) (SEQUENCE phpType7*) metadata))
