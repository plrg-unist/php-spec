  -- if S_cached = F_value.MEMORY[.CONSTCONTEXT = F.MEMORY.CONSTCONTEXT][.RESULT = F.MEMORY.RESULT][.CLASSCONSTANTCACHE = F_value.MEMORY.CLASSCONSTANTCACHE ++ [{ORIGIN pclassconstantdesc.ORIGIN, VALUE pvalue, CLASS pvalueclass}]][.CLASSCONSTANTHISTORY = F_value.MEMORY.CLASSCONSTANTHISTORY ++ [CCTRAITCACHE pclassconstantdesc.ORIGIN ptraitcachecause]]
