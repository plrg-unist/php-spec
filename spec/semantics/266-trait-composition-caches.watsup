  -- if $(|S.CLASSCONSTANTHISTORY| <= |S_result.CLASSCONSTANTHISTORY|)
  -- if S_result.CLASSCONSTANTHISTORY[0:|S.CLASSCONSTANTHISTORY|] = S.CLASSCONSTANTHISTORY
  -- if n_new = $nabs($(|S_result.CLASSCONSTANTHISTORY| - |S.CLASSCONSTANTHISTORY|))
  -- if $trait_cache_new_events(S_result.CLASSCONSTANTHISTORY[|S.CLASSCONSTANTHISTORY|:n_new])
def $trait_cache_failed(S, S_result) = false -- otherwise

;; A fill before publication has its own source/table/lookup witness. It never
;; records a fabricated ordinary lookup of the still-unlinked composing class.
def $trait_cache_parents(eps, porigin) = eps
def $trait_cache_parents((CLASSLINK porigin pclassparent) :: pclasslink*, porigin) = $trait_cache_parents(pclasslink*, porigin)
def $trait_cache_parents((CLASSLINK porigin_other pclassparent) :: pclasslink*, porigin) = (CLASSLINK porigin_other pclassparent) :: $trait_cache_parents(pclasslink*, porigin)
  -- if porigin_other =/= porigin
def $trait_cache_interfaces(eps, porigin) = eps
def $trait_cache_interfaces(pinterfacelink :: pinterfacelink_tail*, porigin) = $trait_cache_interfaces(pinterfacelink_tail*, porigin)
  -- if pinterfacelink.OWNER = porigin
def $trait_cache_interfaces(pinterfacelink :: pinterfacelink_tail*, porigin) = pinterfacelink :: $trait_cache_interfaces(pinterfacelink_tail*, porigin)
  -- if pinterfacelink.OWNER =/= porigin
def $trait_cache_preinherit(S, porigin) = S[.LINKEDPARENTS = $trait_cache_parents(S.LINKEDPARENTS, porigin)][.LINKEDINTERFACES = $trait_cache_interfaces(S.LINKEDINTERFACES, porigin)]
def $trait_cache_cause_valid(S, porigin, ptraitcachecause) = true
  -- if $(ptraitcachecause.PREFIX < |S.DECLARATIONS| /\ ptraitcachecause.USERPREFIX <= |S.USERCONSTANTS|)
  -- if $iterator_notice_publication_index(S.DECLARATIONS, ptraitcachecause.CLASS, 0) = (ptraitcachecause.PREFIX)
  -- if $class_at(S.CLASSES, ptraitcachecause.CLASS) = (pclassdesc)
  -- if S_prefix = $trait_cache_preinherit(S[.CLASSNAMES = $trait_notice_names(S, S.DECLARATIONS[0:ptraitcachecause.PREFIX])][.DECLARATIONS = S.DECLARATIONS[0:ptraitcachecause.PREFIX]][.USERCONSTANTS = S.USERCONSTANTS[0:ptraitcachecause.USERPREFIX]][.COMPLETION = NORMAL], ptraitcachecause.CLASS)
  -- if $trait_cache_table_valid(S_prefix, ptraitcachecause.CLASS, ptraitcachecause.ROOT, ptraitcachecause.TABLE)
  -- if S_table = S_prefix[.CLASSES = $trait_class_set(S_prefix.CLASSES, pclassdesc[.CONSTANTS = ptraitcachecause.TABLE])]
  -- if $trait_cache_lookups(S_table, ptraitcachecause.CLASS, ptraitcachecause.ROOT, ptraitcachecause.LOOKUPS, eps) = (pclassconstantdesc)
  -- if pclassconstantdesc.ORIGIN = porigin
  -- if $class_constant_origin(S.CLASSES, porigin) = (pclassconstantdesc)
def $trait_cache_cause_valid(S, porigin, ptraitcachecause) = false -- otherwise
def $trait_cache_event(CCTRAITCACHE porigin ptraitcachecause) = ((porigin, ptraitcachecause))
def $trait_cache_event(pclassconstantevent) = eps -- otherwise
def $trait_cache_event_at(eps, porigin) = eps
def $trait_cache_event_at(pclassconstantevent :: pclassconstantevent_tail*, porigin) = (ptraitcachecause)
  -- if $trait_cache_event(pclassconstantevent) = ((porigin, ptraitcachecause))
def $trait_cache_event_at(pclassconstantevent :: pclassconstantevent_tail*, porigin) = $trait_cache_event_at(pclassconstantevent_tail*, porigin)
  -- if $trait_cache_event(pclassconstantevent) = eps
def $trait_cache_event_at(pclassconstantevent :: pclassconstantevent_tail*, porigin) = $trait_cache_event_at(pclassconstantevent_tail*, porigin)
  -- if $trait_cache_event(pclassconstantevent) = ((porigin_other, ptraitcachecause))
  -- if porigin_other =/= porigin
def $constant_callable_cache_event(CCTRAITCACHE porigin ptraitcachecause) = ((porigin, ptraitcachecause.PREFIX))
def $trait_cache_value_class(PVSCALAR) = true
def $trait_cache_value_class(PVSTRING b) = true
def $trait_cache_value_class(PVARRAY b (pkey, pvalueclass)*) = $trait_cache_array_classes((pkey, pvalueclass)*)
def $trait_cache_value_class(pvalueclass) = false -- otherwise
def $trait_cache_array_classes(eps) = true
def $trait_cache_array_classes((pkey, pvalueclass) :: (pkey_tail, pvalueclass_tail)*) = ($trait_cache_value_class(pvalueclass) /\ $trait_cache_array_classes((pkey_tail, pvalueclass_tail)*))
def $constant_callable_cache_valid(S, pclassconstantdesc, pvalueclass, n_prefix) = ($trait_cache_cause_valid(S, pclassconstantdesc.ORIGIN, ptraitcachecause) /\ $trait_cache_value_class(pvalueclass))
  -- if $trait_cache_event_at(S.CLASSCONSTANTHISTORY, pclassconstantdesc.ORIGIN) = (ptraitcachecause)
  -- if ptraitcachecause.PREFIX = n_prefix
def $class_constant_history_fills(S, (CCTRAITCACHE porigin ptraitcachecause) :: pclassconstantevent*, (porigin_flag, b_flag)*, porigin_cached*, porigin_filled*, n_previous) = $class_constant_history_fills(S, pclassconstantevent*, (porigin_flag, b_flag)*, porigin_cached* ++ [porigin], porigin_filled*, ptraitcachecause.PREFIX)
  -- if $(n_previous <= ptraitcachecause.PREFIX /\ ptraitcachecause.PREFIX <= |S.DECLARATIONS|)
  -- if ~(porigin <- porigin_cached*)
  -- if $trait_cache_cause_valid(S, porigin, ptraitcachecause)
  -- if $default_cache_at(S.CLASSCONSTANTCACHE, porigin) = (pdefaultcache)

;; Replay excludes fills caused by this very composition. Earlier compositions
;; and ordinary cache fills remain available at the sampled publication prefix.
def $trait_cache_notice_prefix(S, eps, porigin, n_prefix) = eps
def $trait_cache_notice_prefix(S, pclassconstantevent :: pclassconstantevent_tail*, porigin, n_prefix) = $trait_cache_notice_item(S, pclassconstantevent, porigin, n_prefix) ++ $trait_cache_notice_prefix(S, pclassconstantevent_tail*, porigin, n_prefix)
def $trait_cache_notice_item(S, CCTRAITCACHE porigin ptraitcachecause, porigin_composing, n_prefix) = [pdefaultcache]
  -- if $(ptraitcachecause.PREFIX < n_prefix)
  -- if ptraitcachecause.CLASS =/= porigin_composing
  -- if $default_cache_at(S.CLASSCONSTANTCACHE, porigin) = (pdefaultcache)
def $trait_cache_notice_item(S, pclassconstantevent, porigin_composing, n_prefix) = $trait_notice_cache_item(S, pclassconstantevent, n_prefix)
  -- if $trait_cache_event(pclassconstantevent) = eps
def $trait_cache_notice_item(S, pclassconstantevent, porigin_composing, n_prefix) = eps -- otherwise
