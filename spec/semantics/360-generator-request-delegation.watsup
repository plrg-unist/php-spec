;; zend_generator_dtor_storage detaches input before finally. Delegated CURRENT
;; is the physical value slot, retained until free_storage releases that slot.
dec $generator_storage_current_records(pstate, pgeneratorfrom, pgenstorage*) : bool
dec $generator_storage_current_record(pstate, pgeneratorfrom, pgenstorage) : bool

def $generator_storage_current_borrowed(S, pgeneratorfrom) = $generator_storage_current_records(S, pgeneratorfrom, $generator_storage_tasks(S.TODO) ++ $generator_storage_frames(S.FRAMES))
def $generator_storage_current_records(S, pgeneratorfrom, eps) = false
def $generator_storage_current_records(S, pgeneratorfrom, pgenstorage :: pgenstorage_tail*) = ($generator_storage_current_record(S, pgeneratorfrom, pgenstorage) \/ $generator_storage_current_records(S, pgeneratorfrom, pgenstorage_tail*))
def $generator_storage_current_record(S, pgeneratorfrom, pgenstorage) = true
