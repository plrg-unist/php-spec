;; Checked constant-expression work in an explicit lexical environment.
;; A compiled source instance owns this store; it is not recreated on execution.
syntax pffact = PFFACT pcpath pvalue int
syntax pfcontext = PFCONTEXT pcpath plenv
syntax pfstate = { SOURCE pcunit, MEMORY pstate, FACTS pffact*, VALUE pvalue?, ENV plenv, CONTEXTS pfcontext*, REDIRECTS (pcpath, pcpath)*, WARNINGS (pcpath, ptbytes, int)* }
syntax pfshape = PFSCALAR pvalue int | PFNAME name | PFBINARY pbin expression expression
  | PFUNARY punary expression | PFDIM expression phpType5
  | PFARRAY phpType13* | PFNOT expression | PFSHORT bool expression expression
  | PFTERNARY expression phpType5 expression | PFMEMBER expression phpType20 | PFNEW phpType28 phpType6 | PFCAST pcast expression | PFCAST_OBJECT expression | PFCAST_UNSET | PFBITNOT expression | PFCOALESCE expression expression | PFCLASSCONST phpType19 phpType20 | PFCLASSNAME phpType19 | PFSTOP | PFOTHER
syntax pfkey = PFNO_KEY | PFKEY pvalue?
syntax pfitem = PFITEM pvalue? pfkey bool | PFSPREAD pvalue?
syntax pfbuild = PFBUILT pstate | PFDEFER | PFSTATIC text | PFSTATICBYTES ptbytes
var F : pfstate

dec $pfwarning_binary(pbin) : bool
def $pfwarning_binary(pbin) = (pbin <- [LOGICALXOR, EQUAL, NOTEQUAL, LESS, LESSEQUAL, GREATER, GREATEREQUAL, SPACESHIP])

dec $pfredirect((pcpath, pcpath)*, pcpath) : pcpath?
dec $pfwarning_events(pevent*, pcpath) : (pcpath, ptbytes, int)*
dec $pfwarned(pfstate, pcpath, pstate) : pfstate
dec $pftruth(pfstate, pcpath, pvalue, int) : pfstate
dec $pfnot(pfstate, pcpath, int) : pfstate
dec $pfshort(pfstate, pcpath, bool, pvalue?, pvalue?, int) : pfstate
dec $pfshortleft(pfstate, pcpath, bool, pvalue?, int) : pfstate
dec $pfconditional(pfstate, pcpath, expression, phpType5, expression, int) : pfstate
dec $pfchoose(pfstate, pcpath, expression, phpType5, expression, int) : pfstate
dec $pfselected(pfstate, pcpath, pcpath, expression, int) : pfstate
dec $pfselecteddone(pfstate, pcpath, pcpath) : pfstate
dec $pfaddredirect(pfstate, pcpath, pcpath) : pfstate

dec $pftracked(pfstate, pcpath, expression, int) : pfstate
dec $pfnamed(pfstate, pcpath, pnresult, int) : pfstate
dec $pfcontext_at(pfcontext*, pcpath) : plenv?
dec $pfcontextualize(pfstate, pcpath) : pfstate

dec $pfbegin(nat, program) : pfstate
def $pfbegin(n, program) = { SOURCE $pcsource(n, program), MEMORY $initial_state(NORMAL), FACTS eps, VALUE eps, ENV $plempty(false), CONTEXTS eps, REDIRECTS eps, WARNINGS eps }
dec $pfnode(expression) : pcnode
def $pfnode(expression) = expression
dec $pfoccurrence(pcoccurrence*, pcpath, expression) : bool
def $pfoccurrence(eps, pcpath, expression) = false
def $pfoccurrence((PCOCCURRENCE pcpath pcnode) :: pcoccurrence*, pcpath, expression) = (pcnode = $pfnode(expression))
def $pfoccurrence((PCOCCURRENCE pcpath_other pcnode) :: pcoccurrence*, pcpath, expression) = $pfoccurrence(pcoccurrence*, pcpath, expression)
  -- if pcpath_other =/= pcpath
dec $pffact(pffact*, pcpath) : pvalue?
def $pffact(eps, pcpath) = eps
def $pffact((PFFACT pcpath pvalue z) :: pffact*, pcpath) = (pvalue)
def $pffact((PFFACT pcpath_other pvalue z) :: pffact*, pcpath) = $pffact(pffact*, pcpath)
  -- if pcpath_other =/= pcpath
dec $pffactline(pffact*, pcpath) : int?
def $pffactline(eps, pcpath) = eps
def $pffactline((PFFACT pcpath pvalue z) :: pffact*, pcpath) = (z)
def $pffactline((PFFACT pcpath_other pvalue z) :: pffact*, pcpath) = $pffactline(pffact*, pcpath)
  -- if pcpath_other =/= pcpath
dec $pferror(pfstate, text, int) : pfstate
def $pferror(F, text, z) = F[.MEMORY = F.MEMORY[.COMPLETION = pcompletion]][.VALUE = eps]
  -- if $context_error(text, z) = REJECT pcompletion
dec $pfunsupported(pfstate, text) : pfstate
def $pfunsupported(F, text) = F[.MEMORY = F.MEMORY[.COMPLETION = UNSUPPORTED text]][.VALUE = eps]
;; Every retained folded array is a pool owner, including unused partial children.
dec $pfremember(pfstate, pcpath, pvalue?, int) : pfstate
def $pfremember(F, pcpath, eps, z) = F[.VALUE = eps]
def $pfremember(F, pcpath, (pvalue), z) = F[.FACTS = F.FACTS ++ [PFFACT pcpath pvalue z]][.VALUE = (pvalue)][.MEMORY = F.MEMORY[.HELD = F.MEMORY.HELD ++ $value_nodes(pvalue)]]

dec $pfshape(expression) : pfshape
def $pfshape(NScalarInt (INTEGER i) metadata) = PFSCALAR (PINT i) ($source_line(metadata))
def $pfshape(NScalarFloat (FLOAT text) metadata) = PFSCALAR (PFLOAT $hex_bits(text, 0)) ($source_line(metadata))
def $pfshape(NScalarString (BYTES text) metadata) = PFSCALAR (PSTRING $base64(text)) ($string_line(metadata))
def $pfshape(NExprConstFetch name metadata) = PFNAME name
def $pfshape(NExprVariable phpType32 metadata) = PFSTOP
def $pfshape(NExprAssign expression_1 expression_2 metadata) = PFSTOP
def $pfshape(NExprAssignRef expression_1 expression_2 metadata) = PFSTOP
def $pfshape(NExprAssignOpBitwiseAnd expression_1 expression_2 metadata) = PFSTOP
def $pfshape(NExprAssignOpBitwiseOr expression_1 expression_2 metadata) = PFSTOP
def $pfshape(NExprAssignOpBitwiseXor expression_1 expression_2 metadata) = PFSTOP
def $pfshape(NExprAssignOpConcat expression_1 expression_2 metadata) = PFSTOP
def $pfshape(NExprAssignOpDiv expression_1 expression_2 metadata) = PFSTOP
def $pfshape(NExprAssignOpMinus expression_1 expression_2 metadata) = PFSTOP
def $pfshape(NExprAssignOpMod expression_1 expression_2 metadata) = PFSTOP
def $pfshape(NExprAssignOpMul expression_1 expression_2 metadata) = PFSTOP
def $pfshape(NExprAssignOpPlus expression_1 expression_2 metadata) = PFSTOP
def $pfshape(NExprAssignOpPow expression_1 expression_2 metadata) = PFSTOP
def $pfshape(NExprAssignOpShiftLeft expression_1 expression_2 metadata) = PFSTOP
def $pfshape(NExprAssignOpShiftRight expression_1 expression_2 metadata) = PFSTOP
def $pfshape(NExprPreInc expression metadata) = PFSTOP
def $pfshape(NExprPreDec expression metadata) = PFSTOP
def $pfshape(NExprPostInc expression metadata) = PFSTOP
def $pfshape(NExprPostDec expression metadata) = PFSTOP
def $pfshape(NExprBinaryOpPlus expression_1 expression_2 metadata) = PFBINARY ADD expression_1 expression_2
def $pfshape(NExprBinaryOpMinus expression_1 expression_2 metadata) = PFBINARY SUBTRACT expression_1 expression_2
def $pfshape(NExprBinaryOpMul expression_1 expression_2 metadata) = PFBINARY MULTIPLY expression_1 expression_2
def $pfshape(NExprBinaryOpDiv expression_1 expression_2 metadata) = PFBINARY DIVIDE expression_1 expression_2
def $pfshape(NExprBinaryOpIdentical expression_1 expression_2 metadata) = PFBINARY IDENTICAL expression_1 expression_2
def $pfshape(NExprBinaryOpNotIdentical expression_1 expression_2 metadata) = PFBINARY NOTIDENTICAL expression_1 expression_2
def $pfshape(NExprBinaryOpEqual expression_1 expression_2 metadata) = PFBINARY EQUAL expression_1 expression_2
def $pfshape(NExprBinaryOpNotEqual expression_1 expression_2 metadata) = PFBINARY NOTEQUAL expression_1 expression_2
def $pfshape(NExprBinaryOpSmaller expression_1 expression_2 metadata) = PFBINARY LESS expression_1 expression_2
def $pfshape(NExprBinaryOpSmallerOrEqual expression_1 expression_2 metadata) = PFBINARY LESSEQUAL expression_1 expression_2
def $pfshape(NExprBinaryOpGreater expression_1 expression_2 metadata) = PFBINARY GREATER expression_1 expression_2
def $pfshape(NExprBinaryOpGreaterOrEqual expression_1 expression_2 metadata) = PFBINARY GREATEREQUAL expression_1 expression_2
def $pfshape(NExprBinaryOpSpaceship expression_1 expression_2 metadata) = PFBINARY SPACESHIP expression_1 expression_2
def $pfshape(NExprBooleanNot expression metadata) = PFNOT expression
def $pfshape(NExprBinaryOpBooleanAnd expression_1 expression_2 metadata) = PFSHORT false expression_1 expression_2
def $pfshape(NExprBinaryOpLogicalAnd expression_1 expression_2 metadata) = PFSHORT false expression_1 expression_2
def $pfshape(NExprBinaryOpBooleanOr expression_1 expression_2 metadata) = PFSHORT true expression_1 expression_2
def $pfshape(NExprBinaryOpLogicalOr expression_1 expression_2 metadata) = PFSHORT true expression_1 expression_2
def $pfshape(NExprBinaryOpLogicalXor expression_1 expression_2 metadata) = PFBINARY LOGICALXOR expression_1 expression_2
def $pfshape(NExprTernary expression_1 phpType5 expression_2 metadata) = PFTERNARY expression_1 phpType5 expression_2
def $pfshape(NExprUnaryPlus expression metadata) = PFUNARY POSITIVE expression
def $pfshape(NExprUnaryMinus expression metadata) = PFUNARY NEGATIVE expression
def $pfshape(NExprArrayDimFetch expression phpType5 metadata) = PFDIM expression phpType5
def $pfshape(NExprArray (SEQUENCE phpType13*) metadata) = PFARRAY phpType13*
def $pfshape(expression) = PFOTHER
  -- otherwise

dec $pfprepare(pfstate, pcpath, expression, plenv, int) : pfstate
dec $pffold(pfstate, pcpath, expression, int) : pfstate
dec $pfdispatch(pfstate, pcpath, pfshape, int) : pfstate
def $pfprepare(F, pcpath, expression, plenv, z) = F
  -- if F.MEMORY.COMPLETION =/= NORMAL
def $pfprepare(F, pcpath, expression, plenv, z) = $pffold(F[.ENV = plenv], pcpath, expression, z)
  -- if F.MEMORY.COMPLETION = NORMAL
  -- if F.SOURCE = $pcsource(F.SOURCE.ID, F.SOURCE.AST)
  -- if $pfoccurrence(F.SOURCE.OCCURRENCES, pcpath, expression)
  -- if $(z > 0)
def $pfprepare(F, pcpath, expression, plenv, z) = $pfunsupported(F, "invalid constant-expression occurrence or compiler line")
  -- otherwise
def $pffold(F, pcpath, expression, z) = F
  -- if F.MEMORY.COMPLETION =/= NORMAL
def $pffold(F, pcpath, expression, z) = $pftracked($pfcontextualize(F, pcpath), pcpath, expression, z)
  -- if F.MEMORY.COMPLETION = NORMAL

def $pftracked(F, pcpath, expression, z) = F
  -- if F.MEMORY.COMPLETION =/= NORMAL
def $pftracked(F, pcpath, expression, z) = F[.VALUE = (pvalue)]
  -- if F.MEMORY.COMPLETION = NORMAL
  -- if $pffact(F.FACTS, pcpath) = (pvalue)
def $pftracked(F, pcpath, expression, z) = $pfdispatch(F, pcpath, $pfshape(expression), z)
  -- if F.MEMORY.COMPLETION = NORMAL
  -- if $pffact(F.FACTS, pcpath) = eps
  -- if $pfredirect(F.REDIRECTS, pcpath) = eps

def $pfdispatch(F, pcpath, PFSCALAR pvalue z_leaf, z) = $pfremember(F, pcpath, (pvalue), z_leaf)
def $pfdispatch(F, pcpath, PFNAME name, z) = $pfnamed(F, pcpath, $pnresolve(F.ENV, PLCONSTANT, name), z)
def $pfnamed(F, pcpath, PNRESOLVED pnreference, z) = $pfremember(F, pcpath, $pnfold(pnreference), z)
def $pfnamed(F, pcpath, PNUNSUPPORTED text, z) = $pfunsupported(F, text)
def $pfdispatch(F, pcpath, PFSTOP, z) = F[.VALUE = eps]
def $pfdispatch(F, pcpath, PFOTHER, z) = $pfunsupported(F, "constant-expression kind")

;; Both children are visited even when the first cannot fold.
dec $pfbinary(pfstate, pcpath, pbin, pvalue?, pvalue?, int) : pfstate
def $pfdispatch(F, pcpath, PFBINARY pbin expression_1 expression_2, z) = $pfbinary(F_right, pcpath, pbin, F_left.VALUE, F_right.VALUE, z)
  -- if F_left = $pffold(F, pcpath ++ [PCFIELD 0], expression_1, z)
  -- if F_right = $pffold(F_left, pcpath ++ [PCFIELD 1], expression_2, z)
def $pfbinary(F, pcpath, pbin, pvalue_1?, pvalue_2?, z) = F
  -- if F.MEMORY.COMPLETION =/= NORMAL
def $pfbinary(F, pcpath, pbin, (pvalue_1), (pvalue_2), z) = $pfremember(F[.MEMORY = S], pcpath, (pvalue), z)
  -- if F.MEMORY.COMPLETION = NORMAL
  -- if ~$pfwarning_binary(pbin)
  -- if $constant_state($binary_apply(F.MEMORY, pbin, pvalue_1, pvalue_2, z)) = (S)
  -- if S.RESULT = KNOWN pvalue
def $pfbinary(F, pcpath, pbin, pvalue_1?, pvalue_2?, z) = F[.VALUE = eps]
  -- otherwise

dec $pfunary(pfstate, pcpath, punary, int) : pfstate
def $pfdispatch(F, pcpath, PFUNARY punary expression, z) = $pfunary($pffold(F, pcpath ++ [PCFIELD 0], expression, z), pcpath, punary, z)
def $pfunary(F, pcpath, punary, z) = F
  -- if F.MEMORY.COMPLETION =/= NORMAL
def $pfunary(F, pcpath, punary, z) = $pfremember(F[.MEMORY = S], pcpath, (pvalue_result), z)
  -- if F.MEMORY.COMPLETION = NORMAL
  -- if F.VALUE = (pvalue)
  -- if $constant_state($unary_apply(F.MEMORY, punary, pvalue, z)) = (S)
  -- if S.RESULT = KNOWN pvalue_result
def $pfunary(F, pcpath, punary, z) = F[.VALUE = eps]
  -- otherwise

;; Constant DIM accepts narrower keys than the runtime read conversion.
dec $pfarraykey(pvalue) : pkey?
def $pfarraykey(PINT i) = (KINT i)
def $pfarraykey(PSTRING n*) = (KINT i)
  -- if $string_key(n*) = INTEGERKEY i
def $pfarraykey(PSTRING n*) = (KSTRING n*)
  -- if $string_key(n*) = STRINGKEY
def $pfarraykey(pvalue) = eps
  -- otherwise
dec $pfdimvalue(pstate, pvalue, pvalue) : pvalue?
def $pfdimvalue(S, PARRAY n, pvalue) = (pvalue_result)
  -- if $pfarraykey(pvalue) = (pkey)
  -- if $entry_lookup(S.ARRAYS[n].ITEMS, pkey) = (DIRECT pvalue_result)
def $pfdimvalue(S, PSTRING n*, pvalue) = $string_constant_read(n*, pvalue)
def $pfdimvalue(S, pvalue_1, pvalue_2) = eps
  -- otherwise
dec $pfdim(pfstate, pcpath, pvalue?, pvalue?, int) : pfstate
def $pfdispatch(F, pcpath, PFDIM expression ABSENT, z) = $pferror(F, "Cannot use [] for reading", z)
def $pfdispatch(F, pcpath, PFDIM expression phpType5, z) = $pfdim(F_key, pcpath, F_base.VALUE, F_key.VALUE, z)
  -- if phpType5 = expression_key
  -- if F_base = $pffold(F, pcpath ++ [PCFIELD 0], expression, z)
  -- if F_key = $pffold(F_base, pcpath ++ [PCFIELD 1], expression_key, z)
def $pfdim(F, pcpath, pvalue_1?, pvalue_2?, z) = F
  -- if F.MEMORY.COMPLETION =/= NORMAL
def $pfdim(F, pcpath, (pvalue_1), (pvalue_2), z) = $pfremember(F, pcpath, $pfdimvalue(F.MEMORY, pvalue_1, pvalue_2), z)
  -- if F.MEMORY.COMPLETION = NORMAL
def $pfdim(F, pcpath, pvalue_1?, pvalue_2?, z) = F[.VALUE = eps]
  -- otherwise

;; Array pass one visits each value then its key, retaining all partial folds.
;; Only after every entry does pass two attempt constant table construction.
dec $pfitems(pfstate, pcpath, nat, phpType13*, pfitem*, int, int) : pfstate
dec $pfitemkey(pfstate, pcpath, phpType5, int) : pfstate
dec $pfkey(phpType5, pvalue?) : pfkey
dec $pfready(pfitem*) : bool
dec $pfarray(pfstate, pcpath, pfitem*, int) : pfstate
dec $pfconstruct(pstate, nat, pfitem*, int) : pfbuild
dec $pfconstructkey(pstate, nat, pvalue, pfkey, pfitem*, int) : pfbuild
dec $pfinsert(pstate, nat, pkey?, pvalue, pfitem*, int) : pfbuild
dec $pfinserted(pstate, nat, pfitem*, int) : pfbuild
dec $pfbuilt(pfstate, pcpath, pfbuild, nat, int) : pfstate

def $pfdispatch(F, pcpath, PFARRAY phpType13*, z) = $pfitems(F, pcpath, 0, phpType13*, eps, z, 0)
def $pfitems(F, pcpath, n, phpType13*, pfitem*, z, z_previous) = F
  -- if F.MEMORY.COMPLETION =/= NORMAL
def $pfitems(F, pcpath, n, eps, pfitem*, z, z_previous) = $pfarray(F, pcpath, pfitem*, z)
  -- if F.MEMORY.COMPLETION = NORMAL
def $pfitems(F, pcpath, n, (NArrayItem phpType5 expression (BOOLEAN b) (BOOLEAN false) metadata) :: phpType13*, pfitem*, z, z_previous) = $pfitems(F_key, pcpath, $(n + 1), phpType13*, pfitem* ++ [PFITEM F_value.VALUE ($pfkey(phpType5, F_key.VALUE)) b], z, $expression_line(expression))
  -- if F.MEMORY.COMPLETION = NORMAL
  -- if pcpath_item = pcpath ++ [PCFIELD 0, PCINDEX n]
  -- if F_value = $pffold(F, pcpath_item ++ [PCFIELD 1], expression, z)
  -- if F_key = $pfitemkey(F_value, pcpath_item ++ [PCFIELD 0], phpType5, z)
def $pfitems(F, pcpath, n, ABSENT :: phpType13*, pfitem*, z, z_previous) = $pferror(F, "Cannot use empty array elements in arrays", z_previous)
  -- if F.MEMORY.COMPLETION = NORMAL
  -- if $(z_previous > 0)
def $pfitems(F, pcpath, 0, ABSENT :: phpType13*, pfitem*, z, 0) = $pferror(F, "Cannot use empty array elements in arrays", z)
  -- if F.MEMORY.COMPLETION = NORMAL
def $pfitems(F, pcpath, n, (NArrayItem ABSENT expression (BOOLEAN false) (BOOLEAN true) metadata) :: phpType13*, pfitem*, z, z_previous) = $pfitems(F_value, pcpath, $(n + 1), phpType13*, pfitem* ++ [PFSPREAD F_value.VALUE], z, $expression_line(expression))
  -- if F.MEMORY.COMPLETION = NORMAL
  -- if F_value = $pffold(F, pcpath ++ [PCFIELD 0, PCINDEX n, PCFIELD 1], expression, z)
def $pfitems(F, pcpath, n, phpType13*, pfitem*, z, z_previous) = $pfunsupported(F, "constant array unpack or edited item")
  -- otherwise

def $pfitemkey(F, pcpath, ABSENT, z) = F[.VALUE = eps]
def $pfitemkey(F, pcpath, phpType5, z) = $pffold(F, pcpath, expression, z)
  -- if phpType5 = expression
def $pfkey(ABSENT, pvalue?) = PFNO_KEY
def $pfkey(phpType5, pvalue?) = PFKEY pvalue?
  -- if phpType5 = expression
def $pfready(eps) = true
def $pfready((PFITEM (pvalue) PFNO_KEY false) :: pfitem*) = $pfready(pfitem*)
def $pfready((PFITEM (pvalue) (PFKEY (pvalue_key)) false) :: pfitem*) = $pfready(pfitem*)
def $pfready(pfitem*) = false
  -- otherwise

def $pfarray(F, pcpath, pfitem*, z) = F[.VALUE = eps]
  -- if ~$pfready(pfitem*)
def $pfarray(F, pcpath, pfitem*, z) = $pfbuilt(F, pcpath, $pfconstruct(S, n, pfitem*, z), n, z)
  -- if $pfready(pfitem*)
  -- if S = $allocate_array(F.MEMORY, $array_empty())
  -- if S.RESULT = KNOWN (PARRAY n)
def $pfconstruct(S, n, eps, z) = PFBUILT S
def $pfconstruct(S, n, (PFITEM (pvalue) pfkey false) :: pfitem*, z) = $pfconstructkey(S, n, pvalue, pfkey, pfitem*, z)
def $pfconstructkey(S, n, pvalue, PFNO_KEY, pfitem*, z) = $pfinsert(S, n, eps, pvalue, pfitem*, z)
def $pfconstructkey(S, n, pvalue, PFKEY (PARRAY n_key), pfitem*, z) = PFSTATIC "Illegal offset type"
def $pfconstructkey(S, n, pvalue, PFKEY (pvalue_key), pfitem*, z) = $pfinsert(S_key, n, (S_key.KEY), pvalue, pfitem*, z)
  -- if $constant_state($key_value(S, pvalue_key, false, z)) = (S_key)
def $pfconstructkey(S, n, pvalue, pfkey, pfitem*, z) = PFDEFER
  -- otherwise
def $pfinsert(S, n, pkey?, pvalue, pfitem*, z) = $pfinserted($literal_insert(S, n, pkey?, pvalue, z), n, pfitem*, z)
def $pfinserted(S, n, pfitem*, z) = $pfconstruct(S, n, pfitem*, z)
  -- if S.COMPLETION = NORMAL
  -- if S.EVENTS = eps
def $pfinserted(S, n, pfitem*, z) = PFDEFER
  -- otherwise
def $pfbuilt(F, pcpath, PFBUILT S, n, z) = $pfremember(F[.MEMORY = S], pcpath, (PARRAY n), z)
def $pfbuilt(F, pcpath, PFDEFER, n, z) = F[.VALUE = eps]
def $pfbuilt(F, pcpath, PFSTATIC text, n, z) = $pferror(F, text, z)

;; A cached rewrite belongs to the lexical context of its source occurrence.
def $pfcontext_at(eps, pcpath) = eps
def $pfcontext_at((PFCONTEXT pcpath plenv) :: pfcontext*, pcpath) = (plenv)
def $pfcontext_at((PFCONTEXT pcpath_other plenv) :: pfcontext*, pcpath) = $pfcontext_at(pfcontext*, pcpath)
  -- if pcpath_other =/= pcpath
def $pfcontextualize(F, pcpath) = F[.CONTEXTS = F.CONTEXTS ++ [PFCONTEXT pcpath F.ENV]]
  -- if $pfcontext_at(F.CONTEXTS, pcpath) = eps
def $pfcontextualize(F, pcpath) = F
  -- if $pfcontext_at(F.CONTEXTS, pcpath) = (F.ENV)
def $pfcontextualize(F, pcpath) = $pfunsupported(F, "constant occurrence lexical context changed")
  -- otherwise

;; Rewrites preserve original occurrence identities, including a selected dynamic arm.
def $pfredirect(eps, pcpath) = eps
def $pfredirect((pcpath, pcpath_target) :: (pcpath_from, pcpath_to)*, pcpath) = (pcpath_target)
def $pfredirect((pcpath_other, pcpath_target) :: (pcpath_from, pcpath_to)*, pcpath) = $pfredirect((pcpath_from, pcpath_to)*, pcpath)
  -- if pcpath_other =/= pcpath
def $pftracked(F, pcpath, expression, z) = $pfselected(F, pcpath, pcpath_target, expression_target, z)
  -- if F.MEMORY.COMPLETION = NORMAL
  -- if $pffact(F.FACTS, pcpath) = eps
  -- if $pfredirect(F.REDIRECTS, pcpath) = (pcpath_target)
  -- if $occurrence_node(F.SOURCE.OCCURRENCES, pcpath_target) = (expression_target)

def $pfwarning_events(eps, pcpath) = eps
def $pfwarning_events((DIAGNOSTIC "Warning" ptbytes z) :: pevent*, pcpath) = (pcpath, ptbytes, z) :: $pfwarning_events(pevent*, pcpath)
def $pfwarned(F, pcpath, S) = F[.MEMORY = S[.EVENTS = eps]][.WARNINGS = F.WARNINGS ++ $pfwarning_events(S.EVENTS, pcpath)][.VALUE = (pvalue)]
  -- if S.RESULT = KNOWN pvalue
def $pftruth(F, pcpath, pvalue, z) = $pfwarned(F, pcpath, $truth_value(F.MEMORY, pvalue, z))

;; Constant Boolean/comparison operations permit their coercion warnings;
;; arithmetic operations retain their separate error-producing operand guard.
def $pfbinary(F, pcpath, pbin, (pvalue_left), (pvalue_right), z) = $pfremember(F_result, pcpath, F_result.VALUE, z)
  -- if F.MEMORY.COMPLETION = NORMAL
  -- if $pfwarning_binary(pbin)
  -- if S = $binary_apply(F.MEMORY, pbin, pvalue_left, pvalue_right, z)
  -- if S.COMPLETION = NORMAL
  -- if F_result = $pfwarned(F, pcpath, S)

def $pfdispatch(F, pcpath, PFNOT expression, z) = $pfnot($pffold(F, pcpath ++ [PCFIELD 0], expression, z), pcpath, z)
def $pfnot(F, pcpath, z) = F
  -- if F.MEMORY.COMPLETION =/= NORMAL
def $pfnot(F, pcpath, z) = F[.VALUE = eps]
  -- if F.MEMORY.COMPLETION = NORMAL
  -- if F.VALUE = (PFLOAT n)
def $pfnot(F, pcpath, z) = $pfremember(F, pcpath, (PBOOL (~$truth(F.MEMORY, pvalue))), z)
  -- if F.MEMORY.COMPLETION = NORMAL
  -- if F.VALUE = (pvalue)
  -- if $type_bytes(pvalue) =/= [102,108,111,97,116]
def $pfnot(F, pcpath, z) = F[.VALUE = eps]
  -- otherwise

;; The constant AST pass visits BOTH logical operands before selecting the value.
def $pfdispatch(F, pcpath, PFSHORT b_or expression_left expression_right, z) = $pfshort(F_right, pcpath, b_or, F_left.VALUE, F_right.VALUE, z)
  -- if F_left = $pffold(F, pcpath ++ [PCFIELD 0], expression_left, z)
  -- if F_right = $pffold(F_left, pcpath ++ [PCFIELD 1], expression_right, z)
