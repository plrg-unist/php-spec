  -- if pweakmapentry.VALUE = POBJECT n_value
  -- if pnode_live* = $heap_reach(pnode_roots*, eps, $weakmap_gc_strip(hedge*, n_map, n_value))
  -- if ~((HOBJECT n_map) <- pnode_live*) \/ ~((HOBJECT pweakmapentry.KEY) <- pnode_live*)

;; With no destructor or resurrection, actual key notification removes this
;; entry before the existing strong-graph boundary and atomic white disposal.
def $weakmap_gc_prepare(S, pgcplan) = S[.OBJECTS[n_map] = WEAKMAP eps]
  -- if S.TODO = (GC_FREE pgcplan) :: ptask_tail*
  -- if $call_task_valid(S, GC_FREE pgcplan)
  -- if pgcplan.DTORS = eps
  -- if $weakmap_gc_map(S, S.ALLOCATIONS) = (n_map)
  -- if S.OBJECTS[n_map] = WEAKMAP (pweakmapentry)
  -- if pweakmapentry.VALUE = POBJECT n_value
  -- if (HOBJECT pweakmapentry.KEY) <- pgcplan.FREESET /\ (HOBJECT n_value) <- pgcplan.FREESET
  -- if ~((HOBJECT n_map) <- pgcplan.FREESET)
  -- if H = $gc_graph(S)
  -- if $heap_intersect([HOBJECT pweakmapentry.KEY, HOBJECT n_value], $heap_reach(H.ROOTS, eps, H.EDGES)) = eps
def $weakmap_gc_prepare(S, pgcplan) = S -- otherwise

def $gc_begin(S, pconfigcall) = S[.COMPLETION = UNSUPPORTED "WeakMap ephemeron collection"] -- if $weakmap_nonempty(S, S.ALLOCATIONS) /\ $weakmap_gc_map(S, S.ALLOCATIONS) = eps

def $method_select(S, poperand, ptbytes, phpType7*, z) = S_read[.COMPLETION = UNSUPPORTED "WeakMap method protocol"]
  -- if S_read = $resolve_at(S, poperand, z)
  -- if S_read.COMPLETION = NORMAL
  -- if S_read.RESULT = KNOWN (POBJECT n)
  -- if $weakmap_at(S_read, n)
def $scoped_select(S, phpType19, KNOWN (PSTRING ptbytes_class), ptbytes, phpType7*, z) = S[.COMPLETION = UNSUPPORTED "WeakMap static method protocol"]
  -- if $ptlc($typed_callable_name(ptbytes_class)) = $ptascii("weakmap")
def $clone_value(S, POBJECT n, z) = S[.COMPLETION = UNSUPPORTED "WeakMap clone protocol"] -- if $weakmap_at(S, n)
;; get_properties_for(ARRAY_CAST) returns NULL, including for populated maps.
def $cast_value(S, CASTARRAY, POBJECT n, z) = $allocate_array(S, {ITEMS eps, NEXT 0, POSITIONS eps, SERIAL 0})
  -- if $weakmap_at(S, n) /\ ~$instance_storage_freeing(S, n)
def $object_foreach_reset(S, n) = S[.COMPLETION = UNSUPPORTED "WeakMap iteration protocol"] -- if $weakmap_at(S, n)
def $property_unset_key_unshared(S, POBJECT n, ptbytes, z) = S[.COMPLETION = UNSUPPORTED "WeakMap property unset protocol"] -- if $weakmap_at(S, n)
def $property_quiet_key(S, POBJECT n, ptbytes, z) = S[.COMPLETION = UNSUPPORTED "WeakMap quiet property protocol"] -- if $weakmap_at(S, n)
;; Standard same-class zero-property comparison never inspects private entries.
def $value_order(S, POBJECT n_left, POBJECT n_right, pcompareguard_seen*) = ORDER 0
  -- if n_left =/= n_right
  -- if ~($instance_storage_freeing(S, n_left) \/ $instance_storage_freeing(S, n_right))
  -- if $weakmap_at(S, n_left) /\ $weakmap_at(S, n_right)
;; These pairs use zend_std_compare_objects, including Closure's fallback for
;; unlike compare handlers. Class mismatch precedes any property or body walk.
dec $weakmap_standard_other(pobject) : bool
def $weakmap_standard_other(STDINSTANCE) = true
def $weakmap_standard_other(INSTANCE porigin) = true
def $weakmap_standard_other(WEAKREFERENCE n_target?) = true
def $weakmap_standard_other(THROWABLE pthrowable) = $throwable_kind(pthrowable.KIND)
def $weakmap_standard_other(GENERATOR pgenerator) = true
def $weakmap_standard_other(FIBER pfiber) = true
def $weakmap_standard_other(pobject) = true
  -- if $object_body(pobject) = REALCLOSURE porigin pitem* pstaticcell*
def $weakmap_standard_other(pobject) = true
  -- if $object_body(pobject) = NAMEDCLOSURE porigin
def $weakmap_standard_other(pobject) = true
  -- if $object_body(pobject) = METHODCLOSURE porigin_method porigin_site porigin_requested pmethodcapture?
def $weakmap_standard_other(pobject) = true
  -- if $object_body(pobject) = ARRAYMETHODCLOSURE pcalltarget parrayselection pmethodcapture?
def $weakmap_standard_other(pobject) = true
  -- if $object_body(pobject) = STRINGMETHODCLOSURE pcalltarget pstringselection
def $weakmap_standard_other(pobject) = false -- otherwise
def $weakmap_standard_mismatch(S, n_left, n_right) = true
  -- if $(n_left < |S.OBJECTS|) /\ $(n_right < |S.OBJECTS|)
  -- if (HOBJECT n_left) <- S.ALLOCATIONS /\ (HOBJECT n_right) <- S.ALLOCATIONS
  -- if ~($instance_storage_freeing(S, n_left) \/ $instance_storage_freeing(S, n_right))
  -- if ($weakmap_at(S, n_left) /\ $weakmap_standard_other(S.OBJECTS[n_right])) \/ ($weakmap_at(S, n_right) /\ $weakmap_standard_other(S.OBJECTS[n_left]))
def $weakmap_standard_mismatch(S, n_left, n_right) = false -- otherwise
def $value_order(S, POBJECT n_left, POBJECT n_right, pcompareguard_seen*) = ORDER 1
  -- if $weakmap_standard_mismatch(S, n_left, n_right)
def $value_order_effect(S, POBJECT n_left, POBJECT n_right, pcompareguard_seen*, z) = (S, ORDER 1)
  -- if $weakmap_standard_mismatch(S, n_left, n_right)
def $value_order(S, POBJECT n_left, POBJECT n_right, pcompareguard_seen*) = ORDERUNSUPPORTED "WeakMap comparison protocol"
  -- if n_left =/= n_right
  -- if ~($instance_storage_freeing(S, n_left) \/ $instance_storage_freeing(S, n_right))
  -- if $weakmap_at(S, n_left) =/= $weakmap_at(S, n_right)
  -- if ~$weakmap_standard_mismatch(S, n_left, n_right)

;; A retired wrapper is harmless borrowed history; a live GET additionally
;; authenticates the unique current key pin and the allocated wrapper.
def $weakmap_storage_notice_valid(S, pinstancestorage) = true
  -- if pinstancestorage.NOTIFY = eps
def $weakmap_storage_notice_valid(S, pinstancestorage) = true
  -- if n_key = pinstancestorage.OBJECT
  -- if $(n_key < |S.OBJECTS|) /\ (HOBJECT n_key) <- S.ALLOCATIONS
  -- if S.OBJECTS[n_key] = STDINSTANCE \/ S.OBJECTS[n_key] = WEAKMAP eps
  -- if pinstancestorage.SLOTS = eps /\ pinstancestorage.NEXT = 0
  -- if pinstancestorage.NOTIFY = (n_wrapper)
  -- if $(n_wrapper < |S.OBJECTS|) /\ $(n_key < n_wrapper)
  -- if S.OBJECTS[n_wrapper] = WEAKREFERENCE (n_key)
def $weakmap_storage_notice_valid(S, pinstancestorage) = false -- otherwise
def $weakmap_storage_read(S, n_wrapper, n_key) = true
  -- if $weakref_at(S, n_wrapper) = (WEAKREFERENCE (n_key))
  -- if $instance_storage_for(S, n_key) = (pinstancestorage)
  -- if pinstancestorage.NOTIFY = (n_wrapper)
  -- if $instance_storage_basic(S, pinstancestorage)
  -- if $instance_storage_state_valid(S)
def $weakmap_storage_read(S, n_wrapper, n_key) = false -- otherwise
rule PhpStep/weakmap-key-notify: S ~> S[.TODO = (INSTANCE_STORAGE_STEP pinstancestorage[.NOTIFY = eps]) :: ptask_tail*]
  -- if S.TODO = (INSTANCE_STORAGE_STEP pinstancestorage) :: ptask_tail*
  -- if $instance_storage_valid(S, pinstancestorage)
  -- if pinstancestorage.NOTIFY =/= eps

;; Continuation must preserve the already-cleared wrapper notification.
;; A historical retired wrapper is allowed, but a different current one is not.
dec $weakmap_key_continue(pstate, nat) : pstate
def $weakmap_key_continue(S, n_key) = $weakmap_key_notice(S, n_key)
  -- if S.TODO = (INSTANCE_STORAGE_STEP pinstancestorage) :: ptask_tail*
  -- if pinstancestorage.OBJECT = n_key
  -- if $instance_storage_valid(S, pinstancestorage)
  -- if pinstancestorage.NEXT = 0 /\ pinstancestorage.SLOTS = eps /\ pinstancestorage.NOTIFY = eps
  -- if S.OBJECTS[n_key] = STDINSTANCE
  -- if $weakmap_key_maps(S, S.ALLOCATIONS, n_key) = [n_map]
  -- if $weakmap_entry_leaf(S, n_map, n_key)
  -- if S.OBJECTS[n_map] = WEAKMAP (pweakmapentry)
  -- if pweakmapentry.BEFORE = (n_wrapper)
  -- if $weakref_find(S, S.ALLOCATIONS, n_key) = eps \/ $weakref_find(S, S.ALLOCATIONS, n_key) = (n_wrapper)
def $weakmap_key_continue(S, n_key) = S[.COMPLETION = UNSUPPORTED "WeakMap key notification storage authority"] -- otherwise

;; After callback cleanup and wrapper notification, visit the remaining entry
;; before the same physical Key pin may finish. No second edge is detached early.
rule PhpStep/weakmap-key-next: S ~> $weakmap_key_continue(S, pinstancestorage.OBJECT)
  -- if S.TODO = (INSTANCE_STORAGE_STEP pinstancestorage) :: ptask_tail*
  -- if $instance_storage_valid(S, pinstancestorage)
  -- if S.OBJECTS[pinstancestorage.OBJECT] = STDINSTANCE
  -- if pinstancestorage.NEXT = 0 /\ pinstancestorage.SLOTS = eps /\ pinstancestorage.NOTIFY = eps
  -- if $weakmap_key_waiting(S, pinstancestorage.OBJECT)

;; A live own-free callback may reuse or recreate its weak wrapper. Only the
;; borrowed notification identity changes; the physical pin still owns the map.
def $weakmap_storage_create(S, n_map) = true
  -- if $weakmap_at(S, n_map)
  -- if S.OBJECTS[n_map] = WEAKMAP eps
  -- if $instance_storage_for(S, n_map) = (pinstancestorage)
  -- if pinstancestorage.NOTIFY = (n_wrapper)
  -- if $instance_storage_basic(S, pinstancestorage)
  -- if $instance_storage_state_valid(S)
  -- if $instance_storage_select($instance_storage_tasks(S.TODO) ++ $instance_storage_frames(S.FRAMES), n_map) = (pinstancestorage)
  -- if $weakref_find(S, S.ALLOCATIONS, n_map) = eps \/ $weakref_find(S, S.ALLOCATIONS, n_map) = (n_wrapper)
def $weakmap_storage_create(S, n_map) = false -- otherwise

dec $weakmap_notify_task(ptask, nat, nat) : ptask
dec $weakmap_notify_tasks(ptask*, nat, nat) : ptask*
dec $weakmap_notify_frames(pframe*, nat, nat) : pframe*
def $weakmap_notify_task(INSTANCE_STORAGE_STEP pinstancestorage, n_map, n_wrapper) = INSTANCE_STORAGE_STEP pinstancestorage[.NOTIFY = (n_wrapper)]
  -- if pinstancestorage.OBJECT = n_map
def $weakmap_notify_task(AT porigin ptask, n_map, n_wrapper) = AT porigin ($weakmap_notify_task(ptask, n_map, n_wrapper))
def $weakmap_notify_task(ptask, n_map, n_wrapper) = ptask -- otherwise
def $weakmap_notify_tasks(eps, n_map, n_wrapper) = eps
def $weakmap_notify_tasks(ptask :: ptask_tail*, n_map, n_wrapper) = $weakmap_notify_task(ptask, n_map, n_wrapper) :: $weakmap_notify_tasks(ptask_tail*, n_map, n_wrapper)
def $weakmap_notify_frames(eps, n_map, n_wrapper) = eps
def $weakmap_notify_frames(pframe :: pframe_tail*, n_map, n_wrapper) = pframe[.TODO = $weakmap_notify_tasks(pframe.TODO, n_map, n_wrapper)] :: $weakmap_notify_frames(pframe_tail*, n_map, n_wrapper)

def $weakref_create(S, n_map) = $weakref_done(S, POBJECT n_wrapper)
  -- if $weakmap_storage_create(S, n_map)
  -- if $weakref_find(S, S.ALLOCATIONS, n_map) = (n_wrapper)
def $weakref_create(S, n_map) = $weakref_done(S[.OBJECTS = S.OBJECTS ++ [WEAKREFERENCE (n_map)]][.ALLOCATIONS = S.ALLOCATIONS ++ [HOBJECT n_wrapper]][.TODO = $weakmap_notify_tasks(S.TODO, n_map, n_wrapper)][.FRAMES = $weakmap_notify_frames(S.FRAMES, n_map, n_wrapper)], POBJECT n_wrapper)
  -- if $weakmap_storage_create(S, n_map)
  -- if $weakref_find(S, S.ALLOCATIONS, n_map) = eps
  -- if n_wrapper = |S.OBJECTS|

;; A callback may leave the admitted singleton shape. Refuse its real retrace
;; rather than silently restoring a strong map-value edge and a zero count.
rule PhpStep/weak-map-gc-trace-shape-refused: S ~> S[.COMPLETION = UNSUPPORTED "WeakMap ephemeron collection"]
  -- if S.TODO = (GC_TRACE pgccall) :: ptask_tail*
  -- if $call_task_valid(S, GC_TRACE pgccall)
  -- if $weakmap_nonempty(S, S.ALLOCATIONS)
  -- if $weakmap_gc_map(S, S.ALLOCATIONS) = eps
