;; Zend/zend_weakrefs.c: the entry owns its value, never its key. This first
;; slice admits one ordinary key/leaf value and actual std_dtor notification.
def $weakmap_object(WEAKMAP pweakmapentry?) = true
def $weakmap_object(pobject) = false -- otherwise
dec $weakmap_at(pstate, nat) : bool
def $weakmap_at(S, n) = true
  -- if $(n < |S.OBJECTS|) /\ (HOBJECT n) <- S.ALLOCATIONS
  -- if $weakmap_object(S.OBJECTS[n])
def $weakmap_at(S, n) = false -- otherwise
def $closure_live_object_valid(S, n) = true -- if $weakmap_at(S, n)
def $closure_scope_complete(S, (HOBJECT n) :: pnode*) = $closure_scope_complete(S, pnode*) -- if $weakmap_at(S, n)
def $property_live_complete(S, (HOBJECT n) :: pnode*) = $property_live_complete(S, pnode*) -- if $weakmap_at(S, n)
def $object_name(S, n) = $ptascii("WeakMap") -- if S.OBJECTS[n] = WEAKMAP pweakmapentry?
def $getclass_live_object(S, n) = true -- if $weakmap_at(S, n)
def $class_instanceof(S, POBJECT n, ptbytes) = ($ptlc($typed_callable_name(ptbytes)) <- [$ptascii("weakmap"), $ptascii("arrayaccess"), $ptascii("countable"), $ptascii("iteratoraggregate"), $ptascii("traversable")])
  -- if S.OBJECTS[n] = WEAKMAP pweakmapentry?
def $typed_object_exact(S, ptbranch*, POBJECT n) = ($typed_class_type(ptbranch*, $ptascii("WeakMap")) \/ $typed_class_type(ptbranch*, $ptascii("ArrayAccess")) \/ $typed_class_type(ptbranch*, $ptascii("Countable")) \/ $typed_class_type(ptbranch*, $ptascii("IteratorAggregate")) \/ $typed_class_type(ptbranch*, $ptascii("Traversable")))
  -- if S.OBJECTS[n] = WEAKMAP pweakmapentry?
def $typed_given(S, POBJECT n) = $ptascii("WeakMap") -- if S.OBJECTS[n] = WEAKMAP pweakmapentry?
def $node_children(S, HOBJECT n) = eps -- if S.OBJECTS[n] = WEAKMAP eps
def $node_children(S, HOBJECT n) = $value_nodes(pweakmapentry.VALUE)
  -- if S.OBJECTS[n] = WEAKMAP (pweakmapentry)

dec $weakmap_new_site(pstate) : bool
def $weakmap_new_site(S) = true
  -- if S.CONSTCONTEXT = eps
  -- if S.ORIGIN = (porigin)
  -- if $origin_node(S.SOURCES, porigin) = (NExprNew name (SEQUENCE eps) metadata)
  -- if $new_source_name(S, porigin) = (ptbytes)
  -- if $ptlc(ptbytes) = $ptascii("weakmap")
def $weakmap_new_site(S) = false -- otherwise
def $new_class(S, ptbytes, z) = S[.OBJECTS = S.OBJECTS ++ [WEAKMAP eps]][.ALLOCATIONS = S.ALLOCATIONS ++ [HOBJECT n]][.RESULT = KNOWN (POBJECT n)][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if $ptlc(ptbytes) = $ptascii("weakmap") /\ $weakmap_new_site(S)
  -- if n = |S.OBJECTS|
def $new_class(S, ptbytes, z) = S[.COMPLETION = UNSUPPORTED "WeakMap constructor arguments or deferred initialization"]
  -- if $ptlc(ptbytes) = $ptascii("weakmap") /\ ~$weakmap_new_site(S)

def $noctor_object_valid(S, pnoctorcall) = true
  -- if $weakmap_at(S, pnoctorcall.OBJECT)
  -- if S.OBJECTS[pnoctorcall.OBJECT] = WEAKMAP eps
  -- if $ptlc(pnoctorcall.CLASS) = $ptascii("weakmap")
  -- if $weakmap_new_site(S)

;; Reuse the language's ArrayAccess operand/source protocol, without invoking
;; an invented user method. RHS readback remains the assignment's result.
dec $weakmap_key_maps(pstate, pnode*, nat) : nat*
dec $weakmap_has_key(pstate, nat, nat) : bool
def $weakmap_key_maps(S, eps, n_key) = eps
def $weakmap_key_maps(S, (HOBJECT n) :: pnode_tail*, n_key) = n :: $weakmap_key_maps(S, pnode_tail*, n_key)
  -- if $weakmap_has_key(S, n, n_key)
def $weakmap_key_maps(S, (HOBJECT n) :: pnode_tail*, n_key) = $weakmap_key_maps(S, pnode_tail*, n_key)
  -- if ~$weakmap_has_key(S, n, n_key)
def $weakmap_key_maps(S, (HCELL n) :: pnode_tail*, n_key) = $weakmap_key_maps(S, pnode_tail*, n_key)
def $weakmap_key_maps(S, (HARRAY n) :: pnode_tail*, n_key) = $weakmap_key_maps(S, pnode_tail*, n_key)
def $weakmap_has_key(S, n, n_key) = true
  -- if $weakmap_at(S, n)
  -- if S.OBJECTS[n] = WEAKMAP (pweakmapentry)
  -- if pweakmapentry.KEY = n_key
def $weakmap_has_key(S, n, n_key) = false -- otherwise
dec $weakmap_write_allowed(pstate, paccess) : bool
def $weakmap_write_allowed(S, paccess) = true
  -- if paccess.MODE = ACCESS_SET /\ ~paccess.LATCH /\ ~paccess.KEYHOLE
  -- if paccess.BASE = BASE_VALUE poperand
  -- if paccess.TASK = ASSIGN_ARRAY (BASE_DIM paccess.BASE paccess.INPUT paccess.KEYLINE) paccess.LINE false
  -- if paccess.OBJECT = (n_map)
  -- if $weakmap_at(S, n_map)
  -- if ~$instance_storage_freeing(S, n_map)
  -- if S_base = $quiet_operand(S, poperand)
  -- if S_base.COMPLETION = NORMAL
  -- if S_base.RESULT = KNOWN (POBJECT n_map)
  -- if S_key = $quiet_operand(S, paccess.INPUT)
  -- if S_key.COMPLETION = NORMAL
  -- if S_key.RESULT = KNOWN paccess.OFFSET
  -- if S_value = $quiet_operand(S, paccess.SELECTED)
  -- if S_value.COMPLETION = NORMAL
  -- if S_value.RESULT = KNOWN paccess.VALUE
  -- if $access_valid(S, paccess[.PHASE = ACCESS_CALL $ptascii("offsetSet")])
  -- if S.OBJECTS[n_map] = WEAKMAP eps
  -- if paccess.OFFSET = POBJECT n_key
  -- if $(n_key < |S.OBJECTS|) /\ (HOBJECT n_key) <- S.ALLOCATIONS
  -- if S.OBJECTS[n_key] = STDINSTANCE /\ ~$instance_storage_freeing(S, n_key)
  -- if $node_children(S, HOBJECT n_key) = eps
  -- if $weakmap_key_maps(S, S.ALLOCATIONS, n_key) = eps
  -- if paccess.VALUE = POBJECT n_value
  -- if $(n_value < |S.OBJECTS|) /\ (HOBJECT n_value) <- S.ALLOCATIONS
  -- if S.OBJECTS[n_value] = INSTANCE porigin
  -- if ~$instance_storage_freeing(S, n_value)
  -- if $node_children(S, HOBJECT n_value) = eps
def $weakmap_write_allowed(S, paccess) = false -- otherwise
dec $weakmap_replace_allowed(pstate, paccess) : bool
def $access_call(S, paccess, ptbytes) = $access_done(S_read[.OBJECTS[n_map] = WEAKMAP ({KEY n_key, VALUE paccess.VALUE, BEFORE $weakref_find(S, S.ALLOCATIONS, n_key)})], paccess, pvalue_result)
  -- if paccess.OBJECT = (n_map)
  -- if $weakmap_at(S, n_map)
  -- if ptbytes = $ptascii("offsetSet") /\ $weakmap_write_allowed(S, paccess)
  -- if paccess.OFFSET = POBJECT n_key
  -- if S_read = $quiet_operand(S, paccess.SELECTED)
  -- if S_read.COMPLETION = NORMAL
  -- if S_read.RESULT = KNOWN pvalue_result
;; Replacing an existing key keeps its registration and publishes the new
;; value before ordinary eager release of the old value.
def $access_call(S, paccess, ptbytes) = S[.OBJECTS[n_map] = WEAKMAP (pweakmapentry[.VALUE = paccess.VALUE])][.TODO = (ACCESS_RESUME paccess[.PHASE = ACCESS_CALL ptbytes]) :: ptask_tail*][.ORIGIN = (paccess.SITE)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if paccess.OBJECT = (n_map)
  -- if $weakmap_at(S, n_map)
  -- if ptbytes = $ptascii("offsetSet") /\ $weakmap_replace_allowed(S, paccess)
  -- if S.OBJECTS[n_map] = WEAKMAP (pweakmapentry)
  -- if S.TODO = paccess.TASK :: ptask_tail*
;; The receiver survives old-value cleanup, but the assignment result is not
;; copied until write_dimension returns. An unused result needs no RHS read.
;; ASSIGN_DIM frees OP_DATA, the receiver pin, OP2, then OP1. These are
;; the same owning roots as the ordinary access carrier, in decrement order.
def $weakmap_set_shape(paccess) = true
  -- if paccess.MODE = ACCESS_SET /\ ~paccess.LATCH /\ ~paccess.KEYHOLE
  -- if paccess.PHASE = ACCESS_CALL $ptascii("offsetSet")
  -- if paccess.TASK = ASSIGN_ARRAY (BASE_DIM paccess.BASE paccess.INPUT paccess.KEYLINE) paccess.LINE false
  -- if paccess.OUTER
  -- if paccess.OBJECT =/= eps
def $weakmap_set_shape(paccess) = false -- otherwise
def $task_nodes(ACCESS_RESUME paccess) = $operand_nodes(paccess.RHS) ++ $access_object_roots(paccess.OBJECT, paccess.OUTER) ++ $operand_nodes(paccess.INPUT) ++ $base_nodes(paccess.BASE)
  -- if $weakmap_set_shape(paccess)
def $weakmap_set_resume(S, paccess) = true
  -- if $weakmap_set_shape(paccess)
  -- if paccess.OBJECT = (n_map)
  -- if $weakmap_at(S, n_map)
  -- if ~$instance_storage_freeing(S, n_map)
  -- if $access_valid(S, paccess)
def $weakmap_set_resume(S, paccess) = false -- otherwise
dec $weakmap_set_finish(pstate, paccess) : pstate
def $weakmap_set_finish(S, paccess) = $access_done(S, paccess, PNULL)
  -- if S.TODO = (ACCESS_RESUME paccess) :: ptask_tail*
  -- if $destructor_return_discarded(ptask_tail*)
def $weakmap_set_finish(S, paccess) = $access_done(S_read, paccess, pvalue_result)
  -- if S.TODO = (ACCESS_RESUME paccess) :: ptask_tail*
  -- if ~$destructor_return_discarded(ptask_tail*)
  -- if S_read = $quiet_operand(S, paccess.SELECTED)
  -- if S_read.COMPLETION = NORMAL
  -- if S_read.RESULT = KNOWN pvalue_result
def $weakmap_set_finish(S, paccess) = S_read
  -- if S.TODO = (ACCESS_RESUME paccess) :: ptask_tail*
  -- if ~$destructor_return_discarded(ptask_tail*)
  -- if S_read = $quiet_operand(S, paccess.SELECTED)
  -- if S_read.COMPLETION =/= NORMAL
rule PhpStep/weakmap-set-resume: S ~> $weakmap_set_finish(S, paccess)
  -- if S.TODO = (ACCESS_RESUME paccess) :: ptask_tail*
  -- if $weakmap_set_resume(S, paccess)
;; Ordinary dimension reads copy the stored value. Object-store handles,
;; not permanent semantic IDs, appear in the missing-key Error message.
