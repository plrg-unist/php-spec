  -- if pinstancestorage.SLOTS = eps /\ pinstancestorage.NEXT = 0
  -- if pinstancestorage.NOTIFY = (n_wrapper)
  -- if $(n_wrapper < |S.OBJECTS|) /\ $(n_key < n_wrapper)
  -- if S.OBJECTS[n_wrapper] = WEAKREFERENCE (n_key)
def $weakmap_storage_notice_valid(S, pinstancestorage) = false -- otherwise
def $weakmap_storage_read(S, n_wrapper, n_key) = true
