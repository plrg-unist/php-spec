def $scoped_select(S, phpType19, KNOWN (PSTRING ptbytes_class), ptbytes, phpType7*, z) = S[.COMPLETION = UNSUPPORTED "WeakMap static method protocol"]
  -- if $ptlc($typed_callable_name(ptbytes_class)) = $ptascii("weakmap")
def $clone_value(S, POBJECT n, z) = S[.COMPLETION = UNSUPPORTED "WeakMap clone protocol"] -- if $weakmap_at(S, n)
def $cast_value(S, CASTARRAY, POBJECT n, z) = S[.COMPLETION = UNSUPPORTED "WeakMap array cast protocol"] -- if $weakmap_at(S, n)
def $object_foreach_reset(S, n) = S[.COMPLETION = UNSUPPORTED "WeakMap iteration protocol"] -- if $weakmap_at(S, n)
def $property_unset_key_unshared(S, POBJECT n, ptbytes, z) = S[.COMPLETION = UNSUPPORTED "WeakMap property unset protocol"] -- if $weakmap_at(S, n)
def $property_quiet_key(S, POBJECT n, ptbytes, z) = S[.COMPLETION = UNSUPPORTED "WeakMap quiet property protocol"] -- if $weakmap_at(S, n)
def $value_order(S, POBJECT n_left, POBJECT n_right, pnode_seen*) = ORDERUNSUPPORTED "WeakMap comparison protocol"
  -- if n_left =/= n_right
  -- if ~($instance_storage_freeing(S, n_left) \/ $instance_storage_freeing(S, n_right))
