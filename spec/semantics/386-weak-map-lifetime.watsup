;; A retired wrapper is harmless borrowed history; a live GET additionally
;; authenticates the unique current key pin and the allocated wrapper.
def $weakmap_storage_notice_valid(S, pinstancestorage) = true
  -- if pinstancestorage.NOTIFY = eps
def $weakmap_storage_notice_valid(S, pinstancestorage) = true
  -- if n_key = pinstancestorage.OBJECT
  -- if $(n_key < |S.OBJECTS|) /\ (HOBJECT n_key) <- S.ALLOCATIONS
