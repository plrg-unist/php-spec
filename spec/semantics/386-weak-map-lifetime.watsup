  -- if $(n_value < |S.OBJECTS|)
  -- if (HOBJECT n_value) <- S.ALLOCATIONS
  -- if S.OBJECTS[n_value] = INSTANCE porigin
  -- if ~$instance_storage_freeing(S, n_value)
  -- if $node_children(S, HOBJECT n_value) = eps
  -- if $destructor_jobs_valid(S, $destruction_values($value_nodes(pweakmapentry.VALUE)))
def $weakmap_free_allowed(S, n_map, pdestructionrelease) = false -- otherwise

