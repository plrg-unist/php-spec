dec $property_empty_active(pstate, pcallcontext?, pframe*, nat, ptbytes, bool) : bool
def $property_empty_active(S, (pcallcontext), pframe :: pframe_tail*, n, ptbytes, b_get) = ($property_empty_active_frame(S, pcallcontext, pframe, n, ptbytes, b_get) \/ $property_empty_active(S, pframe.CONTEXT, pframe_tail*, n, ptbytes, b_get))
def $property_empty_active(S, eps, pframe :: pframe_tail*, n, ptbytes, b_get) = $property_empty_active(S, pframe.CONTEXT, pframe_tail*, n, ptbytes, b_get)
