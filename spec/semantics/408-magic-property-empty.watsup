dec $property_empty_tail(pstate, ppropertyempty, bool, ptask*) : bool
def $property_empty_tail(S, ppropertyempty, b_get, (PROPERTY_EMPTY_RESULT ppropertyempty b_get) :: ptask_tail*) = $property_empty_valid(S, ppropertyempty)
def $property_empty_tail(S, ppropertyempty, b_get, ptask*) = false -- otherwise
