rule PhpStep/property-empty-nan-warning: S ~> $error_dispatch(S[.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], 2, $ptascii("unexpected NAN value was coerced to bool"), ppropertyempty.LINE, DIAGNOSTIC "Warning" ($ptascii("unexpected NAN value was coerced to bool")) ppropertyempty.LINE, PROPERTY_EMPTY_NAN ppropertyemptynan)
  -- if S.TODO = (PROPERTY_EMPTY_RESULT ppropertyempty true) :: ptask_tail*
  -- if $property_empty_nan_ready(S, ppropertyempty)
  -- if S.RESULT = KNOWN (PFLOAT n_float)
  -- if ppropertyemptynan = {EMPTY ppropertyempty, FLOAT n_float, OWNER (|S.FRAMES|), CALLER S.CURRENT, TAIL ptask_tail*}
rule PhpStep/property-empty-nan-result: S ~> S[.TODO = ppropertyemptynan.TAIL][.RESULT = KNOWN (PBOOL false)][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (PROPERTY_EMPTY_NAN ppropertyemptynan) :: ptask_tail*
