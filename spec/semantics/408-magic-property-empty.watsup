dec $property_empty_guard(pstate, nat, ptbytes) : bool
dec $property_empty_nan_guard(pstate, nat, ptbytes) : bool
def $property_empty_guard(S, n, ptbytes) = true
  -- if S.TODO = (PROPERTY_EMPTY_RESULT ppropertyempty b_get) :: ptask_tail*
