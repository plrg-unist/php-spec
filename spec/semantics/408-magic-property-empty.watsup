dec $property_empty_truth(pstate, pvalue) : bool?
def $property_empty_truth(S, PNULL) = (true)
def $property_empty_truth(S, PBOOL b) = (~b)
def $property_empty_truth(S, PINT i) = (i = 0)
def $property_empty_truth(S, PFLOAT n_float) = (~b)
  -- if $(n_float < 18446744073709551616)
  -- if (b, false) = $number_bool(NFLOAT n_float)
def $property_empty_truth(S, PSTRING ptbytes) = (ptbytes = eps \/ ptbytes = [48])
def $property_empty_truth(S, PSTRING_CARRIER pstringidentity ptbytes) = (ptbytes = eps \/ ptbytes = [48])
  -- if $string_carrier_valid(S, PSTRING_CARRIER pstringidentity ptbytes)
def $property_empty_truth(S, pvalue) = eps -- otherwise

;; i_zend_is_true warns after IN_GET is cleared, retaining IN_ISSET and the
;; receiver. The saved BYVAL double is independent of callback retval/CV writes.
dec $property_empty_nan_ready(pstate, ppropertyempty) : bool
def $property_empty_nan_ready(S, ppropertyempty) = true
  -- if S.COMPLETION = NORMAL /\ S.SOURCEPENDING = eps
