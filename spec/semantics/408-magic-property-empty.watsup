;; Inspect the pending emitter in its actual or saved caller scope. No caller
;; variable is recaptured, and no heap-owner query participates in guard lookup.
dec $property_empty_nan_task(pstate, ptask, nat, ptbytes) : bool
def $property_empty_nan_task(S, ptask, n, ptbytes) = true
  -- if $source_operand_marker(ptask) = PROPERTY_EMPTY_NAN ppropertyemptynan
  -- if ppropertyemptynan.EMPTY.OBJECT = n /\ ppropertyemptynan.EMPTY.NAME = ptbytes
  -- if $property_empty_nan_valid(S, ppropertyemptynan)
def $property_empty_nan_task(S, ptask, n, ptbytes) = false -- otherwise
dec $property_empty_nan_tasks(pstate, ptask*, nat, ptbytes) : bool
def $property_empty_nan_tasks(S, eps, n, ptbytes) = false
def $property_empty_nan_tasks(S, ptask :: ptask_tail*, n, ptbytes) = ($property_empty_nan_task(S, ptask, n, ptbytes) \/ $property_empty_nan_tasks(S, ptask_tail*, n, ptbytes))
dec $property_empty_nan_frames(pstate, pframe*, nat, ptbytes) : bool
def $property_empty_nan_frames(S, eps, n, ptbytes) = false
def $property_empty_nan_frames(S, pframe :: pframe_tail*, n, ptbytes) = ($property_empty_nan_tasks($constant_frame_view(S, pframe, pframe_tail*), pframe.TODO, n, ptbytes) \/ $property_empty_nan_frames(S, pframe_tail*, n, ptbytes))
def $property_empty_nan_guard(S, n, ptbytes) = ($property_empty_nan_tasks(S, S.TODO, n, ptbytes) \/ $property_empty_nan_frames(S, S.FRAMES, n, ptbytes))

;; A handler throw cancels truth delivery and drops the saved receiver before
;; outer catch search. The ordinary destruction transition observes that release.
dec $property_empty_nan_discard(pstate, ppropertyemptynan) : pstate
def $property_empty_nan_discard(S, ppropertyemptynan) = S[.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (THROW_SEARCH n_error) :: ppropertyemptynan.TAIL
  -- if $throwable_live(S, n_error)
  -- if $property_empty_nan_valid(S[.TODO = (PROPERTY_EMPTY_NAN ppropertyemptynan) :: ppropertyemptynan.TAIL], ppropertyemptynan)
def $property_empty_nan_discard(S, ppropertyemptynan) = S[.COMPLETION = UNSUPPORTED "magic empty NaN warning cleanup"] -- otherwise
def $error_read_discard(S, PROPERTY_EMPTY_NAN ppropertyemptynan) = $property_empty_nan_discard(S, ppropertyemptynan)
def $return_discard(S, PROPERTY_EMPTY_NAN ppropertyemptynan) = $property_empty_nan_discard(S, ppropertyemptynan)

