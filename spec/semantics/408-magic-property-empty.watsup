def $task_nodes(PROPERTY_EMPTY_NAN ppropertyemptynan) = [HOBJECT ppropertyemptynan.EMPTY.OBJECT]
def $call_task_valid(S, PROPERTY_EMPTY_NAN ppropertyemptynan) = $property_empty_nan_valid(S, ppropertyemptynan)
def $error_call_valid(S, perrorcall) = true
  -- if perrorcall.RESUME = PROPERTY_EMPTY_NAN ppropertyemptynan
  -- if $property_empty_nan_valid(S, ppropertyemptynan)
  -- if perrorcall.SITE = ppropertyemptynan.EMPTY.SITE /\ perrorcall.LEVEL = 2
