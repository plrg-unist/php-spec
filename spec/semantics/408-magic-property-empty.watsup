;; False selects __isset; true selects __get. One saved RESULT owns the receiver
;; through both calls and NaN warnings. Other primitive truth is pure; carriers authenticate.
dec $property_empty_method(pstate, nat, bool) : pmethoddesc?
def $property_empty_method(S, n, false) = $property_isset_method(S, n)
def $property_empty_method(S, n, true) = $property_get_method(S, n)
dec $property_empty_method_origin(ppropertyempty, bool) : porigin
def $property_empty_method_origin(ppropertyempty, false) = ppropertyempty.ISSET
def $property_empty_method_origin(ppropertyempty, true) = ppropertyempty.GET

dec $property_empty_source(pstate, porigin, ptbytes, int) : bool
def $property_empty_source(S, porigin, ptbytes, z) = true
  -- if porigin = PORIGIN n pcpath
  -- if $origin_node(S.SOURCES, porigin) = (expression)
  -- if expression = NExprPropertyFetch (NExprVariable (BYTES text_receiver) metadata_receiver) (NIdentifier (BYTES text_name) metadata_name) metadata
  -- if $base64(text_receiver) =/= $ptascii("this") /\ ptbytes = $base64(text_name)
  -- if $(|pcpath| > 0)
  -- if pcpath_empty = pcpath[0:$nabs($(|pcpath| - 1))]
  -- if pcpath = pcpath_empty ++ [PCFIELD 0]
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath_empty) = (NExprEmpty expression metadata_empty)
  -- if $property_source_task(S[.ORIGIN = (porigin)], expression)
  -- if z = $runtime_line(S[.ORIGIN = (porigin)], eps, expression)
  -- if $compiled_effects(S, porigin) = eps
def $property_empty_source(S, porigin, ptbytes, z) = false -- otherwise

;; Only authenticated empty preparation defers the ordinary getter interception.
def $property_empty_prepare(S) = true
  -- if S.TODO = (PROPERTY_PREP (NIdentifier (BYTES text_name) metadata_name) z) :: (ORIGIN_RETURN (porigin)) :: (ISSET_RESULT true z) :: ptask_tail*
  -- if S.ORIGIN = (porigin)
  -- if $property_empty_source(S, porigin, $base64(text_name), z)
  -- if S_read = $quiet_operand(S, S.RESULT)
  -- if S_read.RESULT = KNOWN (POBJECT n)
  -- if $property_isset_needed(S, n, $base64(text_name))

;; The selected getter keeps the existing untyped name/return compiler family.
