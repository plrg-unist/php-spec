def $property_empty_get_source(S, pmethoddesc) = true
  -- if pmethoddesc.VISIBILITY = PROPERTY_PUBLIC /\ ~pmethoddesc.STATIC /\ ~pmethoddesc.ABSTRACT
  -- if pfunction = pmethoddesc.FUNCTION
  -- if pmethoddesc.OWNER = PORIGIN n pcpath_owner
  -- if pfunction.ORIGIN = PORIGIN n pcpath
  -- if $(|pcpath| > 0)
  -- if PCINDEX n_method = pcpath[$nabs($(|pcpath| - 1))]
  -- if pcpath = pcpath_owner ++ [PCFIELD 5, PCINDEX n_method]
  -- if $class_at(S.CLASSES, pmethoddesc.OWNER) = (pclassdesc_owner)
  -- if pclassdesc_owner.KIND = "class" /\ pclassdesc_owner.PARENT = eps /\ ~pclassdesc_owner.READONLY
  -- if $method_origin(pclassdesc_owner.METHODS, pfunction.ORIGIN) = (pmethoddesc)
  -- if $origin_node(S.SOURCES, pclassdesc_owner.ORIGIN) = (NStmtClass phpType14_owner phpType24_owner phpType3_owner ABSENT phpType42_owner (SEQUENCE statement_owner*) metadata_owner)
  -- if $(n_method < |statement_owner*|)
  -- if $origin_node(S.SOURCES, pfunction.ORIGIN) = (statement_method)
  -- if statement_method = NStmtClassMethod (SEQUENCE eps) (INTEGER flags) (BOOLEAN false) (NIdentifier (BYTES text_method) metadata_method) (SEQUENCE ([NParam (SEQUENCE eps) (INTEGER 0) ABSENT (BOOLEAN false) (BOOLEAN false) (NExprVariable (BYTES text_parameter) metadata_parameter_name) ABSENT (SEQUENCE eps) metadata_parameter])) ABSENT (SEQUENCE statement*) metadata
  -- if statement_owner*[n_method] = statement_method
  -- if flags <- [0,1] /\ $ptlc($base64(text_method)) = $ptascii("__get") /\ pmethoddesc.NAME = $base64(text_method)
  -- if $origin_node(S.SOURCES, PORIGIN n (pcpath ++ [PCFIELD 4, PCINDEX 0])) = (NParam (SEQUENCE eps) (INTEGER 0) ABSENT (BOOLEAN false) (BOOLEAN false) (NExprVariable (BYTES text_parameter) metadata_parameter_name) ABSENT (SEQUENCE eps) metadata_parameter)
  -- if pfunction.SIGNATURE.PARAMETERS = [psparam]
  -- if psparam.NAME = $base64(text_parameter) /\ $ppmethod_get_signature(pfunction.SIGNATURE) /\ ~pfunction.SIGNATURE.BYREF
  -- if pfunction.NAME = pclassdesc_owner.NAME ++ $ptascii("::") ++ pmethoddesc.NAME
  -- if pfunction.BODY = pcpath ++ [PCFIELD 6] /\ pfunction.DEFAULTS = eps
  -- if $property_unset_body_source(S.SOURCES, n, pfunction.BODY, statement*, 0)
  -- if pfunction.LINE = $ppmethod_line(metadata) /\ pfunction.ENDLINE = $psendline(metadata)
  -- if ~$generator_statements(statement*)
def $property_empty_get_source(S, pmethoddesc) = false -- otherwise

dec $property_empty_method_source(pstate, pmethoddesc, bool) : bool
def $property_empty_method_source(S, pmethoddesc, false) = $property_magic_method_source(S, pmethoddesc, "__isset")
def $property_empty_method_source(S, pmethoddesc, true) = $property_empty_get_source(S, pmethoddesc)
