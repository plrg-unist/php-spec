  -- if S.RESULT = KNOWN (PFLOAT n_float)
  -- if $(n_float < 18446744073709551616)
  -- if $float_decode(n_float) = NOTNUMBER n_float
def $property_empty_nan_ready(S, ppropertyempty) = false -- otherwise
dec $property_empty_nan_valid(pstate, ppropertyemptynan) : bool
def $property_empty_nan_valid(S, ppropertyemptynan) = true
