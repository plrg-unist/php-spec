def $property_empty_entered(S, (pcallcontext), pframe :: pframe_tail*, ppropertyempty, b_get) = $property_empty_entered(S, pframe.CONTEXT, pframe_tail*, ppropertyempty, b_get)
  -- if pcallcontext.TARGET =/= PROPERTY_EMPTY_TARGET ppropertyempty b_get
