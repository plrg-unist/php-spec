  -- if $property_empty_pending(S)
  -- if $property_empty_plan(S) = eps
rule PhpStep/property-empty-false: S ~> S[.TODO = ptask_tail*][.RESULT = KNOWN (PBOOL true)][.BASE = BASE_VALUE (KNOWN PNULL)]
