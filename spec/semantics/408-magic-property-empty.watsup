rule PhpStep/property-empty-call: S ~> S_inputs[.TODO = [(CALL_ARGS (PROPERTY_EMPTY_TARGET ppropertyempty false) eps 1 ([KNOWN (PSTRING ppropertyempty.NAME)]) (ppropertyempty.SITE) ppropertyempty.LINE), PROPERTY_EMPTY_RESULT ppropertyempty false] ++ S_inputs.TODO][.HELD = S.HELD]
