  -- if $property_empty_pending_call(S, ppropertyempty, b_get)
def $property_empty_guard(S, n, ptbytes) = ($property_empty_active(S, S.CURRENT, S.FRAMES, n, ptbytes, false) \/ $property_empty_active(S, S.CURRENT, S.FRAMES, n, ptbytes, true) \/ $property_empty_nan_guard(S, n, ptbytes)) -- otherwise

