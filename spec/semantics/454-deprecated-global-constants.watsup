dec $deprecated_handler_exit_status_source(ptask, pdestructioncleanup, int) : bool
def $deprecated_handler_exit_status_source(EXIT_UNWIND z, pdestructioncleanup, z) = ~pdestructioncleanup.RELEASED
def $deprecated_handler_exit_status_source(DEPRECATED_HANDLER_EXIT pdestructioncleanup_old z ptask_saved*, pdestructioncleanup, z) = (~pdestructioncleanup_old.RELEASED /\ pdestructioncleanup = pdestructioncleanup_old[.RELEASED = true])
def $deprecated_handler_exit_status_source(ptask, pdestructioncleanup, z) = false -- otherwise
