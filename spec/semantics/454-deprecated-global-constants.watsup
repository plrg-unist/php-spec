def $call_task_valid(S, DEPRECATED_HANDLER_EXIT pdestructioncleanup z ptask*) = $deprecated_handler_exit_valid(S, pdestructioncleanup, z, ptask*)
def $task_nodes(DEPRECATED_HANDLER_EXIT pdestructioncleanup z ptask*) = $tasks_nodes(ptask*) -- if ~pdestructioncleanup.RELEASED
def $task_nodes(DEPRECATED_HANDLER_EXIT pdestructioncleanup z ((ERROR_HANDLER_RESULT perrorcall) :: ptask_tail*)) = $task_nodes(perrorcall.RESUME) ++ $tasks_nodes(ptask_tail*) -- if pdestructioncleanup.RELEASED
