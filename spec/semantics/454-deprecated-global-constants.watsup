;; The C warning call keeps its caller operands while locals and the saved raw
;; handler are released. The snapshot is nonowning; its live task owns exactly
;; the still-pending caller roots, then only the read and outer continuation.
dec $deprecated_handler_call(perrorcall) : bool
dec $deprecated_handler_exit_valid(pstate, pdestructioncleanup, int, ptask*) : bool
dec $deprecated_handler_exit_status(pstate, pdestructioncleanup, int, pdestructionoperation*) : bool
def $deprecated_handler_call(perrorcall) = true -- if perrorcall.RESUME = DEPRECATED_CONSTANT_RESULT pdeprecatedconstant
def $deprecated_handler_call(perrorcall) = true -- if perrorcall.RESUME = DEPRECATED_GLOBAL_CONSTANT_RESULT pconfigcall n_prefix
def $deprecated_handler_call(perrorcall) = false -- otherwise
def $deprecated_handler_history(S, ptask) = $closure_call_copy_warning_history(S, perrorcall)
