  -- if papiargcursor.CALL = API_ERROR perrorcall
def $deprecated_api_task(DEPRECATED_GLOBAL_CONSTANT_RESULT pconfigcall n, pconfigcall, n) = true
def $deprecated_api_task(ERROR_HANDLER_INVOKE perrorcall, pconfigcall, n) = (perrorcall.RESUME = DEPRECATED_GLOBAL_CONSTANT_RESULT pconfigcall n)
def $deprecated_api_task(ERROR_HANDLER_RESULT perrorcall, pconfigcall, n) = (perrorcall.RESUME = DEPRECATED_GLOBAL_CONSTANT_RESULT pconfigcall n)
def $deprecated_api_task(ERROR_HANDLER_CLEAN perrorcall, pconfigcall, n) = (perrorcall.RESUME = DEPRECATED_GLOBAL_CONSTANT_RESULT pconfigcall n)
def $deprecated_api_task(API_CALLBACK_SEND papiargcursor, pconfigcall, n) = (perrorcall.RESUME = DEPRECATED_GLOBAL_CONSTANT_RESULT pconfigcall n)
