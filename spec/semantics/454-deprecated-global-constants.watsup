def $closure_call_copy_exit_scope(S, S_exit) = S[.TODO = [DEPRECATED_HANDLER_EXIT pdestructioncleanup z S.TODO]][.COMPLETION = NORMAL][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if $deprecated_handler_exit_ready(S)
  -- if S.TODO = (ERROR_HANDLER_RESULT perrorcall) :: ptask_tail*
