def $deprecated_global_constant_begin(S, pconfigcall) = $deprecated_api_finish(S, pconfigcall, |S.USERCONSTANTS|, ptask_tail*)
  -- if $dynamic_global_constant_valid(S, pconfigcall)
  -- if $deprecated_api_query(pconfigcall) = (preqbytes)
  -- if $deprecated_api_flag(S, preqbytes)
