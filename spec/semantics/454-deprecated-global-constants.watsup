def $deprecated_global_constant_begin(S, pconfigcall) = $error_dispatch(S_pending, $deprecated_api_level(S, preqbytes), $deprecated_api_message(S, preqbytes), pconfigcall.LINE, DIAGNOSTIC "Deprecated" $deprecated_api_message(S, preqbytes) pconfigcall.LINE, DEPRECATED_GLOBAL_CONSTANT_RESULT pconfigcall n_prefix)
