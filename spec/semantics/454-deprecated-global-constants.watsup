def $deprecated_global_constant_begin(S, pconfigcall) = $dynamic_global_constant_finish(S, pconfigcall) -- otherwise
def $deprecated_api_finish(S, pconfigcall, n_prefix, ptask*) = S[.TODO = ptask*][.RESULT = KNOWN pvalue][.BASE = BASE_VALUE (KNOWN PNULL)]
