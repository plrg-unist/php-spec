def $call_task_valid(S, DEPRECATED_GLOBAL_CONSTANT_RESULT pconfigcall n_prefix) = $deprecated_api_valid(S, pconfigcall, n_prefix)
def $task_nodes(DEPRECATED_GLOBAL_CONSTANT_RESULT pconfigcall n_prefix) = $config_nodes(pconfigcall)
