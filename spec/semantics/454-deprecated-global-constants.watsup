def $deprecated_constant_task(DEPRECATED_HANDLER_EXIT pdestructioncleanup z ptask*, pdeprecatedconstant) = (perrorcall.RESUME = DEPRECATED_CONSTANT_RESULT pdeprecatedconstant)
  -- if pdestructioncleanup.SOURCE = ERROR_HANDLER_RESULT perrorcall
