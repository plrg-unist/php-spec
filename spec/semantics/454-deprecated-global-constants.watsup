  -- if $deprecated_api_value(S[.USERCONSTANTS = S.USERCONSTANTS[0:n_prefix]], preqbytes) = (pvalue)
  -- if $deprecated_global_nonowning(pvalue)
def $deprecated_api_finish(S, pconfigcall, n_prefix, ptask*) = S[.COMPLETION = UNSUPPORTED "Deprecated constant API result"] -- otherwise
def $deprecated_constant_protected_task(S, DEPRECATED_GLOBAL_CONSTANT_RESULT pconfigcall n_prefix, preqbytes_identity) = true
  -- if $(n_prefix <= |S.USERCONSTANTS|)
