;; getCurrent observes the immediate executing user function. It returns the
;; same ordinary Closure object; fake captures do not become ordinary Closures.

def $intrinsic_name(INTRINSIC_CLOSURE_CURRENT) = $ptascii("Closure::getCurrent")
def $config_kind(INTRINSIC_CLOSURE_CURRENT) = true
def $config_required(INTRINSIC_CLOSURE_CURRENT) = 0
def $config_trace_frames(S, pconfigcall, pvalue*) = [{FILE $call_sourcefile(S.FILES, pconfigcall.SITE), LINE pconfigcall.LINE, FUNCTION $ptascii("getCurrent"), CLASS ($ptascii("Closure")), TYPE ($ptascii("::")), ARGS $trace_indexed_args(pvalue*, 0), HASARGS true}]
  -- if pconfigcall.KIND = INTRINSIC_CLOSURE_CURRENT

def $closure_current_method_site(S, porigin) = true
  -- if $origin_node(S.SOURCES, porigin) = (NExprMethodCall expression phpType20 (SEQUENCE phpType7*) metadata)
  -- if $method_source_name(phpType20, $ptascii("getcurrent"))
  -- if ~$ppfirstclass(phpType7*)
def $closure_current_method_site(S, porigin) = true
  -- if $origin_node(S.SOURCES, porigin) = (NExprNullsafeMethodCall expression phpType20 (SEQUENCE phpType7*) metadata)
  -- if $method_source_name(phpType20, $ptascii("getcurrent"))
  -- if ~$ppfirstclass(phpType7*)
def $closure_current_method_site(S, porigin) = false -- otherwise
def $closure_current_site(S, porigin) = true -- if $closure_current_method_site(S, porigin)
def $closure_current_site(S, porigin) = true
  -- if $origin_node(S.SOURCES, porigin) = (NExprStaticCall phpType19 phpType20 (SEQUENCE phpType7*) metadata)
  -- if $from_static_class(S, porigin, phpType19)
  -- if $method_source_name(phpType20, $ptascii("getcurrent"))
  -- if ~$ppfirstclass(phpType7*)
def $closure_current_site(S, porigin) = false -- otherwise

def $config_selected_valid(S, pconfigcall) = true
  -- if pconfigcall.KIND = INTRINSIC_CLOSURE_CURRENT
  -- if pconfigcall.SELECTION = eps
  -- if pconfigcall.OWNER = eps
  -- if $closure_current_site(S, pconfigcall.SITE)
  -- if ~$closure_current_method_site(S, pconfigcall.SITE)
def $config_selected_valid(S, pconfigcall) = true
  -- if pconfigcall.KIND = INTRINSIC_CLOSURE_CURRENT
  -- if pconfigcall.SELECTION = eps
  -- if pconfigcall.OWNER = (n)
  -- if $closure_static_api_owner_valid(S, n)
  -- if $closure_current_method_site(S, pconfigcall.SITE)

def $closure_current_start(S, porigin, n_owner?, z) = S[.TODO = [CONFIG_ARGS {SITE porigin, KIND INTRINSIC_CLOSURE_CURRENT, INDEX 0, SENT eps, NAMED false, OWNER n_owner?, SELECTION eps, LINE z, PACKS eps}, METHOD_RESULT] ++ ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = ptask :: ptask_tail*
def $scoped_select(S, phpType19, KNOWN (PSTRING ptbytes_class), ptbytes_method, phpType7*, z) = $closure_current_start(S, porigin, eps, z)
  -- if $ptlc($typed_callable_name(ptbytes_class)) = $ptascii("closure")
  -- if $ptlc(ptbytes_method) = $ptascii("getcurrent")
  -- if ~$ppfirstclass(phpType7*)
  -- if S.ORIGIN = (porigin)
  -- if $closure_current_site(S, porigin)
def $scoped_select(S, phpType19, KNOWN (PSTRING ptbytes_class), ptbytes_method, phpType7*, z) = S[.COMPLETION = UNSUPPORTED "capture of internal Closure::getCurrent target"]
  -- if $ptlc($typed_callable_name(ptbytes_class)) = $ptascii("closure")
  -- if $ptlc(ptbytes_method) = $ptascii("getcurrent")
  -- if $ppfirstclass(phpType7*)
def $method_select(S, poperand, ptbytes, phpType7*, z) = $closure_current_start(S_read, porigin, (n), z)
  -- if S_read = $resolve_at(S, poperand, z)
  -- if S_read.COMPLETION = NORMAL
  -- if S_read.RESULT = KNOWN (POBJECT n)
  -- if $closure_callable(S_read, n)
  -- if $ptlc(ptbytes) = $ptascii("getcurrent")
  -- if ~$ppfirstclass(phpType7*)
  -- if S.ORIGIN = (porigin)
  -- if $closure_current_method_site(S, porigin)
def $method_select(S, poperand, ptbytes, phpType7*, z) = S_read[.COMPLETION = UNSUPPORTED "capture of internal Closure::getCurrent target"]
  -- if S_read = $resolve_at(S, poperand, z)
  -- if S_read.COMPLETION = NORMAL
  -- if S_read.RESULT = KNOWN (POBJECT n)
  -- if $closure_callable(S_read, n)
  -- if $ptlc(ptbytes) = $ptascii("getcurrent")
  -- if $ppfirstclass(phpType7*)

def $closure_current_object(S) = (n)
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.TARGET = CLOSURE_TARGET n
  -- if pcallcontext.INSTANCE = (n)
  -- if $(n < |S.OBJECTS|)
  -- if (HOBJECT n) <- S.ALLOCATIONS
  -- if $object_body(S.OBJECTS[n]) = REALCLOSURE porigin pitem* pstaticcell*
  -- if $closure_callable(S, n)
  -- if $call_current_valid(S)
def $closure_current_object(S) = eps -- otherwise
def $config_receive(S, pconfigcall) = $from_done(S, n)
  -- if pconfigcall.KIND = INTRINSIC_CLOSURE_CURRENT
  -- if pconfigcall.SENT = eps
  -- if $closure_current_object(S) = (n)
def $config_receive(S, pconfigcall) = S[.COMPLETION = UNSUPPORTED "Closure::getCurrent in a temporary Closure::call frame"]
  -- if pconfigcall.KIND = INTRINSIC_CLOSURE_CURRENT
  -- if pconfigcall.SENT = eps
  -- if S.CURRENT = (pcallcontext)
  -- if $closure_call_target(pcallcontext.TARGET)
def $config_receive(S, pconfigcall) = $config_error(S, pconfigcall, "Error", $ptascii("Current function is not a closure"))
  -- if pconfigcall.KIND = INTRINSIC_CLOSURE_CURRENT
  -- if pconfigcall.SENT = eps
  -- if $closure_current_object(S) = eps
  -- if ~$closure_current_temporary(S)

rule PhpStep/closure-current-invoke: S ~> $config_receive(S, pconfigcall)
  -- if S.TODO = (CONFIG_INVOKE pconfigcall) :: ptask_tail*
  -- if pconfigcall.KIND = INTRINSIC_CLOSURE_CURRENT
  -- if $config_invoke_valid(S, pconfigcall)

