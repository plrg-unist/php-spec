  -- if perrorcall.TARGET = (pcallcontext.TARGET)
  -- if pshutdownproducer.SITE = (perrorcall.SITE)
  -- if $parameter_api_handler_raw(S, perrorcall.CALLBACK, $exception_snapshot(S, perrorcall.CALLBACK))
def $parameter_api_handler_context(S, pcallcontext, pfunction, pshutdownproducer) = true
