  -- if $parameter_shutdown_target(S, pshutdownproducer.TARGET) = ((pmethoddesc, porigin_requested, porigin_called, n_receiver?))
  -- if preceivebirth.FUNCTION = pmethoddesc.FUNCTION.ORIGIN
  -- if preceivebirth.CAUSE.CALLS = (preceivebirth.FUNCTION, preceivebirth.CALLSITE, (pmethoddesc.OWNER), (porigin_called)) :: pdeclcalls
