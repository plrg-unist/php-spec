  -- if $constant_callable_published(S.DECLARATIONS[0:preceivebirth.PUBLICATION], porigin_called)
def $parameter_receive_method_dispatch(S, preceivebirth) = $parameter_receive_api_witness_valid(S, preceivebirth)
  -- if preceivebirth.ENTRY = eps /\ preceivebirth.CONSTRUCTOR_ENTRY = eps /\ preceivebirth.SHUTDOWN_ENTRY = eps
  -- if preceivebirth.API_ENTRY =/= eps
def $parameter_receive_child_entry(S, preceivebirth, preceivebirth_child) = $parameter_receive_cache_entry(S, preceivebirth_child)
