;; Handler APIs resolve their copied callable at dispatch. The entered target
;; borrows This; the existing result/handler records retain the real owners.
dec $parameter_api_handler_raw(pstate, pvalue, parray?) : bool
def $parameter_api_handler_raw(S, pvalue, eps) = ($string_bytes(pvalue) =/= eps)
def $parameter_api_handler_raw(S, PARRAY n, (parray)) = true
  -- if (HARRAY n) <- S.ALLOCATIONS
  -- if |parray.ITEMS| = 2
  -- if $entry_lookup(parray.ITEMS, KINT 0) = (DIRECT pvalue_first)
  -- if $entry_lookup(parray.ITEMS, KINT 1) = (DIRECT pvalue_name)
  -- if $parameter_shutdown_first(pvalue_first)
  -- if $string_bytes(pvalue_name) =/= eps
def $parameter_api_handler_raw(S, pvalue, parray?) = false -- otherwise

dec $parameter_api_handler_context(pstate, pcallcontext, pfunction, pshutdownproducer) : bool
def $parameter_api_handler_context(S, pcallcontext, pfunction, pshutdownproducer) = true
