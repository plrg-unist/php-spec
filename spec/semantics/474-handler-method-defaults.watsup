  -- if pcallcontext.TARGET = API_BORROWED_TARGET pshutdownproducer
  -- if pshutdownproducer.INTERNAL /\ pshutdownproducer.SCOPE = eps /\ pshutdownproducer.BINDING = eps /\ pshutdownproducer.CLONE = eps
