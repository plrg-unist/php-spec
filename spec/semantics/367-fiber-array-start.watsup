def $fiber_array_start_unwind_valid(S, pfiberstart) = false -- otherwise
def $fiber_array_start_discard(S, pfiberstart) = $destructor_release_begin(S, $destruction_values($named_slots_roots(pfiberstart.SENT.SLOTS) ++ [HOBJECT pfiberstart.OBJECT] ++ $named_roots(pfiberstart.SENT.NAMED)))
def $return_discard(S, FIBER_ARGS pfiberstart) = $fiber_array_start_discard(S, pfiberstart)
  -- if $fiber_array_start_unwind_valid(S, pfiberstart)
