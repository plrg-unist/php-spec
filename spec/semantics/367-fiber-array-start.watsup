  -- if pfiberstart = {SITE porigin, OBJECT n_input, INDEX 0, SENT {SLOTS eps, NAMED eps}, LINE z_call, PACKS eps}
def $fiber_array_start_source_valid(S, pfiberarray) = true
  -- if pfiberarray.KIND = INTRINSIC_FIBER_START
  -- if $fiber_array_site_valid(S, pfiberarray)
  -- if pfiberarray.INPUT = (n_input)
  -- if $fiber_factory_members(S, PARRAY pfiberarray.ARRAY, pfiberarray.ITEMS) = ((POBJECT n_input, pfiberarray.NAME))
  -- if $fiber_factory_receiver(S, POBJECT n_input)
  -- if $ptlc(pfiberarray.NAME) = $ptascii("start")
def $fiber_array_start_source_valid(S, pfiberarray) = false -- otherwise
def $fiber_array_start_matches(pfiberarray, pfiberstart) = (pfiberarray.SITE = pfiberstart.SITE /\ pfiberarray.LINE = pfiberstart.LINE /\ pfiberarray.INPUT = (pfiberstart.OBJECT))
def $fiber_array_start_task(FIBER_ARGS pfiberstart, pfiberstart) = true
def $fiber_array_start_task(FIBER_SEND pfiberstart, pfiberstart) = true
def $fiber_array_start_task(ptask, pfiberstart) = false -- otherwise
def $fiber_array_start_receipt(FIBER_ARRAY_START_RELEASE pfiberarray, pfiberstart) = (pfiberarray)
  -- if $fiber_array_start_matches(pfiberarray, pfiberstart)
def $fiber_array_start_receipt(FIBER_ARRAY_START_RESULT pfiberarray pfiberstart, pfiberstart) = (pfiberarray)
def $fiber_array_start_receipt(ptask, pfiberstart) = eps -- otherwise
def $fiber_array_start_pair(ptask :: ptask_receipt :: ptask_tail*, pfiberstart) = $fiber_array_start_receipt(ptask_receipt, pfiberstart)
