dec $fiber_array_start_discard(pstate, pfiberstart) : pstate

def $fiber_array_new(S, n, porigin, z_init, z_call) = S[.TODO = [FIBER_ARGS pfiberstart, FIBER_ARRAY_START_RELEASE pfiberarray] ++ S.TODO][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
