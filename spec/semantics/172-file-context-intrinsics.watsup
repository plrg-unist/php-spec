def $config_sent_shape(S, pconfigcall) = true
  -- if $pipe_site(S, pconfigcall.SITE)
  -- if pconfigcall.INDEX = 1
  -- if |pconfigcall.SENT| = 1
  -- if ~pconfigcall.NAMED
def $config_sent_shape(S, pconfigcall) = false -- otherwise
dec $config_call_valid(pstate, pconfigcall) : bool
def $config_call_valid(S, pconfigcall) = true
  -- if $config_kind(pconfigcall.KIND)
  -- if S.ORIGIN = (pconfigcall.SITE)
  -- if $config_selected_valid(S, pconfigcall)
  -- if pconfigcall.SITE = PORIGIN n pcpath
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_expression(pcode.EXPRESSIONS, pcpath) = ((pconfigcall.LINE, false))
  -- if $intrinsic_count(S, pconfigcall.SITE) = (n_count)
  -- if $(pconfigcall.INDEX <= n_count)
