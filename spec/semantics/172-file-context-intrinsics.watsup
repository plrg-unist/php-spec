dec $config_slots_valid(pstate, pnamedslot*) : bool
def $config_slots_valid(S, eps) = true
def $config_slots_valid(S, NAMED_HOLE :: pnamedslot*) = $config_slots_valid(S, pnamedslot*)
def $config_slots_valid(S, (NAMED_SENT (KNOWN (POBJECT n))) :: pnamedslot*) = ($getclass_live_object(S, n) /\ $config_slots_valid(S, pnamedslot*))
def $config_slots_valid(S, (NAMED_SENT (KNOWN pvalue)) :: pnamedslot*) = $config_slots_valid(S, pnamedslot*)
  -- if ~$getclass_is_object(pvalue)
def $config_slots_valid(S, pnamedslot*) = false -- otherwise
dec $config_source_prefix(pintrinsic, phpType7*, pnamedslot*, bool) : (pnamedslot*, bool)?
def $config_source_prefix(pintrinsic, eps, pnamedslot*, b) = ((pnamedslot*, b))
def $config_source_prefix(pintrinsic, (NArg phpType3 expression (BOOLEAN false) (BOOLEAN false) metadata) :: phpType7*, pnamedslot*, b) = $config_source_prefix(pintrinsic, phpType7*, $named_slot_set(pnamedslot*, n, KNOWN PNULL), (b \/ preqbytes? =/= eps))
  -- if preqbytes? = $exit_argument_name(phpType3)
  -- if $config_destination(pintrinsic, preqbytes?, |pnamedslot*|) = (n)
  -- if $named_slot_at(pnamedslot*, n) = NAMED_HOLE
  -- if ~(b /\ preqbytes? = eps)
def $config_source_prefix(pintrinsic, phpType7*, pnamedslot*, b) = eps -- otherwise
dec $config_sent_shape(pstate, pconfigcall) : bool
