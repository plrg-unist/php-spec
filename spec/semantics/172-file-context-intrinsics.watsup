;; Source-callable include_path mutations share one authenticated argument task.
def $intrinsic_name(INTRINSIC_SET_INCLUDE_PATH) = $ptascii("set_include_path")
def $intrinsic_name(INTRINSIC_INI_SET) = $ptascii("ini_set")
def $intrinsic_name(INTRINSIC_INI_RESTORE) = $ptascii("ini_restore")
def $intrinsic_name(INTRINSIC_CHDIR) = $ptascii("chdir")
def $intrinsic_named(preqbytes) = (INTRINSIC_SET_INCLUDE_PATH) -- if $ptlc(preqbytes) = $ptascii("set_include_path")
def $intrinsic_named(preqbytes) = (INTRINSIC_INI_SET) -- if $ptlc(preqbytes) = $ptascii("ini_set")
def $intrinsic_named(preqbytes) = (INTRINSIC_INI_RESTORE) -- if $ptlc(preqbytes) = $ptascii("ini_restore")
def $intrinsic_named(preqbytes) = (INTRINSIC_CHDIR) -- if $ptlc(preqbytes) = $ptascii("chdir")
dec $config_kind(pintrinsic) : bool
def $config_kind(INTRINSIC_SET_INCLUDE_PATH) = true
def $config_kind(INTRINSIC_INI_SET) = true
def $config_kind(INTRINSIC_INI_RESTORE) = true
def $config_kind(INTRINSIC_CHDIR) = true
def $config_kind(pintrinsic) = false -- otherwise
dec $config_invoke_valid(pstate, pconfigcall) : bool
dec $config_strict(pstate, pconfigcall) : bool
def $config_string_child_site(S, PORIGIN n_unit pcpath_child, z_call) = true
  -- if $(|pcpath_child| >= 3)
  -- if pcpath_parent = pcpath_child[0:$nabs($(|pcpath_child| - 3))]
  -- if $intrinsic_argument(S, PORIGIN n_unit pcpath_parent, 0) = ((expression, false, eps, PORIGIN n_unit pcpath_child, z_child))
  -- if $intrinsic_count(S, PORIGIN n_unit pcpath_parent) = (1)
  -- if $call_line_valid(S, (PORIGIN n_unit pcpath_parent), z_call)
def $config_string_child_site(S, porigin_site, z) = false -- otherwise
def $config_string_site_valid(S, pconfigcall, n_object, porigin_child, z_child, z_call) = true
  -- if pconfigcall.KIND = INTRINSIC_CHDIR
  -- if pconfigcall.SENT = [NAMED_SENT (KNOWN (POBJECT n_object))]
  -- if $intrinsic_argument(S, pconfigcall.SITE, 0) = ((expression, false, eps, porigin_child, z_child))
  -- if pconfigcall.LINE = z_call
  -- if $config_string_child_site(S, porigin_child, z_call)
  -- if $config_invoke_valid(S[.ORIGIN = (pconfigcall.SITE)], pconfigcall)
  -- if ~$config_strict(S, pconfigcall)
  -- if $stringable_instance(S, n_object)
def $config_string_site_valid(S, pconfigcall, n_object, porigin_child, z_child, z_call) = false -- otherwise
def $config_string_pending_line_valid(S, METHOD_TARGET n porigin_method, (porigin_child), z_call) = true
  -- if S.TODO = (CALL_ARGS (METHOD_TARGET n porigin_method) eps 0 eps (porigin_child) z_call) :: (STRINGIFY_RESULT n porigin_child z_call) :: (CONFIG_STRING_RESULT pconfigcall n porigin_child z_child z_call) :: ptask_tail*
  -- if $config_string_site_valid(S, pconfigcall, n, porigin_child, z_child, z_call)
  -- if $stringify_pending(S, METHOD_TARGET n porigin_method, porigin_child)
def $config_string_pending_line_valid(S, pcalltarget, porigin?, z) = false -- otherwise
def $config_string_context_line_valid(S, pcallcontext) = true
  -- if pcallcontext.CALLSITE = (porigin_child)
  -- if $config_string_child_site(S, porigin_child, pcallcontext.LINE)
  -- if $stringify_context_kind(S, pcallcontext)
def $config_string_context_line_valid(S, pcallcontext) = false -- otherwise
def $config_string_trace_context(S, pcallcontext) = true
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.CALLSITE = (porigin_child)
  -- if $context_target(pcallcontext) = METHOD_TARGET n porigin_method
  -- if S.FRAMES = pframe :: pframe_tail*
  -- if pframe.TODO = (STRINGIFY_RESULT n porigin_child z_call) :: (CONFIG_STRING_RESULT pconfigcall n porigin_child z_child z_call) :: ptask_tail*
  -- if $stringify_entered(S, S.CURRENT, S.FRAMES, METHOD_TARGET n porigin_method, porigin_child)
  -- if $config_string_site_valid(S, pconfigcall, n, porigin_child, z_child, z_call)
  -- if pcallcontext.LINE = z_call
def $config_string_trace_context(S, pcallcontext) = false -- otherwise
def $config_dynamic_selection(S, pintrinsic, porigin) = ($config_kind(pintrinsic) /\ $dynamic_site(S, (porigin)) /\ $dynamic_fixed_name(S, porigin) = eps)
def $config_pipe_selection(S, pintrinsic, porigin) = ($config_kind(pintrinsic) /\ $pipe_site(S, porigin) /\ $pipe_fixed_name(S, porigin) = eps)
def $intrinsic_prepare(S, pintrinsic, z, n_owner?) = S[.TODO = (CONFIG_ARGS {SITE porigin, KIND pintrinsic, INDEX 0, SENT eps, NAMED false, OWNER n_owner?, SELECTION eps, LINE z}) :: S.TODO][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if $config_kind(pintrinsic)
  -- if S.ORIGIN = (porigin)
def $intrinsic_pipe(S, pintrinsic, pvalue, porigin, z, n_owner?) = S[.TODO = (CONFIG_INVOKE {SITE porigin, KIND pintrinsic, INDEX 1, SENT ([NAMED_SENT (KNOWN pvalue)]), NAMED false, OWNER n_owner?, SELECTION eps, LINE z}) :: S.TODO][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if $config_kind(pintrinsic)
def $dynamic_name(S, preqbytes_original, preqbytes_lookup, porigin, z_init, z_call) = S[.SELECTSEQ = $(n_nonce + 1)][.SELECTEDCALLS = S.SELECTEDCALLS ++ [pselectedcall]][.TODO = (CONFIG_ARGS {SITE porigin, KIND pintrinsic, INDEX 0, SENT eps, NAMED false, OWNER eps, SELECTION (n_nonce), LINE z_call}) :: S.TODO][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if ~$dynamic_method_scan(preqbytes_original, false, false)
  -- if $call_target(S, preqbytes_lookup, eps) = eps
  -- if $intrinsic_lookup(preqbytes_lookup, eps) = (pintrinsic)
  -- if $config_dynamic_selection(S, pintrinsic, porigin)
  -- if S.ORIGIN = (porigin)
  -- if $call_line_valid(S, (porigin), z_call)
  -- if preqbytes_lookup = $dynamic_lookup_name(preqbytes_original)
  -- if n_nonce = S.SELECTSEQ
  -- if n_depth = |S.FRAMES|
  -- if pselectedcall = {NONCE n_nonce, SITE porigin, KIND pintrinsic, ORIGINAL preqbytes_original, LOOKUP preqbytes_lookup, DEPTH n_depth, LINE z_call}
def $pipe_name(S, preqbytes_original, preqbytes_lookup, eps, pvalue, porigin, z_send, z_lookup, z_call) = S[.SELECTSEQ = $(n_nonce + 1)][.SELECTEDCALLS = S.SELECTEDCALLS ++ [pselectedcall]][.TODO = (CONFIG_INVOKE {SITE porigin, KIND pintrinsic, INDEX 1, SENT ([NAMED_SENT (KNOWN pvalue)]), NAMED false, OWNER eps, SELECTION (n_nonce), LINE z_call}) :: S.TODO][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if ~$dynamic_method_scan(preqbytes_original, false, false)
  -- if $call_target(S, preqbytes_lookup, eps) = eps
  -- if $intrinsic_lookup(preqbytes_lookup, eps) = (pintrinsic)
  -- if $config_pipe_selection(S, pintrinsic, porigin)
  -- if S.ORIGIN = (porigin)
  -- if $call_line_valid(S, (porigin), z_call)
  -- if preqbytes_lookup = $dynamic_lookup_name(preqbytes_original)
  -- if n_nonce = S.SELECTSEQ
  -- if n_depth = |S.FRAMES|
  -- if pselectedcall = {NONCE n_nonce, SITE porigin, KIND pintrinsic, ORIGINAL preqbytes_original, LOOKUP preqbytes_lookup, DEPTH n_depth, LINE z_call}

dec $config_nodes(pconfigcall) : pnode*
def $config_nodes(pconfigcall) = $exit_owner_nodes(pconfigcall.OWNER) ++ $named_slots_roots(pconfigcall.SENT)
def $task_nodes(CONFIG_ARGS pconfigcall) = $config_nodes(pconfigcall)
def $task_nodes(CONFIG_SEND pconfigcall) = $config_nodes(pconfigcall)
def $task_nodes(CONFIG_UNPACK_PREP pconfigcall) = $config_nodes(pconfigcall)
def $task_nodes(CONFIG_UNPACK_NEXT pconfigcall poperand n) = $config_nodes(pconfigcall) ++ $operand_nodes(poperand)
def $task_nodes(CONFIG_INVOKE pconfigcall) = $config_nodes(pconfigcall)
def $task_nodes(CONFIG_STRING_RESULT pconfigcall n porigin_child z_child z_call) = [HOBJECT n] ++ $config_nodes(pconfigcall)

dec $config_parameter(pintrinsic, preqbytes) : nat?
def $config_parameter(INTRINSIC_SET_INCLUDE_PATH, preqbytes) = (0) -- if preqbytes = $ptascii("include_path")
def $config_parameter(INTRINSIC_INI_SET, preqbytes) = (0) -- if preqbytes = $ptascii("option")
def $config_parameter(INTRINSIC_INI_SET, preqbytes) = (1) -- if preqbytes = $ptascii("value")
def $config_parameter(INTRINSIC_INI_RESTORE, preqbytes) = (0) -- if preqbytes = $ptascii("option")
def $config_parameter(INTRINSIC_CHDIR, preqbytes) = (0) -- if preqbytes = $ptascii("directory")
def $config_parameter(pintrinsic, preqbytes) = eps -- otherwise
dec $config_destination(pintrinsic, preqbytes?, nat) : nat?
def $config_destination(pintrinsic, eps, n) = (n)
def $config_destination(pintrinsic, (preqbytes), n) = $config_parameter(pintrinsic, preqbytes)
dec $config_send_check(pstate, pconfigcall, preqbytes?, int) : pstate
def $config_send_check(S, pconfigcall, (preqbytes), z) = $throw_scalar(S, "Error", $ptascii("Unknown named parameter $") ++ $c_string(preqbytes), z)
  -- if $config_destination(pconfigcall.KIND, (preqbytes), |pconfigcall.SENT|) = eps
def $config_send_check(S, pconfigcall, (preqbytes), z) = $throw_scalar(S, "Error", $ptascii("Named parameter $") ++ preqbytes ++ $ptascii(" overwrites previous argument"), z)
  -- if $config_destination(pconfigcall.KIND, (preqbytes), |pconfigcall.SENT|) = (n)
  -- if $named_slot_at(pconfigcall.SENT, n) = NAMED_SENT poperand
def $config_send_check(S, pconfigcall, eps, z) = $throw_scalar(S, "Error", $ptascii("Cannot use positional argument after named argument during unpacking"), z)
  -- if pconfigcall.NAMED
def $config_send_check(S, pconfigcall, preqbytes?, z) = S -- otherwise
dec $config_sent(pconfigcall, poperand, preqbytes?) : pconfigcall
def $config_sent(pconfigcall, poperand, preqbytes?) = pconfigcall[.SENT = $named_slot_set(pconfigcall.SENT, n, poperand)][.NAMED = (pconfigcall.NAMED \/ preqbytes? =/= eps)]
  -- if $config_destination(pconfigcall.KIND, preqbytes?, |pconfigcall.SENT|) = (n)

rule PhpStep/config-argument: S ~> S[.TODO = [$at_task((porigin), EVAL expression), CONFIG_SEND pconfigcall] ++ ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (CONFIG_ARGS pconfigcall) :: ptask_tail*
  -- if $intrinsic_argument(S, pconfigcall.SITE, pconfigcall.INDEX) = ((expression, false, preqbytes?, porigin, z))
rule PhpStep/config-send: S ~> S_value[.TODO = (CONFIG_ARGS ($config_sent(pconfigcall, S_value.RESULT, preqbytes?)[.INDEX = $(pconfigcall.INDEX + 1)])) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (CONFIG_SEND pconfigcall) :: ptask_tail*
