;; The selected intrinsic and each saved argument must derive from the source.
dec $selected_task_nonce(ptask) : nat?
def $selected_task_nonce(AT porigin ptask) = $selected_task_nonce(ptask)
def $selected_task_nonce(CONFIG_ARGS pconfigcall) = pconfigcall.SELECTION
def $selected_task_nonce(CONFIG_SEND pconfigcall) = pconfigcall.SELECTION
def $selected_task_nonce(CONFIG_UNPACK_PREP pconfigcall) = pconfigcall.SELECTION
def $selected_task_nonce(CONFIG_UNPACK_NEXT pconfigcall poperand n) = pconfigcall.SELECTION
def $selected_task_nonce(CONFIG_INVOKE pconfigcall) = pconfigcall.SELECTION
def $selected_task_nonce(CONFIG_INI_NULL_RESULT pconfigcall) = pconfigcall.SELECTION
def $selected_task_nonce(CONFIG_STRING_RESULT pconfigcall n porigin_child z_child z_call) = pconfigcall.SELECTION
def $selected_task_nonce(CHDIR_AWAIT pconfigcall n) = pconfigcall.SELECTION
def $selected_task_nonce(ptask) = eps -- otherwise
dec $selected_task_count(ptask*, nat) : nat
def $selected_task_count(eps, n) = 0
def $selected_task_count(ptask :: ptask_tail*, n) = $(1 + $selected_task_count(ptask_tail*, n))
  -- if $selected_task_nonce(ptask) = (n)
def $selected_task_count(ptask :: ptask_tail*, n) = $selected_task_count(ptask_tail*, n)
