dec $config_pack_prefix(pconfigcall, pentry*, bool) : pconfigcall?
def $config_pack_prefix(pconfigcall, eps, b_order) = (pconfigcall)
def $config_pack_prefix(pconfigcall, (ENTRY pkey (DIRECT pvalue)) :: pentry*, b_order) = $config_pack_prefix(pconfigcall_next, pentry*, (b_order \/ preqbytes? =/= eps))
  -- if preqbytes? = $exit_key_name(pkey)
  -- if $config_replay_send(pconfigcall, KNOWN pvalue, preqbytes?, b_order) = (pconfigcall_next)
def $config_pack_prefix(pconfigcall, pentry*, b_order) = eps -- otherwise
dec $config_pack_last(pconfigcall) : pconfigpack?
def $config_pack_last(pconfigcall) = (pconfigcall.PACKS[$nabs($(|pconfigcall.PACKS| - 1))])
  -- if pconfigcall.PACKS =/= eps
def $config_pack_last(pconfigcall) = eps -- otherwise
