def $call_task_valid(S, CONFIG_SEND pconfigcall) = $config_pending_valid(S, pconfigcall, false)
def $call_task_valid(S, CONFIG_UNPACK_PREP pconfigcall) = $config_pending_valid(S, pconfigcall, true)
def $config_invoke_valid(S, pconfigcall) = ($config_call_valid(S, pconfigcall) /\ $config_sent_shape(S, pconfigcall) /\ $intrinsic_count(S, pconfigcall.SITE) = (pconfigcall.INDEX))
def $call_task_valid(S, CONFIG_INVOKE pconfigcall) = $config_invoke_valid(S, pconfigcall)
def $call_task_valid(S, CONFIG_STRING_RESULT pconfigcall n_object porigin_child z_child z_call) = $config_string_site_valid(S, pconfigcall, n_object, porigin_child, z_child, z_call)
dec $config_unpack_valid(pstate, pconfigcall, poperand, nat) : bool
def $config_unpack_valid(S, pconfigcall, KNOWN (PARRAY n), n_cursor) = true
