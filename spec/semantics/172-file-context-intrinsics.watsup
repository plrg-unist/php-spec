dec $config_pack_capture(pstate, pentry*) : pentry*
def $config_pack_capture(S, eps) = eps
def $config_pack_capture(S, (ENTRY pkey pitem) :: pentry*) = (ENTRY pkey (DIRECT $entry_value(S, pitem))) :: $config_pack_capture(S, pentry*)
dec $config_pack_named(pentry*) : bool
def $config_pack_named(eps) = false
def $config_pack_named((ENTRY (KSTRING preqbytes) pitem) :: pentry*) = true
def $config_pack_named((ENTRY (KINT z) pitem) :: pentry*) = $config_pack_named(pentry*)
dec $config_replay_send(pconfigcall, poperand, preqbytes?, bool) : pconfigcall?
def $config_replay_send(pconfigcall, poperand, preqbytes?, b_order) = ($config_sent(pconfigcall, poperand, preqbytes?))
  -- if ~(b_order /\ preqbytes? = eps)
