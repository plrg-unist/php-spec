def $config_call_valid(S, pconfigcall) = false -- otherwise
dec $config_pending_valid(pstate, pconfigcall, bool) : bool
def $config_pending_valid(S, pconfigcall, b) = true
  -- if $config_call_valid(S, pconfigcall)
  -- if $config_sent_shape(S, pconfigcall)
  -- if $intrinsic_argument(S, pconfigcall.SITE, pconfigcall.INDEX) = ((expression, b, preqbytes?, porigin, z))
def $config_pending_valid(S, pconfigcall, b) = false -- otherwise
def $call_task_valid(S, CONFIG_ARGS pconfigcall) = ($config_call_valid(S, pconfigcall) /\ $config_sent_shape(S, pconfigcall))
def $call_task_valid(S, CONFIG_SEND pconfigcall) = $config_pending_valid(S, pconfigcall, false)
def $call_task_valid(S, CONFIG_UNPACK_PREP pconfigcall) = $config_pending_valid(S, pconfigcall, true)
def $config_invoke_valid(S, pconfigcall) = ($config_call_valid(S, pconfigcall) /\ $config_sent_shape(S, pconfigcall) /\ $intrinsic_count(S, pconfigcall.SITE) = (pconfigcall.INDEX))
def $call_task_valid(S, CONFIG_INVOKE pconfigcall) = $config_invoke_valid(S, pconfigcall)
dec $config_unpack_valid(pstate, pconfigcall, poperand, nat) : bool
def $config_unpack_valid(S, pconfigcall, KNOWN (PARRAY n), n_cursor) = true
  -- if $config_call_valid(S, pconfigcall)
  -- if $intrinsic_argument(S, pconfigcall.SITE, pconfigcall.INDEX) = ((expression, true, preqbytes?, porigin, z))
  -- if $(n < |S.ARRAYS|)
  -- if (HARRAY n) <- S.ALLOCATIONS
  -- if $(n_cursor <= |S.ARRAYS[n].ITEMS|)
  -- if $config_sent_shape(S, pconfigcall)
  -- if $config_unpack_prefix(S, pconfigcall, S.ARRAYS[n].ITEMS[0:n_cursor]) = (pconfigcall_prefix)
def $config_unpack_valid(S, pconfigcall, poperand, n_cursor) = false -- otherwise
def $call_task_valid(S, CONFIG_UNPACK_NEXT pconfigcall poperand n_cursor) = $config_unpack_valid(S, pconfigcall, poperand, n_cursor)
def $config_result_valid(S) = $config_result_valid(S[.ORIGIN = (porigin)][.TODO = ptask :: ptask_tail*])
  -- if S.TODO = (AT porigin ptask) :: ptask_tail*
def $config_result_valid(S) = $config_result_valid(S[.ORIGIN = porigin?][.TODO = ptask_tail*])
  -- if S.TODO = (ORIGIN_RETURN porigin?) :: ptask_tail*
def $config_result_valid(S) = $getclass_pending_result_valid(S, {SITE pconfigcall.SITE, INDEX pconfigcall.INDEX, SENT pconfigcall.SENT, NAMED pconfigcall.NAMED, OWNER pconfigcall.OWNER, LINE pconfigcall.LINE}, false)
  -- if S.TODO = (CONFIG_SEND pconfigcall) :: ptask_tail*
def $config_result_valid(S) = $getclass_pending_result_valid(S, {SITE pconfigcall.SITE, INDEX pconfigcall.INDEX, SENT pconfigcall.SENT, NAMED pconfigcall.NAMED, OWNER pconfigcall.OWNER, LINE pconfigcall.LINE}, true)
  -- if S.TODO = (CONFIG_UNPACK_PREP pconfigcall) :: ptask_tail*
def $config_result_valid(S) = true -- otherwise
