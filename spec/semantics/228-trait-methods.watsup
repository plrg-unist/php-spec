def $default_parameter_origin(S, TRAIT_ORIGIN porigin_owner porigin_source ptbytes, n) = PORIGIN n_unit (pcpath ++ [PCFIELD 4, PCINDEX n])
  -- if $origin_source(porigin_source) = PORIGIN n_unit pcpath
def $default_scope_node(NScalarMagicConstClass metadata) = true

;; Logical entry origins retain the selected import while protected regions
;; and finalizer ancestry are recovered from its physical source method.
dec $trait_finally_entry_valid(pstate, porigin) : bool
def $trait_finally_entry_valid(S, TRAIT_ORIGIN porigin_owner porigin_source ptbytes) = true
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.FUNCTION = TRAIT_ORIGIN porigin_owner porigin_source ptbytes
  -- if $call_current_valid(S)
def $trait_finally_entry_valid(S, porigin) = false -- otherwise
def $finally_current_complete(S) = ($finally_regions_complete(S, n_unit, pcpath, $ppfinally_protected(pcunit.OCCURRENCES, pcpath)) /\ $finally_continuations_valid(S, S.TODO))
  -- if S.ORIGIN = (TRAIT_ORIGIN porigin_owner porigin_source ptbytes)
  -- if $trait_finally_entry_valid(S, TRAIT_ORIGIN porigin_owner porigin_source ptbytes)
  -- if $origin_source(porigin_source) = PORIGIN n_unit pcpath
  -- if $source_unit(S.SOURCES, n_unit) = (pcunit)
def $finally_outer_origin_valid(S, porigin, (TRAIT_ORIGIN porigin_owner porigin_source ptbytes)) = $finally_outer_origin_valid(S, porigin, ($origin_source(porigin_source)))
  -- if $trait_finally_entry_valid(S, TRAIT_ORIGIN porigin_owner porigin_source ptbytes)

;; A trait NEW default keeps its keyword until the real importing receive.
