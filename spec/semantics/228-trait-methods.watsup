syntax ptraitprecedence = { TRAIT ptbytes, METHOD ptbytes, EXCLUDES ptbytes* }
syntax ptraitalias = { TRAIT ptbytes?, METHOD ptbytes, MODIFIERS int, NAME ptbytes? }
syntax ptraitplan = { TRAITS ptbytes*, PRECEDENCES ptraitprecedence*, ALIASES ptraitalias* }
syntax ptraitfetch = TRAITFETCHED pclassdesc* | TRAITMISSING ptbytes | TRAITWRONG ptbytes
syntax ptraitselection = TRAITSELECTED pclassdesc | TRAITSELECTERROR ptbytes | TRAITSELECTMISSING ptbytes
syntax ptraitaliases = TRAITALIASES ptraitalias* | TRAITALIASERROR ptbytes | TRAITALIASMISSING ptbytes
syntax ptraitexclusions = TRAITEXCLUSIONS (ptbytes, ptbytes)* | TRAITEXCLUSIONERROR ptbytes | TRAITEXCLUSIONMISSING ptbytes
syntax ptraitmethod = TRAITMETHOD pclassdesc pmethoddesc | TRAITREQUIRE pclassdesc pmethoddesc pmethoddesc
syntax ptraitcomposition = TRAITCOMPOSE pstate ptraitmethod* ptraitmethod*

