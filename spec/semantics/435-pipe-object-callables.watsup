;; A pipe selects a public user __invoke receiver before sending its forced value.
;; SEND authenticates the evaluated RHS object; the target then retains that
;; receiver through the call even if its source variable changes.
dec $pipe_rhs_known_nonobject(expression) : bool
def $pipe_rhs_known_nonobject(NScalarString phpType33 metadata) = true
def $pipe_rhs_known_nonobject(NScalarInt phpType24 metadata) = true
def $pipe_rhs_known_nonobject(NScalarFloat phpType41 metadata) = true
def $pipe_rhs_known_nonobject(NExprArray phpType12 metadata) = true
def $pipe_rhs_known_nonobject(NExprClosure phpType14 phpType4_static phpType4_ref phpType16 phpType21 phpType18 phpType23 metadata) = true
def $pipe_rhs_known_nonobject(NExprArrowFunction phpType14 phpType4_static phpType4_ref phpType16 phpType18 expression metadata) = true
def $pipe_rhs_known_nonobject(expression) = false -- otherwise

