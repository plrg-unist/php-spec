;; This receipt no longer owns the receiver after the call completes.
def $task_nodes(PIPE_OBJECT_RESULT pcalltarget pobjectselection) = eps
def $call_task_valid(S, PIPE_OBJECT_RESULT pcalltarget pobjectselection) = (S.ORIGIN = (pobjectselection.SITE) /\ $pipe_object_site_valid(S, pobjectselection) /\ $pipe_object_target_identity(S, pcalltarget, pobjectselection, false))
rule PhpStep/pipe-object-result: S ~> S[.TODO = ptask_tail*][.BASE = BASE_VALUE S.RESULT]
