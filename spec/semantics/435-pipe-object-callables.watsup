def $task_nodes(PIPE_OBJECT_SEND pcalltarget pobjectselection pvalue_left z_send z_call) = $value_nodes(pvalue_left) ++ $target_nodes(pcalltarget)
dec $pipe_object_send_valid(pstate, pcalltarget, pobjectselection, pvalue, int, int) : bool
