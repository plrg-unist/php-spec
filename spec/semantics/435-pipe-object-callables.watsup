def $pipe_object_send_valid(S, pcalltarget, pobjectselection, pvalue_left, z_send, z_call) = false -- otherwise
def $call_task_valid(S, PIPE_OBJECT_SEND pcalltarget pobjectselection pvalue_left z_send z_call) = $pipe_object_send_valid(S, pcalltarget, pobjectselection, pvalue_left, z_send, z_call)
rule PhpStep/pipe-object-send: S ~> $pipe_start($hold_task_inputs(S)[.TODO = (PIPE_OBJECT_RESULT pcalltarget_raw pobjectselection) :: ptask_tail*], pcalltarget, pvalue_left, pobjectselection.SITE, z_send, z_call)[.HELD = S.HELD]
