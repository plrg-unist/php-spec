dec $noctor_start(pstate, preqbytes, phpType7*, int) : pstate
;; Compiled source descriptors and live class names are separate tables.
def $class_at(eps, porigin) = eps
def $class_at(pclassdesc :: pclassdesc_tail*, porigin) = (pclassdesc)
  -- if pclassdesc.ORIGIN = porigin
def $class_at(pclassdesc :: pclassdesc_tail*, porigin) = $class_at(pclassdesc_tail*, porigin)
  -- if pclassdesc.ORIGIN =/= porigin
def $object_name(S, n) = pclassdesc.NAME
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
def $object_name(S, n) = $ptascii("Closure") -- otherwise
def $class_plain_instance(S, n) = true -- if S.OBJECTS[n] = INSTANCE porigin
def $class_plain_instance(S, n) = false -- otherwise
def $class_named(eps, preqbytes) = eps
def $class_named((preqbytes, porigin) :: (preqbytes_tail, porigin_tail)*, preqbytes) = (porigin)
def $class_named((preqbytes_other, porigin) :: (preqbytes_tail, porigin_tail)*, preqbytes) = $class_named((preqbytes_tail, porigin_tail)*, preqbytes)
  -- if preqbytes_other =/= preqbytes

dec $activate_class(pstate, pclassdesc) : pstate
dec $iterator_notice_publication(pstate, pstate, pclassdesc) : pstate
dec $activate_class_body(pstate, pclassdesc) : pstate
dec $activate_class_base_body(pstate, pclassdesc) : pstate
dec $declaration_class_success(pstate, pstate, pclassdesc) : pstate
dec $class_constant_publish(pstate, pstate, pclassdesc) : pstate
def $activate_class(S, pclassdesc) = $iterator_notice_publication(S, $class_constant_publish(S, $declaration_class_success(S, $activate_class_body(S, pclassdesc), pclassdesc), pclassdesc), pclassdesc)
  -- if ~$autoload_parent_pending(S, pclassdesc)
dec $class_static_initial(pstate, ppropertydesc*) : pclassstatic*?
dec $class_static_commit(pstate, pclassstatic*) : pstate
dec $class_static_finish(pstate, pclassdesc, pstate) : pstate
dec $class_statics_valid(pstate) : bool
def $activate_class_base_body(S, pclassdesc) = S -- if S.COMPLETION =/= NORMAL
def $activate_class_base_body(S, pclassdesc) = S[.COMPLETION = FATAL ($ptascii("Cannot redeclare ") ++ $ptascii(text_kind) ++ [32] ++ ptbytes_display) pclassdesc.LINE][.ERRORORIGIN = $compiled_error_origin(S.ERRORORIGIN, FATAL eps pclassdesc.LINE, n)][.TRACE = $eval_exception_trace(S)]
  -- if S.COMPLETION = NORMAL
  -- if $class_internal_at($class_internal_catalogue(), $ptlc(pclassdesc.NAME)) = (INTERNAL ptbytes_key ptbytes_display text_kind)
  -- if pclassdesc.ORIGIN = PORIGIN n pcpath
def $activate_class_base_body(S, pclassdesc) = S[.COMPLETION = UNSUPPORTED "class static default storage"]
  -- if S.COMPLETION = NORMAL
  -- if ~$class_internal(pclassdesc.NAME)
  -- if $class_named(S.CLASSNAMES, $ptlc(pclassdesc.NAME)) = eps
  -- if $class_static_initial(S, pclassdesc.PROPERTIES) = eps
def $activate_class_base_body(S, pclassdesc) = $class_static_commit(S[.CLASSNAMES = S.CLASSNAMES ++ [($ptlc(pclassdesc.NAME), pclassdesc.ORIGIN)]], pclassstatic*)
  -- if S.COMPLETION = NORMAL
  -- if pclassdesc.KIND = "class"
  -- if ~$class_internal(pclassdesc.NAME)
  -- if $class_named(S.CLASSNAMES, $ptlc(pclassdesc.NAME)) = eps
  -- if pclassdesc.PARENT = eps /\ pclassdesc.INTERFACES = eps
  -- if $class_static_initial(S, pclassdesc.PROPERTIES) = (pclassstatic*)
def $activate_class_base_body(S, pclassdesc) = S_published[.ERRORORIGIN = $compiled_error_origin(S_published.ERRORORIGIN, S_published.COMPLETION, n)]
  -- if S.COMPLETION = NORMAL
  -- if pclassdesc.KIND = "class"
  -- if ~$class_internal(pclassdesc.NAME)
  -- if $class_named(S.CLASSNAMES, $ptlc(pclassdesc.NAME)) = eps
  -- if pclassdesc.PARENT = (ptbytes_parent)
  -- if pclassdesc.INTERFACES = eps
  -- if $class_static_initial(S, pclassdesc.PROPERTIES) = (pclassstatic*)
  -- if pclassdesc.ORIGIN = PORIGIN n pcpath
  -- if S_parent = $activate_parented_class(S, pclassdesc, ptbytes_parent)
  -- if S_published = $class_static_commit(S_parent, pclassstatic*)
def $activate_class_base_body(S, pclassdesc) = S[.COMPLETION = FATAL ($ptascii("Cannot redeclare ") ++ $ptascii(pclassdesc_old.KIND) ++ [32] ++ pclassdesc_old.NAME ++ $ptascii(" (previously declared in ") ++ $call_sourcefile(S.FILES, pclassdesc_old.ORIGIN) ++ [58] ++ $ntunsigned(pclassdesc_old.LINE) ++ [41]) pclassdesc.LINE][.ERRORORIGIN = $compiled_error_origin(S.ERRORORIGIN, FATAL eps pclassdesc.LINE, n)][.TRACE = $eval_exception_trace(S)]
  -- if S.COMPLETION = NORMAL
  -- if pclassdesc.KIND = "class"
  -- if ~$class_internal(pclassdesc.NAME)
  -- if $class_named(S.CLASSNAMES, $ptlc(pclassdesc.NAME)) = (porigin)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc_old)
  -- if pclassdesc.ORIGIN = PORIGIN n pcpath

rule PhpStep/class-declaration-early: S ~> S[.TODO = ptask_tail*]
  -- if S.TODO = (STMT (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata)) :: ptask_tail*
  -- if S.ORIGIN = (porigin)
  -- if $origin_node(S.SOURCES, porigin) = (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if $declaration_early(S.DECLARATIONS, porigin, PPCLASS)
rule PhpStep/class-declaration-runtime: S ~> $activate_class(S[.TODO = ptask_tail*], pclassdesc)
  -- if S.TODO = (STMT (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata)) :: ptask_tail*
  -- if S.ORIGIN = (porigin)
  -- if $origin_node(S.SOURCES, porigin) = (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if ~$declaration_early(S.DECLARATIONS, porigin, PPCLASS)

dec $throwable_constructor_kind(ptbytes) : text?
dec $new_allocation_line(pstate, int) : int
def $new_allocation_line(S, z) = z -- otherwise
dec $internal_new_forbidden(ptbytes) : bool
def $internal_new_forbidden(ptbytes) = false -- otherwise
dec $new_class(pstate, preqbytes, int) : pstate
def $new_class(S, preqbytes, z) = S[.COMPLETION = UNSUPPORTED "internal class construction"]
  -- if $class_internal(preqbytes)
  -- if ~$internal_new_forbidden(preqbytes)
  -- if $ptlc(preqbytes) =/= $ptascii("stdclass")
  -- if $ptlc(preqbytes) =/= $ptascii("closure")
  -- if $throwable_constructor_kind(preqbytes) = eps
def $new_class(S, preqbytes, z) = $throw_scalar(S, "Error", $ptascii("Class \"") ++ preqbytes ++ $ptascii("\" not found"), z)
  -- if ~$class_internal(preqbytes)
  -- if $class_named(S.CLASSNAMES, $ptlc(preqbytes)) = eps
def $new_class(S, preqbytes, z) = $throw_scalar(S, "Error", $ptascii("Cannot instantiate abstract class ") ++ pclassdesc.NAME, z)
  -- if $class_named(S.CLASSNAMES, $ptlc(preqbytes)) = (porigin)
  -- if ~$class_internal(preqbytes)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if pclassdesc.KIND = "class" /\ pclassdesc.ABSTRACT
def $new_class(S, preqbytes, z) = S[.OBJECTS = S.OBJECTS ++ [INSTANCE porigin]][.OBJECTPROPS = S.OBJECTPROPS ++ [{OBJECT n, SLOTS ppropertyslot*, MATERIALIZED false}]][.ALLOCATIONS = S.ALLOCATIONS ++ [HOBJECT n]][.RESULT = KNOWN (POBJECT n)][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if $class_named(S.CLASSNAMES, $ptlc(preqbytes)) = (porigin)
  -- if ~$class_internal(preqbytes)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if pclassdesc.KIND = "class"
  -- if ~pclassdesc.ABSTRACT
  -- if $class_throwable_kind(S, porigin, |S.CLASSES|) = eps
  -- if n = |S.OBJECTS|
  -- if $property_initial_slots(S, porigin, $property_layout(S, porigin, |S.CLASSES|)) = (ppropertyslot*)
def $new_class(S, preqbytes, z) = S[.COMPLETION = UNSUPPORTED "invalid compiled property default"]
  -- if $class_named(S.CLASSNAMES, $ptlc(preqbytes)) = (porigin)
  -- if ~$class_internal(preqbytes)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if ~pclassdesc.ABSTRACT
  -- if $class_throwable_kind(S, porigin, |S.CLASSES|) = eps
  -- if $property_initial_slots(S, porigin, $property_layout(S, porigin, |S.CLASSES|)) = eps
dec $ordinary_keyword_new_site(pstate, porigin) : bool
def $ordinary_keyword_new_site(S, porigin) = false -- otherwise
dec $ordinary_keyword_new_task_valid(pstate, expression) : bool
def $ordinary_keyword_new_task_valid(S, expression) = true -- otherwise
dec $new_source_name(pstate, porigin) : preqbytes?
dec $trait_default_new_site(pstate, porigin) : bool
dec $trait_default_new_name(pstate, porigin) : preqbytes?
dec $anonymous_default_new_site(pstate, porigin) : bool
def $anonymous_default_new_site(S, porigin) = false -- otherwise
dec $anonymous_default_new_name(pstate, porigin) : preqbytes?
def $anonymous_default_new_name(S, porigin) = eps -- otherwise
def $new_source_name(S, porigin) = $anonymous_default_new_name(S, porigin) -- if $anonymous_default_new_site(S, porigin)
def $new_source_name(S, porigin) = $trait_default_new_name(S, porigin)
  -- if ~$anonymous_default_new_site(S, porigin) /\ $trait_default_new_site(S, porigin)
def $new_source_name(S, PORIGIN n pcpath) = (preqbytes)
  -- if ~$anonymous_default_new_site(S, PORIGIN n pcpath) /\ ~$trait_default_new_site(S, PORIGIN n pcpath)
  -- if ~$ordinary_keyword_new_site(S, PORIGIN n pcpath)
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_name(pcode.NAMES, pcpath) = ((preqbytes, eps))
def $new_source_name(S, porigin) = eps -- otherwise

rule PhpStep/new-class: S ~> $noctor_start(S[.TODO = ptask_tail*], preqbytes, eps, $runtime_line(S, eps, NExprNew name (SEQUENCE eps) metadata))
  -- if S.TODO = (EVAL (NExprNew name (SEQUENCE eps) metadata)) :: ptask_tail*
  -- if S.ORIGIN = (PORIGIN n pcpath)
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (NExprNew name (SEQUENCE eps) metadata)
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $new_source_name(S, PORIGIN n pcpath) = (preqbytes)
  -- if ~$new_has_ctor(S, preqbytes)

dec $class_instanceof(pstate, pvalue, preqbytes) : bool
def $class_instanceof(S, POBJECT n, preqbytes) = true
  -- if $ptlc(preqbytes) = $ptascii("stringable")
  -- if $stringable_instance(S, n)
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if ~$class_origin_matches(S, porigin, preqbytes, |S.CLASSES|)
def $class_instanceof(S, POBJECT n, preqbytes) = true
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $class_origin_matches(S, porigin, preqbytes, |S.CLASSES|)
def $class_instanceof(S, POBJECT n, preqbytes) = true
  -- if $ptlc(preqbytes) = $ptascii("closure")
  -- if $object_body(S.OBJECTS[n]) = REALCLOSURE porigin pitem* pstaticcell*
def $class_instanceof(S, POBJECT n, preqbytes) = true
  -- if $ptlc(preqbytes) = $ptascii("closure")
  -- if $object_body(S.OBJECTS[n]) = NAMEDCLOSURE porigin
def $class_instanceof(S, pvalue, preqbytes) = false -- otherwise
rule PhpStep/instanceof-class: S ~> S[.TODO = [$at_task($origin_child(S.ORIGIN, [PCFIELD 0]), EVAL expression), INSTANCEOF_RESULT $runtime_line(S, [PCFIELD 0], expression)] ++ ptask_tail*][.RESULT = KNOWN PNULL]
  -- if S.ORIGIN = (PORIGIN n pcpath)
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (NExprInstanceof expression name metadata)
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_name(pcode.NAMES, pcpath) = ((preqbytes, eps))
  -- if S.TODO = (EVAL (NExprInstanceof expression name metadata)) :: ptask_tail*
rule PhpStep/instanceof-class-result: S ~> S_value[.TODO = ptask_tail*][.RESULT = KNOWN (PBOOL $class_instanceof(S_value, pvalue, preqbytes))][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (INSTANCEOF_RESULT z) :: ptask_tail*
  -- if S.ORIGIN = (PORIGIN n pcpath)
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (NExprInstanceof expression name metadata)
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_name(pcode.NAMES, pcpath) = ((preqbytes, eps))
  -- if S_value = $resolve_at(S, S.RESULT, z)
  -- if S_value.COMPLETION = NORMAL
  -- if S_value.RESULT = KNOWN pvalue
rule PhpStep/instanceof-class-abrupt: S ~> S_value[.TODO = eps]
  -- if S.TODO = (INSTANCEOF_RESULT z) :: ptask_tail*
  -- if S_value = $resolve_at(S, S.RESULT, z)
  -- if S_value.COMPLETION =/= NORMAL

def $node_children(S, HOBJECT n) = $property_slot_nodes(ppropertyslot*)
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $objectprops_at(S.OBJECTPROPS, n) = (ppropertyslot*)
def $node_children(S, HOBJECT n) = eps
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $objectprops_at(S.OBJECTPROPS, n) = eps
def $closure_live_object_valid(S, n) = true
  -- if $(n < |S.OBJECTS|)
  -- if (HOBJECT n) <- S.ALLOCATIONS
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if pclassdesc.KIND = "class"
  -- if $class_named(S.CLASSNAMES, $ptlc(pclassdesc.NAME)) = (porigin)
  -- if $objectprops_at(S.OBJECTPROPS, n) = (ppropertyslot*)
  -- if $property_slots_valid(S, $property_layout(S, porigin, |S.CLASSES|), ppropertyslot*)
  -- if $class_throwable_kind(S, porigin, |S.CLASSES|) = eps
def $closure_live_object_valid(S, n) = true
  -- if $(n < |S.OBJECTS|)
  -- if (HOBJECT n) <- S.ALLOCATIONS
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if $class_named(S.CLASSNAMES, $ptlc(pclassdesc.NAME)) = (porigin)
  -- if $class_throwable_kind(S, porigin, |S.CLASSES|) = (text_kind)
  -- if $class_links_valid(S)
  -- if $throwable_instance_slots_valid(S, n, porigin, text_kind)

dec $class_registry_valid(pclassdesc*, (preqbytes, porigin)*) : bool
def $class_registry_valid(pclassdesc_registry*, eps) = true
def $class_registry_valid(pclassdesc_registry*, (preqbytes, porigin) :: (preqbytes_tail, porigin_tail)*) = true
  -- if $class_at(pclassdesc_registry*, porigin) = (pclassdesc)
  -- if preqbytes = $ptlc(pclassdesc.NAME)
  -- if ~$class_internal(pclassdesc.NAME)
  -- if $class_named((preqbytes_tail, porigin_tail)*, preqbytes) = eps
  -- if $class_registry_valid(pclassdesc_registry*, (preqbytes_tail, porigin_tail)*)
def $class_registry_valid(pclassdesc_registry*, (preqbytes, porigin)*) = false -- otherwise
syntax pclasscheck = CLASSCHECK pclassdesc* | CLASSINVALID
dec $class_projection(pstate, pcunit*) : pclasscheck
dec $declaration_history_valid(pstate) : bool
def $class_projection(S, eps) = CLASSCHECK eps
def $class_projection(S, pcunit :: pcunit_tail*) = CLASSCHECK (ppinstalled.CLASSES ++ pclassdesc*)
  -- if $compilation_projection(S, pcunit) = (ppinstalled)
  -- if $class_projection(S, pcunit_tail*) = CLASSCHECK pclassdesc*
def $class_projection(S, pcunit*) = CLASSINVALID -- otherwise
def $class_state_valid(S) = ($declaration_history_valid(S) /\ $class_registry_valid(S.CLASSES, S.CLASSNAMES) /\ $class_links_valid(S) /\ $pil_links_valid(S) /\ $property_state_valid(S) /\ $class_statics_valid(S))

dec $instanceof_task_valid(pstate, int) : bool
def $instanceof_task_valid(S, z) = true
  -- if S.ORIGIN = (PORIGIN n pcpath)
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (NExprInstanceof expression name metadata)
  -- if z = $runtime_line(S, [PCFIELD 0], expression)
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_name(pcode.NAMES, pcpath) = ((preqbytes, eps))
def $instanceof_task_valid(S, z) = false -- otherwise
def $call_task_valid(S, INSTANCEOF_RESULT z) = $instanceof_task_valid(S, z)

dec $class_stmt_task_valid(pstate, statement) : bool
def $class_stmt_task_valid(S, NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata) = true
  -- if S.ORIGIN = (porigin)
  -- if $origin_node(S.SOURCES, porigin) = (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
def $class_stmt_task_valid(S, statement) = false -- otherwise
def $call_task_valid(S, STMT (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata)) = $class_stmt_task_valid(S, NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata)

dec $class_expr_task_valid(pstate, expression) : bool
def $class_expr_task_valid(S, NExprNew name (SEQUENCE eps) metadata) = true
  -- if S.ORIGIN = (PORIGIN n pcpath)
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (NExprNew name (SEQUENCE eps) metadata)
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $new_source_name(S, PORIGIN n pcpath) =/= eps \/ $trait_default_new_site(S, PORIGIN n pcpath) \/ $anonymous_default_new_site(S, PORIGIN n pcpath) \/ $ordinary_keyword_new_site(S, PORIGIN n pcpath)
def $class_expr_task_valid(S, NExprInstanceof expression name metadata) = true
  -- if S.ORIGIN = (PORIGIN n pcpath)
  -- if $origin_node(S.SOURCES, PORIGIN n pcpath) = (NExprInstanceof expression name metadata)
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_name(pcode.NAMES, pcpath) = ((preqbytes, eps))
def $class_expr_task_valid(S, expression) = false -- otherwise
def $call_task_valid(S, EVAL (NExprNew name (SEQUENCE eps) metadata)) = $class_expr_task_valid(S, NExprNew name (SEQUENCE eps) metadata)
def $call_task_valid(S, EVAL (NExprInstanceof expression name metadata)) = $class_expr_task_valid(S, NExprInstanceof expression name metadata)
