dec $noctor_start(pstate, preqbytes, phpType7*, int) : pstate
;; Compiled source descriptors and live class names are separate tables.
def $class_at(eps, porigin) = eps
def $class_at(pclassdesc :: pclassdesc_tail*, porigin) = (pclassdesc)
  -- if pclassdesc.ORIGIN = porigin
def $class_at(pclassdesc :: pclassdesc_tail*, porigin) = $class_at(pclassdesc_tail*, porigin)
  -- if pclassdesc.ORIGIN =/= porigin
def $object_name(S, n) = pclassdesc.NAME
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
def $object_name(S, n) = $ptascii("Closure") -- otherwise
def $class_plain_instance(S, n) = true -- if S.OBJECTS[n] = INSTANCE porigin
def $class_plain_instance(S, n) = false -- otherwise
def $class_named(eps, preqbytes) = eps
def $class_named((preqbytes, porigin) :: (preqbytes_tail, porigin_tail)*, preqbytes) = (porigin)
def $class_named((preqbytes_other, porigin) :: (preqbytes_tail, porigin_tail)*, preqbytes) = $class_named((preqbytes_tail, porigin_tail)*, preqbytes)
  -- if preqbytes_other =/= preqbytes

dec $activate_class(pstate, pclassdesc) : pstate
dec $recorded_class_step(pstate, pclassdesc) : pstate
dec $iterator_notice_publication(pstate, pstate, pclassdesc) : pstate
dec $activate_class_body(pstate, pclassdesc) : pstate
dec $activate_class_prelink(pstate, pclassdesc) : pstate
dec $activate_class_base_body(pstate, pclassdesc) : pstate
dec $declaration_class_success(pstate, pstate, pclassdesc) : pstate
dec $class_constant_publish(pstate, pstate, pclassdesc) : pstate
dec $runtime_class_link_result(pstate, pstate, pclassdesc) : pstate
def $runtime_class_link_result(S, S_result, pclassdesc) = S_result -- otherwise
def $activate_class(S, pclassdesc) = $runtime_class_link_result(S, $iterator_notice_publication(S, $class_constant_publish(S, $declaration_class_success(S, $activate_class_prelink(S, pclassdesc), pclassdesc), pclassdesc), pclassdesc), pclassdesc)
  -- if ~$autoload_parent_pending(S, pclassdesc)
  -- if ~$autoload_interface_pending(S, pclassdesc)
  -- if ~$autoload_trait_pending(S, pclassdesc)
dec $class_static_initial(pstate, ppropertydesc*) : pclassstatic*?
dec $class_static_commit(pstate, pclassstatic*) : pstate
dec $class_static_finish(pstate, pclassdesc, pstate) : pstate
dec $class_statics_valid(pstate) : bool
def $activate_class_base_body(S, pclassdesc) = S -- if S.COMPLETION =/= NORMAL
def $activate_class_base_body(S, pclassdesc) = S[.COMPLETION = FATAL ($ptascii("Cannot redeclare ") ++ $ptascii(text_kind) ++ [32] ++ ptbytes_display) pclassdesc.LINE][.ERRORORIGIN = $compiled_error_origin(S.ERRORORIGIN, FATAL eps pclassdesc.LINE, n)][.TRACE = $eval_exception_trace(S)]
  -- if S.COMPLETION = NORMAL
  -- if $class_internal_at($class_internal_catalogue(), $ptlc(pclassdesc.NAME)) = (INTERNAL ptbytes_key ptbytes_display text_kind)
  -- if pclassdesc.ORIGIN = PORIGIN n pcpath
def $activate_class_base_body(S, pclassdesc) = S[.COMPLETION = UNSUPPORTED "class static default storage"]
  -- if S.COMPLETION = NORMAL
  -- if ~$class_internal(pclassdesc.NAME)
  -- if $class_named(S.CLASSNAMES, $ptlc(pclassdesc.NAME)) = eps
  -- if $class_static_initial(S, pclassdesc.PROPERTIES) = eps
def $activate_class_base_body(S, pclassdesc) = $class_static_commit(S[.CLASSNAMES = S.CLASSNAMES ++ [($ptlc(pclassdesc.NAME), pclassdesc.ORIGIN)]], pclassstatic*)
  -- if S.COMPLETION = NORMAL
  -- if pclassdesc.KIND = "class"
  -- if ~$class_internal(pclassdesc.NAME)
  -- if $class_named(S.CLASSNAMES, $ptlc(pclassdesc.NAME)) = eps
  -- if pclassdesc.PARENT = eps /\ pclassdesc.INTERFACES = eps
  -- if $class_static_initial(S, pclassdesc.PROPERTIES) = (pclassstatic*)
def $activate_class_base_body(S, pclassdesc) = S_published[.ERRORORIGIN = $compiled_error_origin(S_published.ERRORORIGIN, S_published.COMPLETION, n)]
  -- if S.COMPLETION = NORMAL
  -- if pclassdesc.KIND = "class"
  -- if ~$class_internal(pclassdesc.NAME)
  -- if $class_named(S.CLASSNAMES, $ptlc(pclassdesc.NAME)) = eps
  -- if pclassdesc.PARENT = (ptbytes_parent)
  -- if pclassdesc.INTERFACES = eps
  -- if $class_static_initial(S, pclassdesc.PROPERTIES) = (pclassstatic*)
  -- if pclassdesc.ORIGIN = PORIGIN n pcpath
  -- if S_parent = $activate_parented_class(S, pclassdesc, ptbytes_parent)
  -- if S_published = $class_static_commit(S_parent, pclassstatic*)
def $activate_class_base_body(S, pclassdesc) = S[.COMPLETION = FATAL ($ptascii("Cannot redeclare ") ++ $ptascii(pclassdesc_old.KIND) ++ [32] ++ pclassdesc_old.NAME ++ $ptascii(" (previously declared in ") ++ $call_sourcefile(S.FILES, pclassdesc_old.ORIGIN) ++ [58] ++ $ntunsigned(pclassdesc_old.LINE) ++ [41]) pclassdesc.LINE][.ERRORORIGIN = $compiled_error_origin(S.ERRORORIGIN, FATAL eps pclassdesc.LINE, n)][.TRACE = $eval_exception_trace(S)]
  -- if S.COMPLETION = NORMAL
  -- if pclassdesc.KIND = "class" \/ pclassdesc.KIND = "enum"
  -- if ~$class_internal(pclassdesc.NAME)
  -- if $class_named(S.CLASSNAMES, $ptlc(pclassdesc.NAME)) = (porigin)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc_old)
  -- if pclassdesc.ORIGIN = PORIGIN n pcpath

rule PhpStep/class-declaration-early: S ~> S[.TODO = ptask_tail*]
  -- if S.TODO = (STMT (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata)) :: ptask_tail*
  -- if S.ORIGIN = (porigin)
  -- if $origin_node(S.SOURCES, porigin) = (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if $declaration_early(S.DECLARATIONS, porigin, PPCLASS)
rule PhpStep/class-declaration-runtime: S ~> $recorded_class_step(S, pclassdesc)
  -- if S.TODO = (STMT (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata)) :: ptask_tail*
  -- if S.ORIGIN = (porigin)
  -- if $origin_node(S.SOURCES, porigin) = (NStmtClass phpType14 phpType24 phpType3 phpType44 phpType42 phpType23 metadata)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if ~$declaration_early(S.DECLARATIONS, porigin, PPCLASS)

dec $throwable_constructor_kind(ptbytes) : text?
dec $new_allocation_line(pstate, int) : int
def $new_allocation_line(S, z) = z -- otherwise
dec $internal_new_forbidden(ptbytes) : bool
def $internal_new_forbidden(ptbytes) = false -- otherwise
dec $new_class(pstate, preqbytes, int) : pstate
def $new_class(S, preqbytes, z) = S[.COMPLETION = UNSUPPORTED "internal class construction"]
  -- if $class_internal(preqbytes)
  -- if ~$internal_new_forbidden(preqbytes)
  -- if $ptlc(preqbytes) =/= $ptascii("stdclass")
  -- if $ptlc(preqbytes) =/= $ptascii("closure")
  -- if $ptlc(preqbytes) =/= $ptascii("fiber") /\ $ptlc(preqbytes) =/= $ptascii("fibererror")
  -- if $ptlc(preqbytes) =/= $ptascii("weakreference")
  -- if $ptlc(preqbytes) =/= $ptascii("weakmap")
  -- if $ptlc(preqbytes) =/= $ptascii("sensitiveparametervalue")
  -- if $throwable_constructor_kind(preqbytes) = eps
def $new_class(S, preqbytes, z) = $throw_scalar(S, "Error", $ptascii("Class \"") ++ preqbytes ++ $ptascii("\" not found"), z)
  -- if ~$class_internal(preqbytes)
  -- if $class_named(S.CLASSNAMES, $ptlc(preqbytes)) = eps
def $new_class(S, preqbytes, z) = $throw_scalar(S, "Error", $ptascii("Cannot instantiate abstract class ") ++ pclassdesc.NAME, z)
  -- if $class_named(S.CLASSNAMES, $ptlc(preqbytes)) = (porigin)
  -- if ~$class_internal(preqbytes)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if pclassdesc.KIND = "class" /\ pclassdesc.ABSTRACT
def $new_class(S, preqbytes, z) = S[.OBJECTS = S.OBJECTS ++ [INSTANCE porigin]][.OBJECTPROPS = S.OBJECTPROPS ++ [{OBJECT n, SLOTS ppropertyslot*, MATERIALIZED false}]][.ALLOCATIONS = S.ALLOCATIONS ++ [HOBJECT n]][.RESULT = KNOWN (POBJECT n)][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if $class_named(S.CLASSNAMES, $ptlc(preqbytes)) = (porigin)
  -- if ~$class_internal(preqbytes)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if pclassdesc.KIND = "class"
  -- if ~pclassdesc.ABSTRACT
  -- if $class_throwable_kind(S, porigin, |S.CLASSES|) = eps
  -- if n = |S.OBJECTS|
  -- if $property_initial_slots(S, porigin, $property_layout(S, porigin, |S.CLASSES|)) = (ppropertyslot*)
def $new_class(S, preqbytes, z) = S[.COMPLETION = UNSUPPORTED "invalid compiled property default"]
  -- if $class_named(S.CLASSNAMES, $ptlc(preqbytes)) = (porigin)
  -- if ~$class_internal(preqbytes)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if ~pclassdesc.ABSTRACT
  -- if $class_throwable_kind(S, porigin, |S.CLASSES|) = eps
  -- if $property_initial_slots(S, porigin, $property_layout(S, porigin, |S.CLASSES|)) = eps
