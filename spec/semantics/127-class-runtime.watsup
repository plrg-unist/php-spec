  -- if ~$ordinary_keyword_new_site(S, PORIGIN n pcpath) /\ ~$global_new_site(S, PORIGIN n pcpath)
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_name(pcode.NAMES, pcpath) = ((preqbytes, eps))
def $new_source_name(S, porigin) = eps -- otherwise

