dec $fiber_start_unpack_check(pstate, pfiberstart, pconfigpack, nat) : pstate
def $fiber_start_unpack_check(S, pfiberstart, pconfigpack, n_cursor) = $throw_scalar(S, "Error", $ptascii("Cannot use positional argument after named argument during unpacking"), pconfigpack.LINE)
  -- if pconfigpack.ITEMS[n_cursor] = ENTRY (KINT z) pitem
  -- if $config_pack_named(pconfigpack.ITEMS[0:n_cursor])
def $fiber_start_unpack_check(S, pfiberstart, pconfigpack, n_cursor) = $throw_scalar(S, "Error", $ptascii("Named parameter $") ++ $c_string(ptbytes) ++ $ptascii(" overwrites previous argument"), pconfigpack.LINE)
  -- if pconfigpack.ITEMS[n_cursor] = ENTRY (KSTRING ptbytes) pitem
  -- if $named_has(pfiberstart.SENT.NAMED, ptbytes)
def $fiber_start_unpack_check(S, pfiberstart, pconfigpack, n_cursor) = S -- otherwise
rule PhpStep/fiber-start-unpack-item: S ~> S_check[.TODO = (FIBER_UNPACK_NEXT n? pfiberstart[.SENT = pnamedargs] poperand $(n_cursor + 1)) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (FIBER_UNPACK_NEXT n? pfiberstart poperand n_cursor) :: ptask_tail*
  -- if $fiber_start_unpack_valid(S, n?, pfiberstart, poperand, n_cursor)
  -- if pconfigpack = pfiberstart.PACKS[$nabs($(|pfiberstart.PACKS| - 1))]
  -- if $(n_cursor < |pconfigpack.ITEMS|)
  -- if pconfigpack.ITEMS[n_cursor] = ENTRY pkey (DIRECT pvalue)
  -- if S_check = $fiber_start_unpack_check(S, pfiberstart, pconfigpack, n_cursor)
  -- if S_check.COMPLETION = NORMAL
  -- if $fiber_start_pack_send(pfiberstart.SENT, pvalue, $exit_key_name(pkey), $config_pack_named(pconfigpack.ITEMS[0:n_cursor])) = (pnamedargs)
rule PhpStep/fiber-start-unpack-item-error: S ~> S_check
  -- if S.TODO = (FIBER_UNPACK_NEXT n? pfiberstart poperand n_cursor) :: ptask_tail*
  -- if $fiber_start_unpack_valid(S, n?, pfiberstart, poperand, n_cursor)
  -- if pconfigpack = pfiberstart.PACKS[$nabs($(|pfiberstart.PACKS| - 1))]
  -- if $(n_cursor < |pconfigpack.ITEMS|)
  -- if S_check = $fiber_start_unpack_check(S, pfiberstart, pconfigpack, n_cursor)
  -- if S_check.COMPLETION =/= NORMAL
rule PhpStep/fiber-start-unpack-done: S ~> S[.TODO = $fiber_start_unpack_args(n?, pfiberstart[.INDEX = $(pfiberstart.INDEX + 1)]) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (FIBER_UNPACK_NEXT n? pfiberstart poperand n_cursor) :: ptask_tail*
  -- if $fiber_start_unpack_valid(S, n?, pfiberstart, poperand, n_cursor)
  -- if pconfigpack = pfiberstart.PACKS[$nabs($(|pfiberstart.PACKS| - 1))]
  -- if n_cursor = |pconfigpack.ITEMS|

dec $fiber_start_unpack_nodes(nat?, pfiberstart) : pnode*
def $fiber_start_unpack_nodes(eps, pfiberstart) = $task_nodes(FIBER_ARGS pfiberstart)
def $fiber_start_unpack_nodes((n), pfiberstart) = $task_nodes(FIBER_START_CAPTURE_ARGS n pfiberstart)
def $task_nodes(FIBER_UNPACK_PREP n? pfiberstart) = $fiber_start_unpack_nodes(n?, pfiberstart)
def $task_nodes(FIBER_UNPACK_NEXT n? pfiberstart poperand n_cursor) = $fiber_start_unpack_nodes(n?, pfiberstart) ++ $operand_nodes(poperand)
def $call_task_valid(S, FIBER_UNPACK_PREP n? pfiberstart) = $fiber_start_unpack_pending(S, n?, pfiberstart)
def $call_task_valid(S, FIBER_UNPACK_NEXT n? pfiberstart poperand n_cursor) = $fiber_start_unpack_valid(S, n?, pfiberstart, poperand, n_cursor)
def $generator_internal_task(FIBER_UNPACK_PREP n? pfiberstart) = true
def $generator_internal_task(FIBER_UNPACK_NEXT n? pfiberstart poperand n_cursor) = true

;; Pending call teardown moves every slot once into Zend's release order.
;; Explicit __invoke owns the Closure as EX(This); direct calls release the
;; Closure function after named args through their existing capture tail.
dec $fiber_start_unpack_unwind_valid(pstate, ptask) : bool
def $fiber_start_unpack_unwind_valid(S, ptask) = true
  -- if S.TODO = (THROW_SEARCH n_throwable) :: ptask_tail*
  -- if $throwable_live(S, n_throwable)
  -- if $call_task_valid(S[.TODO = (THROW_SEARCH n_throwable) :: ptask :: ptask_tail*], ptask)
def $fiber_start_unpack_unwind_valid(S, ptask) = false -- otherwise
dec $fiber_start_unpack_discard(pstate, ptask, nat?, pfiberstart, pnode*) : pstate
def $fiber_start_unpack_discard(S, ptask, eps, pfiberstart, pnode*) = $destructor_release_begin(S, $destruction_values(pnode* ++ $named_slots_roots(pfiberstart.SENT.SLOTS) ++ [HOBJECT pfiberstart.OBJECT] ++ $named_roots(pfiberstart.SENT.NAMED)))
  -- if $fiber_start_unpack_unwind_valid(S, ptask)
def $fiber_start_unpack_discard(S, ptask, (n), pfiberstart, pnode*) = $destructor_release_begin(S[.TODO = (THROW_SEARCH n_throwable) :: ptask_tail*], $destruction_values(pnode* ++ $named_slots_roots(pfiberstart.SENT.SLOTS) ++ [HOBJECT n] ++ $named_roots(pfiberstart.SENT.NAMED)))
  -- if $fiber_start_unpack_unwind_valid(S, ptask)
  -- if $exit_method_site(S, pfiberstart.SITE)
  -- if S.TODO = (THROW_SEARCH n_throwable) :: (FIBER_CAPTURE_RELEASE n pfiberstart.SITE) :: ptask_tail*
def $fiber_start_unpack_discard(S, ptask, (n), pfiberstart, pnode*) = $destructor_release_begin(S, $destruction_values(pnode* ++ $named_slots_roots(pfiberstart.SENT.SLOTS) ++ $named_roots(pfiberstart.SENT.NAMED)))
  -- if $fiber_start_unpack_unwind_valid(S, ptask)
  -- if ~$exit_method_site(S, pfiberstart.SITE)
def $return_discard(S, FIBER_UNPACK_PREP n? pfiberstart) = $fiber_start_unpack_discard(S, FIBER_UNPACK_PREP n? pfiberstart, n?, pfiberstart, eps)
  -- if $fiber_start_unpack_unwind_valid(S, FIBER_UNPACK_PREP n? pfiberstart)
def $return_discard(S, FIBER_UNPACK_NEXT n? pfiberstart poperand n_cursor) = $fiber_start_unpack_discard(S, FIBER_UNPACK_NEXT n? pfiberstart poperand n_cursor, n?, pfiberstart, $operand_nodes(poperand))
  -- if $fiber_start_unpack_unwind_valid(S, FIBER_UNPACK_NEXT n? pfiberstart poperand n_cursor)
