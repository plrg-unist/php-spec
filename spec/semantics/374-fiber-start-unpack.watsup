rule PhpStep/fiber-start-unpack-type: S ~> $throw_scalar(S_value, "TypeError", $ptascii("Only arrays and Traversables can be unpacked, ") ++ $noctor_unpack_type_bytes(S_value, pvalue) ++ $ptascii(" given"), z)
  -- if S.TODO = (FIBER_UNPACK_PREP n? pfiberstart) :: ptask_tail*
  -- if $fiber_start_unpack_pending(S, n?, pfiberstart)
  -- if $intrinsic_argument(S, pfiberstart.SITE, pfiberstart.INDEX) = ((expression, true, eps, porigin, z))
  -- if S_value = $resolve_at(S, S.RESULT, z)
  -- if S_value.COMPLETION = NORMAL
  -- if S_value.RESULT = KNOWN pvalue
  -- if ~$is_array_value(pvalue) /\ ~$class_instanceof(S_value, pvalue, $ptascii("Traversable"))
rule PhpStep/fiber-start-unpack-traversable: S ~> S_value[.COMPLETION = UNSUPPORTED "Fiber start Traversable unpacking"]
  -- if S.TODO = (FIBER_UNPACK_PREP n? pfiberstart) :: ptask_tail*
  -- if $fiber_start_unpack_pending(S, n?, pfiberstart)
  -- if $intrinsic_argument(S, pfiberstart.SITE, pfiberstart.INDEX) = ((expression, true, eps, porigin, z))
  -- if S_value = $resolve_at(S, S.RESULT, z)
  -- if S_value.COMPLETION = NORMAL
  -- if S_value.RESULT = KNOWN pvalue
  -- if $class_instanceof(S_value, pvalue, $ptascii("Traversable"))
rule PhpStep/fiber-start-unpack-abrupt: S ~> S_value
  -- if S.TODO = (FIBER_UNPACK_PREP n? pfiberstart) :: ptask_tail*
  -- if $fiber_start_unpack_pending(S, n?, pfiberstart)
  -- if $intrinsic_argument(S, pfiberstart.SITE, pfiberstart.INDEX) = ((expression, true, eps, porigin, z))
