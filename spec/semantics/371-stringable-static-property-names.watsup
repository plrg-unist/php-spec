;; Static address lookup frees an evaluated name only after checking the row.
;; Its destructor can change that row and op2 before ASSIGN_STATIC_PROP_OP reads
;; either value. The post-address continuation therefore owns only the RHS.
dec $computed_static_cast_valid(pstate, pcomputedcompound, nat, porigin) : bool
dec $computed_static_receiver(poperand, nat) : bool
dec $computed_static_fetch(pstate, pcomputedcompound, nat, porigin, ptbytes, nat?, ptask*) : pstate
dec $computed_static_fetch_prepared(pstate, nat?, ptask*) : pstate
dec $computed_static_fetch_ready(pstate, pcomputedcompound, nat, porigin, ptbytes, nat?) : bool
dec $computed_static_fetch_marker(pstate, ptask*, pcomputedcompound, nat, porigin, ptbytes, nat?) : bool
dec $computed_static_fetch_pair(ptask*, pcomputedcompound, nat, porigin, ptbytes, nat?) : bool
dec $computed_static_address_valid(pstate, pcomputedaddress) : bool
dec $computed_static_pending_valid(pstate, nat?) : bool
dec $computed_static_pending_merge(pstate, nat, nat?) : pstate
dec $computed_static_pending_end(pstate, nat?, ptask*) : pstate
dec $computed_static_pending_compound(pstate, pcomputedaddress) : pstate
dec $computed_static_pending_binary(pstate, pcomputedaddress, pvalue, pvalue) : pstate
dec $computed_static_pending_conversion(ptbranch*, ptbytes, bool) : ptypeconversion
dec $computed_static_pending_store(pstate, pcomputedaddress, pstate) : pstate
dec $computed_static_pending_captured(pstate, pcomputedaddress, pstaticcompound, ptbytes) : pstate
dec $computed_static_pending_direct(pstate, pcomputedaddress, pstaticcompound, ptypeconversion) : pstate
dec $computed_static_pending_writer(pstate, pcomputedaddress) : bool
dec $computed_static_fetch_identity(ptask, nat, porigin, int) : bool
dec $computed_static_fetch_find(ptask*, nat, porigin, int) : ptask?
dec $computed_static_fetch_pending(ptask*, ptask, ptask) : ptask*
dec $computed_static_throw_fetch(ptask*, porigin?, nat) : ptask?
dec $computed_static_throw_task(ptask, porigin?, nat) : bool
dec $computed_static_array(pvalue) : bool
dec $computed_static_object(pvalue) : bool

