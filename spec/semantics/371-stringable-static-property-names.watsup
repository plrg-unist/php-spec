  -- if pdestructionoperation.COMPLETION = NORMAL /\ pdestructionoperation.VALUE = KNOWN PNULL
  -- if pdestructionoperation.CALLER = S.CURRENT
  -- if $computed_static_throw_fetch(ptask*, pdestructionoperation.ORIGIN, n_old) = (ptask_fetch)
  -- if ptask_fetch = COMPOUND_STATIC_FETCH pcomputedcompound n porigin_root ptbytes n_fetch?
  -- if n_fetch? = (n_old)
  -- if $call_task_valid(S[.TODO = ptask*][.BASE = pdestructionoperation.BASE], ptask_fetch)
  -- if $computed_static_pending_valid(S, (n_old)) /\ $computed_static_pending_valid(S, (n_pending))
  -- if S_linked = $computed_static_pending_merge(S, n_pending, (n_old))
  -- if S_linked.COMPLETION = NORMAL

;; An already pending exception prevents zend_call_function from entering an
;; object conversion. Scalar concatenation still writes before HANDLE_EXCEPTION;
;; a warning from an array's try conversion instead aborts the binary operation.
def $computed_static_object(POBJECT n) = true
def $computed_static_object(pvalue) = false -- otherwise
def $computed_static_array(PARRAY n) = true
def $computed_static_array(pvalue) = false -- otherwise
def $computed_static_pending_compound(S, pcomputedaddress) = S_place
  -- if S_place = $compound_location(S, BASE_CLASS_STATIC pcomputedaddress.ROOT pcomputedaddress.NAME, pcomputedaddress.LINE)
  -- if S_place.COMPLETION =/= NORMAL
def $computed_static_pending_compound(S, pcomputedaddress) = S_read
  -- if S_place = $compound_location(S, BASE_CLASS_STATIC pcomputedaddress.ROOT pcomputedaddress.NAME, pcomputedaddress.LINE)
  -- if S_place.COMPLETION = NORMAL
  -- if S_read = $resolve_at(S_place, pcomputedaddress.RIGHT, pcomputedaddress.LINE)
  -- if S_read.COMPLETION =/= NORMAL
def $computed_static_pending_compound(S, pcomputedaddress) = $computed_static_pending_binary(S_read, pcomputedaddress, pvalue_left, pvalue_right)
  -- if S_place = $compound_location(S, BASE_CLASS_STATIC pcomputedaddress.ROOT pcomputedaddress.NAME, pcomputedaddress.LINE)
  -- if S_place.COMPLETION = NORMAL
  -- if S_read = $resolve_at(S_place, pcomputedaddress.RIGHT, pcomputedaddress.LINE)
  -- if S_read.COMPLETION = NORMAL
  -- if $location_slot(S_read, S_read.LOCATION) = DEFINED pvalue_left
  -- if S_read.RESULT = KNOWN pvalue_right
def $computed_static_pending_binary(S, pcomputedaddress, pvalue_left, pvalue_right) = S
  -- if $computed_static_object(pvalue_left)
def $computed_static_pending_binary(S, pcomputedaddress, pvalue_left, pvalue_right) = $stringify(S, pvalue_left, pcomputedaddress.LINE)
  -- if $computed_static_array(pvalue_left)
def $computed_static_pending_binary(S, pcomputedaddress, pvalue_left, pvalue_right) = S
  -- if ~$computed_static_object(pvalue_left) /\ ~$computed_static_array(pvalue_left)
  -- if $computed_static_object(pvalue_right)
def $computed_static_pending_binary(S, pcomputedaddress, pvalue_left, pvalue_right) = $stringify(S, pvalue_right, pcomputedaddress.LINE)
  -- if ~$computed_static_object(pvalue_left) /\ ~$computed_static_array(pvalue_left)
  -- if $computed_static_array(pvalue_right)
def $computed_static_pending_binary(S, pcomputedaddress, pvalue_left, pvalue_right) = $computed_static_pending_store(S, pcomputedaddress, $binary_apply(S, CONCAT, pvalue_left, pvalue_right, pcomputedaddress.LINE))
  -- if ~$computed_static_object(pvalue_left) /\ ~$computed_static_array(pvalue_left)
  -- if ~$computed_static_object(pvalue_right) /\ ~$computed_static_array(pvalue_right)

;; Weak scalar parsers abort under EG(exception). The numeric int|float
;; union shortcut parses the new string directly; exact string/mixed succeeds.
def $computed_static_pending_conversion(ptbranch*, ptbytes, b) = TYPEVALUE (PSTRING ptbytes)
  -- if $typed_exact(ptbranch*, PSTRING ptbytes)
def $computed_static_pending_conversion(ptbranch*, ptbytes, false) = TYPEVALUE $number_value(pnumber)
  -- if ~$typed_exact(ptbranch*, PSTRING ptbytes)
  -- if "int" <- $ptmasks(ptbranch*) /\ "float" <- $ptmasks(ptbranch*)
  -- if $typed_number(PSTRING ptbytes) = (pnumber)
def $computed_static_pending_conversion(ptbranch*, ptbytes, b) = TYPEREJECT -- otherwise
def $computed_static_pending_writer(S, pcomputedaddress) = true
  -- if S.TODO = (COMPOUND_STATIC_APPLY pcomputedaddress) :: ptask*
  -- if pcomputedaddress.PENDING = (n_pending)
  -- if S.ORIGIN = (pcomputedaddress.SITE)
  -- if $call_task_valid(S[.ORIGIN = $origin_child((pcomputedaddress.SITE), [PCFIELD 0])], COMPOUND_STATIC_APPLY pcomputedaddress)
def $computed_static_pending_writer(S, pcomputedaddress) = false -- otherwise
def $propref_conversion(S, ptbranch*, PSTRING ptbytes, b) = $computed_static_pending_conversion(ptbranch*, ptbytes, b)
  -- if S.TODO = (COMPOUND_STATIC_APPLY pcomputedaddress) :: ptask*
  -- if $computed_static_pending_writer(S, pcomputedaddress)
def $computed_static_pending_store(S, pcomputedaddress, S_changed) = S_changed
  -- if S_changed.COMPLETION =/= NORMAL
def $computed_static_pending_store(S, pcomputedaddress, S_changed) = $computed_static_pending_captured(S_entered, pcomputedaddress, pstaticcompound, ptbytes)
  -- if S_changed.COMPLETION = NORMAL
  -- if S_changed.RESULT = KNOWN (PSTRING ptbytes)
  -- if S.LOCATION = CLASS_STATIC ppropertyid
  -- if $static_compound_capture(S, ppropertyid, pcomputedaddress.SITE, |S.CLASSCONSTANTHISTORY|) = (pstaticcompound)
  -- if S_entered = S_changed[.LOCATION = STATIC_COMPOUND pstaticcompound][.CLASSCONSTANTHISTORY = S_changed.CLASSCONSTANTHISTORY ++ [$static_compound_enter_event(S, pstaticcompound, pcomputedaddress.SITE, pcomputedaddress.LINE)]]
def $computed_static_pending_captured(S, pcomputedaddress, pstaticcompound, ptbytes) = $static_compound_store(S, pstaticcompound, pcomputedaddress.SITE, pcomputedaddress.LINE, PSTRING ptbytes)
  -- if ~pstaticcompound.VERIFY
def $computed_static_pending_captured(S, pcomputedaddress, pstaticcompound, ptbytes) = $computed_static_pending_direct(S, pcomputedaddress, pstaticcompound, $computed_static_pending_conversion(ppropertydesc.TYPE, ptbytes, $property_strict(S)))
  -- if pstaticcompound.VERIFY /\ pstaticcompound.CELL = eps
  -- if $static_compound_descriptor(S, pstaticcompound, pcomputedaddress.SITE) = (ppropertydesc)
def $computed_static_pending_captured(S, pcomputedaddress, pstaticcompound, ptbytes) = $write_cell_checked(S, n, PSTRING ptbytes, pcomputedaddress.LINE)
  -- if pstaticcompound.VERIFY
  -- if pstaticcompound.CELL = (n)
def $computed_static_pending_direct(S, pcomputedaddress, pstaticcompound, TYPEVALUE pvalue) = $static_compound_direct(S, pstaticcompound, pcomputedaddress.SITE, pcomputedaddress.LINE, pvalue)
def $computed_static_pending_direct(S, pcomputedaddress, pstaticcompound, TYPEREJECT) = S

;; A current string/reference bypasses verification, just like the ordinary
;; static concat fast path. Bind its raw backing to the actual pending writer
;; and fresh ENTRY rather than granting authority from an AST alone.
def $reference_coercion_admission(S, n, porigin, z, ptbytes) = true
  -- if S.TODO = (COMPOUND_STATIC_APPLY pcomputedaddress) :: ptask*
  -- if $computed_static_pending_writer(S, pcomputedaddress)
