;; source operands retain exactly their own CV/VAR/TMP ownership throughout.
def $computed_static_receiver(KNOWN (POBJECT n), n) = true
def $computed_static_receiver(VARIABLE n_name* z, n) = true
def $computed_static_receiver(REFERENCE n_cell, n) = true
def $computed_static_receiver(poperand, n) = false -- otherwise
def $computed_static_cast_valid(S, pcomputedcompound, n, porigin_root) = ($computed_static_valid(S, pcomputedcompound) /\ $computed_static_receiver(pcomputedcompound.NAME, n) /\ $ordinary_internal_string_evidence(S, n) /\ $scoped_selector_class(S, pcomputedcompound.CLASS) = (porigin_root))
