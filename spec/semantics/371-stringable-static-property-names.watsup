  -- if S.LOCATION = STATIC_COMPOUND pstaticcompound
  -- if pstaticcompound.CELL = (n) /\ ~pstaticcompound.VERIFY
  -- if $static_compound_source(S, pstaticcompound, porigin, z)
  -- if $(pstaticcompound.ENTRY + 1 = |S.CLASSCONSTANTHISTORY|)
  -- if $static_compound_capture(S, pstaticcompound.DECL, porigin, pstaticcompound.ENTRY) = (pstaticcompound)
  -- if S.COMPLETION = NORMAL /\ S.RESULT = KNOWN (PSTRING ptbytes)
rule PhpStep/computed-static-name-apply-pending: S ~> $computed_static_pending_end(S_updated[.HELD = S.HELD], pcomputedaddress.PENDING, ptask*)
