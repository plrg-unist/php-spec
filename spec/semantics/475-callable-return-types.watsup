def $callable_return_array(S, pvalue) = false -- otherwise

dec $callable_return_value(pstate, pvalue) : bool
def $callable_return_value(S, pvalue) = ($callable_return_array(S, pvalue) \/ $callable_return_keyword_array(S, pvalue) \/ $callable_return_word(pvalue) =/= eps)

