;; Keep the unresolved compiled replacement-finally/native-timeout combination
;; explicit. Nested callable bodies do not replace this return's outcome.
dec $callable_return_transfer_node(pcnode) : bool
def $callable_return_transfer_node(NStmtReturn phpType5 metadata) = true
def $callable_return_transfer_node(NExprThrow expression metadata) = true
def $callable_return_transfer_node(NStmtBreak phpType5 metadata) = true
def $callable_return_transfer_node(NStmtContinue phpType5 metadata) = true
def $callable_return_transfer_node(NStmtGoto phpType11 metadata) = true
def $callable_return_transfer_node(pcnode) = false -- otherwise
dec $callable_return_region_safe(pcoccurrence*, pcoccurrence*, pcpath, pcpath) : bool
def $callable_return_region_safe(pcoccurrence_all*, eps, pcpath_final, pcpath_scope) = true
def $callable_return_region_safe(pcoccurrence_all*, (PCOCCURRENCE pcpath pcnode) :: pcoccurrence_tail*, pcpath_final, pcpath_scope) = $callable_return_region_safe(pcoccurrence_all*, pcoccurrence_tail*, pcpath_final, pcpath_scope)
  -- if ~$effect_below(pcpath_final, pcpath) \/ $ppfinally_scope(pcoccurrence_all*, pcpath) =/= pcpath_scope \/ ~$callable_return_transfer_node(pcnode)
def $callable_return_region_safe(pcoccurrence_all*, pcoccurrence*, pcpath_final, pcpath_scope) = false -- otherwise
dec $callable_return_regions_safe(pcoccurrence*, pcpath*, pcpath) : bool
def $callable_return_regions_safe(pcoccurrence*, eps, pcpath_scope) = true
def $callable_return_regions_safe(pcoccurrence*, pcpath :: pcpath_tail*, pcpath_scope) = ($callable_return_region_safe(pcoccurrence*, pcoccurrence*, pcpath ++ [PCFIELD 2], pcpath_scope) /\ $callable_return_regions_safe(pcoccurrence*, pcpath_tail*, pcpath_scope))
dec $callable_return_finally_safe(pstate, porigin) : bool
def $callable_return_finally_safe(S, PORIGIN n pcpath) = true
  -- if $source_unit(S.SOURCES, n) = (pcunit)
  -- if $callable_return_regions_safe(pcunit.OCCURRENCES, $ppfinally_protected(pcunit.OCCURRENCES, pcpath), $ppfinally_scope(pcunit.OCCURRENCES, pcpath))
def $callable_return_finally_safe(S, porigin) = false -- otherwise

;; This is an unimplemented continuation, not a PHP exception to unwind.
def $callable_return_blocked(S) = true
  -- if S.COMPLETION = UNSUPPORTED "callable return pending replacement finally"
  -- if S.TODO = (API_CALLABLE_RESULT papiquery 1) :: ptask_tail*
  -- if papiquery.SOURCE = CALLABLE_RETURN_SOURCE porigin_function porigin_site pvalue z (n)
  -- if $api_query_valid(S, papiquery, 1) /\ $throwable_live(S, n)
  -- if ~$callable_return_finally_safe(S, porigin_site)

dec $callable_return_success(pstate, ptask) : pstate
def $callable_return_success(S, CALLABLE_RETURN_SOURCE porigin_function porigin_site pvalue z eps) = S[.TODO = (RETURN_UNWIND (KNOWN pvalue) (porigin_site)) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = ptask :: ptask_tail*
def $callable_return_success(S, CALLABLE_RETURN_SOURCE porigin_function porigin_site pvalue z (n)) = S[.TODO = (RETURN_UNWIND (KNOWN pvalue) (porigin_site)) :: (ptask_tail* ++ [CALLABLE_RETURN_PENDING porigin_function porigin_site z n])][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = ptask :: ptask_tail*
  -- if $callable_return_finally_safe(S, porigin_site)
def $callable_return_success(S, CALLABLE_RETURN_SOURCE porigin_function porigin_site pvalue z (n)) = S[.COMPLETION = UNSUPPORTED "callable return pending replacement finally"]
  -- if ~$callable_return_finally_safe(S, porigin_site)
def $api_finish(S, ptask_source, pvalue, HANDLERRESOLVED pcalltarget) = $callable_return_success(S, ptask_source)
  -- if ptask_source = CALLABLE_RETURN_SOURCE porigin_function porigin_site pvalue z n_pending?
  -- if $callable_return_result_valid(S, ptask_source, pcalltarget)
def $api_finish(S, ptask_source, pvalue, HANDLERRESOLVED pcalltarget) = S[.COMPLETION = UNSUPPORTED "callable return method metadata"]
  -- if ptask_source = CALLABLE_RETURN_SOURCE porigin_function porigin_site pvalue z n_pending?
  -- if ~$callable_return_result_valid(S, ptask_source, pcalltarget)

dec $callable_return_reject(pstate, ptask) : pstate
dec $callable_return_previous(pstate, nat, nat?) : pstate
def $callable_return_previous(S, n_new, eps) = S
def $callable_return_previous(S, n_new, (n_old)) = $throwable_previous(S, n_new, n_old)
def $callable_return_reject(S, CALLABLE_RETURN_SOURCE porigin_function porigin_site pvalue z n_pending?) = $throwable_begin($callable_return_previous(S_new, n_new, n_pending?))
  -- if S.TODO = ptask :: ptask_tail*
  -- if $function_at(S.FUNCTIONS, porigin_function) = (pfunction)
  -- if S_new = $throwable_materialize($throw_scalar(S[.TODO = ptask_tail*], "TypeError", $return_function_name(S, pfunction) ++ $ptascii("(): Return value must be of type ") ++ $pttypename(pfunction.SIGNATURE.RETURNS) ++ $ptascii(", ") ++ $typed_given(S, pvalue) ++ $ptascii(" returned"), z))
  -- if S_new.COMPLETION = THROWING n_new
def $api_finish(S, ptask_source, pvalue, HANDLERINVALID ptbytes) = $callable_return_reject(S, ptask_source)
  -- if ptask_source = CALLABLE_RETURN_SOURCE porigin_function porigin_site pvalue z n_pending?
def $api_throw(S, papiquery, ptbytes_method, ptbytes) = S[.COMPLETION = UNSUPPORTED "callable return method metadata"]
  -- if papiquery.SOURCE = CALLABLE_RETURN_SOURCE porigin_function porigin_site pvalue z n_pending?

;; Handler restoration transfers its real exception into SOURCE, then resumes
;; the same active API lookup. No captured history grants receiver liveness.
def $identity_read_discard(S, API_CALLABLE_RESULT papiquery 1) = S[.TODO = (API_CALLABLE_RESULT (papiquery[.SOURCE = CALLABLE_RETURN_SOURCE porigin_function porigin_site pvalue z (n)]) 1) :: ptask_tail*]
  -- if papiquery.SOURCE = CALLABLE_RETURN_SOURCE porigin_function porigin_site pvalue z eps
  -- if S.TODO = (THROW_SEARCH n) :: ptask_tail*
  -- if S_check = S[.TODO = (API_CALLABLE_RESULT papiquery 1) :: (ptask_tail* ++ [THROW_SEARCH n])]
  -- if $api_query_valid(S_check, papiquery, 1) /\ $throwable_live(S, n)

;; The return temporary survives finally, then transfers to the caller before
;; ordinary throwing-frame cleanup consumes the genuine pending exception.
def $task_nodes(CALLABLE_RETURN_PENDING porigin_function porigin_site z n) = [HOBJECT n]
def $call_task_valid(S, CALLABLE_RETURN_PENDING porigin_function porigin_site z n) = ($callable_return_metadata(S, porigin_function, porigin_site, z) /\ $callable_return_finally_safe(S, porigin_site) /\ $throwable_live(S, n))
def $task_nodes(CALLABLE_RETURN_CANCEL porigin_function porigin_site pvalue z) = $value_nodes(pvalue)
def $call_task_valid(S, CALLABLE_RETURN_CANCEL porigin_function porigin_site pvalue z) = ($callable_return_metadata(S, porigin_function, porigin_site, z) /\ $callable_return_finally_safe(S, porigin_site) /\ $is_array_value(pvalue) /\ $heap_subset($value_nodes(pvalue), S.ALLOCATIONS))
def $return_discard(S, CALLABLE_RETURN_PENDING porigin_function porigin_site z n) = $throw_frame_resume($restore_frame(S_transfer), n)
  -- if S.TODO = [RETURN_UNWIND (KNOWN pvalue) (porigin_site)]
  -- if $callable_return_metadata(S, porigin_function, porigin_site, z)
  -- if $callable_return_frame(S, porigin_function)
  -- if S.FRAMES = pframe :: pframe_tail*
  -- if pframe_new = pframe[.TODO = (CALLABLE_RETURN_CANCEL porigin_function porigin_site pvalue z) :: pframe.TODO]
  -- if S_transfer = S[.FRAMES = pframe_new :: pframe_tail*][.TODO = [THROW_SEARCH n]][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)][.HELD = eps][.RETIREDOWNERS = eps]
def $return_discard(S, CALLABLE_RETURN_PENDING porigin_function porigin_site z n_old) = $throwable_previous(S, n, n_old)
  -- if S.TODO = (THROW_SEARCH n) :: ptask_tail*
def $return_discard(S, CALLABLE_RETURN_CANCEL porigin_function porigin_site pvalue z) = S
