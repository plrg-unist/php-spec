def $pure_ref_scalar_stmts(S, preqbytes, n_cell, (NStmtEcho (SEQUENCE expression*) metadata) :: statement_tail*) = ($callable_protected_ref_quiet_exprs(S, preqbytes, false, expression*) /\ $pure_ref_scalar_stmts(S, preqbytes, n_cell, statement_tail*))
def $pure_ref_scalar_stmts(S, preqbytes, n_cell, (NStmtExpression (NExprAssign (NExprVariable (BYTES text) metadata_variable) expression metadata_expression) metadata_statement) :: statement_tail*) = $callable_protected_ref_quiet_stmts(S, preqbytes, n_cell, false, statement_tail*)
