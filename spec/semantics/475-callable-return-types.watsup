  -- if S.STORE[n_cell] = DEFINED pvalue
  -- if $callable_return_input(S, pvalue)
  -- if S.COMPLETION = NORMAL
  -- if $callable_return_function(S, pcallcontext.FUNCTION) = (pfunction)
  -- if ptypeconversion = $typed_reference_conversion(S, pfunction.SIGNATURE.RETURNS, pvalue, pfunction.CODE.STRICT, false)
  -- if ptypeconversion = TYPEVALUE pvalue \/ ptypeconversion = TYPEDEPENDENT "deprecated callable admission continuation"
def $callable_return_cv_candidate(S, z) = false -- otherwise
def $typed_return_callback_candidate(S, z) = true -- if $callable_return_cv_candidate(S, z)

dec $callable_return_source_identity(ptask) : (porigin, porigin, int, nat?)?
def $callable_return_source_identity(CALLABLE_RETURN_SOURCE porigin_function porigin_site pvalue z n_pending?) = ((porigin_function, porigin_site, z, n_pending?))
def $callable_return_source_identity(CALLABLE_RETURN_CV_SOURCE porigin_function porigin_site preqbytes n_cell z n_pending?) = ((porigin_function, porigin_site, z, n_pending?))
def $callable_return_source_identity(ptask) = eps -- otherwise
dec $callable_return_source_value(pstate, ptask) : pvalue?
def $callable_return_source_value(S, CALLABLE_RETURN_SOURCE porigin_function porigin_site pvalue z n_pending?) = (pvalue)
def $callable_return_source_value(S, CALLABLE_RETURN_CV_SOURCE porigin_function porigin_site preqbytes n_cell z n_pending?) = (pvalue)
  -- if $(n_cell < |S.STORE|)
  -- if S.STORE[n_cell] = DEFINED pvalue
def $callable_return_source_value(S, ptask) = eps -- otherwise
dec $callable_return_source_pending(ptask, nat) : ptask
def $callable_return_source_pending(CALLABLE_RETURN_SOURCE porigin_function porigin_site pvalue z eps, n) = CALLABLE_RETURN_SOURCE porigin_function porigin_site pvalue z (n)
def $callable_return_source_pending(CALLABLE_RETURN_CV_SOURCE porigin_function porigin_site preqbytes n_cell z eps, n) = CALLABLE_RETURN_CV_SOURCE porigin_function porigin_site preqbytes n_cell z (n)

dec $callable_return_source_valid(pstate, ptask) : bool
def $callable_return_source_valid(S, CALLABLE_RETURN_SOURCE porigin_function porigin_site pvalue z n_pending?) = true
  -- if $callable_return_active(S, porigin_function, porigin_site, z)
  -- if $callable_return_temp_site(S, porigin_function, porigin_site, z)
  -- if $callable_return_value(S, pvalue)
  -- if $callable_return_function(S, porigin_function) = (pfunction)
  -- if ~($typed_exact(pfunction.SIGNATURE.RETURNS, pvalue) \/ $typed_object_exact(S, pfunction.SIGNATURE.RETURNS, pvalue))
  -- if $destructor_pending_valid(S, n_pending?)
  -- if $heap_subset($instance_roots(n_pending?), S.ALLOCATIONS)
def $callable_return_source_valid(S, CALLABLE_RETURN_CV_SOURCE porigin_function porigin_site preqbytes n_cell z n_pending?) = true
  -- if $callable_return_active(S, porigin_function, porigin_site, z)
  -- if $callable_return_cv_site(S, porigin_function, porigin_site, z) = (preqbytes)
  -- if ~$callable_return_cv_protected(S, porigin_site)
  -- if $callable_return_plain_cell(S, preqbytes, n_cell)
  -- if ~(n_cell <- S.REFCELLS)
  -- if S.STORE[n_cell] = DEFINED pvalue
  -- if $callable_return_value(S, pvalue)
  -- if $destructor_pending_valid(S, n_pending?)
  -- if $heap_subset($instance_roots(n_pending?), S.ALLOCATIONS)
def $callable_return_source_valid(S, ptask) = false -- otherwise
def $call_task_valid(S, CALLABLE_RETURN_SOURCE porigin_function porigin_site pvalue z n_pending?) = $callable_return_source_valid(S, CALLABLE_RETURN_SOURCE porigin_function porigin_site pvalue z n_pending?)
def $call_task_valid(S, CALLABLE_RETURN_CV_SOURCE porigin_function porigin_site preqbytes n_cell z n_pending?) = $callable_return_source_valid(S, CALLABLE_RETURN_CV_SOURCE porigin_function porigin_site preqbytes n_cell z n_pending?)
def $task_nodes(CALLABLE_RETURN_SOURCE porigin_function porigin_site pvalue z n_pending?) = $value_nodes(pvalue) ++ $instance_roots(n_pending?)
def $task_nodes(CALLABLE_RETURN_CV_SOURCE porigin_function porigin_site preqbytes n_cell z n_pending?) = $instance_roots(n_pending?)
def $api_source_line(S, ptask_source) = z
