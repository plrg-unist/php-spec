def $callable_protected_ref_quiet(S, porigin_site, n_cell) = false -- otherwise

;; Pure protected returns share plain-cell/source safety, independently of
;; callable admission. The finalized operand remains authoritative after unset.
dec $pure_ref_untyped_name(psparam*, preqbytes) : bool
def $pure_ref_untyped_name(eps, preqbytes) = true
def $pure_ref_untyped_name(psparam :: psparam_tail*, preqbytes) = ((psparam.NAME =/= preqbytes \/ psparam.TYPE = eps) /\ $pure_ref_untyped_name(psparam_tail*, preqbytes))
def $pure_ref_scope(S, porigin_site, porigin_owner, z) = true
  -- if S.CURRENT = (pcallcontext)
  -- if $function_at(S.FUNCTIONS, pcallcontext.FUNCTION) = (pfunction)
  -- if $callable_return_function(S, pcallcontext.FUNCTION) = (pfunction)
  -- if $callable_return_frame(S, pcallcontext.FUNCTION)
  -- if pfunction.SIGNATURE.BYREF /\ ~$function_generator(S, pfunction)
  -- if porigin_site = PORIGIN n_unit pcpath_site
  -- if n_unit = pfunction.CODE.UNIT
  -- if $origin_node(S.SOURCES, porigin_site) = (NStmtReturn (NExprVariable (BYTES text) metadata_variable) metadata)
  -- if $cv_name(BYTES text) = (preqbytes)
  -- if preqbytes <- pfunction.CVS
  -- if $pure_ref_untyped_name(pfunction.SIGNATURE.PARAMETERS, preqbytes)
  -- if $code_expression(pfunction.CODE.EXPRESSIONS, pcpath_site) = ((z, false))
  -- if n_body = |pfunction.BODY|
  -- if $(n_body <= |pcpath_site|) /\ pcpath_site[0:n_body] = pfunction.BODY
  -- if $source_unit(S.SOURCES, n_unit) = (pcunit)
  -- if $ppfinally_protected(pcunit.OCCURRENCES, pcpath_site) = [pcpath_owner]
  -- if porigin_owner = PORIGIN n_unit pcpath_owner
  -- if ~$ref_replay_from_finalizer(S, porigin_site)
  -- if $callable_return_finally_safe(S, porigin_site)
dec $pure_ref_reverse(nat, pcpath*) : porigin*
def $pure_ref_reverse(n_unit, eps) = eps
def $pure_ref_reverse(n_unit, pcpath :: pcpath_tail*) = $pure_ref_reverse(n_unit, pcpath_tail*) ++ [PORIGIN n_unit pcpath]
def $pure_ref_owners(S, PORIGIN n_unit pcpath_site) = $pure_ref_reverse(n_unit, $ppfinally_protected(pcunit.OCCURRENCES, pcpath_site))
  -- if $source_unit(S.SOURCES, n_unit) = (pcunit)
def $pure_ref_pair(S, porigin_site) = ((porigin_inner, $pure_ref_last_owner(porigin_next, porigin_tail*)))
  -- if $pure_ref_owners(S, porigin_site) = porigin_inner :: porigin_next :: porigin_tail*
def $pure_ref_multi(S, porigin_site, porigin_inner, porigin_outer, z) = true
  -- if S.CURRENT = (pcallcontext)
  -- if $function_at(S.FUNCTIONS, pcallcontext.FUNCTION) = (pfunction)
  -- if $callable_return_function(S, pcallcontext.FUNCTION) = (pfunction)
  -- if $callable_return_frame(S, pcallcontext.FUNCTION)
  -- if pfunction.SIGNATURE.BYREF /\ ~$function_generator(S, pfunction)
  -- if $ptmasks(pfunction.SIGNATURE.RETURNS) = ["int"]
  -- if porigin_site = PORIGIN n_unit pcpath_site
  -- if n_unit = pfunction.CODE.UNIT
  -- if $origin_node(S.SOURCES, porigin_site) = (NStmtReturn (NExprVariable (BYTES text) metadata_variable) metadata)
  -- if $cv_name(BYTES text) = (preqbytes)
  -- if preqbytes <- pfunction.CVS
  -- if $pure_ref_untyped_name(pfunction.SIGNATURE.PARAMETERS, preqbytes)
  -- if $code_expression(pfunction.CODE.EXPRESSIONS, pcpath_site) = ((z, false))
  -- if n_body = |pfunction.BODY|
  -- if $(n_body <= |pcpath_site|) /\ pcpath_site[0:n_body] = pfunction.BODY
  -- if $pure_ref_pair(S, porigin_site) = ((porigin_inner, porigin_outer))
  -- if ~$ref_replay_from_finalizer(S, porigin_site)
  -- if $callable_return_finally_safe(S, porigin_site)
def $pure_ref_scope(S, porigin_site, porigin_inner, z) = true
  -- if $pure_ref_pair(S, porigin_site) = ((porigin_inner, porigin_outer))
  -- if $pure_ref_multi(S, porigin_site, porigin_inner, porigin_outer, z)
def $pure_ref_cell(S, n_cell) = $callable_protected_ref_cell(S, n_cell)
dec $pure_ref_scalar_quiet(pstate, porigin, nat) : bool
def $pure_ref_quiet(S, porigin_site, n_cell) = ($callable_protected_ref_quiet(S, porigin_site, n_cell) \/ $pure_ref_scalar_quiet(S, porigin_site, n_cell) \/ $pure_ref_multi_quiet(S, porigin_site, n_cell))

;; Initial verification of an exact int return establishes a primitive cell
;; before its finalizer. One literal scalar write cannot release an owning value.
dec $pure_ref_scalar(pstate, nat) : bool
def $pure_ref_scalar(S, n_cell) = true
  -- if S.CURRENT = (pcallcontext)
  -- if $function_at(S.FUNCTIONS, pcallcontext.FUNCTION) = (pfunction)
  -- if $ptmasks(pfunction.SIGNATURE.RETURNS) = ["int"]
