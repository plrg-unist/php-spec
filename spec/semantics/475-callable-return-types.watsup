;; A failed second check releases the one MAKE_REF temporary before replaying
;; the completed try/catch. Replay carries source context, never a retired cell.
def $pure_ref_reject(S, porigin_source, n_cell, z) = $destructor_release_begin(S_throw, [DESTRUCTION_VALUE (HCELL n_cell)])
  -- if S.TODO = [RETURN_REF_UNWIND (REFERENCE n_cell) z true porigin_source, PURE_REF_RECHECK porigin_source porigin_owner n_cell z]
