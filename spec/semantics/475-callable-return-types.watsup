def $callable_return_cv_start(S, ptask_source, pvalue) = $api_begin(S[.TODO = ptask_source :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], ptask_source, pvalue)
