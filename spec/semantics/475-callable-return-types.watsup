  -- if $class_method_origin(S.CLASSES, pmethoddesc.FUNCTION.ORIGIN) = (pmethoddesc)
def $callable_return_method_known(S, porigin, ptbytes) = true
  -- if $effective_method(S, porigin, ptbytes, |S.CLASSES|) = eps
  -- if ~$array_magic(S, porigin)
def $callable_return_method_known(S, porigin, ptbytes) = false -- otherwise

dec $callable_return_this_known(pstate, nat?) : bool
def $callable_return_this_known(S, eps) = true
def $callable_return_this_known(S, (n)) = true
  -- if $(n < |S.OBJECTS|) /\ (HOBJECT n) <- S.ALLOCATIONS
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $callable_return_class(S, porigin)
  -- if ~$array_magic(S, porigin)
def $callable_return_this_known(S, n?) = false -- otherwise
dec $callable_return_keyword_known(pstate, pvalue, ptbytes) : bool
def $callable_return_keyword_known(S, pvalue_keyword, ptbytes_method) = true
  -- if $api_class(S, pvalue_keyword, $api_frame_scope(S), $api_frame_scope(S), $api_frame_called(S), $api_frame_this(S), eps) = API_CLASS papiclass
  -- if $callable_return_class(S, papiclass.REQUESTED) /\ $callable_return_class(S, papiclass.CALLED)
  -- if $callable_return_this_known(S, papiclass.RECEIVER)
  -- if ~$array_magic(S, papiclass.REQUESTED)
  -- if $callable_return_method_known(S, papiclass.REQUESTED, ptbytes_method)
def $callable_return_keyword_known(S, pvalue_keyword, ptbytes_method) = true
  -- if $api_class(S, pvalue_keyword, $api_frame_scope(S), $api_frame_scope(S), $api_frame_called(S), $api_frame_this(S), eps) = API_CLASS_INVALID ptbytes_error
def $callable_return_keyword_known(S, pvalue_keyword, ptbytes_method) = false -- otherwise

;; The captured array and reference item remain structural through a handler.
;; Admission checks the initial leaf; resumed eligibility belongs to the cursor.
dec $callable_return_keyword_array(pstate, pvalue) : bool
def $callable_return_keyword_array(S, PARRAY n) = true
  -- if $unpack_container_valid(S, KNOWN (PARRAY n))
  -- if |S.ARRAYS[n].ITEMS| = 2
  -- if $entry_lookup(S.ARRAYS[n].ITEMS, KINT 0) = (DIRECT pvalue_keyword)
  -- if $string_bytes(pvalue_keyword) = (ptbytes_class)
  -- if $api_keyword(ptbytes_class)
  -- if $entry_lookup(S.ARRAYS[n].ITEMS, KINT 1) = (pitem_method)
def $callable_return_keyword_array(S, pvalue) = false -- otherwise

dec $callable_return_array(pstate, pvalue) : bool
def $callable_return_array(S, PARRAY n) = true
  -- if $unpack_container_valid(S, KNOWN (PARRAY n))
  -- if |S.ARRAYS[n].ITEMS| = 2
  -- if $entry_lookup(S.ARRAYS[n].ITEMS, KINT 0) = (DIRECT pvalue_receiver)
  -- if $callable_return_receiver(S, pvalue_receiver) =/= eps
  -- if $entry_lookup(S.ARRAYS[n].ITEMS, KINT 1) = (pitem_method)
def $callable_return_array(S, pvalue) = false -- otherwise

dec $callable_return_value(pstate, pvalue) : bool
def $callable_return_value(S, pvalue) = ($callable_return_array(S, pvalue) \/ $callable_return_keyword_array(S, pvalue) \/ $callable_return_word(pvalue) =/= eps)

dec $callable_return_input(pstate, pvalue) : bool
def $callable_return_input(S, PARRAY n) = true
  -- if $callable_return_array(S, PARRAY n)
  -- if $entry_lookup(S.ARRAYS[n].ITEMS, KINT 0) = (DIRECT pvalue_receiver)
  -- if $callable_return_receiver(S, pvalue_receiver) = (porigin_receiver)
  -- if $entry_lookup(S.ARRAYS[n].ITEMS, KINT 1) = (pitem_method)
