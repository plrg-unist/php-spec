  -- if $api_query_valid(S_check, papiquery, n_phase) /\ $throwable_live(S, n)
  -- if ptask_source = $callable_return_source_pending(papiquery.SOURCE, n)
  -- if S_reject = S[.TODO = (API_CALLABLE_RESULT (papiquery[.SOURCE = ptask_source]) n_phase) :: ptask_tail*]
def $identity_read_discard(S, API_CALLABLE_RESULT papiquery 1) = S[.TODO = (API_CALLABLE_RESULT (papiquery[.SOURCE = $callable_return_source_pending(papiquery.SOURCE, n)]) 1) :: ptask_tail*]
  -- if $callable_return_source_identity(papiquery.SOURCE) = ((porigin_function, porigin_site, z, eps))
