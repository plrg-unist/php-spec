def $callable_return_unused(S) = false -- otherwise
def $callable_return_success(S, CALLABLE_RETURN_CV_SOURCE porigin_function porigin_site preqbytes n_cell z n_pending?) = $callable_return_cv_unwind(S_move, porigin_function, porigin_site, z, n_pending?, pvalue)
