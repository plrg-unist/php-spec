;; Only an exact canonical declared prefix has the demonstrated CE cache fast
;; path while an earlier exception suppresses callback entry. The outer object
;; is still genuinely live; a published name alone is not this cache proof.
dec $callable_protected_ref_canonical(pstate, pvalue) : bool
def $callable_protected_ref_canonical(S, PARRAY n_array) = true
  -- if $callable_return_array(S, PARRAY n_array) /\ $callable_return_input(S, PARRAY n_array)
  -- if $entry_lookup(S.ARRAYS[n_array].ITEMS, KINT 0) = (DIRECT (POBJECT n_receiver))
  -- if $entry_lookup(S.ARRAYS[n_array].ITEMS, KINT 1) = (pitem)
  -- if $string_bytes($entry_value(S, pitem)) = (ptbytes)
  -- if $method_string_parts(ptbytes) = ((ptbytes_class, ptbytes_method))
  -- if $class_named(S.CLASSNAMES, $ptlc(ptbytes_class)) = (porigin_class)
  -- if $class_at(S.CLASSES, porigin_class) = (pclassdesc)
  -- if pclassdesc.NAME = ptbytes_class
  -- if $callable_return_class(S, porigin_class)
def $callable_protected_ref_canonical(S, pvalue) = false -- otherwise
def $callable_protected_ref_prior_ready(S, CALLABLE_PROTECTED_REF_RECHECK porigin_function porigin_site n_cell z eps, pvalue) = true
def $callable_protected_ref_prior_ready(S, CALLABLE_PROTECTED_REF_RECHECK porigin_function porigin_site n_cell z (n), pvalue) = $callable_protected_ref_canonical(S, pvalue)

rule PhpStep/callable-protected-ref-recheck-unsupported: S ~> S[.COMPLETION = UNSUPPORTED "protected callable reference recheck context"]
