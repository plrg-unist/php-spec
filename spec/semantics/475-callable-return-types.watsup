;; A failed unprotected VERIFY leaves the local cell with ENV. Only the real
;; handler Exception transfers to TypeError; the original catch tail survives.
dec $lossy_cv_reject(pstate, ptask, nat, ptask*) : pstate
def $lossy_cv_reject(S, ptask_source, n_pending, ptask_tail*) = $throwable_begin($callable_return_previous(S_new[.TODO = ptask_tail*], n_new, (n_pending)))
