dec $callable_protected_ref_prior_ready(pstate, ptask, pvalue) : bool
rule PhpStep/callable-protected-ref-recheck: S ~> $api_begin(S[.TODO = [ptask_source, ptask_marker]][.ORIGIN = (porigin_site)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], ptask_source, pvalue)
