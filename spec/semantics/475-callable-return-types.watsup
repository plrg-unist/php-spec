  -- if $api_class(S, pvalue_keyword, $api_frame_scope(S), $api_frame_scope(S), $api_frame_called(S), $api_frame_this(S), eps) = API_CLASS_INVALID ptbytes_error
def $callable_return_keyword_known(S, pvalue_keyword, ptbytes_method) = false -- otherwise

;; The captured array and reference item remain structural through a handler.
;; Admission checks the initial leaf; resumed eligibility belongs to the cursor.
