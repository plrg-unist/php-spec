  -- if S.STORE[n_cell] = DEFINED pvalue
  -- if $callable_protected_ref_quiet_value(pvalue)
def $pure_ref_scalar(S, n_cell) = false -- otherwise
def $pure_ref_scalar_conversion(S, n_cell) = (TYPEINTEGER pvalue)
