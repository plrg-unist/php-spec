;; Native unref precedes the second exact-union test. Shared wrappers separate
;; only this local slot; global/saved tables and every other alias stay intact.
dec $callable_return_cv_prepare(pstate, preqbytes, nat) : pstate
def $callable_return_cv_prepare(S, preqbytes, n_cell) = S[.CELL = n_cell]
  -- if ~(n_cell <- S.REFCELLS)
def $callable_return_cv_prepare(S, preqbytes, n_cell) = S[.CELL = n_cell][.REFCELLS = $literal_reference_delete(S.REFCELLS, n_cell)]
  -- if n_cell <- S.REFCELLS
  -- if $heap_owners($heap_graph(S), HCELL n_cell) = 1
def $callable_return_cv_prepare(S, preqbytes, n_cell) = S[.CELL = n_new][.STORE = S.STORE ++ [DEFINED pvalue]][.ENV = (BIND preqbytes n_new) :: $unbind(S.ENV, preqbytes)][.ALLOCATIONS = S.ALLOCATIONS ++ [HCELL n_new]]
  -- if n_cell <- S.REFCELLS
  -- if $($heap_owners($heap_graph(S), HCELL n_cell) > 1)
  -- if S.STORE[n_cell] = DEFINED pvalue
  -- if n_new = |S.STORE|

def $callable_return_class(S, porigin) = true
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
