;; VERIFY_RETURN_TYPE owns a temporary, or borrows the unwrapped local CV.
;; A protected CV has a real QM_ASSIGN temporary; its original slot stays put.
;; The query adds no owner. A pending handler exception is independent.
dec $callable_return_class(pstate, porigin) : bool
dec $callable_return_function(pstate, porigin) : pfunction?
def $callable_return_function(S, porigin_function) = (pfunction)
  -- if $function_at(S.FUNCTIONS, porigin_function) = (pfunction)
  -- if $callable_at(S.CALLABLES, $ptlc(pfunction.NAME)) = (porigin_function)
def $callable_return_function(S, porigin_function) = (pmethoddesc.FUNCTION)
  -- if $function_at(S.FUNCTIONS, porigin_function) = eps
  -- if $class_method_origin(S.CLASSES, porigin_function) = (pmethoddesc)
  -- if pmethoddesc.VISIBILITY = PROPERTY_PUBLIC /\ ~pmethoddesc.ABSTRACT
  -- if ~$ppmethod_magic(pmethoddesc.NAME)
  -- if $callable_return_class(S, pmethoddesc.OWNER)
def $callable_return_function(S, porigin_function) = eps -- otherwise

dec $callable_return_metadata(pstate, porigin, porigin, int) : bool
def $callable_return_metadata(S, porigin_function, porigin_site, z) = true
  -- if $callable_return_function(S, porigin_function) = (pfunction)
  -- if ~pfunction.SIGNATURE.BYREF /\ ~$function_generator(S, pfunction)
  -- if "callable" <- $ptmasks(pfunction.SIGNATURE.RETURNS)
  -- if porigin_site = PORIGIN n_unit pcpath_site
  -- if n_unit = pfunction.CODE.UNIT
  -- if $origin_node(S.SOURCES, porigin_site) = (NStmtReturn expression metadata)
  -- if $code_expression(pfunction.CODE.EXPRESSIONS, pcpath_site) = ((z, false))
  -- if n_body = |pfunction.BODY|
  -- if $(n_body <= |pcpath_site|) /\ pcpath_site[0:n_body] = pfunction.BODY
def $callable_return_metadata(S, porigin_function, porigin_site, z) = false -- otherwise

;; Immutable descriptors remain valid after creator This retirement. Only this
;; separate active proof consults the actual target, receiver and caller site.
dec $callable_return_method_site(pstate, pcalltarget, pmethoddesc, porigin) : bool
def $callable_return_method_site(S, METHOD_TARGET n porigin_method, pmethoddesc, porigin_site) = true
  -- if ~pmethoddesc.STATIC /\ pmethoddesc.FUNCTION.ORIGIN = porigin_method
  -- if $origin_node(S.SOURCES, porigin_site) = (NExprMethodCall expression_receiver (NIdentifier (BYTES text) metadata_name) (SEQUENCE phpType7*) metadata)
  -- if $method_source_name(NIdentifier (BYTES text) metadata_name, pmethoddesc.NAME)
  -- if $method_call_origin_valid(S, n, pmethoddesc, porigin_site)
def $callable_return_method_site(S, SCOPED_TARGET porigin_requested porigin_method porigin_called eps (KNOWN pvalue_selector), pmethoddesc, porigin_site) = true
  -- if pmethoddesc.STATIC /\ pmethoddesc.FUNCTION.ORIGIN = porigin_method
  -- if $origin_node(S.SOURCES, porigin_site) = (NExprStaticCall phpType19 (NIdentifier (BYTES text) metadata_name) (SEQUENCE phpType7*) metadata)
  -- if $ppscoped_named(phpType19) /\ ~$ppscoped_keyword(phpType19)
  -- if $method_source_name(NIdentifier (BYTES text) metadata_name, pmethoddesc.NAME)
  -- if $scoped_call_live_scope(S, SCOPED_TARGET porigin_requested porigin_method porigin_called eps (KNOWN pvalue_selector), porigin_site, phpType19, pmethoddesc)
def $callable_return_method_site(S, pcalltarget, pmethoddesc, porigin_site) = false -- otherwise

dec $callable_return_method_frame(pstate, porigin) : bool
def $callable_return_method_frame(S, porigin_function) = true
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.FUNCTION = porigin_function
  -- if $class_method_origin(S.CLASSES, porigin_function) = (pmethoddesc)
  -- if $callable_return_function(S, porigin_function) = (pmethoddesc.FUNCTION)
  -- if $target_function(S, pcallcontext.TARGET) = (pmethoddesc.FUNCTION)
  -- if pcallcontext.LEXICAL_CLASS = $target_lexical_class(S, pcallcontext.TARGET)
  -- if pcallcontext.CALLED_CLASS = $target_called_class(S, pcallcontext.TARGET)
  -- if pcallcontext.RECEIVER = $target_receiver(S, pcallcontext.TARGET)
  -- if pcallcontext.INSTANCE = eps
  -- if pcallcontext.CALLSITE = (porigin_call)
  -- if $callable_return_method_site(S, pcallcontext.TARGET, pmethoddesc, porigin_call)
  -- if ~$generator_active(S)
def $callable_return_method_frame(S, porigin_function) = false -- otherwise

dec $callable_return_frame(pstate, porigin) : bool
def $callable_return_frame(S, porigin_function) = true
  -- if $function_at(S.FUNCTIONS, porigin_function) =/= eps
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.TARGET = porigin_function /\ pcallcontext.FUNCTION = porigin_function
  -- if pcallcontext.LEXICAL_CLASS = eps /\ pcallcontext.CALLED_CLASS = eps
  -- if pcallcontext.RECEIVER = eps /\ pcallcontext.INSTANCE = eps
  -- if ~$generator_active(S)
def $callable_return_frame(S, porigin_function) = true
  -- if $callable_return_method_frame(S, porigin_function)
def $callable_return_frame(S, porigin_function) = false -- otherwise
dec $callable_return_active(pstate, porigin, porigin, int) : bool
def $callable_return_active(S, porigin_function, porigin_site, z) = ($callable_return_metadata(S, porigin_function, porigin_site, z) /\ $callable_return_frame(S, porigin_function) /\ S.ORIGIN = (porigin_site))

