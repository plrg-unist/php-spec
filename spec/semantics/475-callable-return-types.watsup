dec $callable_protected_ref_ready(pstate, porigin, nat, nat?) : bool
def $callable_protected_ref_ready(S, porigin_site, n_cell, n_fresh?) = ($callable_protected_ref_quiet(S, porigin_site, n_cell) /\ (n_fresh? = eps \/ (S.OUTPUTBUFFERS = eps /\ ~S.OUTPUTBLOCKED /\ S.TICKENTRIES = eps)))
dec $callable_protected_ref_success(pstate, ptask) : pstate
def $callable_protected_ref_success(S, CALLABLE_PROTECTED_REF_SOURCE porigin_function porigin_site n_cell pvalue z 0 n_fresh?) = S[.TODO = (RETURN_REF_UNWIND (REFERENCE n_cell) z false porigin_site) :: (ptask_tail* ++ [CALLABLE_PROTECTED_REF_RECHECK porigin_function porigin_site n_cell z n_fresh?])][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)][.HELD = eps]
  -- if S.TODO = ptask :: ptask_tail*
  -- if $callable_protected_ref_ready(S, porigin_site, n_cell, n_fresh?)
def $callable_protected_ref_success(S, CALLABLE_PROTECTED_REF_SOURCE porigin_function porigin_site n_cell pvalue z 0 n_fresh?) = S[.COMPLETION = UNSUPPORTED "protected callable reference quiet finally"]
  -- if ~$callable_protected_ref_ready(S, porigin_site, n_cell, n_fresh?)
def $callable_protected_ref_success(S, CALLABLE_PROTECTED_REF_SOURCE porigin_function porigin_site n_cell pvalue z 1 eps) = S[.TODO = [RETURN_UNWIND (REFERENCE n_cell) (porigin_site), ptask_marker]][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)][.HELD = eps]
  -- if $callable_protected_ref_marker(S.TODO) = (ptask_marker)
