  -- if $origin_node(S.SOURCES, PORIGIN n_unit (pcpath ++ [PCFIELD 2])) = (NStmtFinally (SEQUENCE statement*) metadata)
  -- if $callable_protected_ref_quiet_stmts(S, preqbytes, n_cell, false, statement*)
def $callable_protected_ref_quiet_regions(S, n_unit, preqbytes, n_cell, pcpath*) = false -- otherwise
dec $callable_protected_ref_quiet(pstate, porigin, nat) : bool
def $callable_protected_ref_quiet(S, PORIGIN n_unit pcpath, n_cell) = true
