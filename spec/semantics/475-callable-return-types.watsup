  -- if S_new.COMPLETION = THROWING n_new
def $identity_read_discard(S, LOSSY_REF_CV_RETURN porigin_site preqbytes n_cell n_bits i z) = $lossy_cv_reject(S, LOSSY_REF_CV_RETURN porigin_site preqbytes n_cell n_bits i z, n_pending, ptask_tail*)
