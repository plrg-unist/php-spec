  -- if ~$ref_replay_from_finalizer(S, porigin_site)
def $callable_return_cv_site(S, porigin_function, porigin_site, z) = eps -- otherwise
dec $callable_return_cv_protected(pstate, porigin) : bool
def $callable_return_cv_protected(S, PORIGIN n pcpath) = ($ppfinally_protected(pcunit.OCCURRENCES, pcpath) =/= eps)
  -- if $source_unit(S.SOURCES, n) = (pcunit)
def $callable_return_cv_protected(S, porigin) = false -- otherwise
dec $callable_return_temp_site(pstate, porigin, porigin, int) : bool
def $callable_return_temp_site(S, porigin_function, porigin_site, z) = true
  -- if $callable_return_metadata(S, porigin_function, porigin_site, z)
  -- if $callable_return_direct_site(S, porigin_site)
def $callable_return_temp_site(S, porigin_function, porigin_site, z) = true
  -- if $callable_return_cv_site(S, porigin_function, porigin_site, z) =/= eps
  -- if $callable_return_cv_protected(S, porigin_site)
def $callable_return_temp_site(S, porigin_function, porigin_site, z) = false -- otherwise

dec $callable_return_typed_formal(pstate, psparam*, nat) : bool
def $callable_return_typed_formal(S, eps, n_cell) = false
def $callable_return_typed_formal(S, psparam :: psparam_tail*, n_cell) = true
  -- if psparam.TYPE =/= eps /\ $lookup(S.ENV, psparam.NAME) = (n_cell)
def $callable_return_typed_formal(S, psparam :: psparam_tail*, n_cell) = $callable_return_typed_formal(S, psparam_tail*, n_cell)
  -- if psparam.TYPE = eps \/ $lookup(S.ENV, psparam.NAME) =/= (n_cell)
dec $callable_return_plain_cell(pstate, preqbytes, nat) : bool
def $callable_return_plain_cell(S, preqbytes, n_cell) = true
  -- if preqbytes <- S.CVS /\ ~$environment_blocked(S, preqbytes)
  -- if $lookup(S.ENV, preqbytes) = (n_cell)
  -- if $(n_cell < |S.STORE|) /\ (HCELL n_cell) <- S.ALLOCATIONS
  -- if S.STORE[n_cell] = DEFINED pvalue
  -- if $propref_at(S.PROPREFS, n_cell) = eps
  -- if $reference_coercion_at(S.REFCOERCIONS, n_cell) = eps
  -- if $parameter_backing_at(S.PARAMETERBACKINGS, n_cell) = eps
  -- if $container_init_at(S.CONTAINERINITS, n_cell) = eps
  -- if ~(n_cell <- S.LITERALREFDEBTS) /\ ~(n_cell <- S.LITERALREFRETAINED)
  -- if ~$foreach_released_cell(S, n_cell) /\ ~$foreach_released_container_cell(S, n_cell)
  -- if ~$typed_cv_string_released_cell(S, n_cell) /\ ~$update_released_cell(S, n_cell)
  -- if ~$update_released_array_name(S, preqbytes)
  -- if S.CURRENT = (pcallcontext)
  -- if $callable_return_function(S, pcallcontext.FUNCTION) = (pfunction)
  -- if ~$callable_return_typed_formal(S, pfunction.SIGNATURE.PARAMETERS, n_cell)
def $callable_return_plain_cell(S, preqbytes, n_cell) = false -- otherwise

;; Native unref precedes the second exact-union test. Shared wrappers separate
;; only this local slot; global/saved tables and every other alias stay intact.
dec $callable_return_cv_prepare(pstate, preqbytes, nat) : pstate
def $callable_return_cv_prepare(S, preqbytes, n_cell) = S[.CELL = n_cell]
  -- if ~(n_cell <- S.REFCELLS)
def $callable_return_cv_prepare(S, preqbytes, n_cell) = S[.CELL = n_cell][.REFCELLS = $literal_reference_delete(S.REFCELLS, n_cell)]
  -- if n_cell <- S.REFCELLS
  -- if $heap_owners($heap_graph(S), HCELL n_cell) = 1
def $callable_return_cv_prepare(S, preqbytes, n_cell) = S[.CELL = n_new][.STORE = S.STORE ++ [DEFINED pvalue]][.ENV = (BIND preqbytes n_new) :: $unbind(S.ENV, preqbytes)][.ALLOCATIONS = S.ALLOCATIONS ++ [HCELL n_new]]
  -- if n_cell <- S.REFCELLS
  -- if $($heap_owners($heap_graph(S), HCELL n_cell) > 1)
  -- if S.STORE[n_cell] = DEFINED pvalue
  -- if n_new = |S.STORE|

def $callable_return_class(S, porigin) = true
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if pclassdesc.KIND = "class" /\ ~$class_internal(pclassdesc.NAME)
  -- if $class_named(S.CLASSNAMES, $ptlc(pclassdesc.NAME)) = (porigin)
  -- if $class_links_valid(S)
def $callable_return_class(S, porigin) = false -- otherwise

dec $callable_return_receiver(pstate, pvalue) : porigin?
def $callable_return_receiver(S, pvalue) = (porigin)
  -- if $string_bytes(pvalue) = (ptbytes)
  -- if ~(0 <- ptbytes) /\ ~$api_keyword(ptbytes)
  -- if $class_named(S.CLASSNAMES, $ptlc($typed_callable_name(ptbytes))) = (porigin)
  -- if $callable_return_class(S, porigin)
def $callable_return_receiver(S, POBJECT n) = (porigin)
  -- if $(n < |S.OBJECTS|) /\ HOBJECT n <- S.ALLOCATIONS
  -- if S.OBJECTS[n] = INSTANCE porigin
  -- if $callable_return_class(S, porigin)
def $callable_return_receiver(S, pvalue) = eps -- otherwise

dec $callable_return_method_known(pstate, porigin, ptbytes) : bool
def $callable_return_method_known(S, porigin, ptbytes) = true
