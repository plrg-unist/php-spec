def $callable_return_input(S, PARRAY n) = true
  -- if $callable_return_keyword_array(S, PARRAY n)
  -- if $entry_lookup(S.ARRAYS[n].ITEMS, KINT 0) = (DIRECT pvalue_keyword)
  -- if $entry_lookup(S.ARRAYS[n].ITEMS, KINT 1) = (pitem_method)
  -- if $string_bytes($entry_value(S, pitem_method)) = (ptbytes_method)
  -- if ~(0 <- ptbytes_method) /\ $method_string_parts(ptbytes_method) = eps
  -- if $callable_return_keyword_known(S, pvalue_keyword, ptbytes_method)
def $callable_return_input(S, pvalue) = true
  -- if $callable_return_word(pvalue) = ((ptbytes_class, ptbytes_method))
  -- if $callable_return_keyword_known(S, PSTRING ptbytes_class, ptbytes_method)
def $callable_return_input(S, pvalue) = false -- otherwise

dec $callable_return_candidate(pstate, int) : bool
def $callable_return_candidate(S, z) = true
  -- if S.TODO = (RETURN_VALUE z) :: ptask_tail*
  -- if S.CURRENT = (pcallcontext)
  -- if S.ORIGIN = (porigin_site)
  -- if $callable_return_active(S, pcallcontext.FUNCTION, porigin_site, z)
  -- if $callable_return_direct_site(S, porigin_site)
  -- if S_read = $resolve_at(S, S.RESULT, z)
  -- if S_read.COMPLETION = NORMAL
  -- if S_read.RESULT = KNOWN pvalue
  -- if $callable_return_input(S_read, pvalue)
  -- if $callable_return_function(S, pcallcontext.FUNCTION) = (pfunction)
  -- if $typed_reference_conversion(S_read, pfunction.SIGNATURE.RETURNS, pvalue, pfunction.CODE.STRICT, false) = TYPEDEPENDENT "deprecated callable admission continuation"
def $callable_return_candidate(S, z) = false -- otherwise
def $typed_return_callback_candidate(S, z) = true -- if $callable_return_candidate(S, z)

dec $callable_return_cv_candidate(pstate, int) : bool
def $callable_return_cv_candidate(S, z) = true
  -- if S.TODO = (RETURN_VALUE z) :: ptask_tail*
  -- if S.CURRENT = (pcallcontext)
  -- if S.ORIGIN = (porigin_site)
  -- if $callable_return_active(S, pcallcontext.FUNCTION, porigin_site, z)
