  -- if $pure_ref_scalar_stmts(S, preqbytes, n_cell, statement*)
def $pure_ref_scalar_quiet(S, porigin_site, n_cell) = false -- otherwise
dec $pure_ref_quiet_owners(pstate, preqbytes, nat, porigin*) : bool
def $pure_ref_quiet_owners(S, preqbytes, n_cell, eps) = true
def $pure_ref_quiet_owners(S, preqbytes, n_cell, (PORIGIN n_unit pcpath) :: porigin_tail*) = $pure_ref_quiet_owners(S, preqbytes, n_cell, porigin_tail*)
  -- if $origin_node(S.SOURCES, PORIGIN n_unit (pcpath ++ [PCFIELD 2])) = (NStmtFinally (SEQUENCE statement*) metadata)
  -- if $pure_ref_scalar_stmts(S, preqbytes, n_cell, statement*)
def $pure_ref_quiet_owners(S, preqbytes, n_cell, porigin_owner*) = false -- otherwise
def $pure_ref_multi_quiet(S, porigin_site, n_cell) = true
