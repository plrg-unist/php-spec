  -- if $callable_return_function(S, porigin_function) = (pfunction)
  -- if S_new = $throwable_materialize($throw_scalar(S[.TODO = ptask_tail*], "TypeError", $return_function_name(S, pfunction) ++ $ptascii("(): Return value must be of type ") ++ $pttypename(pfunction.SIGNATURE.RETURNS) ++ $ptascii(", ") ++ $typed_given(S, pvalue) ++ $ptascii(" returned"), z))
  -- if S_new.COMPLETION = THROWING n_new
def $api_finish(S, ptask_source, pvalue, HANDLERINVALID ptbytes) = $callable_return_reject(S, ptask_source)
  -- if $callable_return_source_identity(ptask_source) =/= eps
def $api_throw(S, papiquery, ptbytes_method, ptbytes) = S[.COMPLETION = UNSUPPORTED "callable return method metadata"]
  -- if $callable_return_source_identity(papiquery.SOURCE) =/= eps

;; A keyword class warning fails callable checking if its handler throws.
;; Compound-member warnings instead resume the existing method extraction.
def $identity_read_discard(S, API_CALLABLE_RESULT papiquery n_phase) = $callable_return_reject(S_reject, ptask_source)
  -- if $callable_return_source_identity(papiquery.SOURCE) = ((porigin_function, porigin_site, z, eps))
  -- if $callable_return_class_notice(papiquery, n_phase)
