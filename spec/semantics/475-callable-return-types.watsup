  -- if S_move = S[.STORE = $set_cell(S.STORE, n_cell, DEFINED PNULL)]
def $callable_return_success(S, CALLABLE_RETURN_CV_SOURCE porigin_function porigin_site preqbytes n_cell z n_pending?) = $callable_return_cv_unwind(S, porigin_function, porigin_site, z, n_pending?, PNULL)
  -- if $callable_return_unused(S)
def $callable_return_cv_unwind(S, porigin_function, porigin_site, z, eps, pvalue) = S[.TODO = (RETURN_UNWIND (KNOWN pvalue) (porigin_site)) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = ptask :: ptask_tail*
def $callable_return_cv_unwind(S, porigin_function, porigin_site, z, (n), pvalue) = S[.TODO = (RETURN_UNWIND (KNOWN pvalue) (porigin_site)) :: (ptask_tail* ++ [CALLABLE_RETURN_PENDING porigin_function porigin_site z n])][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = ptask :: ptask_tail*
def $api_finish(S, ptask_source, pvalue, HANDLERRESOLVED pcalltarget) = $callable_return_success(S, ptask_source)
  -- if $callable_return_source_identity(ptask_source) =/= eps
