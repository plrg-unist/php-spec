  -- if $declaration_invocation(S, pfunction, porigin_site, (porigin_lexical), (porigin_called), pdeclcalls)
  -- if preceivebirth.CACHE_OWNER =/= eps /\ $default_cache_birth_valid(S, preceivebirth)
def $parameter_receive_scoped_entry(S, preceivebirth) = false -- otherwise
def $parameter_receive_closure_entry(S, preceivebirth) = $parameter_receive_scoped_entry(S, preceivebirth)
  -- if preceivebirth.CAUSE.CALLS = (preceivebirth.FUNCTION, preceivebirth.CALLSITE, porigin_entry_lexical?, porigin_entry_called?) :: pdeclcalls
  -- if porigin_entry_lexical? =/= eps
  -- if preceivebirth.CALLSITE = (porigin_site)
  -- if ~$closure_call_copy_site(S, porigin_site)

;; This immutable classification survives pruning of live binding rows. It
;; identifies the new scoped-private slice, never invents a receiver object.
dec $scoped_private_cache_owner(pstate, nat) : bool
def $scoped_private_cache_owner(S, n) = true
  -- if $(n < |S.OBJECTS|)
  -- if S.OBJECTS[n] = REALCLOSURE porigin pitem* pstaticcell*
  -- if $function_at(S.CLOSURETEMPLATES, porigin) = (pfunction)
  -- if $parameter_scoped_source(S, pfunction)
  -- if $closure_cache_at(S.CLOSURECACHES, n) = (pclosurecache)
  -- if pclosurecache.FUNCTION = porigin /\ pclosurecache.CACHE = (CACHE_PRIVATE n)
  -- if pclosurecache.SCOPE = (BIND_CLASS porigin_lexical)
  -- if $class_at(S.CLASSES, porigin_lexical) = (pclassdesc)
  -- if pclassdesc.KIND = "class"
def $scoped_private_cache_owner(S, n) = false -- otherwise
def $destruction_child_jobs(S, HOBJECT n) = $destruction_values($closure_items_nodes(pitem*) ++ $static_roots(pstaticcell*)) ++ [DESTRUCTION_PRIVATE_CACHE n] ++ $destruction_values($closure_scope_roots(S.CLOSURESCOPES, n) ++ $binding_receiver_roots(S.CLOSUREBINDINGS, n))
  -- if $scoped_private_cache_owner(S, n)
  -- if S.OBJECTS[n] = REALCLOSURE porigin pitem* pstaticcell*

def $destruction_plain_job(DESTRUCTION_PRIVATE_CACHE n) = false
def $destruction_job_node(DESTRUCTION_PRIVATE_CACHE n) = eps
def $destruction_job_nodes((DESTRUCTION_PRIVATE_CACHE n) :: pdestructionjob*) = $destruction_job_nodes(pdestructionjob*)
def $gc_temporary_nodes((DESTRUCTION_PRIVATE_CACHE n) :: pdestructionjob*) = $gc_temporary_nodes(pdestructionjob*)
def $destruction_release_walk(H, (DESTRUCTION_PRIVATE_CACHE n) :: pdestructionjob*, pnode_done*) = $destruction_release_walk(H, pdestructionjob*, pnode_done*)
def $gc_release_walk(S, H, (DESTRUCTION_PRIVATE_CACHE n) :: pdestructionjob*, pnode_done*) = $gc_release_walk(S, H, pdestructionjob*, pnode_done*)
def $gc_release_walk_keep(H, (DESTRUCTION_PRIVATE_CACHE n) :: pdestructionjob*, pnode_done*, pnode_keep*) = $gc_release_walk_keep(H, pdestructionjob*, pnode_done*, pnode_keep*)
def $destructor_jobs_valid(S, (DESTRUCTION_PRIVATE_CACHE n) :: pdestructionjob*) = true
  -- if $scoped_private_cache_owner(S, n)
  -- if $destructor_jobs_valid(S, [DESTRUCTION_HANDLE n])
  -- if (DESTRUCTION_HANDLE n) <- pdestructionjob*
  -- if $destructor_jobs_valid(S, pdestructionjob*)
rule PhpStep/destructor-private-cache-free: S ~> $destructor_release_replace($private_default_cache_drop(S, HOBJECT n), pdestructionrelease[.JOBS = pdestructionjob*])
  -- if S.TODO = (DESTRUCTOR_RELEASE pdestructionrelease) :: ptask_tail*
  -- if $destructor_release_valid(S, pdestructionrelease)
  -- if pdestructionrelease.JOBS = (DESTRUCTION_PRIVATE_CACHE n) :: pdestructionjob*

dec $scoped_cache_marker(pdestructionjob*, nat) : bool
def $scoped_cache_marker(eps, n) = false
def $scoped_cache_marker((DESTRUCTION_PRIVATE_CACHE n) :: pdestructionjob*, n) = true
def $scoped_cache_marker(pdestructionjob :: pdestructionjob_tail*, n) = $scoped_cache_marker(pdestructionjob_tail*, n)
  -- if pdestructionjob =/= DESTRUCTION_PRIVATE_CACHE n
dec $scoped_cache_releases(pstate, pdestructionrelease*, nat) : bool
def $scoped_cache_releases(S, eps, n) = false
def $scoped_cache_releases(S, pdestructionrelease :: pdestructionrelease_tail*, n) = (($scoped_cache_marker(pdestructionrelease.JOBS, n) /\ $destructor_release_live(S, pdestructionrelease)) \/ $scoped_cache_releases(S, pdestructionrelease_tail*, n))
def $private_default_cache_retired(S, n) = ($gc_retired_valid(S, n) /\ $scoped_cache_releases(S, S.DESTRUCTION.RELEASES, n))
  -- if $scoped_private_cache_owner(S, n)
