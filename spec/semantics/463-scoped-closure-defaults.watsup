;; Direct scoped REAL recipients retain their actual binding/scope receiver.
;; Cache identity remains the immutable455 selected-object stamp.
dec $parameter_scoped_source(pstate, pfunction) : bool
def $parameter_scoped_source(S, pfunction) = true
  -- if $function_at(S.CLOSURETEMPLATES, pfunction.ORIGIN) = (pfunction)
  -- if $origin_node(S.SOURCES, pfunction.ORIGIN) = (NExprClosure phpType14 phpType4_static (BOOLEAN false) phpType16 phpType21 phpType18 phpType23 metadata)
  -- if ~pfunction.SIGNATURE.BYREF /\ ~$function_generator(S, pfunction)
  -- if $parameter_closure_uses(phpType21)
  -- if $parameter_method_parameters(pfunction.SIGNATURE.PARAMETERS)
  -- if $parameter_call_source_scope(S, pfunction.ORIGIN, $closure_source_class(S, pfunction.ORIGIN))
def $parameter_scoped_source(S, pfunction) = false -- otherwise

dec $parameter_scoped_record(pstate, nat) : bool
def $parameter_scoped_record(S, n) = $closure_binding_source_valid(S, pclosurebinding)
  -- if $closure_binding_at(S.CLOSUREBINDINGS, n) = (pclosurebinding)
  -- if $closure_binding_api_site(S, pclosurebinding.SITE)
def $parameter_scoped_record(S, n) = $closure_scope_row_valid(S, pclosurescope)
  -- if $closure_binding_at(S.CLOSUREBINDINGS, n) = eps
  -- if $closure_scope_at(S.CLOSURESCOPES, n) = (pclosurescope)
def $parameter_scoped_record(S, n) = false -- otherwise

dec $parameter_scoped_receiver(pstate, pcallcontext) : bool
def $parameter_scoped_receiver(S, pcallcontext) = true
  -- if pcallcontext.RECEIVER = eps
  -- if pcallcontext.CALLED_CLASS = pcallcontext.LEXICAL_CLASS
def $parameter_scoped_receiver(S, pcallcontext) = true
  -- if pcallcontext.RECEIVER = (n)
  -- if $(n < |S.OBJECTS|) /\ HOBJECT n <- S.ALLOCATIONS
  -- if S.OBJECTS[n] = INSTANCE porigin_called
  -- if pcallcontext.CALLED_CLASS = (porigin_called)
  -- if $class_at(S.CLASSES, porigin_called) = (pclassdesc)
  -- if pclassdesc.KIND = "class"
def $parameter_scoped_receiver(S, pcallcontext) = false -- otherwise

dec $parameter_scoped_current(pstate, pfunction) : bool
def $parameter_scoped_current(S, pfunction) = true
  -- if $parameter_scoped_source(S, pfunction)
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.FUNCTION = pfunction.ORIGIN
  -- if pcallcontext.TARGET = CLOSURE_TARGET n
  -- if pcallcontext.CACHE = eps /\ pcallcontext.INSTANCE = (n)
  -- if $(n < |S.OBJECTS|) /\ HOBJECT n <- S.ALLOCATIONS
  -- if S.OBJECTS[n] = REALCLOSURE pfunction.ORIGIN pitem* pstaticcell*
  -- if $parameter_scoped_record(S, n)
  -- if pcallcontext.LEXICAL_CLASS = (porigin_lexical)
  -- if $class_at(S.CLASSES, porigin_lexical) = (pclassdesc)
  -- if pclassdesc.KIND = "class"
  -- if pcallcontext.LEXICAL_CLASS = $target_lexical_class(S, CLOSURE_TARGET n)
  -- if pcallcontext.CALLED_CLASS = $target_called_class(S, CLOSURE_TARGET n)
  -- if pcallcontext.RECEIVER = $target_receiver(S, CLOSURE_TARGET n)
  -- if $parameter_scoped_receiver(S, pcallcontext)
  -- if $closure_cache_at(S.CLOSURECACHES, n) = (pclosurecache)
  -- if pclosurecache.FUNCTION = pfunction.ORIGIN /\ pclosurecache.SCOPE = (BIND_CLASS porigin_lexical)
  -- if $default_cache_owner(S) =/= eps
  -- if $receiving_function(S, pfunction.ORIGIN) = (pfunction)
def $parameter_scoped_current(S, pfunction) = false -- otherwise
def $parameter_closure_selected(S, pfunction) = $parameter_scoped_current(S, pfunction)
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.TARGET = CLOSURE_TARGET n
  -- if pcallcontext.LEXICAL_CLASS =/= eps

dec $parameter_receive_scoped_entry(pstate, preceivebirth) : bool
def $parameter_receive_scoped_entry(S, preceivebirth) = true
  -- if $function_at(S.CLOSURETEMPLATES, preceivebirth.FUNCTION) = (pfunction)
  -- if $parameter_scoped_source(S, pfunction)
  -- if preceivebirth.CAUSE.CALLS = (preceivebirth.FUNCTION, preceivebirth.CALLSITE, porigin_entry_lexical?, porigin_entry_called?) :: pdeclcalls
  -- if porigin_entry_lexical? = (porigin_lexical)
  -- if porigin_entry_called? = (porigin_called)
  -- if $class_at(S.CLASSES, porigin_lexical) = (pclassdesc)
  -- if pclassdesc.KIND = "class"
  -- if $class_at(S.CLASSES, porigin_called) = (pclassdesc_called)
  -- if pclassdesc_called.KIND = "class"
  -- if preceivebirth.CALLSITE = (porigin_site)
  -- if $origin_node(S.SOURCES, porigin_site) = (NExprFuncCall expression (SEQUENCE phpType7*) metadata)
  -- if ~$ppfirstclass(phpType7*)
