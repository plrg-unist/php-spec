def $foreach_aggregate_nodes(pforeachaggregate, text) = $operand_nodes(pforeachaggregate.CURRENT) ++ $foreach_aggregate_data_nodes(pforeachaggregate.OBJECT, $foreach_aggregate_data(text)) ++ $fiber_traversal_acquisition_nodes(pforeachaggregate.ACQUIRED) ++ $operand_nodes(pforeachaggregate.INPUT)
