def $foreach_aggregate_error_clear(text) = "current" -- otherwise

def $foreach_aggregate_ids(eps) = eps
def $foreach_aggregate_ids((n)) = [n]
def $foreach_aggregate_remove(piterator*, eps) = piterator*
