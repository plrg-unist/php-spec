def $destructor_resume_pending(S, pdestructorcall) = S[.TODO = (DESTRUCTOR_RELEASE pdestructionrelease) :: (FOREACH_AGGREGATE pforeachaggregate[.CURRENT = KNOWN (POBJECT n)] $foreach_aggregate_error_stage(text)) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
