def $foreach_aggregate_data_nodes(n, false) = eps
def $task_nodes(FOREACH_AGGREGATE pforeachaggregate text) = $foreach_aggregate_nodes(pforeachaggregate, text)
def $call_task_valid(S, FOREACH_AGGREGATE pforeachaggregate text) = $foreach_aggregate_result_valid(S, pforeachaggregate, text)
def $useriter_task_ids(FOREACH_AGGREGATE pforeachaggregate "generator") = eps
def $useriter_task_ids(FOREACH_AGGREGATE pforeachaggregate text) = $foreach_aggregate_ids(pforeachaggregate.ITERATOR) -- if text =/= "generator"
def $error_task_iterator(FOREACH_AGGREGATE pforeachaggregate text) = $foreach_aggregate_ids(pforeachaggregate.ITERATOR)
def $return_discard(S, FOREACH_AGGREGATE pforeachaggregate text) = $fiber_start_unpack_release(S[.ITERATORS = $foreach_aggregate_remove(S.ITERATORS, pforeachaggregate.ITERATOR)][.ORIGIN = (pforeachaggregate.SITE)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], $foreach_aggregate_nodes(pforeachaggregate, text))
def $error_read_discard(S, FOREACH_AGGREGATE pforeachaggregate "valid-nan") = $return_discard(S, FOREACH_AGGREGATE pforeachaggregate "valid-nan")
  -- if $useriter_nan_unwind_valid(S, FOREACH_AGGREGATE pforeachaggregate "valid-nan")
