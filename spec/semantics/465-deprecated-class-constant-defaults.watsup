;; Owning dependency reads retain the genuine ordinary class-constant binder.
dec $owned_class_constant_source(pstate, pclassconstantdesc) : bool
def $owned_class_constant_source(S, pclassconstantdesc) = true
  -- if ~pclassconstantdesc.FOLDED
  -- if $class_at(S.CLASSES, pclassconstantdesc.OWNER) = (pclassdesc)
  -- if pclassdesc.KIND = "class"
  -- if pclassconstantdesc.OWNER = PORIGIN n_unit pcpath_owner
  -- if pclassconstantdesc.ORIGIN = PORIGIN n_unit pcpath_decl
  -- if |pcpath_decl| = $(|pcpath_owner| + 4)
  -- if pcpath_decl[0:|pcpath_owner|] = pcpath_owner
  -- if pcpath_decl[|pcpath_owner|:4] = [PCFIELD 5, PCINDEX n_group, PCFIELD 3, PCINDEX n_constant]
  -- if pclassconstantdesc.INITIALIZER = PORIGIN n_unit (pcpath_decl ++ [PCFIELD 1])
  -- if $origin_node(S.SOURCES, pclassconstantdesc.OWNER) = (NStmtClass phpType14 (INTEGER int) (NIdentifier (BYTES text_owner) metadata_owner) phpType44 phpType42 phpType23 metadata)
  -- if $origin_node(S.SOURCES, PORIGIN n_unit (pcpath_owner ++ [PCFIELD 5, PCINDEX n_group])) = (NStmtClassConst (SEQUENCE eps) phpType24 phpType18 phpType45 metadata_group)
  -- if $origin_node(S.SOURCES, pclassconstantdesc.ORIGIN) = (NConst (NIdentifier (BYTES text_name) metadata_name) expression metadata_constant)
  -- if pclassconstantdesc.NAME = $base64(text_name)
def $owned_class_constant_source(S, pclassconstantdesc) = false -- otherwise

;; The structural source view avoids recursively validating a saved binder.
dec $owned_class_constant_scope(pstate) : bool
def $owned_class_constant_scope(S) = true
  -- if S.CONSTCONTEXT = (pconstantcontext)
  -- if S.CLASSCONSTANTINIT = pclassconstantcontext :: pclassconstantcontext_tail*
  -- if pconstantcontext.ORIGIN = pclassconstantcontext.DECL
  -- if pconstantcontext.LINE = pclassconstantcontext.LINE
  -- if $class_constant_origin(S.CLASSES, pclassconstantcontext.DECL) = (pclassconstantdesc)
  -- if $owned_class_constant_source(S, pclassconstantdesc)
def $owned_class_constant_scope(S) = false -- otherwise
def $deprecated_constant_class_ast(S, porigin) = true
  -- if $owned_class_constant_scope(S)
  -- if S.CONSTCONTEXT = (pconstantcontext)
  -- if $class_constant_context_valid(S, pconstantcontext)
  -- if $constant_expression_below(S, pconstantcontext.ORIGIN, porigin)
def $deprecated_constant_class_ast(S, porigin) = false -- otherwise

def $constant_binding(S, DEPRECATED_HANDLER_EXIT pdestructioncleanup z ptask_saved*) = [pconstantcontext.ORIGIN]
  -- if $source_operand_suffix(S.TODO, DEPRECATED_HANDLER_EXIT pdestructioncleanup z ptask_saved*, eps)
  -- if $owned_class_constant_scope(S)
  -- if S.CONSTCONTEXT = (pconstantcontext)
  -- if pdestructioncleanup.CONSTCONTEXT = S.CONSTCONTEXT
  -- if pdestructioncleanup.CALLER = S.CURRENT /\ pdestructioncleanup.ORIGIN = S.ORIGIN
  -- if ptask_saved* = (ERROR_HANDLER_RESULT perrorcall) :: ptask_tail*
  -- if pdestructioncleanup.SOURCE = ERROR_HANDLER_RESULT perrorcall
  -- if perrorcall.RESUME = DEPRECATED_CONSTANT_RESULT pdeprecatedconstant
  -- if pdeprecatedconstant.COPIED = eps
  -- if $constant_expression_below(S, pconstantcontext.ORIGIN, pdeprecatedconstant.SITE)
  -- if $constant_bindings(S[.TODO = ptask_saved*], ptask_saved*) = [pconstantcontext.ORIGIN]

;; Full marker and scope validation authenticate this pure continuation view.
def $class_constant_binding(DEPRECATED_HANDLER_EXIT pdestructioncleanup z ptask_saved*) = $class_constant_bindings(ptask_saved*)
  -- if pdestructioncleanup.CONSTCONTEXT = (pconstantcontext)
  -- if ptask_saved* = (ERROR_HANDLER_RESULT perrorcall) :: ptask_tail*
  -- if pdestructioncleanup.SOURCE = ERROR_HANDLER_RESULT perrorcall
  -- if perrorcall.RESUME = DEPRECATED_CONSTANT_RESULT pdeprecatedconstant
  -- if pdeprecatedconstant.COPIED = eps

;; A genuine begin records the history cut before any nested cache publication.
dec $owned_class_replacement_event(pclassconstantevent) : pdefaultcache?
def $owned_class_replacement_event(CCREPLACE pdefaultcache porigin_trigger n) = (pdefaultcache)
def $owned_class_replacement_event(pclassconstantevent) = eps -- otherwise
dec $owned_class_cache_matches(pclassconstantevent, porigin) : bool
def $owned_class_cache_matches(pclassconstantevent, porigin) = true
  -- if $constant_callable_cache_event(pclassconstantevent) = ((porigin, n))
def $owned_class_cache_matches(pclassconstantevent, porigin) = false -- otherwise
dec $owned_class_cache_seen(pclassconstantevent*, porigin) : bool
def $owned_class_cache_seen(eps, porigin) = false
def $owned_class_cache_seen(pclassconstantevent :: pclassconstantevent_tail*, porigin) = true
  -- if $constant_callable_cache_event(pclassconstantevent) = ((porigin, n))
def $owned_class_cache_seen(pclassconstantevent :: pclassconstantevent_tail*, porigin) = $owned_class_cache_seen(pclassconstantevent_tail*, porigin)
  -- if ~$owned_class_cache_matches(pclassconstantevent, porigin)
dec $owned_class_link_matches(pclassconstantevent, porigin) : bool
def $owned_class_link_matches(CCLINK porigin n, porigin) = true
def $owned_class_link_matches(pclassconstantevent, porigin) = false -- otherwise
dec $owned_class_linked_before(pclassconstantevent*, porigin) : bool
def $owned_class_linked_before(eps, porigin) = false
def $owned_class_linked_before((CCLINK porigin n) :: pclassconstantevent*, porigin) = true
def $owned_class_linked_before(pclassconstantevent :: pclassconstantevent_tail*, porigin) = $owned_class_linked_before(pclassconstantevent_tail*, porigin)
  -- if ~$owned_class_link_matches(pclassconstantevent, porigin)
def $class_constant_pending_cache(S, pclassconstantcontext) = ($owned_class_linked_before(S.CLASSCONSTANTHISTORY[0:pclassconstantcontext.HISTORY], pclassconstantdesc.OWNER) /\ ~$owned_class_cache_seen(S.CLASSCONSTANTHISTORY[0:pclassconstantcontext.HISTORY], pclassconstantcontext.DECL) /\ ($default_cache_at(S.CLASSCONSTANTCACHE, pclassconstantcontext.DECL) = eps \/ $owned_class_cache_seen(S.CLASSCONSTANTHISTORY[pclassconstantcontext.HISTORY:n_after], pclassconstantcontext.DECL)))
  -- if $class_constant_origin(S.CLASSES, pclassconstantcontext.DECL) = (pclassconstantdesc)
  -- if $owned_class_constant_source(S, pclassconstantdesc)
  -- if $(pclassconstantcontext.HISTORY <= |S.CLASSCONSTANTHISTORY|)
  -- if n_after = $nabs($(|S.CLASSCONSTANTHISTORY| - pclassconstantcontext.HISTORY))

;; Old rows are borrowed history. Only permanent global donors or inline values
;; make their payload available without adding a historical value/root edge.
dec $owned_class_snapshot_donor(puserconstant*, pdefaultcache) : bool
def $owned_class_snapshot_donor(eps, pdefaultcache) = false
def $owned_class_snapshot_donor(puserconstant :: puserconstant_tail*, pdefaultcache) = true
  -- if puserconstant.VALUE = pdefaultcache.VALUE /\ puserconstant.CLASS = pdefaultcache.CLASS
def $owned_class_snapshot_donor(puserconstant :: puserconstant_tail*, pdefaultcache) = $owned_class_snapshot_donor(puserconstant_tail*, pdefaultcache)
  -- if puserconstant.VALUE =/= pdefaultcache.VALUE \/ puserconstant.CLASS =/= pdefaultcache.CLASS
dec $owned_class_snapshot_available(pstate, pdefaultcache) : bool
def $owned_class_snapshot_available(S, pdefaultcache) = ($constant_value_class_valid(S, pdefaultcache.VALUE, pdefaultcache.CLASS) /\ ($deprecated_global_nonowning(pdefaultcache.VALUE) \/ $owned_class_snapshot_donor(S.USERCONSTANTS, pdefaultcache)))
def $class_constant_store(S, pclassconstantcontext, pclassconstantcontext_tail*, ptask_tail*, pvalue, pvalueclass, porigin_trigger, n_prefix) = $class_constant_result($class_constant_restore(S[.TODO = ptask_tail*][.CLASSCONSTANTCACHE = $default_cache_put(S.CLASSCONSTANTCACHE, {ORIGIN pclassconstantcontext.DECL, VALUE pvalue, CLASS pvalueclass})][.CLASSCONSTANTHISTORY = S.CLASSCONSTANTHISTORY ++ [CCREPLACE pdefaultcache porigin_trigger n_prefix]], pclassconstantcontext, pclassconstantcontext_tail*), pvalue, pvalueclass)
  -- if $class_constant_origin(S.CLASSES, pclassconstantcontext.DECL) = (pclassconstantdesc)
  -- if $owned_class_constant_source(S, pclassconstantdesc)
  -- if $default_cache_at(S.CLASSCONSTANTCACHE, pclassconstantcontext.DECL) = (pdefaultcache)
  -- if $owned_class_snapshot_available(S, pdefaultcache)
def $class_constant_store(S, pclassconstantcontext, pclassconstantcontext_tail*, ptask_tail*, pvalue, pvalueclass, porigin_trigger, n_prefix) = $class_constant_restore(S[.TODO = ptask_tail*][.COMPLETION = UNSUPPORTED "unavailable historical class constant cache value"], pclassconstantcontext, pclassconstantcontext_tail*)
  -- if $class_constant_origin(S.CLASSES, pclassconstantcontext.DECL) = (pclassconstantdesc)
  -- if $owned_class_constant_source(S, pclassconstantdesc)
  -- if $default_cache_at(S.CLASSCONSTANTCACHE, pclassconstantcontext.DECL) = (pdefaultcache)
  -- if ~$owned_class_snapshot_available(S, pdefaultcache)

def $class_constant_event_ordinal(CCREPLACE pdefaultcache porigin_trigger n) = n
def $constant_callable_cache_event(CCREPLACE pdefaultcache porigin_trigger n) = ((pdefaultcache.ORIGIN, n))
def $class_constant_history_fills(S, (CCREPLACE pdefaultcache porigin_trigger n) :: pclassconstantevent*, (porigin_flag, b_flag)*, porigin_cached*, porigin_filled*, n_previous) = $class_constant_history_fills(S, pclassconstantevent*, (porigin_flag, b_flag)*, porigin_cached*, porigin_filled*, n)
