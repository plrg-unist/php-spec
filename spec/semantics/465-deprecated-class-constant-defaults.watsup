  -- if n_tail = $nabs($(|S.CLASSCONSTANTHISTORY| - n_after))
  -- if $owned_class_next_snapshot(S.CLASSCONSTANTHISTORY[n_after:n_tail], porigin) = (pdefaultcache)
def $class_constant_compile_events(S, (CCREPLACE pdefaultcache_old porigin_trigger n) :: pclassconstantevent*, S_entry) = $class_constant_compile_events(S, pclassconstantevent*, S_entry[.CLASSCONSTANTCACHE = $default_cache_put(S_entry.CLASSCONSTANTCACHE, pdefaultcache)])
  -- if $class_constant_cache_projection(S, S_entry, (CCREPLACE pdefaultcache_old porigin_trigger n) :: pclassconstantevent*, pdefaultcache_old.ORIGIN) = (pdefaultcache)

;; Trait notice projections retain the same historical values; no Trait read
;; authority is added. Histories without replacements keep their old path.
dec $owned_class_has_replacement(pclassconstantevent*) : bool
def $owned_class_has_replacement(eps) = false
def $owned_class_has_replacement((CCREPLACE pdefaultcache porigin_trigger n) :: pclassconstantevent*) = true
def $owned_class_has_replacement(pclassconstantevent :: pclassconstantevent_tail*) = $owned_class_has_replacement(pclassconstantevent_tail*)
  -- if $owned_class_replacement_event(pclassconstantevent) = eps

