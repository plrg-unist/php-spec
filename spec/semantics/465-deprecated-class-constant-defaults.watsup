;; The next replacement records the row which was current at this write.
;; Search the full history beyond the actual cursor, even for a prefix replay.
dec $owned_class_next_snapshot(pclassconstantevent*, porigin) : pdefaultcache?
def $owned_class_next_snapshot(eps, porigin) = eps
def $owned_class_next_snapshot(pclassconstantevent :: pclassconstantevent_tail*, porigin) = (pdefaultcache)
  -- if $owned_class_replacement_event(pclassconstantevent) = (pdefaultcache)
