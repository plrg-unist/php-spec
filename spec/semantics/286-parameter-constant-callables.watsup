def $parameter_callable_active(S, porigin_site) = ($parameter_callable_context(S, porigin_site) =/= eps)
def $parameter_callable_record_kind(S, pconstantclosure) = ($parameter_callable_record(S.PARAMETERCLOSURES, pconstantclosure.OBJECT) =/= eps)
def $constant_callable_stamp(S, n_object, porigin_site, n_prefix) = S[.OBJECTS = $object_set(S.OBJECTS, n_object, CONSTANTCLOSURE porigin_site ($parameter_callable_wrap(pparameterclosure.EVIDENCE, S.OBJECTS[n_object])))][.CONSTANTCLOSURES = S.CONSTANTCLOSURES ++ [{OBJECT n_object, SITE porigin_site, DECL porigin_parameter, PREFIX n_prefix}]][.PARAMETERCLOSURES = S.PARAMETERCLOSURES ++ [pparameterclosure[.OBJECT = n_object]]]
  -- if $parameter_callable_context(S, porigin_site) = (pparameterclosure)
  -- if porigin_parameter = $default_parameter_origin(S, pparameterclosure.FUNCTION, pparameterclosure.INDEX)
def $constant_closure_create(S, pfunction) = $constant_callable_stamp($global_constant_real_scope(S_created, n_object, pparameterclosure.SCOPE), n_object, pfunction.ORIGIN, |S.DECLARATIONS|)
  -- if $parameter_callable_context(S, pfunction.ORIGIN) = (pparameterclosure)
  -- if $closure_lexicals(pfunction.CODE.EXPRESSIONS) = eps
  -- if n_object = |S.OBJECTS|
  -- if S_created = S[.OBJECTS = S.OBJECTS ++ [REALCLOSURE pfunction.ORIGIN eps eps]][.ALLOCATIONS = S.ALLOCATIONS ++ [HOBJECT n_object]][.RESULT = KNOWN (POBJECT n_object)][.BASE = BASE_VALUE (KNOWN PNULL)]
def $constant_callable_record_prefix(S, pconstantclosure) = true
  -- if $parameter_callable_record_kind(S, pconstantclosure)
  -- if $firstclass_site(S, pconstantclosure.SITE) \/ $constant_callable_method_site(S, pconstantclosure.SITE)
  -- if $constant_callable_first(S.CONSTANTCLOSURES, pconstantclosure.SITE) = (pconstantclosure_first)
  -- if $(pconstantclosure_first.OBJECT <= pconstantclosure.OBJECT)
  -- if $(pconstantclosure_first.PREFIX <= pconstantclosure.PREFIX)

;; The first physical FCC target is cached. Each receive selects a fresh called
;; class using its own saved lexical scope and current publication prefix.
def $parameter_callable_cached_function(S, porigin_site) = (pfunction)
  -- if $constant_callable_first(S.CONSTANTCLOSURES, porigin_site) = (pconstantclosure_first)
  -- if $parameter_callable_header(S, pconstantclosure_first) = (pparameterclosure_first)
  -- if $constant_callable_function_fresh(S, porigin_site, pconstantclosure_first.PREFIX) = (pfunction)
  -- if $object_body(S.OBJECTS[pconstantclosure_first.OBJECT]) = NAMEDCLOSURE pfunction.ORIGIN
def $parameter_callable_cached_function(S, porigin_site) = eps -- otherwise
def $parameter_callable_cached_method(S, porigin_site) = (pmethoddesc)
  -- if $constant_callable_first(S.CONSTANTCLOSURES, porigin_site) = (pconstantclosure_first)
  -- if $parameter_callable_header(S, pconstantclosure_first) = (pparameterclosure_first)
  -- if $global_constant_method(S, porigin_site, pparameterclosure_first.SCOPE, pconstantclosure_first.PREFIX) = ((pmethoddesc, porigin_first_called))
  -- if $object_body(S.OBJECTS[pconstantclosure_first.OBJECT]) = METHODCLOSURE pmethoddesc.FUNCTION.ORIGIN porigin_site porigin_first_called eps
  -- if pmethoddesc.STATIC /\ ~pmethoddesc.ABSTRACT
  -- if $method_accessible(S, pmethoddesc, pparameterclosure_first.SCOPE)
def $parameter_callable_cached_method(S, porigin_site) = eps -- otherwise

dec $parameter_callable_method(pstate, porigin, porigin?, nat) : (pmethoddesc, porigin)?
dec $parameter_callable_method_access(pstate, porigin, porigin?, pmethoddesc) : bool
def $parameter_callable_method(S, porigin_site, porigin_scope?, n_prefix) = $global_constant_method(S, porigin_site, porigin_scope?, n_prefix)
  -- if $parameter_callable_cached_method(S, porigin_site) = eps
def $parameter_callable_method(S, porigin_site, porigin_scope?, n_prefix) = ((pmethoddesc, porigin_called))
  -- if $parameter_callable_cached_method(S, porigin_site) = (pmethoddesc)
  -- if $constant_callable_first(S.CONSTANTCLOSURES, porigin_site) = (pconstantclosure_first)
  -- if $(pconstantclosure_first.PREFIX <= n_prefix) /\ $(n_prefix <= |S.DECLARATIONS|)
  -- if $origin_node(S.SOURCES, porigin_site) = (NExprStaticCall phpType19 phpType20 phpType6 metadata)
  -- if $global_constant_class_name(S, porigin_site, porigin_scope?, phpType19) = (ptbytes_class)
  -- if $class_named(S.CLASSNAMES, $ptlc(ptbytes_class)) = (porigin_called)
  -- if $constant_callable_published(S.DECLARATIONS[0:n_prefix], porigin_called)
def $parameter_callable_method(S, porigin_site, porigin_scope?, n_prefix) = eps -- otherwise
def $parameter_callable_method_access(S, porigin_site, porigin_scope?, pmethoddesc) = $method_accessible(S, pmethoddesc, porigin_scope?)
  -- if $parameter_callable_cached_method(S, porigin_site) = eps
def $parameter_callable_method_access(S, porigin_site, porigin_scope?, pmethoddesc) = true
  -- if $parameter_callable_cached_method(S, porigin_site) = (pmethoddesc)
def $parameter_callable_method_access(S, porigin_site, porigin_scope?, pmethoddesc) = false -- otherwise

