dec $parameter_callable_method_create(pstate, porigin, porigin?) : pstate
def $constant_callable_method_create(S, porigin_site) = $parameter_callable_method_create(S, porigin_site, pparameterclosure.SCOPE)
  -- if $parameter_callable_context(S, porigin_site) = (pparameterclosure)
def $parameter_callable_method_create(S, porigin_site, porigin_scope?) = $constant_callable_method_allocate(S, porigin_site, pmethoddesc, porigin_called, n_prefix)
  -- if n_prefix = |S.DECLARATIONS|
  -- if $parameter_callable_method(S, porigin_site, porigin_scope?, n_prefix) = ((pmethoddesc, porigin_called))
  -- if $parameter_callable_method_access(S, porigin_site, porigin_scope?, pmethoddesc) /\ pmethoddesc.STATIC /\ ~pmethoddesc.ABSTRACT
  -- if ~$global_constant_method_trait(S, pmethoddesc) \/ $parameter_callable_cached_method(S, porigin_site) = (pmethoddesc)
def $parameter_callable_method_create(S, porigin_site, porigin_scope?) = $error_dispatch(S_pending, 8192, ptbytes_message, z, DIAGNOSTIC "Deprecated" ptbytes_message z, ptask_resume)
  -- if n_prefix = |S.DECLARATIONS|
  -- if $parameter_callable_method(S, porigin_site, porigin_scope?, n_prefix) = ((pmethoddesc, porigin_called))
  -- if $parameter_callable_method_access(S, porigin_site, porigin_scope?, pmethoddesc) /\ pmethoddesc.STATIC /\ ~pmethoddesc.ABSTRACT
  -- if $global_constant_method_trait(S, pmethoddesc) /\ $parameter_callable_cached_method(S, porigin_site) = eps
  -- if $origin_node(S.SOURCES, porigin_site) = (expression)
  -- if z = $runtime_line(S, eps, expression)
  -- if ptbytes_message = $global_constant_method_message(S, pmethoddesc.FUNCTION.ORIGIN)
  -- if ptask_resume = PARAMETER_CONSTANT_METHOD_RESUME porigin_site pmethoddesc.FUNCTION.ORIGIN porigin_called n_prefix
  -- if S_pending = S[.TODO = ptask_resume :: S.TODO][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
def $parameter_callable_method_create(S, porigin_site, porigin_scope?) = $method_denied(S, pmethoddesc, pmethoddesc.NAME, porigin_scope?, false, $runtime_line(S, eps, expression))
  -- if $parameter_callable_method(S, porigin_site, porigin_scope?, |S.DECLARATIONS|) = ((pmethoddesc, porigin_called))
  -- if ~$parameter_callable_method_access(S, porigin_site, porigin_scope?, pmethoddesc)
  -- if $origin_node(S.SOURCES, porigin_site) = (expression)
