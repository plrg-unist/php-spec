def $parameter_callable_scope_valid(S, pparameterclosure, pfunction) = true
  -- if $closure_method_origin(S, pfunction.ORIGIN) = eps
  -- if $function_at(S.FUNCTIONS, pfunction.ORIGIN) = (pfunction)
  -- if pparameterclosure.SCOPE = eps /\ pparameterclosure.EVIDENCE = eps
def $parameter_callable_scope_valid(S, pparameterclosure, pfunction) = true
  -- if $function_at(S.CLOSURETEMPLATES, pfunction.ORIGIN) = (pfunction)
  -- if pparameterclosure.EVIDENCE = (PARAMETER_SCOPE pclosureevidence)
  -- if $($closure_evidence_object(pclosureevidence) < pparameterclosure.OBJECT)
  -- if $closure_evidence_body(S, $closure_evidence_object(pclosureevidence)) = (pfunction.ORIGIN)
  -- if $closure_evidence_valid(S, pclosureevidence)
  -- if $closure_evidence_lexical(pclosureevidence) = pparameterclosure.SCOPE
def $parameter_callable_scope_valid(S, pparameterclosure, pfunction) = true
  -- if $function_at(S.CLOSURETEMPLATES, pfunction.ORIGIN) = (pfunction)
  -- if pparameterclosure.SCOPE = eps
  -- if pparameterclosure.EVIDENCE = (PARAMETER_SOURCE n_source)
  -- if $(n_source < pparameterclosure.OBJECT) /\ $(pparameterclosure.OBJECT < |S.OBJECTS|)
  -- if S.OBJECTS[pparameterclosure.OBJECT] = CONSTANTCLOSURE porigin_site (PARAMETERSOURCECLOSURE n_source pobject)
  -- if $object_body(S.OBJECTS[n_source]) = REALCLOSURE pfunction.ORIGIN pitem* pstaticcell*
  -- if $closure_source_class(S, pfunction.ORIGIN) = eps
  -- if ~(HOBJECT n_source <- S.ALLOCATIONS) \/ ($closure_scope_at(S.CLOSURESCOPES, n_source) = eps /\ $closure_binding_at(S.CLOSUREBINDINGS, n_source) = eps /\ ~$internal_closure_object(S, n_source))
def $parameter_callable_scope_valid(S, pparameterclosure, pfunction) = true
  -- if pparameterclosure.OBJECT = |S.OBJECTS|
  -- if $function_at(S.CLOSURETEMPLATES, pfunction.ORIGIN) = (pfunction)
  -- if pparameterclosure.SCOPE = eps
  -- if pparameterclosure.EVIDENCE = (PARAMETER_SOURCE n_source)
  -- if $parameter_callable_current_evidence(S, pfunction) = (PARAMETER_SOURCE n_source)
def $parameter_callable_scope_valid(S, pparameterclosure, pfunction) = false -- otherwise

