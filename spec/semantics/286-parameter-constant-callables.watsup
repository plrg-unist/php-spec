;; Parameter AST callables use the receiving function's lexical scope. The
;; receipt borrows that receive; it never owns the function Closure or receiver.
dec $parameter_initializer_root(pcunit, pcpath) : porigin?
dec $parameter_initializer_node(pcnode?) : bool
def $parameter_initializer_root(pcunit, pcpath) = (porigin_parameter)
  -- if $(|pcpath| > 0)
  -- if pcpath[$nabs($(|pcpath| - 1))] = PCFIELD 6
  -- if pcpath_parameter = pcpath[0:$nabs($(|pcpath| - 1))]
  -- if porigin_parameter = PORIGIN pcunit.ID pcpath_parameter
  -- if $origin_node([pcunit], porigin_parameter) = (NParam phpType14 phpType24 phpType18 phpType4_ref phpType4_var phpType10 expression phpType37 metadata)
def $parameter_initializer_root(pcunit, pcpath) = $parameter_initializer_root(pcunit, pcpath_parent)
  -- if $(|pcpath| > 0)
  -- if pcpath_parent = pcpath[0:$nabs($(|pcpath| - 1))]
  -- if ~$global_constant_closure_parent(pcunit, pcpath_parent)
  -- if ~$parameter_initializer_node($origin_node([pcunit], PORIGIN pcunit.ID pcpath_parent))
def $parameter_initializer_root(pcunit, pcpath) = eps -- otherwise
def $parameter_initializer_node((NParam phpType14 phpType24 phpType18 phpType4_ref phpType4_var phpType10 expression phpType37 metadata)) = true
def $parameter_initializer_node(pcnode?) = false -- otherwise
def $ppparameter_callable_initializer(P) = (P.FOLD.DEFAULT /\ P.FOLD.CONSTANT /\ $parameter_initializer_root(P.FOLD.SOURCE, P.LOCATION.PATH) =/= eps)
def $ppconstant_callable_initializer(P) = true
  -- if $ppparameter_callable_initializer(P)

dec $parameter_callable_source(pstate, pfunction, nat, porigin) : bool
def $parameter_callable_source(S, pfunction, n_index, porigin_site) = true
  -- if $function_at($all_functions(S), pfunction.ORIGIN) = (pfunction)
  -- if $default_at(pfunction.DEFAULTS, n_index) = (pdefault)
  -- if pdefault.KIND = PDDEFERRED
  -- if porigin_parameter = $default_parameter_origin(S, pfunction.ORIGIN, n_index)
  -- if porigin_parameter = PORIGIN n_unit pcpath_parameter
  -- if pdefault.ORIGIN = PORIGIN n_unit (pcpath_parameter ++ [PCFIELD 6])
  -- if $source_unit(S.SOURCES, n_unit) = (pcunit)
  -- if $origin_node(S.SOURCES, porigin_parameter) = (NParam phpType14 phpType24 phpType18 phpType4_ref phpType4_var phpType10 expression phpType37 metadata)
  -- if $origin_node(S.SOURCES, pdefault.ORIGIN) = (expression)
  -- if $compiled_read(S, pdefault.ORIGIN) = eps
  -- if $constant_callable_path(S, porigin_site, pdefault.ORIGIN)
  -- if porigin_site = PORIGIN n_unit pcpath_site
  -- if $parameter_initializer_root(pcunit, pcpath_site) = (porigin_parameter)
def $parameter_callable_source(S, pfunction, n_index, porigin_site) = false -- otherwise
def $parameter_callable_source_site(S, PORIGIN n_unit pcpath_site) = true
  -- if $source_unit(S.SOURCES, n_unit) = (pcunit)
  -- if $parameter_initializer_root(pcunit, pcpath_site) = (porigin_parameter)
  -- if $origin_node(S.SOURCES, PORIGIN n_unit pcpath_site) = (pcnode)
  -- if $constant_callable_form(pcnode)
def $parameter_callable_source_site(S, porigin_site) = false -- otherwise

dec $parameter_callable_record(pparameterclosure*, nat) : pparameterclosure?
def $parameter_callable_record(eps, n_object) = eps
def $parameter_callable_record(pparameterclosure :: pparameterclosure_tail*, n_object) = (pparameterclosure)
  -- if pparameterclosure.OBJECT = n_object
def $parameter_callable_record(pparameterclosure :: pparameterclosure_tail*, n_object) = $parameter_callable_record(pparameterclosure_tail*, n_object)
  -- if pparameterclosure.OBJECT =/= n_object

;; Only genuinely unscoped source receives mint this immutable, nonowning
;; source marker. Live scope rows can retire without changing that proof.
dec $parameter_callable_source_proof(pparameterreceive?) : bool
def $parameter_callable_source_proof((PARAMETER_SOURCE n_source)) = true
def $parameter_callable_source_proof(pparameterreceive?) = false -- otherwise
dec $parameter_callable_source_wrapper(pobject) : bool
def $parameter_callable_source_wrapper(PARAMETERSOURCECLOSURE n_source pobject) = true
def $parameter_callable_source_wrapper(pobject) = false -- otherwise
dec $parameter_callable_wrap(pparameterreceive?, pobject) : pobject
def $parameter_callable_wrap((PARAMETER_SOURCE n_source), pobject) = PARAMETERSOURCECLOSURE n_source pobject
def $parameter_callable_wrap(pparameterreceive?, pobject) = pobject -- otherwise
def $parameter_callable_body_unwrap(PARAMETERSOURCECLOSURE n_source pobject) = pobject
def $object_changed(CONSTANTCLOSURE porigin_site (PARAMETERSOURCECLOSURE n_source (REALCLOSURE porigin_body pitem_old* pstaticcell_old*)), REALCLOSURE porigin_body pitem* pstaticcell*) = CONSTANTCLOSURE porigin_site (PARAMETERSOURCECLOSURE n_source (REALCLOSURE porigin_body pitem* pstaticcell*))
dec $parameter_callable_wrapper_proof(pobject, pparameterreceive?) : bool
def $parameter_callable_wrapper_proof(PARAMETERSOURCECLOSURE n_source pobject, (PARAMETER_SOURCE n_source)) = true
def $parameter_callable_wrapper_proof(pobject, pparameterreceive?) = true
  -- if ~$parameter_callable_source_wrapper(pobject)
  -- if ~$parameter_callable_source_proof(pparameterreceive?)
def $parameter_callable_wrapper_proof(pobject, pparameterreceive?) = false -- otherwise

dec $parameter_callable_current_evidence(pstate, pfunction) : pparameterreceive?
dec $parameter_callable_scope_valid(pstate, pparameterclosure, pfunction) : bool
def $parameter_callable_scope_valid(S, pparameterclosure, pfunction) = true
  -- if $closure_method_origin(S, pfunction.ORIGIN) = (pmethoddesc)
  -- if pparameterclosure.SCOPE = (pmethoddesc.OWNER)
