def $parameter_callable_context(S, porigin_site) = eps -- otherwise
def $parameter_callable_current_evidence(S, pfunction) = (PARAMETER_SCOPE pclosureevidence)
  -- if $function_at(S.CLOSURETEMPLATES, pfunction.ORIGIN) = (pfunction)
