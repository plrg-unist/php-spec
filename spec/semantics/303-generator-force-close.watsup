def $generator_close_started(GENERATOR pgenerator) = (pgenerator.PHASE <- [GENERATOR_PAUSED, GENERATOR_DELEGATING])
def $generator_close_started(pobject) = false -- otherwise
def $generator_close_node(S, HOBJECT n) = $generator_close_started(S.OBJECTS[n])
def $generator_close_node(S, pnode) = false -- otherwise
def $generator_close_dead(S, eps, pnode_live*) = false
def $generator_close_dead(S, pnode :: pnode_tail*, pnode_live*) = ((~(pnode <- pnode_live*) /\ $generator_close_node(S, pnode)) \/ $generator_close_dead(S, pnode_tail*, pnode_live*))
def $generator_finalizer_task(S, FINALLY_RETURN porigin porigin_source poperand) = true
def $generator_finalizer_task(S, FINALLY_REF_RETURN porigin porigin_source poperand z) = true
def $generator_finalizer_task(S, FINALLY_JUMP porigin porigin_source n_depth n_original b) = true
def $generator_finalizer_task(S, FINALLY_GOTO porigin porigin_source pcpath_source pcpath_target) = true

;; A queued decrement pins only the not-yet-released slots. Test its head with
;; that pin excluded; other jobs and the caller's saved result remain owners.
def $generator_close_pending(THROWING n, ptask*) = (n)
def $generator_close_pending(pcompletion, (THROW_SEARCH n) :: ptask*) = (n) -- if pcompletion =/= THROWING n
def $generator_close_pending(pcompletion, ptask*) = eps -- otherwise
def $generator_close_without_search((THROW_SEARCH n) :: ptask*, (n)) = ptask*
def $generator_close_without_search(ptask*, nat?) = ptask* -- otherwise
def $generator_close_begin(S, pdestructionjob*) = $generator_close_begin_pending(S_materialized, pdestructionjob*, $generator_close_pending(S_materialized.COMPLETION, S_materialized.TODO))
  -- if S_materialized = $throwable_materialize(S)
def $generator_close_begin_pending(S, pdestructionjob*, n?) = S[.TODO = (GENERATOR_CLOSE_RELEASE {JOBS pdestructionjob*, VALUE S.RESULT, BASE S.BASE, PENDING n?, COMPLETION NORMAL}) :: $generator_close_without_search(S.TODO, n?)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)][.COMPLETION = NORMAL]
  -- if S.COMPLETION = NORMAL \/ $generator_close_pending(S.COMPLETION, eps) =/= eps
  -- if ~$generator_close_terminal_tasks(S.TODO)
def $generator_close_begin_pending(S, pdestructionjob*, n?) = S[.COMPLETION = UNSUPPORTED "Generator last-owner release during terminal cleanup"] -- otherwise
def $generator_prune(S, pnode_live*) = $generator_close_begin($destruction_store_new(S), $destruction_values($destruction_zero($heap_graph(S), S.ALLOCATIONS)))
  -- if $generator_close_dead(S, S.ALLOCATIONS, pnode_live*)
  -- if S.ACTIVEFIBER = eps
def $generator_prune(S, pnode_live*) = $generator_fiber_close(S)
  -- if $generator_close_dead(S, S.ALLOCATIONS, pnode_live*)
  -- if S.ACTIVEFIBER =/= eps
def $generator_prune(S, pnode_live*) = S[.COMPLETION = UNSUPPORTED "Generator force-close at request end"]
  -- if ~$generator_close_dead(S, S.ALLOCATIONS, pnode_live*)

;; Eager slot decrements enter this loop before the generic free_obj walk.
;; The outer release certificate remains borrowed, and its remaining slots
;; retain their real owners while the Generator runs its pending finalizers.
def $generator_destructor_pending(S, pnode) = $generator_close_node(S, pnode)
rule PhpStep/generator-destructor-release: S ~> $generator_close_begin_pending(S_unheld, [DESTRUCTION_VALUE pnode], $destructor_selected_pending(S_unheld, $destructor_selected_frame(S_unheld)))
  -- if S.TODO = (DESTRUCTOR_RELEASE pdestructionrelease) :: ptask*
  -- if $destructor_release_valid(S, pdestructionrelease)
  -- if pdestructionrelease.JOBS = pdestructionjob_head :: pdestructionjob*
  -- if $destruction_job_node(pdestructionjob_head) = (pnode)
  -- if S_unheld = $destructor_release_replace(S, pdestructionrelease[.JOBS = pdestructionjob*])
  -- if $heap_owners($heap_graph(S_unheld), pnode) = 0
  -- if $generator_destructor_pending(S_unheld, pnode)
  -- if pdestructionrelease.USER /\ ~$destructor_active(S)
rule PhpStep/generator-destructor-request: S ~> S[.COMPLETION = UNSUPPORTED "Generator force-close at request end"]
  -- if S.TODO = (DESTRUCTOR_RELEASE pdestructionrelease) :: ptask*
  -- if $destructor_release_valid(S, pdestructionrelease)
  -- if pdestructionrelease.JOBS = pdestructionjob_head :: pdestructionjob*
  -- if $destruction_job_node(pdestructionjob_head) = (pnode)
  -- if S_unheld = $destructor_release_replace(S, pdestructionrelease[.JOBS = pdestructionjob*])
  -- if $heap_owners($heap_graph(S_unheld), pnode) = 0
  -- if $generator_destructor_pending(S_unheld, pnode)
  -- if ~pdestructionrelease.USER \/ $destructor_active(S)
def $generator_destructor_tail((DESTRUCTOR_RELEASE pdestructionrelease) :: ptask*) = true
def $generator_destructor_tail(ptask*) = false -- otherwise
def $generator_destructor_finish(S, n) = S[.TODO = $destructor_operation_tasks(S.TODO, pdestructionoperation, pdestructionoperation_new)][.DESTRUCTION.OPERATIONS = pdestructionoperation_new :: pdestructionoperation_tail*]
  -- if $destructor_operation_for(S) = (pdestructionoperation)
  -- if S.DESTRUCTION.OPERATIONS = pdestructionoperation :: pdestructionoperation_tail*
  -- if pdestructionoperation_new = pdestructionoperation[.PENDING = (n)]
def $generator_destructor_finish(S, n) = S[.TODO = $destructor_frame_tasks(S.TODO, pdestructionframe, pdestructionframe_new)][.DESTRUCTION.FRAMES = pdestructionframe_new :: pdestructionframe_tail*]
  -- if $destructor_operation_for(S) = eps
  -- if $destructor_selected_frame(S) = (pdestructionframe)
  -- if S.DESTRUCTION.FRAMES = pdestructionframe :: pdestructionframe_tail*
  -- if pdestructionframe_new = pdestructionframe[.PENDING = (n)]
def $generator_destructor_finish(S, n) = S[.COMPLETION = UNSUPPORTED "Generator close has no pending destruction carrier"] -- otherwise

def $generator_close_merge(S, eps, n_old?) = (S, n_old?)
def $generator_close_merge(S, n_new?, eps) = (S, n_new?)
  -- if n_new? = (n)
def $generator_close_merge(S, n_new?, (n_old)) = ($throwable_previous(S, n, n_old), n_new?)
  -- if n_new? = (n)
def $generator_close_release_end(S, pgenrelease) = S_chained[.TODO = (GENERATOR_CLOSE_ENTER pgenclose[.PENDING = n?]) :: ptask*][.RESULT = pgenrelease.VALUE][.BASE = pgenrelease.BASE]
  -- if S.TODO = (GENERATOR_CLOSE_RELEASE pgenrelease) :: (GENERATOR_CLOSE_ENTER pgenclose) :: ptask*
  -- if (S_chained, n?) = $generator_close_merge(S, pgenrelease.PENDING, pgenclose.PENDING)
def $generator_close_release_end(S, pgenrelease) = S_chained[.TODO = (GENERATOR_CLOSE_DONE pgenclose[.PENDING = n?]) :: ptask*][.RESULT = pgenrelease.VALUE][.BASE = pgenrelease.BASE]
  -- if S.TODO = (GENERATOR_CLOSE_RELEASE pgenrelease) :: (GENERATOR_CLOSE_DONE pgenclose) :: ptask*
  -- if (S_chained, n?) = $generator_close_merge(S, pgenrelease.PENDING, pgenclose.PENDING)
def $generator_close_release_end(S, pgenrelease) = S_chained[.TODO = (GENERATOR_CLOSE_RELEASE pgenrelease_outer[.PENDING = n?]) :: ptask*][.RESULT = pgenrelease.VALUE][.BASE = pgenrelease.BASE]
  -- if S.TODO = (GENERATOR_CLOSE_RELEASE pgenrelease) :: (GENERATOR_CLOSE_RELEASE pgenrelease_outer) :: ptask*
  -- if (S_chained, n?) = $generator_close_merge(S, pgenrelease.PENDING, pgenrelease_outer.PENDING)
def $generator_close_release_end(S, pgenrelease) = S[.TODO = ptask*][.RESULT = pgenrelease.VALUE][.BASE = pgenrelease.BASE][.COMPLETION = pgenrelease.COMPLETION]
  -- if S.TODO = (GENERATOR_CLOSE_RELEASE pgenrelease) :: ptask*
  -- if ~$generator_close_tail(ptask*)
  -- if pgenrelease.PENDING = eps
def $generator_close_release_end(S, pgenrelease) = $generator_destructor_finish(S[.TODO = ptask*][.RESULT = pgenrelease.VALUE][.BASE = pgenrelease.BASE], n)
  -- if S.TODO = (GENERATOR_CLOSE_RELEASE pgenrelease) :: ptask*
  -- if $generator_destructor_tail(ptask*)
  -- if pgenrelease.PENDING = (n)
def $generator_close_release_end(S, pgenrelease) = S[.TODO = (THROW_SEARCH n) :: ptask*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)][.COMPLETION = NORMAL]
  -- if S.TODO = (GENERATOR_CLOSE_RELEASE pgenrelease) :: ptask*
  -- if ~$generator_close_tail(ptask*)
  -- if ~$generator_destructor_tail(ptask*)
  -- if pgenrelease.PENDING = (n)
def $generator_close_tail((GENERATOR_CLOSE_ENTER pgenclose) :: ptask*) = true
def $generator_close_tail((GENERATOR_CLOSE_DONE pgenclose) :: ptask*) = true
def $generator_close_tail((GENERATOR_CLOSE_RELEASE pgenrelease) :: ptask*) = true
def $generator_close_tail(ptask*) = false -- otherwise

def $generator_close_children(S, HOBJECT n) = $generator_closed_closure(pgenerator) ++ $generator_optional_operand_nodes($generator_close_current(pgenerator.DELEGATE)) ++ $generator_values_nodes(pgenerator.VALUE) ++ $generator_values_nodes(pgenerator.KEY) ++ $generator_values_nodes(pgenerator.RETURN)
  -- if S.OBJECTS[n] = GENERATOR pgenerator
  -- if pgenerator.PHASE = GENERATOR_CLOSED
def $generator_close_children(S, HOBJECT n) = $generator_close_frame_nodes(S, pframe) ++ $generator_closed_closure(pgenerator) ++ $generator_values_nodes(pgenerator.VALUE) ++ $generator_values_nodes(pgenerator.KEY) ++ $generator_values_nodes(pgenerator.RETURN) ++ $generator_from_nodes(pgenerator.DELEGATE)
  -- if S.OBJECTS[n] = GENERATOR pgenerator
  -- if pgenerator.PHASE = GENERATOR_FRESH
  -- if pgenerator.FRAME = (pframe)
def $generator_close_children(S, pnode) = $node_children(S, pnode) -- otherwise
;; Cached storage can enter the ordinary destructor loop only when its actual
;; pending carrier is reachable through these release markers.
def $generator_close_destructor_tasks((DESTRUCTOR_OPERATION_EXIT pdestructionoperation) :: ptask*, n_local?, n_caller?, DESTRUCTOR_OPERATION_EXIT pdestructionoperation) = true
def $generator_close_destructor_tasks((DESTRUCTOR_FRAME_EXIT pdestructionframe) :: ptask*, n_local?, n_caller?, DESTRUCTOR_FRAME_EXIT pdestructionframe) = true
def $generator_close_destructor_tasks((DESTRUCTOR_RELEASE pdestructionrelease) :: ptask*, n_local?, n_caller?, ptask_exit) = $generator_close_destructor_tasks(ptask*, n_local?, n_caller?, ptask_exit)
def $generator_close_destructor_tasks((GENERATOR_CLOSE_RELEASE pgenrelease) :: ptask*, n_local?, n_caller?, ptask_exit) = $generator_close_destructor_tasks(ptask*, n_local?, n_caller?, ptask_exit)
  -- if pgenrelease.PENDING = eps \/ pgenrelease.PENDING = n_local? \/ pgenrelease.PENDING = n_caller?
def $generator_close_destructor_tasks(ptask*, n_local?, n_caller?, ptask_exit) = false -- otherwise
def $generator_close_destructor_ready(S, pgenrelease) = true
  -- if $destructor_operational(S) /\ $destructor_user_source(S)
  -- if $destructor_operation_for(S) = (pdestructionoperation)
  -- if S.DESTRUCTION.OPERATIONS = pdestructionoperation :: pdestructionoperation_tail*
  -- if $destructor_operation_valid(S, pdestructionoperation)
  -- if $generator_close_destructor_tasks(S.TODO, pgenrelease.PENDING, pdestructionoperation.PENDING, DESTRUCTOR_OPERATION_EXIT pdestructionoperation)
def $generator_close_destructor_ready(S, pgenrelease) = true
  -- if $destructor_operational(S) /\ $destructor_user_source(S)
  -- if $destructor_operation_for(S) = eps
  -- if $destructor_selected_frame(S) = (pdestructionframe)
  -- if S.DESTRUCTION.FRAMES = pdestructionframe :: pdestructionframe_tail*
  -- if $destructor_frame_valid(S, pdestructionframe)
  -- if $generator_close_destructor_tasks(S.TODO, pgenrelease.PENDING, pdestructionframe.PENDING, DESTRUCTOR_FRAME_EXIT pdestructionframe)
def $generator_close_destructor_ready(S, pgenrelease) = false -- otherwise
def $generator_close_destructor_pending(S, eps) = S
def $generator_close_destructor_pending(S, (n)) = $generator_destructor_finish(S, n)
def $destructor_operation_tasks((GENERATOR_CLOSE_RELEASE pgenrelease) :: ptask*, pdestructionoperation, pdestructionoperation_new) = (GENERATOR_CLOSE_RELEASE pgenrelease[.PENDING = pdestructionoperation_new.PENDING]) :: $destructor_operation_tasks(ptask*, pdestructionoperation, pdestructionoperation_new)
def $destructor_release_frame((GENERATOR_CLOSE_RELEASE pgenrelease) :: ptask*, pdestructionframe) = $destructor_release_frame(ptask*, pdestructionframe)
def $destructor_frame_tasks((GENERATOR_CLOSE_RELEASE pgenrelease) :: ptask*, pdestructionframe, pdestructionframe_new) = (GENERATOR_CLOSE_RELEASE pgenrelease[.PENDING = pdestructionframe_new.PENDING]) :: $destructor_frame_tasks(ptask*, pdestructionframe, pdestructionframe_new)
def $generator_close_current(eps) = eps
def $generator_close_current((pgeneratorfrom)) = pgeneratorfrom.CURRENT
def $generator_close_release(S, pgenrelease) = $generator_close_release_end(S, pgenrelease)
  -- if pgenrelease.JOBS = eps
def $generator_close_release(S, pgenrelease) = $destruction_store_drop(S[.TODO = (GENERATOR_CLOSE_RELEASE pgenrelease[.JOBS = pdestructionjob*]) :: ptask*], [HOBJECT n])
  -- if S.TODO = (GENERATOR_CLOSE_RELEASE pgenrelease) :: ptask*
  -- if pgenrelease.JOBS = (DESTRUCTION_HANDLE n) :: pdestructionjob*
def $generator_close_release(S, pgenrelease) = S_tail
  -- if S.TODO = (GENERATOR_CLOSE_RELEASE pgenrelease) :: ptask*
  -- if pgenrelease.JOBS = (DESTRUCTION_VALUE pnode) :: pdestructionjob*
  -- if S_tail = S[.TODO = (GENERATOR_CLOSE_RELEASE pgenrelease[.JOBS = pdestructionjob*]) :: ptask*]
  -- if ~(pnode <- S.ALLOCATIONS) \/ $($heap_owners($heap_graph(S_tail), pnode) > 0)
def $generator_close_release(S, pgenrelease) = $generator_close_prepare(S, pgenrelease[.JOBS = pdestructionjob*], n)
  -- if S.TODO = (GENERATOR_CLOSE_RELEASE pgenrelease) :: ptask*
  -- if pgenrelease.JOBS = (DESTRUCTION_VALUE (HOBJECT n)) :: pdestructionjob*
  -- if HOBJECT n <- S.ALLOCATIONS
  -- if $heap_owners($heap_graph(S[.TODO = (GENERATOR_CLOSE_RELEASE pgenrelease[.JOBS = pdestructionjob*]) :: ptask*]), HOBJECT n) = 0
  -- if $generator_close_node(S, HOBJECT n)
def $generator_close_release(S, pgenrelease) = $destructor_release_begin(S_tail, [DESTRUCTION_VALUE pnode])
  -- if S.TODO = (GENERATOR_CLOSE_RELEASE pgenrelease) :: ptask*
  -- if pgenrelease.JOBS = (DESTRUCTION_VALUE pnode) :: pdestructionjob*
  -- if pnode <- S.ALLOCATIONS
  -- if S_unheld = S[.TODO = (GENERATOR_CLOSE_RELEASE pgenrelease[.JOBS = pdestructionjob*]) :: ptask*]
  -- if $heap_owners($heap_graph(S_unheld), pnode) = 0
  -- if ~$generator_close_node(S, pnode)
  -- if $destructor_uncalled_node(S, pnode)
  -- if $generator_close_destructor_ready(S, pgenrelease)
  -- if (S_merged, n?) = $generator_close_merge(S, pgenrelease.PENDING, $destructor_selected_pending(S, $destructor_selected_frame(S)))
  -- if S_pending = $generator_close_destructor_pending(S_merged, n?)
  -- if S_pending.TODO = (GENERATOR_CLOSE_RELEASE pgenrelease_pending) :: ptask_pending*
  -- if S_tail = S_pending[.TODO = (GENERATOR_CLOSE_RELEASE pgenrelease_pending[.JOBS = pdestructionjob*]) :: ptask_pending*]
def $generator_close_release(S, pgenrelease) = S[.COMPLETION = UNSUPPORTED "ordinary destructor release before request stage"]
  -- if S.TODO = (GENERATOR_CLOSE_RELEASE pgenrelease) :: ptask*
  -- if pgenrelease.JOBS = (DESTRUCTION_VALUE pnode) :: pdestructionjob*
  -- if pnode <- S.ALLOCATIONS
  -- if $heap_owners($heap_graph(S[.TODO = (GENERATOR_CLOSE_RELEASE pgenrelease[.JOBS = pdestructionjob*]) :: ptask*]), pnode) = 0
  -- if ~$generator_close_node(S, pnode)
  -- if $destructor_uncalled_node(S, pnode)
  -- if ~$generator_close_destructor_ready(S, pgenrelease)
def $generator_close_release(S, pgenrelease) = $prune_live(S[.TODO = (GENERATOR_CLOSE_RELEASE pgenrelease[.JOBS = $destruction_values($generator_close_children(S, pnode)) ++ $destruction_free_job(pnode) ++ pdestructionjob*]) :: ptask*], $destruction_node_delete(S.ALLOCATIONS, pnode))
  -- if S.TODO = (GENERATOR_CLOSE_RELEASE pgenrelease) :: ptask*
  -- if pgenrelease.JOBS = (DESTRUCTION_VALUE pnode) :: pdestructionjob*
  -- if pnode <- S.ALLOCATIONS
  -- if $heap_owners($heap_graph(S[.TODO = (GENERATOR_CLOSE_RELEASE pgenrelease[.JOBS = pdestructionjob*]) :: ptask*]), pnode) = 0
  -- if ~$generator_close_node(S, pnode)
  -- if ~$destructor_uncalled_node(S, pnode)
rule PhpStep/generator-close-release: S ~> $generator_close_release(S, pgenrelease)
  -- if S.TODO = (GENERATOR_CLOSE_RELEASE pgenrelease) :: ptask*

;; Input release runs in the actual caller. The saved frame still owns its
;; parameter cells and unfinished operands, independently of the graph edge.
def $generator_close_prepare(S, pgenrelease, n) = $generator_close_begin_pending(S_detached[.TODO = (GENERATOR_CLOSE_ENTER {OBJECT n, SITE porigin, CONTEXT pcallcontext, CALLER S.CURRENT, CALLSITE S.ORIGIN, STAGE CLOSE_QUEUED, NEXT 0, FRAME (pframe), PENDING eps}) :: (GENERATOR_CLOSE_RELEASE pgenrelease[.PENDING = eps]) :: ptask_tail*], $destruction_values($generator_values_nodes($generator_from_input_of(pgenerator.DELEGATE))), pgenrelease.PENDING)
  -- if S.TODO = ptask :: ptask_tail*
  -- if S.OBJECTS[n] = GENERATOR pgenerator
  -- if pgenerator.FRAME = (pframe)
  -- if pframe.ORIGIN = (porigin)
  -- if pframe.CONTEXT = (pcallcontext)
  -- if S_detached = $generator_set(S, n, pgenerator[.FRAME = eps][.PHASE = GENERATOR_CLOSING][.DELEGATE = $generator_from_closed(pgenerator.DELEGATE)])

;; The helper frame is only a scoped view. It returns to the real caller
;; before a released operand can run a nested Generator finalizer.
def $generator_close_queued_skip(S, pgenclose, ptask, ptask_tail*) = $generator_close_begin_pending(S_restored[.TODO = (GENERATOR_CLOSE_ENTER pgenclose[.FRAME = ($generator_frame(S_skipped, S_skipped.TODO))][.PENDING = eps]) :: ptask_caller*], $destruction_values($destruction_nodes_delete($frames_roots([pframe]), $frames_roots([$generator_frame(S_skipped, S_skipped.TODO)]))), pgenclose.PENDING)
  -- if S.TODO = (GENERATOR_CLOSE_ENTER pgenclose) :: ptask_caller*
  -- if pgenclose.FRAME = (pframe)
  -- if S_view = $generator_install($save_frame(S[.TODO = ptask_caller*]), pframe)
  -- if S_skipped = $generator_close_skip_marker(S_view, ptask, ptask_tail*)
  -- if S_restored = $restore_frame_raw(S_skipped[.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)])
def $generator_close_skip_marker(S, ptask, ptask_tail*) = $finally_leave(S, porigin, ptask_tail*)
  -- if $finally_phase_of(ptask) = (n_phase)
  -- if $finally_marker_origin(ptask) = (porigin)
