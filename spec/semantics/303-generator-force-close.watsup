;; PHP 8.5.10 zend_generator_dtor_storage: ordinary last-owner release,
;; input/link before finally, frame before cached value/key storage.

dec $generator_close_started(pobject) : bool
dec $generator_close_node(pstate, pnode) : bool
dec $generator_close_pending(pcompletion, ptask*) : nat?
dec $generator_close_without_search(ptask*, nat?) : ptask*
dec $generator_close_begin(pstate, pdestructionjob*) : pstate
dec $generator_fiber_close(pstate) : pstate
dec $generator_close_begin_pending(pstate, pdestructionjob*, nat?) : pstate
