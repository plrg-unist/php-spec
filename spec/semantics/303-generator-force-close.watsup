dec $generator_close_done_valid(pstate, pgenclose) : bool
dec $generator_close_frame_valid(pstate, pgenerator, pframe) : bool
dec $generator_close_drop_claim(ptask*, nat, porigin) : ptask*
dec $generator_close_claim(ptask) : nat*
dec $generator_close_claims(ptask*) : nat*
