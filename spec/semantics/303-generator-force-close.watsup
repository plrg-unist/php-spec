def $error_read_shape(GENERATOR_FROM_EVAL porigin, VARIABLE n* z, pbase) = ({ORIGINAL GENERATOR_FROM_EVAL porigin, INPUT VARIABLE n* z, BASE pbase, NAME n*, LINE z, TASK GENERATOR_CLOSE_FROM porigin, RESULT KNOWN PNULL})
