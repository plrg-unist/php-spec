;; PHP8.5.10 shutdown_destructors and zend_generator_dtor_storage.
;; Normal source exhaustion enters the real reverse-global/store passes.

dec $generator_request_terminal(pstate) : bool
dec $generator_request_store_ready(pstate, nat) : bool
dec $generator_request_frame_valid(pstate, pgenerator) : bool
dec $generator_request_store_begin(pstate, nat, nat) : pstate
dec $generator_request_store_valid(pstate, pgenclose) : bool
dec $generator_request_store_tail(ptask*) : bool
dec $generator_request_tail(pstate, ptask*) : bool
dec $generator_request_tail_task(ptask) : bool
dec $generator_request_root(pstate) : bool
dec $generator_request_resume_valid(pstate, pgenclose) : bool
dec $generator_request_resume_position(ptask*, pgenclose) : bool
dec $generator_request_resume_plain(ptask*, pgenclose) : bool
dec $generator_request_finish_tail(ptask*) : bool
dec $generator_request_retired_valid(pstate, (nat, nat)*, nat*) : bool
dec $generator_request_retired_nodes((nat, nat)*) : pnode*
dec $generator_request_retired_filter(pstate, (nat, nat)*) : (nat, nat)*

def $generator_request_terminal(S) = (S.COMPLETION = NORMAL /\ S.TODO = eps /\ S.FRAMES = eps /\ S.CURRENT = eps /\ S.CONSTCONTEXT = eps /\ S.ACTIVEFIBER = eps /\ ~S.COMPILESTOP /\ S.DESTRUCTION.PHASE = DESTRUCTION_PENDING /\ S.SHUTDOWN.PHASE <- [SHUTDOWN_PENDING, SHUTDOWN_DONE])
def $generator_request_operational(S) = true
  -- if S.DESTRUCTION.PHASE <- [DESTRUCTION_GLOBALS, DESTRUCTION_STORE]
def $generator_request_operational(S) = true
  -- if $generator_request_terminal(S)
  -- if $generator_close_any_started(S, S.ALLOCATIONS)
def $generator_request_prune_ready(S) = true
  -- if $generator_request_terminal(S)
  -- if $shutdown_ready(S) \/ $destructor_ready(S)
def $generator_prune(S, pnode_live*) = S
  -- if ~$generator_close_dead(S, S.ALLOCATIONS, pnode_live*)
  -- if $generator_request_prune_ready(S)

def $generator_request_frame_valid(S, pgenerator) = true
  -- if pgenerator.PHASE = GENERATOR_PAUSED /\ pgenerator.DELEGATE = eps
  -- if $generator_record_valid(S, pgenerator)
  -- if pgenerator.FRAME = (pframe)
  -- if pframe.ORIGIN = (porigin)
  -- if $generator_close_site(S, pgenerator, porigin)
  -- if $generator_close_frame_valid(S, pgenerator, pframe)
  -- if S_scope = $generator_frame_scope(S, pframe)
  -- if $generator_close_plan_valid(S_scope, porigin, pframe.TODO, 0)
  -- if $generator_close_original_tasks_valid(S_scope, porigin, pframe.TODO)
def $generator_request_frame_valid(S, pgenerator) = false -- otherwise

;; Store dtor_obj holds an additional native object pin. It closes execution
;; even when globals, reference cells or containers still own the Generator.
def $generator_request_store_ready(S, n) = true
  -- if S.COMPLETION = NORMAL /\ S.ACTIVEFIBER = eps
  -- if S.TODO = [DESTRUCTOR_STORE]
  -- if $call_task_valid(S, DESTRUCTOR_STORE)
  -- if $(S.DESTRUCTION.INDEX < S.DESTRUCTION.NEXT)
  -- if $destructor_handle(S, S.DESTRUCTION.INDEX, 0) = (n)
  -- if ~(n <- S.DESTRUCTION.CALLED)
  -- if S.OBJECTS[n] = GENERATOR pgenerator
  -- if $generator_request_frame_valid(S, pgenerator)
def $generator_request_store_ready(S, n) = false -- otherwise
def $generator_request_store_begin(S, n, n_handle) = $generator_close_prepare_store(S_queued, pgenrelease, n, (n_handle))
  -- if pgenrelease = {JOBS eps, VALUE S.RESULT, BASE S.BASE, PENDING eps, COMPLETION NORMAL}
  -- if S_queued = S[.DESTRUCTION.INDEX = $(n_handle + 1)][.DESTRUCTION.CALLED = S.DESTRUCTION.CALLED ++ [n]][.TODO = (GENERATOR_CLOSE_RELEASE pgenrelease) :: S.TODO]
rule PhpStep/generator-request-store-close: S ~> $generator_request_store_begin(S, n, S.DESTRUCTION.INDEX)
  -- if $destructor_handle(S, S.DESTRUCTION.INDEX, 0) = (n)
  -- if $generator_request_store_ready(S, n)
rule PhpStep/generator-request-store-refused: S ~> S[.COMPLETION = UNSUPPORTED "Generator request-store close continuation"]
  -- if S.TODO = [DESTRUCTOR_STORE]
  -- if $call_task_valid(S, DESTRUCTOR_STORE)
  -- if $(S.DESTRUCTION.INDEX < S.DESTRUCTION.NEXT)
  -- if $destructor_handle(S, S.DESTRUCTION.INDEX, 0) = (n)
  -- if ~(n <- S.DESTRUCTION.CALLED)
  -- if $generator_destructor_pending(S, HOBJECT n)
  -- if ~$generator_request_store_ready(S, n)

def $generator_request_store_tail([DESTRUCTOR_STORE]) = true
def $generator_request_store_tail((DESTRUCTOR_RELEASE pdestructionrelease) :: ptask*) = $generator_request_store_tail(ptask*)
def $generator_request_store_tail(ptask :: ptask_tail*) = $generator_request_store_tail(ptask_tail*)
  -- if $generator_request_tail_task(ptask)
def $generator_request_store_tail(ptask*) = false -- otherwise
def $generator_request_store_valid(S, pgenclose) = true
  -- if pgenclose.STORE = (n_handle)
  -- if S.DESTRUCTION.PHASE = DESTRUCTION_STORE
  -- if $shutdown_task_scope(S) /\ S.ORIGIN = eps /\ S.ACTIVEFIBER = eps
  -- if pgenclose.CALLER = eps /\ pgenclose.CALLSITE = eps
  -- if pgenclose.OBJECT <- S.DESTRUCTION.CALLED
  -- if $destructor_handle(S, n_handle, 0) = (pgenclose.OBJECT)
  -- if S.DESTRUCTION.INDEX = $(n_handle + 1)
  -- if $generator_request_store_tail(S.TODO)
def $generator_request_store_valid(S, pgenclose) = false -- otherwise
def $generator_close_owner_valid(S, pgenclose) = $generator_request_store_valid(S, pgenclose)
  -- if pgenclose.STORE = (n_handle)
def $generator_close_request_valid(S, pgenclose) = $generator_request_store_valid(S, pgenclose)
  -- if pgenclose.STORE = (n_handle)
def $generator_close_destructor_ready(S, pgenrelease) = true
  -- if $generator_request_root(S)
  -- if S.TODO = (GENERATOR_CLOSE_RELEASE pgenrelease) :: ptask*
  -- if pgenrelease.PENDING = eps
  -- if $generator_close_release_valid(S, pgenrelease)
  -- if $generator_request_tail(S, ptask*)

;; With no execute_data caller, zend_generator_resume invokes the registered
;; exception handler before dtor_obj returns to free_storage. Transfer the one
;; close pin into RESUME so the cache remains owned through handler cleanup.
def $generator_request_root(S) = ($shutdown_task_scope(S) /\ S.ORIGIN = eps /\ S.ACTIVEFIBER = eps /\ S.SHUTDOWN.PHASE = SHUTDOWN_DONE /\ $destructor_active(S))
def $generator_request_tail(S, [DESTRUCTOR_GLOBALS]) = (S.DESTRUCTION.PHASE = DESTRUCTION_GLOBALS /\ $destructor_pass_valid(S))
def $generator_request_tail(S, [DESTRUCTOR_STORE]) = (S.DESTRUCTION.PHASE = DESTRUCTION_STORE /\ $(S.DESTRUCTION.INDEX >= 1) /\ $(S.DESTRUCTION.INDEX <= S.DESTRUCTION.NEXT))
def $generator_request_tail(S, (DESTRUCTOR_RELEASE pdestructionrelease) :: ptask*) = ($destructor_release_valid(S, pdestructionrelease) /\ ~pdestructionrelease.USER /\ $generator_request_tail(S, ptask*))
def $generator_request_tail(S, ptask :: ptask_tail*) = $generator_request_tail(S, ptask_tail*)
  -- if $generator_request_tail_task(ptask)
def $generator_request_tail(S, ptask*) = false -- otherwise
def $generator_request_tail_task(GENERATOR_CLOSE_RELEASE pgenrelease) = true
def $generator_request_tail_task(GENERATOR_CLOSE_ENTER pgenclose) = true
def $generator_request_tail_task(GENERATOR_CLOSE_DONE pgenclose) = true
def $generator_request_tail_task(GENERATOR_REQUEST_RESUME pgenclose) = true
def $generator_request_tail_task(EXCEPTION_HANDLER_INVOKE pexceptioncall) = true
def $generator_request_tail_task(EXCEPTION_HANDLER_ENTER pexceptioncall) = true
def $generator_request_tail_task(EXCEPTION_HANDLER_RESULT pexceptioncall) = true
def $generator_request_tail_task(EXCEPTION_HANDLER_CLEAN pexceptioncall b) = true
def $generator_request_tail_task(DESTRUCTOR_OPERATION_EXIT pdestructionoperation) = true
def $generator_request_tail_task(DESTRUCTOR_FRAME_EXIT pdestructionframe) = true
def $generator_request_tail_task(THROW_SEARCH n) = true
def $generator_request_tail_task(ptask) = false -- otherwise
def $generator_request_done_pending(S, pgenclose) = true
  -- if S.TODO = (GENERATOR_CLOSE_DONE pgenclose) :: ptask*
  -- if pgenclose.PENDING = (n)
  -- if $generator_request_root(S) /\ $generator_request_tail(S, ptask*)
def $generator_close_done(S, pgenclose) = S[.TODO = (THROW_SEARCH n) :: (GENERATOR_REQUEST_RESUME pgenclose[.PENDING = eps]) :: ptask*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if $generator_request_done_pending(S, pgenclose)
  -- if S.TODO = (GENERATOR_CLOSE_DONE pgenclose) :: ptask*
  -- if pgenclose.PENDING = (n)
  -- if S.EXCEPTIONHANDLER = (pvalue)
def $generator_close_done(S, pgenclose) = S[.COMPLETION = UNSUPPORTED "Generator request-close uncaught exception"]
  -- if $generator_request_done_pending(S, pgenclose)
  -- if S.EXCEPTIONHANDLER = eps
def $generator_request_resume_valid(S, pgenclose) = true
  -- if $generator_request_root(S)
  -- if pgenclose.STAGE = CLOSE_FINISHED /\ pgenclose.PENDING = eps
  -- if pgenclose.CALLER = eps /\ pgenclose.CALLSITE = eps
  -- if $generator_close_done_valid(S, pgenclose)
  -- if $generator_request_tail(S, S.TODO)
  -- if $generator_request_resume_position(S.TODO, pgenclose)
def $generator_request_resume_valid(S, pgenclose) = false -- otherwise
def $generator_request_resume_position((THROW_SEARCH n) :: ptask*, pgenclose) = $generator_request_resume_plain(ptask*, pgenclose)
def $generator_request_resume_position(ptask*, pgenclose) = $generator_request_resume_plain(ptask*, pgenclose) -- otherwise
def $generator_request_resume_plain((GENERATOR_REQUEST_RESUME pgenclose) :: ptask*, pgenclose) = $generator_request_finish_tail(ptask*)
def $generator_request_resume_plain((EXCEPTION_HANDLER_INVOKE pexceptioncall) :: ptask*, pgenclose) = $generator_request_resume_plain(ptask*, pgenclose)
def $generator_request_resume_plain((EXCEPTION_HANDLER_ENTER pexceptioncall) :: ptask*, pgenclose) = $generator_request_resume_plain(ptask*, pgenclose)
def $generator_request_resume_plain((EXCEPTION_HANDLER_RESULT pexceptioncall) :: ptask*, pgenclose) = $generator_request_resume_plain(ptask*, pgenclose)
def $generator_request_resume_plain((EXCEPTION_HANDLER_CLEAN pexceptioncall b) :: ptask*, pgenclose) = $generator_request_resume_plain(ptask*, pgenclose)
def $generator_request_resume_plain((DESTRUCTOR_RELEASE pdestructionrelease) :: ptask*, pgenclose) = $generator_request_resume_plain(ptask*, pgenclose)
def $generator_request_resume_plain((DESTRUCTOR_OPERATION_EXIT pdestructionoperation) :: ptask*, pgenclose) = $generator_request_resume_plain(ptask*, pgenclose)
def $generator_request_resume_plain((DESTRUCTOR_FRAME_EXIT pdestructionframe) :: ptask*, pgenclose) = $generator_request_resume_plain(ptask*, pgenclose)
def $generator_request_resume_plain(ptask*, pgenclose) = false -- otherwise
def $generator_request_finish_tail([DESTRUCTOR_GLOBALS]) = true
def $generator_request_finish_tail([DESTRUCTOR_STORE]) = true
def $generator_request_finish_tail((DESTRUCTOR_RELEASE pdestructionrelease) :: ptask*) = $generator_request_finish_tail(ptask*)
def $generator_request_finish_tail((GENERATOR_CLOSE_RELEASE pgenrelease) :: ptask*) = $generator_request_finish_tail(ptask*)
def $generator_request_finish_tail((GENERATOR_CLOSE_ENTER pgenclose) :: ptask*) = $generator_request_finish_tail(ptask*)
def $generator_request_finish_tail((GENERATOR_CLOSE_DONE pgenclose) :: ptask*) = $generator_request_finish_tail(ptask*)
def $generator_request_finish_tail(ptask*) = false -- otherwise
def $call_task_valid(S, GENERATOR_REQUEST_RESUME pgenclose) = $generator_request_resume_valid(S, pgenclose)
def $task_nodes(GENERATOR_REQUEST_RESUME pgenclose) = [HOBJECT pgenclose.OBJECT]
def $generator_close_claim(GENERATOR_REQUEST_RESUME pgenclose) = [pgenclose.OBJECT]
def $generator_internal_task(GENERATOR_REQUEST_RESUME pgenclose) = true
def $exception_terminal_tail(S, (GENERATOR_REQUEST_RESUME pgenclose) :: ptask*) = (S.EXCEPTIONHANDLER =/= eps /\ $generator_request_resume_valid(S, pgenclose))
def $throwable_marker(GENERATOR_REQUEST_RESUME pgenclose) = true
rule PhpStep/generator-request-resume: S ~> $generator_close_release_claim(S[.TODO = ptask*], pgenclose)
  -- if S.TODO = (GENERATOR_REQUEST_RESUME pgenclose) :: ptask*
  -- if $generator_request_resume_valid(S, pgenclose)

;; Object-store dtor_obj ends with bare GC_DELREF, not OBJ_RELEASE. A zero-ref
;; bucket and its cache remain allocated until real acquisition or storage free.
;; RETIRED authenticates that bucket; it contributes no physical heap root.
def $eager_explicit_task(GENERATOR_CLOSE_DONE pgenclose) = true
  -- if pgenclose.STORE =/= eps /\ pgenclose.PENDING = eps
def $eager_explicit_task(GENERATOR_REQUEST_RESUME pgenclose) = true
  -- if pgenclose.STORE =/= eps
def $generator_close_release_claim(S, pgenclose) = S
  -- if pgenclose.STORE = (n_handle)
  -- if pgenclose.PENDING = eps
  -- if $generator_request_store_valid(S, pgenclose)
  -- if $($heap_owners($heap_graph(S), HOBJECT pgenclose.OBJECT) > 0)
def $generator_close_release_claim(S, pgenclose) = S[.DESTRUCTION.RETIRED = S.DESTRUCTION.RETIRED ++ [(pgenclose.OBJECT, n_handle)]]
  -- if pgenclose.STORE = (n_handle)
  -- if pgenclose.PENDING = eps
  -- if $generator_request_store_valid(S, pgenclose)
  -- if $heap_owners($heap_graph(S), HOBJECT pgenclose.OBJECT) = 0
def $generator_request_retired_nodes(eps) = eps
def $generator_request_retired_nodes((n_object, n_handle) :: (n_tail, n_handle_tail)*) = (HOBJECT n_object) :: $generator_request_retired_nodes((n_tail, n_handle_tail)*)
def $generator_request_retired_keep(S) = $heap_reach($generator_request_retired_nodes(S.DESTRUCTION.RETIRED), eps, $heap_graph(S).EDGES)
  -- if S.DESTRUCTION.RETIRED =/= eps
def $gc_prune_nodes(S) = $gc_prune_graph($heap_graph(S), $gc_keep(S)).NODES
  -- if S.GC.ACTIVE = eps /\ $gc_bare_nodes(S.GC.BUFFER) = eps
  -- if S.DESTRUCTION.RETIRED =/= eps
def $gc_prune_nodes_graph(S, H) = $gc_prune_graph(H, $gc_keep(S)).NODES
  -- if S.GC.ACTIVE = eps /\ $gc_bare_nodes(S.GC.BUFFER) = eps
  -- if S.DESTRUCTION.RETIRED =/= eps
def $generator_request_retired_filter(S, eps) = eps
def $generator_request_retired_filter(S, (n_object, n_handle) :: (n_tail, n_handle_tail)*) = (n_object, n_handle) :: $generator_request_retired_filter(S, (n_tail, n_handle_tail)*)
  -- if (HOBJECT n_object) <- S.ALLOCATIONS
  -- if $heap_owners($heap_graph(S), HOBJECT n_object) = 0
def $generator_request_retired_filter(S, (n_object, n_handle) :: (n_tail, n_handle_tail)*) = $generator_request_retired_filter(S, (n_tail, n_handle_tail)*)
  -- if ~((HOBJECT n_object) <- S.ALLOCATIONS) \/ $($heap_owners($heap_graph(S), HOBJECT n_object) > 0)
def $generator_request_transition_prepare(S) = S[.DESTRUCTION.RETIRED = $generator_request_retired_filter(S, S.DESTRUCTION.RETIRED)]
  -- if S.DESTRUCTION.RETIRED =/= eps
def $generator_request_retired_state_valid(S) = $generator_request_retired_valid(S, S.DESTRUCTION.RETIRED, eps)
  -- if S.DESTRUCTION.RETIRED =/= eps
def $generator_request_retired_valid(S, eps, nat*) = true
def $generator_request_retired_valid(S, (n_object, n_handle) :: (n_tail, n_handle_tail)*, nat*) = true
  -- if S.DESTRUCTION.PHASE <- [DESTRUCTION_STORE, DESTRUCTION_DONE]
  -- if S.DESTRUCTION.NOREUSE /\ $(n_handle < S.DESTRUCTION.INDEX)
  -- if n_object <- S.DESTRUCTION.CALLED /\ ~(n_object <- nat*)
  -- if $destructor_handle(S, n_handle, 0) = (n_object)
  -- if S.OBJECTS[n_object] = GENERATOR pgenerator
  -- if pgenerator.PHASE = GENERATOR_CLOSED /\ pgenerator.FRAME = eps
  -- if $heap_owners($heap_graph(S), HOBJECT n_object) = 0
  -- if $generator_request_retired_valid(S, (n_tail, n_handle_tail)*, n_object :: nat*)
def $generator_request_retired_valid(S, (n_object, n_handle)*, nat*) = false -- otherwise
rule PhpStep/generator-request-handler-abrupt: S ~> S[.COMPLETION = UNSUPPORTED "Generator request-close exception-handler failure"]
  -- if $generator_request_handler_abrupt(S)
def $generator_request_handler_abrupt(S) = true
  -- if S.TODO = (THROW_SEARCH n) :: (GENERATOR_REQUEST_RESUME pgenclose) :: ptask*
  -- if $generator_request_resume_valid(S, pgenclose)
  -- if S.EXCEPTIONHANDLER = eps
def $generator_request_handler_abrupt(S) = true
  -- if S.TODO = (THROW_SEARCH n) :: (EXCEPTION_HANDLER_RESULT pexceptioncall) :: (GENERATOR_REQUEST_RESUME pgenclose) :: ptask*
  -- if $exception_task_scope(S) /\ $exception_result_valid(S, pexceptioncall)
  -- if S.EXCEPTIONHANDLER = eps
  -- if S.EXCEPTIONHANDLERS = (pexceptioncall.CALLBACK) :: (pvalue?)*
  -- if $generator_request_resume_valid(S, pgenclose)
