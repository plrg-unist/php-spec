dec $named_roots((preqbytes, poperand)*) : pnode*
dec $named_slots_roots(pnamedslot*) : pnode*
dec $instance_roots(nat?) : pnode*
def $instance_roots(eps) = eps
def $instance_roots((n)) = [HOBJECT n]
dec $wrapper_roots(pnamedargs?) : pnode*
def $wrapper_roots(eps) = eps
def $wrapper_roots((pnamedargs)) = $named_slots_roots(pnamedargs.SLOTS) ++ $named_roots(pnamedargs.NAMED)
;; An active symbol table is moved, never copied, across the main/function edge.
dec $active_table(pstate) : psymboltable
def $active_table(S) = {ENV S.ENV, CVS S.CVS, SYMBOLS S.SYMBOLS}
dec $set_active_table(pstate, psymboltable) : pstate
def $set_active_table(S, psymboltable) = S[.ENV = psymboltable.ENV][.CVS = psymboltable.CVS][.SYMBOLS = psymboltable.SYMBOLS]
dec $empty_table() : psymboltable
def $empty_table() = {ENV eps, CVS eps, SYMBOLS eps}

dec $operands_roots(poperand*) : pnode*
def $operands_roots(eps) = eps
def $operands_roots(poperand :: poperand_tail*) = $operand_nodes(poperand) ++ $operands_roots(poperand_tail*)
def $table_roots(eps) = eps
def $table_roots((psymboltable)) = $environment_nodes(psymboltable.ENV)
dec $call_target_extra_roots(pcallcontext) : pnode*
def $call_target_extra_roots(pcallcontext) = [HOBJECT n]
  -- if pcallcontext.TARGET = METHOD_TARGET n porigin
  -- if pcallcontext.RECEIVER = eps
def $call_target_extra_roots(pcallcontext) = $operand_nodes(poperand_selector)
  -- if pcallcontext.TARGET = SCOPED_TARGET porigin_requested porigin_method porigin_called n_receiver? poperand_selector
def $call_target_extra_roots(pcallcontext) = eps -- otherwise
def $call_context_roots(eps) = eps
def $call_context_roots((pcallcontext)) = $instance_roots(pcallcontext.INSTANCE) ++ $instance_roots(pcallcontext.RECEIVER) ++ $call_target_extra_roots(pcallcontext) ++ $operands_roots(pcallcontext.EXTRA) ++ $named_roots(pcallcontext.NAMED) ++ $wrapper_roots(pcallcontext.WRAPPER)
def $frames_roots(eps) = eps
def $frames_roots(pframe :: pframe_tail*) = $table_roots(pframe.LOCALS) ++ $tasks_nodes(pframe.TODO) ++ pframe.HELD ++ $call_context_roots(pframe.CONTEXT) ++ $frames_roots(pframe_tail*)

dec $save_frame(pstate) : pstate
def $save_frame(S) = $set_active_table(S[.GLOBALTABLE = ($active_table(S))][.FRAMES = [{SILENCES S.SILENCES, LOCALS eps, TODO S.TODO, ORIGIN S.ORIGIN, HELD S.HELD, CONTEXT S.CURRENT, BORROWEDREAD S.BORROWEDREAD, OBJECTCAST S.OBJECTCAST, CONSTCONTEXT S.CONSTCONTEXT}]][.TODO = eps][.HELD = eps][.CURRENT = eps][.BORROWEDREAD = eps][.OBJECTCAST = eps][.CONSTCONTEXT = eps][.SILENCES = eps][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], $empty_table())
  -- if S.GLOBALTABLE = eps
  -- if S.FRAMES = eps
  -- if S.CURRENT = eps
def $save_frame(S) = $set_active_table(S[.FRAMES = {SILENCES S.SILENCES, LOCALS ($active_table(S)), TODO S.TODO, ORIGIN S.ORIGIN, HELD S.HELD, CONTEXT S.CURRENT, BORROWEDREAD S.BORROWEDREAD, OBJECTCAST S.OBJECTCAST, CONSTCONTEXT S.CONSTCONTEXT} :: S.FRAMES][.TODO = eps][.HELD = eps][.CURRENT = eps][.BORROWEDREAD = eps][.OBJECTCAST = eps][.CONSTCONTEXT = eps][.SILENCES = eps][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], $empty_table())
  -- if S.GLOBALTABLE = (psymboltable)

;; RESULT already owns the returned operand when the callee table is released.
dec $restore_frame(pstate) : pstate
dec $restore_frame_raw(pstate) : pstate
dec $restore_frame_locals(pstate, pframe, pframe*, psymboltable?) : pstate
dec $frame_release(pstate, pstate) : pstate
def $restore_frame(S) = $frame_release(S, $restore_frame_raw(S))
def $restore_frame_raw(S) = $restore_frame_locals(S, pframe, pframe_tail*, pframe.LOCALS)
  -- if S.FRAMES = pframe :: pframe_tail*
def $restore_frame_locals(S, pframe, eps, eps) = $set_active_table(S[.GLOBALTABLE = eps][.FRAMES = eps][.SILENCES = pframe.SILENCES][.TODO = pframe.TODO][.ORIGIN = pframe.ORIGIN][.HELD = pframe.HELD][.CURRENT = pframe.CONTEXT][.BORROWEDREAD = pframe.BORROWEDREAD][.OBJECTCAST = pframe.OBJECTCAST][.CONSTCONTEXT = pframe.CONSTCONTEXT][.BASE = BASE_VALUE (KNOWN PNULL)], psymboltable)
  -- if S.GLOBALTABLE = (psymboltable)
def $restore_frame_locals(S, pframe, pframe_tail*, (psymboltable)) = $set_active_table(S[.FRAMES = pframe_tail*][.SILENCES = pframe.SILENCES][.TODO = pframe.TODO][.ORIGIN = pframe.ORIGIN][.HELD = pframe.HELD][.CURRENT = pframe.CONTEXT][.BORROWEDREAD = pframe.BORROWEDREAD][.OBJECTCAST = pframe.OBJECTCAST][.CONSTCONTEXT = pframe.CONSTCONTEXT][.BASE = BASE_VALUE (KNOWN PNULL)], psymboltable)

;; Saved initializer facts use the caller's scope, while the global class
;; initialization stack remains available for runtime recursion protection.
dec $constant_frame_view(pstate, pframe, pframe*) : pstate
def $constant_frame_view(S, pframe, pframe_tail*) = S[.FRAMES = pframe_tail*][.ORIGIN = pframe.ORIGIN][.CURRENT = pframe.CONTEXT][.TODO = pframe.TODO][.BORROWEDREAD = pframe.BORROWEDREAD][.OBJECTCAST = pframe.OBJECTCAST][.CONSTCONTEXT = pframe.CONSTCONTEXT][.HELD = pframe.HELD][.CLASSCONSTANTINIT = $class_constant_frame_stack(S, pframe, pframe_tail*)]
dec $constant_frame_scope(pstate, pframe, pframe*) : pstate
def $constant_frame_scope(S, pframe, pframe_tail*) = $set_active_table($constant_frame_view(S, pframe, pframe_tail*), psymboltable)
  -- if pframe.LOCALS = (psymboltable)
def $constant_frame_scope(S, pframe, pframe_tail*) = $set_active_table($constant_frame_view(S, pframe, pframe_tail*), psymboltable)
  -- if pframe.LOCALS = eps
  -- if S.GLOBALTABLE = (psymboltable)
def $constant_frame_scope(S, pframe, pframe_tail*) = $constant_frame_view(S, pframe, pframe_tail*) -- otherwise

;; This involution is a scoped helper view, never an observable machine step.
;; Call it exactly once before and after a table-local global operation.
def $global_table_view(S) = S -- if S.GLOBALTABLE = eps
def $global_table_view(S) = $set_active_table(S[.GLOBALTABLE = ($active_table(S))], psymboltable)
  -- if S.GLOBALTABLE = (psymboltable)
