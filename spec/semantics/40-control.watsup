dec $drive(pstate, nat) : pstate
def $drive(S, n) = S
  -- if S.TODO = eps
def $drive(S, n) = S[.TODO = eps]
  -- if S.TODO = ptask :: ptask_tail*
  -- if S.COMPLETION =/= NORMAL
def $drive(S, 0) = S[.COMPLETION = BUDGET]
  -- if S.TODO = ptask :: ptask_tail*
  -- if S.COMPLETION = NORMAL
def $drive(S, n) = $drive(S_next, n_next)
  -- if S.TODO = ptask :: ptask_tail*
  -- if S.COMPLETION = NORMAL
  -- if $(n > 0)
  -- if $(n - 1) = n_next
  -- PhpStep: S ~> S_next

dec $initial_state(pcompletion) : pstate
def $initial_state(pcompletion) = {TODO eps, EVENTS eps, COMPLETION pcompletion, ENV eps, STORE eps, RESULT KNOWN PNULL, CELL 0}
dec $run_statements(statement*, nat) : pstate
def $run_statements(statement_tail*, n) = $drive(S[.TODO = $statement_tasks(statement_tail*)], n)
  -- if $check_statements(statement_tail*) = READY
  -- if S = $initial_state(NORMAL)
def $run_statements(statement_tail*, n) = $initial_state(pcompletion)
  -- if $check_statements(statement_tail*) = REJECT pcompletion

dec $php_run(program, nat) : pstate
def $php_run(PROGRAM statement_tail*, n) = $run_statements(statement_tail*, n)
def $php_run(ENCODEDPROGRAM text_source text_lexer text_bom text_preamble text_original? statement_tail*, n) = $run_statements(statement_tail*, n)
