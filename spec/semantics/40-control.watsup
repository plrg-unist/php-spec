rule PhpStep/assign-name: S ~> S[.TODO = [EVAL expression, WRITE_NAME n_name* $variable_line(phpType34, metadata_1)] ++ ptask_tail*]
  -- if S.TODO = (EVAL (NExprAssign (NExprVariable phpType34 metadata_1) expression metadata_2)) :: ptask_tail*
