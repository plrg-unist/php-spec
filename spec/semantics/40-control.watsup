dec $cv_name(phpType34) : (nat*)?
def $cv_name(BYTES text) = ($base64(text))
def $cv_name(NScalarString (BYTES text) metadata) = ($base64(text))
def $cv_name(NScalarInt (INTEGER z) metadata) = ($decimal_integer(z))
def $cv_name(phpType34) = eps
  -- otherwise

;; A CV operand is read by its consumer; dynamic FETCH_R captures a value.
dec $atomic_expression(expression) : bool
def $atomic_expression(NScalarString phpType35 metadata) = true
def $atomic_expression(NScalarInt phpType24 metadata) = true
def $atomic_expression(NScalarFloat phpType43 metadata) = true
def $atomic_expression(NExprConstFetch name metadata) = true
def $atomic_expression(expression) = false
  -- otherwise

dec $statement_tasks(statement*) : ptask*
def $statement_tasks(statement_tail*) = (STMT statement_tail)*
dec $echo_tasks(expression*) : ptask*
def $echo_tasks(eps) = eps
def $echo_tasks(expression :: expression_tail*) = [EVAL expression, EMIT $compiled_line(expression)] ++ $echo_tasks(expression_tail*)
dec $unset_tasks(expression*) : ptask*
def $unset_tasks(expression_tail*) = (UNSET expression_tail)*

relation PhpStep: pstate ~> pstate
  hint(input %0)
rule PhpStep/nop: S ~> S[.TODO = ptask_tail*]
  -- if S.TODO = (STMT (NStmtNop metadata)) :: ptask_tail*
rule PhpStep/block: S ~> S[.TODO = $statement_tasks(statement_tail*) ++ ptask_tail*]
  -- if S.TODO = (STMT (NStmtBlock (SEQUENCE statement_tail*) metadata)) :: ptask_tail*
rule PhpStep/inline: S ~> S[.TODO = ptask_tail*][.EVENTS = S.EVENTS ++ [OUTPUT $base64(text)]]
  -- if S.TODO = (STMT (NStmtInlineHTML (BYTES text) metadata)) :: ptask_tail*
rule PhpStep/echo: S ~> S[.TODO = $echo_tasks(expression_tail*) ++ ptask_tail*]
  -- if S.TODO = (STMT (NStmtEcho (SEQUENCE expression_tail*) metadata)) :: ptask_tail*
rule PhpStep/expression: S ~> S[.TODO = (EVAL expression) :: ptask_tail*]
  -- if S.TODO = (STMT (NStmtExpression expression metadata)) :: ptask_tail*
rule PhpStep/unset: S ~> S[.TODO = $unset_tasks(expression_tail*) ++ ptask_tail*]
  -- if S.TODO = (STMT (NStmtUnset (SEQUENCE expression_tail*) metadata)) :: ptask_tail*
rule PhpStep/literal: S ~> S[.TODO = ptask_tail*][.RESULT = KNOWN pvalue]
  -- if S.TODO = (EVAL expression) :: ptask_tail*
  -- if $atomic_expression(expression)
  -- if $evaluate(expression) = VALUE pvalue
rule PhpStep/literal-abrupt: S ~> S[.TODO = eps][.COMPLETION = pcompletion]
  -- if S.TODO = (EVAL expression) :: ptask_tail*
  -- if $atomic_expression(expression)
  -- if $evaluate(expression) = ABRUPT pcompletion
rule PhpStep/variable: S ~> S[.TODO = ptask_tail*][.RESULT = VARIABLE n_name* $variable_line(phpType34, metadata)]
  -- if S.TODO = (EVAL (NExprVariable phpType34 metadata)) :: ptask_tail*
