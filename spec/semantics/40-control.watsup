dec $drive(pstate, nat) : pstate
def $drive(S, n) = S
  -- if S.TODO = eps
  -- if S.COMPLETION = NORMAL
def $drive(S, n) = S
  -- if S.COMPLETION = BUDGET
def $drive(S, n) = $prune_allocations($release_temporaries(S))
  -- if (S.COMPLETION =/= NORMAL /\ S.COMPLETION =/= BUDGET)
def $drive(S, 0) = S[.COMPLETION = BUDGET]
  -- if S.TODO = ptask :: ptask_tail*
  -- if S.COMPLETION = NORMAL
def $drive(S, n) = $drive($prune_allocations(S_next), n_next)
  -- if S.TODO = ptask :: ptask_tail*
  -- if S.COMPLETION = NORMAL
  -- if $(n > 0)
  -- if $(n - 1) = n_next
  -- PhpStep: S ~> S_next

def $initial_state(pcompletion) = {REQUEST eps, SYMBOLS eps, CVS eps, HTTPROOTS eps, ACTIVATED eps, TODO eps, EVENTS eps, COMPLETION pcompletion, ENV eps, STORE eps, REFCELLS eps, RESULT KNOWN PNULL, CELL 0, ARRAYS eps, KEY KINT 0, BASE BASE_VALUE (KNOWN PNULL), LOCATION ROOT 0, ALLOCATIONS eps, HELD eps, SOURCES eps, ORIGIN eps, POOLS eps, FILES eps, CODE eps, ITERATORS eps, NEXTITER 0}
dec $source_filename(nat*) : bool
def $source_filename(n*) = (n* =/= eps /\ ~(0 <- n*))
dec $php_run(program, nat, text) : pstate
def $php_run(program, n, text_file) = $drive($compile_source($initial_state(NORMAL)[.FILES = [SOURCEFILE 0 n_file*]], $ppstart(0, program, n_file*)), n)
  -- if n_file* = $base64(text_file)
  -- if $source_filename(n_file*)
def $php_run(program, n, text_file) = $initial_state(UNSUPPORTED "invalid source filename")
  -- if ~$source_filename($base64(text_file))

def $cv_name(NExprBinaryOpConcat expression_1 expression_2 metadata) = (n*)
  -- if $parser_literal(NExprBinaryOpConcat expression_1 expression_2 metadata) = (PSTRING n*)
