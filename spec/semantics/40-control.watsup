rule PhpStep/binary-plus: S ~> S[.TODO = [EVAL expression_1, BINARY_LEFT ADD expression_2 $compiled_line(expression_2)] ++ ptask_tail*]
  -- if S.TODO = (EVAL (NExprBinaryOpPlus expression_1 expression_2 metadata)) :: ptask_tail*
