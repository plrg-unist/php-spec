rule PhpStep/assign-dynamic: S ~> S[.TODO = [EVAL expression_name, PREP_ASSIGN expression $variable_line(phpType34, metadata_1)] ++ ptask_tail*]
  -- if S.TODO = (EVAL (NExprAssign (NExprVariable phpType34 metadata_1) expression metadata_2)) :: ptask_tail*
