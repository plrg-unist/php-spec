def $cv_name(BYTES text) = ($base64(text))
def $cv_name(NScalarString (BYTES text) metadata) = ($base64(text))
def $cv_name(NScalarInt (INTEGER z) metadata) = ($decimal_integer(z))
def $cv_name(NScalarFloat (FLOAT text) metadata) = ($echo_value(PFLOAT $hex_bits(text, 0)))
def $cv_name(phpType32) = eps
  -- otherwise

;; Current source execution is global: direct FETCH_THIS cannot obtain an object.
;; Computed local names retain FETCH_R/RW behavior instead of using this opcode.
def $direct_this(phpType32) = ($cv_name(phpType32) = ([116,104,105,115]))
def $global_this_error(S, z) = $throw_scalar(S, "Error", [85,115,105,110,103,32,36,116,104,105,115,32,119,104,101,110,32,110,111,116,32,105,110,32,111,98,106,101,99,116,32,99,111,110,116,101,120,116], z)

dec $reference_cv(expression) : (nat*)?
def $reference_cv(NExprVariable phpType32 metadata) = $cv_name(phpType32)
  -- if ~$direct_this(phpType32)
def $reference_cv(expression) = eps
  -- otherwise

;; A CV operand is read by its consumer; dynamic FETCH_R captures a value.
dec $atomic_expression(expression) : bool
def $atomic_expression(NScalarString phpType33 metadata) = true
def $atomic_expression(NScalarInt phpType24 metadata) = true
def $atomic_expression(NScalarFloat phpType41 metadata) = true
def $atomic_expression(NExprConstFetch name metadata) = true
def $atomic_expression(expression) = false
  -- otherwise

relation PhpStep: pstate ~> pstate
  hint(input %0)
rule PhpStep/origin-enter: S ~> $enter_compiled_task(S, porigin, ptask, ptask_tail*)
  -- if S.TODO = (AT porigin ptask) :: ptask_tail*
  -- if $origin_accepts(S.SOURCES, porigin, ptask)
rule PhpStep/origin-invalid: S ~> S[.TODO = eps][.COMPLETION = UNSUPPORTED "invalid task source occurrence"]
  -- if S.TODO = (AT porigin ptask) :: ptask_tail*
  -- if ~$origin_accepts(S.SOURCES, porigin, ptask)
rule PhpStep/origin-return: S ~> S[.TODO = ptask_tail*][.ORIGIN = porigin?]
  -- if S.TODO = (ORIGIN_RETURN porigin?) :: ptask_tail*
rule PhpStep/nop: S ~> S[.TODO = ptask_tail*]
  -- if S.TODO = (STMT (NStmtNop metadata)) :: ptask_tail*
rule PhpStep/block: S ~> S[.TODO = $statement_tasks(statement_tail*, $origin_child(S.ORIGIN, [PCFIELD 0]), 0) ++ ptask_tail*]
  -- if S.TODO = (STMT (NStmtBlock (SEQUENCE statement_tail*) metadata)) :: ptask_tail*
rule PhpStep/inline: S ~> S[.TODO = ptask_tail*][.EVENTS = S.EVENTS ++ [OUTPUT $base64(text)]]
  -- if S.TODO = (STMT (NStmtInlineHTML (BYTES text) metadata)) :: ptask_tail*
rule PhpStep/echo: S ~> S[.TODO = $echo_tasks(S, expression_tail*, $origin_child(S.ORIGIN, [PCFIELD 0]), 0) ++ ptask_tail*]
  -- if S.TODO = (STMT (NStmtEcho (SEQUENCE expression_tail*) metadata)) :: ptask_tail*
rule PhpStep/expression: S ~> S[.TODO = [$at_task($origin_child(S.ORIGIN, [PCFIELD 0]), EVAL expression), DISCARD] ++ ptask_tail*]
  -- if S.TODO = (STMT (NStmtExpression expression metadata)) :: ptask_tail*
rule PhpStep/discard: S ~> S[.TODO = ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = DISCARD :: ptask_tail*
rule PhpStep/unset: S ~> S[.TODO = $unset_tasks(expression_tail*, $origin_child(S.ORIGIN, [PCFIELD 0]), 0) ++ ptask_tail*]
  -- if S.TODO = (STMT (NStmtUnset (SEQUENCE expression_tail*) metadata)) :: ptask_tail*
