  -- if $call_descriptors_valid(S)
def $class_constant_reference_capture_entry(S, poperand_original, phpType19, phpType20, z, ptask_tail*) = false -- otherwise

def $class_constant_class_forward(S, REFERENCE n_reference, expression_class, expression_member, z, ptask_tail*) = $class_constant_member_tasks(S[.TODO = (CLASS_CONST_STRING_CAPTURE porigin_site ptbytes_class z) :: ptask_tail*], expression_class, S.RESULT, expression_member, z)
