def $class_constant_class_forward(S, REFERENCE n_reference, expression_class, NIdentifier (BYTES text_member) metadata_member, z, ptask_tail*) = $class_constant_notice_dispatch(S[.TODO = ptask_tail*], pclassdesc, pclassconstantdesc, pclassdesc.NAME, $base64(text_member), z)
