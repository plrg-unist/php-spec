dec $fiber_named_target(pfunction, ptbytes) : pnamedtarget
;; Fibers have independent VM stacks and live reporting masks. The object arena,
;; zval store, globals, INI, handler registries and allocation nonces are shared.
def $fiber_at(S, n) = (pfiber)
  -- if $(n < |S.OBJECTS|)
  -- if (HOBJECT n) <- S.ALLOCATIONS
  -- if S.OBJECTS[n] = FIBER pfiber
def $fiber_at(S, n) = eps -- otherwise
def $fiber_object(FIBER pfiber) = true
def $fiber_object(pobject) = false -- otherwise
def $fiber_put(S, n, pfiber) = S[.OBJECTS = $object_set(S.OBJECTS, n, FIBER pfiber)]
def $fiber_empty() = {READY false, CALL eps, RAW PNULL, TARGET eps, BIRTH eps, CAPTURE eps, PRODUCER eps, ENTRY eps, FINISH eps, STATUS FIBER_INIT, VM eps, VALUE PNULL, RETURNED false, FAILED false, GRACEFUL false, SEQUENCE 0}
def $object_name(S, n) = $ptascii("Fiber") -- if S.OBJECTS[n] = FIBER pfiber
def $getclass_live_object(S, n) = true
  -- if $(n < |S.OBJECTS|)
  -- if (HOBJECT n) <- S.ALLOCATIONS
  -- if S.OBJECTS[n] = FIBER pfiber
def $class_instanceof(S, POBJECT n, ptbytes) = ($ptlc($typed_callable_name(ptbytes)) = $ptascii("fiber"))
  -- if S.OBJECTS[n] = FIBER pfiber
def $new_has_ctor(S, ptbytes) = true -- if $ptlc(ptbytes) = $ptascii("fiber")
def $new_class(S, ptbytes, z) = S[.OBJECTS = S.OBJECTS ++ [FIBER $fiber_empty()]][.ALLOCATIONS = S.ALLOCATIONS ++ [HOBJECT n]][.RESULT = KNOWN (POBJECT n)][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if $ptlc(ptbytes) = $ptascii("fiber")
  -- if n = |S.OBJECTS|

;; Proof records never own the selected receiver separately from function_name.
def $fiber_vm_nodes(pfibervm) = $environment_nodes(pfibervm.TABLE.ENV) ++ $tasks_nodes(pfibervm.TODO) ++ $frames_roots(pfibervm.FRAMES) ++ $call_context_roots(pfibervm.CURRENT) ++ pfibervm.HELD ++ $operand_nodes(pfibervm.RESULT) ++ $base_nodes(pfibervm.BASE) ++ $trace_roots(pfibervm.TRACE) ++ $trace_roots(pfibervm.ERRORFATALTRACE)
def $fiber_saved_nodes(eps) = eps
def $fiber_saved_nodes((pfibervm)) = $fiber_vm_nodes(pfibervm)
def $fiber_callback_nodes(pfiber) = $operand_nodes(KNOWN pfiber.RAW)
  -- if pfiber.CALL =/= eps /\ pfiber.STATUS =/= FIBER_TERMINATED
def $fiber_callback_nodes(pfiber) = eps -- otherwise
def $node_children(S, HOBJECT n) = $fiber_callback_nodes(pfiber) ++ $fiber_saved_nodes(pfiber.VM) ++ $operand_nodes(KNOWN pfiber.VALUE)
  -- if S.OBJECTS[n] = FIBER pfiber
def $fiber_caller_nodes(eps) = eps

;; Main's symbol table is moved into the shared global slot before switching.
;; A saved main continuation owns no second copy of those bindings.
def $fiber_vm(S) = {GLOBAL (S.GLOBALTABLE = eps), TABLE $fiber_local_table(S), TODO S.TODO, ORIGIN S.ORIGIN, CURRENT S.CURRENT, FRAMES S.FRAMES, DESTRUCTORCALLS S.DESTRUCTION.CALLS, DESTRUCTORRELEASES S.DESTRUCTION.RELEASES, DESTRUCTORFRAMES S.DESTRUCTION.FRAMES, DESTRUCTOROPERATIONS S.DESTRUCTION.OPERATIONS, DESTRUCTORCLEANUPS S.DESTRUCTION.CLEANUPS, HELD S.HELD, RESULT S.RESULT, BASE S.BASE, CELL S.CELL, KEY S.KEY, LOCATION S.LOCATION, REPORTING S.REPORTING, SILENCES S.SILENCES, BORROWEDREAD S.BORROWEDREAD, OBJECTCAST S.OBJECTCAST, CONSTCONTEXT S.CONSTCONTEXT, TRACE S.TRACE, ERRORFATALTRACE S.ERRORFATALTRACE, ERRORORIGIN S.ERRORORIGIN}
def $fiber_local_table(S) = $empty_table() -- if S.GLOBALTABLE = eps
def $fiber_local_table(S) = $active_table(S) -- if S.GLOBALTABLE =/= eps
def $fiber_globals(S) = $active_table(S) -- if S.GLOBALTABLE = eps
def $fiber_globals(S) = psymboltable -- if S.GLOBALTABLE = (psymboltable)
def $fiber_vm_table(S, pfibervm) = $fiber_globals(S) -- if pfibervm.GLOBAL
def $fiber_vm_table(S, pfibervm) = pfibervm.TABLE -- if ~pfibervm.GLOBAL
def $fiber_vm_globals(S, pfibervm) = eps -- if pfibervm.GLOBAL
def $fiber_vm_globals(S, pfibervm) = ($fiber_globals(S)) -- if ~pfibervm.GLOBAL
def $fiber_vm_restore(S, pfibervm) = $set_active_table(S[.GLOBALTABLE = $fiber_vm_globals(S, pfibervm)][.TODO = pfibervm.TODO][.ORIGIN = pfibervm.ORIGIN][.CURRENT = pfibervm.CURRENT][.FRAMES = pfibervm.FRAMES][.DESTRUCTION.CALLS = pfibervm.DESTRUCTORCALLS][.DESTRUCTION.RELEASES = pfibervm.DESTRUCTORRELEASES][.DESTRUCTION.FRAMES = pfibervm.DESTRUCTORFRAMES][.DESTRUCTION.OPERATIONS = pfibervm.DESTRUCTOROPERATIONS][.DESTRUCTION.CLEANUPS = pfibervm.DESTRUCTORCLEANUPS][.HELD = pfibervm.HELD][.RESULT = pfibervm.RESULT][.BASE = pfibervm.BASE][.CELL = pfibervm.CELL][.KEY = pfibervm.KEY][.LOCATION = pfibervm.LOCATION][.REPORTING = pfibervm.REPORTING][.SILENCES = pfibervm.SILENCES][.BORROWEDREAD = pfibervm.BORROWEDREAD][.OBJECTCAST = pfibervm.OBJECTCAST][.CONSTCONTEXT = pfibervm.CONSTCONTEXT][.TRACE = pfibervm.TRACE][.ERRORFATALTRACE = pfibervm.ERRORFATALTRACE][.ERRORORIGIN = pfibervm.ERRORORIGIN], $fiber_vm_table(S, pfibervm))
def $fiber_fresh_vm(S, n, pnamedargs) = $set_active_table(S[.GLOBALTABLE = ($fiber_globals(S))][.TODO = [FIBER_ENTER n pnamedargs, FIBER_FINISH n]][.ORIGIN = eps][.CURRENT = eps][.FRAMES = eps][.DESTRUCTION.CALLS = eps][.DESTRUCTION.RELEASES = eps][.DESTRUCTION.FRAMES = eps][.DESTRUCTION.OPERATIONS = eps][.DESTRUCTION.CLEANUPS = eps][.HELD = eps][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)][.CELL = 0][.KEY = KINT 0][.LOCATION = ROOT 0][.REPORTING = $reporting_ini_mask(S.REPORTINGINI)][.SILENCES = eps][.BORROWEDREAD = eps][.OBJECTCAST = eps][.CONSTCONTEXT = eps][.TRACE = eps][.ERRORFATALTRACE = eps][.ERRORORIGIN = eps], $empty_table())
dec $fiber_transfer_context(pstate, pcallcontext?) : bool
dec $fiber_transfer_frames(pstate, pframe*) : bool
dec $fiber_transfer_reason(pstate) : text
;; The five active destruction lists move with the real VM stack.
def $fiber_transfer_reason(S) = "Fiber switch during an initializer, source loader or Generator continuation"
def $fiber_transfer_context(S, eps) = true
def $fiber_transfer_context(S, (pcallcontext)) = ~$autoload_context_kind(S, pcallcontext)
def $fiber_transfer_frames(S, eps) = true
def $fiber_transfer_frames(S, pframe :: pframe_tail*) = (pframe.CONSTCONTEXT = eps /\ $generator_resume_ids(pframe.TODO) = eps /\ $fiber_transfer_context(S, pframe.CONTEXT) /\ $fiber_transfer_frames(S, pframe_tail*))
def $fiber_transfer_domain(S) = (S.CLASSCONSTANTINIT = eps /\ S.CONSTCONTEXT = eps /\ S.DIRCONTEXT = eps /\ S.FILECONTEXTS = eps /\ S.EVALCONTEXTS = eps /\ $generator_resume_ids(S.TODO) = eps /\ $fiber_transfer_context(S, S.CURRENT) /\ $fiber_transfer_frames(S, S.FRAMES))

