def $scoped_select(S, phpType19, KNOWN (PSTRING ptbytes_class), ptbytes, phpType7*, z) = $fiber_start_config(S, pintrinsic, eps, z, true)
  -- if $ptlc($typed_callable_name(ptbytes_class)) = $ptascii("fiber")
