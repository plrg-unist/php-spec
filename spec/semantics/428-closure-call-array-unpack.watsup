;; One ARRAY pack follows the separately evaluated positional newThis.
;; PACKS retain capture history; only an active NEXT owns the source ARRAY.
def $closure_call_array_pack_site(S, porigin) = true
  -- if $closure_call_args_at(S, porigin) = [NArg ABSENT expression_first (BOOLEAN false) (BOOLEAN false) metadata_first, NArg ABSENT expression_pack (BOOLEAN false) (BOOLEAN true) metadata_pack]
def $closure_call_array_pack_site(S, porigin) = false -- otherwise

dec $closure_call_pack_source_valid(pstate, pclosurecall, pconfigpack) : bool
def $closure_call_pack_source_valid(S, pclosurecall, pconfigpack) = true
  -- if $closure_call_array_pack_site(S, pclosurecall.SITE)
  -- if pconfigpack.INDEX = 1
  -- if $origin_child((pclosurecall.SITE), [PCFIELD 2, PCINDEX 1, PCFIELD 1]) = (pconfigpack.SITE)
  -- if pconfigpack.LINE = $named_line(S, (pclosurecall.SITE), 1)
  -- if $call_line_valid(S, (pconfigpack.SITE), pconfigpack.LINE)
  -- if $(pconfigpack.ARRAY < |S.ARRAYS|)
  -- if $config_pack_items_valid(pconfigpack.ITEMS)
  -- if $config_ini_pack_known(S, pconfigpack.ITEMS, $compiled_read(S, pconfigpack.SITE))
def $closure_call_pack_source_valid(S, pclosurecall, pconfigpack) = false -- otherwise

dec $closure_call_pack_named((pkey, poperand)*) : bool
def $closure_call_pack_named(eps) = false
def $closure_call_pack_named((KSTRING preqbytes, poperand) :: (pkey, poperand_tail)*) = true
def $closure_call_pack_named((KINT z, poperand) :: (pkey, poperand_tail)*) = $closure_call_pack_named((pkey, poperand_tail)*)
dec $closure_call_pack_outer_valid((pkey, poperand)*, pkey) : bool
def $closure_call_pack_outer_valid((pkey, poperand)*, KINT z) = ~$closure_call_pack_named((pkey, poperand)*)
def $closure_call_pack_outer_valid((pkey, poperand)*, KSTRING preqbytes) = (preqbytes =/= $ptascii("newThis") /\ ~$closure_call_named_seen((pkey, poperand)*, preqbytes))
dec $closure_call_pack_key(pkey, nat) : pkey
def $closure_call_pack_key(KINT z, n) = KINT $(n + 1)
def $closure_call_pack_key(KSTRING preqbytes, n) = KSTRING preqbytes
dec $closure_call_pack_error(pnamedtarget, pkey) : preqbytes
def $closure_call_pack_error(NAMED_UNKNOWN preqbytes, pkey) = $ptascii("Unknown named parameter $") ++ $c_string(preqbytes)
def $closure_call_pack_error(NAMED_POSITION n, KSTRING preqbytes) = $ptascii("Named parameter $") ++ $c_string(preqbytes) ++ $ptascii(" overwrites previous argument")
def $closure_call_pack_error(NAMED_EXTRA preqbytes_extra, KSTRING preqbytes) = $ptascii("Named parameter $") ++ $c_string(preqbytes) ++ $ptascii(" overwrites previous argument")
dec $closure_call_pack_append(psparam*, pclosurecall, pkey, pvalue) : pclosurecall?
def $closure_call_pack_append(psparam*, pclosurecall, pkey, pvalue) = (pclosurecall[.RAW = pclosurecall.RAW ++ [(pkey_raw, KNOWN pvalue)]][.SENT = $named_store(pclosurecall.SENT, pnamedtarget, KNOWN pvalue)])
  -- if $closure_call_pack_outer_valid(pclosurecall.RAW, pkey)
  -- if pkey_raw = $closure_call_pack_key(pkey, |pclosurecall.RAW|)
  -- if pnamedtarget = $unpack_target(psparam*, pkey, |pclosurecall.RAW|)
  -- if pclosurecall.ERROR = eps
  -- if $named_can_store(pclosurecall.SENT, pnamedtarget)
def $closure_call_pack_append(psparam*, pclosurecall, pkey, pvalue) = (pclosurecall[.RAW = pclosurecall.RAW ++ [(pkey_raw, KNOWN pvalue)]][.SENT = {SLOTS eps, NAMED eps}][.ERROR = ($closure_call_pack_error(pnamedtarget, pkey))])
  -- if $closure_call_pack_outer_valid(pclosurecall.RAW, pkey)
  -- if pkey_raw = $closure_call_pack_key(pkey, |pclosurecall.RAW|)
  -- if pnamedtarget = $unpack_target(psparam*, pkey, |pclosurecall.RAW|)
  -- if pclosurecall.ERROR = eps
  -- if ~$named_can_store(pclosurecall.SENT, pnamedtarget)
def $closure_call_pack_append(psparam*, pclosurecall, pkey, pvalue) = (pclosurecall[.RAW = pclosurecall.RAW ++ [(pkey_raw, KNOWN pvalue)]])
  -- if $closure_call_pack_outer_valid(pclosurecall.RAW, pkey)
  -- if pkey_raw = $closure_call_pack_key(pkey, |pclosurecall.RAW|)
  -- if pclosurecall.ERROR =/= eps
def $closure_call_pack_append(psparam*, pclosurecall, pkey, pvalue) = eps -- otherwise
dec $closure_call_pack_prefix(psparam*, pclosurecall, pentry*) : pclosurecall?
def $closure_call_pack_prefix(psparam*, pclosurecall, eps) = (pclosurecall)
def $closure_call_pack_prefix(psparam*, pclosurecall, (ENTRY pkey (DIRECT pvalue)) :: pentry*) = $closure_call_pack_prefix(psparam*, pclosurecall_next, pentry*)
  -- if $closure_call_pack_append(psparam*, pclosurecall, pkey, pvalue) = (pclosurecall_next)
def $closure_call_pack_prefix(psparam*, pclosurecall, pentry*) = eps -- otherwise

dec $closure_call_pack_replay(pstate, pclosurecall, nat) : bool
def $closure_call_pack_replay(S, pclosurecall, n_cursor) = true
  -- if pclosurecall.PACKS = [pconfigpack]
  -- if $closure_call_pack_source_valid(S, pclosurecall, pconfigpack)
  -- if $(n_cursor <= |pconfigpack.ITEMS|)
  -- if pclosurecall_seed = pclosurecall[.INDEX = 1][.SENT = {SLOTS eps, NAMED eps}][.RAW = eps][.ERROR = eps][.PACKS = eps]
  -- if $closure_call_pack_prefix($closure_call_parameters(S, pclosurecall.SOURCE), pclosurecall_seed, pconfigpack.ITEMS[0:n_cursor]) = (pclosurecall[.INDEX = 1][.PACKS = eps])
def $closure_call_pack_replay(S, pclosurecall, n_cursor) = false -- otherwise
def $closure_call_progress_valid(S, pclosurecall) = true
  -- if pclosurecall.INDEX = 2
  -- if pclosurecall.PACKS = [pconfigpack]
  -- if $closure_call_source(S, pclosurecall.SOURCE)
  -- if $closure_call_positional_receiver_valid(S, pclosurecall)
  -- if $closure_call_pack_replay(S, pclosurecall, |pconfigpack.ITEMS|)

dec $closure_call_unpack_valid(pstate, pclosurecall, poperand, nat) : bool
def $closure_call_unpack_valid(S, pclosurecall, KNOWN (PARRAY n_array), n_cursor) = true
  -- if pclosurecall.INDEX = 1
  -- if pclosurecall.PACKS = [pconfigpack]
  -- if $call_line_valid(S, (pclosurecall.SITE), pclosurecall.LINE)
  -- if $closure_call_source(S, pclosurecall.SOURCE)
  -- if $closure_call_positional_receiver_valid(S, pclosurecall)
  -- if $closure_call_raw_evaluated(pclosurecall.RAW)
  -- if $unpack_container_valid(S, KNOWN (PARRAY n_array))
  -- if pconfigpack.ARRAY = n_array
  -- if pconfigpack.ITEMS = $config_pack_capture(S, S.ARRAYS[n_array].ITEMS)
  -- if $closure_call_pack_replay(S, pclosurecall, n_cursor)
def $closure_call_unpack_valid(S, pclosurecall, poperand, n_cursor) = false -- otherwise
def $call_task_valid(S, CLOSURE_CALL_UNPACK_PREP pclosurecall) = ($closure_call_task_valid(S, pclosurecall) /\ $closure_call_array_pack_site(S, pclosurecall.SITE) /\ pclosurecall.INDEX = 1 /\ pclosurecall.PACKS = eps)
def $call_task_valid(S, CLOSURE_CALL_UNPACK_NEXT pclosurecall poperand n_cursor) = $closure_call_unpack_valid(S, pclosurecall, poperand, n_cursor)
def $task_nodes(CLOSURE_CALL_UNPACK_PREP pclosurecall) = $task_nodes(CLOSURE_CALL_ARGS pclosurecall)
def $task_nodes(CLOSURE_CALL_UNPACK_NEXT pclosurecall poperand n_cursor) = $task_nodes(CLOSURE_CALL_ARGS pclosurecall) ++ $operand_nodes(poperand)

rule PhpStep/closure-call-unpack-start: S ~> S[.TODO = [$at_task((porigin_pack), EVAL expression_pack), CLOSURE_CALL_UNPACK_PREP pclosurecall] ++ ptask_tail*][.RESULT = KNOWN PNULL]
  -- if S.TODO = (CLOSURE_CALL_ARGS pclosurecall) :: ptask_tail*
  -- if $closure_call_array_pack_site(S, pclosurecall.SITE)
  -- if pclosurecall.INDEX = 1
  -- if $closure_call_args_at(S, pclosurecall.SITE) = [phpType7_first, NArg ABSENT expression_pack (BOOLEAN false) (BOOLEAN true) metadata_pack]
  -- if $origin_child((pclosurecall.SITE), [PCFIELD 2, PCINDEX 1, PCFIELD 1]) = (porigin_pack)
rule PhpStep/closure-call-unpack-array: S ~> S_read[.TODO = (CLOSURE_CALL_UNPACK_NEXT pclosurecall[.PACKS = [pconfigpack]] (KNOWN (PARRAY n_array)) 0) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (CLOSURE_CALL_UNPACK_PREP pclosurecall) :: ptask_tail*
  -- if S_read = $resolve_at(S, S.RESULT, $named_line(S, (pclosurecall.SITE), 1))
  -- if S_read.COMPLETION = NORMAL
  -- if S_read.RESULT = KNOWN (PARRAY n_array)
  -- if $unpack_container_valid(S_read, KNOWN (PARRAY n_array))
  -- if $origin_child((pclosurecall.SITE), [PCFIELD 2, PCINDEX 1, PCFIELD 1]) = (porigin_pack)
  -- if pconfigpack = {INDEX 1, SITE porigin_pack, LINE $named_line(S, (pclosurecall.SITE), 1), ARRAY n_array, ITEMS $config_pack_capture(S_read, S_read.ARRAYS[n_array].ITEMS)}
rule PhpStep/closure-call-unpack-abrupt: S ~> S_read
  -- if S.TODO = (CLOSURE_CALL_UNPACK_PREP pclosurecall) :: ptask_tail*
  -- if S_read = $resolve_at(S, S.RESULT, $named_line(S, (pclosurecall.SITE), 1))
  -- if S_read.COMPLETION =/= NORMAL
rule PhpStep/closure-call-unpack-source-unsupported: S ~> S_read[.COMPLETION = UNSUPPORTED "Closure::call unpack source outside ARRAY domain"]
  -- if S.TODO = (CLOSURE_CALL_UNPACK_PREP pclosurecall) :: ptask_tail*
  -- if S_read = $resolve_at(S, S.RESULT, $named_line(S, (pclosurecall.SITE), 1))
  -- if S_read.COMPLETION = NORMAL
  -- if S_read.RESULT = KNOWN pvalue
  -- if ~$is_array_value(pvalue)
rule PhpStep/closure-call-unpack-next: S ~> S[.TODO = (CLOSURE_CALL_UNPACK_NEXT pclosurecall_next poperand $(n_cursor + 1)) :: ptask_tail*]
  -- if S.TODO = (CLOSURE_CALL_UNPACK_NEXT pclosurecall poperand n_cursor) :: ptask_tail*
  -- if $closure_call_unpack_valid(S, pclosurecall, poperand, n_cursor)
  -- if pclosurecall.PACKS = [pconfigpack]
  -- if $(n_cursor < |pconfigpack.ITEMS|)
  -- if pconfigpack.ITEMS[n_cursor] = ENTRY pkey (DIRECT pvalue)
  -- if $closure_call_pack_append($closure_call_parameters(S, pclosurecall.SOURCE), pclosurecall, pkey, pvalue) = (pclosurecall_next)
rule PhpStep/closure-call-unpack-outer-unsupported: S ~> S[.COMPLETION = UNSUPPORTED "Closure::call ARRAY unpack outer binding"]
  -- if S.TODO = (CLOSURE_CALL_UNPACK_NEXT pclosurecall poperand n_cursor) :: ptask_tail*
  -- if $closure_call_unpack_valid(S, pclosurecall, poperand, n_cursor)
  -- if pclosurecall.PACKS = [pconfigpack]
  -- if $(n_cursor < |pconfigpack.ITEMS|)
  -- if pconfigpack.ITEMS[n_cursor] = ENTRY pkey (DIRECT pvalue)
  -- if $closure_call_pack_append($closure_call_parameters(S, pclosurecall.SOURCE), pclosurecall, pkey, pvalue) = eps
rule PhpStep/closure-call-unpack-done: S ~> S[.TODO = (CLOSURE_CALL_ARGS pclosurecall[.INDEX = 2]) :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (CLOSURE_CALL_UNPACK_NEXT pclosurecall poperand n_cursor) :: ptask_tail*
  -- if $closure_call_unpack_valid(S, pclosurecall, poperand, n_cursor)
  -- if pclosurecall.PACKS = [pconfigpack]
  -- if n_cursor = |pconfigpack.ITEMS|

;; Expanded body contexts validate signature-consistent raw shape, not old ARRAYs.
dec $closure_call_pack_shape_slots(psparam*, pnamedslot*, nat, pnamedargs) : pnamedargs?
def $closure_call_pack_shape_slots(psparam*, eps, n, pnamedargs) = (pnamedargs)
def $closure_call_pack_shape_slots(psparam*, (NAMED_SENT (KNOWN pvalue)) :: pnamedslot*, n, pnamedargs) = $closure_call_pack_shape_slots(psparam*, pnamedslot*, $(n + 1), $named_store(pnamedargs, pnamedtarget, KNOWN PNULL))
  -- if pnamedtarget = $unpack_target(psparam*, KINT n, n)
  -- if $named_can_store(pnamedargs, pnamedtarget)
def $closure_call_pack_shape_slots(psparam*, pnamedslot*, n, pnamedargs) = eps -- otherwise
dec $closure_call_pack_shape_names(psparam*, (preqbytes, poperand)*, nat, pnamedargs) : pnamedargs?
def $closure_call_pack_shape_names(psparam*, eps, n, pnamedargs) = (pnamedargs)
def $closure_call_pack_shape_names(psparam*, (preqbytes, KNOWN pvalue) :: (preqbytes_tail, poperand)*, n, pnamedargs) = $closure_call_pack_shape_names(psparam*, (preqbytes_tail, poperand)*, n, $named_store(pnamedargs, pnamedtarget, KNOWN PNULL))
  -- if preqbytes =/= $ptascii("newThis")
  -- if pnamedtarget = $unpack_target(psparam*, KSTRING preqbytes, n)
  -- if $named_can_store(pnamedargs, pnamedtarget)
def $closure_call_pack_shape_names(psparam*, (preqbytes, poperand)*, n, pnamedargs) = eps -- otherwise
dec $closure_call_pack_shape(psparam*, pnamedargs) : pnamedargs?
def $closure_call_pack_shape(psparam*, pnamedargs) = $closure_call_pack_shape_names(psparam*, pnamedargs.NAMED, |pnamedargs.SLOTS|, pnamedargs_slots)
  -- if $closure_call_pack_shape_slots(psparam*, pnamedargs.SLOTS, 0, {SLOTS eps, NAMED eps}) = (pnamedargs_slots)
def $closure_call_pack_shape(psparam*, pnamedargs) = eps -- otherwise
def $closure_call_enter(S, pfunction, pclosurecall, n_receiver) = S_entered[.CURRENT = (pcallcontext[.WRAPPER = ($closure_call_wrapper(pclosurecall.RAW))])]
  -- if pclosurecall.PACKS =/= eps
  -- if $closure_call_pack_named(pclosurecall.RAW)
  -- if S_entered = $target_after_enter($named_enter(S, pfunction, pclosurecall.SENT, (pclosurecall.SITE), pclosurecall.LINE), CLOSURE_CALL_TARGET pclosurecall.SOURCE n_receiver)
  -- if S_entered.CURRENT = (pcallcontext)
def $closure_call_enter(S, pfunction, pclosurecall, n_receiver) = $call_arity(S_entered[.CURRENT = (pcallcontext[.WRAPPER = ($closure_call_wrapper(pclosurecall.RAW))])], pfunction, |$named_operands(pclosurecall.SENT.SLOTS)|, (pclosurecall.SITE), pclosurecall.LINE)
  -- if pclosurecall.PACKS =/= eps
  -- if ~$closure_call_pack_named(pclosurecall.RAW)
  -- if S_entered = $target_after_enter($call_enter(S, pfunction, $named_operands(pclosurecall.SENT.SLOTS), (pclosurecall.SITE), pclosurecall.LINE), CLOSURE_CALL_TARGET pclosurecall.SOURCE n_receiver)
  -- if S_entered.CURRENT = (pcallcontext)
def $named_call_valid(S, CLOSURE_CALL_TARGET n_source n_receiver, (porigin_site)) = true
  -- if $closure_call_array_pack_site(S, porigin_site)
dec $closure_call_pack_names((preqbytes, poperand)*, (preqbytes, poperand)*) : bool
def $closure_call_pack_names(eps, eps) = true
def $closure_call_pack_names((preqbytes, poperand) :: (preqbytes_tail, poperand_tail)*, (preqbytes, poperand_shape) :: (preqbytes_shape, poperand_shape_tail)*) = $closure_call_pack_names((preqbytes_tail, poperand_tail)*, (preqbytes_shape, poperand_shape_tail)*)
def $closure_call_pack_names((preqbytes, poperand)*, (preqbytes_shape, poperand_shape)*) = false -- otherwise
def $wrapper_context_valid(S, pcallcontext) = true
  -- if pcallcontext.TARGET = CLOSURE_CALL_TARGET n_source n_receiver
  -- if pcallcontext.CALLSITE = (porigin_site)
  -- if $closure_call_array_pack_site(S, porigin_site)
  -- if pcallcontext.WRAPPER = (pnamedargs)
  -- if $target_function(S, CLOSURE_CALL_TARGET n_source n_receiver) = (pfunction)
  -- if $closure_call_pack_shape(pfunction.SIGNATURE.PARAMETERS, pnamedargs) = (pnamedargs_shape)
  -- if pcallcontext.ARGC = |pnamedargs_shape.SLOTS|
  -- if n_received = $call_received(pcallcontext.ARGC, |$call_fixed_parameters(pfunction.SIGNATURE.PARAMETERS)|)
  -- if pcallcontext.HOLES = $named_holes(pnamedargs_shape.SLOTS[0:n_received], 0)
  -- if $closure_call_pack_names(pcallcontext.NAMED, pnamedargs_shape.NAMED)
