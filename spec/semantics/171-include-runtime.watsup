;; Finite file-provider facts are consumed in two separate pauses. Resolution
;; precedes a checked file-mode parser request and any source registration.
dec $file_kind_valid(int) : bool
def $file_kind_valid(1) = true
def $file_kind_valid(2) = true
def $file_kind_valid(3) = true
def $file_kind_valid(4) = true
def $file_kind_valid(int) = false -- otherwise
dec $file_node_kind(pcnode?) : int?
def $file_node_kind((NExprInclude expression (INTEGER n_kind) metadata)) = (n_kind)
def $file_node_kind(pcnode?) = eps -- otherwise
dec $file_site_line(pstate, porigin) : int
def $file_site_line(S, porigin) = $runtime_line(S[.ORIGIN = (porigin)][.CONSTCONTEXT = eps], [PCFIELD 0], expression)
  -- if $origin_node(S.SOURCES, porigin) = (NExprInclude expression phpType24 metadata)
def $file_site_line(S, porigin) = 0 -- otherwise
dec $file_site_valid(pstate, porigin, int, int) : bool
def $file_site_valid(S, porigin, z, n_kind) = ($file_node_kind($origin_node(S.SOURCES, porigin)) = (n_kind) /\ $file_site_line(S, porigin) = z /\ $(z > 0) /\ $file_kind_valid(n_kind) /\ $source_filename($call_sourcefile(S.FILES, porigin)))

def $ppdispatch(P, pcpath, NExprInclude expression (INTEGER n_kind) metadata, PPR) = $ppclearvalue($ppexpr(P, pcpath ++ [PCFIELD 0], expression, PPR))
  -- if $file_kind_valid(n_kind)

dec $file_operand_site_valid(pstate, porigin, porigin, int, int) : bool
def $file_operand_site_valid(S, porigin_parent, porigin_child, z, n_kind) = ($file_site_valid(S, porigin_parent, z, n_kind) /\ $origin_child((porigin_parent), [PCFIELD 0]) = (porigin_child))
def $file_operand_child_site(S, porigin_child, z) = ($file_operand_site_valid(S, porigin_parent, porigin_child, z, 1) \/ $file_operand_site_valid(S, porigin_parent, porigin_child, z, 2) \/ $file_operand_site_valid(S, porigin_parent, porigin_child, z, 3) \/ $file_operand_site_valid(S, porigin_parent, porigin_child, z, 4))
  -- if $reference_origin_parent(porigin_child, 1) = ((porigin_parent, [PCFIELD 0]))
def $file_operand_child_site(S, porigin_child, z) = false -- otherwise

rule PhpStep/file-expression: S ~> S[.TODO = [$at_task($origin_child(S.ORIGIN, [PCFIELD 0]), EVAL expression), $at_task($origin_child(S.ORIGIN, [PCFIELD 0]), FILE_REQUEST porigin z n_kind)] ++ ptask_tail*]
  -- if S.TODO = (EVAL (NExprInclude expression (INTEGER n_kind) metadata)) :: ptask_tail*
  -- if S.ORIGIN = (porigin)
  -- if z = $file_site_line(S, porigin)
  -- if $file_kind_valid(n_kind)

;; INI storage retains full bytes; Zend file resolution reads its C-string view.
dec $file_include_path(preqbytes?) : preqbytes?
def $file_include_path(eps) = eps
def $file_include_path((preqbytes)) = ($c_string(preqbytes))
dec $file_request_start(pstate, porigin, int, int, ptask*) : pstate
dec $file_empty_operand(pstate, int) : bool
def $file_empty_operand(S, n_kind) = true
  -- if S.RESULT = KNOWN pvalue_string
  -- if $string_bytes(pvalue_string) = (eps)
  -- if n_kind = 1 \/ n_kind = 3
def $file_empty_operand(S, int) = false -- otherwise
def $file_request_start(S, porigin, z, n_kind, ptask_tail*) = $throw_scalar(S, "ValueError", $ptascii("Path must not be empty"), z)
  -- if $file_site_valid(S, porigin, z, n_kind)
  -- if $file_empty_operand(S, n_kind)
def $file_request_start(S, porigin, z, n_kind, ptask_tail*) = S[.FILESEQ = $(n_nonce + 1)][.FILECONTEXTS = pfilecontext :: S.FILECONTEXTS][.TODO = (FILE_RESOLVE_AWAIT n_nonce) :: ptask_tail*][.ORIGIN = (porigin)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)][.COMPLETION = SOURCE_PENDING]
  -- if $file_site_valid(S, porigin, z, n_kind)
  -- if ~$file_empty_operand(S, n_kind)
  -- if S.FILECWD = (preqbytes_cwd)
  -- if $file_include_path(S.FILEINCLUDEPATH) = (preqbytes_include_path)
  -- if S.RESULT = KNOWN pvalue_string
  -- if $string_bytes(pvalue_string) = (n_requested*)
  -- if n_nonce = S.FILESEQ
  -- if n_owner = |S.FRAMES|
  -- if n_caller* = $call_sourcefile(S.FILES, porigin)
  -- if pfilecontext = {NONCE n_nonce, SITE porigin, CALLER n_caller*, REQUESTED n_requested*, CWD preqbytes_cwd, INCLUDEPATH preqbytes_include_path, KIND n_kind, LEXICAL_CLASS $eval_class_origin(S), OWNER n_owner, PHASE FILE_RESOLVE_WAIT, TAIL ptask_tail*, UNIT eps, RESOLVED eps, OPENED eps, BYTES eps}
def $file_request_start(S, porigin, z, n_kind, ptask_tail*) = S[.COMPLETION = UNSUPPORTED "file provider requires fixed cwd"]
  -- if S.FILECWD = eps \/ S.FILEINCLUDEPATH = eps
  -- if ~$file_empty_operand(S, n_kind)
rule PhpStep/file-request-object: S ~> $source_string_begin(S_read, S.RESULT, n, porigin_parent, z, n_kind, ptask_tail*)
  -- if S.TODO = (FILE_REQUEST porigin_parent z n_kind) :: ptask_tail*
  -- if S.ORIGIN = (porigin_child)
  -- if $file_operand_site_valid(S, porigin_parent, porigin_child, z, n_kind)
  -- if S_read = $resolve_at(S, S.RESULT, z)
  -- if S_read.COMPLETION = NORMAL
  -- if S_read.RESULT = KNOWN (POBJECT n)
  -- if $stringable_instance(S_read, n)
rule PhpStep/file-request: S ~> $file_request_start(S_value, porigin, z, n_kind, ptask_tail*)
  -- if S.TODO = (FILE_REQUEST porigin z n_kind) :: ptask_tail*
  -- if ~$eval_callback_ready(S, z)
  -- if ~$source_array_ready(S, z)
  -- if ~$source_read_ready(S)
  -- if S_value = $eval_operand(S, z)
  -- if S_value.COMPLETION = NORMAL
rule PhpStep/file-request-abrupt: S ~> S_value
  -- if S.TODO = (FILE_REQUEST porigin z n_kind) :: ptask_tail*
  -- if ~$eval_callback_ready(S, z)
  -- if ~$source_array_ready(S, z)
  -- if ~$source_read_ready(S)
  -- if S_value = $eval_operand(S, z)
  -- if S_value.COMPLETION =/= NORMAL
def $call_task_valid(S, FILE_REQUEST porigin z n_kind) = $file_operand_site_valid(S, porigin, porigin_child, z, n_kind)
  -- if S.ORIGIN = (porigin_child)
def $eval_request_task(FILE_REQUEST porigin z n_kind) = true
def $eval_requests_owned((FILE_REQUEST porigin z n_kind) :: (ORIGIN_RETURN (porigin)) :: ptask_tail*) = $eval_requests_owned(ptask_tail*)
def $stringify_source(S, porigin_site, z, FILE_REQUEST porigin_parent z n_kind) = $file_operand_site_valid(S, porigin_parent, porigin_site, z, n_kind)
def $stringify_file_consumer(FILE_REQUEST porigin z n_kind) = true
def $stringify_file_consumer(ptask) = false -- otherwise
def $stringify_consumer_tail_valid(S, porigin_site, z, FILE_REQUEST porigin_parent z n_kind, (ORIGIN_RETURN (porigin_parent)) :: ptask_tail*) = $file_operand_site_valid(S, porigin_parent, porigin_site, z, n_kind)

def $file_pending_state_valid(S) = (pfilecontext.OWNER = |S.FRAMES| /\ S.ORIGIN = (pfilecontext.SITE) /\ S.FILESEQ = $(pfilecontext.NONCE + 1) /\ S.FILECWD = (pfilecontext.CWD) /\ $file_include_path(S.FILEINCLUDEPATH) = (pfilecontext.INCLUDEPATH) /\ $file_site_valid(S, pfilecontext.SITE, z, pfilecontext.KIND) /\ pfilecontext.CALLER = $call_sourcefile(S.FILES, pfilecontext.SITE) /\ pfilecontext.LEXICAL_CLASS = $eval_class_origin(S) /\ pfilecontext.TAIL = ptask_tail*)
  -- if S.COMPLETION = SOURCE_PENDING
  -- if S.FILECONTEXTS = pfilecontext :: pfilecontext_tail*
  -- if S.TODO = (FILE_RESOLVE_AWAIT pfilecontext.NONCE) :: ptask_tail*
  -- if pfilecontext.PHASE = FILE_RESOLVE_WAIT
  -- if z = $file_site_line(S, pfilecontext.SITE)
def $file_pending_state_valid(S) = (pfilecontext.OWNER = |S.FRAMES| /\ S.ORIGIN = (pfilecontext.SITE) /\ S.FILESEQ = $(pfilecontext.NONCE + 1) /\ S.FILECWD = (pfilecontext.CWD) /\ $file_include_path(S.FILEINCLUDEPATH) = (pfilecontext.INCLUDEPATH) /\ $file_site_valid(S, pfilecontext.SITE, z, pfilecontext.KIND) /\ pfilecontext.CALLER = $call_sourcefile(S.FILES, pfilecontext.SITE) /\ pfilecontext.LEXICAL_CLASS = $eval_class_origin(S) /\ pfilecontext.TAIL = ptask_tail* /\ $sourcefile_count(S.FILES, n_unit) = 1 /\ $source_unit(S.SOURCES, n_unit) = eps /\ $call_sourcefile(S.FILES, PORIGIN n_unit eps) = n_opened*)
  -- if S.COMPLETION = SOURCE_PENDING
  -- if S.FILECONTEXTS = pfilecontext :: pfilecontext_tail*
  -- if S.TODO = (FILE_PARSE_AWAIT pfilecontext.NONCE) :: ptask_tail*
  -- if pfilecontext.PHASE = FILE_PARSE_WAIT
  -- if pfilecontext.UNIT = (n_unit)
  -- if pfilecontext.RESOLVED = (n_resolved*)
  -- if pfilecontext.OPENED = (n_opened*)
  -- if pfilecontext.BYTES = (n_bytes*)
  -- if z = $file_site_line(S, pfilecontext.SITE)
def $file_pending_state_valid(S) = false -- otherwise
dec $file_context_nonce_phase(pfilecontext*, nat, pfilephase) : bool
def $file_context_nonce_phase(eps, n, pfilephase) = false
def $file_context_nonce_phase(pfilecontext :: pfilecontext_tail*, n, pfilephase) = true
  -- if pfilecontext.NONCE = n
  -- if pfilecontext.PHASE = pfilephase
def $file_context_nonce_phase(pfilecontext :: pfilecontext_tail*, n, pfilephase) = $file_context_nonce_phase(pfilecontext_tail*, n, pfilephase)
  -- if pfilecontext.NONCE =/= n \/ pfilecontext.PHASE =/= pfilephase
dec $file_context_unit_running(pfilecontext*, nat) : bool
def $file_context_unit_running(eps, n) = false
def $file_context_unit_running(pfilecontext :: pfilecontext_tail*, n) = true
  -- if pfilecontext.UNIT = (n)
  -- if pfilecontext.PHASE = FILE_UNIT_RUN
def $file_context_unit_running(pfilecontext :: pfilecontext_tail*, n) = $file_context_unit_running(pfilecontext_tail*, n)
  -- if pfilecontext.UNIT =/= (n) \/ pfilecontext.PHASE =/= FILE_UNIT_RUN
def $file_context_unit_present(eps, n) = false
def $file_context_unit_present(pfilecontext :: pfilecontext_tail*, n) = true
  -- if pfilecontext.UNIT = (n)
def $file_context_unit_present(pfilecontext :: pfilecontext_tail*, n) = $file_context_unit_present(pfilecontext_tail*, n)
  -- if pfilecontext.UNIT =/= (n)
def $eval_wrapped_marker(FILE_RESOLVE_AWAIT n) = true
def $eval_wrapped_marker(FILE_PARSE_AWAIT n) = true
def $eval_wrapped_marker(FILE_END n) = true
def $eval_marker_valid(S, FILE_RESOLVE_AWAIT n) = $file_context_nonce_phase(S.FILECONTEXTS, n, FILE_RESOLVE_WAIT)
def $eval_marker_valid(S, FILE_PARSE_AWAIT n) = $file_context_nonce_phase(S.FILECONTEXTS, n, FILE_PARSE_WAIT)
def $eval_marker_valid(S, FILE_END n) = $file_context_unit_running(S.FILECONTEXTS, n)
dec $file_marker_match(pfilecontext, ptask) : bool
def $file_marker_match(pfilecontext, FILE_RESOLVE_AWAIT n) = (pfilecontext.NONCE = n /\ pfilecontext.PHASE = FILE_RESOLVE_WAIT)
def $file_marker_match(pfilecontext, FILE_PARSE_AWAIT n) = (pfilecontext.NONCE = n /\ pfilecontext.PHASE = FILE_PARSE_WAIT)
def $file_marker_match(pfilecontext, FILE_END n) = (pfilecontext.UNIT = (n) /\ pfilecontext.PHASE = FILE_UNIT_RUN)
def $file_marker_match(pfilecontext, ptask) = false -- otherwise
dec $file_marker_count(ptask*, pfilecontext) : nat
def $file_marker_count(eps, pfilecontext) = 0
def $file_marker_count(ptask :: ptask_tail*, pfilecontext) = $($file_marker_count(ptask_tail*, pfilecontext) + 1)
  -- if $file_marker_match(pfilecontext, ptask)
def $file_marker_count(ptask :: ptask_tail*, pfilecontext) = $file_marker_count(ptask_tail*, pfilecontext)
  -- if ~$file_marker_match(pfilecontext, ptask)
dec $file_frame_marker_count(pframe*, pfilecontext) : nat
def $file_frame_marker_count(eps, pfilecontext) = 0
def $file_frame_marker_count(pframe :: pframe_tail*, pfilecontext) = $($file_marker_count(pframe.TODO, pfilecontext) + $file_frame_marker_count(pframe_tail*, pfilecontext))
dec $file_owner_tasks(pstate, pfilecontext) : ptask*
def $file_owner_tasks(S, pfilecontext) = S.TODO
  -- if pfilecontext.OWNER = |S.FRAMES|
def $file_owner_tasks(S, pfilecontext) = $eval_frame_tasks(S.FRAMES, n_index)
  -- if $(pfilecontext.OWNER < |S.FRAMES|)
  -- if n_index = $(|S.FRAMES| - pfilecontext.OWNER - 1)
def $file_owner_tasks(S, pfilecontext) = eps
  -- if $(pfilecontext.OWNER > |S.FRAMES|)
dec $file_marker_suffix_valid(ptask*, pfilecontext) : bool
def $file_marker_suffix_valid(eps, pfilecontext) = false
def $file_marker_suffix_valid(ptask :: ptask_tail*, pfilecontext) = (ptask_tail* = pfilecontext.TAIL)
  -- if $file_marker_match(pfilecontext, ptask)
def $file_marker_suffix_valid(ptask :: ptask_tail*, pfilecontext) = $file_marker_suffix_valid(ptask_tail*, pfilecontext)
  -- if ~$file_marker_match(pfilecontext, ptask)
dec $file_context_phase_valid(pstate, pfilecontext) : bool
def $file_context_phase_valid(S, pfilecontext) = (pfilecontext.UNIT = eps /\ pfilecontext.RESOLVED = eps /\ pfilecontext.OPENED = eps /\ pfilecontext.BYTES = eps /\ S.FILECWD = (pfilecontext.CWD) /\ $file_include_path(S.FILEINCLUDEPATH) = (pfilecontext.INCLUDEPATH) /\ S.COMPLETION = SOURCE_PENDING /\ pfilecontext.OWNER = |S.FRAMES| /\ S.ORIGIN = (pfilecontext.SITE) /\ S.TODO = (FILE_RESOLVE_AWAIT pfilecontext.NONCE) :: pfilecontext.TAIL)
  -- if pfilecontext.PHASE = FILE_RESOLVE_WAIT
def $file_context_phase_valid(S, pfilecontext) = ($source_filename(n_opened*) /\ $sourcefile_count(S.FILES, n_unit) = 1 /\ $source_unit(S.SOURCES, n_unit) = eps /\ $eval_binding_at(S.EVALBINDINGS, n_unit) = eps /\ $file_binding_at(S.FILEBINDINGS, n_unit) = eps /\ S.FILECWD = (pfilecontext.CWD) /\ $file_include_path(S.FILEINCLUDEPATH) = (pfilecontext.INCLUDEPATH) /\ S.COMPLETION = SOURCE_PENDING /\ pfilecontext.OWNER = |S.FRAMES| /\ S.ORIGIN = (pfilecontext.SITE) /\ S.TODO = (FILE_PARSE_AWAIT pfilecontext.NONCE) :: pfilecontext.TAIL /\ $call_sourcefile(S.FILES, PORIGIN n_unit eps) = n_opened*)
  -- if pfilecontext.PHASE = FILE_PARSE_WAIT
  -- if pfilecontext.UNIT = (n_unit)
  -- if pfilecontext.RESOLVED = (n_resolved*)
  -- if pfilecontext.OPENED = (n_opened*)
  -- if pfilecontext.BYTES = (n_bytes*)
def $file_context_phase_valid(S, pfilecontext) = ($source_filename(n_opened*) /\ $sourcefile_count(S.FILES, n_unit) = 1 /\ $source_unit(S.SOURCES, n_unit) =/= eps /\ $file_binding_at(S.FILEBINDINGS, n_unit) = ({UNIT n_unit, SITE pfilecontext.SITE, KIND pfilecontext.KIND, REQUESTED pfilecontext.REQUESTED, RESOLVED n_resolved*, OPENED n_opened*, BYTES n_bytes*, CLASS pfilecontext.LEXICAL_CLASS}) /\ $code_at(S.CODE, n_unit) =/= eps)
  -- if pfilecontext.PHASE = FILE_UNIT_RUN
  -- if pfilecontext.UNIT = (n_unit)
  -- if pfilecontext.RESOLVED = (n_resolved*)
  -- if pfilecontext.OPENED = (n_opened*)
  -- if pfilecontext.BYTES = (n_bytes*)
dec $file_context_valid(pstate, pfilecontext) : bool
def $file_context_valid(S, pfilecontext) = (S.FILECWD =/= eps /\ S.FILEINCLUDEPATH =/= eps /\ pfilecontext.CWD =/= eps /\ pfilecontext.INCLUDEPATH =/= eps /\ $file_site_valid(S, pfilecontext.SITE, z, pfilecontext.KIND) /\ pfilecontext.CALLER = $call_sourcefile(S.FILES, pfilecontext.SITE) /\ $(pfilecontext.NONCE < S.FILESEQ) /\ $eval_binding_class_valid(S, pfilecontext.LEXICAL_CLASS) /\ $($file_marker_count(S.TODO, pfilecontext) + $file_frame_marker_count(S.FRAMES, pfilecontext)) = 1 /\ $file_marker_count($file_owner_tasks(S, pfilecontext), pfilecontext) = 1 /\ $file_marker_suffix_valid($file_owner_tasks(S, pfilecontext), pfilecontext) /\ $file_context_phase_valid(S, pfilecontext))
  -- if z = $file_site_line(S, pfilecontext.SITE)
dec $file_contexts_valid(pstate, pfilecontext*) : bool
def $file_contexts_valid(S, eps) = true
def $file_contexts_valid(S, pfilecontext :: pfilecontext_tail*) = ($file_context_valid(S, pfilecontext) /\ $file_contexts_valid(S, pfilecontext_tail*))
dec $file_contexts_ordered(pfilecontext*) : bool
def $file_contexts_ordered(eps) = true
def $file_contexts_ordered(pfilecontext :: eps) = true
def $file_contexts_ordered(pfilecontext_new :: pfilecontext_old :: pfilecontext_tail*) = ($(pfilecontext_new.NONCE > pfilecontext_old.NONCE) /\ $(pfilecontext_new.OWNER >= pfilecontext_old.OWNER) /\ $file_contexts_ordered(pfilecontext_old :: pfilecontext_tail*))
dec $file_binding_opened(pfilebinding*, preqbytes) : bool
def $file_binding_opened(eps, n_opened*) = false
def $file_binding_opened(pfilebinding :: pfilebinding_tail*, n_opened*) = true
  -- if pfilebinding.OPENED = n_opened*
def $file_binding_opened(pfilebinding :: pfilebinding_tail*, n_opened*) = $file_binding_opened(pfilebinding_tail*, n_opened*)
  -- if pfilebinding.OPENED =/= n_opened*
dec $file_pending_once_opened(pfilecontext*, preqbytes) : bool
dec $file_once_kind(int) : bool
def $file_pending_once_opened(eps, n_opened*) = false
def $file_pending_once_opened(pfilecontext :: pfilecontext_tail*, n_opened*) = true
  -- if $file_once_kind(pfilecontext.KIND)
  -- if pfilecontext.OPENED = (n_opened*)
def $file_pending_once_opened(pfilecontext :: pfilecontext_tail*, n_opened*) = $file_pending_once_opened(pfilecontext_tail*, n_opened*)
  -- if ~$file_once_kind(pfilecontext.KIND) \/ pfilecontext.OPENED =/= (n_opened*)
dec $file_failed_once_opened(pstate, pfailedsource*, preqbytes) : bool
dec $file_once_kind_optional(int?) : bool
def $file_once_kind_optional((n_kind)) = $file_once_kind(n_kind)
def $file_once_kind_optional(eps) = false
dec $file_failed_once_record(pstate, pfailedsource, preqbytes) : bool
def $file_failed_once_record(S, pfailedsource, n_opened*) = (pfailedsource.ISFILE /\ pfailedsource.FILE = n_opened* /\ $file_once_kind_optional($file_node_kind($origin_node(S.SOURCES, pfailedsource.SITE))))
def $file_failed_once_opened(S, eps, n_opened*) = false
def $file_failed_once_opened(S, pfailedsource :: pfailedsource_tail*, n_opened*) = true
  -- if $file_failed_once_record(S, pfailedsource, n_opened*)
def $file_failed_once_opened(S, pfailedsource :: pfailedsource_tail*, n_opened*) = $file_failed_once_opened(S, pfailedsource_tail*, n_opened*)
  -- if ~$file_failed_once_record(S, pfailedsource, n_opened*)
dec $file_included_paths_valid(pstate, preqbytes*) : bool
def $file_included_paths_valid(S, eps) = true
def $file_included_paths_valid(S, n_opened* :: preqbytes_tail*) = (~(n_opened* <- preqbytes_tail*) /\ $source_filename(n_opened*) /\ (n_opened* = $call_sourcefile(S.FILES, PORIGIN 0 eps) \/ $file_binding_opened(S.FILEBINDINGS, n_opened*) \/ $file_pending_once_opened(S.FILECONTEXTS, n_opened*) \/ $file_failed_once_opened(S, S.FAILEDSOURCES, n_opened*)) /\ $file_included_paths_valid(S, preqbytes_tail*))
dec $file_main_included(pstate) : bool
def $file_main_included(S) = (S.INCLUDEDOPENED = eps)
  -- if S.FILECWD = eps
def $file_main_included(S) = ($call_sourcefile(S.FILES, PORIGIN 0 eps) <- S.INCLUDEDOPENED)
  -- if S.FILECWD = (n_cwd*)
def $file_state_valid(S) = (((S.FILECWD = eps /\ (S.FILEINCLUDEPATH = eps \/ S.STARTUP =/= eps)) \/ (S.FILECWD =/= eps /\ S.FILEINCLUDEPATH =/= eps)) /\ $file_contexts_valid(S, S.FILECONTEXTS) /\ $file_contexts_ordered(S.FILECONTEXTS) /\ $file_main_included(S) /\ $file_included_paths_valid(S, S.INCLUDEDOPENED))
def $call_task_valid(S, FILE_END n_unit) = $file_context_unit_running(S.FILECONTEXTS, n_unit)
dec $file_active_nonce(pfilecontext*) : nat?
def $file_active_nonce(pfilecontext :: pfilecontext_tail*) = (pfilecontext.NONCE)
def $file_active_nonce(eps) = eps
def $call_task_valid(S, FILE_RESOLVE_AWAIT n_nonce) = ($file_active_nonce(S.FILECONTEXTS) = (n_nonce) /\ $file_pending_state_valid(S))
def $call_task_valid(S, FILE_PARSE_AWAIT n_nonce) = ($file_active_nonce(S.FILECONTEXTS) = (n_nonce) /\ $file_pending_state_valid(S))

def $file_binding_at(eps, n) = eps
def $file_binding_at(pfilebinding :: pfilebinding_tail*, n) = (pfilebinding)
  -- if pfilebinding.UNIT = n
def $file_binding_at(pfilebinding :: pfilebinding_tail*, n) = $file_binding_at(pfilebinding_tail*, n)
  -- if pfilebinding.UNIT =/= n
def $file_bindings_valid(S, eps) = true
def $file_bindings_valid(S, pfilebinding :: pfilebinding_tail*) = (S.FILECWD =/= eps /\ $(pfilebinding.UNIT > 0) /\ $file_binding_at(pfilebinding_tail*, pfilebinding.UNIT) = eps /\ $eval_binding_at(S.EVALBINDINGS, pfilebinding.UNIT) = eps /\ $source_unit(S.SOURCES, pfilebinding.UNIT) =/= eps /\ $sourcefile_count(S.FILES, pfilebinding.UNIT) = 1 /\ $file_site_valid(S, pfilebinding.SITE, z, pfilebinding.KIND) /\ $call_sourcefile(S.FILES, PORIGIN pfilebinding.UNIT eps) = pfilebinding.OPENED /\ $source_filename(pfilebinding.OPENED) /\ $eval_binding_class_valid(S, pfilebinding.CLASS) /\ $file_bindings_valid(S, pfilebinding_tail*))
  -- if z = $file_site_line(S, pfilebinding.SITE)
def $file_failed_source_record_valid(S, pfailedsource) = (S.FILECWD =/= eps /\ pfailedsource.LOCATION = eps /\ $file_site_valid(S, pfailedsource.SITE, z, n_kind) /\ $(pfailedsource.UNIT > 0) /\ pfailedsource.BYTES =/= eps /\ pfailedsource.MESSAGE =/= eps /\ $(pfailedsource.LINE > 0) /\ $source_unit(S.SOURCES, pfailedsource.UNIT) = eps /\ $sourcefile_count(S.FILES, pfailedsource.UNIT) = 1 /\ pfailedsource.FILE = $call_sourcefile(S.FILES, PORIGIN pfailedsource.UNIT eps) /\ $source_filename(pfailedsource.FILE) /\ $eval_binding_at(S.EVALBINDINGS, pfailedsource.UNIT) = eps /\ $file_binding_at(S.FILEBINDINGS, pfailedsource.UNIT) = eps)
  -- if z = $file_site_line(S, pfailedsource.SITE)
  -- if $file_node_kind($origin_node(S.SOURCES, pfailedsource.SITE)) = (n_kind)
def $file_source_ppstate(S, pcunit) = $ppstart_eval_state(S, pcunit.ID, pcunit.AST, pfilebinding.OPENED, S.FILECWD, (pclassdesc.NAME))
  -- if $file_binding_at(S.FILEBINDINGS, pcunit.ID) = (pfilebinding)
  -- if pfilebinding.CLASS = (porigin_class)
  -- if $class_at(S.CLASSES, porigin_class) = (pclassdesc)
def $file_source_ppstate(S, pcunit) = $ppstart_eval_state(S, pcunit.ID, pcunit.AST, pfilebinding.OPENED, S.FILECWD, eps)
  -- if $file_binding_at(S.FILEBINDINGS, pcunit.ID) = (pfilebinding)
  -- if pfilebinding.CLASS = eps

dec $file_open_response_valid(pstate, pfileopenresponse) : bool
def $file_open_response_valid(S, FILE_MISSING n_nonce n_caller* n_requested* n_stream*) = (S.COMPLETION = SOURCE_PENDING /\ S.SERVICELEFT =/= eps /\ $file_pending_state_valid(S) /\ $call_descriptors_valid(S) /\ pfilecontext.NONCE = n_nonce /\ pfilecontext.CALLER = n_caller* /\ pfilecontext.REQUESTED = n_requested* /\ n_stream* =/= eps)
  -- if S.FILECONTEXTS = pfilecontext :: pfilecontext_tail*
  -- if pfilecontext.PHASE = FILE_RESOLVE_WAIT
def $file_open_response_valid(S, FILE_OPEN_FAILURE n_nonce n_caller* n_requested* n_resolved* n_warning_path* n_stream*) = (S.COMPLETION = SOURCE_PENDING /\ S.SERVICELEFT =/= eps /\ $file_pending_state_valid(S) /\ $call_descriptors_valid(S) /\ pfilecontext.NONCE = n_nonce /\ pfilecontext.CALLER = n_caller* /\ pfilecontext.REQUESTED = n_requested* /\ n_resolved* =/= eps /\ n_warning_path* =/= eps /\ n_stream* =/= eps)
  -- if S.FILECONTEXTS = pfilecontext :: pfilecontext_tail*
  -- if pfilecontext.PHASE = FILE_RESOLVE_WAIT
def $file_open_response_valid(S, FILE_OPENED n_nonce n_caller* n_requested* n_resolved* n_opened* n_bytes*) = (S.COMPLETION = SOURCE_PENDING /\ S.SERVICELEFT =/= eps /\ $file_pending_state_valid(S) /\ $call_descriptors_valid(S) /\ pfilecontext.NONCE = n_nonce /\ pfilecontext.CALLER = n_caller* /\ pfilecontext.REQUESTED = n_requested* /\ $source_filename(n_opened*))
  -- if S.FILECONTEXTS = pfilecontext :: pfilecontext_tail*
  -- if pfilecontext.PHASE = FILE_RESOLVE_WAIT
def $file_open_response_valid(S, pfileopenresponse) = false -- otherwise

dec $file_open_resume_valid(pstate, pfileopenresponse) : pstate
dec $file_open_failed(pstate, pfilecontext, pfilecontext*, preqbytes, preqbytes) : pstate
dec $file_keyword(int) : preqbytes
def $file_keyword(1) = $ptascii("include")
def $file_keyword(2) = $ptascii("include_once")
def $file_keyword(3) = $ptascii("require")
def $file_keyword(4) = $ptascii("require_once")
def $eval_trace_preparser(S, (pcallcontext), pframe) = [{FILE $call_sourcefile(S.FILES, porigin_parent), LINE z, FUNCTION $file_keyword(n_kind), CLASS eps, TYPE eps, ARGS eps, HASARGS false}]
  -- if $stringify_context_kind(S, pcallcontext)
  -- if $stringify_context_frame_valid(S, pcallcontext, pframe)
  -- if pcallcontext.CALLSITE = (porigin_child)
  -- if pcallcontext.LINE = z
  -- if pframe.ORIGIN = (porigin_child)
  -- if pframe.TODO = (STRINGIFY_RESULT n porigin_child z) :: (FILE_REQUEST porigin_parent z n_kind) :: (ORIGIN_RETURN (porigin_parent)) :: ptask_tail*
  -- if $file_operand_site_valid(S, porigin_parent, porigin_child, z, n_kind)
def $file_trace_frame(S, pfilecontext) = {FILE $call_sourcefile(S.FILES, pfilecontext.SITE), LINE $file_site_line(S, pfilecontext.SITE), FUNCTION $file_keyword(pfilecontext.KIND), CLASS eps, TYPE eps, ARGS $trace_indexed_args([PSTRING n_opened*], 0), HASARGS true}
  -- if pfilecontext.OPENED = (n_opened*)
dec $file_warning_start(pstate, pfilecontext, pfilecontext*, preqbytes, preqbytes) : pstate
def $file_open_failed(S, pfilecontext, pfilecontext_tail*, n_warning_path*, n_stream*) = $file_warning_start(S, pfilecontext, pfilecontext_tail*, n_warning_path*, n_stream*)
dec $file_include_after_compile(preqbytes*, preqbytes) : preqbytes*
dec $file_once_record_open(pstate, int, preqbytes) : pstate
def $file_once_kind(2) = true
def $file_once_kind(4) = true
def $file_once_kind(int) = false -- otherwise
dec $file_once_skip(pstate, pfilecontext, pfilecontext*, preqbytes) : pstate
def $file_once_skip(S, pfilecontext, pfilecontext_tail*, n_path*) = $source_helper_result(S[.FILECONTEXTS = pfilecontext_tail*][.COMPLETION = NORMAL][.SERVICELEFT = eps][.RESULT = KNOWN (PBOOL true)][.BASE = BASE_VALUE (KNOWN PNULL)][.ORIGIN = (pfilecontext.SITE)], HELPER_ONCE_SKIP pfilecontext n_path*, pfilecontext.TAIL)
dec $file_once_skip_path(pstate, preqbytes, preqbytes) : preqbytes
def $file_once_skip_path(S, n_resolved*, n_opened*) = n_resolved*
  -- if n_resolved* =/= eps
  -- if n_resolved* <- S.INCLUDEDOPENED
def $file_once_skip_path(S, n_resolved*, n_opened*) = n_opened*
  -- if ~(n_resolved* =/= eps /\ n_resolved* <- S.INCLUDEDOPENED)
def $file_open_resume_valid(S, FILE_OPEN_FAILURE n_nonce n_caller* n_requested* n_resolved* n_warning_path* n_stream*) = $file_once_skip(S, pfilecontext, pfilecontext_tail*, n_resolved*)
  -- if S.FILECONTEXTS = pfilecontext :: pfilecontext_tail*
  -- if $file_once_kind(pfilecontext.KIND)
  -- if n_resolved* <- S.INCLUDEDOPENED
def $file_open_resume_valid(S, FILE_OPENED n_nonce n_caller* n_requested* n_resolved* n_opened* n_bytes*) = $file_once_skip(S, pfilecontext, pfilecontext_tail*, $file_once_skip_path(S, n_resolved*, n_opened*))
  -- if S.FILECONTEXTS = pfilecontext :: pfilecontext_tail*
  -- if $file_once_kind(pfilecontext.KIND)
  -- if ((n_resolved* =/= eps /\ n_resolved* <- S.INCLUDEDOPENED) \/ n_opened* <- S.INCLUDEDOPENED)
def $file_open_resume_valid(S, FILE_OPENED n_nonce n_caller* n_requested* n_resolved* n_opened* n_bytes*) = $declaration_enter(S_next, n_unit, (pfilecontext.SITE))[.FILES = S_next.FILES ++ [SOURCEFILE n_unit n_opened*]][.FILECONTEXTS = pfilecontext_next :: pfilecontext_tail*][.TODO = (FILE_PARSE_AWAIT n_nonce) :: pfilecontext.TAIL][.COMPLETION = SOURCE_PENDING]
  -- if S.FILECONTEXTS = pfilecontext :: pfilecontext_tail*
  -- if (~$file_once_kind(pfilecontext.KIND) \/ (~(n_resolved* =/= eps /\ n_resolved* <- S.INCLUDEDOPENED) /\ ~(n_opened* <- S.INCLUDEDOPENED)))
  -- if n_unit = $next_eval_unit(S.FILES)
  -- if pfilecontext_next = pfilecontext[.PHASE = FILE_PARSE_WAIT][.UNIT = (n_unit)][.RESOLVED = (n_resolved*)][.OPENED = (n_opened*)][.BYTES = (n_bytes*)]
  -- if S_next = $file_once_record_open(S, pfilecontext.KIND, n_opened*)
def $file_open_resume_valid(S, FILE_MISSING n_nonce n_caller* n_requested* n_stream*) = $file_open_failed(S, pfilecontext, pfilecontext_tail*, n_requested*, n_stream*)
  -- if S.FILECONTEXTS = pfilecontext :: pfilecontext_tail*
def $file_open_resume_valid(S, FILE_OPEN_FAILURE n_nonce n_caller* n_requested* n_resolved* n_warning_path* n_stream*) = $file_open_failed(S, pfilecontext, pfilecontext_tail*, n_warning_path*, n_stream*)
  -- if S.FILECONTEXTS = pfilecontext :: pfilecontext_tail*
  -- if (~$file_once_kind(pfilecontext.KIND) \/ ~(n_resolved* <- S.INCLUDEDOPENED))
def $file_once_record_open(S, n_kind, n_opened*) = S[.INCLUDEDOPENED = $file_include_after_compile(S.INCLUDEDOPENED, n_opened*)]
  -- if $file_once_kind(n_kind)
def $file_once_record_open(S, n_kind, n_opened*) = S
  -- if ~$file_once_kind(n_kind)
dec $file_open_resume(pstate, pfileopenresponse) : pstate
dec $file_open_resume_checked(pstate, pfileopenresponse, bool) : pstate
def $file_open_resume(S, pfileopenresponse) = $file_open_resume_checked(S, pfileopenresponse, $file_open_response_valid(S, pfileopenresponse))
def $file_open_resume_checked(S, pfileopenresponse, true) = $file_open_resume_valid(S, pfileopenresponse)
def $file_open_resume_checked(S, pfileopenresponse, false) = S[.COMPLETION = UNSUPPORTED "invalid file resolution response"]
dec $file_open_continue(pstate, pfileopenresponse) : pstate
dec $file_open_continued(pstate, pstate) : pstate
def $file_open_continue(S, pfileopenresponse) = $file_open_continued(S, $file_open_resume(S, pfileopenresponse))
def $file_open_continued(S, S_next) = $drive_steps(S_next, n)
  -- if S.SERVICELEFT = (n)
  -- if S_next.COMPLETION = NORMAL \/ $shutdown_ready(S_next) \/ $destructor_ready(S_next)
def $file_open_continued(S, S_next) = $drive_steps(S_next, n)
  -- if S.SERVICELEFT = (n)
  -- if S_next.COMPLETION = THROWN text n_message* z
def $file_open_continued(S, S_next) = S_next
  -- if S_next.COMPLETION =/= NORMAL
  -- if ~$shutdown_ready(S_next) /\ ~$destructor_ready(S_next)

dec $file_parse_response_valid(pstate, psourceresponse) : bool
dec $file_parse_context_response(pfilecontext*, psourceresponse) : bool
def $file_parse_context_response(eps, psourceresponse) = false
def $file_parse_context_response(pfilecontext :: pfilecontext_tail*, psourceresponse) = (pfilecontext.PHASE = FILE_PARSE_WAIT /\ pfilecontext.UNIT = ($eval_response_id(psourceresponse)) /\ pfilecontext.BYTES = ($eval_response_bytes(psourceresponse)))
def $file_parse_response_valid(S, psourceresponse) = (S.COMPLETION = SOURCE_PENDING /\ S.SERVICELEFT =/= eps /\ $file_pending_state_valid(S) /\ $file_parse_context_response(S.FILECONTEXTS, psourceresponse) /\ $eval_response_shape(psourceresponse) /\ $call_descriptors_valid(S))

dec $file_compile_result(pstate, pfilecontext, pfilecontext*, ppstate) : pstate
dec $file_compile_stop_trace(pstate, pfilecontext, ppstate) : ptraceframe*
def $file_compile_stop_trace(S, pfilecontext, P) = $eval_exception_trace(S) -- otherwise
def $file_compile_result(S_compiled, pfilecontext, pfilecontext_tail*, P) = S_compiled[.FILECONTEXTS = pfilecontext[.PHASE = FILE_UNIT_RUN][.TAIL = $source_operand_tail(pfilecontext.TAIL)] :: pfilecontext_tail*][.TODO = $iterator_notice_work(S_compiled.TODO, $source_operand_work(S_compiled, n_unit, $compiled_work(n_unit, P.WORK) ++ [FILE_END n_unit], pfilecontext.TAIL))][.SERVICELEFT = eps][.ORIGIN = (pfilecontext.SITE)][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)][.INCLUDEDOPENED = $file_include_after_compile(S_compiled.INCLUDEDOPENED, n_opened*)]
  -- if S_compiled.COMPLETION = NORMAL
  -- if P.COMPLETION = PPCNORMAL
  -- if pfilecontext.UNIT = (n_unit)
  -- if pfilecontext.OPENED = (n_opened*)
  -- if $code_at(S_compiled.CODE, n_unit) =/= eps
def $file_compile_result(S_compiled, pfilecontext, pfilecontext_tail*, P) = S_compiled[.FILECONTEXTS = pfilecontext_tail*][.TODO = pfilecontext.TAIL][.SERVICELEFT = eps][.COMPILESTOP = true][.TRACE = $file_compile_stop_trace(S_compiled, pfilecontext, P)]
  -- if S_compiled.COMPLETION = STATICBYTES n_message* z
def $file_compile_result(S_compiled, pfilecontext, pfilecontext_tail*, P) = S_compiled[.FILECONTEXTS = pfilecontext_tail*][.TODO = pfilecontext.TAIL][.SERVICELEFT = eps][.COMPILESTOP = true][.TRACE = $eval_exception_trace(S_compiled)]
  -- if S_compiled.COMPLETION = STATICERROR text z
def $file_compile_result(S_compiled, pfilecontext, pfilecontext_tail*, P) = S_compiled[.FILECONTEXTS = pfilecontext_tail*][.TODO = pfilecontext.TAIL][.SERVICELEFT = eps][.COMPILESTOP = true][.TRACE = $eval_exception_trace(S_compiled)]
  -- if S_compiled.COMPLETION = FATAL n_message* z
def $file_compile_result(S_compiled, pfilecontext, pfilecontext_tail*, P) = S_object[.FILECONTEXTS = pfilecontext_tail*][.TODO = (THROW_SEARCH n_object) :: pfilecontext.TAIL][.ORIGIN = (pfilecontext.SITE)][.SERVICELEFT = eps][.COMPLETION = NORMAL][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)][.HELD = eps][.CONSTCONTEXT = eps]
  -- if S_compiled.COMPLETION = THROWN text n_message* z
  -- if S_object = $throwable_materialize(S_compiled)
  -- if S_object.COMPLETION = THROWING n_object
def $file_compile_result(S_compiled, pfilecontext, pfilecontext_tail*, P) = S_compiled[.FILECONTEXTS = pfilecontext_tail*][.TODO = pfilecontext.TAIL][.SERVICELEFT = eps][.COMPLETION = UNSUPPORTED "file compiler state pending"]
  -- if S_compiled.COMPLETION = NORMAL
  -- if P.COMPLETION =/= PPCNORMAL
def $file_compile_result(S_compiled, pfilecontext, pfilecontext_tail*, P) = S_compiled[.FILECONTEXTS = pfilecontext_tail*][.TODO = pfilecontext.TAIL][.SERVICELEFT = eps][.COMPLETION = UNSUPPORTED "file compiled source missing code"]
  -- if S_compiled.COMPLETION = NORMAL
  -- if P.COMPLETION = PPCNORMAL
  -- if pfilecontext.UNIT = (n_unit)
  -- if $code_at(S_compiled.CODE, n_unit) = eps
def $file_compile_result(S_compiled, pfilecontext, pfilecontext_tail*, P) = S_compiled[.FILECONTEXTS = pfilecontext_tail*][.TODO = pfilecontext.TAIL][.SERVICELEFT = eps]
  -- if S_compiled.COMPLETION = UNSUPPORTED text
def $file_include_after_compile(preqbytes_all*, n_opened*) = preqbytes_all* ++ [n_opened*]
  -- if ~(n_opened* <- preqbytes_all*)
def $file_include_after_compile(preqbytes_all*, n_opened*) = preqbytes_all*
  -- if n_opened* <- preqbytes_all*

dec $file_parse_resume_accepted(pstate, pfilecontext, pfilecontext*, program) : pstate
dec $file_parse_resume_rejected(pstate, pfilecontext, pfilecontext*, pfailedkind, nat*, int) : pstate
def $file_parse_resume_accepted(S, pfilecontext, pfilecontext_tail*, program) = $file_compile_result(S_compiled, pfilecontext, pfilecontext_tail*, P)
  -- if pfilecontext.UNIT = (n_unit)
  -- if pfilecontext.RESOLVED = (n_resolved*)
  -- if pfilecontext.OPENED = (n_opened*)
  -- if pfilecontext.BYTES = (n_bytes*)
  -- if P = $ppstart_eval_state(S, n_unit, program, n_opened*, S.FILECWD, $eval_compiler_class(S))
  -- if ~$declaration_parser_rejects($declaration_preflight(P.FOLD.SOURCE.OCCURRENCES))
  -- if pfilebinding = {UNIT n_unit, SITE pfilecontext.SITE, KIND pfilecontext.KIND, REQUESTED pfilecontext.REQUESTED, RESOLVED n_resolved*, OPENED n_opened*, BYTES n_bytes*, CLASS pfilecontext.LEXICAL_CLASS}
  -- if S_compiled = $compile_source_append(S[.COMPLETION = NORMAL][.FILEBINDINGS = S.FILEBINDINGS ++ [pfilebinding]], P)
def $file_parse_resume_accepted(S, pfilecontext, pfilecontext_tail*, program) = $file_parse_resume_rejected(S, pfilecontext, pfilecontext_tail*, FAILED_COMPILE, ptbytes_message, z)
  -- if pfilecontext.UNIT = (n_unit)
  -- if $declaration_preflight($pcsource(n_unit, program).OCCURRENCES) = (COMPILETHROWN ptbytes_message z)
dec $file_parse_resume_valid(pstate, psourceresponse) : pstate
def $file_parse_resume_valid(S, SOURCE_ACCEPT n_unit n_bytes* program) = $file_parse_resume_accepted(S, pfilecontext, pfilecontext_tail*, program)
  -- if S.FILECONTEXTS = pfilecontext :: pfilecontext_tail*
def $file_parse_resume_rejected(S, pfilecontext, pfilecontext_tail*, pfailedkind, n_message*, z) = S_object[.FILECONTEXTS = pfilecontext_tail*][.TODO = $source_operand_throw(n_object, pfilecontext.TAIL)][.ORIGIN = (pfilecontext.SITE)][.SERVICELEFT = eps][.COMPLETION = NORMAL][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)][.HELD = eps][.CONSTCONTEXT = eps]
  -- if pfilecontext.UNIT = (n_unit)
  -- if pfilecontext.OPENED = (n_opened*)
  -- if pfilecontext.BYTES = (n_bytes*)
  -- if pfailedsource = {UNIT n_unit, SITE pfilecontext.SITE, BYTES n_bytes*, FILE n_opened*, ISFILE true, KIND pfailedkind, MESSAGE n_message*, LINE z, LOCATION eps}
  -- if S_failed = $declaration_exit(S, n_unit, PCSREJECT)[.FAILEDSOURCES = pfailedsource :: S.FAILEDSOURCES][.ORIGIN = (PORIGIN n_unit eps)][.COMPLETION = THROWN $failed_source_kind(pfailedkind) n_message* z]
  -- if S_object = $throwable_allocate_at(S_failed, $failed_source_kind(pfailedkind), n_message*, PORIGIN n_unit eps, z, $eval_exception_trace(S_failed))
  -- if S_object.COMPLETION = THROWING n_object
def $file_parse_resume_rejected(S, pfilecontext, pfilecontext_tail*, pfailedkind, n_message*, z) = S_object[.FILECONTEXTS = pfilecontext_tail*][.TODO = pfilecontext.TAIL][.SERVICELEFT = eps]
  -- if pfilecontext.UNIT = (n_unit)
  -- if pfilecontext.OPENED = (n_opened*)
  -- if pfilecontext.BYTES = (n_bytes*)
  -- if pfailedsource = {UNIT n_unit, SITE pfilecontext.SITE, BYTES n_bytes*, FILE n_opened*, ISFILE true, KIND pfailedkind, MESSAGE n_message*, LINE z, LOCATION eps}
  -- if S_failed = $declaration_exit(S, n_unit, PCSREJECT)[.FAILEDSOURCES = pfailedsource :: S.FAILEDSOURCES][.ORIGIN = (PORIGIN n_unit eps)][.COMPLETION = THROWN $failed_source_kind(pfailedkind) n_message* z]
  -- if S_object = $throwable_allocate_at(S_failed, $failed_source_kind(pfailedkind), n_message*, PORIGIN n_unit eps, z, $eval_exception_trace(S_failed))
  -- if ~$eval_allocated_throw(S_object.COMPLETION)
def $file_parse_resume_valid(S, SOURCE_PARSE_REJECT n_unit n_bytes* n_message* z) = $file_parse_resume_rejected(S, pfilecontext, pfilecontext_tail*, FAILED_PARSE, n_message*, z)
  -- if S.FILECONTEXTS = pfilecontext :: pfilecontext_tail*
def $file_parse_resume_valid(S, SOURCE_COMPILE_REJECT n_unit n_bytes* n_message* z) = $file_parse_resume_rejected(S, pfilecontext, pfilecontext_tail*, FAILED_COMPILE, n_message*, z)
  -- if S.FILECONTEXTS = pfilecontext :: pfilecontext_tail*
dec $file_parse_resume(pstate, psourceresponse) : pstate
dec $file_parse_resume_checked(pstate, psourceresponse, bool) : pstate
def $file_parse_resume(S, psourceresponse) = $file_parse_resume_checked(S, psourceresponse, $file_parse_response_valid(S, psourceresponse))
def $file_parse_resume_checked(S, psourceresponse, true) = $file_parse_resume_valid(S, psourceresponse)
def $file_parse_resume_checked(S, psourceresponse, false) = S[.COMPLETION = UNSUPPORTED "invalid file parser response"]
dec $file_parse_continue(pstate, psourceresponse) : pstate
dec $file_parse_continued(pstate, pstate) : pstate
def $file_parse_continue(S, psourceresponse) = $file_parse_continued(S, $file_parse_resume(S, psourceresponse))
def $file_parse_continued(S, S_next) = $drive_steps(S_next, n)
  -- if S.SERVICELEFT = (n)
  -- if S_next.COMPLETION = NORMAL \/ $shutdown_ready(S_next) \/ $destructor_ready(S_next)
def $file_parse_continued(S, S_next) = S_next
  -- if S_next.COMPLETION =/= NORMAL
  -- if ~$shutdown_ready(S_next) /\ ~$destructor_ready(S_next)

rule PhpStep/file-end: S ~> S[.FILECONTEXTS = pfilecontext_tail*][.TODO = ptask_tail*][.RESULT = KNOWN (PINT 1)][.BASE = BASE_VALUE (KNOWN PNULL)][.ORIGIN = (pfilecontext.SITE)]
  -- if S.TODO = (FILE_END n_unit) :: ptask_tail*
  -- if S.FILECONTEXTS = pfilecontext :: pfilecontext_tail*
  -- if pfilecontext.UNIT = (n_unit)
  -- if pfilecontext.PHASE = FILE_UNIT_RUN
  -- if pfilecontext.OWNER = |S.FRAMES|
  -- if pfilecontext.TAIL = ptask_tail*
def $eval_end_marker(FILE_END n_unit) = true
def $return_step(S, poperand, (PORIGIN n_unit pcpath_source), (FILE_END n_unit) :: ptask_tail*) = S[.FILECONTEXTS = pfilecontext_tail*][.TODO = ptask_tail*][.RESULT = poperand][.BASE = BASE_VALUE (KNOWN PNULL)][.ORIGIN = (pfilecontext.SITE)][.HELD = eps]
  -- if S.FILECONTEXTS = pfilecontext :: pfilecontext_tail*
  -- if pfilecontext.UNIT = (n_unit)
  -- if pfilecontext.PHASE = FILE_UNIT_RUN
  -- if pfilecontext.OWNER = |S.FRAMES|
  -- if pfilecontext.TAIL = ptask_tail*
def $throwable_marker(FILE_END n_unit) = true
rule PhpStep/file-throw-cross: S ~> S[.FILECONTEXTS = pfilecontext_tail*][.TODO = (THROW_SEARCH n_object) :: ptask_tail*][.ORIGIN = (pfilecontext.SITE)][.HELD = eps]
  -- if S.TODO = (THROW_SEARCH n_object) :: (FILE_END n_unit) :: ptask_tail*
  -- if S.FILECONTEXTS = pfilecontext :: pfilecontext_tail*
  -- if pfilecontext.UNIT = (n_unit)
  -- if pfilecontext.PHASE = FILE_UNIT_RUN
  -- if pfilecontext.OWNER = |S.FRAMES|
  -- if pfilecontext.TAIL = ptask_tail*

dec $php_file_run(program, nat, preqbytes, preqbytes) : pstate
def $php_file_run(program, n, n_file*, n_cwd*) = $drive($compile_source($initial_state(NORMAL)[.FILES = [SOURCEFILE 0 n_file*]][.FILECWD = (n_cwd*)][.FILEINCLUDEPATH = ($ptascii(".:"))][.INCLUDEDOPENED = [n_file*]], $ppstart_cwd(0, program, n_file*, (n_cwd*))), n)
  -- if $source_filename(n_file*)
  -- if $source_filename(n_cwd*)
dec $php_request_file_run(program, nat, preqbytes, prequest, preqbytes) : pstate
def $php_request_file_run(program, n, n_file*, Q, n_cwd*) = $drive($compile_source($request_bootstrap($initial_state(NORMAL)[.FILES = [SOURCEFILE 0 n_file*]][.FILECWD = (n_cwd*)][.FILEINCLUDEPATH = ($ptascii(".:"))][.INCLUDEDOPENED = [n_file*]], Q), $ppstart_cwd(0, program, n_file*, (n_cwd*))), n)
  -- if Q.CWD = (n_cwd*)
  -- if $source_filename(n_file*)
  -- if $source_filename(n_cwd*)
