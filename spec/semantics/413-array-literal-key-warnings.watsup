;; Missing ADDREFs are count biases, not missing logical aliases. Inverse
;; retargeting cancels a bias before creating a new request root or debt.
dec $literal_reference_delete(nat*, nat) : nat*
def $literal_reference_delete(eps, n) = eps
def $literal_reference_delete(n :: n_tail*, n) = n_tail*
def $literal_reference_delete(n_other :: n_tail*, n) = n_other :: $literal_reference_delete(n_tail*, n)
  -- if n_other =/= n
def $literal_reference_retain(S, n) = S[.LITERALREFDEBTS = $literal_reference_delete(S.LITERALREFDEBTS, n)]
  -- if n <- S.LITERALREFDEBTS
def $literal_reference_retain(S, n) = S[.LITERALREFRETAINED = S.LITERALREFRETAINED ++ [n]]
  -- if ~(n <- S.LITERALREFDEBTS)
def $literal_reference_owe(S, n) = S[.LITERALREFRETAINED = $literal_reference_delete(S.LITERALREFRETAINED, n)]
  -- if n <- S.LITERALREFRETAINED
def $literal_reference_owe(S, n) = S[.LITERALREFDEBTS = S.LITERALREFDEBTS ++ [n]]
  -- if ~(n <- S.LITERALREFRETAINED)

def $literal_reference_debts_valid(S, eps) = true
def $literal_reference_debts_valid(S, n :: n_tail*) = ($call_reference_operand_valid(S, REFERENCE n) /\ ~(n <- S.LITERALREFRETAINED) /\ $literal_reference_debts_valid(S, n_tail*))

