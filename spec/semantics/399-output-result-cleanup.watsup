def $call_task_valid(S, OB_USER_NORMAL_COMMIT pobinvoke pdestructionframe poboutput) = ($ob_normal_certificate(S, pobinvoke, pdestructionframe) /\ pobinvoke.SENT = eps /\ $throwable_live(S, n) /\ $ob_user_output_valid(S, poboutput) /\ pdestructionframe.VALUE = KNOWN poboutput.VALUE)
  -- if pdestructionframe.PENDING = (n)
