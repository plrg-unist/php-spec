def $call_task_valid(S, OB_USER_NORMAL_RESULT pobinvoke pdestructionframe) = ($ob_normal_certificate(S, pobinvoke, pdestructionframe) /\ $ob_user_fci_arguments(pobinvoke) /\ pdestructionframe.PENDING = eps)
def $call_task_valid(S, OB_USER_NORMAL_PENDING pobinvoke pdestructionframe) = ($ob_normal_certificate(S, pobinvoke, pdestructionframe) /\ $ob_user_fci_arguments(pobinvoke) /\ $throwable_live(S, n))
