  -- if S.TODO = ptask :: ptask_tail*
  -- if $ob_retired_read_task(ptask)
def $ob_user_boundary_reason(S) = "access through a retired output-handler receiver"
  -- if $ob_user_access_pending(S)

def $ob_normal_reference_rest(eps) = false
