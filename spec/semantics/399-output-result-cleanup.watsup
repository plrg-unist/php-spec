;; The C API frame remains the caller while callee CVs are released. Authentic
;; sealed-return or pending body-throw prefixes supply its site and trace suffix.
def $ob_callee_cleanup_call(S, pdestructionframe, (DESTRUCTOR_RELEASE pdestructionrelease) :: ptask_tail*) = $ob_callee_cleanup_call(S, pdestructionframe, ptask_tail*)
