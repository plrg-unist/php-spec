def $ob_normal_commit(S, pobinvoke, pdestructionframe, poboutput) = $ob_normal_api_commit(S, pobinvoke, poboutput, n)
  -- if pobinvoke.CALL = OB_API pconfigcall
  -- if pdestructionframe.PENDING = (n)
def $ob_normal_commit(S, pobinvoke, pdestructionframe, poboutput) = $output_failure_next(S[.OUTPUTBUFFERS = $output_set(S.OUTPUTBUFFERS, poutputbuffer.ID, $ob_user_committed(poutputbuffer, poboutput))], pobwrite, n, $ob_user_routed_bytes(poutputbuffer, poboutput))
  -- if pobinvoke.CALL = OB_WRITE pobwrite
  -- if pdestructionframe.PENDING = (n)
  -- if $output_selected(S, pobinvoke) = (poutputbuffer)
def $ob_normal_api_commit(S, pobinvoke, poboutput, n) = $ob_api_failure_return(S[.OUTPUTBUFFERS = ($ob_user_committed(poutputbuffer, poboutput)) :: poutputbuffer_lower*], n, ptask_native*)
  -- if S.TODO = ptask :: ptask_native*
  -- if pobinvoke.CALL = OB_API pconfigcall
  -- if S.OUTPUTBUFFERS = poutputbuffer :: poutputbuffer_lower*
  -- if pconfigcall.KIND = INTRINSIC_OB_CLEAN
def $ob_normal_api_commit(S, pobinvoke, poboutput, n) = $ob_api_failure_release(S[.OUTPUTBUFFERS = poutputbuffer_lower*], {CALL pconfigcall, BUFFER pobinvoke.BUFFER, VALUE pobinvoke.VALUE}, S.CURRENT, ptask_native*, n)
  -- if S.TODO = ptask :: ptask_native*
  -- if pobinvoke.CALL = OB_API pconfigcall
  -- if S.OUTPUTBUFFERS = poutputbuffer :: poutputbuffer_lower*
  -- if $ob_pop_kind(pconfigcall.KIND) /\ $ob_clean_kind(pconfigcall.KIND)
def $ob_normal_api_commit(S, pobinvoke, poboutput, n) = $ob_normal_failed_write($output_api_begin(S[.OUTPUTBUFFERS = poutputbuffer_lower*], pconfigcall, $ob_user_routed_bytes(poutputbuffer, poboutput), OUTPUT_USER_DONE pobinvoke poutputbuffer poboutput (pconfigcall.KIND = INTRINSIC_OB_FLUSH)), n)
  -- if pobinvoke.CALL = OB_API pconfigcall
  -- if S.OUTPUTBUFFERS = poutputbuffer :: poutputbuffer_lower*
  -- if pconfigcall.KIND = INTRINSIC_OB_FLUSH \/ $ob_pop_kind(pconfigcall.KIND) /\ ~$ob_clean_kind(pconfigcall.KIND)
def $ob_normal_failed_write(S, n) = S[.TODO = (OUTPUT_FAIL_WRITE pobwrite n) :: ptask_native*]
  -- if S.TODO = (OUTPUT_WRITE pobwrite) :: ptask_native*
