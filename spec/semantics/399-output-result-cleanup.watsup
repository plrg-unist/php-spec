def $task_nodes(OB_USER_NORMAL_RESULT pobinvoke pdestructionframe) = $ob_user_nodes(pobinvoke) ++ $operand_nodes(pdestructionframe.VALUE)
def $task_nodes(OB_USER_NORMAL_PENDING pobinvoke pdestructionframe) = $ob_user_nodes(pobinvoke) ++ $operand_nodes(pdestructionframe.VALUE) ++ $instance_roots(pdestructionframe.PENDING)
def $task_nodes(OB_USER_NORMAL_COMMIT pobinvoke pdestructionframe poboutput) = $ob_user_nodes(pobinvoke) ++ $operand_nodes(pdestructionframe.VALUE) ++ $instance_roots(pdestructionframe.PENDING)
def $ob_user_active_task(OB_USER_NORMAL_RESULT pobinvoke pdestructionframe) = (pobinvoke.BUFFER.ID)
def $ob_user_active_task(OB_USER_NORMAL_PENDING pobinvoke pdestructionframe) = (pobinvoke.BUFFER.ID)
def $ob_user_active_task(OB_USER_NORMAL_COMMIT pobinvoke pdestructionframe poboutput) = (pobinvoke.BUFFER.ID)
