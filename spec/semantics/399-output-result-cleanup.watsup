;; Pending E prevents zend_call_function from entering a selected error handler.
;; A default diagnostic still follows reporting/display rules; recording wins.
def $ob_normal_report(S, pobinvoke) = S[.ERRORFATALTRACE = eps]
  -- if $eval_compile_recorded_error(S, 8192) \/ $error_handler_eligible(S, 8192)
def $ob_normal_report(S, pobinvoke) = $error_default(S[.ERRORFATALTRACE = eps], DIAGNOSTIC "Deprecated" $ob_user_deprecation(pobinvoke) $ob_call_line(pobinvoke.CALL), 8192)
  -- if ~$eval_compile_recorded_error(S, 8192) /\ ~$error_handler_eligible(S, 8192)
def $ob_normal_deprecation(S, pobinvoke, pdestructionframe) = S_out[.OUTPUTBUFFERS = $output_set(S_out.OUTPUTBUFFERS, poutputbuffer.ID, poutputbuffer_out[.FLAGS = $long_and(poutputbuffer_out.FLAGS, $(-8193))])]
  -- if $output_selected(S, pobinvoke) = (poutputbuffer)
  -- if S_out = $ob_normal_report(S[.OUTPUTBUFFERS = $output_set(S.OUTPUTBUFFERS, poutputbuffer.ID, poutputbuffer[.FLAGS = $long_or($long_and(poutputbuffer.FLAGS, $(-32769)), 8192)])], pobinvoke)
  -- if S_out.COMPLETION = NORMAL
  -- if $output_selected(S_out, pobinvoke) = (poutputbuffer_out)
def $ob_normal_deprecation(S, pobinvoke, pdestructionframe) = S_out
  -- if $output_selected(S, pobinvoke) = (poutputbuffer)
  -- if S_out = $ob_normal_report(S[.OUTPUTBUFFERS = $output_set(S.OUTPUTBUFFERS, poutputbuffer.ID, poutputbuffer[.FLAGS = $long_or($long_and(poutputbuffer.FLAGS, $(-32769)), 8192)])], pobinvoke)
