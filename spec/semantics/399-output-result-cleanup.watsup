rule PhpStep/ob-user-normal-commit: S ~> $ob_normal_commit(S, pobinvoke, pdestructionframe, poboutput)
  -- if S.TODO = (OB_USER_NORMAL_COMMIT pobinvoke pdestructionframe poboutput) :: ptask_tail*
