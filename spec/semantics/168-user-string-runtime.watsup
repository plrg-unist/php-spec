;; A declared or inherited public __toString() makes an ordinary class
;; Stringable even without an explicit implements clause.
def $stringable_instance(S, n) = true
  -- if $(n < |S.OBJECTS|)
  -- if (HOBJECT n) <- S.ALLOCATIONS
  -- if S.OBJECTS[n] = INSTANCE porigin_class
  -- if $class_at(S.CLASSES, porigin_class) = (pclassdesc)
  -- if $effective_method(S, porigin_class, $ptascii("__toString"), |S.CLASSES|) = (pmethoddesc)
  -- if pmethoddesc.VISIBILITY = PROPERTY_PUBLIC
  -- if ~pmethoddesc.ABSTRACT
def $stringable_instance(S, n) = false -- otherwise

def $user_string_value(S, POBJECT n) = $stringable_instance(S, n)
def $user_string_value(S, pvalue) = false -- otherwise

;; Contexts without a resumable callback consumer remain explicit dependencies.
def $stringify(S, POBJECT n, z) = S[.COMPLETION = UNSUPPORTED "user object string conversion"]
  -- if $stringable_instance(S, n)

;; An implicit method call is tied to the source occurrence that demanded a
;; string. Echo uses each operand child, including when two operands share a
;; line; its AT task restores the enclosing echo after emission.
dec $stringify_echo_operand(pstate, expression*, porigin, porigin, int, nat) : bool
def $stringify_echo_operand(S, eps, porigin_parent, porigin_site, z, n) = false
def $stringify_echo_operand(S, expression :: expression_tail*, porigin_parent, porigin_site, z, n) = true
  -- if $origin_child((porigin_parent), [PCINDEX n]) = (porigin_site)
  -- if $origin_node(S.SOURCES, porigin_site) = (expression)
  -- if $runtime_line(S[.ORIGIN = (porigin_site)], eps, expression) = z
def $stringify_echo_operand(S, expression :: expression_tail*, porigin_parent, porigin_site, z, n) = $stringify_echo_operand(S, expression_tail*, porigin_parent, porigin_site, z, $(n + 1))
  -- if $origin_child((porigin_parent), [PCINDEX n]) =/= (porigin_site)
def $stringify_echo_operand(S, expression*, porigin_parent, porigin_site, z, n) = false -- otherwise

dec $stringify_source(pstate, porigin, int, ptask) : bool
dec $echo_emit_source(pstate, porigin, int) : bool
def $echo_emit_source(S, PORIGIN n_unit pcpath_site, z) = true
  -- if $(|pcpath_site| >= 2)
  -- if pcpath_echo = pcpath_site[0:$nabs($( |pcpath_site| - 2))]
  -- if $origin_node(S.SOURCES, PORIGIN n_unit pcpath_echo) = (NStmtEcho (SEQUENCE expression*) metadata)
  -- if $stringify_echo_operand(S, expression*, PORIGIN n_unit (pcpath_echo ++ [PCFIELD 0]), PORIGIN n_unit pcpath_site, z, 0)
def $echo_emit_source(S, porigin_site, z) = false -- otherwise
dec $stringify_local_consumer(expression) : bool
def $stringify_local_consumer(NExprPrint expression metadata) = true
def $stringify_local_consumer(NExprCastString expression metadata) = true
def $stringify_local_consumer(expression) = false -- otherwise
def $stringify_source(S, PORIGIN n_unit pcpath_site, z, EMIT z) = true
  -- if $echo_emit_source(S, PORIGIN n_unit pcpath_site, z)
  -- if $origin_node(S.SOURCES, PORIGIN n_unit pcpath_site) = (expression_site)
  -- if ~$stringify_local_consumer(expression_site)
def $stringify_source(S, porigin_site, z, PRINT_EMIT porigin_site z) = true
  -- if $print_task_valid(S[.ORIGIN = (porigin_site)], porigin_site, z)
def $stringify_source(S, porigin_site, z, CAST_RESULT CASTSTRING z) = true
  -- if $origin_node(S.SOURCES, porigin_site) = (NExprCastString expression metadata)
  -- if $runtime_line(S[.ORIGIN = (porigin_site)], [PCFIELD 0], expression) = z
def $stringify_source(S, porigin_site, z, EVAL_REQUEST porigin_parent z) = $eval_operand_site_valid(S, porigin_parent, porigin_site, z)
def $stringify_source(S, porigin_site, z, ptask) = false -- otherwise

dec $stringify_site_valid(pstate, porigin, int) : bool
def $stringify_site_valid(S, porigin_site, z) = ($stringify_source(S, porigin_site, z, EMIT z) \/ $stringify_source(S, porigin_site, z, PRINT_EMIT porigin_site z) \/ $stringify_source(S, porigin_site, z, CAST_RESULT CASTSTRING z) \/ $eval_operand_child_site(S, porigin_site, z))

dec $stringify_consumer_tail_valid(pstate, porigin, int, ptask, ptask*) : bool
dec $stringify_eval_consumer(ptask) : bool
def $stringify_eval_consumer(EVAL_REQUEST porigin z) = true
def $stringify_eval_consumer(ptask) = false -- otherwise
def $stringify_consumer_tail_valid(S, porigin_site, z, EVAL_REQUEST porigin_parent z, (ORIGIN_RETURN (porigin_parent)) :: ptask_tail*) = $eval_operand_site_valid(S, porigin_parent, porigin_site, z)
def $stringify_consumer_tail_valid(S, porigin_site, z, ptask_consumer, ptask_tail*) = true
  -- if ~$stringify_eval_consumer(ptask_consumer)
def $stringify_consumer_tail_valid(S, porigin_site, z, ptask_consumer, ptask_tail*) = false -- otherwise

dec $stringify_method_selected(pstate, nat, porigin, porigin) : bool
def $stringify_method_selected(S, n, porigin_method, porigin_site) = true
  -- if $stringable_instance(S, n)
  -- if S.OBJECTS[n] = INSTANCE porigin_class
  -- if $effective_method(S, porigin_class, $ptascii("__toString"), |S.CLASSES|) = (pmethoddesc)
  -- if pmethoddesc.FUNCTION.ORIGIN = porigin_method
  -- if $target_function(S, METHOD_TARGET n porigin_method) = (pmethoddesc.FUNCTION)
def $stringify_method_selected(S, n, porigin_method, porigin_site) = false -- otherwise

;; The selected call is either still pending or has saved its conversion
;; result and original consumer in the caller frame immediately below it.
def $stringify_pending(S, METHOD_TARGET n porigin_method, porigin_site) = true
  -- if S.ORIGIN = (porigin_site)
  -- if S.TODO = (CALL_ARGS (METHOD_TARGET n porigin_method) eps 0 eps (porigin_site) z) :: (STRINGIFY_RESULT n porigin_site z) :: ptask_consumer :: ptask_tail*
  -- if $stringify_source(S, porigin_site, z, ptask_consumer)
  -- if $stringify_consumer_tail_valid(S, porigin_site, z, ptask_consumer, ptask_tail*)
def $stringify_pending(S, pcalltarget, porigin_site) = false -- otherwise
def $stringify_pending_site(S, porigin_site) = true
  -- if S.TODO = (CALL_ARGS (METHOD_TARGET n porigin_method) eps 0 eps (porigin_site) z) :: (STRINGIFY_RESULT n porigin_site z) :: ptask_tail*
  -- if $stringify_pending(S, METHOD_TARGET n porigin_method, porigin_site)
def $stringify_pending_site(S, porigin_site) = false -- otherwise

dec $stringify_entered(pstate, pcallcontext?, pframe*, pcalltarget, porigin) : bool
def $stringify_entered(S, (pcallcontext), pframe :: pframe_tail*, METHOD_TARGET n porigin_method, porigin_site) = true
  -- if $context_target(pcallcontext) = METHOD_TARGET n porigin_method
  -- if pcallcontext.CALLSITE = (porigin_site)
  -- if pframe.ORIGIN = (porigin_site)
  -- if pframe.TODO = (STRINGIFY_RESULT n porigin_site z) :: ptask_consumer :: ptask_tail*
  -- if $stringify_source(S, porigin_site, z, ptask_consumer)
  -- if $stringify_consumer_tail_valid(S, porigin_site, z, ptask_consumer, ptask_tail*)
def $stringify_entered(S, (pcallcontext), pframe :: pframe_tail*, pcalltarget, porigin_site) = $stringify_entered(S, pframe.CONTEXT, pframe_tail*, pcalltarget, porigin_site)
  -- if ~($context_target(pcallcontext) = pcalltarget /\ pcallcontext.CALLSITE = (porigin_site) /\ pframe.ORIGIN = (porigin_site))
def $stringify_entered(S, eps, pframe :: pframe_tail*, pcalltarget, porigin_site) = $stringify_entered(S, pframe.CONTEXT, pframe_tail*, pcalltarget, porigin_site)
def $stringify_entered(S, pcallcontext?, eps, pcalltarget, porigin_site) = false
def $stringify_entered(S, pcallcontext?, pframe*, pcalltarget, porigin_site) = false -- otherwise

def $stringify_selected(S, METHOD_TARGET n porigin_method, porigin_site) = true
  -- if $stringify_method_selected(S, n, porigin_method, porigin_site)
  -- if $stringify_pending(S, METHOD_TARGET n porigin_method, porigin_site) \/ $stringify_entered(S, S.CURRENT, S.FRAMES, METHOD_TARGET n porigin_method, porigin_site)
def $stringify_selected(S, pcalltarget, porigin_site) = false -- otherwise

def $stringify_context(S, pcallcontext) = true
  -- if pcallcontext.CALLSITE = (porigin_site)
  -- if $context_target(pcallcontext) = METHOD_TARGET n porigin_method
  -- if $stringify_method_selected(S, n, porigin_method, porigin_site)
  -- if $stringify_entered(S, S.CURRENT, S.FRAMES, METHOD_TARGET n porigin_method, porigin_site)
def $stringify_context(S, pcallcontext) = false -- otherwise

;; Validate each active and saved implicit call against its own immediately
;; following caller frame. Reentrant calls at the same source site cannot borrow
;; a newer call's marker when an older saved context is checked.
def $stringify_context_kind(S, pcallcontext) = true
  -- if pcallcontext.CALLSITE = (porigin_site)
  -- if $context_target(pcallcontext) = METHOD_TARGET n porigin_method
  -- if $stringify_method_selected(S, n, porigin_method, porigin_site)
  -- if $stringify_site_valid(S, porigin_site, pcallcontext.LINE)
  -- if ~$method_call_selected(S, METHOD_TARGET n porigin_method, porigin_site)
def $stringify_context_kind(S, pcallcontext) = false -- otherwise
dec $stringify_frame_marker(pframe) : bool
def $stringify_frame_marker(pframe) = true
  -- if pframe.TODO = (STRINGIFY_RESULT n porigin_site z) :: ptask_tail*
def $stringify_frame_marker(pframe) = false -- otherwise
def $stringify_context_frame_valid(S, pcallcontext, pframe) = true
  -- if ~$stringify_context_kind(S, pcallcontext)
  -- if ~$stringify_frame_marker(pframe)
def $stringify_context_frame_valid(S, pcallcontext, pframe) = true
  -- if $stringify_context_kind(S, pcallcontext)
  -- if $context_target(pcallcontext) = METHOD_TARGET n porigin_method
  -- if pcallcontext.CALLSITE = (porigin_site)
  -- if pframe.ORIGIN = (porigin_site)
  -- if pframe.TODO = (STRINGIFY_RESULT n porigin_site z) :: ptask_consumer :: ptask_tail*
  -- if z = pcallcontext.LINE
  -- if $stringify_source(S, porigin_site, pcallcontext.LINE, ptask_consumer)
  -- if $stringify_consumer_tail_valid(S, porigin_site, z, ptask_consumer, ptask_tail*)
def $stringify_context_frame_valid(S, pcallcontext, pframe) = false -- otherwise
def $stringify_chain_valid(S, eps, eps) = true
def $stringify_chain_valid(S, (pcallcontext), eps) = ~$stringify_context_kind(S, pcallcontext)
def $stringify_chain_valid(S, (pcallcontext), pframe :: pframe_tail*) = ($stringify_context_frame_valid(S, pcallcontext, pframe) /\ $stringify_chain_valid(S, pframe.CONTEXT, pframe_tail*))
def $stringify_chain_valid(S, eps, pframe :: pframe_tail*) = $stringify_chain_valid(S, pframe.CONTEXT, pframe_tail*)
  -- if ~$stringify_frame_marker(pframe)
def $stringify_chain_valid(S, eps, pframe :: pframe_tail*) = false
  -- if $stringify_frame_marker(pframe)

def $task_nodes(STRINGIFY_RESULT n porigin_site z) = [HOBJECT n]

dec $stringify_result_valid(pstate, nat, porigin, int) : bool
def $stringify_result_valid(S, n, porigin_site, z) = true
  -- if S.ORIGIN = (porigin_site)
  -- if $stringable_instance(S, n)
  -- if $origin_node(S.SOURCES, porigin_site) = (expression)
  -- if $stringify_site_valid(S, porigin_site, z)
def $stringify_result_valid(S, n, porigin_site, z) = false -- otherwise
def $call_task_valid(S, STRINGIFY_RESULT n porigin_site z) = $stringify_result_valid(S, n, porigin_site, z)
def $call_task_valid(S, EMIT z) = true
  -- if S.ORIGIN = (porigin_site)
  -- if $echo_emit_source(S, porigin_site, z)

dec $stringify_task_marker(ptask) : bool
def $stringify_task_marker(STRINGIFY_RESULT n porigin_site z) = true
def $stringify_task_marker(ptask) = false -- otherwise
dec $stringify_pair_valid(pstate, ptask, ptask, ptask*, bool) : bool
def $stringify_pair_valid(S, ptask, ptask_next, ptask_tail*, false) = true
def $stringify_pair_valid(S, STRINGIFY_RESULT n porigin_site z, ptask_next, ptask_tail*, true) = ($stringify_source(S, porigin_site, z, ptask_next) /\ $stringify_consumer_tail_valid(S, porigin_site, z, ptask_next, ptask_tail*))
def $stringify_pairs_valid(S, eps) = true
def $stringify_pairs_valid(S, [ptask]) = ~$stringify_task_marker(ptask)
def $stringify_pairs_valid(S, ptask :: ptask_next :: ptask_tail*) = ($stringify_pair_valid(S, ptask, ptask_next, ptask_tail*, $stringify_task_marker(ptask)) /\ $stringify_pairs_valid($call_after_origin(S, ptask), ptask_next :: ptask_tail*))
def $stringify_frames_pairs_valid(S, eps) = true
def $stringify_frames_pairs_valid(S, pframe :: pframe_tail*) = ($stringify_pairs_valid(S[.ORIGIN = pframe.ORIGIN], pframe.TODO) /\ $stringify_frames_pairs_valid(S, pframe_tail*))

def $user_string_begin(S, n, porigin_site, z, ptask_consumer, ptask_tail*) = S[.TODO = (CALL_ARGS (METHOD_TARGET n pmethoddesc.FUNCTION.ORIGIN) eps 0 eps (porigin_site) z) :: (STRINGIFY_RESULT n porigin_site z) :: ptask_consumer :: ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.OBJECTS[n] = INSTANCE porigin_class
  -- if $effective_method(S, porigin_class, $ptascii("__toString"), |S.CLASSES|) = (pmethoddesc)

rule PhpStep/user-string-echo-call: S ~> $user_string_begin(S_read, n, porigin_site, z, EMIT z, ptask_tail*)
  -- if S.TODO = (EMIT z) :: ptask_tail*
