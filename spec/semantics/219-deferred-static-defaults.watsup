;; Deferred static defaults keep values in the existing declaring-property cell.
;; Fill history contains only source origins; it does not retain a second value.
def $static_default_pending(PROP_DEFERRED porigin) = true
def $static_default_pending(ppropstate) = false -- otherwise

def $property_default_state(S, ppropertydesc) = (PROP_DEFERRED porigin)
  -- if ppropertydesc.STATIC
  -- if ppropertydesc.DEFAULT = PROP_DEFERRED porigin

