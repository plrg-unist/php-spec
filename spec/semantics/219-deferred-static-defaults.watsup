  -- if $static_default_active(S, pstaticdefaultcontext.DECL)
  -- if $static_default_ast(S, pstaticdefaultcontext)
  -- if ~$static_default_binding_head(S.TODO, pstaticdefaultcontext.DECL)
def $static_default_trace_context(S) = eps -- otherwise
def $static_default_error_origin(S) = pstaticdefaultcontext.ORIGIN
  -- if ~$class_constant_active(S)
  -- if $static_default_context_at(S.TODO) = (pstaticdefaultcontext)
  -- if $static_default_active(S, pstaticdefaultcontext.DECL)
  -- if ~$static_default_ast(S, pstaticdefaultcontext)
def $static_default_error_origin(S) = S.ORIGIN -- otherwise
def $static_default_trace(S) = [{FILE $call_sourcefile(S.FILES, porigin_trigger), LINE pstaticdefaultcontext.LINE, FUNCTION $ptascii("[constant expression]"), CLASS eps, TYPE eps, ARGS eps, HASARGS false}]
  -- if $static_default_trace_context(S) = (pstaticdefaultcontext)
  -- if pstaticdefaultcontext.ORIGIN = (porigin_trigger)
  -- if S.ORIGIN = (PORIGIN n pcpath)
  -- if $code_at(S.CODE, n) = (pcode)
  -- if $code_expression(pcode.EXPRESSIONS, pcpath) = ((z, b))
  -- if $class_constant_error_origin(S) = (porigin_error)
  -- if $call_sourcefile(S.FILES, porigin_error) =/= $call_sourcefile(S.FILES, porigin_trigger) \/ $constant_runtime_line(S, z) =/= pstaticdefaultcontext.LINE
def $static_default_trace(S) = eps -- otherwise

rule PhpStep/static-default-update: S ~> S[.CONSTCONTEXT = ({ORIGIN porigin, LINE z, FACTS eps})][.ORIGIN = (porigin)][.TODO = [AT porigin_initializer (EVAL expression), STATIC_DEFAULT_BIND {DECL porigin, ROOT porigin_root, PREVIOUS S.CONSTCONTEXT, ORIGIN S.ORIGIN, LINE z}] ++ ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
  -- if S.TODO = (STATIC_DEFAULT_UPDATE porigin z) :: ptask_tail*
  -- if $class_static_active_desc(S, S.CLASSNAMES, porigin) = (ppropertydesc)
  -- if ppropertydesc.DEFAULT = PROP_DEFERRED porigin_initializer
  -- if $class_static_at(S.CLASSSTATICS, porigin) = (pclassstatic)
  -- if pclassstatic.STATE = PROP_DEFERRED porigin_initializer
  -- if $origin_node(S.SOURCES, porigin_initializer) = (expression)
  -- if $class_constant_update_target(S, ptask_tail*) = (porigin_root)
  -- if $static_default_task_valid(S, porigin, z)
rule PhpStep/static-default-update-filled: S ~> S[.TODO = ptask_tail*]
  -- if S.TODO = (STATIC_DEFAULT_UPDATE porigin z) :: ptask_tail*
  -- if $class_static_at(S.CLASSSTATICS, porigin) = (pclassstatic)
  -- if ~$static_default_pending(pclassstatic.STATE)
  -- if $static_default_task_valid(S, porigin, z)

dec $static_default_class_supported(pvalueclass) : bool
dec $static_default_array_supported((pkey, pvalueclass)*) : bool
def $static_default_class_supported(PVSCALAR) = true
def $static_default_class_supported(PVSTRING b) = true
def $static_default_class_supported(PVARRAY b (pkey, pvalueclass)*) = $static_default_array_supported((pkey, pvalueclass)*)
def $static_default_class_supported(pvalueclass) = false -- otherwise
def $static_default_array_supported(eps) = true
def $static_default_array_supported((pkey, pvalueclass) :: (pkey_tail, pvalueclass_tail)*) = ($static_default_class_supported(pvalueclass) /\ $static_default_array_supported((pkey_tail, pvalueclass_tail)*))

dec $static_default_bound(pstate, pstaticdefaultcontext, ppropertydesc, pvalue) : pstate
rule PhpStep/static-default-bind: S ~> $static_default_restore($static_default_bound(S_value, pstaticdefaultcontext, ppropertydesc, pvalue)[.TODO = ptask_tail*][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)], pstaticdefaultcontext)
  -- if S.TODO = (STATIC_DEFAULT_BIND pstaticdefaultcontext) :: ptask_tail*
  -- if $static_default_bind_valid(S, pstaticdefaultcontext)
  -- if pstaticdefaultcontext.ORIGIN = (porigin_trigger)
  -- if $class_static_active_desc(S, S.CLASSNAMES, pstaticdefaultcontext.DECL) = (ppropertydesc)
  -- if ppropertydesc.DEFAULT = PROP_DEFERRED porigin_initializer
  -- if S_value = $resolve_at(S, S.RESULT, pstaticdefaultcontext.LINE)
  -- if S_value.COMPLETION = NORMAL
  -- if S_value.RESULT = KNOWN pvalue
  -- if $class_constant_runtime_type(S_value, ppropertydesc.TYPE, pvalue)
  -- if pvalueclass = $constant_class(S_value, porigin_initializer)
  -- if $static_default_class_supported(pvalueclass)
  -- if $constant_value_class_valid(S_value, pvalue, pvalueclass)
rule PhpStep/static-default-bind-object: S ~> $static_default_restore(S_value[.TODO = ptask_tail*][.COMPLETION = UNSUPPORTED "object-bearing deferred static default"], pstaticdefaultcontext)
  -- if S.TODO = (STATIC_DEFAULT_BIND pstaticdefaultcontext) :: ptask_tail*
  -- if $class_static_active_desc(S, S.CLASSNAMES, pstaticdefaultcontext.DECL) = (ppropertydesc)
  -- if ppropertydesc.DEFAULT = PROP_DEFERRED porigin_initializer
  -- if S_value = $resolve_at(S, S.RESULT, pstaticdefaultcontext.LINE)
  -- if S_value.COMPLETION = NORMAL
  -- if S_value.RESULT = KNOWN pvalue
  -- if $class_constant_runtime_type(S_value, ppropertydesc.TYPE, pvalue)
  -- if ~$static_default_class_supported($constant_class(S_value, porigin_initializer))
rule PhpStep/static-default-bind-type: S ~> $throw_scalar($static_default_restore(S_value[.TODO = ptask_tail*], pstaticdefaultcontext), "TypeError", $ptascii("Cannot assign ") ++ $typed_given(S_value, pvalue) ++ $ptascii(" to property ") ++ $property_declaring_name(S.CLASSES, pstaticdefaultcontext.DECL) ++ $ptascii("::$") ++ ppropertydesc.NAME ++ $ptascii(" of type ") ++ $pttypename(ppropertydesc.TYPE), pstaticdefaultcontext.LINE)
  -- if S.TODO = (STATIC_DEFAULT_BIND pstaticdefaultcontext) :: ptask_tail*
  -- if $class_static_active_desc(S, S.CLASSNAMES, pstaticdefaultcontext.DECL) = (ppropertydesc)
  -- if S_value = $resolve_at(S, S.RESULT, pstaticdefaultcontext.LINE)
  -- if S_value.COMPLETION = NORMAL
  -- if S_value.RESULT = KNOWN pvalue
  -- if ~$class_constant_runtime_type(S_value, ppropertydesc.TYPE, pvalue)
rule PhpStep/static-default-bind-abrupt: S ~> S_value
  -- if S.TODO = (STATIC_DEFAULT_BIND pstaticdefaultcontext) :: ptask_tail*
  -- if S_value = $resolve_at(S, S.RESULT, pstaticdefaultcontext.LINE)
  -- if S_value.COMPLETION =/= NORMAL

def $call_after_origin(S, STATIC_DEFAULT_BIND pstaticdefaultcontext) = $static_default_restore(S, pstaticdefaultcontext)
def $return_discard(S, STATIC_DEFAULT_BIND pstaticdefaultcontext) = $static_default_restore(S[.CONSTCONTEXT = eps], pstaticdefaultcontext)[.CONSTCONTEXT = eps]
def $task_nodes(STATIC_DEFAULT_UPDATE porigin z) = eps
def $task_nodes(STATIC_DEFAULT_BIND pstaticdefaultcontext) = eps
