def $static_default_parent(S, porigin) = eps -- otherwise
def $static_default_source_valid(S, ppropertydesc) = true
  -- if ppropertydesc.STATIC
  -- if ppropertydesc.DEFAULT = PROP_DEFERRED porigin_initializer
  -- if ppropertydesc.ORIGIN = porigin_decl
  -- if $constant_expression_root(S, porigin_decl) = (porigin_initializer)
