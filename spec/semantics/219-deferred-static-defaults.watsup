;; Inherited static prototypes retain their AST even after the live cell fills.
;; Linking therefore differs from a successful update of the live table.
def $static_default_link_done(S, porigin, 0) = false
def $static_default_link_done(S, porigin, n) = ($static_default_values_done(pclassdesc.PROPERTIES, eps) /\ $static_default_link_done(S, porigin_parent, $nabs($(n - 1))))
  -- if $(n > 0)
  -- if $class_at(S.CLASSES, porigin) = (pclassdesc)
  -- if $class_link_at(S.LINKEDPARENTS, porigin) = (SOURCE_PARENT porigin_parent)
