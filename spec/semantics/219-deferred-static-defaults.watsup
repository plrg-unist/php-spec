def $static_default_values_done(ppropertydesc*, porigin_filled*) = $static_default_complete($static_default_origins(ppropertydesc*), porigin_filled*)
def $static_default_descriptor(PROP_DEFERRED porigin) = true
def $static_default_descriptor(ppropdefault) = false -- otherwise

