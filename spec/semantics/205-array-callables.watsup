def $target_called_class(S, ARRAY_METHOD_TARGET pcalltarget parrayselection) = $target_called_class(S, pcalltarget)
def $target_function(S, ARRAY_METHOD_TARGET pcalltarget parrayselection) = $target_function(S, pcalltarget)
