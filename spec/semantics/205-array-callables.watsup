def $array_dynamic_result(S, ARRAYRESOLVED pcalltarget porigin_requested ptbytes, porigin_site, z_init, z_call) = S[.TODO = $method_args_task(ARRAY_METHOD_TARGET ($scope_target_site(S, pcalltarget, porigin_site, false)) {SITE porigin_site, INIT z_init, LINE z_call, REQUESTED porigin_requested, NAME ptbytes}, $dynamic_arguments(S, porigin_site), (porigin_site), z_call) :: S.TODO][.RESULT = KNOWN PNULL][.BASE = BASE_VALUE (KNOWN PNULL)]
def $array_dynamic_result(S, ARRAYINVALID ptbytes, porigin_site, z_init, z_call) = $throw_scalar(S, "Error", ptbytes, z_init)
