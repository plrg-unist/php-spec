;; Ordinary public source array callbacks. Admission may use the receiving
;; frame's implicit this; direct dynamic calls never do so for class strings.
dec $array_shape_error(pstate, nat) : ptbytes?
def $array_shape_error(S, n) = ($ptascii("Array callback must have exactly two elements"))
  -- if S.ARRAYS[n] = parray
  -- if |parray.ITEMS| =/= 2
def $array_shape_error(S, n) = ($ptascii("Array callback has to contain indices 0 and 1"))
  -- if S.ARRAYS[n] = parray
  -- if |parray.ITEMS| = 2
  -- if $entry_lookup(parray.ITEMS, KINT 0) = eps \/ $entry_lookup(parray.ITEMS, KINT 1) = eps
def $array_shape_error(S, n) = ($ptascii("First array member is not a valid class name or object"))
  -- if S.ARRAYS[n] = parray
  -- if |parray.ITEMS| = 2
  -- if $entry_lookup(parray.ITEMS, KINT 0) = (pitem_receiver)
  -- if $entry_lookup(parray.ITEMS, KINT 1) = (pitem_method)
  -- if ~$typed_callback_receiver($entry_value(S, pitem_receiver))
def $array_shape_error(S, n) = ($ptascii("Second array member is not a valid method"))
  -- if S.ARRAYS[n] = parray
  -- if |parray.ITEMS| = 2
  -- if $entry_lookup(parray.ITEMS, KINT 0) = (pitem_receiver)
  -- if $entry_lookup(parray.ITEMS, KINT 1) = (pitem_method)
  -- if $typed_callback_receiver($entry_value(S, pitem_receiver))
  -- if ~$typed_string_value($entry_value(S, pitem_method))
def $array_shape_error(S, n) = eps -- otherwise

dec $array_implicit_this(pstate, porigin) : bool
def $array_implicit_this(S, porigin_requested) = true
  -- if S.CURRENT = (pcallcontext)
  -- if pcallcontext.LEXICAL_CLASS = (porigin_scope)
  -- if pcallcontext.RECEIVER = (n_receiver)
  -- if $(n_receiver < |S.OBJECTS|)
  -- if (HOBJECT n_receiver) <- S.ALLOCATIONS
  -- if S.OBJECTS[n_receiver] = INSTANCE porigin_receiver
  -- if $class_at(S.CLASSES, porigin_scope) = (pclassdesc_scope)
  -- if $class_at(S.CLASSES, porigin_requested) = (pclassdesc_requested)
  -- if $class_origin_matches(S, porigin_receiver, pclassdesc_scope.NAME, |S.CLASSES|)
  -- if $class_origin_matches(S, porigin_scope, pclassdesc_requested.NAME, |S.CLASSES|)
def $array_implicit_this(S, porigin_requested) = false -- otherwise

dec $array_public_target(pstate, porigin, pmethoddesc, nat?, ptbytes, parraymode) : parrayresolution
def $array_public_target(S, porigin_class, pmethoddesc, n_receiver?, ptbytes, parraymode) = ARRAYRESOLVED (STATIC_METHOD_TARGET porigin_class pmethoddesc.FUNCTION.ORIGIN) porigin_class ptbytes
  -- if pmethoddesc.STATIC
def $array_public_target(S, porigin_class, pmethoddesc, (n_receiver), ptbytes, parraymode) = ARRAYRESOLVED (METHOD_TARGET n_receiver pmethoddesc.FUNCTION.ORIGIN) porigin_class ptbytes
  -- if ~pmethoddesc.STATIC
def $array_public_target(S, porigin_class, pmethoddesc, eps, ptbytes, ARRAY_ADMISSION) = ARRAYADMITTED
  -- if ~pmethoddesc.STATIC
  -- if $array_implicit_this(S, porigin_class)
def $array_public_target(S, porigin_class, pmethoddesc, eps, ptbytes, ARRAY_ADMISSION) = ARRAYINVALID ($ptascii("Non-static method ") ++ pclassdesc.NAME ++ $ptascii("::") ++ pmethoddesc.NAME ++ $ptascii("() cannot be called statically"))
  -- if ~pmethoddesc.STATIC
  -- if ~$array_implicit_this(S, porigin_class)
  -- if $class_at(S.CLASSES, pmethoddesc.OWNER) = (pclassdesc)
def $array_public_target(S, porigin_class, pmethoddesc, eps, ptbytes, ARRAY_DISPATCH) = ARRAYINVALID ($ptascii("Non-static method ") ++ pclassdesc.NAME ++ $ptascii("::") ++ pmethoddesc.NAME ++ $ptascii("() cannot be called statically"))
  -- if ~pmethoddesc.STATIC
  -- if $class_at(S.CLASSES, pmethoddesc.OWNER) = (pclassdesc)

dec $array_magic(pstate, porigin) : bool
def $array_magic(S, porigin_class) = ($effective_method(S, porigin_class, $ptascii("__call"), |S.CLASSES|) =/= eps \/ $effective_method(S, porigin_class, $ptascii("__callStatic"), |S.CLASSES|) =/= eps)
dec $array_method(pstate, porigin, nat?, ptbytes, parraymode) : parrayresolution
def $array_method(S, porigin_class, n_receiver?, ptbytes, parraymode) = $scope_array_method(S, porigin_class, n_receiver?, ptbytes, parraymode)

dec $array_receiver(pstate, pvalue, ptbytes, parraymode) : parrayresolution
def $array_receiver(S, POBJECT n, ptbytes, parraymode) = ARRAYINVALID ($ptascii("Call to undefined method stdClass::") ++ $c_string(ptbytes) ++ $ptascii("()"))
  -- if $(n < |S.OBJECTS|)
  -- if (HOBJECT n) <- S.ALLOCATIONS
  -- if S.OBJECTS[n] = STDINSTANCE
def $array_receiver(S, POBJECT n, ptbytes, parraymode) = $array_method(S, porigin_class, (n), ptbytes, parraymode)
  -- if $(n < |S.OBJECTS|)
  -- if (HOBJECT n) <- S.ALLOCATIONS
  -- if S.OBJECTS[n] = INSTANCE porigin_class
  -- if $class_at(S.CLASSES, porigin_class) = (pclassdesc)
  -- if $class_named(S.CLASSNAMES, $ptlc(pclassdesc.NAME)) = (porigin_class)
def $array_receiver(S, PSTRING ptbytes_class, ptbytes, parraymode) = ARRAYINVALID ($ptascii("Class \"") ++ $c_string(ptbytes_class) ++ $ptascii("\" not found"))
  -- if $ptlc($typed_callable_name(ptbytes_class)) <- [$ptascii("self"), $ptascii("parent"), $ptascii("static")]
def $array_receiver(S, PSTRING ptbytes_class, ptbytes, parraymode) = $array_method(S, porigin_class, eps, ptbytes, parraymode)
  -- if ~($ptlc($typed_callable_name(ptbytes_class)) <- [$ptascii("self"), $ptascii("parent"), $ptascii("static")])
  -- if $class_named(S.CLASSNAMES, $ptlc($typed_callable_name(ptbytes_class))) = (porigin_class)
def $array_receiver(S, pvalue, ptbytes, parraymode) = ARRAYUNKNOWN "array callable class, autoload or internal method lookup" -- otherwise

def $array_resolve(S, n, parraymode) = ARRAYINVALID ptbytes
  -- if $array_shape_error(S, n) = (ptbytes)
def $array_resolve(S, n, parraymode) = $array_receiver(S, $entry_value(S, pitem_receiver), ptbytes, parraymode)
  -- if $typed_callback_array(S, n)
  -- if S.ARRAYS[n] = parray
  -- if $entry_lookup(parray.ITEMS, KINT 0) = (pitem_receiver)
  -- if $entry_lookup(parray.ITEMS, KINT 1) = (pitem_method)
  -- if $entry_value(S, pitem_method) = PSTRING ptbytes
def $array_resolve(S, n, parraymode) = ARRAYUNKNOWN "invalid array callable state" -- otherwise

def $array_admission(ARRAYRESOLVED pcalltarget porigin ptbytes) = (true)
def $array_admission(ARRAYADMITTED) = (true)
def $array_admission(ARRAYINVALID ptbytes) = (false)
def $array_admission(ARRAYUNKNOWN text) = eps

;; Selection owns only the selected receiver (or static class identities),
