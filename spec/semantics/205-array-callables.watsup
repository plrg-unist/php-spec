def $target_nodes(ARRAY_METHOD_TARGET pcalltarget parrayselection) = $target_nodes(pcalltarget)
def $target_instance(ARRAY_METHOD_TARGET pcalltarget parrayselection) = eps
def $target_receiver(S, ARRAY_METHOD_TARGET pcalltarget parrayselection) = $target_receiver(S, pcalltarget)
